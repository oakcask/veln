pub fn identity<T>(value: T) -> T
    value
end

pub fn wrap<T>(value: T) -> Option<T>
    Some(value)
end

pub fn apply<T, U, effect E>(f: fn(T) -> U effects [...E], value: T) -> U effects [...E]
    f(value)
end

pub fn repeat<T>(value: T, count: Int) -> T
    if count == 0
        value
    else
        repeat<T>(value, count - 1)
    end
end

pub fn nested<T>(value: T) -> Option<Vec<T>>
    wrap<Vec<T>>([value])
end
