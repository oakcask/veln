use fs from "std"
use io from "std"
use path from "std"
use io_provider from "std"
use io_lifecycle_test_support_test as lifecycle
use io_publication_test_support_test as publication

# Backend contract: a captured namespace call remains tracked across owner
# teardown, and its late resource release failure reaches owner cleanup.
type Controls
	Controls(cell: io_provider::State<lifecycle::State>, entered: Sender<String>, gate: Receiver<String>, views: Sender<fs::Filesystem>, children: Sender<Task<Result<fs::ReadFile, io::Error>>>, leave: Receiver<String>)
end

fn open(filesystem: fs::Filesystem) -> Result<fs::ReadFile, io::Error> effects [fs::Read, concurrency]
	fs::open_read(filesystem, path::root())
end

fn owned(context: Controls) -> Result<(), String> effects [io_provider::Scope, concurrency]
	match context
		Controls(cell, entered, gate, views, children, leave) => begin
			let owner = io_provider::owner()
			let filesystem: fs::Filesystem = match publication::filesystem(owner, cell, entered, gate)
				Ok(value) => Ok(value)
				Err(error) => Err(error.message)
			end?
			let child = handle task::spawn_with(open, filesystem) with publication::namespace(owner, cell, entered, gate)
			let _ = channel::send(views, filesystem)
			let _ = channel::send(children, child)
			let _ = channel::recv(leave)
			__EXIT__
		end
	end
end

fn worker(context: Controls) -> Result<(), String> effects [concurrency]
	handle owned(context) with io_provider::scope()
end

handler unused() for fs::Read
	open_read(filesystem, path) => Err(lifecycle::failure("unexpected lexical open"))
	metadata(filesystem, path, follow) => Err(lifecycle::failure("unexpected lexical metadata"))
	entries(filesystem, path) => Err(lifecycle::failure("unexpected lexical entries"))
end

fn wait_closed(filesystem: fs::Filesystem) -> () effects [fs::Read]
	match fs::metadata(filesystem, path::root(), fs::FollowLinks::NoFollow)
		Err(error) => match error.kind
			io::ErrorKind::Closed => ()
			_ => wait_closed(filesystem)
		end
		Ok(_) => wait_closed(filesystem)
	end
end

fn observe(cell: io_provider::State<lifecycle::State>) -> () effects [concurrency, stdio]
	match lifecycle::snapshot(cell)
		lifecycle::State(_, live, closes, _) => begin
			stdio::println(int_to_string(list_fold(closes, 0, count)))
			match dict_get(live, 1)
				Some(true) => stdio::println("retained release obligation")
				_ => stdio::println("released")
			end
		end
	end
end

fn count(total: Int, ignored: lifecycle::CloseEvent) -> Int
	total + 1
end

pub fn main() -> Result<(), String> effects [concurrency, stdio]
	let steps = Cons(lifecycle::CloseStep(1, __REPLY__, __RELEASED__), Nil)
	let cell = io_provider::state(lifecycle::initial(steps))
	let entered = channel::bounded<String>(1)
	let gate = channel::bounded<String>(1)
	let views = channel::bounded<fs::Filesystem>(1)
	let children = channel::bounded<Task<Result<fs::ReadFile, io::Error>>>(1)
	let leave = channel::bounded<String>(1)
	let owner = task::spawn_with(worker, Controls(cell, entered.tx, gate.rx, views.tx, children.tx, leave.rx))
	let filesystem = match channel::recv(views.rx)
		Some(value) => Ok(value)
		None => Err("missing filesystem")
	end?
	let child: Task<Result<fs::ReadFile, io::Error>> = match channel::recv(children.rx)
		Some(value) => Ok(value)
		None => Err("missing child")
	end?
	let _ = channel::recv(entered.rx)
	let _ = channel::send(leave.tx, "leave owner")
	let _ = handle wait_closed(filesystem) with unused()
	let _ = channel::send(gate.tx, "complete open")
	defer
		observe(cell)
	end
	let joined = task::join(owner)
	let child_result: Result<Result<fs::ReadFile, io::Error>, JoinError> = task::join(child)
	match child_result
		Ok(Err(error)) => match error.kind
			io::ErrorKind::Closed => match joined
				Ok(Ok(())) => Ok(())
				_ => Err("unexpected owner result")
			end
			_ => Err("late open returned another error")
		end
		_ => Err("late open published a usable resource")
	end
end
