use host_effects from "std"

handler fixed_clock(value: Int) handles host_effects::Clock
	request(operation, milliseconds) => Ok(value)
	wall_time() => Ok({ unix_seconds: value, nanosecond: 0 })
end

handler failing_clock(failed_operation: String, message: String) handles host_effects::Clock
	request(operation, milliseconds) => if operation == failed_operation
		Err(message)
	else
		Ok(0)
	end
	wall_time() => if failed_operation == "wall_time"
		Err(message)
	else
		Ok({ unix_seconds: 0, nanosecond: 0 })
	end
end

handler outcome_clock(outcome: Int) handles host_effects::Clock
	request(operation, milliseconds) => if operation == "wait_cancellable"
		Ok(outcome)
	else
		Ok(0)
	end
	wall_time() => Ok({ unix_seconds: 0, nanosecond: 0 })
end

handler wall_clock(seconds: Int, nanosecond: Int) handles host_effects::Clock
	request(operation, milliseconds) => Ok(0)
	wall_time() => Ok({ unix_seconds: seconds, nanosecond: nanosecond })
end
