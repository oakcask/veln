fn buffered_transforming_log(context: Option<TraceContext>) -> Observation callsite
	let attributes = list_cons(
		observe::Attribute("secret", observe::StringValue("value")),
		list_cons(
			observe::Attribute("long", observe::StringValue("abcdef")),
			list_cons(observe::Attribute("drop", observe::IntValue(3)), list_nil()),
		),
	)
	observe::Log(observe::LogRecord("log", observe::Info, "transform", attributes, context, callsite))
end

test buffered_concurrent_invalid_and_full_submissions_do_not_commit_transformations() -> Result<(), String> effects [time, concurrency]
	let lines = observe_test_support_test::export_lines(4)
	let destination_release = channel::bounded<()>(3)
	let idle = channel::bounded<()>(1)
	let resume = channel::bounded<()>(1)
	let invalid_entered = channel::bounded<()>(1)
	let invalid_release = channel::bounded<()>(1)
	let full_entered = channel::bounded<()>(1)
	let full_release = channel::bounded<()>(1)
	let constructed = handle new_buffered_transformations_for_test(idle.tx, resume.rx) with observe_test_support_test::controlled_record_exporter(lines.tx, destination_release.rx)
	match constructed
		observe::BufferedJsonLines(exporter) => begin
			let control = handle observe::buffered_export_observation(exporter, buffered_transforming_log(None)) with observe_test_support_test::clock(0)
			let control_line = channel::recv(lines.rx)
			let control_health = observe::buffered_exporter_health(exporter)
			let _ = channel::send(destination_release.tx, ())
			let _ = channel::recv(idle.rx)
			let occupying = handle observe::buffered_export_observation(exporter, buffered_log("occupy")) with observe_test_support_test::clock(0)
			let _ = channel::send(resume.tx, ())
			let occupying_line = channel::recv(lines.rx)
			let invalid_record = buffered_transforming_log(Some(observe::TraceContext("", "span", true)))
			let full_record = buffered_transforming_log(None)
			let invalid = task::spawn_with(stalled_buffered_record_admission, { exporter: exporter, record: invalid_record, entered: invalid_entered.tx, release: invalid_release.rx })
			let _ = channel::recv(invalid_entered.rx)
			let full = task::spawn_with(queued_buffered_record_admission, { exporter: exporter, record: full_record, entered: full_entered.tx, release: full_release.rx })
			let _ = channel::recv(full_entered.rx)
			let _ = channel::send(invalid_release.tx, ())
			let invalid_result = task::join(invalid)
			let invalid_health = observe::buffered_exporter_health(exporter)
			let invalid_destination_attempt: Option<{ index : Int, value : String }> = channel::select_many_timeout(list_cons(lines.rx, list_nil()), 0)
			let _ = channel::send(full_release.tx, ())
			let full_result = task::join(full)
			let full_health = observe::buffered_exporter_health(exporter)
			let full_destination_attempt: Option<{ index : Int, value : String }> = channel::select_many_timeout(list_cons(lines.rx, list_nil()), 0)
			let _ = channel::send(destination_release.tx, ())
			let _ = channel::recv(idle.rx)
			let last = handle observe::buffered_export_observation(exporter, buffered_log("last")) with observe_test_support_test::clock(0)
			let _ = channel::send(resume.tx, ())
			let last_line = channel::recv(lines.rx)
			let _ = channel::send(destination_release.tx, ())
			let _ = channel::recv(idle.rx)
			let _ = channel::send(resume.tx, ())
			let report = observe::shutdown_buffered(exporter)
			if not buffered_transformation_control_matches(control, control_line, control_health)
				Err("admitted transformation control did not establish every counter")
			else if not buffered_admission_is_accepted(occupying)
				Err("buffered transformation rejection setup did not occupy capacity")
			else if not buffered_line_has_sequence_and_message(occupying_line, 2, "occupy")
				match occupying_line
					Some(_) => Err("buffered transformation rejection setup wrote the wrong sequence or message")
					None => Err("buffered transformation rejection setup did not write sequence two")
				end
			else if not buffered_no_selected_line(invalid_destination_attempt) or not buffered_no_selected_line(full_destination_attempt)
				Err("a rejected transformation candidate reached the destination")
			else if not buffered_admission_is_accepted(last) or not buffered_line_has_sequence_and_message(last_line, 5, "last")
				Err("rejected transformation candidates did not consume sequence positions")
			else
				match invalid_result
					Ok(observe::InvalidRecord) => match invalid_health
						observe::ExporterHealth(1, 1, 2, 1, observe::ProductionHealth(0, 0, 0)) => match full_result
							Ok(observe::Full) => match full_health
								observe::ExporterHealth(2, 1, 2, 1, observe::ProductionHealth(0, 0, 0)) => match report
									observe::BufferedShutdownReport(observe::Completed, observe::ExporterHealth(2, 1, 2, 1, observe::ProductionHealth(0, 0, 0)), _) => Ok(())
									_ => Err("concurrent rejection shutdown did not retain admitted transformation facts")
								end
								_ => Err("full admission committed rejected transformation facts")
							end
							_ => Err("queued concurrent admission was not rejected at capacity")
						end
						_ => Err("invalid admission committed rejected transformation facts")
					end
					_ => Err("stalled concurrent invalid admission changed outcome")
				end
			end
		end
		_ => Err("concurrent rejection exporter construction failed")
	end
end

fn buffered_transformation_control_matches(outcome: BufferedAdmissionOutcome, line: Option<String>, health: ExporterHealth) -> Bool
	match outcome
		observe::Accepted => match line
			Some(value) => buffered_contains(value, "\"sequence\":1,") and buffered_contains(value, "\"attribute_facts\":{\"dropped\":1,\"truncated\":2,\"redacted\":1}") and match health
				observe::ExporterHealth(0, 1, 2, 1, observe::ProductionHealth(0, 0, 0)) => true
				_ => false
			end
			None => false
		end
		_ => false
	end
end

fn buffered_admission_is_accepted(outcome: BufferedAdmissionOutcome) -> Bool
	match outcome
		observe::Accepted => true
		_ => false
	end
end

fn buffered_no_selected_line(value: Option<{ index : Int, value : String }>) -> Bool
	match value
		None => true
		Some(_) => false
	end
end

fn buffered_line_has_sequence_and_message(line: Option<String>, sequence: Int, message: String) -> Bool
	match line
		Some(value) => buffered_contains(value, string::concat(string::concat("\"sequence\":", int_to_string(sequence)), ",")) and buffered_contains(value, string::concat(string::concat("\"message\":\"", message), "\""))
		None => false
	end
end

test buffered_concurrent_accepted_submissions_reach_destination_in_admission_order() -> Result<(), String> effects [time, concurrency]
	let lines = observe_test_support_test::export_lines(3)
	let entered = channel::bounded<()>(1)
	let release = channel::bounded<()>(1)
	let queued = channel::bounded<()>(1)
	let admit = channel::bounded<()>(1)
	let constructed = handle new_buffered_for_test(2, observe::NoDiagnosticDestination) with observe_test_support_test::exporter(lines.tx, true)
	match constructed
		observe::BufferedJsonLines(exporter) => begin
			let first = task::spawn_with(stalled_buffered_admission, { exporter: exporter, entered: entered.tx, release: release.rx })
			let _ = channel::recv(entered.rx)
			let second = task::spawn_with(queued_buffered_admission, { exporter: exporter, entered: queued.tx, release: admit.rx })
			let _ = channel::recv(queued.rx)
			let _ = channel::send(release.tx, ())
			let first_result = task::join(first)
			let _ = channel::send(admit.tx, ())
			let second_result = task::join(second)
			let report = observe::shutdown_buffered(exporter)
			let first_line = channel::recv(lines.rx)
			let second_line = channel::recv(lines.rx)
			match first_result
				Ok(observe::Accepted) => match second_result
					Ok(observe::Accepted) => if buffered_concurrent_fifo(first_line, second_line)
						match report
							observe::BufferedShutdownReport(observe::Completed, observe::ExporterHealth(0, 0, 0, 0, _), _) => Ok(())
							_ => Err("concurrent accepted buffered submissions changed shutdown health")
						end
					else
						Err("concurrent accepted buffered submissions did not preserve admission FIFO")
					end
					_ => Err("overlapping buffered submission was not accepted")
				end
				_ => Err("stalled buffered submission was not accepted")
			end
		end
		_ => Err("concurrent buffered exporter construction failed")
	end
end

fn buffered_concurrent_fifo(first: Option<String>, second: Option<String>) -> Bool
	match first
		Some(first_line) => match second
			Some(second_line) => buffered_contains(first_line, "\"sequence\":1,") and buffered_contains(first_line, "\"message\":\"first\"") and buffered_contains(second_line, "\"sequence\":2,") and buffered_contains(second_line, "\"message\":\"second\"")
			None => false
		end
		None => false
	end
end

