			match admission
				observe::Accepted => match report
					observe::BufferedShutdownReport(observe::Interrupted, observe::ExporterHealth(9223372036854775807, 0, 0, 0, observe::ProductionHealth(0, 0, 0)), observe::SummaryNotAttempted) => Ok(())
					_ => Err("interrupted unsettled accounting overflowed failed exports")
				end
				_ => Err("saturating interruption record was not admitted")
			end
