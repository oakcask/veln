test shutdown_cancellation_before_worker_cleanup_registration_freezes_shared_interruption() -> Result<(), String> effects [time, concurrency]
	let startup = channel::bounded<()>(1)
	let startup_release = channel::bounded<()>(1)
	let cancelled_wait = channel::bounded<()>(1)
	let survivor_wait = channel::bounded<()>(1)
	let reports = channel::bounded<BufferedShutdownReport>(1)
	let lines = observe_test_support_test::export_lines(2)
	let constructed = handle new_buffered_for_test_with_startup_hook(startup.tx, startup_release.rx) with observe_test_support_test::exporter(lines.tx, true)
	match constructed
		observe::BufferedJsonLines(exporter) => begin
			let startup_blocked: Option<()> = channel::recv(startup.rx)
			let admitted = handle observe::buffered_export_observation(exporter, buffered_log("startup-queued")) with observe_test_support_test::clock(0)
			let cancelled = task::spawn_with(shutdown_buffered_task_observed, { exporter: exporter, waiting: cancelled_wait.tx })
			let survivor = task::spawn_with(shutdown_buffered_and_send_observed, { exporter: exporter, reports: reports.tx, waiting: survivor_wait.tx })
			let cancelled_waiting: Option<()> = channel::recv(cancelled_wait.rx)
			let survivor_waiting: Option<()> = channel::recv(survivor_wait.rx)
			task::cancel(cancelled)
			let cancelled_join = task::join(cancelled)
			let survivor_join = task::join(survivor)
			let prompt: Option<BufferedShutdownReport> = channel::recv(reports.rx)
			let frozen_before = observe::buffered_exporter_health(exporter)
			let outstanding_before_release = observe::buffered_outstanding_for_test(exporter)
			let queue_empty_before_release = observe::buffered_queue_is_empty_for_test(exporter)
			let _ = channel::send(startup_release.tx, ())
			let no_call: Option<{ index : Int, value : String }> = channel::select_many_timeout(list_cons(lines.rx, list_nil()), 50)
			let repeated = observe::shutdown_buffered(exporter)
			let frozen_after = observe::buffered_exporter_health(exporter)
			let closed = handle observe::buffered_export_observation(exporter, buffered_log("after-startup-interruption")) with observe_test_support_test::clock(0)
			match cancelled_join
				Err(error) => if task::join_error_is_cancelled(error) and buffered_unit_received(startup_blocked) and buffered_unit_received(cancelled_waiting) and buffered_unit_received(survivor_waiting) and buffered_admission_is_accepted(admitted)
					match prompt
						Some(observe::BufferedShutdownReport(observe::Interrupted, observe::ExporterHealth(1, 0, 0, 0, observe::ProductionHealth(0, 0, 0)), observe::SummaryNotAttempted)) => match survivor_join
							Ok(()) => match repeated
								observe::BufferedShutdownReport(observe::Interrupted, observe::ExporterHealth(1, 0, 0, 0, observe::ProductionHealth(0, 0, 0)), observe::SummaryNotAttempted) => match frozen_before
									observe::ExporterHealth(1, 0, 0, 0, observe::ProductionHealth(0, 0, 0)) => match frozen_after
										observe::ExporterHealth(1, 0, 0, 0, observe::ProductionHealth(0, 0, 0)) => if outstanding_before_release != 0 or not queue_empty_before_release
											Err("startup interruption did not discard queued outstanding work")
										else if not buffered_no_selected_line(no_call)
											Err("late worker startup began a record or summary call")
										else if not buffered_admission_is_closed(closed)
											Err("startup interruption left admission open")
										else
											Ok(())
										end
										_ => Err("late worker startup changed frozen health")
									end
									_ => Err("startup interruption froze the wrong health")
								end
								_ => Err("repeated shutdown changed the startup interruption report")
							end
							Err(_) => Err("startup interruption did not wake the survivor normally")
						end
						_ => Err("startup interruption did not wake the survivor promptly with the frozen report")
					end
				else
					Err("startup interruption missed a deterministic boundary")
				end
				Ok(_) => Err("startup shutdown waiter lost abrupt cancellation")
			end
		end
		_ => Err("startup interruption exporter construction failed")
	end
end

test concurrent_buffered_shutdown_callers_share_one_drain_summary_and_frozen_report() -> Result<(), String> effects [time, concurrency]
	let events = channel::bounded<String>(4)
	let release = channel::bounded<()>(2)
	let reports = channel::bounded<BufferedShutdownReport>(2)
	let first_wait = channel::bounded<()>(1)
	let second_wait = channel::bounded<()>(1)
	let constructed = handle new_buffered_failure_for_test(0, observe::DiagnosticStandardError) with observe_test_support_test::late_completion_exporter(events.tx, release.rx)
	match constructed
		observe::BufferedJsonLines(exporter) => begin
			let admitted = handle observe::buffered_export_observation(exporter, buffered_log("shared")) with observe_test_support_test::clock(0)
			let started: Option<String> = channel::recv(events.rx)
			let first = task::spawn_with(shutdown_buffered_and_send_observed, { exporter: exporter, reports: reports.tx, waiting: first_wait.tx })
			let second = task::spawn_with(shutdown_buffered_and_send_observed, { exporter: exporter, reports: reports.tx, waiting: second_wait.tx })
			let first_waiting: Option<()> = channel::recv(first_wait.rx)
			let second_waiting: Option<()> = channel::recv(second_wait.rx)
			let closed = handle observe::buffered_export_observation(exporter, buffered_log("lost-close-race")) with observe_test_support_test::clock(0)
			let _ = handle handle handled_emit(buffered_named_metric("closed-series-1"), 1) with observe::buffered_json_lines(exporter) with observe_test_support_test::clock(0)
			let _ = handle handle handled_emit(buffered_named_metric("closed-series-2"), 2) with observe::buffered_json_lines(exporter) with observe_test_support_test::clock(0)
			let _ = handle handle handled_emit(buffered_named_metric("closed-series-3"), 3) with observe::buffered_json_lines(exporter) with observe_test_support_test::clock(0)
			let _ = handle handle handled_emit(buffered_named_metric("closed-series-4"), 4) with observe::buffered_json_lines(exporter) with observe_test_support_test::clock(0)
			let _ = handle handle handled_emit(buffered_named_metric("closed-series-5"), 5) with observe::buffered_json_lines(exporter) with observe_test_support_test::clock(0)
			let before_release = observe::buffered_exporter_health(exporter)
			let production_before_release = observe::buffered_production_health_for_test(exporter)
			let _ = channel::send(release.tx, ())
			let completed_record: Option<String> = channel::recv(events.rx)
			let summary_started: Option<String> = channel::recv(events.rx)
			let _ = channel::send(release.tx, ())
			let completed_summary: Option<String> = channel::recv(events.rx)
			let first_report = channel::recv(reports.rx)
			let second_report = channel::recv(reports.rx)
			let first_joined = match task::join(first)
				Ok(()) => true
				Err(_) => false
			end
			let second_joined = match task::join(second)
				Ok(()) => true
				Err(_) => false
			end
			let repeated = observe::shutdown_buffered(exporter)
			let no_more: Option<{ index : Int, value : String }> = channel::select_many_timeout(list_cons(events.rx, list_nil()), 0)
			match admitted
				observe::Accepted => match closed
					observe::Closed => match production_before_release
						observe::ProductionHealth(0, 0, 0) => match before_release
						observe::ExporterHealth(0, 0, 0, 0, observe::ProductionHealth(0, 0, 0)) => match first_report
							Some(observe::BufferedShutdownReport(observe::Completed, observe::ExporterHealth(0, 0, 0, 0, observe::ProductionHealth(0, 0, 0)), observe::SummaryAccepted)) => match second_report
								Some(observe::BufferedShutdownReport(observe::Completed, observe::ExporterHealth(0, 0, 0, 0, observe::ProductionHealth(0, 0, 0)), observe::SummaryAccepted)) => if not buffered_event_is(started, "record-started")
									Err(buffered_unexpected_event("concurrent shutdown record start", started))
								else if completed_record == None or not buffered_event_is(summary_started, "summary-started") or completed_summary == None
									Err("concurrent shutdown did not complete one record and one summary")
								else if not buffered_unit_received(first_waiting) or not buffered_unit_received(second_waiting)
									Err("concurrent shutdown caller did not join the shared transition")
								else if not first_joined or not second_joined
									Err("concurrent shutdown caller did not complete normally")
								else if not buffered_report_is_completed(repeated)
									Err("interruption after closed changed the completed report")
								else if not buffered_no_selected_line(no_more)
									Err("concurrent shutdown started an extra destination call")
								else
									Ok(())
								end
								_ => Err("second concurrent shutdown caller observed a different report")
							end
							_ => Err("first concurrent shutdown caller observed an unexpected report")
						end
						_ => Err("admission that lost the close race changed exporter health")
						end
						_ => Err("handler metric that lost the close race changed retained, admitted, or dropped metric health")
					end
					_ => Err("admission that lost the close race was not closed")
				end
				_ => Err("record was not admitted before concurrent shutdown")
			end
		end
		_ => Err("concurrent shutdown exporter construction failed")
	end
end

test abnormal_worker_exit_while_open_freezes_exact_unsettled_accounting() -> Result<(), String> effects [time, concurrency]
	let events = channel::bounded<String>(3)
	let release = channel::bounded<()>(1)
	let constructed = handle new_buffered_failure_for_test(0, observe::NoDiagnosticDestination) with observe_test_support_test::late_completion_exporter(events.tx, release.rx)
	match constructed
		observe::BufferedJsonLines(exporter) => begin
			let admitted = handle observe::buffered_export_observation(exporter, buffered_log("open-in-flight")) with observe_test_support_test::clock(0)
			let started: Option<String> = channel::recv(events.rx)
			observe::cancel_buffered_worker_for_test(exporter)
			let report = observe::shutdown_buffered(exporter)
			let health = observe::buffered_exporter_health(exporter)
			let closed = handle observe::buffered_export_observation(exporter, buffered_log("after-open-exit")) with observe_test_support_test::clock(0)
			let _ = channel::send(release.tx, ())
			let late: Option<String> = channel::recv(events.rx)
			let repeated = observe::shutdown_buffered(exporter)
			match admitted
				observe::Accepted => match report
					observe::BufferedShutdownReport(observe::Interrupted, observe::ExporterHealth(1, 0, 0, 0, observe::ProductionHealth(0, 0, 0)), observe::SummaryNotAttempted) => match repeated
						observe::BufferedShutdownReport(observe::Interrupted, observe::ExporterHealth(1, 0, 0, 0, observe::ProductionHealth(0, 0, 0)), observe::SummaryNotAttempted) => match health
							observe::ExporterHealth(1, 0, 0, 0, observe::ProductionHealth(0, 0, 0)) => if not buffered_event_is(started, "record-started")
								Err(buffered_unexpected_event("open worker record start", started))
							else if not buffered_admission_is_closed(closed)
								Err("abnormal open worker exit left admission open")
							else if late == None
								Err("abnormal open worker exit did not permit the started host call to finish")
							else
								Ok(())
							end
							_ => Err("abnormal open worker exit did not freeze unsettled health")
						end
						_ => Err("late open-worker completion changed the frozen report")
					end
					_ => Err("abnormal open worker exit did not interrupt and account for its in-flight record")
				end
				_ => Err("open worker exit setup did not admit its record")
			end
		end
		_ => Err("open worker exit exporter construction failed")
	end
end

test interruption_freezes_metric_health_after_atomic_admission() -> Result<(), String> effects [time, concurrency]
	let interruption_entered = channel::bounded<()>(1)
	let interruption_release = channel::bounded<()>(1)
	let lines = observe_test_support_test::export_lines(1)
	let constructed = handle new_buffered_interruption_boundary_for_test(interruption_entered.tx, interruption_release.rx) with observe_test_support_test::exporter(lines.tx, true)
	match constructed
		observe::BufferedJsonLines(exporter) => begin
			let interruption = task::spawn_with(cancel_buffered_worker_task, exporter)
			let interruption_waiting: Option<()> = channel::recv(interruption_entered.rx)
			let emitted = handle handle handled_emit(buffered_named_metric("atomic-race"), 1) with observe::buffered_json_lines(exporter) with observe_test_support_test::clock(0)
			let _ = channel::send(interruption_release.tx, ())
			let interruption_result = task::join(interruption)
			let report = observe::shutdown_buffered(exporter)
			let health = observe::buffered_exporter_health(exporter)
			let no_call: Option<{ index : Int, value : String }> = channel::select_many_timeout(list_cons(lines.rx, list_nil()), 0)
			if not buffered_unit_received(interruption_waiting) or emitted != 1
				Err("metric admission and interruption did not reach the atomic boundary")
			else match interruption_result
				Ok(()) => match report
					observe::BufferedShutdownReport(observe::Interrupted, observe::ExporterHealth(1, 0, 0, 0, observe::ProductionHealth(1, 1, 0)), observe::SummaryNotAttempted) => match health
						observe::ExporterHealth(1, 0, 0, 0, observe::ProductionHealth(1, 1, 0)) => if buffered_no_selected_line(no_call)
							Ok(())
						else
							Err("atomic interruption started a destination call")
						end
						_ => Err("atomic interruption exposed stale metric health")
					end
					_ => Err("atomic interruption froze stale metric health")
				end
				Err(_) => Err("atomic interruption task did not complete normally")
			end
			end
		end
		_ => Err("atomic metric interruption exporter construction failed")
	end
end

test confirmed_record_outcome_survives_worker_cancellation_before_state_commit() -> Result<(), String> effects [time, concurrency]
	let entered = channel::bounded<()>(1)
	let release = channel::bounded<()>(1)
	let lines = observe_test_support_test::export_lines(1)
	let constructed = handle new_buffered_completion_for_test(0, observe::NoDiagnosticDestination, entered.tx, release.rx) with observe_test_support_test::exporter(lines.tx, true)
	match constructed
		observe::BufferedJsonLines(exporter) => begin
			let admitted = handle observe::buffered_export_observation(exporter, buffered_log("confirmed")) with observe_test_support_test::clock(0)
			let confirmed: Option<()> = channel::recv(entered.rx)
			observe::cancel_buffered_worker_for_test(exporter)
			let report = observe::shutdown_buffered(exporter)
			let line: Option<String> = channel::recv(lines.rx)
			match report
				observe::BufferedShutdownReport(observe::Interrupted, observe::ExporterHealth(0, 0, 0, 0, observe::ProductionHealth(0, 0, 0)), observe::SummaryNotAttempted) => if not buffered_admission_is_accepted(admitted)
					Err("confirmed record setup was not admitted")
				else if not buffered_unit_received(confirmed)
					Err("confirmed record cancellation did not reach its deterministic barrier")
				else if line == None
					Err("confirmed record did not reach its destination")
				else
					Ok(())
				end
				_ => Err("confirmed record was reclassified as unsettled by cancellation")
			end
		end
		_ => Err("confirmed record exporter construction failed")
	end
end

test confirmed_summary_outcome_closes_before_interruption_cleanup() -> Result<(), String> effects [concurrency]
	let entered = channel::bounded<()>(1)
	let release = channel::bounded<()>(1)
	let lines = observe_test_support_test::export_lines(1)
	let waiting = channel::bounded<()>(1)
	let constructed = handle new_buffered_completion_for_test(5, observe::DiagnosticStandardError, entered.tx, release.rx) with observe_test_support_test::exporter(lines.tx, true)
	match constructed
		observe::BufferedJsonLines(exporter) => begin
			let shutdown = task::spawn_with(shutdown_buffered_task_observed, { exporter: exporter, waiting: waiting.tx })
			let shutdown_waiting: Option<()> = channel::recv(waiting.rx)
			let confirmed: Option<()> = channel::recv(entered.rx)
			task::cancel(shutdown)
			let joined = task::join(shutdown)
			let report = observe::shutdown_buffered(exporter)
			let repeated = observe::shutdown_buffered(exporter)
			let line: Option<String> = channel::recv(lines.rx)
			match joined
				Err(error) => if task::join_error_is_cancelled(error)
					match report
						observe::BufferedShutdownReport(observe::Completed, observe::ExporterHealth(5, 0, 0, 0, observe::ProductionHealth(0, 0, 0)), observe::SummaryAccepted) => match repeated
							observe::BufferedShutdownReport(observe::Completed, observe::ExporterHealth(5, 0, 0, 0, observe::ProductionHealth(0, 0, 0)), observe::SummaryAccepted) => if not buffered_unit_received(shutdown_waiting) or not buffered_unit_received(confirmed)
								Err("confirmed summary cancellation did not reach both deterministic barriers")
							else if line == None
								Err("confirmed summary did not reach its destination")
							else
								Ok(())
							end
							_ => Err("interruption cleanup changed the report after confirmed summary closure")
						end
						_ => Err("confirmed summary was reclassified as rejected by cancellation")
					end
				else
					Err("confirmed summary shutdown lost abrupt cancellation")
				end
				Ok(_) => Err("confirmed summary shutdown completed normally after cancellation")
			end
		end
		_ => Err("confirmed summary exporter construction failed")
	end
end

test shutdown_cancellation_after_closed_is_abrupt_and_has_no_exporter_effect() -> Result<(), String> effects [time, concurrency]
	let events = channel::bounded<String>(4)
	let destination_release = channel::bounded<()>(2)
	let return_entered = channel::bounded<()>(1)
	let return_release = channel::bounded<()>(1)
	let constructed = handle new_buffered_failure_for_test(0, observe::DiagnosticStandardError) with observe_test_support_test::late_completion_exporter(events.tx, destination_release.rx)
	match constructed
		observe::BufferedJsonLines(exporter) => begin
			let admission = handle observe::buffered_export_observation(exporter, buffered_log("close-before-cancel")) with observe_test_support_test::clock(0)
			let record_started: Option<String> = channel::recv(events.rx)
			let _ = channel::send(destination_release.tx, ())
			let record_completed: Option<String> = channel::recv(events.rx)
			let shutdown = task::spawn_with(shutdown_buffered_task_at_return_boundary, { exporter: exporter, entered: return_entered.tx, release: return_release.rx })
			let summary_started: Option<String> = channel::recv(events.rx)
			let _ = channel::send(destination_release.tx, ())
			let summary_completed: Option<String> = channel::recv(events.rx)
			let closed_boundary: Option<()> = channel::recv(return_entered.rx)
			task::cancel(shutdown)
			let joined = task::join(shutdown)
			let repeated = observe::shutdown_buffered(exporter)
			let health = observe::buffered_exporter_health(exporter)
			let closed = handle observe::buffered_export_observation(exporter, buffered_log("after-closed-cancel")) with observe_test_support_test::clock(0)
			let no_more: Option<{ index : Int, value : String }> = channel::select_many_timeout(list_cons(events.rx, list_nil()), 0)
			match joined
				Err(error) => if task::join_error_is_cancelled(error) and buffered_admission_is_accepted(admission) and buffered_event_is(record_started, "record-started") and record_completed != None and buffered_event_is(summary_started, "summary-started") and summary_completed != None and buffered_unit_received(closed_boundary) and buffered_report_is_completed(repeated) and buffered_admission_is_closed(closed) and buffered_no_selected_line(no_more)
					match health
						observe::ExporterHealth(0, 0, 0, 0, observe::ProductionHealth(0, 0, 0)) => Ok(())
						_ => Err("cancellation after closed changed frozen health")
					end
				else
					Err("cancellation after closed changed the frozen report or destination calls")
				end
				Ok(_) => Err("shutdown cancellation after closed did not remain abrupt")
			end
		end
		_ => Err("shutdown cancellation after closed exporter construction failed")
	end
end

test interrupted_unsettled_accounting_saturates_failed_exports() -> Result<(), String> effects [time, concurrency]
	let maximum = 9223372036854775807
	let lines = observe_test_support_test::export_lines(1)
	let outcomes = channel::bounded<ExportWriteOutcome>(1)
	let _ = channel::send(outcomes.tx, observe_test_support_test::ContractFailWrite)
