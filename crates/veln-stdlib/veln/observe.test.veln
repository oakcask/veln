test exporter_health_totals_saturate_at_maximum_int() -> Result<(), String> effects [time, concurrency]
	let maximum = 9223372036854775807
	let resource = observe::Resource("checkout", list_nil())
	let scope = observe::InstrumentationScope("checkout.web", "1")
	let single = observe::new_json_lines_for_test(resource, scope, 1, observe::ExporterLimits(1, 4, 1, list_cons("long-name", list_nil())), observe::StandardError, observe::NoDiagnosticDestination, "single", maximum - 1, maximum - 1, maximum - 1, maximum - 1)
	let crossing = observe::new_json_lines_for_test(resource, scope, 1, observe::ExporterLimits(2, 4, 2, list_cons("first-long", list_cons("second-long", list_nil()))), observe::StandardError, observe::NoDiagnosticDestination, "crossing", maximum - 1, maximum - 1, maximum - 1, maximum - 1)
	observe_export_test_support_test::saturating_exporter_health(single, crossing)
end

