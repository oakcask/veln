test buffered_constructor_rejects_non_positive_capacity_without_destination_effects() -> Result<(), String> effects [concurrency]
	let lines = observe_test_support_test::export_lines(1)
	let zero = handle new_buffered_for_test(0, observe::DiagnosticStandardError) with observe_test_support_test::exporter(lines.tx, true)
	let negative = handle new_buffered_for_test(-7, observe::DiagnosticStandardError) with observe_test_support_test::exporter(lines.tx, true)
	match zero
		observe::InvalidCapacity(0) => match negative
			observe::InvalidCapacity(value) => if value == -7
				match channel::select_many_timeout(list_cons(lines.rx, list_nil()), 0)
					None => Ok(())
					Some(_) => Err("invalid buffered capacity performed destination I/O")
				end
			else
				Err("negative buffered capacity changed its reported value")
			end
			_ => Err("negative buffered capacity was accepted")
		end
		_ => Err("zero buffered capacity was accepted")
	end
end

test buffered_constructor_accepts_positive_capacity_above_backend_channel_limit_and_performs_no_destination_io() -> Result<(), String> effects [concurrency]
	let lines = observe_test_support_test::export_lines(1)
	let constructed = handle new_buffered_for_test(2147483648, observe::DiagnosticStandardError) with observe_test_support_test::exporter(lines.tx, true)
	match constructed
		observe::BufferedJsonLines(exporter) => begin
			match channel::select_many_timeout(list_cons(lines.rx, list_nil()), 0)
				Some(_) => Err("large logical buffered capacity performed destination I/O during construction")
				None => begin
					let _ = observe::shutdown_buffered(exporter)
					Ok(())
				end
			end
		end
		observe::InvalidCapacity(_) => Err("positive logical buffered capacity above the backend channel limit was rejected")
	end
end

test buffered_invalid_record_reports_outcome_without_record_destination_attempt() -> Result<(), String> effects [time, concurrency]
	let lines = observe_test_support_test::export_lines(2)
	let constructed = handle new_buffered_for_test(1, observe::DiagnosticStandardError) with observe_test_support_test::exporter(lines.tx, true)
	match constructed
		observe::BufferedJsonLines(exporter) => begin
			let invalid = observe::Log(observe::LogRecord("log", observe::Info, "invalid", list_nil(), Some(observe::TraceContext("", "span", true)), callsite_location()))
			let outcome = handle observe::buffered_export_observation(exporter, invalid) with observe_test_support_test::clock(0)
			let before_shutdown: Option<{ index : Int, value : String }> = channel::select_many_timeout(list_cons(lines.rx, list_nil()), 0)
			let report = observe::shutdown_buffered(exporter)
			match outcome
				observe::InvalidRecord => match before_shutdown
					None => match report
						observe::BufferedShutdownReport(observe::Completed, observe::ExporterHealth(1, 0, 0, 0, observe::ProductionHealth(0, 0, 0)), observe::SummaryAccepted) => match channel::recv(lines.rx)
							Some(summary) => if buffered_contains(summary, "diagnostic:stderr:{\"schema_version\":1,\"kind\":\"exporter_health\"")
								Ok(())
							else
								Err("invalid buffered record changed the final summary destination")
							end
							None => Err("invalid buffered record shutdown emitted no summary")
						end
						_ => Err("invalid buffered record changed completed health")
					end
					Some(_) => Err("invalid buffered record reached the record destination")
				end
				_ => Err("invalid buffered record did not return InvalidRecord")
			end
		end
		_ => Err("positive buffered capacity was rejected")
	end
end

test buffered_capacity_counts_in_flight_and_releases_after_completion() -> Result<(), String> effects [time, concurrency]
	let lines = observe_test_support_test::export_lines(7)
	let release = channel::bounded<()>(3)
	let idle = channel::bounded<()>(3)
	let resume = channel::bounded<()>(3)
	let constructed = handle new_buffered_for_test_with_idle_hook(1, observe::DiagnosticStandardError, idle.tx, resume.rx) with observe_test_support_test::controlled_record_exporter(lines.tx, release.rx)
	match constructed
		observe::BufferedJsonLines(exporter) => begin
			let first = handle observe::buffered_export_observation(exporter, buffered_log("first")) with observe_test_support_test::clock(0)
			match channel::recv(lines.rx)
				Some(first_line) => begin
					let second = handle observe::buffered_export_observation(exporter, buffered_log("full")) with observe_test_support_test::clock(0)
					let full_health = observe::buffered_exporter_health(exporter)
					let _ = channel::send(release.tx, ())
					match channel::recv(idle.rx)
						Some(_) => begin
							let outstanding = observe::buffered_outstanding_for_test(exporter)
							let third = handle observe::buffered_export_observation(exporter, buffered_log("second")) with observe_test_support_test::clock(0)
							let _ = channel::send(resume.tx, ())
							let second_line = channel::recv(lines.rx)
							let _ = channel::send(release.tx, ())
							let second_idle = channel::recv(idle.rx)
							let fourth = handle observe::buffered_export_observation(exporter, buffered_log("third")) with observe_test_support_test::clock(0)
							let _ = channel::send(resume.tx, ())
							let third_line = channel::recv(lines.rx)
							let _ = channel::send(release.tx, ())
							let third_idle = channel::recv(idle.rx)
							let _ = channel::send(resume.tx, ())
							let report = observe::shutdown_buffered(exporter)
							match first
								observe::Accepted => match second
									observe::Full => match full_health
										observe::ExporterHealth(1, 0, 0, 0, observe::ProductionHealth(0, 0, 0)) => match third
											observe::Accepted => match fourth
												observe::Accepted => match report
													observe::BufferedShutdownReport(observe::Completed, observe::ExporterHealth(1, 0, 0, 0, observe::ProductionHealth(0, 0, 0)), observe::SummaryAccepted) => if outstanding == 0 and buffered_contains(first_line, "\"message\":\"first\"") and buffered_line_contains(second_line, "\"message\":\"second\"") and buffered_line_contains(third_line, "\"message\":\"third\"") and buffered_idle(second_idle) and buffered_idle(third_idle)
														Ok(())
													else
														Err("buffered repeated slot release or destination order changed")
													end
													_ => Err("buffered shutdown report did not retain the full rejection")
												end
												_ => Err("second buffered readmission did not return before its destination release")
											end
											_ => Err("buffered capacity did not admit after first destination completion")
									end
										_ => Err("buffered full admission did not increment failed exports once")
								end
									_ => Err("buffered capacity one did not report Full")
							end
								_ => Err("first buffered record was not accepted")
							end
						end
						None => Err("buffered idle signal closed before slot release")
					end
				end
				None => Err("accepted buffered record did not start its destination attempt")
			end
		end
		_ => Err("positive buffered capacity was rejected")
	end
end

fn buffered_line_contains(line: Option<String>, fragment: String) -> Bool
	match line
		Some(value) => buffered_contains(value, fragment)
		None => false
	end
end

fn buffered_idle(value: Option<()>) -> Bool
	match value
		Some(_) => true
		None => false
	end
end

fn exercise_buffered_idle_cycles(exporter: BufferedJsonLinesExporter, lines: Receiver<String>, release: Sender<()>, idle: Receiver<()>, resume: Sender<()>, remaining: Int) -> Result<(), String> effects [time, concurrency]
	match channel::recv(lines)
		Some(_) => begin
			let _ = channel::send(release, ())
			match channel::recv(idle)
				Some(_) => if observe::buffered_outstanding_for_test(exporter) == 0
					if remaining <= 1
						begin
							let _ = channel::send(resume, ())
							Ok(())
						end
					else
						match handle observe::buffered_export_observation(exporter, buffered_log("idle-cycle")) with observe_test_support_test::clock(0)
							observe::Accepted => begin
								let _ = channel::send(resume, ())
								exercise_buffered_idle_cycles(exporter, lines, release, idle, resume, remaining - 1)
							end
							_ => Err("buffered exporter rejected a record after reaching idle")
						end
					end
				else
					Err("buffered exporter reached idle with an outstanding record")
				end
				None => Err("buffered idle signal closed during repeated wake cycles")
			end
		end
		None => Err("buffered destination closed during repeated wake cycles")
	end
end

test buffered_worker_is_stack_bounded_across_repeated_idle_wake_cycles() -> Result<(), String> effects [time, concurrency]
	let lines = observe_test_support_test::export_lines(2)
	let release = channel::bounded<()>(1)
	let idle = channel::bounded<()>(1)
	let resume = channel::bounded<()>(1)
	let constructed = handle new_buffered_for_test_with_idle_hook(1, observe::DiagnosticStandardError, idle.tx, resume.rx) with observe_test_support_test::controlled_record_exporter(lines.tx, release.rx)
	match constructed
		observe::BufferedJsonLines(exporter) => match handle observe::buffered_export_observation(exporter, buffered_log("idle-cycle")) with observe_test_support_test::clock(0)
			observe::Accepted => match exercise_buffered_idle_cycles(exporter, lines.rx, release.tx, idle.rx, resume.tx, 1001)
				Ok(_) => begin
					let report = observe::shutdown_buffered(exporter)
					let summary = channel::recv(lines.rx)
					let repeated = observe::shutdown_buffered(exporter)
					let frozen_health = observe::buffered_exporter_health(exporter)
					let no_more: Option<{ index : Int, value : String }> = channel::select_many_timeout(list_cons(lines.rx, list_nil()), 0)
					match report
						observe::BufferedShutdownReport(observe::Completed, observe::ExporterHealth(0, 0, 0, 0, observe::ProductionHealth(0, 0, 0)), observe::SummaryAccepted) => match repeated
							observe::BufferedShutdownReport(observe::Completed, observe::ExporterHealth(0, 0, 0, 0, observe::ProductionHealth(0, 0, 0)), observe::SummaryAccepted) => match frozen_health
								observe::ExporterHealth(0, 0, 0, 0, observe::ProductionHealth(0, 0, 0)) => if buffered_line_contains(summary, "\"kind\":\"exporter_health\"")
									match no_more
										None => Ok(())
										Some(_) => Err("repeated shutdown after idle cycles emitted another summary")
									end
								else
									Err("idle-cycle shutdown did not emit the final health summary")
								end
								_ => Err("idle-cycle shutdown did not freeze exporter health")
							end
							_ => Err("later idle-cycle shutdown did not return the frozen report")
						end
						_ => Err("normal shutdown after idle cycles did not complete")
					end
				end
				Err(error) => Err(error)
			end
			_ => Err("buffered exporter rejected the first idle-cycle record")
		end
		_ => Err("positive buffered capacity was rejected")
	end
end

test buffered_shutdown_drains_in_order_then_freezes_completed_report() -> Result<(), String> effects [time, concurrency]
	let lines = observe_test_support_test::export_lines(6)
	let release = channel::bounded<()>(4)
	let constructed = handle new_buffered_for_test(4, observe::DiagnosticStandardError) with observe_test_support_test::controlled_record_exporter(lines.tx, release.rx)
	match constructed
		observe::BufferedJsonLines(exporter) => begin
			let log_result = handle observe::buffered_export_observation(exporter, buffered_log("first")) with observe_test_support_test::clock(0)
			let event_result = handle observe::buffered_export_observation(exporter, observe::Event(observe::EventRecord("second", list_nil(), None, callsite_location()))) with observe_test_support_test::clock(0)
			let counter_result = handle observe::buffered_export_observation(exporter, observe::CounterIncrement(observe::CounterIncrementRecord("third", 3, list_nil(), None, callsite_location()))) with observe_test_support_test::clock(0)
			let histogram_result = handle observe::buffered_export_observation(exporter, observe::HistogramSample(observe::HistogramSampleRecord("fourth", 4, list_nil(), None, callsite_location()))) with observe_test_support_test::clock(0)
			let shutdown: Task<BufferedShutdownReport> = task::spawn_with(shutdown_buffered_task, exporter)
			let first = channel::recv(lines.rx)
			let _ = channel::send(release.tx, ())
			let second = channel::recv(lines.rx)
			let _ = channel::send(release.tx, ())
			let third = channel::recv(lines.rx)
			let _ = channel::send(release.tx, ())
			let fourth = channel::recv(lines.rx)
			let _ = channel::send(release.tx, ())
			let summary = channel::recv(lines.rx)
			match task::join(shutdown)
				Ok(report) => begin
					let repeated = observe::shutdown_buffered(exporter)
					let late = handle observe::buffered_export_observation(exporter, buffered_log("late")) with observe_test_support_test::clock(0)
					let frozen_health = observe::buffered_exporter_health(exporter)
					let no_more: Option<{ index : Int, value : String }> = channel::select_many_timeout(list_cons(lines.rx, list_nil()), 0)
					match log_result
						observe::Accepted => match event_result
							observe::Accepted => match counter_result
								observe::Accepted => match histogram_result
									observe::Accepted => if buffered_lines_are_ordered(first, second, third, fourth, summary)
									match report
										observe::BufferedShutdownReport(observe::Completed, observe::ExporterHealth(0, 0, 0, 0, observe::ProductionHealth(0, 0, 0)), observe::SummaryAccepted) => match repeated
											observe::BufferedShutdownReport(observe::Completed, observe::ExporterHealth(0, 0, 0, 0, observe::ProductionHealth(0, 0, 0)), observe::SummaryAccepted) => match late
												observe::Closed => match no_more
													None => match frozen_health
														observe::ExporterHealth(0, 0, 0, 0, observe::ProductionHealth(0, 0, 0)) => Ok(())
														_ => Err("buffered health did not return the frozen completed health")
													end
													Some(_) => Err("repeated buffered shutdown emitted another summary")
												end
												_ => Err("buffered exporter admitted a record after shutdown")
											end
											_ => Err("repeated buffered shutdown did not return the frozen report")
										end
										_ => Err("buffered shutdown did not return its completed report")
									end
								else
									Err("buffered shutdown changed destination or summary order")
								end
									_ => Err("buffered histogram was not accepted")
								end
								_ => Err("buffered counter was not accepted")
							end
							_ => Err("buffered event was not accepted")
						end
						_ => Err("buffered log was not accepted")
					end
				end
				Err(_) => Err("buffered shutdown task failed")
			end
		end
		_ => Err("positive buffered capacity was rejected")
	end
end

fn buffered_lines_are_ordered(first: Option<String>, second: Option<String>, third: Option<String>, fourth: Option<String>, summary: Option<String>) -> Bool
	match first
		Some(first_line) => match second
			Some(second_line) => match third
				Some(third_line) => match fourth
					Some(fourth_line) => match summary
						Some(summary_line) => buffered_contains(first_line, "\"sequence\":1,") and buffered_contains(first_line, "\"message\":\"first\"") and buffered_contains(second_line, "\"sequence\":2,") and buffered_contains(second_line, "\"name\":\"second\"") and buffered_contains(third_line, "\"sequence\":3,") and buffered_contains(third_line, "\"kind\":\"counter\"") and buffered_contains(third_line, "\"name\":\"third\"") and buffered_contains(fourth_line, "\"sequence\":4,") and buffered_contains(fourth_line, "\"kind\":\"histogram\"") and buffered_contains(fourth_line, "\"name\":\"fourth\"") and buffered_contains(summary_line, "diagnostic:stderr:{\"schema_version\":1,\"kind\":\"exporter_health\"")
						None => false
					end
					None => false
				end
				None => false
			end
			None => false
		end
		None => false
	end
end

fn buffered_contains(text: String, fragment: String) -> Bool
	match string_split_once(text, fragment)
		Some(_) => true
		None => false
	end
end

fn handled_emit(record: Observation, result: Int) -> Int effects [observe::Observe]
	perform observe::Observe::emit(record)
	result
end

test buffered_handler_orders_cardinality_validation_capacity_and_sequence_gaps() -> Result<(), String> effects [time, concurrency]
	let lines = observe_test_support_test::export_lines(3)
	let release = channel::bounded<()>(2)
	let idle = channel::bounded<()>(2)
	let resume = channel::bounded<()>(2)
	let constructed = handle new_buffered_matrix_for_test(idle.tx, resume.rx) with observe_test_support_test::controlled_record_exporter(lines.tx, release.rx)
	match constructed
		observe::BufferedJsonLines(exporter) => begin
			let first_result = handle handle handled_emit(buffered_log("first"), 11) with observe::buffered_json_lines(exporter) with observe_test_support_test::clock(0)
			let first_line = channel::recv(lines.rx)
			let transforming = list_cons(observe::Attribute("secret", observe::StringValue("long-value")), list_nil())
			let invalid = observe::CounterIncrement(observe::CounterIncrementRecord("invalid", 1, transforming, Some(observe::TraceContext("", "span", true)), callsite_location()))
			let invalid_result = handle handle handled_emit(invalid, 12) with observe::buffered_json_lines(exporter) with observe_test_support_test::clock(0)
			let full = observe::HistogramSample(observe::HistogramSampleRecord("full", 2, transforming, None, callsite_location()))
			let full_result = handle handle handled_emit(full, 13) with observe::buffered_json_lines(exporter) with observe_test_support_test::clock(0)
			let rejected = observe::CounterIncrement(observe::CounterIncrementRecord("rejected", 3, list_nil(), None, callsite_location()))
			let rejected_result = handle handle handled_emit(rejected, 14) with observe::buffered_json_lines(exporter) with observe_test_support_test::clock(0)
			let before_release = observe::buffered_exporter_health(exporter)
			let _ = channel::send(release.tx, ())
			let _ = channel::recv(idle.rx)
			let last_result = handle handle handled_emit(buffered_log("last"), 15) with observe::buffered_json_lines(exporter) with observe_test_support_test::clock(0)
			let _ = channel::send(resume.tx, ())
			let last_line = channel::recv(lines.rx)
			let _ = channel::send(release.tx, ())
			let _ = channel::recv(idle.rx)
			let _ = channel::send(resume.tx, ())
			let report = observe::shutdown_buffered(exporter)
			if first_result == 11 and invalid_result == 12 and full_result == 13 and rejected_result == 14 and last_result == 15 and buffered_sequence_gap(first_line, last_line)
				match before_release
					observe::ExporterHealth(2, 0, 0, 0, observe::ProductionHealth(2, 2, 1)) => match report
						observe::BufferedShutdownReport(observe::Completed, observe::ExporterHealth(2, 0, 0, 0, observe::ProductionHealth(2, 2, 1)), _) => Ok(())
						_ => Err("buffered matrix shutdown changed retained admission facts")
					end
					_ => Err("buffered handler changed validation, capacity, transformation, or cardinality ordering")
				end
			else
				Err("buffered handler changed a body result or accepted sequence gaps")
			end
		end
		_ => Err("buffered matrix exporter construction failed")
	end
end

fn buffered_sequence_gap(first: Option<String>, last: Option<String>) -> Bool
	match first
		Some(first_line) => match last
			Some(last_line) => buffered_contains(first_line, "\"sequence\":1,") and buffered_contains(last_line, "\"sequence\":4,") and buffered_contains(last_line, "\"message\":\"last\"")
			None => false
		end
		None => false
	end
end

test buffered_rejected_span_start_returns_handle_and_finish_retries_admission() -> Result<(), String> effects [time, concurrency]
	let lines = observe_test_support_test::export_lines(3)
	let release = channel::bounded<()>(2)
	let idle = channel::bounded<()>(2)
	let resume = channel::bounded<()>(2)
	let constructed = handle new_buffered_for_test_with_idle_hook(1, observe::NoDiagnosticDestination, idle.tx, resume.rx) with observe_test_support_test::controlled_record_exporter(lines.tx, release.rx)
	match constructed
		observe::BufferedJsonLines(exporter) => begin
			let first = handle observe::buffered_export_observation(exporter, buffered_log("occupy")) with observe_test_support_test::clock(0)
			let first_line = channel::recv(lines.rx)
			let started = handle handle observe::buffered_start_export_span(exporter, observe::SpanRequest("retry", None, list_nil())) with observe_test_support_test::clock(0) with observe_test_support_test::exporter(lines.tx, true)
			match started
				observe::BufferedSpanStart(span, observe::Full) => match observe::context(span)
					Some(_) => begin
						let _ = channel::send(release.tx, ())
						let _ = channel::recv(idle.rx)
						let finish = handle observe::buffered_finish_export_span(exporter, observe::finish(span)) with observe_test_support_test::clock(0)
						let _ = channel::send(resume.tx, ())
						let finish_line = channel::recv(lines.rx)
						let _ = channel::send(release.tx, ())
						let _ = channel::recv(idle.rx)
						let _ = channel::send(resume.tx, ())
						let report = observe::shutdown_buffered(exporter)
						match first
							observe::Accepted => match finish
								observe::Accepted => if buffered_span_retry_lines(first_line, finish_line)
									match report
										observe::BufferedShutdownReport(observe::Completed, observe::ExporterHealth(1, 0, 0, 0, _), _) => Ok(())
										_ => Err("rejected span start changed finish or shutdown health")
									end
								else
									Err("span finish did not preserve the rejected-start sequence gap")
								end
								_ => Err("span finish did not make an independent admission attempt")
							end
							_ => Err("occupying record was not admitted")
						end
					end
					None => Err("rejected span start did not return its allocated handle")
				end
				_ => Err("span start at capacity did not return its handle with Full")
			end
		end
		_ => Err("buffered span exporter construction failed")
	end
end

fn buffered_span_retry_lines(first: Option<String>, finish: Option<String>) -> Bool
	match first
		Some(first_line) => match finish
			Some(finish_line) => buffered_contains(first_line, "\"sequence\":1,") and buffered_contains(finish_line, "\"sequence\":3,") and buffered_contains(finish_line, "\"kind\":\"span_finish\"")
			None => false
		end
		None => false
	end
end

test buffered_invalid_span_start_returns_allocated_handle_and_finish_is_admitted() -> Result<(), String> effects [time, concurrency]
	let lines = observe_test_support_test::export_lines(2)
	let constructed = handle new_buffered_for_test(1, observe::NoDiagnosticDestination) with observe_test_support_test::exporter(lines.tx, true)
	match constructed
		observe::BufferedJsonLines(exporter) => begin
			let invalid_link = observe::TraceContext("", "linked-span", true)
			let started = handle handle observe::buffered_start_export_span(exporter, observe::SpanRequest("invalid-link", None, list_cons(invalid_link, list_nil()))) with observe_test_support_test::clock(0) with observe_test_support_test::exporter(lines.tx, true)
			let after_start = observe::buffered_exporter_health(exporter)
			let start_destination: Option<{ index : Int, value : String }> = channel::select_many_timeout(list_cons(lines.rx, list_nil()), 0)
			match started
				observe::BufferedSpanStart(span, observe::InvalidRecord) => match observe::context(span)
					Some(observe::TraceContext("fixed-trace-1", "fixed-span-1", true)) => begin
						let finish = handle observe::buffered_finish_export_span(exporter, observe::finish(span)) with observe_test_support_test::clock(0)
						let finish_line: Option<String> = channel::recv(lines.rx)
						let report = observe::shutdown_buffered(exporter)
						match after_start
							observe::ExporterHealth(1, 0, 0, 0, observe::ProductionHealth(0, 0, 0)) => match start_destination
								None => match finish
									observe::Accepted => match finish_line
										Some(line) => if buffered_contains(line, "\"sequence\":2,") and buffered_contains(line, "\"kind\":\"span_finish\"") and buffered_contains(line, "\"trace_id\":\"fixed-trace-1\"") and buffered_contains(line, "\"span_id\":\"fixed-span-1\"")
											match report
												observe::BufferedShutdownReport(observe::Completed, observe::ExporterHealth(1, 0, 0, 0, observe::ProductionHealth(0, 0, 0)), _) => Ok(())
												_ => Err("invalid span start changed completed exporter health")
											end
										else
											Err("accepted span finish did not expose the invalid-start sequence gap or context")
										end
										None => Err("accepted span finish did not reach the destination")
									end
									_ => Err("finish after an invalid span start was not admitted independently")
								end
								Some(_) => Err("invalid span start reached the destination")
							end
							_ => Err("invalid span start changed unrelated exporter health facts")
						end
					end
					_ => Err("invalid span start did not retain its allocated context")
				end
				_ => Err("invalid linked context did not return the span with InvalidRecord")
			end
		end
		_ => Err("buffered invalid-span exporter construction failed")
	end
end

test buffered_non_exporter_span_finish_is_immediate_and_preserves_state() -> Result<(), String> effects [time, concurrency]
	let lines = observe_test_support_test::export_lines(1)
	let constructed = handle new_buffered_for_test(1, observe::NoDiagnosticDestination) with observe_test_support_test::exporter(lines.tx, true)
	match constructed
		observe::BufferedJsonLines(exporter) => begin
			let span = handle perform observe::Observe::start_span(observe::SpanRequest("noop", None, list_nil())) with observe::noop()
			let before = observe::buffered_exporter_health(exporter)
			let outcome = observe::buffered_finish_export_span(exporter, observe::finish(span))
			let after = observe::buffered_exporter_health(exporter)
			let destination: Option<{ index : Int, value : String }> = channel::select_many_timeout(list_cons(lines.rx, list_nil()), 0)
			let admitted = handle observe::buffered_export_observation(exporter, buffered_log("after non-exporter finish")) with observe_test_support_test::clock(0)
			let admitted_line: Option<String> = channel::recv(lines.rx)
			let report = observe::shutdown_buffered(exporter)
			match before
				observe::ExporterHealth(0, 0, 0, 0, observe::ProductionHealth(0, 0, 0)) => match outcome
					observe::InvalidRecord => match after
						observe::ExporterHealth(0, 0, 0, 0, observe::ProductionHealth(0, 0, 0)) => match destination
							None => match admitted
								observe::Accepted => match admitted_line
									Some(line) => if buffered_contains(line, "\"sequence\":1,") and buffered_contains(line, "\"message\":\"after non-exporter finish\"")
										match report
											observe::BufferedShutdownReport(observe::Completed, observe::ExporterHealth(0, 0, 0, 0, observe::ProductionHealth(0, 0, 0)), _) => Ok(())
											_ => Err("non-exporter span finish changed the completed report")
										end
									else
										Err("non-exporter span finish consumed a sequence")
									end
									None => Err("record after non-exporter span finish did not reach the destination")
								end
								_ => Err("record after non-exporter span finish was not admitted")
							end
							Some(_) => Err("non-exporter span finish reached the destination")
						end
						_ => Err("non-exporter span finish changed exporter health or sequence state")
					end
					_ => Err("non-exporter buffered span finish did not return InvalidRecord")
				end
				_ => Err("new buffered exporter did not start with empty health")
			end
		end
		_ => Err("buffered non-exporter-finish construction failed")
	end
end

fn handled_rejected_span_retry(release: Sender<()>, idle: Receiver<()>) -> Bool effects [observe::Observe, concurrency]
	let span = perform observe::Observe::start_span(observe::SpanRequest("handler-retry", None, list_nil()))
	let allocated = match observe::context(span)
		Some(_) => true
		None => false
	end
	let _ = channel::send(release, ())
	let _ = channel::recv(idle)
	perform observe::Observe::finish_span(observe::finish(span))
	allocated
end

test buffered_handler_consumes_rejected_start_and_independently_admits_finish() -> Result<(), String> effects [time, concurrency]
	let lines = observe_test_support_test::export_lines(3)
	let release = channel::bounded<()>(2)
	let idle = channel::bounded<()>(2)
	let resume = channel::bounded<()>(2)
	let constructed = handle new_buffered_for_test_with_idle_hook(1, observe::NoDiagnosticDestination, idle.tx, resume.rx) with observe_test_support_test::controlled_record_exporter(lines.tx, release.rx)
	match constructed
		observe::BufferedJsonLines(exporter) => begin
			let first = handle observe::buffered_export_observation(exporter, buffered_log("occupy-handler")) with observe_test_support_test::clock(0)
			let first_line = channel::recv(lines.rx)
			let allocated = handle handle handle handled_rejected_span_retry(release.tx, idle.rx) with observe::buffered_json_lines(exporter) with observe_test_support_test::clock(0) with observe_test_support_test::exporter(lines.tx, true)
			let _ = channel::send(resume.tx, ())
			let finish_line = channel::recv(lines.rx)
			let _ = channel::send(release.tx, ())
			let _ = channel::recv(idle.rx)
			let _ = channel::send(resume.tx, ())
			let report = observe::shutdown_buffered(exporter)
			match first
				observe::Accepted => if allocated and buffered_span_retry_lines(first_line, finish_line)
					match report
						observe::BufferedShutdownReport(observe::Completed, observe::ExporterHealth(1, 0, 0, 0, _), _) => Ok(())
						_ => Err("buffered handler rejection changed finish or shutdown health")
					end
				else
					Err("buffered handler did not preserve the rejected handle or independently admit finish")
				end
				_ => Err("handler rejection occupying record was not admitted")
			end
		end
		_ => Err("buffered handler rejection exporter construction failed")
	end
end

fn controlled_buffered_span_allocation(context: { exporter : BufferedJsonLinesExporter, request : SpanRequest, entered : Sender<()>, release : Receiver<()>, completed : Sender<()>, kind : String, fail : Bool }) -> BufferedSpanStart effects [time, concurrency]
	defer
		let _ = channel::send(context.completed, ())
		()
	end
	handle handle observe::buffered_start_export_span(context.exporter, context.request) with observe_test_support_test::clock(0) with observe_test_support_test::controlled_identity_exporter(context.entered, context.release, context.kind, context.fail)
end

fn buffered_span_request_for_identity(kind: String) -> SpanRequest
	if kind == "trace"
		observe::SpanRequest("controlled", None, list_nil())
	else
		observe::SpanRequest("controlled", Some(observe::TraceContext("parent-trace", "parent-span", true)), list_nil())
	end
end

fn buffered_allocator_remains_usable_after_aborted_identity(kind: String, fail: Bool) -> Result<(), String> effects [time, concurrency]
	let lines = observe_test_support_test::export_lines(2)
	let constructed = handle new_buffered_for_test(2, observe::NoDiagnosticDestination) with observe_test_support_test::exporter(lines.tx, true)
	match constructed
		observe::BufferedJsonLines(exporter) => begin
			let entered = channel::bounded<()>(1)
			let release = channel::bounded<()>(1)
			let completed = channel::bounded<()>(1)
			let request = buffered_span_request_for_identity(kind)
			let worker = task::spawn_with(controlled_buffered_span_allocation, { exporter: exporter, request: request, entered: entered.tx, release: release.rx, completed: completed.tx, kind: kind, fail: fail })
			let started: Option<()> = channel::recv(entered.rx)
			if fail
				()
			else
				task::cancel(worker)
			end
			let _ = channel::send(release.tx, ())
			let aborted = if fail
				match channel::recv(completed.rx)
					Some(_) => true
					None => false
				end
			else
				match task::join(worker)
					Err(error) => task::join_error_is_cancelled(error)
					Ok(_) => false
				end
			end
			let retried = handle handle observe::buffered_start_export_span(exporter, request) with observe_test_support_test::clock(0) with observe_test_support_test::exporter(lines.tx, true)
			let report = observe::shutdown_buffered(exporter)
			match started
				Some(_) => if aborted and buffered_retried_identity_matches(retried, kind)
					match report
						observe::BufferedShutdownReport(observe::Completed, observe::ExporterHealth(0, 0, 0, 0, _), _) => Ok(())
						_ => Err("retry after aborted buffered span allocation changed shutdown health")
					end
				else
					Err("aborted buffered identity allocation did not restore its token")
				end
				None => Err("buffered identity allocation did not reach its deterministic boundary")
			end
		end
		_ => Err("buffered identity recovery exporter construction failed")
	end
end

fn buffered_retried_identity_matches(retried: BufferedSpanStart, kind: String) -> Bool
	match retried
		observe::BufferedSpanStart(span, observe::Accepted) => match observe::context(span)
			Some(observe::TraceContext(trace_id, "fixed-span-1", true)) => if kind == "trace"
				trace_id == "fixed-trace-1"
			else
				trace_id == "parent-trace"
			end
			_ => false
		end
		_ => false
	end
end

test buffered_span_allocator_restores_identity_after_cancellation_and_runtime_failure() -> Result<(), String> effects [time, concurrency]
	let _ = buffered_allocator_remains_usable_after_aborted_identity("trace", false)?
	let _ = buffered_allocator_remains_usable_after_aborted_identity("span", false)?
	let _ = buffered_allocator_remains_usable_after_aborted_identity("trace", true)?
	buffered_allocator_remains_usable_after_aborted_identity("span", true)
end

fn handled_span_emit(name: String, result: Int) -> Int effects [observe::Observe] callsite
	let span = perform observe::Observe::start_span(observe::SpanRequest(name, None, list_nil()))
	perform observe::Observe::emit(observe::Log(observe::LogRecord("log", observe::Info, name, list_nil(), observe::context(span), callsite)))
	perform observe::Observe::finish_span(observe::finish(span))
	result
end

fn child_handled_span(name: String) -> Int effects [observe::Observe]
	handled_span_emit(name, 23)
end

test buffered_handler_is_shared_with_children_restored_after_nesting_and_state_is_independent() -> Result<(), String> effects [time, concurrency]
	let outer_lines = observe_test_support_test::export_lines(8)
	let inner_lines = observe_test_support_test::export_lines(4)
	let outer_constructed = handle new_buffered_for_test(8, observe::NoDiagnosticDestination) with observe_test_support_test::exporter(outer_lines.tx, true)
	let inner_constructed = handle new_buffered_for_test(4, observe::NoDiagnosticDestination) with observe_test_support_test::exporter(inner_lines.tx, true)
	match outer_constructed
		observe::BufferedJsonLines(outer) => match inner_constructed
			observe::BufferedJsonLines(inner) => begin
				let outcomes = handle handle handle begin
					let child = task::spawn_with(child_handled_span, "child")
					let parent = handled_span_emit("parent", 29)
					let joined = task::join(child)
					let nested = handle handle handled_span_emit("inner", 31) with observe::buffered_json_lines(inner) with observe_test_support_test::exporter(inner_lines.tx, true)
					let restored = handled_emit(buffered_log("restored"), 37)
					{ parent: parent, joined: joined, nested: nested, restored: restored }
				end with observe::buffered_json_lines(outer) with observe_test_support_test::clock(0) with observe_test_support_test::exporter(outer_lines.tx, true)
				let outer_report = observe::shutdown_buffered(outer)
				let inner_report = observe::shutdown_buffered(inner)
				match outcomes.joined
					Ok(child_result) => if outcomes.parent == 29 and child_result == 23 and outcomes.nested == 31 and outcomes.restored == 37 and buffered_lines_have_sequences(outer_lines.rx, 1, 7) and buffered_lines_have_sequences(inner_lines.rx, 1, 3)
						match outer_report
							observe::BufferedShutdownReport(observe::Completed, observe::ExporterHealth(0, 0, 0, 0, observe::ProductionHealth(0, 0, 0)), _) => match inner_report
								observe::BufferedShutdownReport(observe::Completed, observe::ExporterHealth(0, 0, 0, 0, observe::ProductionHealth(0, 0, 0)), _) => Ok(())
								_ => Err("independent nested buffered exporter changed its own health")
							end
							_ => Err("child-shared outer buffered exporter changed its health")
						end
					else
						Err("buffered handler scope did not preserve results, child sharing, restoration, or independent sequence state")
					end
					Err(_) => Err("child using the inherited buffered handler did not complete")
				end
			end
			_ => Err("inner buffered exporter construction failed")
		end
		_ => Err("outer buffered exporter construction failed")
	end
end

fn buffered_independent_metric() -> Observation callsite
	observe::CounterIncrement(observe::CounterIncrementRecord("shared-series", 1, list_nil(), None, callsite))
end

fn buffered_invalid_log() -> Observation callsite
	observe::Log(observe::LogRecord("log", observe::Info, "invalid", list_nil(), Some(observe::TraceContext("", "span", true)), callsite))
end

fn new_independent_buffered_for_test() -> BufferedJsonLinesConstruction effects [concurrency]
	observe::new_buffered_json_lines(
		observe::Resource("independent", list_nil()),
		observe::InstrumentationScope("scope", "1"),
		1,
		observe::ExporterLimits(8, 64, 2, list_nil()),
		observe::StandardError,
		observe::NoDiagnosticDestination,
		"independent",
		1,
	)
end

test independently_constructed_buffered_exporters_do_not_share_cardinality_health_or_queue_state() -> Result<(), String> effects [time, concurrency]
	let outer_lines = observe_test_support_test::export_lines(2)
	let inner_lines = observe_test_support_test::export_lines(2)
	let outer_release = channel::bounded<()>(1)
	let inner_release = channel::bounded<()>(1)
	let outer_constructed = handle new_independent_buffered_for_test() with observe_test_support_test::controlled_record_exporter(outer_lines.tx, outer_release.rx)
	let inner_constructed = handle new_independent_buffered_for_test() with observe_test_support_test::controlled_record_exporter(inner_lines.tx, inner_release.rx)
	match outer_constructed
		observe::BufferedJsonLines(outer) => match inner_constructed
			observe::BufferedJsonLines(inner) => begin
				let outer_metric = handle handle handled_emit(buffered_independent_metric(), 41) with observe::buffered_json_lines(outer) with observe_test_support_test::clock(0)
				let _ = channel::recv(outer_lines.rx)
				let inner_metric = handle handle handled_emit(buffered_independent_metric(), 43) with observe::buffered_json_lines(inner) with observe_test_support_test::clock(0)
				let _ = channel::recv(inner_lines.rx)
				let outer_full = handle observe::buffered_export_observation(outer, buffered_log("full")) with observe_test_support_test::clock(0)
				let outer_invalid = handle observe::buffered_export_observation(outer, buffered_invalid_log()) with observe_test_support_test::clock(0)
				let inner_health = observe::buffered_exporter_health(inner)
				let outer_health = observe::buffered_exporter_health(outer)
				let _ = channel::send(outer_release.tx, ())
				let _ = channel::send(inner_release.tx, ())
				let outer_report = observe::shutdown_buffered(outer)
				let inner_report = observe::shutdown_buffered(inner)
				if outer_metric == 41
					if inner_metric == 43
						match outer_full
							observe::Full => match outer_invalid
								observe::InvalidRecord => if buffered_independent_health_matches(outer_health, inner_health) and buffered_independent_reports_match(outer_report, inner_report)
									Ok(())
								else
									Err("independent buffered exporters shared cardinality, health, or queue state")
								end
								_ => Err("invalid record was not rejected independently of capacity")
							end
							_ => Err("full buffered exporter admitted a second outstanding record")
						end
					else
						Err("one full buffered exporter prevented the other exporter from admitting work")
					end
				else
					Err("first independent buffered exporter did not admit its metric")
				end
			end
			_ => Err("second independent buffered exporter construction failed")
		end
		_ => Err("first independent buffered exporter construction failed")
	end
end

fn buffered_independent_health_matches(outer: ExporterHealth, inner: ExporterHealth) -> Bool
	match outer
		observe::ExporterHealth(2, 0, 0, 0, observe::ProductionHealth(1, 1, 0)) => match inner
			observe::ExporterHealth(0, 0, 0, 0, observe::ProductionHealth(1, 1, 0)) => true
			_ => false
		end
		_ => false
	end
end

fn buffered_independent_reports_match(outer: BufferedShutdownReport, inner: BufferedShutdownReport) -> Bool
	match outer
		observe::BufferedShutdownReport(observe::Completed, observe::ExporterHealth(2, 0, 0, 0, observe::ProductionHealth(1, 1, 0)), _) => match inner
			observe::BufferedShutdownReport(observe::Completed, observe::ExporterHealth(0, 0, 0, 0, observe::ProductionHealth(1, 1, 0)), _) => true
			_ => false
		end
		_ => false
	end
end

fn buffered_lines_have_sequences(lines: Receiver<String>, expected: Int, last: Int) -> Bool effects [concurrency]
	if expected > last
		true
	else
		match channel::recv(lines)
			Some(line) => if buffered_contains(line, string::concat(string::concat("\"sequence\":", int_to_string(expected)), ",")) and if expected == 1
				buffered_contains(line, "\"span_id\":\"fixed-span-1\"")
			else
				true
			end
				buffered_lines_have_sequences(lines, expected + 1, last)
			else
				false
			end
			None => false
		end
	end
end

fn stalled_buffered_admission(context: { exporter : BufferedJsonLinesExporter, entered : Sender<()>, release : Receiver<()> }) -> BufferedAdmissionOutcome effects [time, concurrency]
	handle observe::buffered_export_observation_with_boundary_hook_for_test(context.exporter, buffered_log("first"), observe_test_support_test::decision_barrier, context.entered, context.release) with observe_test_support_test::clock(0)
end

fn queued_buffered_admission(context: { exporter : BufferedJsonLinesExporter, entered : Sender<()>, release : Receiver<()> }) -> BufferedAdmissionOutcome effects [time, concurrency]
	handle observe::buffered_export_observation_with_entry_hook_for_test(context.exporter, buffered_log("second"), observe_test_support_test::decision_barrier, context.entered, context.release) with observe_test_support_test::clock(0)
end

fn stalled_buffered_record_admission(context: { exporter : BufferedJsonLinesExporter, record : Observation, entered : Sender<()>, release : Receiver<()> }) -> BufferedAdmissionOutcome effects [time, concurrency]
	handle observe::buffered_export_observation_with_boundary_hook_for_test(context.exporter, context.record, observe_test_support_test::decision_barrier, context.entered, context.release) with observe_test_support_test::clock(0)
end

fn queued_buffered_record_admission(context: { exporter : BufferedJsonLinesExporter, record : Observation, entered : Sender<()>, release : Receiver<()> }) -> BufferedAdmissionOutcome effects [time, concurrency]
	handle observe::buffered_export_observation_with_entry_hook_for_test(context.exporter, context.record, observe_test_support_test::decision_barrier, context.entered, context.release) with observe_test_support_test::clock(0)
end

test buffered_concurrent_invalid_and_full_submissions_do_not_commit_transformations() -> Result<(), String> effects [time, concurrency]
	let lines = observe_test_support_test::export_lines(2)
	let destination_release = channel::bounded<()>(1)
	let idle = channel::bounded<()>(1)
	let resume = channel::bounded<()>(1)
	let invalid_entered = channel::bounded<()>(1)
	let invalid_release = channel::bounded<()>(1)
	let full_entered = channel::bounded<()>(1)
	let full_release = channel::bounded<()>(1)
	let constructed = handle new_buffered_for_test_with_idle_hook(1, observe::NoDiagnosticDestination, idle.tx, resume.rx) with observe_test_support_test::controlled_record_exporter(lines.tx, destination_release.rx)
	match constructed
		observe::BufferedJsonLines(exporter) => begin
			let occupying = handle observe::buffered_export_observation(exporter, buffered_log("occupy")) with observe_test_support_test::clock(0)
			let _ = channel::recv(lines.rx)
			let transforming = list_cons(observe::Attribute("secret", observe::StringValue("long-value")), list_nil())
			let invalid_record = observe::CounterIncrement(observe::CounterIncrementRecord("invalid", 1, transforming, Some(observe::TraceContext("", "span", true)), callsite_location()))
			let full_record = observe::HistogramSample(observe::HistogramSampleRecord("full", 2, transforming, None, callsite_location()))
			let invalid = task::spawn_with(stalled_buffered_record_admission, { exporter: exporter, record: invalid_record, entered: invalid_entered.tx, release: invalid_release.rx })
			let _ = channel::recv(invalid_entered.rx)
			let full = task::spawn_with(queued_buffered_record_admission, { exporter: exporter, record: full_record, entered: full_entered.tx, release: full_release.rx })
			let _ = channel::recv(full_entered.rx)
			let _ = channel::send(invalid_release.tx, ())
			let invalid_result = task::join(invalid)
			let _ = channel::send(full_release.tx, ())
			let full_result = task::join(full)
			let health = observe::buffered_exporter_health(exporter)
			let _ = channel::send(destination_release.tx, ())
			let _ = channel::recv(idle.rx)
			let _ = channel::send(resume.tx, ())
			let report = observe::shutdown_buffered(exporter)
			match occupying
				observe::Accepted => match invalid_result
					Ok(observe::InvalidRecord) => match full_result
						Ok(observe::Full) => match health
							observe::ExporterHealth(2, 0, 0, 0, observe::ProductionHealth(0, 0, 0)) => match report
								observe::BufferedShutdownReport(observe::Completed, observe::ExporterHealth(2, 0, 0, 0, observe::ProductionHealth(0, 0, 0)), _) => Ok(())
								_ => Err("concurrent invalid and full admissions changed shutdown health")
							end
							_ => Err("concurrent invalid and full admissions committed transformation facts")
						end
						_ => Err("queued concurrent admission was not rejected at capacity")
					end
					_ => Err("stalled concurrent invalid admission changed outcome")
				end
				_ => Err("occupying record was not admitted")
			end
		end
		_ => Err("concurrent rejection exporter construction failed")
	end
end

test buffered_concurrent_accepted_submissions_reach_destination_in_admission_order() -> Result<(), String> effects [time, concurrency]
	let lines = observe_test_support_test::export_lines(3)
	let entered = channel::bounded<()>(1)
	let release = channel::bounded<()>(1)
	let queued = channel::bounded<()>(1)
	let admit = channel::bounded<()>(1)
	let constructed = handle new_buffered_for_test(2, observe::NoDiagnosticDestination) with observe_test_support_test::exporter(lines.tx, true)
	match constructed
		observe::BufferedJsonLines(exporter) => begin
			let first = task::spawn_with(stalled_buffered_admission, { exporter: exporter, entered: entered.tx, release: release.rx })
			let _ = channel::recv(entered.rx)
			let second = task::spawn_with(queued_buffered_admission, { exporter: exporter, entered: queued.tx, release: admit.rx })
			let _ = channel::recv(queued.rx)
			let _ = channel::send(release.tx, ())
			let first_result = task::join(first)
			let _ = channel::send(admit.tx, ())
			let second_result = task::join(second)
			let report = observe::shutdown_buffered(exporter)
			let first_line = channel::recv(lines.rx)
			let second_line = channel::recv(lines.rx)
			match first_result
				Ok(observe::Accepted) => match second_result
					Ok(observe::Accepted) => if buffered_concurrent_fifo(first_line, second_line)
						match report
							observe::BufferedShutdownReport(observe::Completed, observe::ExporterHealth(0, 0, 0, 0, _), _) => Ok(())
							_ => Err("concurrent accepted buffered submissions changed shutdown health")
						end
					else
						Err("concurrent accepted buffered submissions did not preserve admission FIFO")
					end
					_ => Err("overlapping buffered submission was not accepted")
				end
				_ => Err("stalled buffered submission was not accepted")
			end
		end
		_ => Err("concurrent buffered exporter construction failed")
	end
end

fn buffered_concurrent_fifo(first: Option<String>, second: Option<String>) -> Bool
	match first
		Some(first_line) => match second
			Some(second_line) => buffered_contains(first_line, "\"sequence\":1,") and buffered_contains(first_line, "\"message\":\"first\"") and buffered_contains(second_line, "\"sequence\":2,") and buffered_contains(second_line, "\"message\":\"second\"")
			None => false
		end
		None => false
	end
end
