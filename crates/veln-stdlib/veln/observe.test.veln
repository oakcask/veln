	handle observe::buffered_export_observation_with_entry_hook_for_test(context.exporter, context.record, observe_test_support_test::decision_barrier, context.entered, context.release) with observe_test_support_test::clock(0)
end

fn cancel_buffered_worker_task(exporter: BufferedJsonLinesExporter) -> () effects [concurrency]
	observe::cancel_buffered_worker_for_test(exporter)
