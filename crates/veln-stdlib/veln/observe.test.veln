fn check_buffered_summary_failure(outcome: ExportWriteOutcome) -> Result<(), String> effects [concurrency]
	let lines = observe_test_support_test::export_lines(2)
	let outcomes = channel::bounded<ExportWriteOutcome>(1)
	let _ = channel::send(outcomes.tx, outcome)
	let constructed = handle new_buffered_failure_for_test(5, observe::DiagnosticStandardError) with observe_test_support_test::scheduled_exporter(lines.tx, outcomes.rx)
	match constructed
		observe::BufferedJsonLines(exporter) => begin
			let report = observe::shutdown_buffered(exporter)
			let attempted = channel::recv(lines.rx)
			let repeated = observe::shutdown_buffered(exporter)
			let health = observe::buffered_exporter_health(exporter)
			let no_more: Option<{ index : Int, value : String }> = channel::select_many_timeout(list_cons(lines.rx, list_nil()), 0)
			match report
				observe::BufferedShutdownReport(observe::Completed, observe::ExporterHealth(5, 0, 0, 0, observe::ProductionHealth(0, 0, 0)), observe::SummaryRejected) => match repeated
					observe::BufferedShutdownReport(observe::Completed, observe::ExporterHealth(5, 0, 0, 0, observe::ProductionHealth(0, 0, 0)), observe::SummaryRejected) => match health
						observe::ExporterHealth(5, 0, 0, 0, observe::ProductionHealth(0, 0, 0)) => if buffered_line_contains(attempted, "diagnostic:stderr:{\"schema_version\":1,\"kind\":\"exporter_health\",\"failed_exports\":5")
							match no_more
								None => Ok(())
								Some(_) => Err("failed buffered summary was attempted more than once")
							end
						else
							Err("failed buffered summary changed its schema")
						end
						_ => Err("failed buffered summary changed frozen health")
					end
					_ => Err("failed buffered summary did not freeze its report")
				end
				_ => Err("failed buffered summary did not report rejection")
			end
		end
		_ => Err("failed buffered summary exporter construction failed")
	end
end

test buffered_summary_rejection_and_exception_are_contained_once() -> Result<(), String> effects [concurrency]
	let _ = check_buffered_summary_failure(observe_test_support_test::RejectWrite)?
	check_buffered_summary_failure(observe_test_support_test::FailWrite)
end

test buffered_summary_contract_failure_freezes_rejected_interruption_without_retry() -> Result<(), String> effects [concurrency]
	let lines = observe_test_support_test::export_lines(2)
	let outcomes = channel::bounded<ExportWriteOutcome>(1)
	let reports = channel::bounded<BufferedShutdownReport>(1)
	let _ = channel::send(outcomes.tx, observe_test_support_test::ContractFailWrite)
	let constructed = handle new_buffered_failure_for_test(5, observe::DiagnosticStandardError) with observe_test_support_test::scheduled_exporter(lines.tx, outcomes.rx)
	match constructed
		observe::BufferedJsonLines(exporter) => begin
			let shutdown = task::spawn_with(shutdown_buffered_and_send, { exporter: exporter, reports: reports.tx })
			let selected: Option<{ index : Int, value : BufferedShutdownReport }> = channel::select_many_timeout(list_cons(reports.rx, list_nil()), 250)
			let report = match selected
				Some({ index: 0, value: report }) => report
				Some(_) => Err("contract-failing buffered summary selected the wrong completion channel")?
				None => begin
					task::cancel(shutdown)
					let _ = task::join(shutdown)
					Err("contract-failing buffered summary did not restore state before the bounded guard")?
				end
			end
			let attempted = channel::recv(lines.rx)
			let joined = task::join(shutdown)
			let repeated = observe::shutdown_buffered(exporter)
			let health = observe::buffered_exporter_health(exporter)
			let no_more: Option<{ index : Int, value : String }> = channel::select_many_timeout(list_cons(lines.rx, list_nil()), 0)
			match report
				observe::BufferedShutdownReport(observe::Interrupted, observe::ExporterHealth(5, 0, 0, 0, observe::ProductionHealth(0, 0, 0)), observe::SummaryRejected) => match joined
					Ok(()) => match repeated
						observe::BufferedShutdownReport(observe::Interrupted, observe::ExporterHealth(5, 0, 0, 0, observe::ProductionHealth(0, 0, 0)), observe::SummaryRejected) => match health
							observe::ExporterHealth(5, 0, 0, 0, observe::ProductionHealth(0, 0, 0)) => if buffered_line_contains(attempted, "diagnostic:stderr:{\"schema_version\":1,\"kind\":\"exporter_health\",\"failed_exports\":5")
								match no_more
									None => Ok(())
									Some(_) => Err("contract-failing buffered summary was retried")
								end
							else
								Err("contract-failing buffered summary changed its attempted schema")
							end
							_ => Err("contract-failing buffered summary changed exporter health")
						end
						_ => Err("contract-failing buffered summary did not freeze its rejected interruption")
					end
					Err(_) => Err("contract-failing buffered summary prevented shutdown task completion")
				end
				_ => Err("contract-failing buffered summary reported the wrong shutdown outcome")
			end
		end
		_ => Err("buffered summary contract failure exporter construction failed")
	end
end

test cancellation_before_queue_reversal_restores_state_and_wakes_shutdown_waiters() -> Result<(), String> effects [time, concurrency]
	let boundary = channel::bounded<()>(1)
	let boundary_release = channel::bounded<()>(1)
	let waiter = channel::bounded<()>(1)
	let waiter_release = channel::bounded<()>(1)
	let reports = channel::bounded<BufferedShutdownReport>(1)
	let lines = observe_test_support_test::export_lines(1)
	let constructed = handle new_buffered_worker_boundary_for_test(0, observe::DiagnosticStandardError, true, boundary.tx, boundary_release.rx) with observe_test_support_test::exporter(lines.tx, true)
	match constructed
		observe::BufferedJsonLines(exporter) => begin
			let admitted = handle observe::buffered_export_observation(exporter, buffered_log("queued-before-reversal")) with observe_test_support_test::clock(0)
			let reached: Option<()> = channel::recv(boundary.rx)
			let survivor = task::spawn_with(shutdown_buffered_and_send, { exporter: exporter, reports: reports.tx })
			let cancelled = task::spawn_with(shutdown_buffered_task_at_wait_boundary, { exporter: exporter, entered: waiter.tx, release: waiter_release.rx })
			let waiting: Option<()> = channel::recv(waiter.rx)
			task::cancel(cancelled)
			let cancelled_join = task::join(cancelled)
			let prompt: Option<{ index : Int, value : BufferedShutdownReport }> = channel::select_many_timeout(list_cons(reports.rx, list_nil()), 250)
			let survivor_join = task::join(survivor)
			let repeated = observe::shutdown_buffered(exporter)
			let health = observe::buffered_exporter_health(exporter)
			let no_call: Option<{ index : Int, value : String }> = channel::select_many_timeout(list_cons(lines.rx, list_nil()), 0)
			match cancelled_join
				Err(error) => if task::join_error_is_cancelled(error) and buffered_unit_received(reached) and buffered_unit_received(waiting) and buffered_admission_is_accepted(admitted)
					match prompt
						Some({ index: 0, value: observe::BufferedShutdownReport(observe::Interrupted, observe::ExporterHealth(1, 0, 0, 0, observe::ProductionHealth(0, 0, 0)), observe::SummaryNotAttempted) }) => match survivor_join
							Ok(()) => match repeated
								observe::BufferedShutdownReport(observe::Interrupted, observe::ExporterHealth(1, 0, 0, 0, observe::ProductionHealth(0, 0, 0)), observe::SummaryNotAttempted) => match health
									observe::ExporterHealth(1, 0, 0, 0, observe::ProductionHealth(0, 0, 0)) => if buffered_no_selected_line(no_call)
										Ok(())
									else
										Err("queue-reversal interruption started a destination call")
									end
									_ => Err("queue-reversal interruption left health unavailable")
								end
								_ => Err("queue-reversal interruption did not freeze its report")
							end
							Err(_) => Err("queue-reversal interruption did not wake the survivor normally")
						end
						_ => Err("queue-reversal interruption did not wake the survivor promptly")
					end
				else
					Err("queue-reversal cancellation did not reach both deterministic boundaries")
				end
				Ok(_) => Err("queue-reversal shutdown waiter lost abrupt cancellation")
			end
		end
		_ => Err("queue-reversal boundary exporter construction failed")
	end
end

