	handle observe::buffered_export_observation_with_entry_hook_for_test(context.exporter, buffered_log("second"), observe_test_support_test::decision_barrier, context.entered, context.release) with observe_test_support_test::clock(0)
end

fn stalled_buffered_record_admission(context: { exporter : BufferedJsonLinesExporter, record : Observation, entered : Sender<()>, release : Receiver<()> }) -> BufferedAdmissionOutcome effects [time, concurrency]
	handle observe::buffered_export_observation_with_boundary_hook_for_test(context.exporter, context.record, observe_test_support_test::decision_barrier, context.entered, context.release) with observe_test_support_test::clock(0)
end

