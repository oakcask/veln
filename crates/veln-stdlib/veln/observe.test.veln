test cancelled_shutdown_waiter_interrupts_shared_drain_and_late_record_completion_is_inert() -> Result<(), String> effects [time, concurrency]
	let events = channel::bounded<String>(4)
	let release = channel::bounded<()>(1)
	let call_returned = channel::bounded<()>(1)
	let reports = channel::bounded<BufferedShutdownReport>(1)
	let cancelled_wait = channel::bounded<()>(1)
	let survivor_wait = channel::bounded<()>(1)
	let constructed = handle new_buffered_call_return_for_test(0, observe::DiagnosticStandardError, call_returned.tx) with observe_test_support_test::late_completion_exporter(events.tx, release.rx)
	match constructed
		observe::BufferedJsonLines(exporter) => begin
			let first_admission = handle observe::buffered_export_observation(exporter, buffered_log("in-flight")) with observe_test_support_test::clock(0)
			let second_admission = handle observe::buffered_export_observation(exporter, buffered_log("queued")) with observe_test_support_test::clock(0)
			let started: Option<String> = channel::recv(events.rx)
			let cancelled = task::spawn_with(shutdown_buffered_task_observed, { exporter: exporter, waiting: cancelled_wait.tx })
			let survivor = task::spawn_with(shutdown_buffered_and_send_observed, { exporter: exporter, reports: reports.tx, waiting: survivor_wait.tx })
			let cancelled_waiting: Option<()> = channel::recv(cancelled_wait.rx)
			let survivor_waiting: Option<()> = channel::recv(survivor_wait.rx)
			task::cancel(cancelled)
			let cancelled_join = task::join(cancelled)
			let prompt: Option<{ index : Int, value : BufferedShutdownReport }> = channel::select_many_timeout(list_cons(reports.rx, list_nil()), 250)
			let survivor_join = match task::join(survivor)
				Ok(()) => true
				Err(_) => false
			end
			let closed = handle observe::buffered_export_observation(exporter, buffered_log("after-interruption")) with observe_test_support_test::clock(0)
			let frozen_before = observe::buffered_exporter_health(exporter)
			let _ = channel::send(release.tx, ())
			let late: Option<String> = channel::recv(events.rx)
			let returned: Option<()> = channel::recv(call_returned.rx)
			let repeated = observe::shutdown_buffered(exporter)
			let frozen_after = observe::buffered_exporter_health(exporter)
			let no_more: Option<{ index : Int, value : String }> = channel::select_many_timeout(list_cons(events.rx, list_nil()), 0)
			match cancelled_join
				Err(error) => if task::join_error_is_cancelled(error)
					match prompt
						Some({ index: 0, value: observe::BufferedShutdownReport(observe::Interrupted, observe::ExporterHealth(2, 0, 0, 0, observe::ProductionHealth(0, 0, 0)), observe::SummaryNotAttempted) }) => match repeated
							observe::BufferedShutdownReport(observe::Interrupted, observe::ExporterHealth(2, 0, 0, 0, observe::ProductionHealth(0, 0, 0)), observe::SummaryNotAttempted) => match frozen_before
								observe::ExporterHealth(2, 0, 0, 0, observe::ProductionHealth(0, 0, 0)) => match frozen_after
									observe::ExporterHealth(2, 0, 0, 0, observe::ProductionHealth(0, 0, 0)) => if not buffered_admission_is_accepted(first_admission) or not buffered_admission_is_accepted(second_admission)
										Err("interrupted drain setup did not admit two records")
									else if not buffered_event_is(started, "record-started")
										Err(buffered_unexpected_event("interrupted drain record start", started))
									else if not buffered_unit_received(cancelled_waiting) or not buffered_unit_received(survivor_waiting) or not survivor_join
										Err("interrupted drain did not wake the surviving waiter normally")
									else if not buffered_admission_is_closed(closed)
										Err("interrupted drain admitted a record after revocation")
									else if late == None or not buffered_unit_received(returned)
										Err("interrupted in-flight record did not complete late")
									else if not buffered_no_selected_line(no_more)
										Err("late record completion released another destination call")
									else
										Ok(())
									end
									_ => Err("late record completion changed frozen health")
								end
								_ => Err("interrupted record drain did not freeze exact unsettled accounting")
							end
							_ => Err("repeated shutdown did not return the interrupted frozen report")
						end
						_ => Err("surviving shutdown waiter did not receive a prompt interrupted report")
					end
				else
					Err("cancelled shutdown waiter lost abrupt cancellation")
				end
				Ok(_) => Err("cancelled shutdown waiter completed normally")
			end
		end
		_ => Err("interrupted record exporter construction failed")
	end
end

test summary_interruption_rejects_unconfirmed_call_and_late_completion_is_inert() -> Result<(), String> effects [concurrency]
	let events = channel::bounded<String>(2)
	let release = channel::bounded<()>(1)
	let call_returned = channel::bounded<()>(1)
	let waiting = channel::bounded<()>(1)
	let constructed = handle new_buffered_call_return_for_test(5, observe::DiagnosticStandardError, call_returned.tx) with observe_test_support_test::late_completion_exporter(events.tx, release.rx)
	match constructed
		observe::BufferedJsonLines(exporter) => begin
			let shutdown = task::spawn_with(shutdown_buffered_task_observed, { exporter: exporter, waiting: waiting.tx })
			let shutdown_waiting: Option<()> = channel::recv(waiting.rx)
			let started: Option<String> = channel::recv(events.rx)
			task::cancel(shutdown)
			let joined = task::join(shutdown)
			let report = observe::shutdown_buffered(exporter)
			let before = observe::buffered_exporter_health(exporter)
			let _ = channel::send(release.tx, ())
			let late: Option<String> = channel::recv(events.rx)
			let returned: Option<()> = channel::recv(call_returned.rx)
			let repeated = observe::shutdown_buffered(exporter)
			let after = observe::buffered_exporter_health(exporter)
			let no_more: Option<{ index : Int, value : String }> = channel::select_many_timeout(list_cons(events.rx, list_nil()), 0)
			match joined
				Err(error) => if task::join_error_is_cancelled(error)
					match report
						observe::BufferedShutdownReport(observe::Interrupted, observe::ExporterHealth(5, 0, 0, 0, observe::ProductionHealth(0, 0, 0)), observe::SummaryRejected) => match repeated
							observe::BufferedShutdownReport(observe::Interrupted, observe::ExporterHealth(5, 0, 0, 0, observe::ProductionHealth(0, 0, 0)), observe::SummaryRejected) => if not buffered_unit_received(shutdown_waiting)
								Err("summary interruption caller did not join the transition")
							else if not buffered_event_is(started, "summary-started")
								Err(buffered_unexpected_event("summary interruption start", started))
							else if late == None or not buffered_unit_received(returned)
								Err("interrupted summary did not complete late")
							else if not buffered_health_is_five(before) or not buffered_health_is_five(after)
								Err("late summary completion changed frozen health")
							else if not buffered_no_selected_line(no_more)
								Err("late summary completion started an extra destination call")
							else
								Ok(())
							end
							_ => Err("repeated shutdown changed the summary interruption report")
						end
						_ => Err("unconfirmed summary interruption was not rejected")
					end
				else
					Err("summary waiter cancellation was not preserved")
				end
				Ok(_) => Err("cancelled summary waiter completed normally")
			end
		end
		_ => Err("summary interruption exporter construction failed")
	end
end

fn buffered_event_is(event: Option<String>, expected: String) -> Bool
	match event
		Some(value) => value == expected
		None => false
	end
end

fn buffered_unit_received(value: Option<()>) -> Bool
	match value
		Some(()) => true
		None => false
	end
end

fn buffered_admission_is_closed(outcome: BufferedAdmissionOutcome) -> Bool
	match outcome
		observe::Closed => true
		_ => false
	end
end

fn buffered_report_is_completed(report: BufferedShutdownReport) -> Bool
	match report
		observe::BufferedShutdownReport(observe::Completed, observe::ExporterHealth(0, 0, 0, 0, observe::ProductionHealth(0, 0, 0)), observe::SummaryAccepted) => true
		_ => false
	end
end

fn buffered_health_is_five(health: ExporterHealth) -> Bool
	match health
		observe::ExporterHealth(5, 0, 0, 0, observe::ProductionHealth(0, 0, 0)) => true
		_ => false
	end
end

fn buffered_unexpected_event(context: String, event: Option<String>) -> String
	match event
		Some(value) => string::concat(string::concat(context, ": "), value)
		None => string::concat(context, ": closed")
	end
end
