use event
use log
use metric
use observe
use observe_test_support_test
use observe_export_test_support_test

test noop_preserves_a_handled_body_result() -> Result<(), String>
	let observed = handle 42 with observe::noop()
	if observed == 42
		Ok(())
	else
		Err("no-op observation handler changed the body result")
	end
end

test noop_start_span_has_no_recording_context() -> Result<(), String>
	let span = handle perform observe::Observe::start_span(observe::SpanRequest("noop", None, list_nil())) with observe::noop()
	match observe::context(span)
		None => if observe::is_noop_span(span)
			Ok(())
		else
			Err("no-op observation handler returned an unexpected span")
		end
		Some(_) => Err("no-op observation handler exposed a recording context")
	end
end

test noop_emit_completes_without_observation() -> Result<(), String>
	let record = observe::Log(observe::LogRecord("log", observe::Info, "ignored", list_nil(), None, callsite_location()))
	let completed = handle perform observe::Observe::emit(record) with observe::noop()
	if completed == ()
		Ok(())
	else
		Err("no-op observation handler did not complete emit")
	end
end

test noop_finish_span_completes() -> Result<(), String>
	let span = handle perform observe::Observe::start_span(observe::SpanRequest("noop", None, list_nil())) with observe::noop()
	let completed = handle perform observe::Observe::finish_span(observe::finish(span)) with observe::noop()
	if completed == ()
		Ok(())
	else
		Err("no-op observation handler did not complete finish_span")
	end
end

test recording_exposes_ordered_start_emit_and_finish_entries() -> Result<(), String> effects [time, concurrency]
	let recording = observe::new_recording("recording")
	let span = handle perform observe::Observe::start_span(observe::SpanRequest("request", None, list_nil())) with observe::recording(recording)
	let record = observe::Log(observe::LogRecord("log", observe::Info, "message", list_nil(), None, callsite_location()))
	let _ = handle perform observe::Observe::emit(record) with observe::recording(recording)
	let _ = handle perform observe::Observe::finish_span(observe::finish(span)) with observe::recording(recording)
	match observe::recorded(recording)
		Cons(observe::SpanStarted("request", "recording-0", "recording-1", None, Nil, _), Cons(observe::Emitted(observe::Log(observe::LogRecord("log", observe::Info, "message", Nil, None, _))), Cons(observe::SpanFinished("recording-0", "recording-1", _), Nil))) => Ok(())
		_ => Err("recording did not preserve lifecycle order or identities")
	end
end

test recording_snapshots_preserve_mixed_log_and_event_order() -> Result<(), String> effects [time, concurrency]
	let recording = observe::new_recording("mixed-observations")
	let result = handle begin
		log::info(None, "before", list_nil())
		event::emit(Some(observe::TraceContext("trace-event", "span-event", true)), "checkout.completed", list_cons(observe::Attribute("attempt", observe::IntValue(3)), list_nil()))
		log::error(None, "after", list_nil())
		91
	end with observe::recording(recording)
	let first = observe::recorded(recording)
	let second = observe::recorded(recording)
	if result == 91
		match first
			Cons(observe::Emitted(observe::Log(observe::LogRecord("log", observe::Info, "before", Nil, None, _))), Cons(observe::Emitted(observe::Event(observe::EventRecord("checkout.completed", Cons(observe::Attribute("attempt", observe::IntValue(3)), Nil), Some(observe::TraceContext("trace-event", "span-event", true)), _))), Cons(observe::Emitted(observe::Log(observe::LogRecord("log", observe::Error, "after", Nil, None, _))), Nil))) => match second
				Cons(observe::Emitted(observe::Log(observe::LogRecord("log", observe::Info, "before", Nil, None, _))), Cons(observe::Emitted(observe::Event(observe::EventRecord("checkout.completed", Cons(observe::Attribute("attempt", observe::IntValue(3)), Nil), Some(observe::TraceContext("trace-event", "span-event", true)), _))), Cons(observe::Emitted(observe::Log(observe::LogRecord("log", observe::Error, "after", Nil, None, _))), Nil))) => Ok(())
				_ => Err("second snapshot consumed or reordered mixed observations")
			end
			_ => Err("recording changed mixed log and event order or values")
		end
	else
		Err("recording changed the mixed observation body result")
	end
end

test recorded_is_a_non_consuming_sequential_snapshot() -> Result<(), String> effects [time, concurrency]
	let recording = observe::new_recording("snapshot")
	let first_span = handle perform observe::Observe::start_span(observe::SpanRequest("first", None, list_nil())) with observe::recording(recording)
	let first_read = observe::recorded(recording)
	let second_read = observe::recorded(recording)
	let record = observe::Log(observe::LogRecord("log", observe::Info, "after read", list_nil(), None, callsite_location()))
	let _ = handle perform observe::Observe::emit(record) with observe::recording(recording)
	let appended_read = observe::recorded(recording)
	let second_span = handle perform observe::Observe::start_span(observe::SpanRequest("second", None, list_nil())) with observe::recording(recording)
	let identity_read = observe::recorded(recording)
	match first_read
		Cons(observe::SpanStarted("first", "snapshot-0", "snapshot-1", None, Nil, _), Nil) => match second_read
			Cons(observe::SpanStarted("first", "snapshot-0", "snapshot-1", None, Nil, _), Nil) => match appended_read
				Cons(observe::SpanStarted("first", "snapshot-0", "snapshot-1", None, Nil, _), Cons(observe::Emitted(observe::Log(observe::LogRecord("log", observe::Info, "after read", Nil, None, _))), Nil)) => match identity_read
					Cons(observe::SpanStarted("first", "snapshot-0", "snapshot-1", None, Nil, _), Cons(observe::Emitted(observe::Log(observe::LogRecord("log", observe::Info, "after read", Nil, None, _))), Cons(observe::SpanStarted("second", "snapshot-2", "snapshot-3", None, Nil, _), Nil))) => Ok(())
					_ => Err("recorded changed the preserved entries or reset identity allocation")
				end
				_ => Err("recording after a read did not preserve and append entries")
			end
			_ => Err("repeated recorded read changed the prior snapshot")
		end
		_ => Err("first recorded read changed the prior entries")
	end
end

test recording_children_do_not_collide_with_a_parent_from_another_recording() -> Result<(), String> effects [time, concurrency]
	let parent_recording = observe::new_recording("shared")
	let child_recording = observe::new_recording("shared")
	let parent = handle perform observe::Observe::start_span(observe::SpanRequest("parent", None, list_nil())) with observe::recording(parent_recording)
	let parent_context = observe::context(parent)
	let _ = handle perform observe::Observe::start_span(observe::SpanRequest("first", parent_context, list_nil())) with observe::recording(child_recording)
	let _ = handle perform observe::Observe::start_span(observe::SpanRequest("second", parent_context, list_nil())) with observe::recording(child_recording)
	match observe::recorded(child_recording)
		Cons(observe::SpanStarted("first", "shared-0", "shared-0", Some("shared-1"), Nil, _), Cons(observe::SpanStarted("second", "shared-0", "shared-2", Some("shared-1"), Nil, _), Nil)) => Ok(())
		_ => Err("cross-recording children changed trace, parent, sibling, or allocation identities")
	end
end

test recording_collision_adjustment_preserves_parent_sampling_state() -> Result<(), String> effects [time, concurrency]
	let recording = observe::new_recording("collision")
	let parent = observe::TraceContext("upstream-trace", "collision-0", false)
	let child = handle perform observe::Observe::start_span(observe::SpanRequest("child", Some(parent), list_nil())) with observe::recording(recording)
	match observe::context(child)
		Some(observe::TraceContext("upstream-trace", "collision-1", false)) => Ok(())
		_ => Err("collision-adjusted child context changed its identity or inherited sampling state")
	end
end

test recording_treats_a_noop_parent_as_a_root_request() -> Result<(), String> effects [time, concurrency]
	let parent = handle perform observe::Observe::start_span(observe::SpanRequest("ignored", None, list_nil())) with observe::noop()
	let recording = observe::new_recording("mixed")
	let _ = handle perform observe::Observe::start_span(observe::SpanRequest("root", observe::context(parent), list_nil())) with observe::recording(recording)
	match observe::recorded(recording)
		Cons(observe::SpanStarted("root", "mixed-0", "mixed-1", None, Nil, _), Nil) => Ok(())
		_ => Err("recording did not treat a no-op parent as a root request")
	end
end

test recording_preserves_an_empty_link_list_with_an_explicit_parent() -> Result<(), String> effects [time, concurrency]
	let recording = observe::new_recording("empty-links")
	let parent = observe::TraceContext("upstream-trace", "upstream-span", true)
	let _ = handle perform observe::Observe::start_span(observe::SpanRequest("consumer", Some(parent), list_nil())) with observe::recording(recording)
	match observe::recorded(recording)
		Cons(observe::SpanStarted("consumer", "upstream-trace", "empty-links-0", Some("upstream-span"), Nil, _), Nil) => Ok(())
		_ => Err("recording did not preserve an explicit parent with zero links")
	end
end

test recording_preserves_multiple_link_identities_in_request_order() -> Result<(), String> effects [time, concurrency]
	let recording = observe::new_recording("ordered-links")
	let links = list_cons(observe::TraceContext("linked-trace-a", "linked-span-a", true), list_cons(observe::TraceContext("linked-trace-b", "linked-span-b", true), list_nil()))
	let _ = handle perform observe::Observe::start_span(observe::SpanRequest("consumer", Some(observe::TraceContext("parent-trace", "parent-span", true)), links)) with observe::recording(recording)
	match observe::recorded(recording)
		Cons(observe::SpanStarted("consumer", "parent-trace", "ordered-links-0", Some("parent-span"), Cons(observe::TraceContext("linked-trace-a", "linked-span-a", true), Cons(observe::TraceContext("linked-trace-b", "linked-span-b", true), Nil)), _), Nil) => Ok(())
		_ => Err("recording changed linked context identities or request order")
	end
end

test recording_preserves_links_without_a_parent() -> Result<(), String> effects [time, concurrency]
	let recording = observe::new_recording("root-links")
	let links = list_cons(observe::TraceContext("linked-trace", "linked-span", true), list_nil())
	let _ = handle perform observe::Observe::start_span(observe::SpanRequest("consumer", None, links)) with observe::recording(recording)
	match observe::recorded(recording)
		Cons(observe::SpanStarted("consumer", "root-links-0", "root-links-1", None, Cons(observe::TraceContext("linked-trace", "linked-span", true), Nil), _), Nil) => Ok(())
		_ => Err("recording did not preserve links independently of parentage")
	end
end

test trace_context_injection_exposes_every_carrier_field() -> Result<(), String>
	match observe::inject_context(observe::TraceContext("trace-injected", "span-injected", false))
		observe::TraceCarrier(Some("trace-injected"), Some("span-injected"), Some(false)) => Ok(())
		_ => Err("trace context injection changed an identity or sampling state")
	end
end

test trace_context_injection_then_extraction_preserves_both_sampling_states() -> Result<(), String>
	let sampled = observe::TraceContext("trace-sampled", "span-sampled", true)
	let unsampled = observe::TraceContext("trace-unsampled", "span-unsampled", false)
	match observe::extract_context(observe::inject_context(sampled))
		Some(observe::TraceContext("trace-sampled", "span-sampled", true)) => match observe::extract_context(observe::inject_context(unsampled))
			Some(observe::TraceContext("trace-unsampled", "span-unsampled", false)) => Ok(())
			_ => Err("trace context carrier round trip changed unsampled state")
		end
		_ => Err("trace context carrier round trip changed sampled state")
	end
end

test trace_context_extraction_rejects_missing_and_empty_fields() -> Result<(), String>
	match observe::extract_context(observe::TraceCarrier(None, Some("span"), Some(true)))
		None => match observe::extract_context(observe::TraceCarrier(Some("trace"), None, Some(true)))
			None => match observe::extract_context(observe::TraceCarrier(Some("trace"), Some("span"), None))
				None => match observe::extract_context(observe::inject_context(observe::TraceContext("", "span", true)))
					None => match observe::extract_context(observe::TraceCarrier(Some("trace"), Some(""), Some(false)))
						None => Ok(())
						Some(_) => Err("trace context extraction accepted an empty span identity")
					end
					Some(_) => Err("trace context extraction accepted an empty trace identity")
				end
				Some(_) => Err("trace context extraction accepted missing sampling state")
			end
			Some(_) => Err("trace context extraction accepted a missing span identity")
		end
		Some(_) => Err("trace context extraction accepted a missing trace identity")
	end
end

test recording_context_defaults_roots_to_sampled_and_inherits_parent_sampling() -> Result<(), String> effects [time, concurrency]
	let root_recording = observe::new_recording("sampled-root")
	let root = handle perform observe::Observe::start_span(observe::SpanRequest("root", None, list_nil())) with observe::recording(root_recording)
	let child_recording = observe::new_recording("unsampled-child")
	let parent = observe::TraceContext("upstream-trace", "upstream-span", false)
	let child = handle perform observe::Observe::start_span(observe::SpanRequest("child", Some(parent), list_nil())) with observe::recording(child_recording)
	match observe::context(root)
		Some(observe::TraceContext("sampled-root-0", "sampled-root-1", true)) => match observe::context(child)
			Some(observe::TraceContext("upstream-trace", "unsampled-child-0", false)) => Ok(())
			_ => Err("recording child context did not inherit parent sampling state")
		end
		_ => Err("recording root context did not default to sampled")
	end
end

test production_large_reversed_attribute_multiset_remains_one_known_series() -> Result<(), String> effects [concurrency]
	let production = observe::new_production(1)
	let attributes = large_metric_attributes(4000, list_nil())
	let reversed = list_reverse(attributes)
	let result = handle begin
		metric::counter_increment(None, "large-series", 1, attributes)
		metric::counter_increment(None, "large-series", 2, reversed)
		47
	end with observe::production(production)
	match observe::production_health(production)
		observe::ProductionHealth(1, 2, 0) => if result == 47
			Ok(())
		else
			Err("large known-series admission changed the handled result")
		end
		_ => Err("large reversed attributes created a new series or stranded production state")
	end
end

test production_cancellation_aborts_one_decision_and_keeps_state_available() -> Result<(), String> effects [concurrency]
	let production = observe::new_production(1)
	let entered = channel::bounded<()>(1)
	let release = channel::bounded<()>(1)
	let worker = task::spawn_with<(), { production : Production, entered : Sender<()>, release : Receiver<()> }>(cancelled_production_decision, { production: production, entered: entered.tx, release: release.rx })
	let started: Option<()> = channel::recv(entered.rx)
	task::cancel(worker)
	let _ = channel::send(release.tx, ())
	let joined = task::join(worker)
	let before_retry = observe::production_health(production)
	let _ = handle metric::counter_increment(None, "after-cancellation", 1, list_nil()) with observe::production(production)
	let after_retry = observe::production_health(production)
	match started
		Some(_) => match joined
			Err(error) => if task::join_error_is_cancelled(error)
				match before_retry
					observe::ProductionHealth(0, 0, 0) => match after_retry
						observe::ProductionHealth(1, 1, 0) => Ok(())
						_ => Err("production state did not admit a metric after cancellation")
					end
					_ => Err("cancelled production decision committed partial state")
				end
			else
				Err("cancelled production decision reported a non-cancellation join error")
			end
			Ok(_) => Err("cancelled production decision completed normally")
		end
		None => Err("production decision did not reach the deterministic cancellation barrier")
	end
end

test production_health_counters_saturate_at_maximum_int() -> Result<(), String> effects [concurrency]
	let maximum = 9223372036854775807
	let production = observe::new_production_for_test(1, maximum - 1, maximum - 1)
	let _ = handle begin
		metric::counter_increment(None, "admitted", 1, list_nil())
		metric::counter_increment(None, "admitted", 2, list_nil())
		metric::counter_increment(None, "dropped", 1, list_nil())
		metric::counter_increment(None, "still-dropped", 1, list_nil())
	end with observe::production(production)
	match observe::production_health(production)
		observe::ProductionHealth(1, 9223372036854775807, 9223372036854775807) => Ok(())
		_ => Err("production health counters did not saturate at maximum Int")
	end
end

fn large_metric_attributes(remaining: Int, attributes: List<observe::Attribute>) -> List<observe::Attribute>
	if remaining == 0
		attributes
	else
		large_metric_attributes(remaining - 1, list_cons(observe::Attribute("index", observe::IntValue(remaining)), attributes))
	end
end

fn cancelled_production_decision(context: { production : Production, entered : Sender<()>, release : Receiver<()> }) -> () effects [concurrency] callsite
	let record = observe::CounterIncrement(observe::CounterIncrementRecord("cancelled", 1, list_nil(), None, callsite))
	observe::apply_metric_cardinality_for_test(context.production, record, observe_test_support_test::decision_barrier, context.entered, context.release)
end

fn callsite_location() -> SourceLocation callsite
	callsite
end

