test record_permit_publication_cancellation_discards_unpublished_permits_repeatedly() -> Result<(), String> effects [time, concurrency]
	let baseline = observe::buffered_export_permit_count_for_test()
	let _ = check_record_permit_publication_cancellation(baseline)?
	let _ = check_record_permit_publication_cancellation(baseline)?
	if observe::buffered_export_permit_count_for_test() == baseline
		Ok(())
	else
		Err("repeated record publication cancellation retained a host permit")
	end
end

fn check_record_permit_publication_cancellation(baseline: Int) -> Result<(), String> effects [time, concurrency]
	let entered = channel::bounded<()>(1)
	let release = channel::bounded<()>(1)
	let waiting = channel::bounded<()>(1)
	let lines = observe_test_support_test::export_lines(1)
	let constructed = handle new_buffered_permit_publication_for_test(observe::NoDiagnosticDestination, entered.tx, release.rx) with observe_test_support_test::exporter(lines.tx, true)
	match constructed
		observe::BufferedJsonLines(exporter) => begin
			let admission = handle observe::buffered_export_observation(exporter, buffered_log("unpublished-record")) with observe_test_support_test::clock(0)
			let reached: Option<()> = channel::recv(entered.rx)
			let during = observe::buffered_export_permit_count_for_test()
			let shutdown = task::spawn_with(shutdown_buffered_task_observed, { exporter: exporter, waiting: waiting.tx })
			let shutdown_waiting: Option<()> = channel::recv(waiting.rx)
			task::cancel(shutdown)
			let joined = task::join(shutdown)
			let report = observe::shutdown_buffered(exporter)
			let after = observe::buffered_export_permit_count_for_test()
			let no_call: Option<{ index : Int, value : String }> = channel::select_many_timeout(list_cons(lines.rx, list_nil()), 0)
			match joined
				Err(error) => if task::join_error_is_cancelled(error) and buffered_admission_is_accepted(admission) and buffered_unit_received(reached) and buffered_unit_received(shutdown_waiting) and during == baseline + 1 and after == baseline and buffered_no_selected_line(no_call)
					match report
						observe::BufferedShutdownReport(observe::Interrupted, observe::ExporterHealth(1, 0, 0, 0, observe::ProductionHealth(0, 0, 0)), observe::SummaryNotAttempted) => Ok(())
						_ => Err("record publication cancellation froze the wrong report")
					end
				else
					Err("record publication cancellation did not restore permit ownership atomically")
				end
				Ok(_) => Err("record publication cancellation did not remain abrupt")
			end
		end
		_ => Err("record publication cancellation exporter construction failed")
	end
end

test summary_permit_publication_cancellation_discards_unpublished_permits_repeatedly() -> Result<(), String> effects [concurrency]
	let baseline = observe::buffered_export_permit_count_for_test()
	let _ = check_summary_permit_publication_cancellation(baseline)?
	let _ = check_summary_permit_publication_cancellation(baseline)?
	if observe::buffered_export_permit_count_for_test() == baseline
		Ok(())
	else
		Err("repeated summary publication cancellation retained a host permit")
	end
end

fn check_summary_permit_publication_cancellation(baseline: Int) -> Result<(), String> effects [concurrency]
	let entered = channel::bounded<()>(1)
	let release = channel::bounded<()>(1)
	let waiting = channel::bounded<()>(1)
	let lines = observe_test_support_test::export_lines(1)
	let constructed = handle new_buffered_permit_publication_for_test(observe::DiagnosticStandardError, entered.tx, release.rx) with observe_test_support_test::exporter(lines.tx, true)
	match constructed
		observe::BufferedJsonLines(exporter) => begin
			let shutdown = task::spawn_with(shutdown_buffered_task_observed, { exporter: exporter, waiting: waiting.tx })
			let shutdown_waiting: Option<()> = channel::recv(waiting.rx)
			let reached: Option<()> = channel::recv(entered.rx)
			let during = observe::buffered_export_permit_count_for_test()
			task::cancel(shutdown)
			let joined = task::join(shutdown)
			let report = observe::shutdown_buffered(exporter)
			let after = observe::buffered_export_permit_count_for_test()
			let no_call: Option<{ index : Int, value : String }> = channel::select_many_timeout(list_cons(lines.rx, list_nil()), 0)
			match joined
				Err(error) => if task::join_error_is_cancelled(error) and buffered_unit_received(reached) and buffered_unit_received(shutdown_waiting) and during == baseline + 1 and after == baseline and buffered_no_selected_line(no_call)
					match report
						observe::BufferedShutdownReport(observe::Interrupted, observe::ExporterHealth(0, 0, 0, 0, observe::ProductionHealth(0, 0, 0)), observe::SummaryNotAttempted) => Ok(())
						_ => Err("summary publication cancellation froze the wrong report")
					end
				else
					Err("summary publication cancellation did not restore permit ownership atomically")
				end
				Ok(_) => Err("summary publication cancellation did not remain abrupt")
			end
		end
		_ => Err("summary publication cancellation exporter construction failed")
	end
end

fn buffered_failure_body() -> Int effects [observe::Observe]
	log::info(None, "rejected", list_nil())
	log::info(None, "exceptional", list_nil())
	log::info(None, "accepted", list_nil())
	42
end

test buffered_record_rejection_and_exception_are_counted_once_and_later_work_continues() -> Result<(), String> effects [time, concurrency]
	let lines = observe_test_support_test::export_lines(4)
	let constructed = handle new_buffered_failure_for_test(0, observe::NoDiagnosticDestination) with observe_test_support_test::record_failure_exporter(lines.tx)
	match constructed
		observe::BufferedJsonLines(exporter) => begin
			let result = handle handle buffered_failure_body() with observe::buffered_json_lines(exporter) with observe_test_support_test::clock(0)
			let report = observe::shutdown_buffered(exporter)
			let first = channel::recv(lines.rx)
			let second = channel::recv(lines.rx)
			let third = channel::recv(lines.rx)
			let no_more: Option<{ index : Int, value : String }> = channel::select_many_timeout(list_cons(lines.rx, list_nil()), 0)
			match report
				observe::BufferedShutdownReport(observe::Completed, observe::ExporterHealth(2, 0, 0, 0, observe::ProductionHealth(0, 0, 0)), observe::SummaryDisabled) => if result == 42 and buffered_line_contains(first, "\"message\":\"rejected\"") and buffered_line_contains(second, "\"message\":\"exceptional\"") and buffered_line_contains(third, "\"message\":\"accepted\"")
					match no_more
						None => Ok(())
						Some(_) => Err("buffered record failure retried a destination attempt")
					end
				else
					Err("buffered record failure changed the body result or later destination order")
				end
				observe::BufferedShutdownReport(observe::Completed, observe::ExporterHealth(failed, dropped, truncated, redacted, observe::ProductionHealth(series, admitted, metric_dropped)), summary) => Err(string::concat(string::concat(string::concat(string::concat(string::concat(string::concat(string::concat("unexpected buffered record failure report: failed=", int_to_string(failed)), " dropped="), int_to_string(dropped)), " truncated="), int_to_string(truncated)), " redacted="), int_to_string(redacted)))
				_ => Err("buffered record failures did not increment exporter health once each")
			end
		end
		_ => Err("buffered record failure exporter construction failed")
	end
end

test buffered_record_contract_failure_accounts_unsettled_records_and_stops_later_writes() -> Result<(), String> effects [time, concurrency]
	let lines = observe_test_support_test::export_lines(2)
	let outcomes = channel::bounded<ExportWriteOutcome>(2)
	let _ = channel::send(outcomes.tx, observe_test_support_test::ContractFailWrite)
	let _ = channel::send(outcomes.tx, observe_test_support_test::AcceptWrite)
	let constructed = handle new_buffered_failure_for_test(0, observe::NoDiagnosticDestination) with observe_test_support_test::scheduled_exporter(lines.tx, outcomes.rx)
	match constructed
		observe::BufferedJsonLines(exporter) => begin
			let first = handle observe::buffered_export_observation(exporter, buffered_log("contract")) with observe_test_support_test::clock(0)
			let second = handle observe::buffered_export_observation(exporter, buffered_log("later")) with observe_test_support_test::clock(0)
			let report = observe::shutdown_buffered(exporter)
			let attempted = channel::recv(lines.rx)
			let no_more: Option<{ index : Int, value : String }> = channel::select_many_timeout(list_cons(lines.rx, list_nil()), 0)
			match first
				observe::Accepted => match second
					observe::Accepted => match report
						observe::BufferedShutdownReport(observe::Interrupted, observe::ExporterHealth(2, 0, 0, 0, observe::ProductionHealth(0, 0, 0)), observe::SummaryNotAttempted) => if buffered_line_contains(attempted, "\"message\":\"contract\"")
							match no_more
								None => Ok(())
								Some(_) => Err("contract-failing record continued to later buffered work")
							end
						else
							Err("contract-failing record did not make its single destination attempt")
						end
						_ => Err("contract-failing record did not account for every unsettled admission")
					end
					_ => Err("later record was not admitted before the worker contract failure")
				end
				_ => Err("contract-failing record was not admitted")
			end
		end
		_ => Err("buffered contract failure exporter construction failed")
	end
end

test buffered_record_failure_counter_saturates_without_stopping_later_work() -> Result<(), String> effects [time, concurrency]
	let maximum = 9223372036854775807
	let lines = observe_test_support_test::export_lines(3)
	let outcomes = channel::bounded<ExportWriteOutcome>(2)
	let _ = channel::send(outcomes.tx, observe_test_support_test::RejectWrite)
	let _ = channel::send(outcomes.tx, observe_test_support_test::AcceptWrite)
	let constructed = handle new_buffered_failure_for_test(maximum, observe::NoDiagnosticDestination) with observe_test_support_test::scheduled_exporter(lines.tx, outcomes.rx)
	match constructed
		observe::BufferedJsonLines(exporter) => begin
			let first = handle observe::buffered_export_observation(exporter, buffered_log("saturated")) with observe_test_support_test::clock(0)
			let second = handle observe::buffered_export_observation(exporter, buffered_log("later")) with observe_test_support_test::clock(0)
			let report = observe::shutdown_buffered(exporter)
			let first_line = channel::recv(lines.rx)
			let second_line = channel::recv(lines.rx)
			match report
				observe::BufferedShutdownReport(observe::Completed, observe::ExporterHealth(9223372036854775807, 0, 0, 0, observe::ProductionHealth(0, 0, 0)), observe::SummaryDisabled) => match first
					observe::Accepted => match second
						observe::Accepted => if buffered_line_contains(first_line, "\"message\":\"saturated\"") and buffered_line_contains(second_line, "\"message\":\"later\"")
							Ok(())
						else
							Err("saturated failure health stopped or reordered later work")
						end
						_ => Err("saturated failure health rejected later work")
					end
					_ => Err("saturated failure health rejected the first record")
				end
				_ => Err("buffered record failure counter overflowed")
			end
		end
		_ => Err("buffered saturation exporter construction failed")
	end
end

