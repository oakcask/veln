test record_interruption_before_actual_write_entry_revokes_the_call() -> Result<(), String> effects [time, concurrency]
	let entry = channel::bounded<()>(1)
	let entry_release = channel::bounded<()>(1)
	let waiter = channel::bounded<()>(1)
	let waiter_release = channel::bounded<()>(1)
	let reports = channel::bounded<BufferedShutdownReport>(1)
	let events = channel::bounded<String>(1)
	let completion_release = channel::bounded<()>(1)
	let constructed = handle new_buffered_call_entry_for_test(0, observe::DiagnosticStandardError, entry.tx, entry_release.rx) with observe_test_support_test::late_completion_exporter(events.tx, completion_release.rx)
	match constructed
		observe::BufferedJsonLines(exporter) => begin
			let admitted = handle observe::buffered_export_observation(exporter, buffered_log("pre-entry")) with observe_test_support_test::clock(0)
			let ready: Option<()> = channel::recv(entry.rx)
			let survivor = task::spawn_with(shutdown_buffered_and_send, { exporter: exporter, reports: reports.tx })
			let cancelled = task::spawn_with(shutdown_buffered_task_at_wait_boundary, { exporter: exporter, entered: waiter.tx, release: waiter_release.rx })
			let waiting: Option<()> = channel::recv(waiter.rx)
			task::cancel(cancelled)
			let cancelled_join = task::join(cancelled)
			let prompt: Option<{ index : Int, value : BufferedShutdownReport }> = channel::select_many_timeout(list_cons(reports.rx, list_nil()), 250)
			let _ = channel::send(entry_release.tx, ())
			let no_call: Option<{ index : Int, value : String }> = channel::select_many_timeout(list_cons(events.rx, list_nil()), 50)
			let survivor_completed = match task::join(survivor)
				Ok(()) => true
				Err(_) => false
			end
			let repeated = observe::shutdown_buffered(exporter)
			match cancelled_join
				Err(error) => if task::join_error_is_cancelled(error) and buffered_unit_received(ready) and buffered_unit_received(waiting) and buffered_admission_is_accepted(admitted)
					match prompt
						Some({ index: 0, value: observe::BufferedShutdownReport(observe::Interrupted, observe::ExporterHealth(1, 0, 0, 0, observe::ProductionHealth(0, 0, 0)), observe::SummaryNotAttempted) }) => if buffered_no_selected_line(no_call) and survivor_completed
							match repeated
								observe::BufferedShutdownReport(observe::Interrupted, observe::ExporterHealth(1, 0, 0, 0, observe::ProductionHealth(0, 0, 0)), observe::SummaryNotAttempted) => Ok(())
								_ => Err("pre-entry record interruption changed its frozen report")
							end
						else
							Err("pre-entry record interruption started the call or failed to wake the survivor")
						end
						_ => Err("pre-entry record interruption did not revoke the call promptly")
					end
				else
					Err("pre-entry record cancellation missed a deterministic boundary")
				end
				Ok(_) => Err("pre-entry record shutdown waiter lost abrupt cancellation")
			end
		end
		_ => Err("pre-entry record exporter construction failed")
	end
end

