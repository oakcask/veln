	pub DiagnosticFileDestination(path: String)
	pub NoDiagnosticDestination
end

type ExportPayload
	ExportLog(record: LogRecord)
	ExportEvent(record: EventRecord)
	ExportCounter(record: CounterIncrementRecord)
	ExportHistogram(record: HistogramSampleRecord)
	ExportSpanStart(name: String, trace_id: String, span_id: String, parent_span_id: Option<String>, links: List<TraceContext>, source: Option<SourceLocation>)
	ExportSpanFinish(name: String, trace_id: String, span_id: String, parent_span_id: Option<String>, source: Option<SourceLocation>)
end

type ExportStateBoundaryHook
	NoExportStateBoundaryHook
	TestExportStateBoundaryHook(callback: fn(Sender<()>, Receiver<()>) -> () effects [concurrency], entered: Sender<()>, release: Receiver<()>)
end

type BufferedAdmissionBoundaryHook
	NoBufferedAdmissionBoundaryHook
	TestBufferedAdmissionBoundaryHook(callback: fn(Sender<()>, Receiver<()>) -> () effects [concurrency], entered: Sender<()>, release: Receiver<()>)
end

type BufferedAdmissionEntryHook
	NoBufferedAdmissionEntryHook
	TestBufferedAdmissionEntryHook(callback: fn(Sender<()>, Receiver<()>) -> () effects [concurrency], entered: Sender<()>, release: Receiver<()>)
end

type ExporterState
	ExporterState(next_sequence: Int, next_identity: Int, failed_exports: Int, dropped_attributes: Int, truncated_attributes: Int, redacted_attributes: Int)
end

type BufferedExportWork
	BufferedExportWork(line: String, dropped_attributes: Int, truncated_attributes: Int, redacted_attributes: Int)
end

type BufferedIdleHook
	NoBufferedIdleHook
	TestBufferedIdleHook(callback: fn(Sender<()>, Receiver<()>) -> () effects [concurrency], idle: Sender<()>, resume: Receiver<()>)
end

type BufferedCompletionHook
	NoBufferedCompletionHook
	TestBufferedCompletionHook(callback: fn(Sender<()>, Receiver<()>) -> () effects [concurrency], entered: Sender<()>, release: Receiver<()>)
end

type BufferedWorkerBoundaryHook
	NoBufferedWorkerBoundaryHook
	TestBufferedWorkerBoundaryHook(callback: fn(Sender<()>, Receiver<()>) -> () effects [concurrency], entered: Sender<()>, release: Receiver<()>)
end

type BufferedCallEntryHook
	NoBufferedCallEntryHook
	TestBufferedCallEntryHook(callback: fn(Sender<()>, Receiver<()>) -> () effects [concurrency], entered: Sender<()>, release: Receiver<()>)
	TestBufferedCallReturnHook(completed: Sender<()>)
	TestBufferedPermitPublicationHook(callback: fn(Sender<()>, Receiver<()>) -> () effects [concurrency], entered: Sender<()>, release: Receiver<()>)
end

