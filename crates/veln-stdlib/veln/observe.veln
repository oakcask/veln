use prelude

pub type SpanRequest
	pub SpanRequest(name: String, parent: Option<TraceContext>, links: List<TraceContext>)
end

pub type Span
	NoopSpan(request: SpanRequest)
	RecordingSpan(trace_id: String, span_id: String, sampled: Bool)
end

pub type SpanFinish
	SpanFinish(span: Span)
end

pub type RecordingEntry
	pub SpanStarted(name: String, trace_id: String, span_id: String, parent_span_id: Option<String>, links: List<TraceContext>, monotonic_ms: Int)
	pub SpanFinished(trace_id: String, span_id: String, monotonic_ms: Int)
	pub Emitted(record: Observation)
end

type RecordingBuffer
	RecordingBuffer(next_identity: Int, entries: List<RecordingEntry>)
end

pub type Recording
	Recording(prefix: String, state: { tx : Sender<RecordingBuffer>, rx : Receiver<RecordingBuffer> })
end

type MetricSeries
	CounterSeries(name: String, attributes: AttributeMultiset)
	HistogramSeries(name: String, attributes: AttributeMultiset)
end

type AttributeMultiset
	AttributeMultiset(count: Int, bools: Dict<String, { false_count : Int, true_count : Int }>, ints: Dict<String, Dict<Int, Int>>, strings: Dict<String, Dict<String, Int>>)
end

type ProductionState
	ProductionState(series: List<MetricSeries>, series_count: Int, admitted_metric_observations: Int, dropped_metric_observations: Int)
end

type ProductionDecision
	CommitProductionState(state: ProductionState, completed: Sender<()>)
	AbortProductionDecision
end

pub type Production
	Production(metric_series_limit: Int, state: { tx : Sender<ProductionState>, rx : Receiver<ProductionState> })
end

pub type ProductionHealth
	pub ProductionHealth(metric_series: Int, admitted_metric_observations: Int, dropped_metric_observations: Int)
end

pub type AttributeValue
	pub BoolValue(value: Bool)
	pub IntValue(value: Int)
	pub StringValue(value: String)
end

pub type Attribute
	pub Attribute(name: String, value: AttributeValue)
end

pub type TraceContext
	pub TraceContext(trace_id: String, span_id: String, sampled: Bool)
end

pub type TraceCarrier
	pub TraceCarrier(trace_id: Option<String>, span_id: Option<String>, sampled: Option<Bool>)
end

pub type Severity
	pub Debug
	pub Info
	pub Warning
	pub Error
end

pub type LogRecord
	pub LogRecord(name: String, severity: Severity, message: String, attributes: List<Attribute>, context: Option<TraceContext>, source: SourceLocation)
end

pub type EventRecord
	pub EventRecord(name: String, attributes: List<Attribute>, context: Option<TraceContext>, source: SourceLocation)
end

pub type CounterIncrementRecord
	pub CounterIncrementRecord(name: String, value: Int, attributes: List<Attribute>, context: Option<TraceContext>, source: SourceLocation)
end

pub type HistogramSampleRecord
	pub HistogramSampleRecord(name: String, value: Int, attributes: List<Attribute>, context: Option<TraceContext>, source: SourceLocation)
end

pub type Observation
	pub Log(record: LogRecord)
	pub Event(record: EventRecord)
	pub CounterIncrement(record: CounterIncrementRecord)
	pub HistogramSample(record: HistogramSampleRecord)
end

pub effect Observe
	start_span(request: SpanRequest) -> Span
	emit(record: Observation) -> ()
	finish_span(request: SpanFinish) -> ()
end

pub handler noop() for Observe
	start_span(request) => NoopSpan(request)
	emit(record) => ()
	finish_span(request) => ()
end

pub fn new_production(metric_series_limit: Int) -> Production effects [concurrency]
	start_production(metric_series_limit, 0, 0)
end

fn new_production_for_test(metric_series_limit: Int, admitted_metric_observations: Int, dropped_metric_observations: Int) -> Production effects [concurrency]
	start_production(metric_series_limit, admitted_metric_observations, dropped_metric_observations)
end

fn start_production(metric_series_limit: Int, admitted_metric_observations: Int, dropped_metric_observations: Int) -> Production effects [concurrency]
	let state = channel::bounded<ProductionState>(1)
	let limit = if metric_series_limit < 0
		0
	else
		metric_series_limit
	end
	let initial = ProductionState(list_nil(), 0, admitted_metric_observations, dropped_metric_observations)
	let _ = channel::send(state.tx, initial)
	Production(limit, state)
end

pub fn production_health(production: Production) -> ProductionHealth effects [concurrency]
	match production
		Production(_, state_channel) => begin
			let snapshot = channel::bounded<ProductionState>(1)
			let decision = channel::bounded<ProductionDecision>(2)
			let completed = channel::bounded<()>(1)
			defer
				let _ = channel::send(decision.tx, AbortProductionDecision)
				()
			end
			let _ = task::spawn_with<(), { state : { tx : Sender<ProductionState>, rx : Receiver<ProductionState> }, snapshot : Sender<ProductionState>, decision : Receiver<ProductionDecision> }>(production_transaction, { state: state_channel, snapshot: snapshot.tx, decision: decision.rx })
			match channel::recv(snapshot.rx)
				Some(current) => begin
					let health = production_state_health(current)
					let _ = channel::send(decision.tx, CommitProductionState(current, completed.tx))
					let _ = channel::recv(completed.rx)
					health
				end
				None => ProductionHealth(0, 0, 0)
			end
		end
	end
end

pub handler production(production: Production) for Observe effects [concurrency]
	start_span(request) => NoopSpan(request)
	emit(record) => apply_metric_cardinality(production, record)
	finish_span(request) => ()
end

pub fn new_recording(prefix: String) -> Recording effects [concurrency]
	let state = channel::bounded<RecordingBuffer>(1)
	let _ = channel::send(state.tx, RecordingBuffer(0, list_nil()))
	Recording(prefix, state)
end

pub fn recorded(recording: Recording) -> List<RecordingEntry> effects [concurrency]
	match recording
		Recording(prefix, state) => match channel::recv(state.rx)
			Some(buffer) => restore_and_read(state.tx, buffer)
			None => list_nil()
		end
	end
end

pub handler recording(recording: Recording) for Observe effects [time, concurrency]
	start_span(request) => match recording
		Recording(prefix, state) => begin
			let monotonic_ms = time::monotonic_ms()
			match channel::recv(state.rx)
				Some(RecordingBuffer(next_identity, entries)) => match request
					SpanRequest(name, Some(TraceContext(trace_id, parent_span_id, sampled)), links) => begin
						let candidate = string::concat(string::concat(prefix, "-"), int_to_string(next_identity))
						if candidate == parent_span_id
							begin
								let span_id = string::concat(string::concat(prefix, "-"), int_to_string(next_identity + 1))
								let entry = SpanStarted(name, trace_id, span_id, Some(parent_span_id), links, monotonic_ms)
								let _ = channel::send(state.tx, RecordingBuffer(next_identity + 2, list_cons(entry, entries)))
								RecordingSpan(trace_id, span_id, sampled)
							end
						else
							begin
								let entry = SpanStarted(name, trace_id, candidate, Some(parent_span_id), links, monotonic_ms)
								let _ = channel::send(state.tx, RecordingBuffer(next_identity + 1, list_cons(entry, entries)))
								RecordingSpan(trace_id, candidate, sampled)
							end
						end
					end
					SpanRequest(name, _, links) => begin
						let trace_id = string::concat(string::concat(prefix, "-"), int_to_string(next_identity))
						let span_id = string::concat(string::concat(prefix, "-"), int_to_string(next_identity + 1))
						let entry = SpanStarted(name, trace_id, span_id, None, links, monotonic_ms)
						let _ = channel::send(state.tx, RecordingBuffer(next_identity + 2, list_cons(entry, entries)))
						RecordingSpan(trace_id, span_id, true)
					end
				end
				None => NoopSpan(request)
			end
		end
	end
	emit(record) => match recording
		Recording(prefix, state) => match channel::recv(state.rx)
			Some(RecordingBuffer(next_identity, entries)) => begin
				let _ = channel::send(state.tx, RecordingBuffer(next_identity, list_cons(Emitted(record), entries)))
				()
			end
			None => ()
		end
	end
	finish_span(request) => begin
		let monotonic_ms = time::monotonic_ms()
		match request
			SpanFinish(RecordingSpan(trace_id, span_id, _)) => match recording
				Recording(prefix, state) => match channel::recv(state.rx)
					Some(RecordingBuffer(next_identity, entries)) => begin
						let _ = channel::send(state.tx, RecordingBuffer(next_identity, list_cons(SpanFinished(trace_id, span_id, monotonic_ms), entries)))
						()
					end
					None => ()
				end
			end
			SpanFinish(NoopSpan(_)) => ()
		end
	end
end

pub fn finish(span: Span) -> SpanFinish
	SpanFinish(span)
end

pub fn context(span: Span) -> Option<TraceContext>
	match span
		RecordingSpan(trace_id, span_id, sampled) => Some(TraceContext(trace_id, span_id, sampled))
		NoopSpan(_) => None
	end
end

pub fn inject_context(context: TraceContext) -> TraceCarrier
	match context
		TraceContext(trace_id, span_id, sampled) => TraceCarrier(Some(trace_id), Some(span_id), Some(sampled))
	end
end

pub fn extract_context(carrier: TraceCarrier) -> Option<TraceContext>
	match carrier
		TraceCarrier(Some(trace_id), Some(span_id), Some(sampled)) => if trace_id == ""
			None
		else if span_id == ""
			None
		else
			Some(TraceContext(trace_id, span_id, sampled))
		end
		_ => None
	end
end

fn restore_and_read(tx: Sender<RecordingBuffer>, buffer: RecordingBuffer) -> List<RecordingEntry> effects [concurrency]
	match buffer
		RecordingBuffer(next_identity, entries) => begin
			let _ = channel::send(tx, buffer)
			list_reverse(entries)
		end
	end
end

fn apply_metric_cardinality(production: Production, record: Observation) -> () effects [concurrency]
	match metric_series(record)
		Some(candidate) => update_metric_cardinality(production, candidate)
		None => ()
	end
end

fn metric_series(record: Observation) -> Option<MetricSeries>
	match record
		CounterIncrement(CounterIncrementRecord(name, _, attributes, _, _)) => match attribute_multiset(attributes)
			normalized => Some(CounterSeries(name, normalized))
		end
		HistogramSample(HistogramSampleRecord(name, _, attributes, _, _)) => match attribute_multiset(attributes)
			normalized => Some(HistogramSeries(name, normalized))
		end
		_ => None
	end
end

fn update_metric_cardinality(production: Production, candidate: MetricSeries) -> () effects [concurrency]
	let hook = channel::bounded<()>(1)
	update_metric_cardinality_with_hook(production, candidate, production_decision_noop, hook.tx, hook.rx)
end

fn apply_metric_cardinality_for_test(production: Production, record: Observation, decision_hook: fn(Sender<()>, Receiver<()>) -> () effects [concurrency], entered: Sender<()>, release: Receiver<()>) -> () effects [concurrency]
	match metric_series(record)
		Some(candidate) => update_metric_cardinality_with_hook(production, candidate, decision_hook, entered, release)
		None => ()
	end
end

fn update_metric_cardinality_with_hook(production: Production, candidate: MetricSeries, decision_hook: fn(Sender<()>, Receiver<()>) -> () effects [concurrency], entered: Sender<()>, release: Receiver<()>) -> () effects [concurrency]
	match production
		Production(_, state_channel) => begin
			let snapshot = channel::bounded<ProductionState>(1)
			let decision = channel::bounded<ProductionDecision>(2)
			let completed = channel::bounded<()>(1)
			defer
				let _ = channel::send(decision.tx, AbortProductionDecision)
				()
			end
			let _ = task::spawn_with<(), { state : { tx : Sender<ProductionState>, rx : Receiver<ProductionState> }, snapshot : Sender<ProductionState>, decision : Receiver<ProductionDecision> }>(production_transaction, { state: state_channel, snapshot: snapshot.tx, decision: decision.rx })
			match channel::recv(snapshot.rx)
				Some(current) => begin
					decision_hook(entered, release)
					let next = decide_metric_cardinality(production_limit(production), current, candidate)
					let _ = channel::send(decision.tx, CommitProductionState(next, completed.tx))
					let _ = channel::recv(completed.rx)
					()
				end
				None => ()
			end
		end
	end
end

fn production_transaction(context: { state : { tx : Sender<ProductionState>, rx : Receiver<ProductionState> }, snapshot : Sender<ProductionState>, decision : Receiver<ProductionDecision> }) -> () effects [concurrency]
	match channel::recv(context.state.rx)
		Some(state) => begin
			let _ = channel::send(context.snapshot, state)
			match channel::recv(context.decision)
				Some(CommitProductionState(next, completed)) => begin
					let _ = channel::send(context.state.tx, next)
					let _ = channel::send(completed, ())
					()
				end
				Some(AbortProductionDecision) => begin
					let _ = channel::send(context.state.tx, state)
					()
				end
				None => begin
					let _ = channel::send(context.state.tx, state)
					()
				end
			end
		end
		None => ()
	end
end

fn production_decision_noop(entered: Sender<()>, release: Receiver<()>) -> () effects [concurrency]
	()
end

fn production_limit(production: Production) -> Int
	match production
		Production(metric_series_limit, _) => metric_series_limit
	end
end

fn decide_metric_cardinality(metric_series_limit: Int, state: ProductionState, candidate: MetricSeries) -> ProductionState
	match state
		ProductionState(series, series_count, admitted_metric_observations, dropped_metric_observations) => if contains_metric_series(series, candidate)
			ProductionState(series, series_count, bounded_increment(admitted_metric_observations), dropped_metric_observations)
		else if series_count < metric_series_limit
			ProductionState(list_cons(candidate, series), series_count + 1, bounded_increment(admitted_metric_observations), dropped_metric_observations)
		else
			ProductionState(series, series_count, admitted_metric_observations, bounded_increment(dropped_metric_observations))
		end
	end
end

fn production_state_health(state: ProductionState) -> ProductionHealth
	match state
		ProductionState(_, series_count, admitted_metric_observations, dropped_metric_observations) => ProductionHealth(series_count, admitted_metric_observations, dropped_metric_observations)
	end
end

fn bounded_increment(value: Int) -> Int
	if value == 9223372036854775807
		value
	else
		value + 1
	end
end

fn contains_metric_series(series: List<MetricSeries>, candidate: MetricSeries) -> Bool
	match series
		Nil => false
		Cons(known, remaining) => if same_metric_series(known, candidate)
			true
		else
			contains_metric_series(remaining, candidate)
		end
	end
end

fn same_metric_series(left: MetricSeries, right: MetricSeries) -> Bool
	match left
		CounterSeries(left_name, left_attributes) => match right
			CounterSeries(right_name, right_attributes) => left_name == right_name and equivalent_attributes(left_attributes, right_attributes)
			_ => false
		end
		HistogramSeries(left_name, left_attributes) => match right
			HistogramSeries(right_name, right_attributes) => left_name == right_name and equivalent_attributes(left_attributes, right_attributes)
			_ => false
		end
	end
end

fn attribute_multiset(attributes: List<Attribute>) -> AttributeMultiset
	attribute_multiset_step(attributes, AttributeMultiset(0, {}, {}, {}))
end

fn attribute_multiset_step(attributes: List<Attribute>, multiset: AttributeMultiset) -> AttributeMultiset
	match attributes
		Nil => multiset
		Cons(attribute, remaining) => attribute_multiset_step(remaining, insert_attribute(multiset, attribute))
	end
end

fn insert_attribute(multiset: AttributeMultiset, attribute: Attribute) -> AttributeMultiset
	match multiset
		AttributeMultiset(count, bools, ints, strings) => match attribute
			Attribute(name, BoolValue(value)) => AttributeMultiset(count + 1, insert_bool_attribute(bools, name, value), ints, strings)
			Attribute(name, IntValue(value)) => AttributeMultiset(count + 1, bools, insert_int_attribute(ints, name, value), strings)
			Attribute(name, StringValue(value)) => AttributeMultiset(count + 1, bools, ints, insert_string_attribute(strings, name, value))
		end
	end
end

fn insert_bool_attribute(bools: Dict<String, { false_count : Int, true_count : Int }>, name: String, value: Bool) -> Dict<String, { false_count : Int, true_count : Int }>
	let counts = match dict_get(bools, name)
		Some(existing) => existing
		None => { false_count: 0, true_count: 0 }
	end
	if value
		dict_insert(bools, name, { false_count: counts.false_count, true_count: counts.true_count + 1 })
	else
		dict_insert(bools, name, { false_count: counts.false_count + 1, true_count: counts.true_count })
	end
end

fn insert_int_attribute(ints: Dict<String, Dict<Int, Int>>, name: String, value: Int) -> Dict<String, Dict<Int, Int>>
	let values = option_unwrap_or(dict_get(ints, name), {})
	let multiplicity = option_unwrap_or(dict_get(values, value), 0)
	dict_insert(ints, name, dict_insert(values, value, multiplicity + 1))
end

fn insert_string_attribute(strings: Dict<String, Dict<String, Int>>, name: String, value: String) -> Dict<String, Dict<String, Int>>
	let values = option_unwrap_or(dict_get(strings, name), {})
	let multiplicity = option_unwrap_or(dict_get(values, value), 0)
	dict_insert(strings, name, dict_insert(values, value, multiplicity + 1))
end

fn equivalent_attributes(left: AttributeMultiset, right: AttributeMultiset) -> Bool
	match left
		AttributeMultiset(left_count, left_bools, left_ints, left_strings) => match right
			AttributeMultiset(right_count, right_bools, right_ints, right_strings) => left_count == right_count and equivalent_bool_attributes(left_bools, right_bools) and equivalent_int_attributes(left_ints, right_ints) and equivalent_string_attributes(left_strings, right_strings)
		end
	end
end

fn equivalent_bool_attributes(left: Dict<String, { false_count : Int, true_count : Int }>, right: Dict<String, { false_count : Int, true_count : Int }>) -> Bool
	dict_fold_with(right, left, true, same_bool_attribute_counts)
end

fn same_bool_attribute_counts(right: Dict<String, { false_count : Int, true_count : Int }>, equal: Bool, name: String, counts: { false_count : Int, true_count : Int }) -> Bool
	if equal
		match dict_get(right, name)
			Some(right_counts) => counts.false_count == right_counts.false_count and counts.true_count == right_counts.true_count
			None => false
		end
	else
		false
	end
end

fn equivalent_int_attributes(left: Dict<String, Dict<Int, Int>>, right: Dict<String, Dict<Int, Int>>) -> Bool
	dict_fold_with(right, left, true, same_int_attribute_values)
end

fn same_int_attribute_values(right: Dict<String, Dict<Int, Int>>, equal: Bool, name: String, values: Dict<Int, Int>) -> Bool
	if equal
		match dict_get(right, name)
			Some(right_values) => dict_fold_with(right_values, values, true, same_int_multiplicity)
			None => false
		end
	else
		false
	end
end

fn same_int_multiplicity(right: Dict<Int, Int>, equal: Bool, value: Int, multiplicity: Int) -> Bool
	if equal
		match dict_get(right, value)
			Some(right_multiplicity) => multiplicity == right_multiplicity
			None => false
		end
	else
		false
	end
end

fn equivalent_string_attributes(left: Dict<String, Dict<String, Int>>, right: Dict<String, Dict<String, Int>>) -> Bool
	dict_fold_with(right, left, true, same_string_attribute_values)
end

fn same_string_attribute_values(right: Dict<String, Dict<String, Int>>, equal: Bool, name: String, values: Dict<String, Int>) -> Bool
	if equal
		match dict_get(right, name)
			Some(right_values) => dict_fold_with(right_values, values, true, same_string_multiplicity)
			None => false
		end
	else
		false
	end
end

fn same_string_multiplicity(right: Dict<String, Int>, equal: Bool, value: String, multiplicity: Int) -> Bool
	if equal
		match dict_get(right, value)
			Some(right_multiplicity) => multiplicity == right_multiplicity
			None => false
		end
	else
		false
	end
end

fn is_noop_span(span: Span) -> Bool
	match span
		NoopSpan(_) => true
		_ => false
	end
end
