use prelude

pub type SpanRequest
	pub SpanRequest(name: String, parent: Option<TraceContext>, links: List<TraceContext>)
	pub LocatedSpanRequest(name: String, parent: Option<TraceContext>, links: List<TraceContext>, source: SourceLocation)
end

pub type Span
	NoopSpan(request: SpanRequest)
	RecordingSpan(trace_id: String, span_id: String, sampled: Bool)
	ExportSpan(name: String, trace_id: String, span_id: String, parent_span_id: Option<String>, sampled: Bool, source: Option<SourceLocation>)
end

pub type SpanFinish
	SpanFinish(span: Span)
end

pub type RecordingEntry
	pub SpanStarted(name: String, trace_id: String, span_id: String, parent_span_id: Option<String>, links: List<TraceContext>, monotonic_ms: Int)
	pub SpanFinished(trace_id: String, span_id: String, monotonic_ms: Int)
	pub Emitted(record: Observation)
end

type RecordingBuffer
	RecordingBuffer(next_identity: Int, entries: List<RecordingEntry>)
end

pub type Recording
	Recording(prefix: String, state: { tx : Sender<RecordingBuffer>, rx : Receiver<RecordingBuffer> })
end

type MetricSeries
	CounterSeries(name: String, attributes: List<Attribute>)
	HistogramSeries(name: String, attributes: List<Attribute>)
end

type ProductionState
	ProductionState(series_index: Int, series_count: Int, admitted_metric_observations: Int, dropped_metric_observations: Int)
end

pub type Production
	Production(metric_series_limit: Int, state: { tx : Sender<ProductionState>, rx : Receiver<ProductionState> })
end

pub type ProductionHealth
	pub ProductionHealth(metric_series: Int, admitted_metric_observations: Int, dropped_metric_observations: Int)
end

pub type Resource
	pub Resource(name: String, attributes: List<Attribute>)
end

pub type InstrumentationScope
	pub InstrumentationScope(name: String, version: String)
end

pub type ExporterLimits
	pub ExporterLimits(maximum_attributes: Int, maximum_string_size: Int, maximum_redacted_attributes: Int, redacted_attribute_names: List<String>)
end

pub type ExportDestination
	pub StandardError
	pub FileDestination(path: String)
end

pub type DiagnosticDestination
	pub DiagnosticStandardError
	pub DiagnosticFileDestination(path: String)
	pub NoDiagnosticDestination
end

type ExportPayload
	ExportLog(record: LogRecord)
	ExportEvent(record: EventRecord)
	ExportCounter(record: CounterIncrementRecord)
	ExportHistogram(record: HistogramSampleRecord)
	ExportSpanStart(name: String, trace_id: String, span_id: String, parent_span_id: Option<String>, links: List<TraceContext>, source: Option<SourceLocation>)
	ExportSpanFinish(name: String, trace_id: String, span_id: String, parent_span_id: Option<String>, source: Option<SourceLocation>)
end

type ExportStateBoundaryHook
	NoExportStateBoundaryHook
	TestExportStateBoundaryHook(callback: fn(Sender<()>, Receiver<()>) -> () effects [concurrency], entered: Sender<()>, release: Receiver<()>)
end

type ExporterState
	ExporterState(next_sequence: Int, next_identity: Int, failed_exports: Int, dropped_attributes: Int, truncated_attributes: Int, redacted_attributes: Int)
end

type BufferedExportWork
	BufferedExportWork(line: String, dropped_attributes: Int, truncated_attributes: Int, redacted_attributes: Int)
end

type BufferedIdleHook
	NoBufferedIdleHook
	TestBufferedIdleHook(callback: fn(Sender<()>, Receiver<()>) -> () effects [concurrency], idle: Sender<()>, resume: Receiver<()>)
end

type BufferedLifecycle
	BufferedOpen
	BufferedClosing
	BufferedClosed(report: BufferedShutdownReport)
end

type BufferedExporterState
	BufferedExporterState(next_sequence: Int, failed_exports: Int, dropped_attributes: Int, truncated_attributes: Int, redacted_attributes: Int, outstanding: Int, queued: List<BufferedExportWork>, worker_active: Bool, lifecycle: BufferedLifecycle)
end

pub type JsonLinesExporter
	JsonLinesExporter(resource: Resource, scope: InstrumentationScope, limits: ExporterLimits, destination: ExportDestination, diagnostic_destination: DiagnosticDestination, identity_prefix: String, production: Production, state: { tx : Sender<ExporterState>, rx : Receiver<ExporterState> })
end

pub type ExporterHealth
	pub ExporterHealth(failed_exports: Int, dropped_attributes: Int, truncated_attributes: Int, redacted_attributes: Int, cardinality: ProductionHealth)
end

pub type BufferedAdmissionOutcome
	pub Accepted
	pub Full
	pub Closed
	pub InvalidRecord
end

pub type BufferedSummaryOutcome
	pub SummaryAccepted
	pub SummaryRejected
	pub SummaryDisabled
	pub SummaryNotAttempted
end

pub type BufferedShutdownState
	pub Completed
	pub Interrupted
end

pub type BufferedShutdownReport
	pub BufferedShutdownReport(state: BufferedShutdownState, health: ExporterHealth, summary: BufferedSummaryOutcome)
end

pub type BufferedJsonLinesExporter
	BufferedJsonLinesExporter(capacity: Int, resource: Resource, scope: InstrumentationScope, limits: ExporterLimits, destination: ExportDestination, diagnostic_destination: DiagnosticDestination, production: Production, state: { tx : Sender<BufferedExporterState>, rx : Receiver<BufferedExporterState> }, ready: Sender<()>, worker: Task<()>)
end

pub type BufferedJsonLinesConstruction
	pub BufferedJsonLines(exporter: BufferedJsonLinesExporter)
	pub InvalidCapacity(capacity: Int)
end

pub type AttributeValue
	pub BoolValue(value: Bool)
	pub IntValue(value: Int)
	pub StringValue(value: String)
end

pub type Attribute
	pub Attribute(name: String, value: AttributeValue)
end

pub type TraceContext
	pub TraceContext(trace_id: String, span_id: String, sampled: Bool)
end

pub type TraceCarrier
	pub TraceCarrier(trace_id: Option<String>, span_id: Option<String>, sampled: Option<Bool>)
end

pub type Severity
	pub Debug
	pub Info
	pub Warning
	pub Error
end

pub type LogRecord
	pub LogRecord(name: String, severity: Severity, message: String, attributes: List<Attribute>, context: Option<TraceContext>, source: SourceLocation)
end

pub type EventRecord
	pub EventRecord(name: String, attributes: List<Attribute>, context: Option<TraceContext>, source: SourceLocation)
end

pub type CounterIncrementRecord
	pub CounterIncrementRecord(name: String, value: Int, attributes: List<Attribute>, context: Option<TraceContext>, source: SourceLocation)
end

pub type HistogramSampleRecord
	pub HistogramSampleRecord(name: String, value: Int, attributes: List<Attribute>, context: Option<TraceContext>, source: SourceLocation)
end

pub type Observation
	pub Log(record: LogRecord)
	pub Event(record: EventRecord)
	pub CounterIncrement(record: CounterIncrementRecord)
	pub HistogramSample(record: HistogramSampleRecord)
end

pub effect Observe
	start_span(request: SpanRequest) -> Span
	emit(record: Observation) -> ()
	finish_span(request: SpanFinish) -> ()
end

pub handler noop() for Observe
	start_span(request) => NoopSpan(request)
	emit(record) => ()
	finish_span(request) => ()
end

pub fn new_production(metric_series_limit: Int) -> Production effects [concurrency]
	start_production(metric_series_limit, 0, 0)
end

fn new_production_for_test(metric_series_limit: Int, admitted_metric_observations: Int, dropped_metric_observations: Int) -> Production effects [concurrency]
	start_production(metric_series_limit, admitted_metric_observations, dropped_metric_observations)
end

fn start_production(metric_series_limit: Int, admitted_metric_observations: Int, dropped_metric_observations: Int) -> Production effects [concurrency]
	let state = channel::bounded<ProductionState>(1)
	let limit = if metric_series_limit < 0
		0
	else
		metric_series_limit
	end
	let initial = ProductionState(prelude_builtin::production_metric_index_new(limit), 0, admitted_metric_observations, dropped_metric_observations)
	let _ = channel::send(state.tx, initial)
	Production(limit, state)
end

pub fn production_health(production: Production) -> ProductionHealth effects [concurrency]
	match production
		Production(_, state_channel) => begin
			match channel::recv(state_channel.rx)
				Some(current) => begin
					let committed = channel::bounded<()>(1)
					defer
						restore_uncommitted_production_state(state_channel.tx, current, committed.rx)
					end
					let health = production_state_health(current)
					commit_production_state(state_channel.tx, current, committed.tx, None)
					health
				end
				None => ProductionHealth(0, 0, 0)
			end
		end
	end
end

pub handler production(production: Production) for Observe effects [concurrency]
	start_span(request) => NoopSpan(request)
	emit(record) => begin
		let _ = apply_metric_cardinality(production, record)
		()
	end
	finish_span(request) => ()
end

pub fn span_request(name: String, parent: Option<TraceContext>, links: List<TraceContext>) -> SpanRequest callsite
	LocatedSpanRequest(name, parent, links, callsite)
end

pub fn new_json_lines(resource: Resource, scope: InstrumentationScope, metric_series_limit: Int, limits: ExporterLimits, destination: ExportDestination, diagnostic_destination: DiagnosticDestination, identity_prefix: String) -> JsonLinesExporter effects [concurrency]
	start_json_lines(resource, scope, metric_series_limit, limits, destination, diagnostic_destination, identity_prefix, 0, 0, 0, 0)
end

fn new_json_lines_for_test(resource: Resource, scope: InstrumentationScope, metric_series_limit: Int, limits: ExporterLimits, destination: ExportDestination, diagnostic_destination: DiagnosticDestination, identity_prefix: String, failed_exports: Int, dropped_attributes: Int, truncated_attributes: Int, redacted_attributes: Int) -> JsonLinesExporter effects [concurrency]
	start_json_lines(resource, scope, metric_series_limit, limits, destination, diagnostic_destination, identity_prefix, failed_exports, dropped_attributes, truncated_attributes, redacted_attributes)
end

fn start_json_lines(resource: Resource, scope: InstrumentationScope, metric_series_limit: Int, limits: ExporterLimits, destination: ExportDestination, diagnostic_destination: DiagnosticDestination, identity_prefix: String, failed_exports: Int, dropped_attributes: Int, truncated_attributes: Int, redacted_attributes: Int) -> JsonLinesExporter effects [concurrency]
	let state = channel::bounded<ExporterState>(1)
	let _ = channel::send(state.tx, ExporterState(1, 1, failed_exports, dropped_attributes, truncated_attributes, redacted_attributes))
	JsonLinesExporter(resource, scope, normalize_exporter_limits(limits), destination, diagnostic_destination, identity_prefix, new_production(metric_series_limit), state)
end

pub fn new_json_lines_default(resource: Resource, scope: InstrumentationScope, metric_series_limit: Int, limits: ExporterLimits, identity_prefix: String) -> JsonLinesExporter effects [concurrency]
	new_json_lines(resource, scope, metric_series_limit, limits, StandardError, NoDiagnosticDestination, identity_prefix)
end

pub fn new_buffered_json_lines(resource: Resource, scope: InstrumentationScope, metric_series_limit: Int, limits: ExporterLimits, destination: ExportDestination, diagnostic_destination: DiagnosticDestination, identity_prefix: String, capacity: Int) -> BufferedJsonLinesConstruction effects [concurrency]
	start_buffered_json_lines(resource, scope, metric_series_limit, limits, destination, diagnostic_destination, identity_prefix, capacity, NoBufferedIdleHook)
end

fn new_buffered_json_lines_with_idle_hook_for_test(resource: Resource, scope: InstrumentationScope, metric_series_limit: Int, limits: ExporterLimits, destination: ExportDestination, diagnostic_destination: DiagnosticDestination, identity_prefix: String, capacity: Int, callback: fn(Sender<()>, Receiver<()>) -> () effects [concurrency], idle: Sender<()>, resume: Receiver<()>) -> BufferedJsonLinesConstruction effects [concurrency]
	start_buffered_json_lines(resource, scope, metric_series_limit, limits, destination, diagnostic_destination, identity_prefix, capacity, TestBufferedIdleHook(callback, idle, resume))
end

fn start_buffered_json_lines(resource: Resource, scope: InstrumentationScope, metric_series_limit: Int, limits: ExporterLimits, destination: ExportDestination, diagnostic_destination: DiagnosticDestination, identity_prefix: String, capacity: Int, idle_hook: BufferedIdleHook) -> BufferedJsonLinesConstruction effects [concurrency]
	if capacity <= 0
		InvalidCapacity(capacity)
	else
		begin
			let production = new_production(metric_series_limit)
			let state = channel::bounded<BufferedExporterState>(1)
			let _ = channel::send(state.tx, BufferedExporterState(1, 0, 0, 0, 0, 0, list_nil(), false, BufferedOpen))
			let ready = channel::bounded<()>(1)
			let worker = task::spawn_with<(), { state : { tx : Sender<BufferedExporterState>, rx : Receiver<BufferedExporterState> }, ready : Receiver<()>, destination : ExportDestination, diagnostic_destination : DiagnosticDestination, production : Production, idle_hook : BufferedIdleHook }>(run_buffered_export_worker, { state: state, ready: ready.rx, destination: destination, diagnostic_destination: diagnostic_destination, production: production, idle_hook: idle_hook })
			BufferedJsonLines(BufferedJsonLinesExporter(capacity, resource, scope, normalize_exporter_limits(limits), destination, diagnostic_destination, production, state, ready.tx, worker))
		end
	end
end

pub handler json_lines(exporter: JsonLinesExporter) for Observe effects [time, concurrency]
	start_span(request) => start_export_span(exporter, request)
	emit(record) => match exporter
		JsonLinesExporter(_, _, _, _, _, _, production, _) => if apply_metric_cardinality(production, record)
			export_observation(exporter, record)
		else
			()
		end
	end
	finish_span(request) => finish_export_span(exporter, request)
end

pub fn exporter_health(exporter: JsonLinesExporter) -> ExporterHealth effects [concurrency]
	match exporter
		JsonLinesExporter(_, _, _, _, _, _, production, state) => match channel::recv(state.rx)
			Some(current) => begin
				let committed = channel::bounded<()>(1)
				defer
					restore_uncommitted_exporter_state(state.tx, current, committed.rx)
				end
				let health = exporter_state_health(current, production_health(production))
				commit_exporter_state(state.tx, current, committed.tx)
				health
			end
			None => ExporterHealth(0, 0, 0, 0, ProductionHealth(0, 0, 0))
		end
	end
end

pub fn report_exporter_health(exporter: JsonLinesExporter) -> Bool effects [concurrency]
	match exporter
		JsonLinesExporter(_, _, _, _, diagnostic_destination, _, _, _) => match exporter_health(exporter)
			health => prelude_builtin::observation_export_write(diagnostic_destination, exporter_health_line(health), true)
		end
	end
end

fn exporter_health_line(health: ExporterHealth) -> String
	match health
		ExporterHealth(failed, dropped, truncated, redacted, ProductionHealth(series, admitted, cardinality_dropped)) => begin
			let line = string::concat(string::concat(string::concat(string::concat(string::concat(string::concat(string::concat(string::concat(string::concat("{\"schema_version\":1,\"kind\":\"exporter_health\",\"failed_exports\":", int_to_string(failed)), ",\"dropped_attributes\":"), int_to_string(dropped)), ",\"truncated_attributes\":"), int_to_string(truncated)), ",\"redacted_attributes\":"), int_to_string(redacted)), ",\"metric_series\":"), int_to_string(series))
			let metrics = string::concat(string::concat(string::concat(string::concat(line, ",\"admitted_metric_observations\":"), int_to_string(admitted)), ",\"dropped_metric_observations\":"), int_to_string(cardinality_dropped))
			string::concat(metrics, "}\n")
		end
	end
end

pub fn new_recording(prefix: String) -> Recording effects [concurrency]
	let state = channel::bounded<RecordingBuffer>(1)
	let _ = channel::send(state.tx, RecordingBuffer(0, list_nil()))
	Recording(prefix, state)
end

pub fn recorded(recording: Recording) -> List<RecordingEntry> effects [concurrency]
	match recording
		Recording(prefix, state) => match channel::recv(state.rx)
			Some(buffer) => restore_and_read(state.tx, buffer)
			None => list_nil()
		end
	end
end

pub handler recording(recording: Recording) for Observe effects [time, concurrency]
	start_span(request) => match recording
		Recording(prefix, state) => begin
			let monotonic_ms = time::monotonic_ms()
			match channel::recv(state.rx)
				Some(RecordingBuffer(next_identity, entries)) => match request
					SpanRequest(name, Some(TraceContext(trace_id, parent_span_id, sampled)), links) => begin
						let candidate = string::concat(string::concat(prefix, "-"), int_to_string(next_identity))
						if candidate == parent_span_id
							begin
								let span_id = string::concat(string::concat(prefix, "-"), int_to_string(next_identity + 1))
								let entry = SpanStarted(name, trace_id, span_id, Some(parent_span_id), links, monotonic_ms)
								let _ = channel::send(state.tx, RecordingBuffer(next_identity + 2, list_cons(entry, entries)))
								RecordingSpan(trace_id, span_id, sampled)
							end
						else
							begin
								let entry = SpanStarted(name, trace_id, candidate, Some(parent_span_id), links, monotonic_ms)
								let _ = channel::send(state.tx, RecordingBuffer(next_identity + 1, list_cons(entry, entries)))
								RecordingSpan(trace_id, candidate, sampled)
							end
						end
					end
					SpanRequest(name, _, links) => begin
						let trace_id = string::concat(string::concat(prefix, "-"), int_to_string(next_identity))
						let span_id = string::concat(string::concat(prefix, "-"), int_to_string(next_identity + 1))
						let entry = SpanStarted(name, trace_id, span_id, None, links, monotonic_ms)
						let _ = channel::send(state.tx, RecordingBuffer(next_identity + 2, list_cons(entry, entries)))
						RecordingSpan(trace_id, span_id, true)
					end
					LocatedSpanRequest(name, Some(TraceContext(trace_id, parent_span_id, sampled)), links, _) => begin
						let candidate = string::concat(string::concat(prefix, "-"), int_to_string(next_identity))
						if candidate == parent_span_id
							begin
								let span_id = string::concat(string::concat(prefix, "-"), int_to_string(next_identity + 1))
								let entry = SpanStarted(name, trace_id, span_id, Some(parent_span_id), links, monotonic_ms)
								let _ = channel::send(state.tx, RecordingBuffer(next_identity + 2, list_cons(entry, entries)))
								RecordingSpan(trace_id, span_id, sampled)
							end
						else
							begin
								let entry = SpanStarted(name, trace_id, candidate, Some(parent_span_id), links, monotonic_ms)
								let _ = channel::send(state.tx, RecordingBuffer(next_identity + 1, list_cons(entry, entries)))
								RecordingSpan(trace_id, candidate, sampled)
							end
						end
					end
					LocatedSpanRequest(name, _, links, _) => begin
						let trace_id = string::concat(string::concat(prefix, "-"), int_to_string(next_identity))
						let span_id = string::concat(string::concat(prefix, "-"), int_to_string(next_identity + 1))
						let entry = SpanStarted(name, trace_id, span_id, None, links, monotonic_ms)
						let _ = channel::send(state.tx, RecordingBuffer(next_identity + 2, list_cons(entry, entries)))
						RecordingSpan(trace_id, span_id, true)
					end
				end
				None => NoopSpan(request)
			end
		end
	end
	emit(record) => match recording
		Recording(prefix, state) => match channel::recv(state.rx)
			Some(RecordingBuffer(next_identity, entries)) => begin
				let _ = channel::send(state.tx, RecordingBuffer(next_identity, list_cons(Emitted(record), entries)))
				()
			end
			None => ()
		end
	end
	finish_span(request) => begin
		let monotonic_ms = time::monotonic_ms()
		match request
			SpanFinish(RecordingSpan(trace_id, span_id, _)) => match recording
				Recording(prefix, state) => match channel::recv(state.rx)
					Some(RecordingBuffer(next_identity, entries)) => begin
						let _ = channel::send(state.tx, RecordingBuffer(next_identity, list_cons(SpanFinished(trace_id, span_id, monotonic_ms), entries)))
						()
					end
					None => ()
				end
			end
			SpanFinish(NoopSpan(_)) => ()
			SpanFinish(ExportSpan(_, _, _, _, _, _)) => ()
		end
	end
end

pub fn finish(span: Span) -> SpanFinish
	SpanFinish(span)
end

pub fn context(span: Span) -> Option<TraceContext>
	match span
		RecordingSpan(trace_id, span_id, sampled) => Some(TraceContext(trace_id, span_id, sampled))
		ExportSpan(_, trace_id, span_id, _, sampled, _) => Some(TraceContext(trace_id, span_id, sampled))
		NoopSpan(_) => None
	end
end

pub fn inject_context(context: TraceContext) -> TraceCarrier
	match context
		TraceContext(trace_id, span_id, sampled) => TraceCarrier(Some(trace_id), Some(span_id), Some(sampled))
	end
end

pub fn extract_context(carrier: TraceCarrier) -> Option<TraceContext>
	match carrier
		TraceCarrier(Some(trace_id), Some(span_id), Some(sampled)) => if trace_id == ""
			None
		else if span_id == ""
			None
		else
			Some(TraceContext(trace_id, span_id, sampled))
		end
		_ => None
	end
end

fn restore_and_read(tx: Sender<RecordingBuffer>, buffer: RecordingBuffer) -> List<RecordingEntry> effects [concurrency]
	match buffer
		RecordingBuffer(next_identity, entries) => begin
			let _ = channel::send(tx, buffer)
			list_reverse(entries)
		end
	end
end

pub fn apply_metric_cardinality(production: Production, record: Observation) -> Bool effects [concurrency]
	match metric_series(record)
		Some(candidate) => update_metric_cardinality(production, candidate)
		None => true
	end
end

fn metric_series(record: Observation) -> Option<MetricSeries>
	match record
		CounterIncrement(CounterIncrementRecord(name, _, attributes, _, _)) => Some(CounterSeries(name, attributes))
		HistogramSample(HistogramSampleRecord(name, _, attributes, _, _)) => Some(HistogramSeries(name, attributes))
		_ => None
	end
end

fn update_metric_cardinality(production: Production, candidate: MetricSeries) -> Bool effects [concurrency]
	match production
		Production(metric_series_limit, state_channel) => match channel::recv(state_channel.rx)
			Some(current) => begin
				let committed = channel::bounded<()>(1)
				defer
					restore_uncommitted_production_state(state_channel.tx, current, committed.rx)
				end
				match decide_metric_cardinality(metric_series_limit, current, candidate)
					{ state: next, retained: retained, admitted: admitted } => begin
						commit_production_state(state_channel.tx, next, committed.tx, retained)
						admitted
					end
				end
			end
			None => false
		end
	end
end

fn apply_metric_cardinality_for_test(production: Production, record: Observation, decision_hook: fn(Sender<()>, Receiver<()>) -> () effects [concurrency], entered: Sender<()>, release: Receiver<()>) -> () effects [concurrency]
	match metric_series(record)
		Some(candidate) => begin
			let _ = update_metric_cardinality_with_hook(production, candidate, decision_hook, entered, release)
			()
		end
		None => ()
	end
end

fn update_metric_cardinality_with_hook(production: Production, candidate: MetricSeries, decision_hook: fn(Sender<()>, Receiver<()>) -> () effects [concurrency], entered: Sender<()>, release: Receiver<()>) -> Bool effects [concurrency]
	match production
		Production(metric_series_limit, state_channel) => begin
			match channel::recv(state_channel.rx)
				Some(current) => begin
					let committed = channel::bounded<()>(1)
					defer
						restore_uncommitted_production_state(state_channel.tx, current, committed.rx)
					end
					decision_hook(entered, release)
					match decide_metric_cardinality(metric_series_limit, current, candidate)
						{ state: next, retained: retained, admitted: admitted } => begin
							commit_production_state(state_channel.tx, next, committed.tx, retained)
							admitted
						end
					end
				end
				None => false
			end
		end
	end
end

fn commit_production_state(state: Sender<ProductionState>, next: ProductionState, committed: Sender<()>, retained: Option<MetricSeries>) -> () effects [concurrency]
	match retained
		Some(candidate) => match next
			ProductionState(series_index, _, _, _) => prelude_builtin::production_metric_index_insert(series_index, candidate)
		end
		None => ()
	end
	let _ = channel::send(committed, ())
	let _ = channel::send(state, next)
	()
end

fn restore_uncommitted_production_state(state: Sender<ProductionState>, original: ProductionState, committed: Receiver<()>) -> () effects [concurrency]
	match channel::select_many_timeout(list_cons(committed, list_nil()), 0)
		Some(_) => ()
		None => begin
			let _ = channel::send(state, original)
			()
		end
	end
end

fn decide_metric_cardinality(metric_series_limit: Int, state: ProductionState, candidate: MetricSeries) -> { state : ProductionState, retained : Option<MetricSeries>, admitted : Bool }
	match state
		ProductionState(series_index, series_count, admitted_metric_observations, dropped_metric_observations) => if prelude_builtin::production_metric_index_contains(series_index, candidate)
			{ state: ProductionState(series_index, series_count, bounded_increment(admitted_metric_observations), dropped_metric_observations), retained: None, admitted: true }
		else if series_count < metric_series_limit
			{ state: ProductionState(series_index, series_count + 1, bounded_increment(admitted_metric_observations), dropped_metric_observations), retained: Some(candidate), admitted: true }
		else
			{ state: ProductionState(series_index, series_count, admitted_metric_observations, bounded_increment(dropped_metric_observations)), retained: None, admitted: false }
		end
	end
end

fn production_state_health(state: ProductionState) -> ProductionHealth
	match state
		ProductionState(_, series_count, admitted_metric_observations, dropped_metric_observations) => ProductionHealth(series_count, admitted_metric_observations, dropped_metric_observations)
	end
end

fn bounded_increment(value: Int) -> Int
	if value == 9223372036854775807
		value
	else
		value + 1
	end
end

fn normalize_exporter_limits(limits: ExporterLimits) -> ExporterLimits
	match limits
		ExporterLimits(maximum_attributes, maximum_string_size, maximum_redacted_attributes, names) => ExporterLimits(non_negative(maximum_attributes), non_negative(maximum_string_size), non_negative(maximum_redacted_attributes), names)
	end
end

fn non_negative(value: Int) -> Int
	if value < 0
		0
	else
		value
	end
end

fn exporter_state_health(state: ExporterState, cardinality: ProductionHealth) -> ExporterHealth
	match state
		ExporterState(_, _, failed, dropped, truncated, redacted) => ExporterHealth(failed, dropped, truncated, redacted, cardinality)
	end
end

fn request_name(request: SpanRequest) -> String
	match request
		SpanRequest(name, _, _) => name
		LocatedSpanRequest(name, _, _, _) => name
	end
end

fn request_parent(request: SpanRequest) -> Option<TraceContext>
	match request
		SpanRequest(_, parent, _) => parent
		LocatedSpanRequest(_, parent, _, _) => parent
	end
end

fn request_links(request: SpanRequest) -> List<TraceContext>
	match request
		SpanRequest(_, _, links) => links
		LocatedSpanRequest(_, _, links, _) => links
	end
end

fn request_source(request: SpanRequest) -> Option<SourceLocation>
	match request
		SpanRequest(_, _, _) => None
		LocatedSpanRequest(_, _, _, source) => Some(source)
	end
end

pub fn start_export_span(exporter: JsonLinesExporter, request: SpanRequest) -> Span effects [time, concurrency]
	match exporter
		JsonLinesExporter(_, _, _, _, _, identity_prefix, _, state) => match channel::recv(state.rx)
			Some(current) => begin
				let committed = channel::bounded<()>(1)
				defer
					restore_uncommitted_exporter_state(state.tx, current, committed.rx)
				end
				match current
					ExporterState(sequence, next_identity, failed, dropped, truncated, redacted) => begin
						let parent = request_parent(request)
						let trace_id = match parent
							Some(TraceContext(parent_trace, _, _)) => parent_trace
							None => prelude_builtin::observation_export_identity(identity_prefix, "trace", next_identity)
						end
						let parent_span_id: Option<String> = match parent
							Some(TraceContext(_, parent_span, _)) => Some(parent_span)
							None => None
						end
						let sampled = match parent
							Some(TraceContext(_, _, parent_sampled)) => parent_sampled
							None => true
						end
						let span_id = prelude_builtin::observation_export_identity(identity_prefix, "span", next_identity)
						commit_exporter_state(state.tx, ExporterState(sequence, bounded_increment(next_identity), failed, dropped, truncated, redacted), committed.tx)
						let name = request_name(request)
						export_payload(exporter, ExportSpanStart(name, trace_id, span_id, parent_span_id, request_links(request), request_source(request)))
						ExportSpan(name, trace_id, span_id, parent_span_id, sampled, request_source(request))
					end
				end
			end
			None => NoopSpan(request)
		end
	end
end

pub fn finish_export_span(exporter: JsonLinesExporter, request: SpanFinish) -> () effects [time, concurrency]
	match request
		SpanFinish(ExportSpan(name, trace_id, span_id, parent_span_id, _, source)) => export_payload(exporter, ExportSpanFinish(name, trace_id, span_id, parent_span_id, source))
		_ => ()
	end
end

pub fn export_observation(exporter: JsonLinesExporter, record: Observation) -> () effects [time, concurrency]
	export_payload(exporter, observation_export_payload(record))
end

fn observation_export_payload(record: Observation) -> ExportPayload
	match record
		Log(value) => ExportLog(value)
		Event(value) => ExportEvent(value)
		CounterIncrement(value) => ExportCounter(value)
		HistogramSample(value) => ExportHistogram(value)
	end
end

pub fn buffered_export_observation(exporter: BufferedJsonLinesExporter, record: Observation) -> BufferedAdmissionOutcome effects [time, concurrency]
	match exporter
		BufferedJsonLinesExporter(capacity, resource, scope, limits, _, _, production, state, ready, _) => match channel::recv(state.rx)
			Some(current) => begin
				let committed = channel::bounded<()>(1)
				defer
					restore_uncommitted_buffered_state(state.tx, current, committed.rx)
				end
				match current
					BufferedExporterState(sequence, failed, dropped, truncated, redacted, outstanding, queued, worker_active, BufferedOpen) => begin
						let wall_time = time::wall_time()
						let cardinality = production_health(production)
						match cardinality
							ProductionHealth(_, admitted_metrics, dropped_metrics) => begin
								let encoded: { valid : Bool, line : String, dropped : Int, truncated : Int, redacted : Int } = prelude_builtin::observation_json_line(observation_export_payload(record), wall_time, sequence, resource, scope, limits, failed, admitted_metrics, dropped_metrics)
								if not encoded.valid
									begin
										commit_buffered_state(state.tx, BufferedExporterState(bounded_increment(sequence), bounded_increment(failed), dropped, truncated, redacted, outstanding, queued, worker_active, BufferedOpen), committed.tx)
										InvalidRecord
									end
								else if outstanding >= capacity
									begin
										commit_buffered_state(state.tx, BufferedExporterState(bounded_increment(sequence), bounded_increment(failed), dropped, truncated, redacted, outstanding, queued, worker_active, BufferedOpen), committed.tx)
										Full
									end
								else
									begin
										let next_queued = list_cons(BufferedExportWork(encoded.line, encoded.dropped, encoded.truncated, encoded.redacted), queued)
										commit_buffered_state(state.tx, BufferedExporterState(bounded_increment(sequence), failed, bounded_add(dropped, encoded.dropped), bounded_add(truncated, encoded.truncated), bounded_add(redacted, encoded.redacted), outstanding + 1, next_queued, true, BufferedOpen), committed.tx)
										if not worker_active
											begin
												let _ = channel::send(ready, ())
												()
											end
										else
											()
										end
										Accepted
									end
								end
							end
						end
					end
					BufferedExporterState(_, _, _, _, _, _, _, _, _) => begin
						commit_buffered_state(state.tx, current, committed.tx)
						Closed
					end
				end
			end
			None => Closed
		end
	end
end

pub fn buffered_exporter_health(exporter: BufferedJsonLinesExporter) -> ExporterHealth effects [concurrency]
	match exporter
		BufferedJsonLinesExporter(_, _, _, _, _, _, production, state, _, _) => match channel::recv(state.rx)
			Some(current) => begin
				let committed = channel::bounded<()>(1)
				defer
					restore_uncommitted_buffered_state(state.tx, current, committed.rx)
				end
				let health = match current
					BufferedExporterState(_, _, _, _, _, _, _, _, BufferedClosed(BufferedShutdownReport(_, frozen, _))) => frozen
					BufferedExporterState(_, failed, dropped, truncated, redacted, _, _, _, _) => ExporterHealth(failed, dropped, truncated, redacted, production_health(production))
				end
				commit_buffered_state(state.tx, current, committed.tx)
				health
			end
			None => ExporterHealth(0, 0, 0, 0, ProductionHealth(0, 0, 0))
		end
	end
end

pub fn shutdown_buffered(exporter: BufferedJsonLinesExporter) -> BufferedShutdownReport effects [concurrency]
	match exporter
		BufferedJsonLinesExporter(_, _, _, _, _, _, production, state, ready, worker) => match begin_buffered_shutdown(state, ready)
			Some(report) => report
			None => begin
				let _ = task::join(worker)
				read_buffered_shutdown_report(state, production)
			end
		end
	end
end

fn begin_buffered_shutdown(state: { tx : Sender<BufferedExporterState>, rx : Receiver<BufferedExporterState> }, ready: Sender<()>) -> Option<BufferedShutdownReport> effects [concurrency]
	match channel::recv(state.rx)
		Some(current) => begin
			let committed = channel::bounded<()>(1)
			defer
				restore_uncommitted_buffered_state(state.tx, current, committed.rx)
			end
			match current
				BufferedExporterState(_, _, _, _, _, _, _, _, BufferedClosed(report)) => begin
					commit_buffered_state(state.tx, current, committed.tx)
					Some(report)
				end
				BufferedExporterState(sequence, failed, dropped, truncated, redacted, outstanding, queued, worker_active, BufferedOpen) => begin
					commit_buffered_state(state.tx, BufferedExporterState(sequence, failed, dropped, truncated, redacted, outstanding, queued, true, BufferedClosing), committed.tx)
					if not worker_active
						begin
							let _ = channel::send(ready, ())
							()
						end
					else
						()
					end
					None
				end
				BufferedExporterState(_, _, _, _, _, _, _, _, BufferedClosing) => begin
					commit_buffered_state(state.tx, current, committed.tx)
					None
				end
			end
		end
		None => None
	end
end

fn read_buffered_shutdown_report(state: { tx : Sender<BufferedExporterState>, rx : Receiver<BufferedExporterState> }, production: Production) -> BufferedShutdownReport effects [concurrency]
	match channel::recv(state.rx)
		Some(current) => begin
			let committed = channel::bounded<()>(1)
			defer
				restore_uncommitted_buffered_state(state.tx, current, committed.rx)
			end
			let report = match current
				BufferedExporterState(_, _, _, _, _, _, _, _, BufferedClosed(frozen)) => frozen
				BufferedExporterState(_, failed, dropped, truncated, redacted, _, _, _, _) => BufferedShutdownReport(Interrupted, ExporterHealth(failed, dropped, truncated, redacted, production_health(production)), SummaryNotAttempted)
			end
			commit_buffered_state(state.tx, current, committed.tx)
			report
		end
		None => BufferedShutdownReport(Interrupted, ExporterHealth(0, 0, 0, 0, ProductionHealth(0, 0, 0)), SummaryNotAttempted)
	end
end

fn run_buffered_export_worker(context: { state : { tx : Sender<BufferedExporterState>, rx : Receiver<BufferedExporterState> }, ready : Receiver<()>, destination : ExportDestination, diagnostic_destination : DiagnosticDestination, production : Production, idle_hook : BufferedIdleHook }) -> () effects [concurrency]
	match channel::recv(context.ready)
		Some(_) => if drain_buffered_exports(context)
			run_buffered_export_worker(context)
		else
			()
		end
		None => ()
	end
end

fn drain_buffered_exports(context: { state : { tx : Sender<BufferedExporterState>, rx : Receiver<BufferedExporterState> }, ready : Receiver<()>, destination : ExportDestination, diagnostic_destination : DiagnosticDestination, production : Production, idle_hook : BufferedIdleHook }) -> Bool effects [concurrency]
	match channel::recv(context.state.rx)
		Some(BufferedExporterState(sequence, failed, dropped, truncated, redacted, outstanding, queued, _, lifecycle)) => match queued
			Cons(_, _) => begin
				let work = list_reverse(queued)
				let _ = channel::send(context.state.tx, BufferedExporterState(sequence, failed, dropped, truncated, redacted, outstanding, list_nil(), true, lifecycle))
				export_buffered_batch(context, work)
				drain_buffered_exports(context)
			end
			Nil => begin
				match lifecycle
					BufferedOpen => begin
						let _ = channel::send(context.state.tx, BufferedExporterState(sequence, failed, dropped, truncated, redacted, outstanding, queued, false, lifecycle))
						notify_buffered_idle(context.idle_hook)
						true
					end
					BufferedClosing => begin
						let _ = channel::send(context.state.tx, BufferedExporterState(sequence, failed, dropped, truncated, redacted, outstanding, queued, true, lifecycle))
						complete_buffered_export(context.state, context.diagnostic_destination, context.production)
						false
					end
					BufferedClosed(_) => begin
						let _ = channel::send(context.state.tx, BufferedExporterState(sequence, failed, dropped, truncated, redacted, outstanding, queued, false, lifecycle))
						false
					end
				end
			end
		end
		None => false
	end
end

fn export_buffered_batch(context: { state : { tx : Sender<BufferedExporterState>, rx : Receiver<BufferedExporterState> }, ready : Receiver<()>, destination : ExportDestination, diagnostic_destination : DiagnosticDestination, production : Production, idle_hook : BufferedIdleHook }, work: List<BufferedExportWork>) -> () effects [concurrency]
	match work
		Cons(BufferedExportWork(line, _, _, _), tail) => begin
			let written = prelude_builtin::observation_export_write(context.destination, line, false)
			settle_buffered_export(context.state, written)
			export_buffered_batch(context, tail)
		end
		Nil => ()
	end
end

fn settle_buffered_export(state: { tx : Sender<BufferedExporterState>, rx : Receiver<BufferedExporterState> }, written: Bool) -> () effects [concurrency]
	match channel::recv(state.rx)
		Some(BufferedExporterState(sequence, failed, dropped, truncated, redacted, outstanding, queued, worker_active, lifecycle)) => begin
			let next_failed = if written
				failed
			else
				bounded_increment(failed)
			end
			let _ = channel::send(state.tx, BufferedExporterState(sequence, next_failed, dropped, truncated, redacted, outstanding - 1, queued, worker_active, lifecycle))
			()
		end
		None => ()
	end
end

fn notify_buffered_idle(hook: BufferedIdleHook) -> () effects [concurrency]
	match hook
		NoBufferedIdleHook => ()
		TestBufferedIdleHook(callback, idle, resume) => callback(idle, resume)
	end
end

fn complete_buffered_export(state: { tx : Sender<BufferedExporterState>, rx : Receiver<BufferedExporterState> }, diagnostic_destination: DiagnosticDestination, production: Production) -> () effects [concurrency]
	match channel::recv(state.rx)
		Some(BufferedExporterState(sequence, failed, dropped, truncated, redacted, _, queued, _, lifecycle)) => match lifecycle
			BufferedClosed(_) => begin
				let _ = channel::send(state.tx, BufferedExporterState(sequence, failed, dropped, truncated, redacted, 0, queued, false, lifecycle))
				()
			end
			_ => begin
				let health = ExporterHealth(failed, dropped, truncated, redacted, production_health(production))
				let summary = buffered_summary_outcome(diagnostic_destination, health)
				let report = BufferedShutdownReport(Completed, health, summary)
				let _ = channel::send(state.tx, BufferedExporterState(sequence, failed, dropped, truncated, redacted, 0, queued, false, BufferedClosed(report)))
				()
			end
		end
		None => ()
	end
end

fn buffered_summary_outcome(destination: DiagnosticDestination, health: ExporterHealth) -> BufferedSummaryOutcome effects [concurrency]
	match destination
		NoDiagnosticDestination => SummaryDisabled
		_ => if prelude_builtin::observation_export_write(destination, exporter_health_line(health), true)
			SummaryAccepted
		else
			SummaryRejected
		end
	end
end

fn commit_buffered_state(state: Sender<BufferedExporterState>, next: BufferedExporterState, committed: Sender<()>) -> () effects [concurrency]
	let _ = channel::send(committed, ())
	let _ = channel::send(state, next)
	()
end

fn restore_uncommitted_buffered_state(state: Sender<BufferedExporterState>, original: BufferedExporterState, committed: Receiver<()>) -> () effects [concurrency]
	match channel::select_many_timeout(list_cons(committed, list_nil()), 0)
		Some(_) => ()
		None => begin
			let _ = channel::send(state, original)
			()
		end
	end
end

fn buffered_outstanding_for_test(exporter: BufferedJsonLinesExporter) -> Int effects [concurrency]
	match exporter
		BufferedJsonLinesExporter(_, _, _, _, _, _, _, state, _, _) => match channel::recv(state.rx)
			Some(current) => match current
				BufferedExporterState(_, _, _, _, _, outstanding, _, _, _) => begin
					let _ = channel::send(state.tx, current)
					outstanding
				end
			end
			None => 0
		end
	end
end

fn export_payload(exporter: JsonLinesExporter, payload: ExportPayload) -> () effects [time, concurrency]
	export_payload_with_boundary_hook(exporter, payload, NoExportStateBoundaryHook)
end

fn export_metric_with_boundary_hook_for_test(exporter: JsonLinesExporter, record: Observation, callback: fn(Sender<()>, Receiver<()>) -> () effects [concurrency], entered: Sender<()>, release: Receiver<()>) -> () effects [time, concurrency]
	match exporter
		JsonLinesExporter(_, _, _, _, _, _, production, _) => if apply_metric_cardinality(production, record)
			match record
				CounterIncrement(value) => export_payload_with_boundary_hook(exporter, ExportCounter(value), TestExportStateBoundaryHook(callback, entered, release))
				HistogramSample(value) => export_payload_with_boundary_hook(exporter, ExportHistogram(value), TestExportStateBoundaryHook(callback, entered, release))
				_ => ()
			end
		else
			()
		end
	end
end

fn export_payload_with_boundary_hook(exporter: JsonLinesExporter, payload: ExportPayload, boundary_hook: ExportStateBoundaryHook) -> () effects [time, concurrency]
	let wall_time = time::wall_time()
	match exporter
		JsonLinesExporter(resource, scope, limits, destination, _, _, production, state) => begin
			run_export_state_boundary_hook(boundary_hook)
			match channel::recv(state.rx)
				Some(current) => begin
					let committed = channel::bounded<()>(1)
					defer
						restore_uncommitted_exporter_state(state.tx, current, committed.rx)
					end
					match production_health(production)
						ProductionHealth(_, admitted_metrics, dropped_metrics) => match current
							ExporterState(sequence, next_identity, failed, dropped, truncated, redacted) => begin
								let encoded: { valid : Bool, line : String, dropped : Int, truncated : Int, redacted : Int } = prelude_builtin::observation_json_line(payload, wall_time, sequence, resource, scope, limits, failed, admitted_metrics, dropped_metrics)
								let written = if encoded.valid
									prelude_builtin::observation_export_write(destination, encoded.line, false)
								else
									false
								end
								let next_failed = if written
									failed
								else
									bounded_increment(failed)
								end
								commit_exporter_state(state.tx, ExporterState(bounded_increment(sequence), next_identity, next_failed, bounded_add(dropped, encoded.dropped), bounded_add(truncated, encoded.truncated), bounded_add(redacted, encoded.redacted)), committed.tx)
								()
							end
						end
					end
				end
				None => ()
			end
		end
	end
end

fn run_export_state_boundary_hook(boundary_hook: ExportStateBoundaryHook) -> () effects [concurrency]
	match boundary_hook
		NoExportStateBoundaryHook => ()
		TestExportStateBoundaryHook(callback, entered, release) => callback(entered, release)
	end
end

fn commit_exporter_state(state: Sender<ExporterState>, next: ExporterState, committed: Sender<()>) -> () effects [concurrency]
	let _ = channel::send(committed, ())
	let _ = channel::send(state, next)
	()
end

fn restore_uncommitted_exporter_state(state: Sender<ExporterState>, original: ExporterState, committed: Receiver<()>) -> () effects [concurrency]
	match channel::select_many_timeout(list_cons(committed, list_nil()), 0)
		Some(_) => ()
		None => begin
			let _ = channel::send(state, original)
			()
		end
	end
end

fn bounded_add(left: Int, right: Int) -> Int
	if right <= 0
		left
	else if left > 9223372036854775807 - right
		9223372036854775807
	else
		left + right
	end
end

fn production_index_work_for_test(production: Production) -> Int effects [concurrency]
	match production
		Production(_, state_channel) => match channel::recv(state_channel.rx)
			Some(current) => begin
				let committed = channel::bounded<()>(1)
				defer
					restore_uncommitted_production_state(state_channel.tx, current, committed.rx)
				end
				match current
					ProductionState(series_index, _, _, _) => begin
						let work = prelude_builtin::production_metric_index_work(series_index)
						commit_production_state(state_channel.tx, current, committed.tx, None)
						work
					end
				end
			end
			None => 0
		end
	end
end

fn reset_production_index_work_for_test(production: Production) -> () effects [concurrency]
	match production
		Production(_, state_channel) => match channel::recv(state_channel.rx)
			Some(current) => begin
				let committed = channel::bounded<()>(1)
				defer
					restore_uncommitted_production_state(state_channel.tx, current, committed.rx)
				end
				match current
					ProductionState(series_index, _, _, _) => prelude_builtin::production_metric_index_reset_work(series_index)
				end
				commit_production_state(state_channel.tx, current, committed.tx, None)
			end
			None => ()
		end
	end
end

fn is_noop_span(span: Span) -> Bool
	match span
		NoopSpan(_) => true
		_ => false
	end
end
