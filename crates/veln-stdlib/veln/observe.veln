end

pub type BufferedJsonLinesConstruction
	pub BufferedJsonLines(exporter: BufferedJsonLinesExporter)
	pub InvalidCapacity(capacity: Int)
end

pub type AttributeValue
	pub BoolValue(value: Bool)
	pub IntValue(value: Int)
	pub StringValue(value: String)
end

pub type Attribute
	pub Attribute(name: String, value: AttributeValue)
end

pub type TraceContext
	pub TraceContext(trace_id: String, span_id: String, sampled: Bool)
end

pub type TraceCarrier
	pub TraceCarrier(trace_id: Option<String>, span_id: Option<String>, sampled: Option<Bool>)
end

pub type Severity
	pub Debug
	pub Info
	pub Warning
	pub Error
end

pub type LogRecord
	pub LogRecord(name: String, severity: Severity, message: String, attributes: List<Attribute>, context: Option<TraceContext>, source: SourceLocation)
end

pub type EventRecord
	pub EventRecord(name: String, attributes: List<Attribute>, context: Option<TraceContext>, source: SourceLocation)
end

pub type CounterIncrementRecord
	pub CounterIncrementRecord(name: String, value: Int, attributes: List<Attribute>, context: Option<TraceContext>, source: SourceLocation)
end

pub type HistogramSampleRecord
	pub HistogramSampleRecord(name: String, value: Int, attributes: List<Attribute>, context: Option<TraceContext>, source: SourceLocation)
end

pub type Observation
	pub Log(record: LogRecord)
	pub Event(record: EventRecord)
	pub CounterIncrement(record: CounterIncrementRecord)
	pub HistogramSample(record: HistogramSampleRecord)
end

pub effect Observe
	start_span(request: SpanRequest) -> Span
	emit(record: Observation) -> ()
	finish_span(request: SpanFinish) -> ()
end

pub handler noop() for Observe
	start_span(request) => NoopSpan(request)
	emit(record) => ()
	finish_span(request) => ()
end

pub fn new_production(metric_series_limit: Int) -> Production effects [concurrency]
	start_production(metric_series_limit, 0, 0)
end

fn new_production_for_test(metric_series_limit: Int, admitted_metric_observations: Int, dropped_metric_observations: Int) -> Production effects [concurrency]
	start_production(metric_series_limit, admitted_metric_observations, dropped_metric_observations)
end

fn start_production(metric_series_limit: Int, admitted_metric_observations: Int, dropped_metric_observations: Int) -> Production effects [concurrency]
	let state = channel::bounded<ProductionState>(1)
	let limit = if metric_series_limit < 0
		0
	else
		metric_series_limit
	end
	let initial = ProductionState(prelude_builtin::production_metric_index_new(limit), 0, admitted_metric_observations, dropped_metric_observations)
	let _ = channel::send(state.tx, initial)
	Production(limit, state)
end

pub fn production_health(production: Production) -> ProductionHealth effects [concurrency]
	match production
		Production(_, state_channel) => begin
			match channel::recv(state_channel.rx)
				Some(current) => begin
					let committed = channel::bounded<()>(1)
					defer
						restore_uncommitted_production_state(state_channel.tx, current, committed.rx)
					end
					let health = production_state_health(current)
					commit_production_state(state_channel.tx, current, committed.tx, None)
					health
				end
				None => ProductionHealth(0, 0, 0)
			end
		end
	end
end

pub handler production(production: Production) for Observe effects [concurrency]
	start_span(request) => NoopSpan(request)
	emit(record) => begin
		let _ = apply_metric_cardinality(production, record)
		()
	end
	finish_span(request) => ()
end

pub fn span_request(name: String, parent: Option<TraceContext>, links: List<TraceContext>) -> SpanRequest callsite
	LocatedSpanRequest(name, parent, links, callsite)
end

pub fn new_json_lines(resource: Resource, scope: InstrumentationScope, metric_series_limit: Int, limits: ExporterLimits, destination: ExportDestination, diagnostic_destination: DiagnosticDestination, identity_prefix: String) -> JsonLinesExporter effects [concurrency]
	start_json_lines(resource, scope, metric_series_limit, limits, destination, diagnostic_destination, identity_prefix, 0, 0, 0, 0)
end

fn new_json_lines_for_test(resource: Resource, scope: InstrumentationScope, metric_series_limit: Int, limits: ExporterLimits, destination: ExportDestination, diagnostic_destination: DiagnosticDestination, identity_prefix: String, failed_exports: Int, dropped_attributes: Int, truncated_attributes: Int, redacted_attributes: Int) -> JsonLinesExporter effects [concurrency]
	start_json_lines(resource, scope, metric_series_limit, limits, destination, diagnostic_destination, identity_prefix, failed_exports, dropped_attributes, truncated_attributes, redacted_attributes)
end

fn start_json_lines(resource: Resource, scope: InstrumentationScope, metric_series_limit: Int, limits: ExporterLimits, destination: ExportDestination, diagnostic_destination: DiagnosticDestination, identity_prefix: String, failed_exports: Int, dropped_attributes: Int, truncated_attributes: Int, redacted_attributes: Int) -> JsonLinesExporter effects [concurrency]
	let state = channel::bounded<ExporterState>(1)
	let _ = channel::send(state.tx, ExporterState(1, 1, failed_exports, dropped_attributes, truncated_attributes, redacted_attributes))
	JsonLinesExporter(resource, scope, normalize_exporter_limits(limits), destination, diagnostic_destination, identity_prefix, new_production(metric_series_limit), state)
end

pub fn new_json_lines_default(resource: Resource, scope: InstrumentationScope, metric_series_limit: Int, limits: ExporterLimits, identity_prefix: String) -> JsonLinesExporter effects [concurrency]
	new_json_lines(resource, scope, metric_series_limit, limits, StandardError, NoDiagnosticDestination, identity_prefix)
end

pub fn new_buffered_json_lines(resource: Resource, scope: InstrumentationScope, metric_series_limit: Int, limits: ExporterLimits, destination: ExportDestination, diagnostic_destination: DiagnosticDestination, identity_prefix: String, capacity: Int) -> BufferedJsonLinesConstruction effects [concurrency]
	start_buffered_json_lines(resource, scope, metric_series_limit, limits, destination, diagnostic_destination, identity_prefix, capacity, 0, NoBufferedIdleHook, NoBufferedCompletionHook, NoBufferedWorkerBoundaryHook, NoBufferedWorkerBoundaryHook, NoBufferedCallEntryHook, NoBufferedWorkerBoundaryHook)
end

fn new_buffered_json_lines_with_call_return_hook_for_test(resource: Resource, scope: InstrumentationScope, metric_series_limit: Int, limits: ExporterLimits, destination: ExportDestination, diagnostic_destination: DiagnosticDestination, identity_prefix: String, capacity: Int, failed_exports: Int, completed: Sender<()>) -> BufferedJsonLinesConstruction effects [concurrency]
	start_buffered_json_lines(resource, scope, metric_series_limit, limits, destination, diagnostic_destination, identity_prefix, capacity, failed_exports, NoBufferedIdleHook, NoBufferedCompletionHook, NoBufferedWorkerBoundaryHook, NoBufferedWorkerBoundaryHook, TestBufferedCallReturnHook(completed), NoBufferedWorkerBoundaryHook)
end

fn new_buffered_json_lines_with_permit_publication_hook_for_test(resource: Resource, scope: InstrumentationScope, metric_series_limit: Int, limits: ExporterLimits, destination: ExportDestination, diagnostic_destination: DiagnosticDestination, identity_prefix: String, capacity: Int, failed_exports: Int, callback: fn(Sender<()>, Receiver<()>) -> () effects [concurrency], entered: Sender<()>, release: Receiver<()>) -> BufferedJsonLinesConstruction effects [concurrency]
	start_buffered_json_lines(resource, scope, metric_series_limit, limits, destination, diagnostic_destination, identity_prefix, capacity, failed_exports, NoBufferedIdleHook, NoBufferedCompletionHook, NoBufferedWorkerBoundaryHook, NoBufferedWorkerBoundaryHook, TestBufferedPermitPublicationHook(callback, entered, release), NoBufferedWorkerBoundaryHook)
end

fn new_buffered_json_lines_with_idle_hook_for_test(resource: Resource, scope: InstrumentationScope, metric_series_limit: Int, limits: ExporterLimits, destination: ExportDestination, diagnostic_destination: DiagnosticDestination, identity_prefix: String, capacity: Int, callback: fn(Sender<()>, Receiver<()>) -> () effects [concurrency], idle: Sender<()>, resume: Receiver<()>) -> BufferedJsonLinesConstruction effects [concurrency]
	start_buffered_json_lines(resource, scope, metric_series_limit, limits, destination, diagnostic_destination, identity_prefix, capacity, 0, TestBufferedIdleHook(callback, idle, resume), NoBufferedCompletionHook, NoBufferedWorkerBoundaryHook, NoBufferedWorkerBoundaryHook, NoBufferedCallEntryHook, NoBufferedWorkerBoundaryHook)
end

fn new_buffered_json_lines_with_failed_exports_for_test(resource: Resource, scope: InstrumentationScope, metric_series_limit: Int, limits: ExporterLimits, destination: ExportDestination, diagnostic_destination: DiagnosticDestination, identity_prefix: String, capacity: Int, failed_exports: Int) -> BufferedJsonLinesConstruction effects [concurrency]
	start_buffered_json_lines(resource, scope, metric_series_limit, limits, destination, diagnostic_destination, identity_prefix, capacity, failed_exports, NoBufferedIdleHook, NoBufferedCompletionHook, NoBufferedWorkerBoundaryHook, NoBufferedWorkerBoundaryHook, NoBufferedCallEntryHook, NoBufferedWorkerBoundaryHook)
end

fn new_buffered_json_lines_with_completion_hook_for_test(resource: Resource, scope: InstrumentationScope, metric_series_limit: Int, limits: ExporterLimits, destination: ExportDestination, diagnostic_destination: DiagnosticDestination, identity_prefix: String, capacity: Int, failed_exports: Int, callback: fn(Sender<()>, Receiver<()>) -> () effects [concurrency], entered: Sender<()>, release: Receiver<()>) -> BufferedJsonLinesConstruction effects [concurrency]
	start_buffered_json_lines(resource, scope, metric_series_limit, limits, destination, diagnostic_destination, identity_prefix, capacity, failed_exports, NoBufferedIdleHook, TestBufferedCompletionHook(callback, entered, release), NoBufferedWorkerBoundaryHook, NoBufferedWorkerBoundaryHook, NoBufferedCallEntryHook, NoBufferedWorkerBoundaryHook)
end

fn new_buffered_json_lines_with_worker_boundary_hook_for_test(resource: Resource, scope: InstrumentationScope, metric_series_limit: Int, limits: ExporterLimits, destination: ExportDestination, diagnostic_destination: DiagnosticDestination, identity_prefix: String, capacity: Int, failed_exports: Int, before_queue_reversal: Bool, callback: fn(Sender<()>, Receiver<()>) -> () effects [concurrency], entered: Sender<()>, release: Receiver<()>) -> BufferedJsonLinesConstruction effects [concurrency]
	let queue_hook = if before_queue_reversal
		TestBufferedWorkerBoundaryHook(callback, entered, release)
	else
		NoBufferedWorkerBoundaryHook
	end
	let health_hook = if before_queue_reversal
		NoBufferedWorkerBoundaryHook
	else
		TestBufferedWorkerBoundaryHook(callback, entered, release)
	end
	start_buffered_json_lines(resource, scope, metric_series_limit, limits, destination, diagnostic_destination, identity_prefix, capacity, failed_exports, NoBufferedIdleHook, NoBufferedCompletionHook, queue_hook, health_hook, NoBufferedCallEntryHook, NoBufferedWorkerBoundaryHook)
end

fn new_buffered_json_lines_with_call_entry_hook_for_test(resource: Resource, scope: InstrumentationScope, metric_series_limit: Int, limits: ExporterLimits, destination: ExportDestination, diagnostic_destination: DiagnosticDestination, identity_prefix: String, capacity: Int, failed_exports: Int, callback: fn(Sender<()>, Receiver<()>) -> () effects [concurrency], entered: Sender<()>, release: Receiver<()>) -> BufferedJsonLinesConstruction effects [concurrency]
	start_buffered_json_lines(resource, scope, metric_series_limit, limits, destination, diagnostic_destination, identity_prefix, capacity, failed_exports, NoBufferedIdleHook, NoBufferedCompletionHook, NoBufferedWorkerBoundaryHook, NoBufferedWorkerBoundaryHook, TestBufferedCallEntryHook(callback, entered, release), NoBufferedWorkerBoundaryHook)
end

fn new_buffered_json_lines_with_interruption_hook_for_test(resource: Resource, scope: InstrumentationScope, metric_series_limit: Int, limits: ExporterLimits, destination: ExportDestination, diagnostic_destination: DiagnosticDestination, identity_prefix: String, capacity: Int, failed_exports: Int, callback: fn(Sender<()>, Receiver<()>) -> () effects [concurrency], entered: Sender<()>, release: Receiver<()>) -> BufferedJsonLinesConstruction effects [concurrency]
	start_buffered_json_lines(resource, scope, metric_series_limit, limits, destination, diagnostic_destination, identity_prefix, capacity, failed_exports, NoBufferedIdleHook, NoBufferedCompletionHook, NoBufferedWorkerBoundaryHook, NoBufferedWorkerBoundaryHook, NoBufferedCallEntryHook, TestBufferedWorkerBoundaryHook(callback, entered, release))
end

fn start_buffered_json_lines(resource: Resource, scope: InstrumentationScope, metric_series_limit: Int, limits: ExporterLimits, destination: ExportDestination, diagnostic_destination: DiagnosticDestination, identity_prefix: String, capacity: Int, failed_exports: Int, idle_hook: BufferedIdleHook, completion_hook: BufferedCompletionHook, queue_hook: BufferedWorkerBoundaryHook, health_hook: BufferedWorkerBoundaryHook, call_entry_hook: BufferedCallEntryHook, interruption_hook: BufferedWorkerBoundaryHook) -> BufferedJsonLinesConstruction effects [concurrency]
	if capacity <= 0
		InvalidCapacity(capacity)
	else
		begin
			let production = new_production(metric_series_limit)
			let identity_state = channel::bounded<Int>(1)
			let _ = channel::send(identity_state.tx, 1)
			let span_allocator = BufferedSpanAllocator(identity_prefix, identity_state)
			let state = channel::bounded<BufferedExporterState>(1)
			let _ = channel::send(state.tx, BufferedExporterState(1, failed_exports, 0, 0, 0, 0, list_nil(), false, BufferedOpen))
			let calls = channel::bounded<BufferedCallState>(1)
			let _ = channel::send(calls.tx, BufferedNoCall)
			let ready = channel::bounded<()>(1)
			let worker = task::spawn_with(run_buffered_export_worker, { state: state, calls: calls, ready: ready.rx, destination: destination, diagnostic_destination: diagnostic_destination, production: production, idle_hook: idle_hook, completion_hook: completion_hook, queue_hook: queue_hook, health_hook: health_hook, call_entry_hook: call_entry_hook, interruption_hook: interruption_hook })
			BufferedJsonLines(BufferedJsonLinesExporter(capacity, resource, scope, normalize_exporter_limits(limits), production, span_allocator, state, ready.tx, worker))
		end
	end
end

pub handler json_lines(exporter: JsonLinesExporter) for Observe effects [time, concurrency]
	start_span(request) => start_export_span(exporter, request)
	emit(record) => match exporter
		JsonLinesExporter(_, _, _, _, _, _, production, _) => if apply_metric_cardinality(production, record)
			export_observation(exporter, record)
		else
			()
		end
	end
	finish_span(request) => finish_export_span(exporter, request)
end

pub handler buffered_json_lines(exporter: BufferedJsonLinesExporter) for Observe effects [time, concurrency]
	start_span(request) => match buffered_start_export_span(exporter, request)
		BufferedSpanStart(span, _) => span
	end
	emit(record) => begin
		let _ = buffered_export_observation_with_cardinality(exporter, record)
		()
	end
	finish_span(request) => begin
		let _ = buffered_finish_export_span(exporter, request)
		()
	end
end

pub fn exporter_health(exporter: JsonLinesExporter) -> ExporterHealth effects [concurrency]
	match exporter
		JsonLinesExporter(_, _, _, _, _, _, production, state) => match channel::recv(state.rx)
			Some(current) => begin
				let committed = channel::bounded<()>(1)
				defer
					restore_uncommitted_exporter_state(state.tx, current, committed.rx)
				end
				let health = exporter_state_health(current, production_health(production))
				commit_exporter_state(state.tx, current, committed.tx)
				health
			end
			None => ExporterHealth(0, 0, 0, 0, ProductionHealth(0, 0, 0))
		end
	end
end

pub fn report_exporter_health(exporter: JsonLinesExporter) -> Bool effects [concurrency]
	match exporter
		JsonLinesExporter(_, _, _, _, diagnostic_destination, _, _, _) => match exporter_health(exporter)
			health => prelude_builtin::observation_export_write(diagnostic_destination, exporter_health_line(health), true)
		end
	end
end

fn exporter_health_line(health: ExporterHealth) -> String
	match health
		ExporterHealth(failed, dropped, truncated, redacted, ProductionHealth(series, admitted, cardinality_dropped)) => begin
			let line = string::concat(string::concat(string::concat(string::concat(string::concat(string::concat(string::concat(string::concat(string::concat("{\"schema_version\":1,\"kind\":\"exporter_health\",\"failed_exports\":", int_to_string(failed)), ",\"dropped_attributes\":"), int_to_string(dropped)), ",\"truncated_attributes\":"), int_to_string(truncated)), ",\"redacted_attributes\":"), int_to_string(redacted)), ",\"metric_series\":"), int_to_string(series))
			let metrics = string::concat(string::concat(string::concat(string::concat(line, ",\"admitted_metric_observations\":"), int_to_string(admitted)), ",\"dropped_metric_observations\":"), int_to_string(cardinality_dropped))
			string::concat(metrics, "}\n")
		end
	end
end

pub fn new_recording(prefix: String) -> Recording effects [concurrency]
	let state = channel::bounded<RecordingBuffer>(1)
	let _ = channel::send(state.tx, RecordingBuffer(0, list_nil()))
	Recording(prefix, state)
end

pub fn recorded(recording: Recording) -> List<RecordingEntry> effects [concurrency]
	match recording
		Recording(prefix, state) => match channel::recv(state.rx)
			Some(buffer) => restore_and_read(state.tx, buffer)
			None => list_nil()
		end
	end
end

pub handler recording(recording: Recording) for Observe effects [time, concurrency]
	start_span(request) => match recording
		Recording(prefix, state) => begin
			let monotonic_ms = time::monotonic_ms()
			match channel::recv(state.rx)
				Some(RecordingBuffer(next_identity, entries)) => match request
					SpanRequest(name, Some(TraceContext(trace_id, parent_span_id, sampled)), links) => begin
						let candidate = string::concat(string::concat(prefix, "-"), int_to_string(next_identity))
						if candidate == parent_span_id
							begin
								let span_id = string::concat(string::concat(prefix, "-"), int_to_string(next_identity + 1))
								let entry = SpanStarted(name, trace_id, span_id, Some(parent_span_id), links, monotonic_ms)
								let _ = channel::send(state.tx, RecordingBuffer(next_identity + 2, list_cons(entry, entries)))
								RecordingSpan(trace_id, span_id, sampled)
							end
						else
							begin
								let entry = SpanStarted(name, trace_id, candidate, Some(parent_span_id), links, monotonic_ms)
								let _ = channel::send(state.tx, RecordingBuffer(next_identity + 1, list_cons(entry, entries)))
								RecordingSpan(trace_id, candidate, sampled)
							end
						end
					end
					SpanRequest(name, _, links) => begin
						let trace_id = string::concat(string::concat(prefix, "-"), int_to_string(next_identity))
						let span_id = string::concat(string::concat(prefix, "-"), int_to_string(next_identity + 1))
						let entry = SpanStarted(name, trace_id, span_id, None, links, monotonic_ms)
						let _ = channel::send(state.tx, RecordingBuffer(next_identity + 2, list_cons(entry, entries)))
						RecordingSpan(trace_id, span_id, true)
					end
					LocatedSpanRequest(name, Some(TraceContext(trace_id, parent_span_id, sampled)), links, _) => begin
						let candidate = string::concat(string::concat(prefix, "-"), int_to_string(next_identity))
						if candidate == parent_span_id
							begin
								let span_id = string::concat(string::concat(prefix, "-"), int_to_string(next_identity + 1))
								let entry = SpanStarted(name, trace_id, span_id, Some(parent_span_id), links, monotonic_ms)
								let _ = channel::send(state.tx, RecordingBuffer(next_identity + 2, list_cons(entry, entries)))
								RecordingSpan(trace_id, span_id, sampled)
							end
						else
							begin
								let entry = SpanStarted(name, trace_id, candidate, Some(parent_span_id), links, monotonic_ms)
								let _ = channel::send(state.tx, RecordingBuffer(next_identity + 1, list_cons(entry, entries)))
								RecordingSpan(trace_id, candidate, sampled)
							end
						end
					end
					LocatedSpanRequest(name, _, links, _) => begin
						let trace_id = string::concat(string::concat(prefix, "-"), int_to_string(next_identity))
						let span_id = string::concat(string::concat(prefix, "-"), int_to_string(next_identity + 1))
						let entry = SpanStarted(name, trace_id, span_id, None, links, monotonic_ms)
						let _ = channel::send(state.tx, RecordingBuffer(next_identity + 2, list_cons(entry, entries)))
						RecordingSpan(trace_id, span_id, true)
					end
				end
				None => NoopSpan(request)
			end
		end
	end
	emit(record) => match recording
		Recording(prefix, state) => match channel::recv(state.rx)
			Some(RecordingBuffer(next_identity, entries)) => begin
				let _ = channel::send(state.tx, RecordingBuffer(next_identity, list_cons(Emitted(record), entries)))
				()
			end
			None => ()
		end
	end
	finish_span(request) => begin
		let monotonic_ms = time::monotonic_ms()
		match request
			SpanFinish(RecordingSpan(trace_id, span_id, _)) => match recording
				Recording(prefix, state) => match channel::recv(state.rx)
					Some(RecordingBuffer(next_identity, entries)) => begin
						let _ = channel::send(state.tx, RecordingBuffer(next_identity, list_cons(SpanFinished(trace_id, span_id, monotonic_ms), entries)))
						()
					end
					None => ()
				end
			end
			SpanFinish(NoopSpan(_)) => ()
			SpanFinish(ExportSpan(_, _, _, _, _, _)) => ()
		end
	end
end

pub fn finish(span: Span) -> SpanFinish
	SpanFinish(span)
end

pub fn context(span: Span) -> Option<TraceContext>
	match span
		RecordingSpan(trace_id, span_id, sampled) => Some(TraceContext(trace_id, span_id, sampled))
		ExportSpan(_, trace_id, span_id, _, sampled, _) => Some(TraceContext(trace_id, span_id, sampled))
		NoopSpan(_) => None
	end
end

pub fn inject_context(context: TraceContext) -> TraceCarrier
	match context
		TraceContext(trace_id, span_id, sampled) => TraceCarrier(Some(trace_id), Some(span_id), Some(sampled))
	end
end

pub fn extract_context(carrier: TraceCarrier) -> Option<TraceContext>
	match carrier
		TraceCarrier(Some(trace_id), Some(span_id), Some(sampled)) => if trace_id == ""
			None
		else if span_id == ""
			None
		else
			Some(TraceContext(trace_id, span_id, sampled))
		end
		_ => None
	end
end

fn restore_and_read(tx: Sender<RecordingBuffer>, buffer: RecordingBuffer) -> List<RecordingEntry> effects [concurrency]
	match buffer
		RecordingBuffer(next_identity, entries) => begin
			let _ = channel::send(tx, buffer)
			list_reverse(entries)
		end
	end
end

pub fn apply_metric_cardinality(production: Production, record: Observation) -> Bool effects [concurrency]
	match metric_series(record)
		Some(candidate) => update_metric_cardinality(production, candidate)
		None => true
	end
end

fn metric_series(record: Observation) -> Option<MetricSeries>
	match record
		CounterIncrement(CounterIncrementRecord(name, _, attributes, _, _)) => Some(CounterSeries(name, attributes))
		HistogramSample(HistogramSampleRecord(name, _, attributes, _, _)) => Some(HistogramSeries(name, attributes))
		_ => None
	end
end

fn update_metric_cardinality(production: Production, candidate: MetricSeries) -> Bool effects [concurrency]
	match production
		Production(metric_series_limit, state_channel) => match channel::recv(state_channel.rx)
			Some(current) => begin
				let committed = channel::bounded<()>(1)
				defer
					restore_uncommitted_production_state(state_channel.tx, current, committed.rx)
				end
				match decide_metric_cardinality(metric_series_limit, current, candidate)
					{ state: next, retained: retained, admitted: admitted } => begin
						commit_production_state(state_channel.tx, next, committed.tx, retained)
						admitted
					end
				end
			end
			None => false
		end
	end
end

fn apply_metric_cardinality_for_test(production: Production, record: Observation, decision_hook: fn(Sender<()>, Receiver<()>) -> () effects [concurrency], entered: Sender<()>, release: Receiver<()>) -> () effects [concurrency]
	match metric_series(record)
		Some(candidate) => begin
			let _ = update_metric_cardinality_with_hook(production, candidate, decision_hook, entered, release)
			()
		end
		None => ()
	end
end

fn update_metric_cardinality_with_hook(production: Production, candidate: MetricSeries, decision_hook: fn(Sender<()>, Receiver<()>) -> () effects [concurrency], entered: Sender<()>, release: Receiver<()>) -> Bool effects [concurrency]
	match production
		Production(metric_series_limit, state_channel) => begin
			match channel::recv(state_channel.rx)
				Some(current) => begin
					let committed = channel::bounded<()>(1)
					defer
						restore_uncommitted_production_state(state_channel.tx, current, committed.rx)
					end
					decision_hook(entered, release)
					match decide_metric_cardinality(metric_series_limit, current, candidate)
						{ state: next, retained: retained, admitted: admitted } => begin
							commit_production_state(state_channel.tx, next, committed.tx, retained)
							admitted
						end
					end
				end
				None => false
			end
		end
	end
end

fn commit_production_state(state: Sender<ProductionState>, next: ProductionState, committed: Sender<()>, retained: Option<MetricSeries>) -> () effects [concurrency]
	match retained
		Some(candidate) => match next
			ProductionState(series_index, _, _, _) => prelude_builtin::production_metric_index_insert(series_index, candidate)
		end
		None => ()
	end
	let _ = channel::send(committed, ())
	let _ = channel::send(state, next)
	()
end

fn restore_uncommitted_production_state(state: Sender<ProductionState>, original: ProductionState, committed: Receiver<()>) -> () effects [concurrency]
	match channel::select_many_timeout(list_cons(committed, list_nil()), 0)
		Some(_) => ()
		None => begin
			let _ = channel::send(state, original)
			()
		end
	end
end

fn decide_metric_cardinality(metric_series_limit: Int, state: ProductionState, candidate: MetricSeries) -> { state : ProductionState, retained : Option<MetricSeries>, admitted : Bool }
	match state
		ProductionState(series_index, series_count, admitted_metric_observations, dropped_metric_observations) => if prelude_builtin::production_metric_index_contains(series_index, candidate)
			{ state: ProductionState(series_index, series_count, bounded_increment(admitted_metric_observations), dropped_metric_observations), retained: None, admitted: true }
		else if series_count < metric_series_limit
			{ state: ProductionState(series_index, series_count + 1, bounded_increment(admitted_metric_observations), dropped_metric_observations), retained: Some(candidate), admitted: true }
		else
			{ state: ProductionState(series_index, series_count, admitted_metric_observations, bounded_increment(dropped_metric_observations)), retained: None, admitted: false }
		end
	end
end

fn production_state_health(state: ProductionState) -> ProductionHealth
	match state
		ProductionState(_, series_count, admitted_metric_observations, dropped_metric_observations) => ProductionHealth(series_count, admitted_metric_observations, dropped_metric_observations)
	end
end

fn bounded_increment(value: Int) -> Int
	if value == 9223372036854775807
		value
	else
		value + 1
	end
end

fn normalize_exporter_limits(limits: ExporterLimits) -> ExporterLimits
	match limits
		ExporterLimits(maximum_attributes, maximum_string_size, maximum_redacted_attributes, names) => ExporterLimits(non_negative(maximum_attributes), non_negative(maximum_string_size), non_negative(maximum_redacted_attributes), names)
	end
end

fn non_negative(value: Int) -> Int
	if value < 0
		0
	else
		value
	end
end

fn exporter_state_health(state: ExporterState, cardinality: ProductionHealth) -> ExporterHealth
	match state
		ExporterState(_, _, failed, dropped, truncated, redacted) => ExporterHealth(failed, dropped, truncated, redacted, cardinality)
	end
end

fn request_name(request: SpanRequest) -> String
	match request
		SpanRequest(name, _, _) => name
		LocatedSpanRequest(name, _, _, _) => name
	end
end

fn request_parent(request: SpanRequest) -> Option<TraceContext>
	match request
		SpanRequest(_, parent, _) => parent
		LocatedSpanRequest(_, parent, _, _) => parent
	end
end

fn request_links(request: SpanRequest) -> List<TraceContext>
	match request
		SpanRequest(_, _, links) => links
		LocatedSpanRequest(_, _, links, _) => links
	end
end

fn request_source(request: SpanRequest) -> Option<SourceLocation>
	match request
		SpanRequest(_, _, _) => None
		LocatedSpanRequest(_, _, _, source) => Some(source)
	end
end

pub fn start_export_span(exporter: JsonLinesExporter, request: SpanRequest) -> Span effects [time, concurrency]
	match exporter
		JsonLinesExporter(_, _, _, _, _, identity_prefix, _, state) => match channel::recv(state.rx)
			Some(current) => begin
				let committed = channel::bounded<()>(1)
				defer
					restore_uncommitted_exporter_state(state.tx, current, committed.rx)
				end
				match current
					ExporterState(sequence, next_identity, failed, dropped, truncated, redacted) => begin
						let parent = request_parent(request)
						let trace_id = match parent
							Some(TraceContext(parent_trace, _, _)) => parent_trace
							None => prelude_builtin::observation_export_identity(identity_prefix, "trace", next_identity)
						end
						let parent_span_id: Option<String> = match parent
							Some(TraceContext(_, parent_span, _)) => Some(parent_span)
							None => None
						end
						let sampled = match parent
							Some(TraceContext(_, _, parent_sampled)) => parent_sampled
							None => true
						end
						let span_id = prelude_builtin::observation_export_identity(identity_prefix, "span", next_identity)
						commit_exporter_state(state.tx, ExporterState(sequence, bounded_increment(next_identity), failed, dropped, truncated, redacted), committed.tx)
						let name = request_name(request)
						export_payload(exporter, ExportSpanStart(name, trace_id, span_id, parent_span_id, request_links(request), request_source(request)))
						ExportSpan(name, trace_id, span_id, parent_span_id, sampled, request_source(request))
					end
				end
			end
			None => NoopSpan(request)
		end
	end
end

pub fn finish_export_span(exporter: JsonLinesExporter, request: SpanFinish) -> () effects [time, concurrency]
	match request
		SpanFinish(ExportSpan(name, trace_id, span_id, parent_span_id, _, source)) => export_payload(exporter, ExportSpanFinish(name, trace_id, span_id, parent_span_id, source))
		_ => ()
	end
end

pub fn export_observation(exporter: JsonLinesExporter, record: Observation) -> () effects [time, concurrency]
	export_payload(exporter, observation_export_payload(record))
end

fn observation_export_payload(record: Observation) -> ExportPayload
	match record
		Log(value) => ExportLog(value)
		Event(value) => ExportEvent(value)
		CounterIncrement(value) => ExportCounter(value)
		HistogramSample(value) => ExportHistogram(value)
	end
end

pub fn buffered_export_observation(exporter: BufferedJsonLinesExporter, record: Observation) -> BufferedAdmissionOutcome effects [time, concurrency]
	buffered_export_payload_with_hooks(exporter, observation_export_payload(record), None, NoBufferedAdmissionEntryHook, NoBufferedAdmissionBoundaryHook)
end

fn buffered_export_observation_with_cardinality(exporter: BufferedJsonLinesExporter, record: Observation) -> BufferedAdmissionOutcome effects [time, concurrency]
	buffered_export_payload_with_hooks(exporter, observation_export_payload(record), Some(record), NoBufferedAdmissionEntryHook, NoBufferedAdmissionBoundaryHook)
end

fn buffered_export_observation_with_boundary_hook_for_test(exporter: BufferedJsonLinesExporter, record: Observation, callback: fn(Sender<()>, Receiver<()>) -> () effects [concurrency], entered: Sender<()>, release: Receiver<()>) -> BufferedAdmissionOutcome effects [time, concurrency]
	buffered_export_payload_with_hooks(exporter, observation_export_payload(record), None, NoBufferedAdmissionEntryHook, TestBufferedAdmissionBoundaryHook(callback, entered, release))
end

fn buffered_export_observation_with_entry_hook_for_test(exporter: BufferedJsonLinesExporter, record: Observation, callback: fn(Sender<()>, Receiver<()>) -> () effects [concurrency], entered: Sender<()>, release: Receiver<()>) -> BufferedAdmissionOutcome effects [time, concurrency]
	buffered_export_payload_with_hooks(exporter, observation_export_payload(record), None, TestBufferedAdmissionEntryHook(callback, entered, release), NoBufferedAdmissionBoundaryHook)
end

pub fn buffered_start_export_span(exporter: BufferedJsonLinesExporter, request: SpanRequest) -> BufferedSpanStart effects [time, concurrency]
	match exporter
		BufferedJsonLinesExporter(_, _, _, _, _, span_allocator, _, _, _) => match allocate_buffered_span(span_allocator, request)
			span => match span
				ExportSpan(name, trace_id, span_id, parent_span_id, _, source) => BufferedSpanStart(span, buffered_export_payload(exporter, ExportSpanStart(name, trace_id, span_id, parent_span_id, request_links(request), source)))
				_ => BufferedSpanStart(span, InvalidRecord)
			end
		end
	end
end

pub fn buffered_finish_export_span(exporter: BufferedJsonLinesExporter, request: SpanFinish) -> BufferedAdmissionOutcome effects [time, concurrency]
	match request
		SpanFinish(ExportSpan(name, trace_id, span_id, parent_span_id, _, source)) => buffered_export_payload(exporter, ExportSpanFinish(name, trace_id, span_id, parent_span_id, source))
		_ => InvalidRecord
	end
end

fn allocate_buffered_span(allocator: BufferedSpanAllocator, request: SpanRequest) -> Span effects [concurrency]
	match allocator
		BufferedSpanAllocator(identity_prefix, state) => match channel::recv(state.rx)
			Some(next_identity) => begin
				let committed = channel::bounded<()>(1)
				defer
					restore_uncommitted_buffered_span_allocator_state(state.tx, next_identity, committed.rx)
				end
				let parent = request_parent(request)
				let trace_id = match parent
					Some(TraceContext(parent_trace, _, _)) => parent_trace
					None => prelude_builtin::observation_export_identity(identity_prefix, "trace", next_identity)
				end
				let parent_span_id: Option<String> = match parent
					Some(TraceContext(_, parent_span, _)) => Some(parent_span)
					None => None
				end
				let sampled = match parent
					Some(TraceContext(_, _, parent_sampled)) => parent_sampled
					None => true
				end
				let span_id = prelude_builtin::observation_export_identity(identity_prefix, "span", next_identity)
				commit_buffered_span_allocator_state(state.tx, bounded_increment(next_identity), committed.tx)
				ExportSpan(request_name(request), trace_id, span_id, parent_span_id, sampled, request_source(request))
			end
			None => NoopSpan(request)
		end
	end
end

fn commit_buffered_span_allocator_state(state: Sender<Int>, next: Int, committed: Sender<()>) -> () effects [concurrency]
	let _ = channel::send(committed, ())
	let _ = channel::send(state, next)
	()
end

fn restore_uncommitted_buffered_span_allocator_state(state: Sender<Int>, original: Int, committed: Receiver<()>) -> () effects [concurrency]
	match channel::select_many_timeout(list_cons(committed, list_nil()), 0)
		Some(_) => ()
		None => begin
			let _ = channel::send(state, original)
			()
		end
	end
end

fn buffered_export_payload(exporter: BufferedJsonLinesExporter, payload: ExportPayload) -> BufferedAdmissionOutcome effects [time, concurrency]
	buffered_export_payload_with_hooks(exporter, payload, None, NoBufferedAdmissionEntryHook, NoBufferedAdmissionBoundaryHook)
end

fn buffered_export_payload_with_hooks(exporter: BufferedJsonLinesExporter, payload: ExportPayload, cardinality_record: Option<Observation>, entry_hook: BufferedAdmissionEntryHook, boundary_hook: BufferedAdmissionBoundaryHook) -> BufferedAdmissionOutcome effects [time, concurrency]
	match exporter
		BufferedJsonLinesExporter(capacity, resource, scope, limits, production, _, state, ready, _) => begin
			notify_buffered_admission_entry(entry_hook)
			match channel::recv(state.rx)
				Some(current) => begin
					let committed = channel::bounded<()>(1)
					defer
						restore_uncommitted_buffered_state(state.tx, current, committed.rx)
					end
					match current
						BufferedExporterState(sequence, failed, dropped, truncated, redacted, outstanding, queued, worker_active, BufferedOpen) => begin
							notify_buffered_admission_boundary(boundary_hook)
							let cardinality_admitted = match cardinality_record
								Some(record) => apply_metric_cardinality(production, record)
								None => true
							end
							if not cardinality_admitted
								begin
									commit_buffered_state(state.tx, current, committed.tx)
									InvalidRecord
								end
							else match production_health(production)
								ProductionHealth(_, admitted_metrics, dropped_metrics) => begin
									let wall_time = time::wall_time()
									let encoded: { valid : Bool, line : String, dropped : Int, truncated : Int, redacted : Int } = prelude_builtin::observation_json_line(payload, wall_time, sequence, resource, scope, limits, failed, admitted_metrics, dropped_metrics)
									if not encoded.valid
										begin
											commit_buffered_state(state.tx, BufferedExporterState(bounded_increment(sequence), bounded_increment(failed), dropped, truncated, redacted, outstanding, queued, worker_active, BufferedOpen), committed.tx)
											InvalidRecord
										end
									else if outstanding >= capacity
										begin
											commit_buffered_state(state.tx, BufferedExporterState(bounded_increment(sequence), bounded_increment(failed), dropped, truncated, redacted, outstanding, queued, worker_active, BufferedOpen), committed.tx)
											Full
										end
									else
										begin
											let next_queued = list_cons(BufferedExportWork(encoded.line, encoded.dropped, encoded.truncated, encoded.redacted), queued)
											commit_buffered_state(state.tx, BufferedExporterState(bounded_increment(sequence), failed, bounded_add(dropped, encoded.dropped), bounded_add(truncated, encoded.truncated), bounded_add(redacted, encoded.redacted), outstanding + 1, next_queued, true, BufferedOpen), committed.tx)
											if not worker_active
												begin
													let _ = channel::send(ready, ())
													()
												end
											else
												()
											end
											Accepted
										end
									end
								end
							end
							end
						end
						BufferedExporterState(_, _, _, _, _, _, _, _, _) => begin
							commit_buffered_state(state.tx, current, committed.tx)
							Closed
						end
					end
				end
				None => Closed
			end
		end
	end
end

fn notify_buffered_admission_entry(hook: BufferedAdmissionEntryHook) -> () effects [concurrency]
	match hook
		NoBufferedAdmissionEntryHook => ()
		TestBufferedAdmissionEntryHook(callback, entered, release) => callback(entered, release)
	end
end

fn notify_buffered_admission_boundary(hook: BufferedAdmissionBoundaryHook) -> () effects [concurrency]
	match hook
		NoBufferedAdmissionBoundaryHook => ()
		TestBufferedAdmissionBoundaryHook(callback, entered, release) => callback(entered, release)
	end
end

pub fn buffered_exporter_health(exporter: BufferedJsonLinesExporter) -> ExporterHealth effects [concurrency]
	match exporter
		BufferedJsonLinesExporter(_, _, _, _, production, _, state, _, _) => match channel::recv(state.rx)
			Some(current) => begin
				let committed = channel::bounded<()>(1)
				defer
					restore_uncommitted_buffered_state(state.tx, current, committed.rx)
				end
				let health = match current
					BufferedExporterState(_, _, _, _, _, _, _, _, BufferedClosed(BufferedShutdownReport(_, frozen, _))) => frozen
					BufferedExporterState(_, failed, dropped, truncated, redacted, _, _, _, _) => ExporterHealth(failed, dropped, truncated, redacted, production_health(production))
				end
				commit_buffered_state(state.tx, current, committed.tx)
				health
			end
			None => ExporterHealth(0, 0, 0, 0, ProductionHealth(0, 0, 0))
		end
	end
end

pub fn shutdown_buffered(exporter: BufferedJsonLinesExporter) -> BufferedShutdownReport effects [concurrency]
	match exporter
		BufferedJsonLinesExporter(_, _, _, _, production, _, state, ready, worker) => begin
			let completed = channel::bounded<()>(1)
			defer
				interrupt_buffered_shutdown_waiter(worker, completed.rx)
			end
			let report = match begin_buffered_shutdown(state, ready)
				Some(frozen) => frozen
				None => begin
					let _ = task::join(worker)
					read_buffered_shutdown_report(state, production)
				end
			end
			let _ = channel::send(completed.tx, ())
			report
		end
	end
end

fn shutdown_buffered_with_wait_hook_for_test(exporter: BufferedJsonLinesExporter, callback: fn(Sender<()>, Receiver<()>) -> () effects [concurrency], entered: Sender<()>, release: Receiver<()>) -> BufferedShutdownReport effects [concurrency]
	match exporter
		BufferedJsonLinesExporter(_, _, _, _, production, _, state, ready, worker) => begin
			let completed = channel::bounded<()>(1)
			defer
				interrupt_buffered_shutdown_waiter(worker, completed.rx)
			end
			callback(entered, release)
			let report = match begin_buffered_shutdown(state, ready)
				Some(frozen) => frozen
				None => begin
					let _ = task::join(worker)
					read_buffered_shutdown_report(state, production)
				end
			end
			let _ = channel::send(completed.tx, ())
			report
		end
	end
end

fn shutdown_buffered_with_return_hook_for_test(exporter: BufferedJsonLinesExporter, callback: fn(Sender<()>, Receiver<()>) -> () effects [concurrency], entered: Sender<()>, release: Receiver<()>) -> BufferedShutdownReport effects [concurrency]
	match exporter
		BufferedJsonLinesExporter(_, _, _, _, production, _, state, ready, worker) => begin
			let completed = channel::bounded<()>(1)
			defer
				interrupt_buffered_shutdown_waiter(worker, completed.rx)
			end
			let report = match begin_buffered_shutdown(state, ready)
				Some(frozen) => frozen
				None => begin
					let _ = task::join(worker)
					read_buffered_shutdown_report(state, production)
				end
			end
			callback(entered, release)
			let _ = channel::send(completed.tx, ())
			report
		end
	end
end

fn interrupt_buffered_shutdown_waiter(worker: Task<()>, completed: Receiver<()>) -> () effects [concurrency]
	match channel::select_many_timeout(list_cons(completed, list_nil()), 0)
		Some(_) => ()
		None => task::cancel(worker)
	end
end

fn begin_buffered_shutdown(state: { tx : Sender<BufferedExporterState>, rx : Receiver<BufferedExporterState> }, ready: Sender<()>) -> Option<BufferedShutdownReport> effects [concurrency]
	match channel::recv(state.rx)
		Some(current) => begin
			let committed = channel::bounded<()>(1)
			defer
				restore_uncommitted_buffered_state(state.tx, current, committed.rx)
			end
			match current
				BufferedExporterState(_, _, _, _, _, _, _, _, BufferedClosed(report)) => begin
					commit_buffered_state(state.tx, current, committed.tx)
					Some(report)
				end
				BufferedExporterState(sequence, failed, dropped, truncated, redacted, outstanding, queued, worker_active, BufferedOpen) => begin
					commit_buffered_state(state.tx, BufferedExporterState(sequence, failed, dropped, truncated, redacted, outstanding, queued, true, BufferedClosing), committed.tx)
					if not worker_active
						begin
							let _ = channel::send(ready, ())
							()
						end
					else
						()
					end
					None
				end
				BufferedExporterState(_, _, _, _, _, _, _, _, BufferedClosing) => begin
					commit_buffered_state(state.tx, current, committed.tx)
					None
				end
			end
		end
		None => None
	end
end

fn read_buffered_shutdown_report(state: { tx : Sender<BufferedExporterState>, rx : Receiver<BufferedExporterState> }, production: Production) -> BufferedShutdownReport effects [concurrency]
	match channel::recv(state.rx)
		Some(current) => begin
			let committed = channel::bounded<()>(1)
			defer
				restore_uncommitted_buffered_state(state.tx, current, committed.rx)
			end
			let report = match current
				BufferedExporterState(_, _, _, _, _, _, _, _, BufferedClosed(frozen)) => frozen
				BufferedExporterState(_, failed, dropped, truncated, redacted, _, _, _, _) => BufferedShutdownReport(Interrupted, ExporterHealth(failed, dropped, truncated, redacted, production_health(production)), SummaryNotAttempted)
			end
			commit_buffered_state(state.tx, current, committed.tx)
			report
		end
		None => BufferedShutdownReport(Interrupted, ExporterHealth(0, 0, 0, 0, ProductionHealth(0, 0, 0)), SummaryNotAttempted)
	end
end

fn run_buffered_export_worker(context: { state : { tx : Sender<BufferedExporterState>, rx : Receiver<BufferedExporterState> }, calls : { tx : Sender<BufferedCallState>, rx : Receiver<BufferedCallState> }, ready : Receiver<()>, destination : ExportDestination, diagnostic_destination : DiagnosticDestination, production : Production, idle_hook : BufferedIdleHook, completion_hook : BufferedCompletionHook, queue_hook : BufferedWorkerBoundaryHook, health_hook : BufferedWorkerBoundaryHook, call_entry_hook : BufferedCallEntryHook, interruption_hook : BufferedWorkerBoundaryHook }) -> () effects [concurrency]
	let completed = channel::bounded<()>(1)
	defer
		interrupt_unfinished_buffered_transition(context.state, context.calls, context.production, context.interruption_hook, completed.rx)
	end
	run_buffered_export_worker_loop(context)
	let _ = channel::send(completed.tx, ())
	()
end

fn run_buffered_export_worker_loop(context: { state : { tx : Sender<BufferedExporterState>, rx : Receiver<BufferedExporterState> }, calls : { tx : Sender<BufferedCallState>, rx : Receiver<BufferedCallState> }, ready : Receiver<()>, destination : ExportDestination, diagnostic_destination : DiagnosticDestination, production : Production, idle_hook : BufferedIdleHook, completion_hook : BufferedCompletionHook, queue_hook : BufferedWorkerBoundaryHook, health_hook : BufferedWorkerBoundaryHook, call_entry_hook : BufferedCallEntryHook }) -> () effects [concurrency]
	match channel::recv(context.ready)
		Some(_) => if drain_buffered_exports(context)
			run_buffered_export_worker_loop(context)
		else
			()
		end
		None => ()
	end
end

fn interrupt_unfinished_buffered_transition(state: { tx : Sender<BufferedExporterState>, rx : Receiver<BufferedExporterState> }, calls: { tx : Sender<BufferedCallState>, rx : Receiver<BufferedCallState> }, production: Production, interruption_hook: BufferedWorkerBoundaryHook, completed: Receiver<()>) -> () effects [concurrency]
	match channel::select_many_timeout(list_cons(completed, list_nil()), 0)
		Some(_) => ()
		None => interrupt_buffered_transition_with_boundary_hook(state, calls, production, interruption_hook)
	end
end

fn interrupt_buffered_transition(state: { tx : Sender<BufferedExporterState>, rx : Receiver<BufferedExporterState> }, calls: { tx : Sender<BufferedCallState>, rx : Receiver<BufferedCallState> }, production: Production) -> () effects [concurrency]
	interrupt_buffered_transition_with_boundary_hook(state, calls, production, NoBufferedWorkerBoundaryHook)
end

fn interrupt_buffered_transition_with_boundary_hook(state: { tx : Sender<BufferedExporterState>, rx : Receiver<BufferedExporterState> }, calls: { tx : Sender<BufferedCallState>, rx : Receiver<BufferedCallState> }, production: Production, boundary_hook: BufferedWorkerBoundaryHook) -> () effects [concurrency]
	match channel::recv(calls.rx)
		Some(active_call) => begin
			let call_committed = channel::bounded<()>(1)
			defer
				restore_uncommitted_buffered_call_state(calls.tx, active_call, call_committed.rx)
			end
			let call_phase = match active_call
				BufferedRecordCall(permit) => prelude_builtin::observation_export_permit_revoke(permit)
				BufferedSummaryCall(_, permit) => prelude_builtin::observation_export_permit_revoke(permit)
				BufferedNoCall => 4
				BufferedCallsRevoked => 4
			end
			notify_buffered_worker_boundary(boundary_hook)
			match channel::recv(state.rx)
				Some(current) => begin
					let state_committed = channel::bounded<()>(1)
					defer
						restore_uncommitted_buffered_state(state.tx, current, state_committed.rx)
					end
					let cardinality = production_health(production)
					let next = interrupted_buffered_state(current, active_call, call_phase, cardinality)
					commit_buffered_transition(state.tx, next, state_committed.tx, calls.tx, BufferedCallsRevoked, call_committed.tx)
					discard_buffered_call_permit(active_call)
				end
				None => commit_buffered_call_state(calls.tx, BufferedCallsRevoked, call_committed.tx)
			end
		end
		None => ()
	end
end

fn discard_buffered_call_permit(active_call: BufferedCallState) -> ()
	match active_call
		BufferedRecordCall(permit) => prelude_builtin::observation_export_permit_discard(permit)
		BufferedSummaryCall(_, permit) => prelude_builtin::observation_export_permit_discard(permit)
		_ => ()
	end
end

fn interrupted_buffered_state(current: BufferedExporterState, active_call: BufferedCallState, call_phase: Int, cardinality: ProductionHealth) -> BufferedExporterState
	match current
		BufferedExporterState(sequence, failed, dropped, truncated, redacted, outstanding, _, _, BufferedClosed(report)) => BufferedExporterState(sequence, failed, dropped, truncated, redacted, outstanding, list_nil(), false, BufferedClosed(report))
		BufferedExporterState(sequence, failed, dropped, truncated, redacted, outstanding, _, _, _) => match active_call
			BufferedRecordCall(_) => if call_phase == 2 or call_phase == 3
				begin
					let confirmed_failed = if call_phase == 2
						bounded_increment(failed)
					else
						failed
					end
					let interrupted_failed = bounded_add(confirmed_failed, outstanding - 1)
					let health = ExporterHealth(interrupted_failed, dropped, truncated, redacted, cardinality)
					let report = BufferedShutdownReport(Interrupted, health, SummaryNotAttempted)
					BufferedExporterState(sequence, interrupted_failed, dropped, truncated, redacted, 0, list_nil(), false, BufferedClosed(report))
				end
			else
				freeze_unsettled_buffered_state(sequence, failed, dropped, truncated, redacted, outstanding, cardinality, SummaryNotAttempted)
			end
			BufferedSummaryCall(health, _) => if call_phase == 2 or call_phase == 3
				begin
					let summary = if call_phase == 3
						SummaryAccepted
					else
						SummaryRejected
					end
					let report = BufferedShutdownReport(Completed, health, summary)
					BufferedExporterState(sequence, failed, dropped, truncated, redacted, 0, list_nil(), false, BufferedClosed(report))
				end
			else if call_phase == 1
				begin
					let report = BufferedShutdownReport(Interrupted, health, SummaryRejected)
					BufferedExporterState(sequence, failed, dropped, truncated, redacted, 0, list_nil(), false, BufferedClosed(report))
				end
			else
				begin
					let report = BufferedShutdownReport(Interrupted, health, SummaryNotAttempted)
					BufferedExporterState(sequence, failed, dropped, truncated, redacted, 0, list_nil(), false, BufferedClosed(report))
				end
			end
			_ => freeze_unsettled_buffered_state(sequence, failed, dropped, truncated, redacted, outstanding, cardinality, SummaryNotAttempted)
		end
	end
end

fn freeze_unsettled_buffered_state(sequence: Int, failed: Int, dropped: Int, truncated: Int, redacted: Int, outstanding: Int, cardinality: ProductionHealth, summary: BufferedSummaryOutcome) -> BufferedExporterState
	let interrupted_failed = bounded_add(failed, outstanding)
	let health = ExporterHealth(interrupted_failed, dropped, truncated, redacted, cardinality)
	let report = BufferedShutdownReport(Interrupted, health, summary)
	BufferedExporterState(sequence, interrupted_failed, dropped, truncated, redacted, 0, list_nil(), false, BufferedClosed(report))
end

fn drain_buffered_exports(context: { state : { tx : Sender<BufferedExporterState>, rx : Receiver<BufferedExporterState> }, calls : { tx : Sender<BufferedCallState>, rx : Receiver<BufferedCallState> }, ready : Receiver<()>, destination : ExportDestination, diagnostic_destination : DiagnosticDestination, production : Production, idle_hook : BufferedIdleHook, completion_hook : BufferedCompletionHook, queue_hook : BufferedWorkerBoundaryHook, health_hook : BufferedWorkerBoundaryHook, call_entry_hook : BufferedCallEntryHook }) -> Bool effects [concurrency]
	match drain_buffered_export_batch(context)
		0 => false
		1 => true
		_ => drain_buffered_exports(context)
	end
end

fn drain_buffered_export_batch(context: { state : { tx : Sender<BufferedExporterState>, rx : Receiver<BufferedExporterState> }, calls : { tx : Sender<BufferedCallState>, rx : Receiver<BufferedCallState> }, ready : Receiver<()>, destination : ExportDestination, diagnostic_destination : DiagnosticDestination, production : Production, idle_hook : BufferedIdleHook, completion_hook : BufferedCompletionHook, queue_hook : BufferedWorkerBoundaryHook, health_hook : BufferedWorkerBoundaryHook, call_entry_hook : BufferedCallEntryHook }) -> Int effects [concurrency]
	match channel::recv(context.state.rx)
		Some(current) => begin
			let committed = channel::bounded<()>(1)
			defer
				restore_uncommitted_buffered_state(context.state.tx, current, committed.rx)
			end
			match current
				BufferedExporterState(sequence, failed, dropped, truncated, redacted, outstanding, queued, _, lifecycle) => match queued
					Cons(_, _) => begin
						notify_buffered_worker_boundary(context.queue_hook)
						let work = list_reverse(queued)
						commit_buffered_state(context.state.tx, BufferedExporterState(sequence, failed, dropped, truncated, redacted, outstanding, list_nil(), true, lifecycle), committed.tx)
						export_buffered_batch(context, work)
						2
					end
					Nil => begin
						match lifecycle
							BufferedOpen => begin
								commit_buffered_state(context.state.tx, BufferedExporterState(sequence, failed, dropped, truncated, redacted, outstanding, queued, false, lifecycle), committed.tx)
								notify_buffered_idle(context.idle_hook)
								1
							end
							BufferedClosing => begin
								commit_buffered_state(context.state.tx, BufferedExporterState(sequence, failed, dropped, truncated, redacted, outstanding, queued, true, lifecycle), committed.tx)
								complete_buffered_export(context)
								0
							end
							BufferedClosed(_) => begin
								commit_buffered_state(context.state.tx, BufferedExporterState(sequence, failed, dropped, truncated, redacted, outstanding, queued, false, lifecycle), committed.tx)
								0
							end
						end
					end
				end
			end
		end
		None => 0
	end
end

fn export_buffered_batch(context: { state : { tx : Sender<BufferedExporterState>, rx : Receiver<BufferedExporterState> }, calls : { tx : Sender<BufferedCallState>, rx : Receiver<BufferedCallState> }, ready : Receiver<()>, destination : ExportDestination, diagnostic_destination : DiagnosticDestination, production : Production, idle_hook : BufferedIdleHook, completion_hook : BufferedCompletionHook, queue_hook : BufferedWorkerBoundaryHook, health_hook : BufferedWorkerBoundaryHook, call_entry_hook : BufferedCallEntryHook }, work: List<BufferedExportWork>) -> () effects [concurrency]
	match work
		Cons(BufferedExportWork(line, _, _, _), tail) => begin
			match prepare_buffered_record_call(context.calls, context.call_entry_hook)
				Some(permit) => begin
					let call = task::spawn_with(buffered_record_host_call, { destination: context.destination, line: line, permit: permit, entry_hook: context.call_entry_hook })
					match task::join(call)
						Ok(BufferedCallCompleted(written)) => begin
							settle_buffered_export(context.state, context.calls, permit, written, context.completion_hook)
							export_buffered_batch(context, tail)
						end
						Ok(BufferedCallSkipped) => ()
						Err(_) => interrupt_buffered_transition(context.state, context.calls, context.production)
					end
				end
				None => ()
			end
		end
		Nil => ()
	end
end

fn prepare_buffered_record_call(calls: { tx : Sender<BufferedCallState>, rx : Receiver<BufferedCallState> }, hook: BufferedCallEntryHook) -> Option<Int> effects [concurrency]
	match channel::recv(calls.rx)
		Some(current) => begin
			match current
				BufferedNoCall => begin
					let permit = prelude_builtin::observation_export_permit_create()
					let committed = channel::bounded<()>(1)
					defer
						restore_uncommitted_buffered_call_permit_state(calls.tx, current, permit, committed.rx)
					end
					notify_buffered_permit_publication(hook)
					commit_buffered_call_state(calls.tx, BufferedRecordCall(permit), committed.tx)
					Some(permit)
				end
				_ => begin
					let committed = channel::bounded<()>(1)
					defer
						restore_uncommitted_buffered_call_state(calls.tx, current, committed.rx)
					end
					commit_buffered_call_state(calls.tx, current, committed.tx)
					None
				end
			end
		end
		None => None
	end
end

fn buffered_record_host_call(context: { destination : ExportDestination, line : String, permit : Int, entry_hook : BufferedCallEntryHook }) -> BufferedHostCallOutcome effects [concurrency]
	notify_buffered_call_entry(context.entry_hook)
	let result = prelude_builtin::observation_export_write_coordinated(context.destination, context.line, false, context.permit, buffered_call_return_sender(context.entry_hook))
	if result < 0
		BufferedCallSkipped
	else
		BufferedCallCompleted(result > 0)
	end
end

fn settle_buffered_export(state: { tx : Sender<BufferedExporterState>, rx : Receiver<BufferedExporterState> }, calls: { tx : Sender<BufferedCallState>, rx : Receiver<BufferedCallState> }, permit: Int, written: Bool, completion_hook: BufferedCompletionHook) -> () effects [concurrency]
	match channel::recv(calls.rx)
		Some(active_call) => begin
			let call_committed = channel::bounded<()>(1)
			defer
				restore_uncommitted_buffered_call_state(calls.tx, active_call, call_committed.rx)
			end
			match active_call
				BufferedRecordCall(active_permit) => if active_permit == permit
					match channel::recv(state.rx)
						Some(current) => begin
							let state_committed = channel::bounded<()>(1)
							defer
								restore_uncommitted_buffered_state(state.tx, current, state_committed.rx)
							end
							notify_buffered_completion(completion_hook)
							match current
								BufferedExporterState(sequence, failed, dropped, truncated, redacted, outstanding, queued, worker_active, lifecycle) => begin
									let next_failed = if written
										failed
									else
										bounded_increment(failed)
									end
									let next = BufferedExporterState(sequence, next_failed, dropped, truncated, redacted, outstanding - 1, queued, worker_active, lifecycle)
									commit_buffered_transition(state.tx, next, state_committed.tx, calls.tx, BufferedNoCall, call_committed.tx)
									prelude_builtin::observation_export_permit_discard(permit)
								end
							end
						end
						None => commit_buffered_call_state(calls.tx, active_call, call_committed.tx)
					end
				else
					commit_buffered_call_state(calls.tx, active_call, call_committed.tx)
				end
				_ => commit_buffered_call_state(calls.tx, active_call, call_committed.tx)
			end
		end
		None => ()
	end
end

fn notify_buffered_completion(hook: BufferedCompletionHook) -> () effects [concurrency]
	match hook
		NoBufferedCompletionHook => ()
		TestBufferedCompletionHook(callback, entered, release) => callback(entered, release)
	end
end

fn notify_buffered_idle(hook: BufferedIdleHook) -> () effects [concurrency]
	match hook
		NoBufferedIdleHook => ()
		TestBufferedIdleHook(callback, idle, resume) => callback(idle, resume)
	end
end

fn notify_buffered_worker_boundary(hook: BufferedWorkerBoundaryHook) -> () effects [concurrency]
	match hook
		NoBufferedWorkerBoundaryHook => ()
		TestBufferedWorkerBoundaryHook(callback, entered, release) => callback(entered, release)
	end
end

fn notify_buffered_call_entry(hook: BufferedCallEntryHook) -> () effects [concurrency]
	match hook
		NoBufferedCallEntryHook => ()
		TestBufferedCallEntryHook(callback, entered, release) => callback(entered, release)
		TestBufferedCallReturnHook(_) => ()
		TestBufferedPermitPublicationHook(_, _, _) => ()
	end
end

fn notify_buffered_permit_publication(hook: BufferedCallEntryHook) -> () effects [concurrency]
	match hook
		TestBufferedPermitPublicationHook(callback, entered, release) => callback(entered, release)
		_ => ()
	end
end

fn buffered_call_return_sender(hook: BufferedCallEntryHook) -> Option<Sender<()>>
	match hook
		TestBufferedCallReturnHook(completed) => Some(completed)
		_ => None
	end
end

fn complete_buffered_export(context: { state : { tx : Sender<BufferedExporterState>, rx : Receiver<BufferedExporterState> }, calls : { tx : Sender<BufferedCallState>, rx : Receiver<BufferedCallState> }, ready : Receiver<()>, destination : ExportDestination, diagnostic_destination : DiagnosticDestination, production : Production, idle_hook : BufferedIdleHook, completion_hook : BufferedCompletionHook, queue_hook : BufferedWorkerBoundaryHook, health_hook : BufferedWorkerBoundaryHook, call_entry_hook : BufferedCallEntryHook }) -> () effects [concurrency]
	let state = context.state
	let diagnostic_destination = context.diagnostic_destination
	let production = context.production
	let completion_hook = context.completion_hook
	match channel::recv(state.rx)
		Some(current) => begin
			let state_committed = channel::bounded<()>(1)
			defer
				restore_uncommitted_buffered_state(state.tx, current, state_committed.rx)
			end
			match current
				BufferedExporterState(sequence, failed, dropped, truncated, redacted, _, queued, _, lifecycle) => match lifecycle
					BufferedClosed(_) => begin
						commit_buffered_state(state.tx, BufferedExporterState(sequence, failed, dropped, truncated, redacted, 0, queued, false, lifecycle), state_committed.tx)
						()
					end
					_ => match diagnostic_destination
						NoDiagnosticDestination => begin
							notify_buffered_worker_boundary(context.health_hook)
							let health = ExporterHealth(failed, dropped, truncated, redacted, production_health(production))
							let report = BufferedShutdownReport(Completed, health, SummaryDisabled)
							commit_buffered_state(state.tx, BufferedExporterState(sequence, failed, dropped, truncated, redacted, 0, queued, false, BufferedClosed(report)), state_committed.tx)
							()
						end
						_ => begin
							notify_buffered_worker_boundary(context.health_hook)
							let health = ExporterHealth(failed, dropped, truncated, redacted, production_health(production))
							commit_buffered_state(state.tx, BufferedExporterState(sequence, failed, dropped, truncated, redacted, 0, queued, true, lifecycle), state_committed.tx)
							match prepare_buffered_summary_call(context.calls, health, context.call_entry_hook)
								Some(permit) => begin
									let call = task::spawn_with(buffered_summary_host_call, { destination: diagnostic_destination, line: exporter_health_line(health), permit: permit, entry_hook: context.call_entry_hook })
									match task::join(call)
										Ok(BufferedCallCompleted(written)) => finish_buffered_summary(state, context.calls, health, permit, written, completion_hook)
										Ok(BufferedCallSkipped) => ()
										Err(_) => interrupt_buffered_transition(state, context.calls, production)
									end
								end
								None => ()
							end
						end
					end
				end
			end
		end
		None => ()
	end
end

fn prepare_buffered_summary_call(calls: { tx : Sender<BufferedCallState>, rx : Receiver<BufferedCallState> }, health: ExporterHealth, hook: BufferedCallEntryHook) -> Option<Int> effects [concurrency]
	match channel::recv(calls.rx)
		Some(current) => begin
			match current
				BufferedNoCall => begin
					let permit = prelude_builtin::observation_export_permit_create()
					let committed = channel::bounded<()>(1)
					defer
						restore_uncommitted_buffered_call_permit_state(calls.tx, current, permit, committed.rx)
					end
					notify_buffered_permit_publication(hook)
					commit_buffered_call_state(calls.tx, BufferedSummaryCall(health, permit), committed.tx)
					Some(permit)
				end
				_ => begin
					let committed = channel::bounded<()>(1)
					defer
						restore_uncommitted_buffered_call_state(calls.tx, current, committed.rx)
					end
					commit_buffered_call_state(calls.tx, current, committed.tx)
					None
				end
			end
		end
		None => None
	end
end

fn buffered_summary_host_call(context: { destination : DiagnosticDestination, line : String, permit : Int, entry_hook : BufferedCallEntryHook }) -> BufferedHostCallOutcome effects [concurrency]
	notify_buffered_call_entry(context.entry_hook)
	let result = prelude_builtin::observation_export_write_coordinated(context.destination, context.line, true, context.permit, buffered_call_return_sender(context.entry_hook))
	if result < 0
		BufferedCallSkipped
	else
		BufferedCallCompleted(result > 0)
	end
end

fn finish_buffered_summary(state: { tx : Sender<BufferedExporterState>, rx : Receiver<BufferedExporterState> }, calls: { tx : Sender<BufferedCallState>, rx : Receiver<BufferedCallState> }, health: ExporterHealth, permit: Int, written: Bool, completion_hook: BufferedCompletionHook) -> () effects [concurrency]
	match channel::recv(calls.rx)
		Some(active_call) => begin
			let call_committed = channel::bounded<()>(1)
			defer
				restore_uncommitted_buffered_call_state(calls.tx, active_call, call_committed.rx)
			end
			match active_call
				BufferedSummaryCall(_, active_permit) => if active_permit == permit
					match channel::recv(state.rx)
						Some(current) => begin
							let state_committed = channel::bounded<()>(1)
							defer
								restore_uncommitted_buffered_state(state.tx, current, state_committed.rx)
							end
							notify_buffered_completion(completion_hook)
							match current
								BufferedExporterState(_, _, _, _, _, _, _, _, BufferedClosed(_)) => commit_buffered_transition(state.tx, current, state_committed.tx, calls.tx, BufferedNoCall, call_committed.tx)
								BufferedExporterState(sequence, failed, dropped, truncated, redacted, _, queued, _, _) => begin
									let summary = if written
										SummaryAccepted
									else
										SummaryRejected
									end
									let report = BufferedShutdownReport(Completed, health, summary)
									let next = BufferedExporterState(sequence, failed, dropped, truncated, redacted, 0, queued, false, BufferedClosed(report))
									commit_buffered_transition(state.tx, next, state_committed.tx, calls.tx, BufferedNoCall, call_committed.tx)
									prelude_builtin::observation_export_permit_discard(permit)
								end
							end
						end
						None => commit_buffered_call_state(calls.tx, active_call, call_committed.tx)
					end
				else
					commit_buffered_call_state(calls.tx, active_call, call_committed.tx)
				end
				_ => commit_buffered_call_state(calls.tx, active_call, call_committed.tx)
			end
		end
		None => ()
	end
end

fn cancel_buffered_worker_for_test(exporter: BufferedJsonLinesExporter) -> () effects [concurrency]
	match exporter
		BufferedJsonLinesExporter(_, _, _, _, _, _, _, _, worker) => begin
			task::cancel(worker)
			let _ = task::join(worker)
			()
		end
	end
end

fn commit_buffered_state(state: Sender<BufferedExporterState>, next: BufferedExporterState, committed: Sender<()>) -> () effects [concurrency]
	let _ = channel::send(committed, ())
	let _ = channel::send(state, next)
	()
end

fn commit_buffered_call_state(state: Sender<BufferedCallState>, next: BufferedCallState, committed: Sender<()>) -> () effects [concurrency]
	let _ = channel::send(committed, ())
	let _ = channel::send(state, next)
	()
end

fn restore_uncommitted_buffered_call_state(state: Sender<BufferedCallState>, original: BufferedCallState, committed: Receiver<()>) -> () effects [concurrency]
	match channel::select_many_timeout(list_cons(committed, list_nil()), 0)
		Some(_) => ()
		None => begin
			let _ = channel::send(state, original)
			()
		end
	end
end

fn restore_uncommitted_buffered_call_permit_state(state: Sender<BufferedCallState>, original: BufferedCallState, permit: Int, committed: Receiver<()>) -> () effects [concurrency]
	match channel::select_many_timeout(list_cons(committed, list_nil()), 0)
		Some(_) => ()
		None => begin
			let _ = channel::send(state, original)
			prelude_builtin::observation_export_permit_discard(permit)
		end
	end
end

fn commit_buffered_transition(state: Sender<BufferedExporterState>, next: BufferedExporterState, state_committed: Sender<()>, calls: Sender<BufferedCallState>, next_call: BufferedCallState, call_committed: Sender<()>) -> () effects [concurrency]
	let _ = channel::send(state_committed, ())
	let _ = channel::send(call_committed, ())
	let _ = channel::send(state, next)
	let _ = channel::send(calls, next_call)
	()
end

fn restore_uncommitted_buffered_state(state: Sender<BufferedExporterState>, original: BufferedExporterState, committed: Receiver<()>) -> () effects [concurrency]
	match channel::select_many_timeout(list_cons(committed, list_nil()), 0)
		Some(_) => ()
		None => begin
			let _ = channel::send(state, original)
			()
		end
	end
end

fn buffered_outstanding_for_test(exporter: BufferedJsonLinesExporter) -> Int effects [concurrency]
	match exporter
		BufferedJsonLinesExporter(_, _, _, _, _, _, state, _, _) => match channel::recv(state.rx)
			Some(current) => match current
				BufferedExporterState(_, _, _, _, _, outstanding, _, _, _) => begin
					let _ = channel::send(state.tx, current)
					outstanding
				end
			end
			None => 0
		end
	end
end

fn buffered_export_permit_count_for_test() -> Int
	prelude_builtin::observation_export_permit_count()
end

fn buffered_production_health_for_test(exporter: BufferedJsonLinesExporter) -> ProductionHealth effects [concurrency]
	match exporter
		BufferedJsonLinesExporter(_, _, _, _, production, _, _, _, _) => production_health(production)
	end
end

fn export_payload(exporter: JsonLinesExporter, payload: ExportPayload) -> () effects [time, concurrency]
	export_payload_with_boundary_hook(exporter, payload, NoExportStateBoundaryHook)
end

fn export_metric_with_boundary_hook_for_test(exporter: JsonLinesExporter, record: Observation, callback: fn(Sender<()>, Receiver<()>) -> () effects [concurrency], entered: Sender<()>, release: Receiver<()>) -> () effects [time, concurrency]
	match exporter
		JsonLinesExporter(_, _, _, _, _, _, production, _) => if apply_metric_cardinality(production, record)
			match record
				CounterIncrement(value) => export_payload_with_boundary_hook(exporter, ExportCounter(value), TestExportStateBoundaryHook(callback, entered, release))
				HistogramSample(value) => export_payload_with_boundary_hook(exporter, ExportHistogram(value), TestExportStateBoundaryHook(callback, entered, release))
				_ => ()
			end
		else
			()
		end
	end
end

fn export_payload_with_boundary_hook(exporter: JsonLinesExporter, payload: ExportPayload, boundary_hook: ExportStateBoundaryHook) -> () effects [time, concurrency]
	let wall_time = time::wall_time()
	match exporter
		JsonLinesExporter(resource, scope, limits, destination, _, _, production, state) => begin
			run_export_state_boundary_hook(boundary_hook)
			match channel::recv(state.rx)
				Some(current) => begin
					let committed = channel::bounded<()>(1)
					defer
						restore_uncommitted_exporter_state(state.tx, current, committed.rx)
					end
					match production_health(production)
						ProductionHealth(_, admitted_metrics, dropped_metrics) => match current
							ExporterState(sequence, next_identity, failed, dropped, truncated, redacted) => begin
								let encoded: { valid : Bool, line : String, dropped : Int, truncated : Int, redacted : Int } = prelude_builtin::observation_json_line(payload, wall_time, sequence, resource, scope, limits, failed, admitted_metrics, dropped_metrics)
								let written = if encoded.valid
									prelude_builtin::observation_export_write(destination, encoded.line, false)
								else
									false
								end
								let next_failed = if written
									failed
								else
									bounded_increment(failed)
								end
								commit_exporter_state(state.tx, ExporterState(bounded_increment(sequence), next_identity, next_failed, bounded_add(dropped, encoded.dropped), bounded_add(truncated, encoded.truncated), bounded_add(redacted, encoded.redacted)), committed.tx)
								()
							end
						end
					end
				end
				None => ()
			end
		end
	end
end

fn run_export_state_boundary_hook(boundary_hook: ExportStateBoundaryHook) -> () effects [concurrency]
	match boundary_hook
		NoExportStateBoundaryHook => ()
		TestExportStateBoundaryHook(callback, entered, release) => callback(entered, release)
	end
end

fn commit_exporter_state(state: Sender<ExporterState>, next: ExporterState, committed: Sender<()>) -> () effects [concurrency]
	let _ = channel::send(committed, ())
	let _ = channel::send(state, next)
	()
end

fn restore_uncommitted_exporter_state(state: Sender<ExporterState>, original: ExporterState, committed: Receiver<()>) -> () effects [concurrency]
	match channel::select_many_timeout(list_cons(committed, list_nil()), 0)
		Some(_) => ()
		None => begin
			let _ = channel::send(state, original)
			()
		end
	end
end

fn bounded_add(left: Int, right: Int) -> Int
	if right <= 0
		left
	else if left > 9223372036854775807 - right
		9223372036854775807
	else
		left + right
	end
end

fn production_index_work_for_test(production: Production) -> Int effects [concurrency]
	match production
		Production(_, state_channel) => match channel::recv(state_channel.rx)
			Some(current) => begin
				let committed = channel::bounded<()>(1)
				defer
					restore_uncommitted_production_state(state_channel.tx, current, committed.rx)
				end
				match current
					ProductionState(series_index, _, _, _) => begin
						let work = prelude_builtin::production_metric_index_work(series_index)
						commit_production_state(state_channel.tx, current, committed.tx, None)
						work
					end
				end
			end
			None => 0
		end
	end
end

fn reset_production_index_work_for_test(production: Production) -> () effects [concurrency]
	match production
		Production(_, state_channel) => match channel::recv(state_channel.rx)
			Some(current) => begin
				let committed = channel::bounded<()>(1)
				defer
					restore_uncommitted_production_state(state_channel.tx, current, committed.rx)
				end
				match current
					ProductionState(series_index, _, _, _) => prelude_builtin::production_metric_index_reset_work(series_index)
				end
				commit_production_state(state_channel.tx, current, committed.tx, None)
			end
			None => ()
		end
	end
end

fn is_noop_span(span: Span) -> Bool
	match span
		NoopSpan(_) => true
		_ => false
	end
end
