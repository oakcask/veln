use observe
use prelude
use host_effects

pub fn span_recording(prefix: String) -> Recording effects [concurrency]
	observe::new_recording(prefix)
end

pub handler clock(now: Int) for host_effects::Clock
	request(operation, milliseconds) => Ok(now)
	wall_time() => Ok({ unix_seconds: 0, nanosecond: 0 })
end

pub fn records(capacity: Int) -> { tx : Sender<Observation>, rx : Receiver<Observation> } effects [concurrency]
	channel::bounded<Observation>(capacity)
end

pub fn export_lines(capacity: Int) -> { tx : Sender<String>, rx : Receiver<String> } effects [concurrency]
	channel::bounded<String>(capacity)
end

pub handler exporter(lines: Sender<String>, accepted: Bool) for host_effects::ObservationExporter effects [concurrency]
	write(destination, line, diagnostic) => begin
		let _ = channel::send(lines, string::concat(string::concat(if diagnostic
			"diagnostic:"
		else
			"record:"
		end, destination), string::concat(":", line)))
		accepted
	end
	identity(kind, sequence) => string::concat(string::concat(string::concat("fixed-", kind), "-"), int_to_string(sequence))
end

pub handler exporter_with_empty_identity(lines: Sender<String>, empty_kind: String) for host_effects::ObservationExporter effects [concurrency]
	write(destination, line, diagnostic) => begin
		let _ = channel::send(lines, string::concat(string::concat(if diagnostic
			"diagnostic:"
		else
			"record:"
		end, destination), string::concat(":", line)))
		true
	end
	identity(kind, sequence) => if kind == empty_kind
		""
	else
		string::concat(string::concat(string::concat("fixed-", kind), "-"), int_to_string(sequence))
	end
end

pub handler stalling_exporter(entered: Sender<()>, release: Receiver<()>) for host_effects::ObservationExporter effects [concurrency]
	write(destination, line, diagnostic) => begin
		let _ = channel::send(entered, ())
		let _ = channel::recv(release)
		true
	end
	identity(kind, sequence) => string::concat(string::concat(string::concat("stalled-", kind), "-"), int_to_string(sequence))
end

pub handler controlled_record_exporter(lines: Sender<String>, release: Receiver<()>) for host_effects::ObservationExporter effects [concurrency]
	write(destination, line, diagnostic) => begin
		let _ = channel::send(lines, string::concat(string::concat(if diagnostic
			"diagnostic:"
		else
			"record:"
		end, destination), string::concat(":", line)))
		if diagnostic
			true
		else
			begin
				let _ = channel::recv(release)
				true
			end
		end
	end
	identity(kind, sequence) => string::concat(string::concat(string::concat("controlled-", kind), "-"), int_to_string(sequence))
end

pub fn o1_attributes() -> List<Attribute>
	list_cons(observe::Attribute("enabled", observe::BoolValue(true)), list_cons(observe::Attribute("attempt", observe::IntValue(3)), list_cons(observe::Attribute("route", observe::StringValue("checkout")), list_nil())))
end

pub fn o1_context() -> Option<TraceContext>
	Some(observe::TraceContext("trace-1", "span-2", true))
end

pub fn decision_barrier(entered: Sender<()>, release: Receiver<()>) -> () effects [concurrency]
	let _ = channel::send(entered, ())
	let _ = channel::recv(release)
	()
end

pub fn is_o1_debug(record: Observation, expected_file: String, expected_line: Int) -> Bool
	match record
		observe::Log(observe::LogRecord("log", observe::Debug, "accepted", attributes, Some(observe::TraceContext("trace-1", "span-2", true)), source)) => has_o1_attributes(attributes) and source.file == expected_file and source.start_line == expected_line
		_ => false
	end
end

pub fn is_o1_info(record: Observation, expected_file: String, expected_line: Int) -> Bool
	match record
		observe::Log(observe::LogRecord("log", observe::Info, "accepted", attributes, Some(observe::TraceContext("trace-1", "span-2", true)), source)) => has_o1_attributes(attributes) and source.file == expected_file and source.start_line == expected_line
		_ => false
	end
end

pub fn is_o1_warning(record: Observation, expected_file: String, expected_line: Int) -> Bool
	match record
		observe::Log(observe::LogRecord("log", observe::Warning, "accepted", attributes, Some(observe::TraceContext("trace-1", "span-2", true)), source)) => has_o1_attributes(attributes) and source.file == expected_file and source.start_line == expected_line
		_ => false
	end
end

pub fn is_o1_error(record: Observation, expected_file: String, expected_line: Int) -> Bool
	match record
		observe::Log(observe::LogRecord("log", observe::Error, "accepted", attributes, Some(observe::TraceContext("trace-1", "span-2", true)), source)) => has_o1_attributes(attributes) and source.file == expected_file and source.start_line == expected_line
		_ => false
	end
end

fn has_o1_attributes(attributes: List<Attribute>) -> Bool
	match attributes
		Cons(observe::Attribute("enabled", observe::BoolValue(true)), Cons(observe::Attribute("attempt", observe::IntValue(3)), Cons(observe::Attribute("route", observe::StringValue("checkout")), Nil))) => true
		_ => false
	end
end

pub handler recording(records: Sender<Observation>) for observe::Observe effects [concurrency]
	start_span(request) => unavailable_span(request)
	emit(record) => record_observation(records, record)
	finish_span(request) => ()
end

fn unavailable_span(request: SpanRequest) -> Span
	unavailable_span(request)
end

fn record_observation(records: Sender<Observation>, record: Observation) -> () effects [concurrency]
	let _ = channel::send(records, record)
	()
end
