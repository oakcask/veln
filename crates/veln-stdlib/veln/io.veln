use prelude
use net
use path as portable

## Opaque byte-operation capabilities. Values are created only by provider
## registration; the source surface exposes no constructors or casts.
pub type Reader = IoReader
pub type Writer = IoWriter
pub type Seeker = IoSeeker
pub type ReaderAt = IoReaderAt
pub type WriterAt = IoWriterAt
pub type Closer = IoCloser
pub type Syncer = IoSyncer

pub type Progress
	pub Known(count: ByteCount)
	pub Unknown(known_prefix: ByteCount)
end

pub type Commit
	pub No
	pub Yes
	pub Unknown
end

pub type ErrorKind
	pub InvalidInput
	pub NotFound
	pub AlreadyExists
	pub PermissionDenied
	pub NotDirectory
	pub IsDirectory
	pub DirectoryNotEmpty
	pub LinkLoop
	pub UnrepresentablePath
	pub CrossFilesystem
	pub Unsupported
	pub Closed
	pub Busy
	pub InvalidResource
	pub Cancelled
	pub NoProgress
	pub Other
end

pub type Error
	pub Error(operation: String, kind: ErrorKind, path: Option<portable::Path>, other_path: Option<portable::Path>, network: Option<net::NetError>, commit: Option<Commit>, message: String)
end

pub type ReadOutcome
	pub Data(bytes: ByteChunk)
	pub End
	pub ReadFailed(bytes: ByteChunk, consumed: Progress, error: Error)
end

pub type WriteOutcome
	pub Written(count: ByteCount)
	pub WriteFailed(committed: Progress, error: Error)
end

pub type ExactOutcome
	pub Complete(bytes: ByteChunk)
	pub Short(bytes: ByteChunk)
	pub ExactFailed(bytes: ByteChunk, consumed: Progress, error: Error)
end

pub type CopyOutcome
	pub Copied(count: ByteCount)
	pub CopyFailed(consumed: Progress, committed: Progress, error: Error)
end

pub type CloseOutcome
	pub Closed
	pub CloseFailed(released: Commit, error: Error)
end

pub type SeekOrigin
	pub Start(offset: ByteOffset)
	pub Current(displacement: Int)
	pub End(displacement: Int)
end

pub effect Read
	read(reader: Reader, maximum: ByteCount) -> ReadOutcome
end

pub effect Write
	write(writer: Writer, bytes: ByteChunk) -> WriteOutcome
end

pub effect Seek
	seek(seeker: Seeker, origin: SeekOrigin) -> Result<ByteOffset, Error>
end

pub effect ReadAt
	read_at(reader: ReaderAt, offset: ByteOffset, maximum: ByteCount) -> ReadOutcome
end

pub effect WriteAt
	write_at(writer: WriterAt, offset: ByteOffset, bytes: ByteChunk) -> WriteOutcome
end

pub effect Close
	close(closer: Closer) -> CloseOutcome
end

pub effect Sync
	sync(syncer: Syncer) -> Result<(), Error>
end

fn no_progress(operation: String) -> Error
	Error::Error(operation, ErrorKind::NoProgress, None, None, None, None, "provider made no progress")
end

fn transfer_error(operation: String, kind: ErrorKind, message: String) -> Error
	Error::Error(operation, kind, None, None, None, None, message)
end

fn zero_count() -> ByteCount
	byte_chunk_count(byte_chunk([]))
end

fn invalid_read_request(operation: String) -> ReadOutcome
	ReadFailed(byte_chunk([]), Progress::Known(zero_count()), transfer_error(operation, ErrorKind::InvalidInput, "read maximum must be nonnegative"))
end

fn invalid_read_reply(operation: String) -> ReadOutcome
	ReadFailed(byte_chunk([]), Progress::Unknown(zero_count()), transfer_error(operation, ErrorKind::InvalidResource, "provider reply exceeds the submitted read bounds"))
end

fn invalid_write_reply(operation: String) -> WriteOutcome
	WriteFailed(Progress::Unknown(zero_count()), transfer_error(operation, ErrorKind::InvalidResource, "provider reply exceeds the submitted write bounds"))
end

fn progress_count(progress: Progress) -> ByteCount
	match progress
		Progress::Known(count) => count
		Progress::Unknown(prefix) => prefix
	end
end

fn validate_read_reply(operation: String, maximum: ByteCount, outcome: ReadOutcome) -> ReadOutcome
	let bound = byte_count_to_int(maximum)
	match outcome
		Data(bytes) => if byte_count_to_int(byte_chunk_count(bytes)) > bound
			invalid_read_reply(operation)
		else
			outcome
		end
		End => outcome
		ReadFailed(bytes, consumed, _) => begin
			let delivered = byte_count_to_int(byte_chunk_count(bytes))
			let prefix = byte_count_to_int(progress_count(consumed))
			if delivered > bound or prefix < delivered or prefix > bound
				invalid_read_reply(operation)
			else
				outcome
			end
		end
	end
end

fn validate_write_reply(operation: String, bytes: ByteChunk, outcome: WriteOutcome) -> WriteOutcome
	let bound = byte_count_to_int(byte_chunk_count(bytes))
	match outcome
		Written(count) => begin
			let written = byte_count_to_int(count)
			if written < 0 or written > bound
				invalid_write_reply(operation)
			else
				outcome
			end
		end
		WriteFailed(committed, _) => begin
			let prefix = byte_count_to_int(progress_count(committed))
			if prefix < 0 or prefix > bound
				invalid_write_reply(operation)
			else
				outcome
			end
		end
	end
end

pub fn read(reader: Reader, maximum: ByteCount) -> ReadOutcome effects [Read]
	if byte_count_to_int(maximum) < 0
		invalid_read_request("read")
	else begin
		let outcome: ReadOutcome = validate_read_reply("read", maximum, prelude_builtin::io_provider_dispatch2("std::io::Read", "read", reader, maximum))
		match outcome
			ReadOutcome::Data(bytes) => if byte_count_to_int(maximum) > 0 and byte_count_to_int(byte_chunk_count(bytes)) == 0
				ReadOutcome::ReadFailed(bytes, Progress::Known(byte_chunk_count(bytes)), no_progress("read"))
			else
				outcome
			end
			_ => outcome
		end
	end
	end
end

pub fn write(writer: Writer, bytes: ByteChunk) -> WriteOutcome effects [Write]
	let outcome: WriteOutcome = validate_write_reply("write", bytes, prelude_builtin::io_provider_dispatch2("std::io::Write", "write", writer, bytes))
	match outcome
		Written(count) => if byte_count_to_int(byte_chunk_count(bytes)) > 0 and byte_count_to_int(count) == 0
			WriteFailed(Progress::Known(count), no_progress("write"))
		else
			outcome
		end
		_ => outcome
	end
end

pub fn seek(seeker: Seeker, origin: SeekOrigin) -> Result<ByteOffset, Error> effects [Seek]
	prelude_builtin::io_provider_dispatch2("std::io::Seek", "seek", seeker, origin)
end

pub fn read_at(reader: ReaderAt, offset: ByteOffset, maximum: ByteCount) -> ReadOutcome effects [ReadAt]
	if byte_count_to_int(maximum) < 0
		invalid_read_request("read_at")
	else
		validate_read_reply("read_at", maximum, prelude_builtin::io_provider_dispatch3("std::io::ReadAt", "read_at", reader, offset, maximum))
	end
end

pub fn write_at(writer: WriterAt, offset: ByteOffset, bytes: ByteChunk) -> WriteOutcome effects [WriteAt]
	validate_write_reply("write_at", bytes, prelude_builtin::io_provider_dispatch3("std::io::WriteAt", "write_at", writer, offset, bytes))
end

pub fn close(closer: Closer) -> CloseOutcome effects [Close]
	prelude_builtin::io_provider_dispatch1("std::io::Close", "close", closer)
end

pub fn sync(syncer: Syncer) -> Result<(), Error> effects [Sync]
	prelude_builtin::io_provider_dispatch1("std::io::Sync", "sync", syncer)
end

## Reads until count bytes arrive, clean end stops the transfer, or one provider
## failure occurs. Partial bytes and consumed progress remain observable.
pub fn read_exact(reader: Reader, count: ByteCount) -> ExactOutcome effects [Read]
	prelude_builtin::io_read_exact(reader, count)
end

## Writes the complete chunk by retrying only the uncommitted suffix. A failure
## stops the transfer and retains total committed progress.
pub fn write_all(writer: Writer, bytes: ByteChunk) -> WriteOutcome effects [Write]
	prelude_builtin::io_write_all(writer, bytes)
end

## Bounded provider transfer with explicit consumed and committed progress.
## A positive chunk size is required; empty reads and zero writes stop with
## NoProgress, and invalid provider counts stop with InvalidResource.
pub fn copy(reader: Reader, writer: Writer, chunk_size: ByteCount) -> CopyOutcome effects [Read, Write]
	prelude_builtin::io_copy(reader, writer, chunk_size)
end
