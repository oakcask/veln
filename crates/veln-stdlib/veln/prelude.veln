use bytes
use diagnostic

pub type Byte = bytes::Byte
pub type ByteChunk = bytes::ByteChunk
pub type ByteOffset = bytes::ByteOffset
pub type ByteCount = bytes::ByteCount
pub type ByteView = bytes::ByteView

pub type StreamInput
	Chunk(bytes: ByteChunk)
	End
end

pub type StreamAdapterAction
	SendBytes(bytes: ByteChunk)
	EndStream
	Ignore
end

pub fn stream_adapter_drain_actions(stream: NetStream, handler: fn(StreamInput) -> List<StreamAdapterAction>) -> List<StreamAdapterAction> effects [net, concurrency]
	prelude_builtin::stream_adapter_drain_actions(stream, handler)
end

pub fn stream_adapter_drain_actions_until_cancellable(stream: NetStream, handler: fn(StreamInput) -> List<StreamAdapterAction>, deadline: Deadline, token: CancelToken) -> StreamWriteOutcome effects [net, time, concurrency]
	prelude_builtin::stream_adapter_drain_actions_until_cancellable(stream, handler, deadline, token)
end

pub fn stream_adapter_accept_loop(listener: NetListener, handler: fn(StreamInput) -> List<StreamAdapterAction>) -> () effects [net, concurrency]
	prelude_builtin::stream_adapter_accept_loop(listener, handler)
end

pub type AcceptOutcome
	AcceptStream(stream: NetStream)
	AcceptEnd
	AcceptDeadlineExpired
	AcceptCancelled
end

pub type StreamReadOutcome
	ReadChunk(bytes: ByteChunk)
	ReadEnd
	ReadDeadlineExpired
	ReadCancelled
end

pub type StreamWriteOutcome
	WriteCompleted
	WriteDeadlineExpired
	WriteCancelled
end

pub type CancellableWaitOutcome
	WaitCompleted
	WaitDeadlineExpired
	WaitCancelled
end

pub type DecodeError
	DecodeError(id: String, offset: ByteOffset, field_path: String)
	DecodeErrorWithReason(id: String, offset: ByteOffset, field_path: String, reason: String)
end

pub type DecodeReadiness
	NeedBytes(count: ByteCount)
	NeedEnd
end

pub type DecodeStep<T>
	Decoded(value: T, consumed: ByteCount)
	NeedMore(readiness: DecodeReadiness)
	Invalid(error: DecodeError)
end

pub type SchemaDispatchPayload<T>
	Known(value: T)
	Unknown(tag: Int, payload: ByteView)
end

pub type EncodeError
	EncodeError(id: String, field_path: String, reason: String)
end

pub type RuntimeDiagnostic = diagnostic::RuntimeDiagnostic
pub type RuntimeDiagnosticDetail = diagnostic::RuntimeDiagnosticDetail
pub type RuntimeDiagnosticFieldPathSegment = diagnostic::RuntimeDiagnosticFieldPathSegment
pub type RuntimeByteDiagnosticFacts = diagnostic::RuntimeByteDiagnosticFacts
pub type RuntimeBytePreview = diagnostic::RuntimeBytePreview
pub type Http2DiagnosticDetail = diagnostic::Http2DiagnosticDetail
pub type HpackDiagnosticDetail = diagnostic::HpackDiagnosticDetail

pub type EncodeStep<TState>
	Encoded(chunks: List<ByteChunk>)
	Partial(chunks: List<ByteChunk>, produced: ByteCount, state: TState)
	Invalid(error: EncodeError)
end

## Builds a validated byte value for byte-oriented package APIs.
pub fn byte(value: Int) -> Result<Byte, String>
	if value < 0
		Err("byte value must be between 0 and 255")
	else if value > 255
		Err("byte value must be between 0 and 255")
	else
		Ok(Byte(value))
	end
end

pub fn byte_to_int(value: Byte) -> Int
	match value
		Byte(inner) => inner
	end
end

pub fn byte_chunk(bytes: Vec<Byte>) -> ByteChunk
	ByteChunk(bytes)
end

pub fn byte_chunk_count(chunk: ByteChunk) -> ByteCount
	match chunk
		ByteChunk(bytes) => ByteCount(prelude_builtin::vec_len(bytes))
	end
end

pub fn byte_append(left: ByteChunk, right: ByteChunk) -> ByteChunk
	match left
		ByteChunk(left_bytes) => match right
			ByteChunk(right_bytes) => ByteChunk(prelude_builtin::vec_concat(left_bytes, right_bytes))
		end
	end
end

