pub fn byte_chunks_empty() -> List<ByteChunk>
	Nil
end

pub fn byte_chunks_one(chunk: ByteChunk) -> List<ByteChunk>
	Cons(chunk, Nil)
end

pub fn byte_chunks_append(left: List<ByteChunk>, right: List<ByteChunk>) -> List<ByteChunk>
	match left
		Nil => right
		Cons(head, tail) => Cons(head, byte_chunks_append(tail, right))
	end
end

