pub fn byte_count(value: Int) -> Result<ByteCount, String>
	if value < 0
		Err("byte count must be non-negative")
	else
		Ok(ByteCount(value))
	end
end

pub fn byte_count_to_int(value: ByteCount) -> Int
	match value
		ByteCount(inner) => inner
	end
end

pub fn byte_offset(value: Int) -> Result<ByteOffset, String>
	if value < 0
		Err("byte offset must be non-negative")
	else
		Ok(ByteOffset(value))
	end
end

pub fn byte_offset_to_int(value: ByteOffset) -> Int
	match value
		ByteOffset(inner) => inner
	end
end

pub fn vec_fold(items: Vec<A>, initial: B, f: fn(B, A) -> B) -> B
	prelude_builtin::vec_fold(items, initial, f)
end

pub fn vec_len(items: Vec<A>) -> Int
	prelude_builtin::vec_len(items)
end

pub fn vec_is_empty(items: Vec<A>) -> Bool
	vec_len(items) == 0
end

pub fn vec_push(items: Vec<A>, value: A) -> Vec<A>
	vec_concat(items, [value])
end

pub fn vec_concat(left: Vec<A>, right: Vec<A>) -> Vec<A>
	prelude_builtin::vec_fold(right, left, vec_append)
end

fn vec_append(items: Vec<A>, item: A) -> Vec<A>
	prelude_builtin::vec_push(items, item)
end

pub fn vec_map(items: Vec<Item>, f: fn(Item) -> A) -> Vec<A>
	let state: { values : Vec<A>, map : fn(Item) -> A } = prelude_builtin::vec_fold(items, { values: [], map: f }, vec_map_step)
	state.values
end

fn vec_map_step(state: { values : Vec<A>, map : fn(Item) -> A }, item: Item) -> { values : Vec<A>, map : fn(Item) -> A }
	let map = state.map
	{ values: vec_push(state.values, map(item)), map: map }
end

pub fn vec_filter(items: Vec<A>, f: fn(A) -> Bool) -> Vec<A>
	let state: { values : Vec<A>, keep : fn(A) -> Bool } = prelude_builtin::vec_fold(items, { values: [], keep: f }, vec_filter_step)
	state.values
end

fn vec_filter_step(state: { values : Vec<A>, keep : fn(A) -> Bool }, item: A) -> { values : Vec<A>, keep : fn(A) -> Bool }
	let keep = state.keep
	if keep(item)
		{ values: vec_push(state.values, item), keep: keep }
	else
		state
	end
end

pub fn vec_try_map(items: Vec<Item>, f: fn(Item) -> Result<A, E>) -> Result<Vec<A>, E>
	let state: { values : Result<Vec<A>, E>, map : fn(Item) -> Result<A, E> } = prelude_builtin::vec_fold(items, { values: Ok([]), map: f }, vec_try_map_step)
	state.values
end

fn vec_try_map_step(state: { values : Result<Vec<A>, E>, map : fn(Item) -> Result<A, E> }, item: Item) -> { values : Result<Vec<A>, E>, map : fn(Item) -> Result<A, E> }
	let map = state.map
	match state.values
		Ok(values) => match map(item)
			Ok(mapped) => { values: Ok(vec_push(values, mapped)), map: map }
			Err(error) => { values: Err(error), map: map }
		end
		Err(error) => { values: Err(error), map: map }
	end
end

pub fn vec_try_map_with(context: C, items: Vec<Item>, f: fn(C, Item) -> Result<A, E>) -> Result<Vec<A>, E>
	let state: { values : Result<Vec<A>, E>, map : fn(C, Item) -> Result<A, E>, context : C } = prelude_builtin::vec_fold(items, { values: Ok([]), map: f, context: context }, vec_try_map_with_step)
	state.values
end

fn vec_try_map_with_step(state: { values : Result<Vec<A>, E>, map : fn(C, Item) -> Result<A, E>, context : C }, item: Item) -> { values : Result<Vec<A>, E>, map : fn(C, Item) -> Result<A, E>, context : C }
	let map = state.map
	let context = state.context
	match state.values
		Ok(values) => match map(context, item)
			Ok(mapped) => { values: Ok(vec_push(values, mapped)), map: map, context: context }
			Err(error) => { values: Err(error), map: map, context: context }
		end
		Err(error) => { values: Err(error), map: map, context: context }
	end
end

pub fn list_nil() -> List<A>
	Nil
end

pub fn list_cons(head: A, tail: List<A>) -> List<A>
	Cons(head, tail)
end

pub fn list_is_empty(items: List<A>) -> Bool
	match items
		Nil => true
		Cons(_, _) => false
	end
end

pub fn list_fold(items: List<Item>, initial: B, f: fn(B, Item) -> B) -> B
	match items
		Nil => initial
		Cons(head, tail) => list_fold(tail, f(initial, head), f)
	end
end

pub fn list_reverse(items: List<A>) -> List<A>
	list_reverse_step(items, Nil)
end

fn list_reverse_step(items: List<A>, acc: List<A>) -> List<A>
	match items
		Nil => acc
		Cons(head, tail) => list_reverse_step(tail, Cons(head, acc))
	end
end

pub fn list_map(items: List<Item>, f: fn(Item) -> A) -> List<A>
	list_reverse(list_map_step(items, f, Nil))
end

fn list_map_step(items: List<Item>, f: fn(Item) -> A, acc: List<A>) -> List<A>
	match items
		Nil => acc
		Cons(head, tail) => list_map_step(tail, f, Cons(f(head), acc))
	end
end

pub fn list_filter(items: List<A>, f: fn(A) -> Bool) -> List<A>
	list_reverse(list_filter_step(items, f, Nil))
end

fn list_filter_step(items: List<A>, f: fn(A) -> Bool, acc: List<A>) -> List<A>
	match items
		Nil => acc
		Cons(head, tail) => if f(head)
			list_filter_step(tail, f, Cons(head, acc))
		else
			list_filter_step(tail, f, acc)
		end
	end
end

pub fn list_try_map(items: List<Item>, f: fn(Item) -> Result<A, E>) -> Result<List<A>, E>
	match list_try_map_step(items, f, Nil)
		Ok(mapped) => Ok(list_reverse(mapped))
		Err(error) => Err(error)
	end
end

fn list_try_map_step(items: List<Item>, f: fn(Item) -> Result<A, E>, acc: List<A>) -> Result<List<A>, E>
	match items
		Nil => Ok(acc)
		Cons(head, tail) => match f(head)
			Ok(mapped) => list_try_map_step(tail, f, Cons(mapped, acc))
			Err(error) => Err(error)
		end
	end
end

pub fn dict_get(dict: Dict<K, V>, key: K) -> Option<V>
	prelude_builtin::dict_get(dict, key)
end

pub fn dict_contains(dict: Dict<K, V>, key: K) -> Bool
	match prelude_builtin::dict_get(dict, key)
		Some(_) => true
		None => false
	end
end

pub fn dict_insert(dict: Dict<K, V>, key: K, value: V) -> Dict<K, V>
	prelude_builtin::dict_insert(dict, key, value)
end

pub fn dict_remove(dict: Dict<K, V>, key: K) -> Dict<K, V>
	prelude_builtin::dict_remove(dict, key)
end

pub fn dict_map(dict: Dict<K, V>, f: fn(K, V) -> A) -> Dict<K, A>
	prelude_builtin::dict_map(dict, f)
end

pub fn dict_map_with(context: C, dict: Dict<K, V>, f: fn(C, K, V) -> A) -> Dict<K, A>
	let state: { values : Dict<K, A>, map : fn(C, K, V) -> A, context : C } = prelude_builtin::dict_fold(dict, {}, dict_map_with_step)
	state.values
end

fn dict_map_with_step(state: { values : Dict<K, A>, map : fn(C, K, V) -> A, context : C }, key: K, value: V) -> { values : Dict<K, A>, map : fn(C, K, V) -> A, context : C }
	let map = state.map
	let context = state.context
	{ values: prelude_builtin::dict_insert(state.values, key, map(context, key, value)), map: map, context: context }
end

pub fn dict_filter(dict: Dict<K, V>, f: fn(K, V) -> Bool) -> Dict<K, V>
	prelude_builtin::dict_filter(dict, f)
end

pub fn dict_filter_with(context: C, dict: Dict<K, V>, f: fn(C, K, V) -> Bool) -> Dict<K, V>
	let state: { values : Dict<K, V>, keep : fn(C, K, V) -> Bool, context : C } = prelude_builtin::dict_fold(dict, {}, dict_filter_with_step)
	state.values
end

fn dict_filter_with_step(state: { values : Dict<K, V>, keep : fn(C, K, V) -> Bool, context : C }, key: K, value: V) -> { values : Dict<K, V>, keep : fn(C, K, V) -> Bool, context : C }
	let keep = state.keep
	let context = state.context
	if keep(context, key, value)
		{ values: prelude_builtin::dict_insert(state.values, key, value), keep: keep, context: context }
	else
		state
	end
end

pub fn dict_fold(dict: Dict<K, V>, initial: A, f: fn(A, K, V) -> A) -> A
	prelude_builtin::dict_fold(dict, initial, f)
end

pub fn dict_fold_with(context: C, dict: Dict<K, V>, initial: A, f: fn(C, A, K, V) -> A) -> A
	let state: { acc : A, fold : fn(C, A, K, V) -> A, context : C } = prelude_builtin::dict_fold(dict, { acc: initial, fold: f, context: context }, dict_fold_with_step)
	state.acc
end

fn dict_fold_with_step(state: { acc : A, fold : fn(C, A, K, V) -> A, context : C }, key: K, value: V) -> { acc : A, fold : fn(C, A, K, V) -> A, context : C }
	let fold = state.fold
	let context = state.context
	{ acc: fold(context, state.acc, key, value), fold: fold, context: context }
end

pub fn dict_try_map(dict: Dict<K, V>, f: fn(K, V) -> Result<A, E>) -> Result<Dict<K, A>, E>
	prelude_builtin::dict_try_map(dict, f)
end

pub fn dict_try_map_with(context: C, dict: Dict<K, V>, f: fn(C, K, V) -> Result<A, E>) -> Result<Dict<K, A>, E>
	let state: { values : Result<Dict<K, A>, E>, map : fn(C, K, V) -> Result<A, E>, context : C } = prelude_builtin::dict_fold(dict, { values: Ok({}), map: f, context: context }, dict_try_map_with_step)
	state.values
end

fn dict_try_map_with_step(state: { values : Result<Dict<K, A>, E>, map : fn(C, K, V) -> Result<A, E>, context : C }, key: K, value: V) -> { values : Result<Dict<K, A>, E>, map : fn(C, K, V) -> Result<A, E>, context : C }
	let map = state.map
	let context = state.context
	match state.values
		Ok(values) => match map(context, key, value)
			Ok(mapped) => { values: Ok(prelude_builtin::dict_insert(values, key, mapped)), map: map, context: context }
			Err(error) => { values: Err(error), map: map, context: context }
		end
		Err(error) => { values: Err(error), map: map, context: context }
	end
end

pub fn option_map(value: Option<A>, f: fn(A) -> B) -> Option<B>
	match value
		Some(inner) => Some(f(inner))
		None => None
	end
end

pub fn option_and_then(value: Option<A>, f: fn(A) -> Option<B>) -> Option<B>
	match value
		Some(inner) => f(inner)
		None => None
	end
end

pub fn option_unwrap_or(value: Option<A>, fallback: A) -> A
	match value
		Some(inner) => inner
		None => fallback
	end
end

pub fn result_map(value: Result<A, E>, f: fn(A) -> B) -> Result<B, E>
	match value
		Ok(inner) => Ok(f(inner))
		Err(error) => Err(error)
	end
end

pub fn result_map_err(value: Result<A, E>, f: fn(E) -> F) -> Result<A, F>
	match value
		Ok(inner) => Ok(inner)
		Err(error) => Err(f(error))
	end
end

pub fn result_and_then(value: Result<A, E>, f: fn(A) -> Result<B, E>) -> Result<B, E>
	match value
		Ok(inner) => f(inner)
		Err(error) => Err(error)
	end
end

pub fn string_split_once(text: String, separator: String) -> Option<{ left : String, right : String }>
	prelude_builtin::string_split_once(text, separator)
end

pub fn string_parse_int(text: String) -> Result<Int, String>
	prelude_builtin::string_parse_int(text)
end

pub fn int_to_string(value: Int) -> String
	prelude_builtin::int_to_string(value)
end
