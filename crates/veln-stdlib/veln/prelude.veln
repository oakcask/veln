end

pub fn byte_drop(chunk: ByteChunk, count: ByteCount) -> Result<ByteChunk, String>
	prelude_builtin::byte_drop(chunk, count)
end

pub fn byte_view(chunk: ByteChunk, offset: ByteOffset, count: ByteCount) -> Result<ByteView, String>
