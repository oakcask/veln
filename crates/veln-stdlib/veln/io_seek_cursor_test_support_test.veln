	handle handle handle handle handle handle handle handle positional_body(owner, state) with reader(owner, state) with writer(owner, state) with seeker(owner, state) with positional_reader(owner, state) with positional_writer(owner, state) with closer() with syncer() with mutator()
end

fn run_unknown(owner: io_provider::Owner, state: io_provider::State<State>) -> Result<UnknownObservation, String> effects [concurrency]
	handle handle handle handle handle handle handle handle unknown_body(owner, state) with reader(owner, state) with writer(owner, state) with seeker(owner, state) with positional_reader(owner, state) with positional_writer(owner, state) with closer() with syncer() with mutator()
end

pub fn execute_origins() -> Result<OriginObservation, String> effects [io_provider::Scope, concurrency]
	let owner = io_provider::owner()
	let bytes = byte_chunk_from_visible_ascii_string("abcdef")?
	let actions = list_cons(SeekSucceeds, list_cons(SeekSucceeds, list_cons(SeekSucceeds, list_cons(SeekSucceeds, list_cons(ReadSucceeds(1), list_cons(SeekSucceeds, list_nil()))))))
	let state = io_provider::state(State(bytes, KnownCursor(0), KnownCursor(0), actions, ""))
	run_origins(owner, state)
end

pub fn execute_sequential() -> Result<SequentialObservation, String> effects [io_provider::Scope, concurrency]
	let owner = io_provider::owner()
	let bytes = byte_chunk_from_visible_ascii_string("abcdefghij")?
	let actions = list_cons(ReadSucceeds(2), list_cons(SeekSucceeds, list_cons(WriteSucceeds(2), list_cons(ReadFails(1), list_cons(WriteFails(1), list_cons(ReadSucceeds(1), list_nil()))))))
	let state = io_provider::state(State(bytes, KnownCursor(0), KnownCursor(0), actions, ""))
	run_sequential(owner, state)
end

pub fn execute_positional() -> Result<PositionalObservation, String> effects [io_provider::Scope, concurrency]
	let owner = io_provider::owner()
	let bytes = byte_chunk_from_visible_ascii_string("abcdef")?
	let actions = list_cons(SeekSucceeds, list_cons(ReadAtSucceeds(2), list_cons(ReadAtFails(1), list_cons(WriteAtSucceeds(2), list_cons(WriteAtFails(0), list_nil())))))
	let state = io_provider::state(State(bytes, KnownCursor(0), KnownCursor(0), actions, ""))
	run_positional(owner, state)
end

pub fn execute_unknown() -> Result<UnknownObservation, String> effects [io_provider::Scope, concurrency]
	let owner = io_provider::owner()
	let bytes = byte_chunk_from_visible_ascii_string("abcdef")?
	let actions = list_cons(SeekSucceeds, list_cons(SeekFailsKnown, list_cons(SeekFailsUnknown, list_cons(SeekSucceeds, list_cons(SeekSucceeds, list_nil())))))
	let state = io_provider::state(State(bytes, KnownCursor(0), KnownCursor(0), actions, ""))
	run_unknown(owner, state)
end
