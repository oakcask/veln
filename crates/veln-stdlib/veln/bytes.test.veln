fn expect_chunk_and_tail(chunk: ByteChunk, tail: List<ByteChunk>, hex: String, remaining: List<String>) -> Result<(), String>
	let _ = expect_bytes(chunk, hex)?
	expect_chunk_list(tail, remaining)
end
