		Err("byte_write_u48_le value must be between 0 and 281474976710655") => true
		_ => false
	end
	let _ = bytes_expect(high and negative and overflow)?
	let short = byte_view(big, byte_offset(0)?, byte_count(5)?)?
	let big_failure = match byte_read_u48_be(short)
		Err("byte read requires 6 bytes but view has 5") => true
