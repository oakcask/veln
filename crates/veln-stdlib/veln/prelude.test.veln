	let selected_third = channel_first_stream_routing_general_list_route_ready_stream_input(receivers)
	let selected_fourth = channel_first_stream_routing_general_list_route_ready_stream_input(receivers)
	let selected_fifth = channel_first_stream_routing_general_list_route_ready_stream_input(receivers)
	let selected_sixth = channel_first_stream_routing_general_list_route_ready_stream_input(receivers)
	let selected_seventh = channel_first_stream_routing_general_list_route_ready_stream_input(receivers)
	let _ = expect_prelude(selected_first.index == 0, "channel-first-stream-routing-general-list value 1")?
	let _ = expect_prelude(channel_first_stream_routing_general_list_input_score(selected_first.value) == 1, "channel-first-stream-routing-general-list value 3")?
	let _ = expect_prelude(selected_second.index == 0, "channel-first-stream-routing-general-list value 5")?
	let _ = expect_prelude(channel_first_stream_routing_general_list_input_score(selected_second.value) == 2, "channel-first-stream-routing-general-list value 7")?
	let _ = expect_prelude(selected_third.index == 1, "channel-first-stream-routing-general-list value 9")?
	let _ = expect_prelude(channel_first_stream_routing_general_list_input_score(selected_third.value) == 3, "channel-first-stream-routing-general-list value 11")?
	let _ = expect_prelude(selected_fourth.index == 2, "channel-first-stream-routing-general-list value 13")?
	let _ = expect_prelude(channel_first_stream_routing_general_list_input_score(selected_fourth.value) == 4, "channel-first-stream-routing-general-list value 15")?
	let _ = expect_prelude(selected_fifth.index == 3, "channel-first-stream-routing-general-list value 17")?
	let _ = expect_prelude(channel_first_stream_routing_general_list_input_score(selected_fifth.value) == 5, "channel-first-stream-routing-general-list value 19")?
	let _ = expect_prelude(selected_sixth.index == 4, "channel-first-stream-routing-general-list value 21")?
	let _ = expect_prelude(channel_first_stream_routing_general_list_input_score(selected_sixth.value) == 6, "channel-first-stream-routing-general-list value 23")?
	let _ = expect_prelude(selected_seventh.index == 5, "channel-first-stream-routing-general-list value 25")?
	let _ = expect_prelude(channel_first_stream_routing_general_list_input_score(selected_seventh.value) == 7, "channel-first-stream-routing-general-list value 27")?
	let first_score = channel_first_stream_routing_general_list_selected_score(selected_first) + channel_first_stream_routing_general_list_selected_score(selected_second) + channel_first_stream_routing_general_list_selected_score(selected_third)
	let second_score = channel_first_stream_routing_general_list_selected_score(selected_fourth) + channel_first_stream_routing_general_list_selected_score(selected_fifth)
	let third_score = channel_first_stream_routing_general_list_selected_score(selected_sixth) + channel_first_stream_routing_general_list_selected_score(selected_seventh)
