	let _ = expect_prelude(total_score == 1528, "channel-first-stream-routing-general-list value 29")?
	Ok(())
end

# Cancellable stream routing maps receiver-list selection outcomes to actions.
type CancellableRouteAction
	CancellableRouteSendBytes { stream_id: Int, bytes: ByteChunk }
	CancellableRouteEndStream { stream_id: Int }
	CancellableRouteRetryAfterDeadline { stream_id: Int }
	CancellableRouteCleanupAfterCancel { stream_id: Int }
	CancellableRouteDecline { stream_id: Int }
end

type CancellableRouteOutcome
	CancellableRouteRouted { index: Int, value: StreamInput }
	CancellableRouteTimedOut
	CancellableRouteCancelled
end

fn stream_adapter_cancellable_channel_first_routing_handle_stream_input(stream_id: Int, input: StreamInput, state: { chunks : Int, ended : Bool }) -> { actions : List<CancellableRouteAction>, next_state : { chunks : Int, ended : Bool } }
	match input
		Chunk(bytes) => { actions: list_cons(CancellableRouteSendBytes(stream_id, bytes), list_nil()), next_state: { chunks: state.chunks + 1, ended: state.ended } }
		End => { actions: list_cons(CancellableRouteEndStream(stream_id), list_nil()), next_state: { chunks: state.chunks, ended: true } }
	end
end

fn stream_adapter_cancellable_channel_first_routing_stream_id_for_index(index: Int) -> Int
	match index
		0 => 11
		1 => 13
		_ => 17
	end
end

fn stream_adapter_cancellable_channel_first_routing_with_outcome(outcome: String, handled: { actions : List<CancellableRouteAction>, next_state : { chunks : Int, ended : Bool } }) -> { outcome : String, actions : List<CancellableRouteAction>, next_state : { chunks : Int, ended : Bool } }
	{ outcome: outcome, actions: handled.actions, next_state: handled.next_state }
end

fn stream_adapter_cancellable_channel_first_routing_route_outcome(selected: Result<Option<{ index : Int, value : StreamInput }>, SelectError>) -> CancellableRouteOutcome
	match selected
		Ok(Some(route)) => CancellableRouteRouted(route.index, route.value)
		Ok(None) => CancellableRouteTimedOut
		Err(_) => CancellableRouteCancelled
	end
end

fn stream_adapter_cancellable_channel_first_routing_handle_route_outcome(outcome: CancellableRouteOutcome, state: { chunks : Int, ended : Bool }) -> { outcome : String, actions : List<CancellableRouteAction>, next_state : { chunks : Int, ended : Bool } }
	match outcome
		CancellableRouteRouted(index, value) => stream_adapter_cancellable_channel_first_routing_with_outcome("routed", stream_adapter_cancellable_channel_first_routing_handle_stream_input(stream_adapter_cancellable_channel_first_routing_stream_id_for_index(index), value, state))
		CancellableRouteTimedOut => { outcome: "timed-out", actions: list_cons(CancellableRouteDecline(0), list_nil()), next_state: state }
		CancellableRouteCancelled => { outcome: "cancelled", actions: list_cons(CancellableRouteCleanupAfterCancel(17), list_nil()), next_state: state }
	end
end

fn stream_adapter_cancellable_channel_first_routing_route_with_cancellable_channel_first(receivers: List<Receiver<StreamInput>>, state: { chunks : Int, ended : Bool }, timeout_ms: Int, token: CancelToken) -> { outcome : String, actions : List<CancellableRouteAction>, next_state : { chunks : Int, ended : Bool } } effects [time, concurrency]
	stream_adapter_cancellable_channel_first_routing_handle_route_outcome(stream_adapter_cancellable_channel_first_routing_route_outcome(channel::select_many_timeout_cancellable(receivers, timeout_ms, token)), state)
end

fn stream_adapter_cancellable_channel_first_routing_action_score(actions: List<CancellableRouteAction>) -> Int
	match actions
		Nil => 0
		Cons(action, tail) => match action
			CancellableRouteSendBytes(stream_id, bytes) => stream_id * 100 + byte_count_to_int(byte_chunk_count(bytes)) + stream_adapter_cancellable_channel_first_routing_action_score(tail)
			CancellableRouteEndStream(stream_id) => stream_id * 10 + stream_adapter_cancellable_channel_first_routing_action_score(tail)
			CancellableRouteRetryAfterDeadline(stream_id) => 1000 + stream_id + stream_adapter_cancellable_channel_first_routing_action_score(tail)
			CancellableRouteCleanupAfterCancel(stream_id) => 2000 + stream_id + stream_adapter_cancellable_channel_first_routing_action_score(tail)
			CancellableRouteDecline(stream_id) => stream_id + stream_adapter_cancellable_channel_first_routing_action_score(tail)
		end
	end
end

fn stream_adapter_cancellable_channel_first_routing_bool_text(value: Bool) -> String
	if value
		"true"
	else
		"false"
	end
end

test stream_adapter_cancellable_channel_first_routing() -> Result<(), String> effects [concurrency, time]
	let payload = byte_chunk_from_hex("0a0b")?
	let ready_first = channel::bounded<StreamInput>(1)
	let ready_second = channel::bounded<StreamInput>(1)
	let ready_third = channel::bounded<StreamInput>(1)
	let ready_fourth = channel::bounded<StreamInput>(1)
	let ready_fifth = channel::bounded<StreamInput>(1)
	let _ = channel::send(ready_fourth.tx, Chunk(payload))
	let ready_receivers = list_cons(ready_first.rx, list_cons(ready_second.rx, list_cons(ready_third.rx, list_cons(ready_fourth.rx, list_cons(ready_fifth.rx, list_nil())))))
	let ready_token = time::cancel_token()
	let ready = stream_adapter_cancellable_channel_first_routing_route_with_cancellable_channel_first(ready_receivers, { chunks: 0, ended: false }, 25, ready_token)
	let _ = expect_prelude(ready.outcome == "routed", "stream-adapter-cancellable-channel-first-routing value 1")?
	let _ = expect_prelude(stream_adapter_cancellable_channel_first_routing_action_score(ready.actions) == 1702, "stream-adapter-cancellable-channel-first-routing value 3")?
	let _ = expect_prelude(ready.next_state.chunks == 1, "stream-adapter-cancellable-channel-first-routing value 5")?
	let timeout_first = channel::bounded<StreamInput>(1)
	let timeout_second = channel::bounded<StreamInput>(1)
	let timeout_third = channel::bounded<StreamInput>(1)
	let timeout_fourth = channel::bounded<StreamInput>(1)
	let timeout_fifth = channel::bounded<StreamInput>(1)
	let timeout_receivers = list_cons(timeout_first.rx, list_cons(timeout_second.rx, list_cons(timeout_third.rx, list_cons(timeout_fourth.rx, list_cons(timeout_fifth.rx, list_nil())))))
	let timeout_token = time::cancel_token()
	let timed_out = stream_adapter_cancellable_channel_first_routing_route_with_cancellable_channel_first(timeout_receivers, ready.next_state, 0, timeout_token)
	let _ = expect_prelude(timed_out.outcome == "timed-out", "stream-adapter-cancellable-channel-first-routing value 6")?
	let _ = expect_prelude(stream_adapter_cancellable_channel_first_routing_action_score(timed_out.actions) == 0, "stream-adapter-cancellable-channel-first-routing value 8")?
	let _ = expect_prelude(timed_out.next_state.chunks == 1, "stream-adapter-cancellable-channel-first-routing value 10")?
	let cancel_first = channel::bounded<StreamInput>(1)
	let cancel_second = channel::bounded<StreamInput>(1)
	let cancel_third = channel::bounded<StreamInput>(1)
	let cancel_fourth = channel::bounded<StreamInput>(1)
	let cancel_fifth = channel::bounded<StreamInput>(1)
	let cancel_receivers = list_cons(cancel_first.rx, list_cons(cancel_second.rx, list_cons(cancel_third.rx, list_cons(cancel_fourth.rx, list_cons(cancel_fifth.rx, list_nil())))))
	let cancel_token = time::cancel_token()
	time::cancel(cancel_token)
	let cancelled = stream_adapter_cancellable_channel_first_routing_route_with_cancellable_channel_first(cancel_receivers, timed_out.next_state, 25, cancel_token)
	let _ = expect_prelude(cancelled.outcome == "cancelled", "stream-adapter-cancellable-channel-first-routing value 11")?
	let _ = expect_prelude(stream_adapter_cancellable_channel_first_routing_action_score(cancelled.actions) == 2017, "stream-adapter-cancellable-channel-first-routing value 13")?
	let _ = expect_prelude(stream_adapter_cancellable_channel_first_routing_bool_text(cancelled.next_state.ended) == "false", "stream-adapter-cancellable-channel-first-routing value 15")?
	Ok(())
end

test channel_receive_and_selection_preserve_fairness_priority_and_timeouts() -> Result<(), String> effects [concurrency]
	let pair = channel::bounded<String>(2)
	let _ = channel::send(pair.tx, "first")
	let received = match channel::recv(pair.rx)
		Some("first") => true
		_ => false
	end
	let left = channel::bounded<String>(1)
	let right = channel::bounded<String>(1)
	let _ = channel::send(left.tx, "left")
	let _ = channel::send(right.tx, "right")
	let selected = match channel::select(left.rx, right.rx)
		Some({ index: 0, value: "left" }) => true
		_ => false
	end
	let balanced_left = channel::bounded<String>(2)
	let balanced_right = channel::bounded<String>(2)
	let _ = channel::send(balanced_left.tx, "left-a")
	let _ = channel::send(balanced_left.tx, "left-b")
	let _ = channel::send(balanced_right.tx, "right-a")
	let _ = channel::send(balanced_right.tx, "right-b")
	let first = match channel::select(balanced_left.rx, balanced_right.rx)
		Some({ index: 1, value: "right-a" }) => true
		_ => false
	end
	let second = match channel::select(balanced_left.rx, balanced_right.rx)
		Some({ index: 0, value: "left-a" }) => true
		_ => false
	end
	let priority = match channel::select_priority(left.rx, right.rx)
		Some({ index: 1, value: "right" }) => true
		_ => false
	end
	let timeout = channel::bounded<String>(1)
	let timed_out = match channel::select_timeout(timeout.rx, timeout.rx, 0)
		None => true
		_ => false
	end
	let result_timeout = match channel::select_timeout_result(timeout.rx, timeout.rx, 0)
		Ok(None) => true
		_ => false
	end
	expect_prelude(received and selected and first and second and priority and timed_out and result_timeout, "channel fairness, priority, or timeout changed")
end
