	let second_actions = channel_first_stream_routing_four_route_append_actions(handled_third.actions, handled_fourth.actions)
	let actions = channel_first_stream_routing_four_route_append_actions(first_actions, second_actions)
	let _ = expect_prelude(selected_first.index == 0, "channel-first-stream-routing-four-route value 1")?
	let _ = expect_prelude(selected_second.index == 1, "channel-first-stream-routing-four-route value 3")?
	let _ = expect_prelude(selected_third.index == 2, "channel-first-stream-routing-four-route value 5")?
	let _ = expect_prelude(selected_fourth.index == 3, "channel-first-stream-routing-four-route value 7")?
	let _ = expect_prelude(channel_first_stream_routing_four_route_action_stream_score(actions) == 160, "channel-first-stream-routing-four-route value 9")?
	let _ = expect_prelude(channel_first_stream_routing_four_route_bool_text(handled_first.next_state.ended) == "true", "channel-first-stream-routing-four-route value 11")?
	let _ = expect_prelude(handled_second.next_state.chunks == 1, "channel-first-stream-routing-four-route value 13")?
	let _ = expect_prelude(channel_first_stream_routing_four_route_bool_text(handled_third.next_state.ended) == "true", "channel-first-stream-routing-four-route value 15")?
	let _ = expect_prelude(handled_fourth.next_state.chunks == 1, "channel-first-stream-routing-four-route value 17")?
	let _ = expect_prelude(channel_first_stream_routing_four_route_write_count(actions) == 2, "channel-first-stream-routing-four-route value 19")?
	Ok(())
end

# General channel-first stream routing accepts a receiver list and returns the selected route.
fn channel_first_stream_routing_general_list_route_ready_stream_input(receivers: List<Receiver<StreamInput>>) -> { index : Int, value : StreamInput } effects [concurrency]
	match channel::select_many_priority(receivers)
		Some(selected) => selected
		None => { index: -1, value: End }
	end
end

fn channel_first_stream_routing_general_list_input_score(input: StreamInput) -> Int
	match input
		Chunk(bytes) => byte_count_to_int(byte_chunk_count(bytes))
		End => 0
	end
end

fn channel_first_stream_routing_general_list_selected_score(selected: { index : Int, value : StreamInput }) -> Int
	selected.index * 100 + channel_first_stream_routing_general_list_input_score(selected.value)
end

