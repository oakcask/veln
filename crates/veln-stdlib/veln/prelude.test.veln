	channel::close(second.tx)
	channel::close(third.tx)
	channel::close(fourth.tx)
	let selected_first = match channel_first_stream_routing_four_route_select_four_priority(first.rx, second.rx, third.rx, fourth.rx)
		Some(selected) => selected
		None => { index: 0, value: End }
	end
	let handled_first = channel_first_stream_routing_four_route_handled_route(selected_first.index, selected_first.value, { chunks: 0, ended: false })
	let selected_second = match channel_first_stream_routing_four_route_select_four_priority(first.rx, second.rx, third.rx, fourth.rx)
		Some(selected) => selected
		None => { index: 0, value: End }
	end
	let handled_second = channel_first_stream_routing_four_route_handled_route(selected_second.index, selected_second.value, { chunks: 0, ended: false })
	let selected_third = match channel_first_stream_routing_four_route_select_four_priority(first.rx, second.rx, third.rx, fourth.rx)
		Some(selected) => selected
		None => { index: 0, value: End }
	end
	let handled_third = channel_first_stream_routing_four_route_handled_route(selected_third.index, selected_third.value, { chunks: 0, ended: false })
	let selected_fourth = match channel_first_stream_routing_four_route_select_four_priority(first.rx, second.rx, third.rx, fourth.rx)
		Some(selected) => selected
		None => { index: 0, value: End }
	end
