use prelude
use fs
use io
use io_provider

pub type ReleasePlan
	pub ReleasePlan(owner: io_provider::Owner, foreign_owner: io_provider::Owner, slot: Int, state: io_provider::State<Int>, events: Sender<String>, fail_release: Bool)
end

fn retain_int(current: Int, context: ()) -> {state: Int, result: Int}
	{state: current, result: current}
end

pub fn observe_state(state: io_provider::State<Int>) -> Int effects [concurrency]
	io_provider::update(state, (), retain_int)
end

fn slot_matches(result: Result<Int, io::Error>, expected: Int) -> Bool
	match result
		Ok(actual) => actual == expected
		_ => false
	end
end

fn invalid_resource_slot(result: Result<Int, io::Error>) -> Bool
	match result
		Err(io::Error::Error(_, io::ErrorKind::InvalidResource, _, _, _, _, _)) => true
		_ => false
	end
end

fn invalid_resource_registration(result: Result<io_provider::Resource, io::Error>) -> Bool
	match result
		Err(io::Error::Error(_, io::ErrorKind::InvalidResource, _, _, _, _, _)) => true
		_ => false
	end
end

fn count_read(current: Int, context: ()) -> {state: Int, result: ()}
	{state: current + 1, result: ()}
end

pub handler read(plan: ReleasePlan) for io::Read effects [concurrency]
	read(reader, maximum) => match plan
		ReleasePlan(_, _, _, state, _, _) => begin
			let _ = io_provider::update(state, (), count_read)
			io::ReadOutcome::End
		end
	end
end

pub handler seek() for io::Seek
	seek(seeker, origin) => match byte_offset(0)
		Ok(offset) => Ok(offset)
		Err(_) => Err(io::Error::Error("seek", io::ErrorKind::Other, None, None, None, None, "could not construct zero offset"))
	end
end

pub handler read_at() for io::ReadAt
	read_at(reader, offset, maximum) => io::ReadOutcome::End
end

pub handler release(plan: ReleasePlan) for io::Close effects [concurrency]
	close(closer) => match plan
		ReleasePlan(owner, foreign_owner, slot, state, events, fail_release) => begin
			let matching = slot_matches(io_provider::closer_slot(owner, closer), slot)
			let foreign = invalid_resource_slot(io_provider::closer_slot(foreign_owner, closer))
			let registration = invalid_resource_registration(io_provider::resource(owner, slot + 1, io_provider::ViewFamily::ReadFile))
			let unchanged = observe_state(state) == 17
			let _ = channel::send(events, if matching and foreign and registration and unchanged
				"restricted-release"
			else
				"invalid-release-boundary"
			end)
			if fail_release
				io::CloseOutcome::CloseFailed(io::Commit::Unknown, io::Error::Error("close", io::ErrorKind::Other, None, None, None, Some(io::Commit::Unknown), "scripted release failure"))
			else
				io::CloseOutcome::Closed
			end
		end
	end
end

pub fn register(owner: io_provider::Owner, plan: ReleasePlan) -> Result<io_provider::Resource, io::Error> effects [concurrency]
	handle handle handle handle io_provider::resource(owner, 401, io_provider::ViewFamily::ReadFile) with read(plan) with seek() with read_at() with release(plan)
end

pub type ClosedDispatchReport
	pub ClosedDispatchReport(facade_rejected: Bool, lexical_rejected: Bool, state_unchanged: Bool)
end

type ClosedDispatchRequest
	ClosedDispatchRequest(reader: io::Reader, maximum: ByteCount, state: io_provider::State<Int>, ready: Sender<()>, start: Receiver<()>)
end

fn invalid_resource_read(outcome: io::ReadOutcome) -> Bool
	match outcome
		io::ReadOutcome::ReadFailed(bytes, io::Progress::Known(progress), io::Error::Error(_, io::ErrorKind::InvalidResource, _, _, _, _, _)) => byte_count_to_int(byte_chunk_count(bytes)) == 0 and byte_count_to_int(progress) == 0
		_ => false
	end
end

fn closed_dispatch(request: ClosedDispatchRequest) -> ClosedDispatchReport effects [io::Read, concurrency]
	match request
		ClosedDispatchRequest(reader, maximum, state, ready, start) => begin
			let _ = channel::send(ready, ())
			let _: Option<()> = channel::recv(start)
			let facade = io::read(reader, maximum)
			let lexical = perform io::Read::read(reader, maximum)
			ClosedDispatchReport(invalid_resource_read(facade), invalid_resource_read(lexical), observe_state(state) == 17)
		end
	end
end

fn register_and_spawn(owner: io_provider::Owner, plan: ReleasePlan, maximum: ByteCount, ready: Sender<()>, start: Receiver<()>) -> Result<Task<ClosedDispatchReport>, io::Error> effects [io::Read, concurrency]
	match io_provider::resource(owner, 401, io_provider::ViewFamily::ReadFile)
		Err(error) => Err(error)
		Ok(resource) => match io_provider::read_file(resource)
			Err(error) => Err(error)
			Ok(fs::ReadFile(reader, _, _, _)) => Ok(task::spawn_with<ClosedDispatchReport, ClosedDispatchRequest>(closed_dispatch, ClosedDispatchRequest(reader, maximum, match plan
					ReleasePlan(_, _, _, state, _, _) => state
				end, ready, start)))
		end
	end
end

pub fn spawn_closed_dispatch(owner: io_provider::Owner, plan: ReleasePlan, maximum: ByteCount, ready: Sender<()>, start: Receiver<()>) -> Result<Task<ClosedDispatchReport>, io::Error> effects [concurrency]
	handle handle handle handle register_and_spawn(owner, plan, maximum, ready, start) with read(plan) with seek() with read_at() with release(plan)
end
