use prelude

## A portable stream-network selection.
pub type Network
	pub Tcp
	pub Tcp4
	pub Tcp6
end

## An unresolved host and port paired with the requested network.
## The pure constructor does not resolve or validate the host or port.
pub type Address
	pub Address(network: Network, host: String, port: Int)
end

## A resolved numeric address in host-port text form.
pub type Endpoint
	pub Endpoint(network: Network, address: String)
end

## Portable network failure classifications. Pure address helpers produce
## InvalidAddress. Network handlers can return the remaining variants.
pub type NetErrorKind
	pub InvalidAddress
	pub UnsupportedNetwork
	pub NameNotFound
	pub PermissionDenied
	pub AddressInUse
	pub ConnectionRefused
	pub ConnectionReset
	pub TimedOut
	pub Cancelled
	pub Closed
	pub Busy
	pub InvalidResource
	pub Other
end

## A portable network failure with a stable operation and kind. The message is
## explanatory text and is not a stable comparison key.
pub type NetError
	pub NetError(operation: String, network: Option<Network>, address: Option<String>, kind: NetErrorKind, message: String)
end

## An opaque listening resource owned by the IO handler that created it.
pub type Listener = NetListener

## An opaque connected stream owned by the IO handler that created it.
pub type Stream = NetStream

## A non-negative byte count shared with the standard prelude.
pub type ByteCount = prelude::ByteCount

## A stream read outcome is a byte chunk or clean end-of-stream. The direct
## facade forwards the active IO handler's outcome unchanged, including an
## empty ReadChunk.
pub type ReadOutcome
	pub ReadChunk(bytes: ByteChunk)
	pub ReadEnd
end

## A stream write reports either its committed count or a committed prefix and
## an ordinary network failure.
pub type WriteOutcome
	pub Written(count: ByteCount)
	pub WriteFailed(committed: ByteCount, error: NetError)
end

## The substitutable network-operation boundary. This module does not install
## a handler implicitly.
pub effect IO
	resolve(address: Address) -> Result<List<Endpoint>, NetError>
	listen(address: Address) -> Result<Listener, NetError>
	connect(address: Address, deadline: Option<Deadline>, token: Option<CancelToken>) -> Result<Stream, NetError>
	accept(listener: Listener, deadline: Option<Deadline>, token: Option<CancelToken>) -> Result<Stream, NetError>
	listener_address(listener: Listener) -> Result<Endpoint, NetError>
	close_listener(listener: Listener) -> Result<(), NetError>
	read(stream: Stream, deadline: Option<Deadline>, token: Option<CancelToken>) -> Result<ReadOutcome, NetError>
	write(stream: Stream, bytes: ByteChunk, deadline: Option<Deadline>, token: Option<CancelToken>) -> WriteOutcome
	local_address(stream: Stream) -> Result<Endpoint, NetError>
	peer_address(stream: Stream) -> Result<Endpoint, NetError>
	shutdown_read(stream: Stream) -> Result<(), NetError>
	shutdown_write(stream: Stream) -> Result<(), NetError>
	close_stream(stream: Stream) -> Result<(), NetError>
end

## Use the host TCP implementation for the handled IO scope. Resources belong
## to this handler instance and are closed when the handled scope exits.
pub handler system() for IO effects [net, time]
	resolve(address) => prelude_builtin::net_system_resolve(address)
	listen(address) => prelude_builtin::net_system_listen(address)
	connect(address, deadline, token) => prelude_builtin::net_system_connect(address, deadline, token)
	accept(listener, deadline, token) => prelude_builtin::net_system_accept(listener, deadline, token)
	listener_address(listener) => prelude_builtin::net_system_listener_address(listener)
	close_listener(listener) => prelude_builtin::net_system_close_listener(listener)
	read(stream, deadline, token) => prelude_builtin::net_system_read(stream, deadline, token)
	write(stream, bytes, deadline, token) => prelude_builtin::net_system_write(stream, bytes, deadline, token)
	local_address(stream) => prelude_builtin::net_system_local_address(stream)
	peer_address(stream) => prelude_builtin::net_system_peer_address(stream)
	shutdown_read(stream) => prelude_builtin::net_system_shutdown_read(stream)
	shutdown_write(stream) => prelude_builtin::net_system_shutdown_write(stream)
	close_stream(stream) => prelude_builtin::net_system_close_stream(stream)
end

## Resolve an address through the active IO handler.
pub fn resolve(address: Address) -> Result<List<Endpoint>, NetError> effects [IO]
	perform IO::resolve(address)
end

## Open a listener through the active IO handler.
pub fn listen(address: Address) -> Result<Listener, NetError> effects [IO]
	perform IO::listen(address)
end

## Connect without a deadline or cancellation token.
pub fn connect(address: Address) -> Result<Stream, NetError> effects [IO]
	perform IO::connect(address, None, None)
end

## Connect with caller-supplied deadline and cancellation options.
pub fn connect_with(address: Address, deadline: Option<Deadline>, token: Option<CancelToken>) -> Result<Stream, NetError> effects [IO]
	perform IO::connect(address, deadline, token)
end

## Accept without a deadline or cancellation token.
pub fn accept(listener: Listener) -> Result<Stream, NetError> effects [IO]
	perform IO::accept(listener, None, None)
end

## Accept with caller-supplied deadline and cancellation options.
pub fn accept_with(listener: Listener, deadline: Option<Deadline>, token: Option<CancelToken>) -> Result<Stream, NetError> effects [IO]
	perform IO::accept(listener, deadline, token)
end

## Return the listener endpoint through the active IO handler.
pub fn listener_address(listener: Listener) -> Result<Endpoint, NetError> effects [IO]
	perform IO::listener_address(listener)
end

## Close a listener through the active IO handler.
pub fn close_listener(listener: Listener) -> Result<(), NetError> effects [IO]
	perform IO::close_listener(listener)
end

## Read without a deadline or cancellation token.
pub fn read(stream: Stream) -> Result<ReadOutcome, NetError> effects [IO]
	perform IO::read(stream, None, None)
end

## Read with caller-supplied deadline and cancellation options.
pub fn read_with(stream: Stream, deadline: Option<Deadline>, token: Option<CancelToken>) -> Result<ReadOutcome, NetError> effects [IO]
	perform IO::read(stream, deadline, token)
end

## Write without a deadline or cancellation token.
pub fn write(stream: Stream, bytes: ByteChunk) -> WriteOutcome effects [IO]
	perform IO::write(stream, bytes, None, None)
end

## Write with caller-supplied deadline and cancellation options.
pub fn write_with(stream: Stream, bytes: ByteChunk, deadline: Option<Deadline>, token: Option<CancelToken>) -> WriteOutcome effects [IO]
	perform IO::write(stream, bytes, deadline, token)
end

## Write the complete byte chunk through the active IO handler. Partial
## successes retry only the uncommitted suffix with the same deadline and
## cancellation token. A write failure stops the operation immediately.
pub fn write_all(stream: Stream, bytes: ByteChunk, deadline: Option<Deadline>, token: Option<CancelToken>) -> Result<(), NetError> effects [IO]
	write_all_remaining(stream, bytes, deadline, token)
end

fn write_all_remaining(stream: Stream, remaining: ByteChunk, deadline: Option<Deadline>, token: Option<CancelToken>) -> Result<(), NetError> effects [IO]
	if byte_count_to_int(byte_chunk_count(remaining)) == 0
		Ok(())
	else
		match write_all_next(remaining, perform IO::write(stream, remaining, deadline, token))
			Ok(None) => Ok(())
			Ok(Some(suffix)) => write_all_remaining(stream, suffix, deadline, token)
			Err(error) => Err(error)
		end
	end
end

fn write_all_next(remaining: ByteChunk, outcome: WriteOutcome) -> Result<Option<ByteChunk>, NetError>
	match outcome
		Written(count) => write_all_next_after_success(remaining, byte_count_to_int(byte_chunk_count(remaining)), count)
		WriteFailed(_, error) => Err(error)
	end
end

fn write_all_next_after_success(remaining: ByteChunk, remaining_count: Int, count: ByteCount) -> Result<Option<ByteChunk>, NetError>
	let committed = byte_count_to_int(count)
	if committed == remaining_count
		Ok(None)
	else if committed == 0
		Err(write_all_progress_error("write returned zero before the input was complete"))
	else if committed > remaining_count
		Err(write_all_progress_error("write returned a count larger than its input"))
	else
		match byte_drop(remaining, count)
			Ok(suffix) => Ok(Some(suffix))
			Err(message) => Err(write_all_progress_error(message))
		end
	end
end

fn write_all_progress_error(message: String) -> NetError
	NetError("write_all", None, None, Other, message)
end

## Return the local stream endpoint through the active IO handler.
pub fn local_address(stream: Stream) -> Result<Endpoint, NetError> effects [IO]
	perform IO::local_address(stream)
end

## Return the peer stream endpoint through the active IO handler.
pub fn peer_address(stream: Stream) -> Result<Endpoint, NetError> effects [IO]
	perform IO::peer_address(stream)
end

## Shut down the stream read half through the active IO handler.
pub fn shutdown_read(stream: Stream) -> Result<(), NetError> effects [IO]
	perform IO::shutdown_read(stream)
end

## Shut down the stream write half through the active IO handler.
pub fn shutdown_write(stream: Stream) -> Result<(), NetError> effects [IO]
	perform IO::shutdown_write(stream)
end

## Close a stream through the active IO handler.
pub fn close_stream(stream: Stream) -> Result<(), NetError> effects [IO]
	perform IO::close_stream(stream)
end

## Format a host and port without resolving the host. Hosts containing a colon
## are bracketed. Ports outside the inclusive 0..65535 range are rejected.
pub fn join_host_port(host: String, port: Int) -> Result<String, NetError>
	if port < 0
		Err(invalid_address("join_host_port", host, "port must be between 0 and 65535"))
	else if port > 65535
		Err(invalid_address("join_host_port", host, "port must be between 0 and 65535"))
	else
		join_valid_host_port(host, port)
	end
end

fn join_valid_host_port(host: String, port: Int) -> Result<String, NetError>
	let suffix = string::concat(":", int_to_string(port))
	match string_split_once(host, ":")
		Some(_) => Ok(string::concat(string::concat("[", host), string::concat("]", suffix)))
		None => Ok(string::concat(host, suffix))
	end
end

## Split host-port text without resolving the host. Bracketed IPv6 is accepted.
## Unbracketed text containing more than one colon is ambiguous and rejected.
pub fn split_host_port(address: String) -> Result<{ host : String, port : Int }, NetError>
	match string_split_once(address, "[")
		Some(open) => split_bracketed_host_port(address, open.left, open.right)
		None => split_unbracketed_host_port(address)
	end
end

fn split_bracketed_host_port(address: String, prefix: String, remainder: String) -> Result<{ host : String, port : Int }, NetError>
	if prefix != ""
		Err(invalid_address("split_host_port", address, "opening bracket must begin the address"))
	else
		match string_split_once(remainder, "]:")
			Some(parts) => parse_host_port(address, parts.left, parts.right)
			None => Err(invalid_address("split_host_port", address, "bracketed host must be followed by one port"))
		end
	end
end

fn split_unbracketed_host_port(address: String) -> Result<{ host : String, port : Int }, NetError>
	match string_split_once(address, ":")
		Some(parts) => match string_split_once(parts.right, ":")
			Some(_) => Err(invalid_address("split_host_port", address, "IPv6 hosts must be bracketed"))
			None => parse_host_port(address, parts.left, parts.right)
		end
		None => Err(invalid_address("split_host_port", address, "address must contain one port"))
	end
end

fn parse_host_port(address: String, host: String, port_text: String) -> Result<{ host : String, port : Int }, NetError>
	match string_parse_int(port_text)
		Ok(port) => if port < 0
			Err(invalid_address("split_host_port", address, "port must be between 0 and 65535"))
		else if port > 65535
			Err(invalid_address("split_host_port", address, "port must be between 0 and 65535"))
		else
			Ok({ host: host, port: port })
		end
		Err(_) => Err(invalid_address("split_host_port", address, "port must be one decimal integer"))
	end
end

fn invalid_address(operation: String, address: String, message: String) -> NetError
	NetError(operation, None, Some(address), InvalidAddress, message)
end
