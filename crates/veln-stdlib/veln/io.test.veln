test zero_complete_transfers_reject_closed_resources() -> Result<(), String> effects [io::Read, io::Write, concurrency]
	match io_complete_transfer_test::closed_zero_read()?
		io::ExactOutcome::ExactFailed(bytes, io::Progress::Known(consumed), io::Error::Error("read_exact", io::ErrorKind::InvalidResource, _, _, _, _, _)) => match io_complete_transfer_test::closed_zero_write()?
			io::WriteOutcome::WriteFailed(io::Progress::Known(committed), io::Error::Error("write_all", io::ErrorKind::InvalidResource, _, _, _, _, _)) => if byte_count_to_int(byte_chunk_count(bytes)) == 0 and byte_count_to_int(consumed) == 0 and byte_count_to_int(committed) == 0
				Ok(())
			else
				Err("closed zero-size helper fabricated progress")
			end
			_ => Err("zero write_all did not validate the closed writer")
		end
		_ => Err("zero read_exact did not validate the closed reader")
	end
end

