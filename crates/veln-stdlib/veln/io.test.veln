use prelude
use io
use io_provider
use io_complete_transfer_test
use io_direct_validation_test

fn provider_error(message: String) -> io::Error
	io::Error::Error("scripted", io::ErrorKind::Other, None, None, None, None, message)
end

fn exact(script: io_complete_transfer_test::Script, count: ByteCount) -> Result<io_complete_transfer_test::ExactObservation, String> effects [concurrency]
	handle io_complete_transfer_test::execute_exact(script, count) with io_provider::scope()
end

fn write(script: io_complete_transfer_test::Script, bytes: ByteChunk) -> Result<io_complete_transfer_test::WriteObservation, String> effects [concurrency]
	handle io_complete_transfer_test::execute_write(script, bytes) with io_provider::scope()
end

fn direct_read(reads: List<io::ReadOutcome>, maximum: ByteCount) -> Result<io_complete_transfer_test::DirectReadObservation, String> effects [concurrency]
	handle io_complete_transfer_test::execute_direct_read(reads, maximum) with io_provider::scope()
end

fn direct_write(writes: List<io::WriteOutcome>, bytes: ByteChunk) -> Result<io_complete_transfer_test::DirectWriteObservation, String> effects [concurrency]
	handle io_complete_transfer_test::execute_direct_write(writes, bytes) with io_provider::scope()
end

fn validated_read(reads: List<io::ReadOutcome>, maximum: ByteCount) -> Result<io_direct_validation_test::ReadObservation, String> effects [concurrency]
	handle io_direct_validation_test::execute_read(reads, maximum) with io_provider::scope()
end

fn validated_write(writes: List<io::WriteOutcome>, bytes: ByteChunk) -> Result<io_direct_validation_test::WriteObservation, String> effects [concurrency]
	handle io_direct_validation_test::execute_write(writes, bytes) with io_provider::scope()
end

fn validated_read_at(reads: List<io::ReadOutcome>, maximum: ByteCount) -> Result<io_direct_validation_test::ReadObservation, String> effects [concurrency]
	handle io_direct_validation_test::execute_read_at(reads, maximum) with io_provider::scope()
end

fn validated_write_at(writes: List<io::WriteOutcome>, bytes: ByteChunk) -> Result<io_direct_validation_test::WriteObservation, String> effects [concurrency]
	handle io_direct_validation_test::execute_write_at(writes, bytes) with io_provider::scope()
end

fn chunk_is(bytes: ByteChunk, expected: String) -> Bool
	match byte_chunk_to_visible_ascii_string(bytes)
		Ok(actual) => actual == expected
		Err(_) => false
	end
end

fn inputs_are_three(inputs: List<ByteChunk>, first: String, second: String, third: String) -> Bool
	match inputs
		Cons(first_bytes, Cons(second_bytes, Cons(third_bytes, Nil))) => chunk_is(first_bytes, first) and chunk_is(second_bytes, second) and chunk_is(third_bytes, third)
		_ => false
	end
end

fn inputs_are_two(inputs: List<ByteChunk>, first: String, second: String) -> Bool
	match inputs
		Cons(first_bytes, Cons(second_bytes, Nil)) => chunk_is(first_bytes, first) and chunk_is(second_bytes, second)
		_ => false
	end
end

test direct_empty_requests_validate_and_bypass_live_provider() -> Result<(), String> effects [concurrency]
	let read_result = direct_read(list_cons(io::ReadOutcome::End, list_nil()), byte_count(0)?)?
	let write_result = direct_write(list_cons(io::WriteOutcome::Written(byte_count(1)?), list_nil()), byte_chunk([]))?
	match read_result
		io_complete_transfer_test::DirectReadObservation(io::ReadOutcome::Data(bytes), io_complete_transfer_test::DirectSnapshot(Nil, Nil, Nil, Cons(io::ReadOutcome::End, Nil), Nil)) => if byte_count_to_int(byte_chunk_count(bytes)) == 0
			match write_result
				io_complete_transfer_test::DirectWriteObservation(io::WriteOutcome::Written(count), io_complete_transfer_test::DirectSnapshot(Nil, Nil, Nil, Nil, Cons(io::WriteOutcome::Written(remaining), Nil))) => if byte_count_to_int(count) == 0 and byte_count_to_int(remaining) == 1
					Ok(())
				else
					Err("empty direct write changed progress or its provider script")
				end
				_ => Err("empty direct write invoked its provider")
			end
		else
			Err("empty direct read returned nonempty data")
		end
		_ => Err("empty direct read invoked its provider")
	end
end

test direct_empty_requests_reject_closed_resources_without_provider_invocation() -> Result<(), String> effects [io::Read, io::Write, concurrency]
	let read_result = io_complete_transfer_test::closed_direct_read()?
	let write_result = io_complete_transfer_test::closed_direct_write()?
	match read_result
		io_complete_transfer_test::DirectReadObservation(io::ReadOutcome::ReadFailed(bytes, io::Progress::Known(consumed), io::Error::Error("read", io::ErrorKind::InvalidResource, _, _, _, _, _)), io_complete_transfer_test::DirectSnapshot(Nil, Nil, Nil, Nil, Nil)) => if byte_count_to_int(byte_chunk_count(bytes)) == 0 and byte_count_to_int(consumed) == 0
			match write_result
				io_complete_transfer_test::DirectWriteObservation(io::WriteOutcome::WriteFailed(io::Progress::Known(committed), io::Error::Error("write", io::ErrorKind::InvalidResource, _, _, _, _, _)), io_complete_transfer_test::DirectSnapshot(Nil, Nil, Nil, Nil, Nil)) => if byte_count_to_int(committed) == 0
					Ok(())
				else
					Err("closed empty direct write fabricated progress")
				end
				_ => Err("closed empty direct write invoked its provider or returned the wrong error")
			end
		else
			Err("closed empty direct read fabricated bytes or progress")
		end
		_ => Err("closed empty direct read invoked its provider or returned the wrong error")
	end
end

test direct_read_normalizes_empty_success_without_retry() -> Result<(), String> effects [concurrency]
	let reads = list_cons(io::ReadOutcome::Data(byte_chunk([])), list_cons(io::ReadOutcome::End, list_nil()))
	match direct_read(reads, byte_count(4)?)?
		io_complete_transfer_test::DirectReadObservation(io::ReadOutcome::ReadFailed(bytes, io::Progress::Known(consumed), io::Error::Error("read", io::ErrorKind::NoProgress, None, None, None, None, _)), io_complete_transfer_test::DirectSnapshot(Cons("read", Nil), Cons(4, Nil), Nil, Cons(io::ReadOutcome::End, Nil), Nil)) => if byte_count_to_int(byte_chunk_count(bytes)) == 0 and byte_count_to_int(consumed) == 0
			Ok(())
		else
			Err("direct empty read fabricated bytes or progress")
		end
		_ => Err("direct empty read did not return NoProgress after one provider dispatch")
	end
end

test direct_write_normalizes_zero_success_without_retry() -> Result<(), String> effects [concurrency]
	let writes = list_cons(io::WriteOutcome::Written(byte_count(0)?), list_cons(io::WriteOutcome::Written(byte_count(1)?), list_nil()))
	match direct_write(writes, byte_chunk_from_visible_ascii_string("abc")?)?
		io_complete_transfer_test::DirectWriteObservation(io::WriteOutcome::WriteFailed(io::Progress::Known(committed), io::Error::Error("write", io::ErrorKind::NoProgress, None, None, None, None, _)), io_complete_transfer_test::DirectSnapshot(Cons("write", Nil), Nil, Cons(input, Nil), Nil, Cons(io::WriteOutcome::Written(remaining), Nil))) => if byte_count_to_int(committed) == 0 and byte_count_to_int(remaining) == 1 and chunk_is(input, "abc")
			Ok(())
		else
			Err("direct zero write changed the input, remaining script, or progress")
		end
		_ => Err("direct zero write did not return NoProgress after one provider dispatch")
	end
end

test direct_read_preserves_end_short_data_and_provider_failure() -> Result<(), String> effects [concurrency]
	let end_result = direct_read(list_cons(io::ReadOutcome::End, list_nil()), byte_count(3)?)?
	let data_result = direct_read(list_cons(io::ReadOutcome::Data(byte_chunk_from_visible_ascii_string("ab")?), list_nil()), byte_count(3)?)?
	let failure = provider_error("direct read failure")
	let failed_result = direct_read(list_cons(io::ReadOutcome::ReadFailed(byte_chunk_from_visible_ascii_string("x")?, io::Progress::Unknown(byte_count(1)?), failure), list_nil()), byte_count(3)?)?
	match end_result
		io_complete_transfer_test::DirectReadObservation(io::ReadOutcome::End, _) => match data_result
			io_complete_transfer_test::DirectReadObservation(io::ReadOutcome::Data(bytes), _) => match failed_result
				io_complete_transfer_test::DirectReadObservation(io::ReadOutcome::ReadFailed(failed_bytes, io::Progress::Unknown(consumed), io::Error::Error("scripted", io::ErrorKind::Other, None, None, None, None, "direct read failure")), _) => if chunk_is(bytes, "ab") and chunk_is(failed_bytes, "x") and byte_count_to_int(consumed) == 1
					Ok(())
				else
					Err("direct read changed short data or typed failure details")
				end
				_ => Err("direct read changed the provider failure shape")
			end
			_ => Err("direct read changed nonempty short data")
		end
		_ => Err("direct read changed End")
	end
end

test direct_write_preserves_partial_success_and_provider_failure() -> Result<(), String> effects [concurrency]
	let partial_result = direct_write(list_cons(io::WriteOutcome::Written(byte_count(2)?), list_nil()), byte_chunk_from_visible_ascii_string("abc")?)?
	let failure = provider_error("direct write failure")
	let failed_result = direct_write(list_cons(io::WriteOutcome::WriteFailed(io::Progress::Unknown(byte_count(1)?), failure), list_nil()), byte_chunk_from_visible_ascii_string("abc")?)?
	match partial_result
		io_complete_transfer_test::DirectWriteObservation(io::WriteOutcome::Written(count), _) => if byte_count_to_int(count) == 2
			match failed_result
				io_complete_transfer_test::DirectWriteObservation(io::WriteOutcome::WriteFailed(io::Progress::Unknown(committed), io::Error::Error("scripted", io::ErrorKind::Other, None, None, None, None, "direct write failure")), _) => if byte_count_to_int(committed) == 1
					Ok(())
				else
					Err("direct write changed provider failure progress")
				end
				_ => Err("direct write changed the provider failure shape")
			end
		else
			Err("direct write changed positive partial progress")
		end
		_ => Err("direct write changed positive partial success")
	end
end

test direct_reads_reject_negative_maximum_before_provider_dispatch() -> Result<(), String> effects [concurrency]
	let reply = io::ReadOutcome::End
	let sequential = validated_read(list_cons(reply, list_nil()), ByteCount(-1))?
	let positional = validated_read_at(list_cons(reply, list_nil()), ByteCount(-1))?
	match sequential
		io_direct_validation_test::ReadObservation(io::ReadOutcome::ReadFailed(bytes, io::Progress::Known(progress), io::Error::Error("read", io::ErrorKind::InvalidInput, _, _, _, _, _)), io_direct_validation_test::Snapshot(Nil, Cons(io::ReadOutcome::End, Nil), Nil, Nil, Nil)) => if byte_count_to_int(byte_chunk_count(bytes)) == 0 and byte_count_to_int(progress) == 0
			match positional
				io_direct_validation_test::ReadObservation(io::ReadOutcome::ReadFailed(positional_bytes, io::Progress::Known(positional_progress), io::Error::Error("read_at", io::ErrorKind::InvalidInput, _, _, _, _, _)), io_direct_validation_test::Snapshot(Nil, Nil, Nil, Cons(io::ReadOutcome::End, Nil), Nil)) => if byte_count_to_int(byte_chunk_count(positional_bytes)) == 0 and byte_count_to_int(positional_progress) == 0
					Ok(())
				else
					Err("negative positional read fabricated bytes or progress")
				end
				_ => Err("negative positional read reached its provider or returned the wrong failure")
			end
		else
			Err("negative sequential read fabricated bytes or progress")
		end
		_ => Err("negative sequential read reached its provider or returned the wrong failure")
	end
end

test direct_facades_preserve_success_at_submitted_bounds() -> Result<(), String> effects [concurrency]
	let bytes = byte_chunk_from_visible_ascii_string("ab")?
	let sequential_read = validated_read(list_cons(io::ReadOutcome::Data(bytes), list_nil()), byte_count(2)?)?
	let positional_read = validated_read_at(list_cons(io::ReadOutcome::Data(bytes), list_nil()), byte_count(2)?)?
	let sequential_write = validated_write(list_cons(io::WriteOutcome::Written(byte_count(2)?), list_nil()), bytes)?
	let positional_write = validated_write_at(list_cons(io::WriteOutcome::Written(byte_count(2)?), list_nil()), bytes)?
	match sequential_read
		io_direct_validation_test::ReadObservation(io::ReadOutcome::Data(read_bytes), io_direct_validation_test::Snapshot(Cons("read", Nil), Nil, Nil, Nil, Nil)) => if chunk_is(read_bytes, "ab")
			match positional_read
				io_direct_validation_test::ReadObservation(io::ReadOutcome::Data(read_at_bytes), io_direct_validation_test::Snapshot(Cons("read_at", Nil), Nil, Nil, Nil, Nil)) => if chunk_is(read_at_bytes, "ab")
					match sequential_write
						io_direct_validation_test::WriteObservation(io::WriteOutcome::Written(written), io_direct_validation_test::Snapshot(Cons("write", Nil), Nil, Nil, Nil, Nil)) => if byte_count_to_int(written) == 2
							match positional_write
								io_direct_validation_test::WriteObservation(io::WriteOutcome::Written(written_at), io_direct_validation_test::Snapshot(Cons("write_at", Nil), Nil, Nil, Nil, Nil)) => if byte_count_to_int(written_at) == 2
									Ok(())
								else
									Err("boundary write_at changed its count")
								end
								_ => Err("boundary write_at was not dispatched exactly once")
							end
						else
							Err("boundary write changed its count")
						end
						_ => Err("boundary write was not dispatched exactly once")
					end
				else
					Err("boundary read_at changed its bytes")
				end
				_ => Err("boundary read_at was not dispatched exactly once")
			end
		else
			Err("boundary read changed its bytes")
		end
		_ => Err("boundary read was not dispatched exactly once")
	end
end

test direct_positional_facades_preserve_zero_success_at_submitted_bounds() -> Result<(), String> effects [concurrency]
	let empty = byte_chunk([])
	let positional_read = validated_read_at(list_cons(io::ReadOutcome::Data(empty), list_nil()), byte_chunk_count(empty))?
	let positional_write = validated_write_at(list_cons(io::WriteOutcome::Written(byte_chunk_count(empty)), list_nil()), empty)?
	match positional_read
		io_direct_validation_test::ReadObservation(io::ReadOutcome::Data(read_bytes), io_direct_validation_test::Snapshot(Cons("read_at", Nil), Nil, Nil, Nil, Nil)) => if byte_count_to_int(byte_chunk_count(read_bytes)) == 0
			match positional_write
				io_direct_validation_test::WriteObservation(io::WriteOutcome::Written(written), io_direct_validation_test::Snapshot(Cons("write_at", Nil), Nil, Nil, Nil, Nil)) => if byte_count_to_int(written) == 0
					Ok(())
				else
					Err("zero-boundary write_at changed its count")
				end
				_ => Err("zero-boundary write_at was not dispatched exactly once")
			end
		else
			Err("zero-boundary read_at changed its bytes")
		end
		_ => Err("zero-boundary read_at was not dispatched exactly once")
	end
end

test direct_positional_facades_preserve_zero_success_for_positive_requests() -> Result<(), String> effects [concurrency]
	let empty = byte_chunk([])
	let input = byte_chunk_from_visible_ascii_string("ab")?
	let positional_read = validated_read_at(list_cons(io::ReadOutcome::Data(empty), list_nil()), byte_count(2)?)?
	let positional_write = validated_write_at(list_cons(io::WriteOutcome::Written(byte_count(0)?), list_nil()), input)?
	match positional_read
		io_direct_validation_test::ReadObservation(io::ReadOutcome::Data(read_bytes), io_direct_validation_test::Snapshot(Cons("read_at", Nil), Nil, Nil, Nil, Nil)) => if byte_count_to_int(byte_chunk_count(read_bytes)) == 0
			match positional_write
				io_direct_validation_test::WriteObservation(io::WriteOutcome::Written(written), io_direct_validation_test::Snapshot(Cons("write_at", Nil), Nil, Nil, Nil, Nil)) => if byte_count_to_int(written) == 0
					Ok(())
				else
					Err("positive-request write_at changed its zero count")
				end
				_ => Err("positive-request write_at normalized zero success or did not dispatch exactly once")
			end
		else
			Err("positive-request read_at changed its empty bytes")
		end
		_ => Err("positive-request read_at normalized empty success or did not dispatch exactly once")
	end
end

test direct_reads_reject_failure_payloads_beyond_submitted_bound() -> Result<(), String> effects [concurrency]
	let oversized = byte_chunk_from_visible_ascii_string("abc")?
	let failure = provider_error("oversized failure payload")
	let reply = io::ReadOutcome::ReadFailed(oversized, io::Progress::Known(byte_count(3)?), failure)
	let sequential = validated_read(list_cons(reply, list_nil()), byte_count(2)?)?
	let positional = validated_read_at(list_cons(reply, list_nil()), byte_count(2)?)?
	match sequential
		io_direct_validation_test::ReadObservation(io::ReadOutcome::ReadFailed(bytes, io::Progress::Unknown(progress), io::Error::Error("read", io::ErrorKind::InvalidResource, _, _, _, _, _)), io_direct_validation_test::Snapshot(Cons("read", Nil), Nil, Nil, Nil, Nil)) => if byte_count_to_int(byte_chunk_count(bytes)) == 0 and byte_count_to_int(progress) == 0
			match positional
				io_direct_validation_test::ReadObservation(io::ReadOutcome::ReadFailed(positional_bytes, io::Progress::Unknown(positional_progress), io::Error::Error("read_at", io::ErrorKind::InvalidResource, _, _, _, _, _)), io_direct_validation_test::Snapshot(Cons("read_at", Nil), Nil, Nil, Nil, Nil)) => if byte_count_to_int(byte_chunk_count(positional_bytes)) == 0 and byte_count_to_int(positional_progress) == 0
					Ok(())
				else
					Err("oversized positional failure payload fabricated bytes or progress")
				end
				_ => Err("oversized positional failure payload was trusted or retried")
			end
		else
			Err("oversized sequential failure payload fabricated bytes or progress")
		end
		_ => Err("oversized sequential failure payload was trusted or retried")
	end
end

test direct_facades_reject_malformed_success_without_retry() -> Result<(), String> effects [concurrency]
	let oversized = byte_chunk_from_visible_ascii_string("abc")?
	let input = byte_chunk_from_visible_ascii_string("ab")?
	let sequential_read = validated_read(list_cons(io::ReadOutcome::Data(oversized), list_cons(io::ReadOutcome::End, list_nil())), byte_count(2)?)?
	let positional_read = validated_read_at(list_cons(io::ReadOutcome::Data(oversized), list_cons(io::ReadOutcome::End, list_nil())), byte_count(2)?)?
	let sequential_write = validated_write(list_cons(io::WriteOutcome::Written(ByteCount(-1)), list_cons(io::WriteOutcome::Written(byte_count(2)?), list_nil())), input)?
	let positional_write = validated_write_at(list_cons(io::WriteOutcome::Written(byte_count(3)?), list_cons(io::WriteOutcome::Written(byte_count(2)?), list_nil())), input)?
	match sequential_read
		io_direct_validation_test::ReadObservation(io::ReadOutcome::ReadFailed(bytes, io::Progress::Unknown(progress), io::Error::Error("read", io::ErrorKind::InvalidResource, _, _, _, _, _)), io_direct_validation_test::Snapshot(Cons("read", Nil), Cons(io::ReadOutcome::End, Nil), Nil, Nil, Nil)) => if byte_count_to_int(byte_chunk_count(bytes)) == 0 and byte_count_to_int(progress) == 0
			match positional_read
				io_direct_validation_test::ReadObservation(io::ReadOutcome::ReadFailed(read_at_bytes, io::Progress::Unknown(read_at_progress), io::Error::Error("read_at", io::ErrorKind::InvalidResource, _, _, _, _, _)), io_direct_validation_test::Snapshot(Cons("read_at", Nil), Nil, Nil, Cons(io::ReadOutcome::End, Nil), Nil)) => if byte_count_to_int(byte_chunk_count(read_at_bytes)) == 0 and byte_count_to_int(read_at_progress) == 0
					match sequential_write
						io_direct_validation_test::WriteObservation(io::WriteOutcome::WriteFailed(io::Progress::Unknown(written), io::Error::Error("write", io::ErrorKind::InvalidResource, _, _, _, _, _)), io_direct_validation_test::Snapshot(Cons("write", Nil), Nil, Cons(io::WriteOutcome::Written(_), Nil), Nil, Nil)) => if byte_count_to_int(written) == 0
							match positional_write
								io_direct_validation_test::WriteObservation(io::WriteOutcome::WriteFailed(io::Progress::Unknown(written_at), io::Error::Error("write_at", io::ErrorKind::InvalidResource, _, _, _, _, _)), io_direct_validation_test::Snapshot(Cons("write_at", Nil), Nil, Nil, Nil, Cons(io::WriteOutcome::Written(_), Nil))) => if byte_count_to_int(written_at) == 0
									Ok(())
								else
									Err("malformed write_at fabricated progress")
								end
								_ => Err("malformed write_at was trusted or retried")
							end
						else
							Err("malformed write fabricated progress")
						end
						_ => Err("malformed write was trusted or retried")
					end
				else
					Err("malformed read_at fabricated bytes or progress")
				end
				_ => Err("malformed read_at was trusted or retried")
			end
		else
			Err("malformed read fabricated bytes or progress")
		end
		_ => Err("malformed read was trusted or retried")
	end
end

test direct_facades_reject_malformed_known_failures() -> Result<(), String> effects [concurrency]
	let input = byte_chunk_from_visible_ascii_string("ab")?
	let failure = provider_error("malformed known failure")
	let sequential_read = validated_read(list_cons(io::ReadOutcome::ReadFailed(input, io::Progress::Known(byte_count(1)?), failure), list_nil()), byte_count(2)?)?
	let positional_read = validated_read_at(list_cons(io::ReadOutcome::ReadFailed(byte_chunk_from_visible_ascii_string("a")?, io::Progress::Known(byte_count(3)?), failure), list_nil()), byte_count(2)?)?
	let sequential_write = validated_write(list_cons(io::WriteOutcome::WriteFailed(io::Progress::Known(ByteCount(-1)), failure), list_nil()), input)?
	let positional_write = validated_write_at(list_cons(io::WriteOutcome::WriteFailed(io::Progress::Known(byte_count(3)?), failure), list_nil()), input)?
	match sequential_read
		io_direct_validation_test::ReadObservation(io::ReadOutcome::ReadFailed(bytes, io::Progress::Unknown(progress), io::Error::Error("read", io::ErrorKind::InvalidResource, _, _, _, _, _)), io_direct_validation_test::Snapshot(Cons("read", Nil), Nil, Nil, Nil, Nil)) => if byte_count_to_int(byte_chunk_count(bytes)) == 0 and byte_count_to_int(progress) == 0
			match positional_read
				io_direct_validation_test::ReadObservation(io::ReadOutcome::ReadFailed(read_at_bytes, io::Progress::Unknown(read_at_progress), io::Error::Error("read_at", io::ErrorKind::InvalidResource, _, _, _, _, _)), io_direct_validation_test::Snapshot(Cons("read_at", Nil), Nil, Nil, Nil, Nil)) => if byte_count_to_int(byte_chunk_count(read_at_bytes)) == 0 and byte_count_to_int(read_at_progress) == 0
					match sequential_write
						io_direct_validation_test::WriteObservation(io::WriteOutcome::WriteFailed(io::Progress::Unknown(written), io::Error::Error("write", io::ErrorKind::InvalidResource, _, _, _, _, _)), io_direct_validation_test::Snapshot(Cons("write", Nil), Nil, Nil, Nil, Nil)) => if byte_count_to_int(written) == 0
							match positional_write
								io_direct_validation_test::WriteObservation(io::WriteOutcome::WriteFailed(io::Progress::Unknown(written_at), io::Error::Error("write_at", io::ErrorKind::InvalidResource, _, _, _, _, _)), io_direct_validation_test::Snapshot(Cons("write_at", Nil), Nil, Nil, Nil, Nil)) => if byte_count_to_int(written_at) == 0
									Ok(())
								else
									Err("malformed known write_at fabricated progress")
								end
								_ => Err("malformed known write_at retained its provider failure")
							end
						else
							Err("malformed known write fabricated progress")
						end
						_ => Err("malformed known write retained its provider failure")
					end
				else
					Err("malformed known read_at fabricated progress")
				end
				_ => Err("malformed known read_at retained its provider failure")
			end
		else
			Err("malformed known read fabricated bytes or progress")
		end
		_ => Err("malformed known read retained its provider failure")
	end
end

test direct_facades_reject_malformed_unknown_failures() -> Result<(), String> effects [concurrency]
	let input = byte_chunk_from_visible_ascii_string("ab")?
	let failure = provider_error("malformed unknown failure")
	let sequential_read = validated_read(list_cons(io::ReadOutcome::ReadFailed(input, io::Progress::Unknown(byte_count(1)?), failure), list_nil()), byte_count(2)?)?
	let positional_read = validated_read_at(list_cons(io::ReadOutcome::ReadFailed(byte_chunk_from_visible_ascii_string("a")?, io::Progress::Unknown(byte_count(3)?), failure), list_nil()), byte_count(2)?)?
	let sequential_write = validated_write(list_cons(io::WriteOutcome::WriteFailed(io::Progress::Unknown(ByteCount(-1)), failure), list_nil()), input)?
	let positional_write = validated_write_at(list_cons(io::WriteOutcome::WriteFailed(io::Progress::Unknown(byte_count(3)?), failure), list_nil()), input)?
	match sequential_read
		io_direct_validation_test::ReadObservation(io::ReadOutcome::ReadFailed(bytes, io::Progress::Unknown(progress), io::Error::Error("read", io::ErrorKind::InvalidResource, _, _, _, _, _)), io_direct_validation_test::Snapshot(Cons("read", Nil), Nil, Nil, Nil, Nil)) => if byte_count_to_int(byte_chunk_count(bytes)) == 0 and byte_count_to_int(progress) == 0
			match positional_read
				io_direct_validation_test::ReadObservation(io::ReadOutcome::ReadFailed(read_at_bytes, io::Progress::Unknown(read_at_progress), io::Error::Error("read_at", io::ErrorKind::InvalidResource, _, _, _, _, _)), io_direct_validation_test::Snapshot(Cons("read_at", Nil), Nil, Nil, Nil, Nil)) => if byte_count_to_int(byte_chunk_count(read_at_bytes)) == 0 and byte_count_to_int(read_at_progress) == 0
					match sequential_write
						io_direct_validation_test::WriteObservation(io::WriteOutcome::WriteFailed(io::Progress::Unknown(written), io::Error::Error("write", io::ErrorKind::InvalidResource, _, _, _, _, _)), io_direct_validation_test::Snapshot(Cons("write", Nil), Nil, Nil, Nil, Nil)) => if byte_count_to_int(written) == 0
							match positional_write
								io_direct_validation_test::WriteObservation(io::WriteOutcome::WriteFailed(io::Progress::Unknown(written_at), io::Error::Error("write_at", io::ErrorKind::InvalidResource, _, _, _, _, _)), io_direct_validation_test::Snapshot(Cons("write_at", Nil), Nil, Nil, Nil, Nil)) => if byte_count_to_int(written_at) == 0
									Ok(())
								else
									Err("malformed unknown write_at fabricated progress")
								end
								_ => Err("malformed unknown write_at retained its provider failure")
							end
						else
							Err("malformed unknown write fabricated progress")
						end
						_ => Err("malformed unknown write retained its provider failure")
					end
				else
					Err("malformed unknown read_at fabricated progress")
				end
				_ => Err("malformed unknown read_at retained its provider failure")
			end
		else
			Err("malformed unknown read fabricated progress")
		end
		_ => Err("malformed unknown read retained its provider failure")
	end
end

test direct_facades_preserve_valid_failure_boundaries() -> Result<(), String> effects [concurrency]
	let input = byte_chunk_from_visible_ascii_string("ab")?
	let delivered = byte_chunk_from_visible_ascii_string("a")?
	let failure = provider_error("valid boundary failure")
	let sequential_read = validated_read(list_cons(io::ReadOutcome::ReadFailed(delivered, io::Progress::Known(byte_count(2)?), failure), list_nil()), byte_count(2)?)?
	let positional_read = validated_read_at(list_cons(io::ReadOutcome::ReadFailed(delivered, io::Progress::Unknown(byte_count(2)?), failure), list_nil()), byte_count(2)?)?
	let sequential_write = validated_write(list_cons(io::WriteOutcome::WriteFailed(io::Progress::Known(byte_count(2)?), failure), list_nil()), input)?
	let positional_write = validated_write_at(list_cons(io::WriteOutcome::WriteFailed(io::Progress::Unknown(byte_count(2)?), failure), list_nil()), input)?
	match sequential_read
		io_direct_validation_test::ReadObservation(io::ReadOutcome::ReadFailed(bytes, io::Progress::Known(progress), io::Error::Error("scripted", io::ErrorKind::Other, _, _, _, _, "valid boundary failure")), io_direct_validation_test::Snapshot(Cons("read", Nil), Nil, Nil, Nil, Nil)) => if chunk_is(bytes, "a") and byte_count_to_int(progress) == 2
			match positional_read
				io_direct_validation_test::ReadObservation(io::ReadOutcome::ReadFailed(read_at_bytes, io::Progress::Unknown(read_at_progress), io::Error::Error("scripted", io::ErrorKind::Other, _, _, _, _, "valid boundary failure")), io_direct_validation_test::Snapshot(Cons("read_at", Nil), Nil, Nil, Nil, Nil)) => if chunk_is(read_at_bytes, "a") and byte_count_to_int(read_at_progress) == 2
					match sequential_write
						io_direct_validation_test::WriteObservation(io::WriteOutcome::WriteFailed(io::Progress::Known(written), io::Error::Error("scripted", io::ErrorKind::Other, _, _, _, _, "valid boundary failure")), io_direct_validation_test::Snapshot(Cons("write", Nil), Nil, Nil, Nil, Nil)) => if byte_count_to_int(written) == 2
							match positional_write
								io_direct_validation_test::WriteObservation(io::WriteOutcome::WriteFailed(io::Progress::Unknown(written_at), io::Error::Error("scripted", io::ErrorKind::Other, _, _, _, _, "valid boundary failure")), io_direct_validation_test::Snapshot(Cons("write_at", Nil), Nil, Nil, Nil, Nil)) => if byte_count_to_int(written_at) == 2
									Ok(())
								else
									Err("valid write_at failure changed its progress")
								end
								_ => Err("valid write_at failure changed its provider error or dispatch count")
							end
						else
							Err("valid write failure changed its progress")
						end
						_ => Err("valid write failure changed its provider error or dispatch count")
					end
				else
					Err("valid read_at failure changed bytes or progress")
				end
				_ => Err("valid read_at failure changed its provider error or dispatch count")
			end
		else
			Err("valid read failure changed bytes or progress")
		end
		_ => Err("valid read failure changed its provider error or dispatch count")
	end
end

test read_exact_accumulates_short_reads_to_completion() -> Result<(), String> effects [concurrency]
	let reads = list_cons(io::ReadOutcome::Data(byte_chunk_from_visible_ascii_string("ab")?), list_cons(io::ReadOutcome::Data(byte_chunk_from_visible_ascii_string("cde")?), list_cons(io::ReadOutcome::End, list_nil())))
	let script = io_complete_transfer_test::Script(reads, list_nil())
	match exact(script, byte_count(5)?)?
		io_complete_transfer_test::ExactObservation(io::ExactOutcome::Complete(bytes), io_complete_transfer_test::Snapshot(Cons(3, Cons(5, Nil)), Nil, Cons(io::ReadOutcome::End, Nil), Nil)) => if chunk_is(bytes, "abcde")
			Ok(())
		else
			Err("read_exact completion changed the accumulated bytes")
		end
		_ => Err("read_exact did not request only the remaining count across short reads")
	end
end

test read_exact_returns_short_on_clean_end() -> Result<(), String> effects [concurrency]
	let reads = list_cons(io::ReadOutcome::Data(byte_chunk_from_visible_ascii_string("ab")?), list_cons(io::ReadOutcome::End, list_cons(io::ReadOutcome::Data(byte_chunk_from_visible_ascii_string("x")?), list_nil())))
	let script = io_complete_transfer_test::Script(reads, list_nil())
	match exact(script, byte_count(5)?)?
		io_complete_transfer_test::ExactObservation(io::ExactOutcome::Short(bytes), io_complete_transfer_test::Snapshot(Cons(3, Cons(5, Nil)), Nil, Cons(io::ReadOutcome::Data(remaining), Nil), Nil)) => if chunk_is(bytes, "ab") and chunk_is(remaining, "x")
			Ok(())
		else
			Err("clean end changed accumulated or remaining bytes")
		end
		_ => Err("read_exact did not stop with Short at clean end")
	end
end

test read_exact_preserves_failure_bytes_and_known_progress() -> Result<(), String> effects [concurrency]
	let failure = provider_error("known read failure")
	let reads = list_cons(io::ReadOutcome::Data(byte_chunk_from_visible_ascii_string("ab")?), list_cons(io::ReadOutcome::ReadFailed(byte_chunk_from_visible_ascii_string("x")?, io::Progress::Known(byte_count(1)?), failure), list_cons(io::ReadOutcome::End, list_nil())))
	let script = io_complete_transfer_test::Script(reads, list_nil())
	match exact(script, byte_count(5)?)?
		io_complete_transfer_test::ExactObservation(io::ExactOutcome::ExactFailed(bytes, io::Progress::Known(consumed), io::Error::Error("scripted", io::ErrorKind::Other, _, _, _, _, "known read failure")), io_complete_transfer_test::Snapshot(Cons(3, Cons(5, Nil)), Nil, Cons(io::ReadOutcome::End, Nil), Nil)) => if chunk_is(bytes, "abx") and byte_count_to_int(consumed) == 3
			Ok(())
		else
			Err("known read failure lost bytes or accumulated progress")
		end
		_ => Err("read_exact did not preserve the known provider failure")
	end
end

