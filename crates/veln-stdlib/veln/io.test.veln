	match exact(io_complete_transfer_test::Script(reads, list_nil()), byte_count(3)?)?
		io_complete_transfer_test::ExactObservation(io::ExactOutcome::ExactFailed(bytes, io::Progress::Unknown(consumed), io::Error::Error("read_exact", io::ErrorKind::InvalidResource, _, _, _, _, _)), io_complete_transfer_test::Snapshot(Cons(2, Cons(3, Nil)), Nil, Cons(io::ReadOutcome::End, Nil), Nil)) => if chunk_is(bytes, "a") and byte_count_to_int(consumed) == 1
			Ok(())
		else
			Err("overflowing progress wrapped or changed the confirmed prefix")
		end
		_ => Err("read_exact did not stop on overflowing provider progress")
	end
end

test write_all_retries_only_the_uncommitted_suffix() -> Result<(), String> effects [concurrency]
	let writes = list_cons(io::WriteOutcome::Written(byte_count(1)?), list_cons(io::WriteOutcome::Written(byte_count(2)?), list_cons(io::WriteOutcome::Written(byte_count(1)?), list_nil())))
	let script = io_complete_transfer_test::Script(list_nil(), writes)
	match write(script, byte_chunk_from_visible_ascii_string("abcd")?)?
		io_complete_transfer_test::WriteObservation(io::WriteOutcome::Written(count), io_complete_transfer_test::Snapshot(Nil, inputs, Nil, Nil)) => if byte_count_to_int(count) == 4 and inputs_are_three(inputs, "d", "bcd", "abcd")
			Ok(())
		else
			Err("write_all changed total progress or a retried suffix")
		end
		_ => Err("write_all did not complete partial writes")
	end
end

