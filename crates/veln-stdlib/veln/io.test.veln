	match write(script, byte_chunk_from_visible_ascii_string("abcd")?)?
		io_complete_transfer_test::WriteObservation(io::WriteOutcome::WriteFailed(io::Progress::Known(committed), io::Error::Error("scripted", io::ErrorKind::Other, _, _, _, _, "known write failure")), io_complete_transfer_test::Snapshot(Nil, inputs, Nil, Cons(io::WriteOutcome::Written(_), Nil))) => if byte_count_to_int(committed) == 2 and inputs_are_two(inputs, "bcd", "abcd")
			Ok(())
		else
			Err("known write failure lost progress or suffix inputs")
		end
		_ => Err("write_all did not preserve the known provider failure")
	end
end

