end

test write_all_rejects_malformed_failure_progress_without_retry() -> Result<(), String> effects [concurrency]
	let malformed = io::WriteOutcome::WriteFailed(io::Progress::Unknown(ByteCount(-1)), provider_error("negative failure"))
	let writes = list_cons(malformed, list_cons(io::WriteOutcome::Written(byte_count(1)?), list_nil()))
	match write(io_complete_transfer_test_support_test::Script(list_nil(), writes), byte_chunk_from_visible_ascii_string("ab")?)?
		io_complete_transfer_test_support_test::WriteObservation(io::WriteOutcome::WriteFailed(io::Progress::Unknown(committed), io::Error::Error("write_all", io::ErrorKind::InvalidResource, _, _, _, _, _)), io_complete_transfer_test_support_test::Snapshot(Nil, Cons(input, Nil), Nil, Cons(io::WriteOutcome::Written(_), Nil))) => if byte_count_to_int(committed) == 0 and chunk_is(input, "ab")
			Ok(())
		else
			Err("negative write failure progress fabricated a prefix")
		end
		_ => Err("write_all accepted malformed failure progress or retried it")
	end
end
