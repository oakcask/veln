use observe
use observe_test_support_test
use trace

fn body_record(message: String) -> Observation
	observe::Log(observe::LogRecord("body", observe::Info, message, list_nil(), None, callsite_location()))
end

fn return_value(span: Span) -> Result<(), String> effects [observe::Observe]
	let _ = perform observe::Observe::emit(body_record("normal"))
	Ok(())
end

fn return_error(span: Span) -> Result<(), String> effects [observe::Observe]
	let _ = perform observe::Observe::emit(body_record("error"))
	Err("body error")
end

fn propagate_error(span: Span) -> Result<(), String> effects [observe::Observe]
	let _ = return_error(span)?
	Ok(())
end

fn child_value(span: Span) -> Result<(), String>
	Ok(())
end

fn sibling_children(parent: Span) -> Result<(), String> effects [observe::Observe, time]
	let _ = time::monotonic_ms()
	let _ = trace::in_span(observe::SpanRequest("first", observe::context(parent), list_nil()), child_value)?
	let _ = trace::in_span(observe::SpanRequest("second", observe::context(parent), list_nil()), child_value)?
	Ok(())
end

fn is_ok(result: Result<(), String>) -> Bool
	match result
		Ok(()) => true
		_ => false
	end
end

test in_span_finishes_once_after_normal_return() -> Result<(), String> effects [time, concurrency]
	let recording = observe_test_support_test::span_recording("normal")
	let value = handle (handle trace::in_span(observe::SpanRequest("work", None, list_nil()), return_value) with observe::recording(recording)) with observe_test_support_test::clock(10)
	match observe::recorded(recording)
		Cons(observe::SpanStarted("work", "normal-0", "normal-1", None, Nil, 10), Cons(observe::Emitted(observe::Log(observe::LogRecord("body", observe::Info, "normal", Nil, None, _))), Cons(observe::SpanFinished("normal-0", "normal-1", 10), Nil))) => if is_ok(value)
			Ok(())
		else
			Err("in_span changed the body result")
		end
		_ => Err("normal in_span lifecycle was not exactly start, body, then finish")
	end
end

test in_span_finishes_once_when_error_propagates() -> Result<(), String> effects [time, concurrency]
	let recording = observe_test_support_test::span_recording("error")
	let result = handle (handle trace::in_span(observe::SpanRequest("work", None, list_nil()), propagate_error) with observe::recording(recording)) with observe_test_support_test::clock(20)
	match observe::recorded(recording)
		Cons(observe::SpanStarted("work", "error-0", "error-1", None, Nil, 20), Cons(observe::Emitted(observe::Log(observe::LogRecord("body", observe::Info, "error", Nil, None, _))), Cons(observe::SpanFinished("error-0", "error-1", 20), Nil))) => match result
			Err("body error") => Ok(())
			_ => Err("in_span changed the propagated error")
		end
		_ => Err("error in_span lifecycle was not exactly start, body, then finish")
	end
end

test sibling_spans_share_parent_and_have_distinct_identities() -> Result<(), String> effects [time, concurrency]
	let recording = observe_test_support_test::span_recording("tree")
	let result = handle (handle trace::in_span(observe::SpanRequest("parent", None, list_nil()), sibling_children) with observe::recording(recording)) with observe_test_support_test::clock(30)
	match observe::recorded(recording)
		Cons(observe::SpanStarted("parent", "tree-0", "tree-1", None, Nil, 30), Cons(observe::SpanStarted("first", "tree-0", "tree-2", Some("tree-1"), Nil, 30), Cons(observe::SpanFinished("tree-0", "tree-2", 30), Cons(observe::SpanStarted("second", "tree-0", "tree-3", Some("tree-1"), Nil, 30), Cons(observe::SpanFinished("tree-0", "tree-3", 30), Cons(observe::SpanFinished("tree-0", "tree-1", 30), Nil)))))) => if is_ok(result)
			Ok(())
		else
			Err("nested in_span changed the body result")
		end
		_ => Err("sibling span parentage, identities, or lifecycle order changed")
	end
end

fn callsite_location() -> SourceLocation callsite
	callsite
end
