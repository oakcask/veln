use observe

pub type Traced<A>
	pub Traced(value: A, context: TraceContext)
end

pub fn spawn<effect E>(context: TraceContext, callback: fn(TraceContext) -> Result<(), String> effects [...E]) -> Task<Result<(), String>> effects [concurrency, ...E]
	task::spawn_with<Result<(), String>, TraceContext>(callback, context)
end
