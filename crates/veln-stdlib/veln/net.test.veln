test system_connect_observes_parent_task_cancellation_during_resolution() -> Result<(), String> effects [net, time, concurrency]
	let ready = channel::bounded<()>(1)
	let release = channel::bounded<()>(1)
	let worker = task::spawn_with(system_stalled_connect_task, { ready: ready.tx, release: release.rx })
	let started: Option<()> = channel::recv(ready.rx)
	task::cancel(worker)
	let _ = channel::send(release.tx, ())
	match started
		Some(_) => match task::join(worker)
			Err(error) => if task::join_error_is_cancelled(error)
				Ok(())
			else
				Err("cancelled connect task reported a non-cancellation join error")
			end
			Ok(_) => Err("cancelled connect task completed normally")
		end
		None => Err("stalled task-cancellation resolver did not begin")
	end
end

