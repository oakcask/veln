fn system_close_commit_case(kind: String, uncertain: Bool) -> Result<(), String> effects [net::IO]
	if kind == "listener"
		match net::listen(net::Address(net::Tcp4, "127.0.0.1", 0))
			Ok(listener) => match net::close_listener(listener)
				Err(_) => match net::listener_address(listener)
					Err(net::NetError(_, _, _, net::Closed, _)) => match net::close_listener(listener)
						Ok(()) => Ok(())
						Err(_) => if uncertain Err("unknown listener close was not retryable") else Err("committed listener close was not idempotent") end
					end
					_ => Err("failed listener close left ordinary operations available")
				end
				Ok(()) => Err("scripted listener close unexpectedly succeeded")
			end
			Err(_) => Err("scripted listener did not open")
		end
	else
		match net::connect(net::Address(net::Tcp4, "retry.test", 443))
			Ok(stream) => match net::close_stream(stream)
				Err(_) => match net::local_address(stream)
					Err(net::NetError(_, _, _, net::Closed, _)) => match net::close_stream(stream)
						Ok(()) => Ok(())
						Err(_) => if uncertain Err("unknown stream close was not retryable") else Err("committed stream close was not idempotent") end
					end
					_ => Err("failed stream close left ordinary operations available")
				end
				Ok(()) => Err("scripted stream close unexpectedly succeeded")
			end
			Err(_) => Err("scripted stream did not connect")
		end
	end
end

fn close_commit_count(kind: String, commit: Int) -> Result<Int, String> effects [net, time, concurrency]
	let calls = channel::bounded<Int>(1)
	let _ = channel::send(calls.tx, 0)
	let result = handle handle system_close_commit_case(kind, commit < 0) with net::system() with committed_close_system_network(commit, calls)
	match result
		Ok(()) => match channel::recv(calls.rx)
			Some(count) => Ok(count)
			None => Err("close commit count was missing")
		end
		Err(message) => Err(message)
	end
end

fn system_empty_write_ignores_expired_controls() -> Result<(), String> effects [net::IO, time]
	match net::connect(net::Address(net::Tcp4, "write.test", 443))
		Ok(stream) => match byte_chunk_from_visible_ascii_string("")
			Ok(empty) => begin
				let owner = time::cancel_owner()
				let token = time::cancel_token_from(owner)
				time::cancel_owned(owner)
				match net::write_with(stream, empty, Some(time::deadline_after_ms(0)), Some(token))
					net::Written(net::ByteCount(0)) => Ok(())
					_ => Err("empty system write did not report zero progress")
				end
			end
			Err(message) => Err(message)
		end
		Err(_) => Err("scripted stream did not connect")
	end
end

fn system_scripted_write_failure_then_closed() -> Result<(), String> effects [net::IO]
	match net::connect(net::Address(net::Tcp4, "write.test", 443))
		Ok(stream) => match byte_chunk_from_visible_ascii_string("abcdef")
			Ok(bytes) => match net::write(stream, bytes)
				net::WriteFailed(net::ByteCount(4), net::NetError("write", _, Some("192.0.2.10:443"), net::ConnectionReset, _)) => match net::write(stream, bytes)
					net::WriteFailed(net::ByteCount(0), net::NetError("write", _, Some("192.0.2.10:443"), net::Closed, _)) => Ok(())
					_ => Err("system write did not close the failed write half")
				end
				_ => Err("system write did not preserve the exact failed committed count and translated failure")
			end
			Err(message) => Err(message)
		end
		Err(_) => Err("scripted stream did not connect")
	end
end

fn is_reusable_write_failure(outcome: net::WriteOutcome, kind: String) -> Bool
	match outcome
		net::WriteFailed(net::ByteCount(2), net::NetError("write", _, _, net::TimedOut, _)) => kind == "timeout"
		net::WriteFailed(net::ByteCount(2), net::NetError("write", _, _, net::Cancelled, _)) => kind == "cancelled"
		_ => false
	end
end

fn is_reusable_read_failure(outcome: Result<net::ReadOutcome, net::NetError>, kind: String) -> Bool
	match outcome
		Err(net::NetError("read", _, _, net::TimedOut, _)) => kind == "timeout"
		Err(net::NetError("read", _, _, net::Cancelled, _)) => kind == "cancelled"
		_ => false
	end
end

fn system_scripted_reusable_write_failure(kind: String) -> Result<(), String> effects [net::IO]
	match net::connect(net::Address(net::Tcp4, "write.test", 443))
		Ok(stream) => match byte_chunk_from_visible_ascii_string("abcdef")
			Ok(bytes) => if is_reusable_write_failure(net::write(stream, bytes), kind) and is_reusable_write_failure(net::write(stream, bytes), kind)
				Ok(())
			else
				Err("system write did not preserve the stream after a timeout or cancellation")
			end
			Err(message) => Err(message)
		end
		Err(_) => Err("scripted stream did not connect")
	end
end

fn system_scripted_reusable_read_failure(kind: String) -> Result<(), String> effects [net::IO]
	match net::connect(net::Address(net::Tcp4, "write.test", 443))
		Ok(stream) => if is_reusable_read_failure(net::read(stream), kind) and is_reusable_read_failure(net::read(stream), kind)
			Ok(())
		else
			Err("system read did not preserve the stream after a timeout or cancellation")
		end
		Err(_) => Err("scripted stream did not connect")
	end
end

fn system_connect_and_close(address: net::Address) -> Result<(), net::NetError> effects [net::IO]
	let stream = net::connect(address)?
	net::close_stream(stream)
end

fn system_connect_with_controls(deadline: Option<Deadline>, token: Option<CancelToken>) -> Result<net::Stream, net::NetError> effects [net::IO]
	net::connect_with(net::Address(net::Tcp4, "stalled.test", 443), deadline, token)
end

fn system_connect_after_commit(token: CancelToken) -> Result<(), net::NetError> effects [net::IO]
	let stream = net::connect_with(net::Address(net::Tcp4, "commit.test", 443), None, Some(token))?
	net::close_stream(stream)
end

fn system_stalled_connect_task(context: { ready : Sender<()>, release : Receiver<()> }) -> Result<net::Stream, net::NetError> effects [net, time, concurrency]
	handle handle system_connect_with_controls(None, None) with net::system() with task_stalled_system_resolver(context.ready, context.release)
end

fn system_ordered_connect_and_close_body() -> Result<(), net::NetError> effects [net::IO, time]
	let stream = net::connect_with(net::Address(net::Tcp4, "ordered.test", 443), Some(time::deadline_after_ms(1000)), None)?
	net::close_stream(stream)
end

fn system_ordered_connect_and_close() -> Result<Int, String> effects [net, time, concurrency]
	let attempts = channel::bounded<Int>(1)
	let _ = channel::send(attempts.tx, 0)
	let result = handle handle system_ordered_connect_and_close_body() with net::system() with ordered_deduplicated_system_network(attempts)
	match result
		Ok(()) => match channel::recv(attempts.rx)
			Some(count) => Ok(count)
			None => Err("ordered connect attempt count was unavailable")
		end
		Err(_) => Err("ordered connect failed")
	end
end

fn system_controlled_endpoint_attempt(kind: String) -> Result<{ error : net::NetError, attempts : Int }, String> effects [net, time, concurrency]
	let attempts = channel::bounded<Int>(1)
	let _ = channel::send(attempts.tx, 0)
	let result = handle handle net::connect(net::Address(net::Tcp4, "controlled.test", 443)) with net::system() with controlled_endpoint_system_network(kind, attempts)
	match result
		Err(error) => match channel::recv(attempts.rx)
			Some(count) => Ok({ error: error, attempts: count })
			None => Err("controlled endpoint attempt count was unavailable")
		end
		Ok(_) => Err("connect retried after a controlling endpoint failure")
	end
end

fn system_accept_end_is_closed() -> Result<(), String> effects [net::IO]
	match net::listen(net::Address(net::Tcp4, "ended.test", 0))
		Ok(listener) => match net::accept(listener)
			Err(net::NetError("accept", _, _, net::Closed, _)) => match net::close_listener(listener)
				Ok(()) => Ok(())
				Err(_) => Err("listener could not close after clean accept end")
			end
			_ => Err("clean accept end was not translated to Closed")
		end
		Err(_) => Err("scripted listener did not open")
	end
end

fn system_background_write(stream: net::Stream) -> net::WriteOutcome effects [net::IO]
	match byte_chunk_from_visible_ascii_string("w")
		Ok(bytes) => net::write(stream, bytes)
		Err(message) => net::WriteFailed(net::ByteCount(0), net::NetError("write", None, None, net::Other, message))
	end
end

fn system_background_read(stream: net::Stream) -> Result<net::ReadOutcome, net::NetError> effects [net::IO]
	net::read(stream)
end

fn system_background_shutdown_read(stream: net::Stream) -> Result<(), net::NetError> effects [net::IO]
	net::shutdown_read(stream)
end

fn system_background_shutdown_write(stream: net::Stream) -> Result<(), net::NetError> effects [net::IO]
	net::shutdown_write(stream)
end

fn system_contention_stream() -> Result<net::Stream, String> effects [net::IO]
	match net::connect(net::Address(net::Tcp4, "contention.test", 443))
		Ok(value) => Ok(value)
		Err(_) => Err("contention stream did not connect")
	end
end

fn system_write_contention_body(ready: Receiver<()>, release: Sender<()>) -> Result<(), String> effects [net::IO, concurrency]
	let stream = system_contention_stream()?
	let first = task::spawn_with(system_background_write, stream)
	let _ = channel::recv(ready)
	let second = system_background_write(stream)
	let simultaneous = net::read(stream)
	let _ = channel::send(release, ())
	let joined = task::join(first)
	let _ = net::close_stream(stream)
	match second
		net::WriteFailed(net::ByteCount(0), net::NetError(_, _, _, net::Busy, _)) => match simultaneous
			Ok(net::ReadChunk(_)) => match joined
				Ok(net::Written(net::ByteCount(1))) => Ok(())
				_ => Err("first contended write did not complete unchanged")
			end
			_ => Err("simultaneous read was not permitted during write")
		end
		_ => Err("second concurrent write did not return Busy")
	end
end

fn system_read_contention_body(ready: Receiver<()>, release: Sender<()>) -> Result<(), String> effects [net::IO, concurrency]
	let stream = system_contention_stream()?
	let first = task::spawn_with(system_background_read, stream)
	let _ = channel::recv(ready)
	let second = net::read(stream)
	let _ = channel::send(release, ())
	let joined = task::join(first)
	let _ = net::close_stream(stream)
	match second
		Err(net::NetError(_, _, _, net::Busy, _)) => match joined
			Ok(Ok(net::ReadChunk(_))) => Ok(())
			_ => Err("first contended read did not complete unchanged")
		end
		_ => Err("second concurrent read did not return Busy")
	end
end

fn system_read_shutdown_interruption_body(ready: Receiver<()>, release: Sender<()>) -> Result<(), String> effects [net::IO, concurrency]
	let stream = system_contention_stream()?
	let pending = task::spawn_with(system_background_read, stream)
	let _ = channel::recv(ready)
	let shutdown = net::shutdown_read(stream)
	let _ = channel::send(release, ())
	let joined = task::join(pending)
	let _ = net::close_stream(stream)
	match shutdown
		Ok(()) => match joined
			Ok(Err(net::NetError(_, _, _, net::Closed, _))) => Ok(())
			_ => Err("blocked read after local shutdown did not return Closed")
		end
		Err(_) => Err("local read shutdown failed")
	end
end

fn system_write_shutdown_interruption_body(ready: Receiver<()>, release: Sender<()>) -> Result<(), String> effects [net::IO, concurrency]
	let stream = system_contention_stream()?
	let pending = task::spawn_with(system_background_write, stream)
	let _ = channel::recv(ready)
	let shutdown = net::shutdown_write(stream)
	let _ = channel::send(release, ())
	let joined = task::join(pending)
	let _ = net::close_stream(stream)
	match shutdown
		Ok(()) => match joined
			Ok(net::WriteFailed(net::ByteCount(1), net::NetError(_, _, _, net::Closed, _))) => Ok(())
			_ => Err("blocked write after local shutdown did not preserve its prefix and return Closed")
		end
		Err(_) => Err("local write shutdown failed")
	end
end

fn system_successful_shutdown_post_states() -> Result<(), String> effects [net::IO]
	let stream = system_contention_stream()?
	let read_shutdown = net::shutdown_read(stream)
	let fresh_read = net::read(stream)
	let write_shutdown = net::shutdown_write(stream)
	let fresh_write = match byte_chunk_from_visible_ascii_string("w")
		Ok(bytes) => net::write(stream, bytes)
		Err(message) => net::WriteFailed(net::ByteCount(0), net::NetError("write", None, None, net::Other, message))
	end
	let _ = net::close_stream(stream)
	match read_shutdown
		Ok(()) => match fresh_read
			Err(net::NetError(_, _, _, net::Closed, _)) => match write_shutdown
				Ok(()) => match fresh_write
					net::WriteFailed(net::ByteCount(0), net::NetError(_, _, _, net::Closed, _)) => Ok(())
					_ => Err("fresh write after successful shutdown did not return WriteFailed(0, Closed)")
				end
				Err(_) => Err("local write shutdown failed")
			end
			_ => Err("fresh read after successful shutdown did not return Closed")
		end
		Err(_) => Err("local read shutdown failed")
	end
end

fn system_successful_stream_close_post_states() -> Result<(), String> effects [net::IO]
	let stream = system_contention_stream()?
	let closed = net::close_stream(stream)
	let fresh_read = net::read(stream)
	let fresh_write = match byte_chunk_from_visible_ascii_string("w")
		Ok(bytes) => net::write(stream, bytes)
		Err(message) => net::WriteFailed(net::ByteCount(0), net::NetError("write", None, None, net::Other, message))
	end
	match closed
		Ok(()) => match fresh_read
			Err(net::NetError(_, _, _, net::Closed, _)) => match fresh_write
				net::WriteFailed(net::ByteCount(0), net::NetError(_, _, _, net::Closed, _)) => Ok(())
				_ => Err("fresh write after successful stream close did not return WriteFailed(0, Closed)")
			end
			_ => Err("fresh read after successful stream close did not return Closed")
		end
		Err(_) => Err("stream close failed")
	end
end

fn system_successful_listener_close_post_state() -> Result<(), String> effects [net::IO]
	match net::listen(net::Address(net::Tcp4, "ended.test", 0))
		Ok(listener) => begin
			let closed = net::close_listener(listener)
			let fresh_accept = net::accept(listener)
			match closed
				Ok(()) => match fresh_accept
					Err(net::NetError(_, _, _, net::Closed, _)) => Ok(())
					_ => Err("fresh accept after successful listener close did not return Closed")
				end
				Err(_) => Err("listener close failed")
			end
		end
		Err(_) => Err("listener did not open")
	end
end

fn system_uncommitted_read_shutdown_failure_body(io_ready: Receiver<()>, io_release: Sender<()>, shutdown_ready: Receiver<()>, shutdown_release: Sender<()>) -> Result<(), String> effects [net::IO, concurrency]
	let stream = system_contention_stream()?
	let io = task::spawn_with(system_background_read, stream)
	let _ = channel::recv(io_ready)
	let shutdown = task::spawn_with(system_background_shutdown_read, stream)
	let _ = channel::recv(shutdown_ready)
	let _ = channel::send(io_release, ())
	let _ = channel::send(shutdown_release, ())
	let io_result = task::join(io)
	let shutdown_result = task::join(shutdown)
	let retry = net::shutdown_read(stream)
	let _ = net::close_stream(stream)
	match shutdown_result
		Ok(Err(_)) => match retry
			Ok(()) => match io_result
				Ok(Ok(net::ReadChunk(_))) => Ok(())
				_ => Err("uncommitted read shutdown discarded successful bytes")
			end
			Err(_) => Err("uncommitted shutdown did not leave the half retryable")
		end
		_ => Err("first shutdown did not return its host failure")
	end
end

fn system_uncommitted_write_shutdown_failure_body(io_ready: Receiver<()>, io_release: Sender<()>, shutdown_ready: Receiver<()>, shutdown_release: Sender<()>) -> Result<(), String> effects [net::IO, concurrency]
	let stream = system_contention_stream()?
	let io = task::spawn_with(system_background_write, stream)
	let _ = channel::recv(io_ready)
	let shutdown = task::spawn_with(system_background_shutdown_write, stream)
	let _ = channel::recv(shutdown_ready)
	let _ = channel::send(io_release, ())
	let _ = channel::send(shutdown_release, ())
	let io_result = task::join(io)
	let shutdown_result = task::join(shutdown)
	let retry = net::shutdown_write(stream)
	let _ = net::close_stream(stream)
	match shutdown_result
		Ok(Err(_)) => match retry
			Ok(()) => match io_result
				Ok(net::Written(net::ByteCount(1))) => Ok(())
				_ => Err("uncommitted write shutdown discarded the committed prefix")
			end
			Err(_) => Err("uncommitted shutdown did not leave the half retryable")
		end
		_ => Err("first shutdown did not return its host failure")
	end
end

fn system_shutdown_commit_case(direction: String) -> Result<(), String> effects [net::IO]
	let stream = system_contention_stream()?
	if direction == "read"
		match net::shutdown_read(stream)
			Err(_) => match net::read(stream)
				Err(net::NetError(_, _, _, net::Closed, _)) => match net::shutdown_read(stream)
					Ok(()) => Ok(())
					Err(_) => Err("read shutdown state could not be confirmed")
				end
				_ => Err("failed read shutdown left the half available")
			end
			Ok(()) => Err("scripted read shutdown unexpectedly succeeded")
		end
	else
		match net::shutdown_write(stream)
			Err(_) => match byte_chunk_from_visible_ascii_string("w")
				Ok(bytes) => match net::write(stream, bytes)
					net::WriteFailed(net::ByteCount(0), net::NetError(_, _, _, net::Closed, _)) => match net::shutdown_write(stream)
						Ok(()) => Ok(())
						Err(_) => Err("write shutdown state could not be confirmed")
					end
					_ => Err("failed write shutdown left the half available")
				end
				Err(message) => Err(message)
			end
			Ok(()) => Err("scripted write shutdown unexpectedly succeeded")
		end
	end
end

fn shutdown_commit_count(direction: String, commit: Int) -> Result<Int, String> effects [net, time, concurrency]
	let io_ready = channel::bounded<()>(1)
	let io_release = channel::bounded<()>(1)
	let shutdown_ready = channel::bounded<()>(1)
	let shutdown_release = channel::bounded<()>(1)
	let calls = channel::bounded<Int>(1)
	let _ = channel::send(calls.tx, 0)
	let _ = channel::send(shutdown_release.tx, ())
	let result = handle handle system_shutdown_commit_case(direction) with net::system() with failing_shutdown_system_network(direction, commit, io_ready.tx, io_release.rx, shutdown_ready.tx, shutdown_release.rx, calls)
	match result
		Ok(()) => match channel::recv(calls.rx)
			Some(count) => Ok(count)
			None => Err("shutdown commit count was missing")
		end
		Err(message) => Err(message)
	end
end

fn system_failure_has_kind(category: String, expected: String) -> Bool effects [net, time]
	let result = handle handle net::resolve(net::Address(net::Tcp, "failure.test", 443)) with net::system() with failing_system_network(category)
	match result
		Err(net::NetError(_, _, _, net::TimedOut, _)) => expected == "timed_out"
		Err(net::NetError(_, _, _, net::Cancelled, _)) => expected == "cancelled"
		Err(net::NetError(_, _, _, net::Closed, _)) => expected == "closed"
		Err(net::NetError(_, _, _, net::ConnectionRefused, _)) => expected == "connection_refused"
		Err(net::NetError(_, _, _, net::ConnectionReset, _)) => expected == "connection_reset"
		Err(net::NetError(_, _, _, net::AddressInUse, _)) => expected == "address_in_use"
		Err(net::NetError(_, _, _, net::PermissionDenied, _)) => expected == "permission_denied"
		Err(net::NetError(_, _, _, net::NameNotFound, _)) => expected == "name_not_found"
		Err(net::NetError(_, _, _, net::InvalidAddress, _)) => expected == "invalid_address"
		Err(net::NetError(_, _, _, net::Other, _)) => expected == "other"
		_ => false
	end
end

fn observed_failure(operation: String, message: String) -> net::NetError
	net::NetError(operation, Some(net::Tcp4), Some("example.test:443"), net::PermissionDenied, message)
end

fn address_message(address: net::Address, operation: String) -> String
	match address
		net::Address(net::Tcp4, "example.test", 443) => operation
		_ => "unexpected address"
	end
end

fn connect_message(address: net::Address, deadline: Option<Deadline>, token: Option<CancelToken>) -> String
	match deadline
		None => match token
			None => address_message(address, "short")
			Some(_) => "unexpected token"
		end
		Some(_) => match token
			Some(_) => address_message(address, "with")
			None => "missing token"
		end
	end
end

fn resource_failure(operation: String) -> net::NetError
	observed_failure(operation, "opaque resource operation was not invoked")
end

handler observing_io() for net::IO
	resolve(address) => Err(observed_failure("resolve", address_message(address, "resolve")))
	listen(address) => Err(observed_failure("listen", address_message(address, "listen")))
	connect(address, deadline, token) => Err(observed_failure("connect", connect_message(address, deadline, token)))
	accept(listener, deadline, token) => Err(resource_failure("accept"))
	listener_address(listener) => Err(resource_failure("listener_address"))
	close_listener(listener) => Err(resource_failure("close_listener"))
	read(stream, deadline, token) => Err(resource_failure("read"))
	write(stream, bytes, deadline, token) => net::WriteFailed(net::ByteCount(0), resource_failure("write"))
	local_address(stream) => Err(resource_failure("local_address"))
	peer_address(stream) => Err(resource_failure("peer_address"))
	shutdown_read(stream) => Err(resource_failure("shutdown_read"))
	shutdown_write(stream) => Err(resource_failure("shutdown_write"))
	close_stream(stream) => Err(resource_failure("close_stream"))
end

fn expect_observed_error(error: net::NetError, operation: String, message: String) -> Result<(), String>
	match error
		net::NetError(observed_operation, Some(net::Tcp4), Some("example.test:443"), net::PermissionDenied, observed_message) => if observed_operation == operation and observed_message == message
			Ok(())
		else
			Err("handler failure fields did not pass through unchanged")
		end
		_ => Err("handler ordinary failure fields did not match")
	end
end

fn is_invalid(result: Result<String, net::NetError>) -> Bool
	match result
		Ok(_) => false
		Err(net::NetError(_, _, _, net::InvalidAddress, _)) => true
		Err(_) => false
	end
end

fn is_split_invalid(result: Result<{ host : String, port : Int }, net::NetError>) -> Bool
	match result
		Ok(_) => false
		Err(net::NetError(_, _, _, net::InvalidAddress, _)) => true
		Err(_) => false
	end
end

test address_values_are_constructible_and_inspectable() -> Result<(), String>
	let address = net::Address(net::Tcp4, "127.0.0.1", 8080)
	let endpoint = net::Endpoint(net::Tcp6, "[::1]:443")
	match address
		net::Address(net::Tcp4, "127.0.0.1", 8080) => match endpoint
			net::Endpoint(net::Tcp6, "[::1]:443") => Ok(())
		end
	end
end

test io_outcome_values_are_constructible_and_inspectable() -> Result<(), String>
	let bytes = byte_chunk_from_visible_ascii_string("ok")?
	let failure = observed_failure("write", "partial")
	let chunk = net::ReadChunk(bytes)
	let ended = net::ReadEnd
	let written = net::Written(net::ByteCount(2))
	let failed = net::WriteFailed(net::ByteCount(1), failure)
	match chunk
		net::ReadChunk(observed_bytes) => if byte_chunk_to_visible_ascii_string(observed_bytes)? == "ok"
			match ended
				net::ReadEnd => match written
					net::Written(net::ByteCount(2)) => match failed
						net::WriteFailed(net::ByteCount(1), error) => expect_observed_error(error, "write", "partial")
					end
				end
			end
		else
			Err("read chunk bytes did not match")
		end
	end
end

test write_all_partial_success_keeps_only_the_uncommitted_suffix() -> Result<(), String>
	let bytes = byte_chunk_from_visible_ascii_string("abcdef")?
	match net::write_all_next(bytes, net::Written(net::ByteCount(2)))
		Ok(Some(suffix)) => if byte_chunk_to_visible_ascii_string(suffix)? == "cdef"
			Ok(())
		else
			Err("write_all retained the wrong suffix")
		end
		_ => Err("write_all did not continue after a partial success")
	end
end

test write_all_failed_partial_write_returns_the_handler_error() -> Result<(), String>
	let bytes = byte_chunk_from_visible_ascii_string("abcdef")?
	let failure = observed_failure("scripted-write", "failed after prefix")
	match net::write_all_next(bytes, net::WriteFailed(net::ByteCount(3), failure))
		Err(error) => expect_observed_error(error, "scripted-write", "failed after prefix")
		Ok(_) => Err("write_all ignored a failed partial write")
	end
end

test write_all_zero_progress_is_an_other_error() -> Result<(), String>
	let bytes = byte_chunk_from_visible_ascii_string("remaining")?
	match net::write_all_next(bytes, net::Written(net::ByteCount(0)))
		Err(net::NetError("write_all", None, None, net::Other, _)) => Ok(())
		_ => Err("write_all did not reject zero progress")
	end
end

test write_all_rejects_a_committed_count_larger_than_the_input() -> Result<(), String>
	let bytes = byte_chunk_from_visible_ascii_string("short")?
	match net::write_all_next(bytes, net::Written(net::ByteCount(6)))
		Err(net::NetError("write_all", None, None, net::Other, _)) => Ok(())
		_ => Err("write_all accepted a committed count larger than its input")
	end
end

test host_port_success_boundaries_round_trip() -> Result<(), String>
	match net::join_host_port("127.0.0.1", 0)
		Ok(ipv4) => match net::split_host_port(ipv4)
			Ok({ host: "127.0.0.1", port: 0 }) => match net::join_host_port("example.test", 65535)
				Ok(hostname) => match net::split_host_port(hostname)
					Ok({ host: "example.test", port: 65535 }) => match net::join_host_port("2001:db8::1", 443)
						Ok("[2001:db8::1]:443") => match net::split_host_port("[2001:db8::1]:443")
							Ok({ host: "2001:db8::1", port: 443 }) => Ok(())
							_ => Err("IPv6 round trip did not match")
						end
						_ => Err("IPv6 join did not succeed")
					end
					_ => Err("hostname round trip did not match")
				end
				_ => Err("hostname join did not succeed")
			end
			_ => Err("IPv4 round trip did not match")
		end
		_ => Err("IPv4 join did not succeed")
	end
end

test host_port_rejection_boundaries_are_invalid_addresses() -> Result<(), String>
	if is_invalid(net::join_host_port("host", -1)) and is_invalid(net::join_host_port("host", 65536)) and is_split_invalid(net::split_host_port("host:-1")) and is_split_invalid(net::split_host_port("host:65536")) and is_split_invalid(net::split_host_port("host")) and is_split_invalid(net::split_host_port("host:")) and is_split_invalid(net::split_host_port("host:not-a-port")) and is_split_invalid(net::split_host_port("host:80:90")) and is_split_invalid(net::split_host_port("2001:db8::1:443")) and is_split_invalid(net::split_host_port("[::1]")) and is_split_invalid(net::split_host_port("[::1]:80:90"))
		Ok(())
	else
		Err("expected every rejected address to use InvalidAddress")
	end
end

