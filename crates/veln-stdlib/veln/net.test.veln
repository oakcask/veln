test failed_explicit_closes_are_retried_and_then_idempotent() -> Result<(), String> effects [net, time, concurrency]
	match close_retry_count("listener")
		Ok(2) => match close_retry_count("stream")
			Ok(2) => Ok(())
			Ok(1) => Err("scope cleanup observed one stream close")
			Ok(_) => Err("scope cleanup observed an unexpected stream close count")
			Err(message) => Err(message)
		end
		Ok(1) => Err("scope cleanup observed one listener close")
		Ok(_) => Err("scope cleanup observed an unexpected listener close count")
		Err(message) => Err(message)
	end
end

test scope_cleanup_retries_unreconciled_explicit_closes() -> Result<(), String> effects [net, time, concurrency]
	match cleanup_retry_count("listener")
		Ok(2) => match cleanup_retry_count("stream")
			Ok(2) => Ok(())
			Ok(_) => Err("scope cleanup did not retry the stream close")
			Err(message) => Err(message)
		end
		Ok(_) => Err("scope cleanup did not retry the listener close")
		Err(message) => Err(message)
	end
end

test scope_exit_retries_failures_from_the_cleanup_pass() -> Result<(), String> effects [net, time, concurrency]
	match scope_exit_cleanup_retry_count("listener")
		Ok(2) => match scope_exit_cleanup_retry_count("stream")
			Ok(2) => Ok(())
			Ok(_) => Err("scope exit did not retry the stream cleanup failure")
			Err(message) => Err(message)
		end
		Ok(_) => Err("scope exit did not retry the listener cleanup failure")
		Err(message) => Err(message)
	end
end

test committed_and_unknown_close_failures_preserve_their_distinct_states() -> Result<(), String> effects [net, time, concurrency]
	match close_commit_count("listener", 1)
		Ok(1) => match close_commit_count("stream", 1)
			Ok(1) => match close_commit_count("listener", -1)
				Ok(2) => match close_commit_count("stream", -1)
					Ok(2) => Ok(())
					_ => Err("unknown stream close did not perform one explicit retry")
				end
				_ => Err("unknown listener close did not perform one explicit retry")
			end
			_ => Err("committed stream close retried the host operation")
		end
		_ => Err("committed listener close retried the host operation")
	end
end

test system_empty_write_reports_zero_before_expired_deadline_or_cancellation() -> Result<(), String> effects [net, time]
	handle handle system_empty_write_ignores_expired_controls() with net::system() with scripted_system_network("write-success")
end

test system_write_uses_exact_failed_committed_count_not_commit_state() -> Result<(), String> effects [net, time]
	handle handle system_scripted_write_failure_then_closed() with net::system() with scripted_system_network("write-failure")
end

test system_write_preserves_exact_deadline_and_cancellation_prefixes() -> Result<(), String> effects [net, time]
	let deadline = handle handle system_scripted_write() with net::system() with scripted_system_network("write-deadline")
	let cancelled = handle handle system_scripted_write() with net::system() with scripted_system_network("write-cancelled")
	match deadline
		net::WriteFailed(net::ByteCount(3), net::NetError("write", _, _, net::TimedOut, _)) => match cancelled
			net::WriteFailed(net::ByteCount(3), net::NetError("write", _, _, net::Cancelled, _)) => Ok(())
			_ => Err("system write did not preserve the cancellation committed prefix")
		end
		_ => Err("system write did not preserve the deadline committed prefix")
	end
end

test translated_deadline_and_cancellation_failures_leave_stream_halves_reusable() -> Result<(), String> effects [net, time]
	let write_deadline = handle handle system_scripted_reusable_write_failure("timeout") with net::system() with scripted_system_network("write-error-deadline")
	let write_cancelled = handle handle system_scripted_reusable_write_failure("cancelled") with net::system() with scripted_system_network("write-error-cancelled")
	let read_deadline = handle handle system_scripted_reusable_read_failure("timeout") with net::system() with scripted_system_network("read-error-deadline")
	let read_cancelled = handle handle system_scripted_reusable_read_failure("cancelled") with net::system() with scripted_system_network("read-error-cancelled")
	match write_deadline
		Ok(()) => match write_cancelled
			Ok(()) => match read_deadline
				Ok(()) => read_cancelled
				Err(message) => Err(message)
			end
			Err(message) => Err(message)
		end
		Err(message) => Err(message)
	end
end

test system_stream_allows_one_reader_and_one_writer() -> Result<(), String> effects [net, time, concurrency]
	let write_ready = channel::bounded<()>(1)
	let write_release = channel::bounded<()>(1)
	let write_result = handle handle system_write_contention_body(write_ready.rx, write_release.tx) with net::system() with contended_system_network("write", write_ready.tx, write_release.rx)
	let read_ready = channel::bounded<()>(1)
	let read_release = channel::bounded<()>(1)
	let read_result = handle handle system_read_contention_body(read_ready.rx, read_release.tx) with net::system() with contended_system_network("read", read_ready.tx, read_release.rx)
	match write_result
		Ok(()) => read_result
		Err(message) => Err(message)
	end
end

