fn system_listen_accept_addresses(address: net::Address) -> Result<{ listener : net::Endpoint, local : net::Endpoint, peer : net::Endpoint }, net::NetError> effects [net::IO]
	let listener = net::listen(address)?
	let listener_address = net::listener_address(listener)?
	let stream = net::accept(listener)?
	let local = net::local_address(stream)?
	let peer = net::peer_address(stream)?
	let _ = net::close_stream(stream)?
	let _ = net::close_listener(listener)?
	Ok({ listener: listener_address, local: local, peer: peer })
end

fn close_retry_count(kind: String) -> Result<Int, String> effects [net, time, concurrency]
	let calls = channel::bounded<Int>(1)
	let _ = channel::send(calls.tx, 0)
	let result = handle handle system_explicit_close_failure(kind) with net::system() with retrying_close_system_network(calls)
	match result
		Ok(()) => match channel::recv(calls.rx)
			Some(count) => Ok(count)
			None => Err("close retry count was missing")
		end
		Err(message) => Err(message)
	end
end

