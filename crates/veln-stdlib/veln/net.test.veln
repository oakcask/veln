test uncommitted_shutdown_failures_preserve_concurrent_io_and_allow_retry() -> Result<(), String> effects [net, time, concurrency]
	let read_io_ready = channel::bounded<()>(1)
	let read_io_release = channel::bounded<()>(1)
	let read_shutdown_ready = channel::bounded<()>(1)
	let read_shutdown_release = channel::bounded<()>(1)
	let read_calls = channel::bounded<Int>(1)
	let _ = channel::send(read_calls.tx, 0)
	let read_result = handle handle system_uncommitted_read_shutdown_failure_body(read_io_ready.rx, read_io_release.tx, read_shutdown_ready.rx, read_shutdown_release.tx) with net::system() with failing_shutdown_system_network("read", 0, read_io_ready.tx, read_io_release.rx, read_shutdown_ready.tx, read_shutdown_release.rx, read_calls)
	let write_io_ready = channel::bounded<()>(1)
	let write_io_release = channel::bounded<()>(1)
	let write_shutdown_ready = channel::bounded<()>(1)
	let write_shutdown_release = channel::bounded<()>(1)
	let write_calls = channel::bounded<Int>(1)
	let _ = channel::send(write_calls.tx, 0)
	let write_result = handle handle system_uncommitted_write_shutdown_failure_body(write_io_ready.rx, write_io_release.tx, write_shutdown_ready.rx, write_shutdown_release.tx) with net::system() with failing_shutdown_system_network("write", 0, write_io_ready.tx, write_io_release.rx, write_shutdown_ready.tx, write_shutdown_release.rx, write_calls)
	match read_result
		Ok(()) => write_result
		Err(message) => Err(message)
	end
end

test committed_and_unknown_shutdown_failures_preserve_commit_state() -> Result<(), String> effects [net, time, concurrency]
	match shutdown_commit_count("read", 1)
		Ok(1) => match shutdown_commit_count("write", 1)
			Ok(1) => match shutdown_commit_count("read", -1)
				Ok(2) => match shutdown_commit_count("write", -1)
					Ok(2) => Ok(())
					_ => Err("unknown write shutdown did not retry")
				end
				_ => Err("unknown read shutdown did not retry")
			end
			_ => Err("committed write shutdown retried the host operation")
		end
		_ => Err("committed read shutdown retried the host operation")
	end
end

test direct_facade_forwards_address_and_ordinary_failures() -> Result<(), String>
	let address = net::Address(net::Tcp4, "example.test", 443)
	let resolved = handle net::resolve(address) with observing_io()
	let listened = handle net::listen(address) with observing_io()
	match resolved
		Err(error) => match expect_observed_error(error, "resolve", "resolve")
			Ok(()) => match listened
				Err(listen_error) => expect_observed_error(listen_error, "listen", "listen")
				Ok(_) => Err("listen unexpectedly succeeded")
			end
			Err(message) => Err(message)
		end
		Ok(_) => Err("resolve unexpectedly succeeded")
	end
end

test short_connect_supplies_absent_deadline_and_cancellation() -> Result<(), String>
	let address = net::Address(net::Tcp4, "example.test", 443)
	match handle net::connect(address) with observing_io()
		Err(error) => expect_observed_error(error, "connect", "short")
		Ok(_) => Err("connect unexpectedly succeeded")
	end
end

test connect_with_forwards_deadline_and_cancellation_options() -> Result<(), String> effects [time]
	let address = net::Address(net::Tcp4, "example.test", 443)
	let deadline = time::deadline_after_ms(1)
	let token = time::cancel_token()
	match handle net::connect_with(address, Some(deadline), Some(token)) with observing_io()
		Err(error) => expect_observed_error(error, "connect", "with")
		Ok(_) => Err("connect_with unexpectedly succeeded")
	end
end
