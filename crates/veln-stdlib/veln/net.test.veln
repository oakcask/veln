			Err(net::NetError("connect", Some(net::Tcp4), Some("stalled.test"), net::TimedOut, _)) => Ok(())
			_ => Err("connect deadline did not bound stalled resolution")
		end
		None => Err("stalled deadline resolver did not begin")
	end
end

