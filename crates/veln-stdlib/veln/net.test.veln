use net
use host_effects from "std"

fn system_network_reply(status: String, value: String, local: String, peer: String, resolved_endpoints: List<{ network : String, address : String }>, bytes_committed: Int, category: String, output_committed: Int, cause: String) -> { status : String, value : String, local : String, peer : String, bytes : ByteChunk, resolved_endpoints : List<{ network : String, address : String }>, bytes_committed : Int, category : String, phase : String, input_committed : Int, output_committed : Int, ownership_committed : Int, cause : String }
	{
		status: status,
		value: value,
		local: local,
		peer: peer,
		bytes: byte_chunk([]),
		resolved_endpoints: resolved_endpoints,
		bytes_committed: bytes_committed,
		category: category,
		phase: "during_operation",
		input_committed: 0,
		output_committed: output_committed,
		ownership_committed: 0,
		cause: cause
	}
end

fn system_network_success(value: String, local: String, peer: String) -> { status : String, value : String, local : String, peer : String, bytes : ByteChunk, resolved_endpoints : List<{ network : String, address : String }>, bytes_committed : Int, category : String, phase : String, input_committed : Int, output_committed : Int, ownership_committed : Int, cause : String }
	system_network_reply("ok", value, local, peer, list_nil(), 0, "", 0, "")
end

fn system_network_read_success(bytes: ByteChunk) -> { status : String, value : String, local : String, peer : String, bytes : ByteChunk, resolved_endpoints : List<{ network : String, address : String }>, bytes_committed : Int, category : String, phase : String, input_committed : Int, output_committed : Int, ownership_committed : Int, cause : String }
	{ status: "ok", value: "", local: "192.0.2.30:50000", peer: "192.0.2.20:443", bytes: bytes, resolved_endpoints: list_nil(), bytes_committed: 0, category: "", phase: "", input_committed: 0, output_committed: 0, ownership_committed: 0, cause: "" }
end

fn system_network_close_failure(ownership_committed: Int) -> { status : String, value : String, local : String, peer : String, bytes : ByteChunk, resolved_endpoints : List<{ network : String, address : String }>, bytes_committed : Int, category : String, phase : String, input_committed : Int, output_committed : Int, ownership_committed : Int, cause : String }
	{ status: "error", value: "", local: "", peer: "", bytes: byte_chunk([]), resolved_endpoints: list_nil(), bytes_committed: 0, category: "forced_failure", phase: "during_operation", input_committed: 0, output_committed: 0, ownership_committed: ownership_committed, cause: "scripted close failure" }
end

fn system_network_shutdown_failure(direction: String, committed: Int) -> { status : String, value : String, local : String, peer : String, bytes : ByteChunk, resolved_endpoints : List<{ network : String, address : String }>, bytes_committed : Int, category : String, phase : String, input_committed : Int, output_committed : Int, ownership_committed : Int, cause : String }
	{ status: "error", value: "", local: "", peer: "", bytes: byte_chunk([]), resolved_endpoints: list_nil(), bytes_committed: 0, category: "forced_failure", phase: "during_operation", input_committed: if direction == "read" committed else 0 end, output_committed: if direction == "write" committed else 0 end, ownership_committed: 0, cause: "scripted shutdown failure" }
end

handler scripted_system_network(scenario: String) for host_effects::Network
	request(operation, subject, bytes, remaining_ms, cancelled) => scripted_system_network_reply(scenario, operation, subject)
end

handler failing_system_network(category: String) for host_effects::Network
	request(operation, subject, bytes, remaining_ms, cancelled) => system_network_reply("error", "", "", "", list_nil(), 0, category, -1, "scripted host failure")
end

handler contended_system_network(direction: String, ready: Sender<()>, release: Receiver<()>) for host_effects::Network effects [concurrency]
	request(operation, subject, bytes, remaining_ms, cancelled) => contended_system_network_reply(direction, ready, release, operation, subject, bytes)
end

handler retrying_close_system_network(calls: { tx : Sender<Int>, rx : Receiver<Int> }) for host_effects::Network effects [concurrency]
	request(operation, subject, bytes, remaining_ms, cancelled) => retrying_close_system_network_reply(calls, operation, subject)
end

handler committed_close_system_network(commit: Int, calls: { tx : Sender<Int>, rx : Receiver<Int> }) for host_effects::Network effects [concurrency]
	request(operation, subject, bytes, remaining_ms, cancelled) => committed_close_system_network_reply(commit, calls, operation, subject)
end

handler failing_shutdown_system_network(direction: String, commit: Int, io_ready: Sender<()>, io_release: Receiver<()>, shutdown_ready: Sender<()>, shutdown_release: Receiver<()>, shutdown_calls: { tx : Sender<Int>, rx : Receiver<Int> }) for host_effects::Network effects [concurrency]
	request(operation, subject, bytes, remaining_ms, cancelled) => failing_shutdown_system_network_reply(direction, commit, io_ready, io_release, shutdown_ready, shutdown_release, shutdown_calls, operation, subject, bytes)
end

handler deadline_system_resolver(ready: Sender<()>) for host_effects::Network effects [concurrency]
	request(operation, subject, bytes, remaining_ms, cancelled) => if operation == "resolve_tcp4" and subject == "stalled.test"
		begin
			let _ = channel::send(ready, ())
			system_network_reply("error", "", "", "", list_nil(), 0, "timed_out", 0, "resolver deadline elapsed")
		end
	else
		system_network_reply("error", "", "", "", list_nil(), 0, "invalid_input", 0, "unexpected deadline resolver request")
	end
end

handler cancelling_system_resolver(owner: CancelOwner, ready: Sender<()>) for host_effects::Network effects [time, concurrency]
	request(operation, subject, bytes, remaining_ms, cancelled) => if operation == "resolve_tcp4" and subject == "stalled.test"
		begin
			let _ = channel::send(ready, ())
			time::cancel_owned(owner)
			system_network_reply("error", "", "", "", list_nil(), 0, "cancelled", 0, "resolver was cancelled")
		end
	else
		system_network_reply("error", "", "", "", list_nil(), 0, "invalid_input", 0, "unexpected cancellation resolver request")
	end
end

handler task_stalled_system_resolver(ready: Sender<()>, release: Receiver<()>) for host_effects::Network effects [concurrency]
	request(operation, subject, bytes, remaining_ms, cancelled) => if operation == "resolve_tcp4" and subject == "stalled.test"
		begin
			let _ = channel::send(ready, ())
			let _ = channel::recv(release)
			system_network_reply("ok", "", "", "", list_cons({ network: "tcp4", address: "192.0.2.60" }, list_nil()), 0, "", 0, "")
		end
	else
		system_network_reply("error", "", "", "", list_nil(), 0, "invalid_input", 0, "unexpected task resolver request")
	end
end

handler commit_cancelling_system_network(owner: CancelOwner) for host_effects::Network effects [time]
	request(operation, subject, bytes, remaining_ms, cancelled) => if operation == "resolve_tcp4" and subject == "commit.test"
		system_network_reply("ok", "", "", "", list_cons({ network: "tcp4", address: "192.0.2.61" }, list_nil()), 0, "", 0, "")
	else if operation == "connect" and subject == "192.0.2.61:443"
		begin
			time::cancel_owned(owner)
			system_network_success("committed-stream", "192.0.2.62:50000", "192.0.2.61:443")
		end
	else if operation == "close_stream" and subject == "committed-stream"
		system_network_success("", "", "")
	else
		system_network_reply("error", "", "", "", list_nil(), 0, "invalid_input", 0, "unexpected commit request")
	end
end

handler ordered_deduplicated_system_network(attempts: { tx : Sender<Int>, rx : Receiver<Int> }) for host_effects::Network effects [concurrency]
	request(operation, subject, bytes, remaining_ms, cancelled) => if operation == "resolve_tcp4" and subject == "ordered.test"
		system_network_reply("ok", "", "", "", list_cons({ network: "tcp4", address: "192.0.2.70" }, list_cons({ network: "tcp4", address: "192.0.2.70" }, list_cons({ network: "tcp4", address: "192.0.2.71" }, list_nil()))), 0, "", 0, "")
	else if operation == "connect" and subject == "192.0.2.70:443"
		match channel::recv(attempts.rx)
			Some(0) => begin
				let _ = channel::send(attempts.tx, 1)
				system_network_reply("error", "", "", "", list_nil(), 0, "connection_refused", 0, "first endpoint refused")
			end
			_ => system_network_reply("error", "", "", "", list_nil(), 0, "invalid_input", 0, "first endpoint was retried or reordered")
		end
	else if operation == "connect" and subject == "192.0.2.71:443"
		match channel::recv(attempts.rx)
			Some(1) => begin
				let _ = channel::send(attempts.tx, 2)
				system_network_success("ordered-stream", "192.0.2.72:50000", "192.0.2.71:443")
			end
			_ => system_network_reply("error", "", "", "", list_nil(), 0, "invalid_input", 0, "second endpoint was attempted out of order")
		end
	else if operation == "close_stream" and subject == "ordered-stream"
		system_network_success("", "", "")
	else
		system_network_reply("error", "", "", "", list_nil(), 0, "invalid_input", 0, "unexpected ordered-connect request")
	end
end

handler controlled_endpoint_system_network(kind: String, attempts: { tx : Sender<Int>, rx : Receiver<Int> }) for host_effects::Network effects [concurrency]
	request(operation, subject, bytes, remaining_ms, cancelled) => if operation == "resolve_tcp4" and subject == "controlled.test"
		system_network_reply("ok", "", "", "", list_cons({ network: "tcp4", address: "192.0.2.80" }, list_cons({ network: "tcp4", address: "192.0.2.81" }, list_nil())), 0, "", 0, "")
	else if operation == "connect" and subject == "192.0.2.80:443"
		match channel::recv(attempts.rx)
			Some(count) => begin
				let _ = channel::send(attempts.tx, count + 1)
				system_network_reply("error", "", "", "", list_nil(), 0, kind, 0, "first endpoint control outcome")
			end
			None => system_network_reply("error", "", "", "", list_nil(), 0, "invalid_input", 0, "missing endpoint attempt count")
		end
	else if operation == "connect" and subject == "192.0.2.81:443"
		match channel::recv(attempts.rx)
			Some(count) => begin
				let _ = channel::send(attempts.tx, count + 1)
				system_network_success("unexpected-stream", "192.0.2.82:50000", "192.0.2.81:443")
			end
			None => system_network_reply("error", "", "", "", list_nil(), 0, "invalid_input", 0, "missing second endpoint attempt count")
		end
	else if operation == "close_stream" and subject == "unexpected-stream"
		system_network_success("", "", "")
	else
		system_network_reply("error", "", "", "", list_nil(), 0, "invalid_input", 0, "unexpected controlled-connect request")
	end
end

fn retrying_close_system_network_reply(calls: { tx : Sender<Int>, rx : Receiver<Int> }, operation: String, subject: String) -> { status : String, value : String, local : String, peer : String, bytes : ByteChunk, resolved_endpoints : List<{ network : String, address : String }>, bytes_committed : Int, category : String, phase : String, input_committed : Int, output_committed : Int, ownership_committed : Int, cause : String } effects [concurrency]
	if operation == "resolve_tcp4" and subject == "127.0.0.1"
		system_network_reply("ok", "", "", "", list_cons({ network: "tcp4", address: "127.0.0.1" }, list_nil()), 0, "", 0, "")
	else if operation == "listen" and subject == "127.0.0.1:0"
		system_network_success("retry-listener", "127.0.0.1:41000", "")
	else if operation == "resolve_tcp4" and subject == "retry.test"
		system_network_reply("ok", "", "", "", list_cons({ network: "tcp4", address: "192.0.2.40" }, list_nil()), 0, "", 0, "")
	else if operation == "connect" and subject == "192.0.2.40:443"
		system_network_success("retry-stream", "192.0.2.41:41001", "192.0.2.40:443")
	else if (operation == "close_listener" and subject == "retry-listener") or (operation == "close_stream" and subject == "retry-stream")
		match channel::recv(calls.rx)
			Some(count) => begin
				let _ = channel::send(calls.tx, count + 1)
				if count == 0
					system_network_reply("error", "", "", "", list_nil(), 0, "forced_failure", 0, "first close failed")
				else
					system_network_success("", "", "")
				end
			end
			None => system_network_reply("error", "", "", "", list_nil(), 0, "forced_failure", 0, "missing close count")
		end
	else
		system_network_reply("error", "", "", "", list_nil(), 0, "invalid_input", 0, "unexpected close-retry request")
	end
end

fn committed_close_system_network_reply(commit: Int, calls: { tx : Sender<Int>, rx : Receiver<Int> }, operation: String, subject: String) -> { status : String, value : String, local : String, peer : String, bytes : ByteChunk, resolved_endpoints : List<{ network : String, address : String }>, bytes_committed : Int, category : String, phase : String, input_committed : Int, output_committed : Int, ownership_committed : Int, cause : String } effects [concurrency]
	if operation == "resolve_tcp4" and subject == "127.0.0.1"
		system_network_reply("ok", "", "", "", list_cons({ network: "tcp4", address: "127.0.0.1" }, list_nil()), 0, "", 0, "")
	else if operation == "listen" and subject == "127.0.0.1:0"
		system_network_success("retry-listener", "127.0.0.1:41000", "")
	else if operation == "resolve_tcp4" and subject == "retry.test"
		system_network_reply("ok", "", "", "", list_cons({ network: "tcp4", address: "192.0.2.40" }, list_nil()), 0, "", 0, "")
	else if operation == "connect" and subject == "192.0.2.40:443"
		system_network_success("retry-stream", "192.0.2.41:41001", "192.0.2.40:443")
	else if (operation == "close_listener" and subject == "retry-listener") or (operation == "close_stream" and subject == "retry-stream")
		match channel::recv(calls.rx)
			Some(count) => begin
				let _ = channel::send(calls.tx, count + 1)
				if count == 0
					system_network_close_failure(commit)
				else
					system_network_success("", "", "")
				end
			end
			None => system_network_close_failure(commit)
		end
	else
		system_network_reply("error", "", "", "", list_nil(), 0, "invalid_input", 0, "unexpected committed-close request")
	end
end

fn contended_system_network_reply(direction: String, ready: Sender<()>, release: Receiver<()>, operation: String, subject: String, bytes: ByteChunk) -> { status : String, value : String, local : String, peer : String, bytes : ByteChunk, resolved_endpoints : List<{ network : String, address : String }>, bytes_committed : Int, category : String, phase : String, input_committed : Int, output_committed : Int, ownership_committed : Int, cause : String } effects [concurrency]
	if operation == "resolve_tcp4" and subject == "contention.test"
		system_network_reply("ok", "", "", "", list_cons({ network: "tcp4", address: "192.0.2.20" }, list_nil()), 0, "", 0, "")
	else if operation == "connect" and subject == "192.0.2.20:443"
		system_network_success("contended-stream", "192.0.2.30:50000", "192.0.2.20:443")
	else if operation == direction and subject == "contended-stream"
		begin
			let _ = channel::send(ready, ())
			let _ = channel::recv(release)
			if operation == "read"
				match byte_chunk_from_visible_ascii_string("r")
					Ok(chunk) => system_network_read_success(chunk)
					Err(message) => system_network_reply("error", "", "", "", list_nil(), 0, "invalid_input", 0, message)
				end
			else
				system_network_reply("ok", "", "", "", list_nil(), byte_count_to_int(byte_chunk_count(bytes)), "", 0, "")
			end
		end
	else if (operation == "shutdown_read" or operation == "shutdown_write") and subject == "contended-stream"
		system_network_success("", "", "")
	else if operation == "read" and subject == "contended-stream"
		match byte_chunk_from_visible_ascii_string("r")
			Ok(chunk) => system_network_read_success(chunk)
			Err(message) => system_network_reply("error", "", "", "", list_nil(), 0, "invalid_input", 0, message)
		end
	else if operation == "close_stream" and subject == "contended-stream"
		system_network_success("", "", "")
	else
		system_network_reply("error", "", "", "", list_nil(), 0, "invalid_input", 0, "unexpected contention request")
	end
end

fn failing_shutdown_system_network_reply(direction: String, commit: Int, io_ready: Sender<()>, io_release: Receiver<()>, shutdown_ready: Sender<()>, shutdown_release: Receiver<()>, shutdown_calls: { tx : Sender<Int>, rx : Receiver<Int> }, operation: String, subject: String, bytes: ByteChunk) -> { status : String, value : String, local : String, peer : String, bytes : ByteChunk, resolved_endpoints : List<{ network : String, address : String }>, bytes_committed : Int, category : String, phase : String, input_committed : Int, output_committed : Int, ownership_committed : Int, cause : String } effects [concurrency]
	if operation == "resolve_tcp4" and subject == "contention.test"
		system_network_reply("ok", "", "", "", list_cons({ network: "tcp4", address: "192.0.2.20" }, list_nil()), 0, "", 0, "")
	else if operation == "connect" and subject == "192.0.2.20:443"
		system_network_success("contended-stream", "192.0.2.30:50000", "192.0.2.20:443")
	else if operation == direction and subject == "contended-stream"
		begin
			let _ = channel::send(io_ready, ())
			let _ = channel::recv(io_release)
			if direction == "read"
				match byte_chunk_from_visible_ascii_string("r")
					Ok(chunk) => system_network_read_success(chunk)
					Err(message) => system_network_reply("error", "", "", "", list_nil(), 0, "invalid_input", 0, message)
				end
			else
				system_network_reply("ok", "", "", "", list_nil(), byte_count_to_int(byte_chunk_count(bytes)), "", 0, "")
			end
		end
	else if ((direction == "read" and operation == "shutdown_read") or (direction == "write" and operation == "shutdown_write")) and subject == "contended-stream"
		match channel::recv(shutdown_calls.rx)
			Some(count) => begin
				let _ = channel::send(shutdown_calls.tx, count + 1)
				if count == 0
					begin
						let _ = channel::send(shutdown_ready, ())
						let _ = channel::recv(shutdown_release)
						system_network_shutdown_failure(direction, commit)
					end
				else
					system_network_success("", "", "")
				end
			end
			None => system_network_reply("error", "", "", "", list_nil(), 0, "forced_failure", 0, "missing shutdown count")
		end
	else if operation == "close_stream" and subject == "contended-stream"
		system_network_success("", "", "")
	else
		system_network_reply("error", "", "", "", list_nil(), 0, "invalid_input", 0, "unexpected failed-shutdown request")
	end
end

fn scripted_system_network_reply(scenario: String, operation: String, subject: String) -> { status : String, value : String, local : String, peer : String, bytes : ByteChunk, resolved_endpoints : List<{ network : String, address : String }>, bytes_committed : Int, category : String, phase : String, input_committed : Int, output_committed : Int, ownership_committed : Int, cause : String }
	if scenario == "accept-end" and operation == "resolve_tcp4" and subject == "ended.test"
		system_network_reply("ok", "", "", "", list_cons({ network: "tcp4", address: "192.0.2.90" }, list_nil()), 0, "", 0, "")
	else if scenario == "accept-end" and operation == "listen" and subject == "192.0.2.90:0"
		system_network_success("ended-listener", "192.0.2.90:43000", "")
	else if scenario == "accept-end" and operation == "accept" and subject == "ended-listener"
		system_network_reply("end", "", "", "", list_nil(), 0, "", 0, "")
	else if scenario == "accept-end" and operation == "close_listener" and subject == "ended-listener"
		system_network_success("", "", "")
	else if scenario == "resolver-order" and operation == "resolve_tcp" and subject == "ordered.test"
		system_network_reply("ok", "", "", "", list_cons({ network: "tcp6", address: "2001:db8::2" }, list_cons({ network: "tcp4", address: "192.0.2.1" }, list_cons({ network: "tcp6", address: "2001:db8::2" }, list_cons({ network: "tcp4", address: "192.0.2.2" }, list_nil())))), 0, "", 0, "")
	else if scenario == "resolver-empty" and operation == "resolve_tcp6" and subject == "empty.test"
		system_network_success("", "", "")
	else if scenario == "resolver-failure" and operation == "resolve_tcp4" and subject == "denied.test"
		system_network_reply("error", "", "", "", list_nil(), 0, "permission_denied", -1, "resolver access denied")
	else if scenario == "tcp-connect" and operation == "resolve_tcp" and subject == "tcp.test"
		system_network_reply("ok", "", "", "", list_cons({ network: "tcp4", address: "192.0.2.20" }, list_nil()), 0, "", 0, "")
	else if scenario == "tcp4-connect" and operation == "resolve_tcp4" and subject == "tcp4.test"
		system_network_reply("ok", "", "", "", list_cons({ network: "tcp4", address: "192.0.2.21" }, list_nil()), 0, "", 0, "")
	else if scenario == "tcp6-connect" and operation == "resolve_tcp6" and subject == "tcp6.test"
		system_network_reply("ok", "", "", "", list_cons({ network: "tcp6", address: "2001:db8::21" }, list_nil()), 0, "", 0, "")
	else if scenario == "tcp-connect" and operation == "connect" and subject == "192.0.2.20:443"
		system_network_success("family-stream", "192.0.2.30:50000", "192.0.2.20:443")
	else if scenario == "tcp4-connect" and operation == "connect" and subject == "192.0.2.21:443"
		system_network_success("family-stream", "192.0.2.30:50000", "192.0.2.21:443")
	else if scenario == "tcp6-connect" and operation == "connect" and subject == "[2001:db8::21]:443"
		system_network_success("family-stream", "[2001:db8::30]:50000", "[2001:db8::21]:443")
	else if (scenario == "tcp-connect" or scenario == "tcp4-connect" or scenario == "tcp6-connect") and operation == "close_stream" and subject == "family-stream"
		system_network_success("", "", "")
	else if scenario == "tcp-listen" and operation == "resolve_tcp" and subject == "listen.test"
		system_network_reply("ok", "", "", "", list_cons({ network: "tcp4", address: "192.0.2.50" }, list_nil()), 0, "", 0, "")
	else if scenario == "tcp4-listen" and operation == "resolve_tcp4" and subject == "listen4.test"
		system_network_reply("ok", "", "", "", list_cons({ network: "tcp4", address: "192.0.2.51" }, list_nil()), 0, "", 0, "")
	else if scenario == "tcp6-listen" and operation == "resolve_tcp6" and subject == "listen6.test"
		system_network_reply("ok", "", "", "", list_cons({ network: "tcp6", address: "2001:db8::51" }, list_nil()), 0, "", 0, "")
	else if scenario == "tcp-listen" and operation == "listen" and subject == "192.0.2.50:0"
		system_network_success("family-listener", "192.0.2.50:42000", "")
	else if scenario == "tcp4-listen" and operation == "listen" and subject == "192.0.2.51:0"
		system_network_success("family-listener", "192.0.2.51:42001", "")
	else if scenario == "tcp6-listen" and operation == "listen" and subject == "[2001:db8::51]:0"
		system_network_success("family-listener", "[2001:db8::51]:42002", "")
	else if scenario == "tcp-listen" and operation == "listener_local_addr" and subject == "family-listener"
		system_network_success("192.0.2.50:42000", "", "")
	else if scenario == "tcp4-listen" and operation == "listener_local_addr" and subject == "family-listener"
		system_network_success("192.0.2.51:42001", "", "")
	else if scenario == "tcp6-listen" and operation == "listener_local_addr" and subject == "family-listener"
		system_network_success("[2001:db8::51]:42002", "", "")
	else if (scenario == "tcp-listen" or scenario == "tcp4-listen" or scenario == "tcp6-listen") and operation == "accept" and subject == "family-listener"
		if scenario == "tcp6-listen"
			system_network_success("family-accepted", "[2001:db8::51]:42002", "[2001:db8::52]:52002")
		else if scenario == "tcp-listen"
			system_network_success("family-accepted", "192.0.2.50:42000", "192.0.2.52:52000")
		else
			system_network_success("family-accepted", "192.0.2.51:42001", "192.0.2.52:52001")
		end
	else if scenario == "tcp-listen" and operation == "stream_local_addr" and subject == "family-accepted"
		system_network_success("192.0.2.50:42000", "", "")
	else if scenario == "tcp-listen" and operation == "stream_peer_addr" and subject == "family-accepted"
		system_network_success("192.0.2.52:52000", "", "")
	else if scenario == "tcp4-listen" and operation == "stream_local_addr" and subject == "family-accepted"
		system_network_success("192.0.2.51:42001", "", "")
	else if scenario == "tcp4-listen" and operation == "stream_peer_addr" and subject == "family-accepted"
		system_network_success("192.0.2.52:52001", "", "")
	else if scenario == "tcp6-listen" and operation == "stream_local_addr" and subject == "family-accepted"
		system_network_success("[2001:db8::51]:42002", "", "")
	else if scenario == "tcp6-listen" and operation == "stream_peer_addr" and subject == "family-accepted"
		system_network_success("[2001:db8::52]:52002", "", "")
	else if (scenario == "tcp-listen" or scenario == "tcp4-listen" or scenario == "tcp6-listen") and (operation == "close_stream" and subject == "family-accepted" or operation == "close_listener" and subject == "family-listener")
		system_network_success("", "", "")
	else if (scenario == "write-success" or scenario == "write-failure" or scenario == "write-deadline" or scenario == "write-cancelled" or scenario == "write-error-deadline" or scenario == "write-error-cancelled" or scenario == "read-error-deadline" or scenario == "read-error-cancelled" or scenario == "empty-read") and operation == "resolve_tcp4" and subject == "write.test"
		system_network_reply("ok", "", "", "", list_cons({ network: "tcp4", address: "192.0.2.10" }, list_nil()), 0, "", 0, "")
	else if (scenario == "write-success" or scenario == "write-failure" or scenario == "write-deadline" or scenario == "write-cancelled" or scenario == "write-error-deadline" or scenario == "write-error-cancelled" or scenario == "read-error-deadline" or scenario == "read-error-cancelled" or scenario == "empty-read") and operation == "connect" and subject == "192.0.2.10:443"
		system_network_success("scripted-stream", "192.0.2.20:50000", "192.0.2.10:443")
	else if scenario == "write-success" and operation == "write" and subject == "scripted-stream"
		system_network_reply("ok", "", "192.0.2.20:50000", "192.0.2.10:443", list_nil(), 4, "", 1, "")
	else if scenario == "write-failure" and operation == "write" and subject == "scripted-stream"
		system_network_reply("error", "", "192.0.2.20:50000", "192.0.2.10:443", list_nil(), 4, "connection_reset", -1, "peer reset after prefix")
	else if scenario == "write-deadline" and operation == "write" and subject == "scripted-stream"
		system_network_reply("deadline", "", "192.0.2.20:50000", "192.0.2.10:443", list_nil(), 3, "", -1, "")
	else if scenario == "write-cancelled" and operation == "write" and subject == "scripted-stream"
		system_network_reply("cancelled", "", "192.0.2.20:50000", "192.0.2.10:443", list_nil(), 3, "", -1, "")
	else if scenario == "write-error-deadline" and operation == "write" and subject == "scripted-stream"
		system_network_reply("error", "", "192.0.2.20:50000", "192.0.2.10:443", list_nil(), 2, "timed_out", -1, "scripted timeout")
	else if scenario == "write-error-cancelled" and operation == "write" and subject == "scripted-stream"
		system_network_reply("error", "", "192.0.2.20:50000", "192.0.2.10:443", list_nil(), 2, "cancelled", -1, "scripted cancellation")
	else if scenario == "read-error-deadline" and operation == "read" and subject == "scripted-stream"
		system_network_reply("error", "", "192.0.2.20:50000", "192.0.2.10:443", list_nil(), 0, "timed_out", 0, "scripted timeout")
	else if scenario == "read-error-cancelled" and operation == "read" and subject == "scripted-stream"
		system_network_reply("error", "", "192.0.2.20:50000", "192.0.2.10:443", list_nil(), 0, "cancelled", 0, "scripted cancellation")
	else if scenario == "empty-read" and operation == "read" and subject == "scripted-stream"
		system_network_read_success(byte_chunk([]))
	else if (scenario == "write-success" or scenario == "write-failure" or scenario == "write-deadline" or scenario == "write-cancelled" or scenario == "write-error-deadline" or scenario == "write-error-cancelled" or scenario == "read-error-deadline" or scenario == "read-error-cancelled" or scenario == "empty-read") and operation == "close_stream" and subject == "scripted-stream"
		system_network_success("", "192.0.2.20:50000", "192.0.2.10:443")
	else
		system_network_reply("error", "", "", "", list_nil(), 0, "invalid_input", 0, "unexpected scripted network request")
	end
end

fn system_scripted_write() -> net::WriteOutcome effects [net::IO]
	match net::connect(net::Address(net::Tcp4, "write.test", 443))
		Ok(stream) => match byte_chunk_from_visible_ascii_string("abcdef")
			Ok(bytes) => net::write(stream, bytes)
			Err(message) => net::WriteFailed(net::ByteCount(0), net::NetError("write", None, None, net::Other, message))
		end
		Err(error) => net::WriteFailed(net::ByteCount(0), error)
	end
end

fn system_rejects_empty_successful_read() -> Result<(), String> effects [net::IO]
	match net::connect(net::Address(net::Tcp4, "write.test", 443))
		Ok(stream) => match net::read(stream)
			Err(net::NetError("read", _, _, net::Other, _)) => match net::read(stream)
				Err(net::NetError("read", _, _, net::Closed, _)) => Ok(())
				_ => Err("malformed read did not close the failed read half")
			end
			_ => Err("empty successful host read was not rejected")
		end
		Err(_) => Err("scripted stream did not connect")
	end
end

fn system_explicit_close_failure(kind: String) -> Result<(), String> effects [net::IO]
	if kind == "listener"
		match net::listen(net::Address(net::Tcp4, "127.0.0.1", 0))
			Ok(listener) => match net::close_listener(listener)
				Err(_) => match net::close_listener(listener)
					Ok(()) => match net::close_listener(listener)
						Ok(()) => Ok(())
						Err(_) => Err("confirmed listener close was not idempotent")
					end
					Err(_) => Err("second listener close did not retry")
				end
				Ok(()) => Err("first listener close unexpectedly succeeded")
			end
			Err(_) => Err("scripted listener did not open")
		end
	else
		match net::connect(net::Address(net::Tcp4, "retry.test", 443))
			Ok(stream) => match net::close_stream(stream)
				Err(_) => match net::close_stream(stream)
					Ok(()) => match net::close_stream(stream)
						Ok(()) => Ok(())
						Err(_) => Err("confirmed stream close was not idempotent")
					end
					Err(_) => Err("second stream close did not retry")
				end
				Ok(()) => Err("first stream close unexpectedly succeeded")
			end
			Err(_) => Err("scripted stream did not connect")
		end
	end
end

