	match tcp
		Ok({ listener: net::Endpoint(net::Tcp4, _), local: net::Endpoint(net::Tcp4, _), peer: net::Endpoint(net::Tcp4, _) }) => match tcp4
			Ok({ listener: net::Endpoint(net::Tcp4, _), local: net::Endpoint(net::Tcp4, _), peer: net::Endpoint(net::Tcp4, _) }) => match tcp6
				Ok({ listener: net::Endpoint(net::Tcp6, _), local: net::Endpoint(net::Tcp6, _), peer: net::Endpoint(net::Tcp6, _) }) => Ok(())
				_ => Err("TCP6 listen, accept, or address behavior changed")
			end
			_ => Err("TCP4 listen, accept, or address behavior changed")
		end
		_ => Err("TCP listen, accept, or address behavior changed")
	end
end

