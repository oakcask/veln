use event
use observe
use observe_test_support_test

test emit_preserves_name_typed_attributes_context_and_user_callsite_once() -> Result<(), String> effects [concurrency]
	let records = observe_test_support_test::records(2)
	let attributes = observe_test_support_test::o1_attributes()
	let _ = handle event::emit(observe_test_support_test::o1_context(), "checkout.completed", attributes) with observe_test_support_test::recording(records.tx)
	channel::close(records.tx)
	match channel::recv(records.rx)
		Some(observe::Event(observe::EventRecord("checkout.completed", Cons(observe::Attribute("enabled", observe::BoolValue(true)), Cons(observe::Attribute("attempt", observe::IntValue(3)), Cons(observe::Attribute("route", observe::StringValue("checkout")), Nil))), Some(observe::TraceContext("trace-1", "span-2")), source))) => if source.file == "event.test.veln" and source.start_line == 8
			match channel::recv(records.rx)
				None => Ok(())
				Some(_) => Err("event emitted more than one observation")
			end
		else
			Err("event source location changed")
		end
		Some(_) => Err("event fields changed")
		None => Err("event emitted no observation")
	end
end

test emit_preserves_empty_attributes_and_absent_context() -> Result<(), String> effects [concurrency]
	let records = observe_test_support_test::records(2)
	let _ = handle event::emit(None, "cache.miss", list_nil()) with observe_test_support_test::recording(records.tx)
	channel::close(records.tx)
	match channel::recv(records.rx)
		Some(observe::Event(observe::EventRecord("cache.miss", Nil, None, source))) => if source.file == "event.test.veln" and source.start_line == 26
			match channel::recv(records.rx)
				None => Ok(())
				Some(_) => Err("empty event emitted more than one observation")
			end
		else
			Err("empty event source location changed")
		end
		Some(_) => Err("empty event fields changed")
		None => Err("empty event emitted no observation")
	end
end

test callsite_wrapper_forwards_the_outer_source() -> Result<(), String> effects [concurrency]
	let records = observe_test_support_test::records(2)
	let _ = handle emit_wrapped() with observe_test_support_test::recording(records.tx)
	channel::close(records.tx)
	match channel::recv(records.rx)
		Some(observe::Event(observe::EventRecord("wrapped", Nil, None, source))) => if source.file == "event.test.veln" and source.start_line == 44
			match channel::recv(records.rx)
				None => Ok(())
				Some(_) => Err("wrapped event emitted more than one observation")
			end
		else
			Err("event wrapper did not forward the outer source")
		end
		Some(_) => Err("wrapped event fields changed")
		None => Err("wrapped event emitted no observation")
	end
end

test noop_discards_event_and_preserves_body_result() -> Result<(), String>
	let result = handle begin
		event::emit(None, "discarded", list_nil())
		73
	end with observe::noop()
	if result == 73
		Ok(())
	else
		Err("no-op event handling changed the body result")
	end
end

fn emit_wrapped() -> () effects [observe::Observe] callsite
	event::emit(None, "wrapped", list_nil())
end
