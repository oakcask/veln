	if http2::hpack::dynamic_table_entry_count(zero) == 0 and http2::hpack::dynamic_table_entry_count(ignored) == 0 and http2::hpack::dynamic_table_entry_count(grown) == 0 and dynamic_entry_matches(inserted, 1, "bb", byte_chunk_from_hex("3232")?)?
