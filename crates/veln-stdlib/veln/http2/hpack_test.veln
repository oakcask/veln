test dynamic_table_inserts_newest_first_with_exact_octet_size() -> Result<(), String>
	let empty = http2::hpack::empty_dynamic_table(128)?
	let first_value = byte_chunk_from_hex("31")?
	let second_value = byte_chunk_from_hex("3232")?
	let first = http2::hpack::insert_dynamic_table_entry(empty, "a", first_value)?
	let second = http2::hpack::insert_dynamic_table_entry(first, "bb", second_value)?
	let entries_match = dynamic_entry_matches(second, 1, "bb", second_value)? and dynamic_entry_matches(second, 2, "a", first_value)?
	let original_preserved = http2::hpack::dynamic_table_size(empty) == 0 and http2::hpack::dynamic_table_entry_count(empty) == 0 and http2::hpack::dynamic_table_size(first) == 34 and http2::hpack::dynamic_table_entry_count(first) == 1
	if entries_match and original_preserved and http2::hpack::dynamic_table_size(second) == 70 and http2::hpack::dynamic_table_entry_count(second) == 2
		Ok(())
	else
		Err("HPACK dynamic table insertion or size accounting changed")
	end
end

test dynamic_table_evicts_oldest_entries_until_the_newest_prefix_fits() -> Result<(), String>
