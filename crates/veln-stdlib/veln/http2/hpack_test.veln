	let first = http2::hpack::insert_dynamic_table_entry(empty, "a", byte_chunk_from_hex("31")?)?
	let second = http2::hpack::insert_dynamic_table_entry(first, "bb", byte_chunk_from_hex("3232")?)?
	let third = http2::hpack::insert_dynamic_table_entry(second, "ccc", byte_chunk_from_hex("333333")?)?
	let retained_match = dynamic_entry_matches(third, 1, "ccc", byte_chunk_from_hex("333333")?)? and dynamic_entry_matches(third, 2, "bb", byte_chunk_from_hex("3232")?)?
	if retained_match and dynamic_entry_is_missing(third, 3) and http2::hpack::dynamic_table_size(third) == 74 and http2::hpack::dynamic_table_entry_count(third) == 2
		Ok(())
	else
