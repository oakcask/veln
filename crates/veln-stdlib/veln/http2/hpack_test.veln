test dynamic_table_capacity_changes_are_immutable_and_evict_when_shrinking() -> Result<(), String>
	let empty = http2::hpack::empty_dynamic_table(100)?
	let first = http2::hpack::insert_dynamic_table_entry(empty, "a", byte_chunk_from_hex("31")?)?
	let original = http2::hpack::insert_dynamic_table_entry(first, "bb", byte_chunk_from_hex("3232")?)?
	let shrunk = http2::hpack::dynamic_table_with_capacity(original, 36)?
	let grown = http2::hpack::dynamic_table_with_capacity(shrunk, 160)?
	let shrunk_match = dynamic_entry_matches(shrunk, 1, "bb", byte_chunk_from_hex("3232")?)? and dynamic_entry_is_missing(shrunk, 2)
	let grown_match = dynamic_entry_matches(grown, 1, "bb", byte_chunk_from_hex("3232")?)?
	let original_preserved = http2::hpack::dynamic_table_capacity(original) == 100 and http2::hpack::dynamic_table_size(original) == 70 and http2::hpack::dynamic_table_entry_count(original) == 2
	if shrunk_match and grown_match and original_preserved and http2::hpack::dynamic_table_capacity(shrunk) == 36 and http2::hpack::dynamic_table_size(shrunk) == 36 and http2::hpack::dynamic_table_capacity(grown) == 160 and http2::hpack::dynamic_table_size(grown) == 36
		Ok(())
	else
		Err("HPACK dynamic table capacity transition changed")
	end
end

