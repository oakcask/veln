	let original_match = http2::hpack::dynamic_table_capacity(table) == 100 and http2::hpack::dynamic_table_size(table) == 70 and http2::hpack::dynamic_table_entry_count(table) == 2
	if shrink_match and growth_match and original_match
		Ok(())
	else
		Err("HPACK table-size update immutable capacity transition changed")
	end
end

test table_size_update_decoder_returns_focused_failures_without_changing_state() -> Result<(), String>
	let table = http2::hpack::insert_dynamic_table_entry(http2::hpack::empty_dynamic_table(64)?, "x", byte_chunk_from_hex("00ff")?)?
	let failure_kinds_match = table_size_update_failure_matches(byte_chunk_from_hex("80")?, table, 64, "not_table_size_update")? and table_size_update_failure_matches(byte_chunk([]), table, 64, "incomplete_integer")? and table_size_update_failure_matches(byte_chunk_from_hex("3f80")?, table, 64, "incomplete_integer")? and table_size_update_failure_matches(byte_chunk_from_hex("3f80808080808080808000")?, table, 64, "malformed_integer")?
	let limit_match = match decode_table_size_update_chunk(byte_chunk_from_hex("3f3a")?, table, 64)?
		Err(failure) => http2::hpack::table_size_update_failure_kind(failure) == "capacity_limit" and http2::hpack::table_size_update_failure_capacity(failure) == 89 and http2::hpack::table_size_update_failure_peer_maximum(failure) == 64
		Ok(_) => false
	end
	if failure_kinds_match and limit_match and http2::hpack::dynamic_table_capacity(table) == 64 and http2::hpack::dynamic_table_size(table) == 35 and dynamic_entry_matches(table, 1, "x", byte_chunk_from_hex("00ff")?)?
		Ok(())
	else
		Err("HPACK table-size update failure classification or state preservation changed")
	end
end

test header_block_decoder_preserves_order_octets_and_dynamic_transitions() -> Result<(), String>
	let table = http2::hpack::empty_dynamic_table(256)?
	let empty = require_header_block(byte_chunk([]), table, 256)?
	let mixed = require_header_block(byte_chunk_from_hex("824001780200ffbe04012f")?, table, 256)?
	let headers = http2::hpack::header_block_headers(mixed)
	let next_table = http2::hpack::header_block_table(mixed)
	let fields_match = header_list_entry_matches(headers, 0, ":method", byte_chunk_from_hex("474554")?)? and header_list_entry_matches(headers, 1, "x", byte_chunk_from_hex("00ff")?)? and header_list_entry_matches(headers, 2, "x", byte_chunk_from_hex("00ff")?)? and header_list_entry_matches(headers, 3, ":path", byte_chunk_from_hex("2f")?)?
	if http2::hpack::header_list_count(http2::hpack::header_block_headers(empty)) == 0 and http2::hpack::header_block_consumed(empty) == 0 and http2::hpack::header_list_count(headers) == 4 and http2::hpack::header_block_consumed(mixed) == 11 and fields_match and dynamic_entry_matches(next_table, 1, "x", byte_chunk_from_hex("00ff")?)? and http2::hpack::dynamic_table_entry_count(table) == 0
		Ok(())
	else
		Err("HPACK ordered header-block decoding or immutable transition changed")
	end
end

test header_block_decoder_composes_every_literal_form_and_list_boundaries() -> Result<(), String>
	let table = http2::hpack::empty_dynamic_table(256)?
	let transition = require_header_block(byte_chunk_from_hex("44072f74617267657404052f736b697014072f736563726574008349509f026f6b0485ffc7ffffdd")?, table, 256)?
	let headers = http2::hpack::header_block_headers(transition)
	let fields_match = header_list_entry_matches(headers, 0, ":path", byte_chunk_from_hex("2f746172676574")?)? and header_list_entry_matches(headers, 1, ":path", byte_chunk_from_hex("2f736b6970")?)? and header_list_entry_matches(headers, 2, ":path", byte_chunk_from_hex("2f736563726574")?)? and header_list_entry_matches(headers, 3, "test", byte_chunk_from_hex("6f6b")?)? and header_list_entry_matches(headers, 4, ":path", byte_chunk_from_hex("00ff")?)?
	let list_boundaries_match = match http2::hpack::header_list_at(headers, -1)
		None => match http2::hpack::header_list_at(headers, 5)
			None => true
			Some(_) => false
		end
		Some(_) => false
	end
	let next_table = http2::hpack::header_block_table(transition)
	if http2::hpack::header_list_count(headers) == 5 and http2::hpack::header_block_consumed(transition) == 40 and fields_match and list_boundaries_match and http2::hpack::dynamic_table_entry_count(next_table) == 1 and dynamic_entry_matches(next_table, 1, ":path", byte_chunk_from_hex("2f746172676574")?)? and http2::hpack::dynamic_table_entry_count(table) == 0
		Ok(())
	else
		Err("HPACK header-block literal composition or list boundary changed")
	end
end

test header_block_decoder_reuses_next_table_and_accepts_update_only_blocks() -> Result<(), String>
	let table = http2::hpack::insert_dynamic_table_entry(http2::hpack::empty_dynamic_table(128)?, "original", byte_chunk_from_hex("31")?)?
	let inserted = require_header_block(byte_chunk_from_hex("4001780132")?, table, 128)?
	let reused = require_header_block(byte_chunk_from_hex("be")?, http2::hpack::header_block_table(inserted), 128)?
	let updated = require_header_block(byte_chunk_from_hex("203f21")?, table, 128)?
	let reuse_matches = http2::hpack::header_block_consumed(reused) == 1 and header_list_entry_matches(http2::hpack::header_block_headers(reused), 0, "x", byte_chunk_from_hex("32")?)?
	let update_matches = http2::hpack::header_block_consumed(updated) == 3 and http2::hpack::header_list_count(http2::hpack::header_block_headers(updated)) == 0 and http2::hpack::dynamic_table_capacity(http2::hpack::header_block_table(updated)) == 64 and http2::hpack::dynamic_table_entry_count(http2::hpack::header_block_table(updated)) == 0
	if reuse_matches and update_matches and http2::hpack::dynamic_table_capacity(table) == 128 and dynamic_entry_matches(table, 1, "original", byte_chunk_from_hex("31")?)?
		Ok(())
	else
		Err("HPACK header-block cross-decode state or update-only block changed")
	end
end

test header_block_decoder_accepts_leading_updates_and_rejects_misplaced_updates() -> Result<(), String>
	let table = http2::hpack::insert_dynamic_table_entry(http2::hpack::empty_dynamic_table(128)?, "x", byte_chunk_from_hex("31")?)?
	let transition = require_header_block(byte_chunk_from_hex("203f2182")?, table, 128)?
	let misplaced = match decode_header_block_chunk(byte_chunk_from_hex("8220")?, table, 128)?
		Err(failure) => match http2::hpack::header_block_indexed_failure(failure)
			None => match http2::hpack::header_block_literal_failure(failure)
				None => match http2::hpack::header_block_table_size_update_failure(failure)
					None => http2::hpack::header_block_failure_kind(failure) == "misplaced_table_size_update" and http2::hpack::header_block_failure_first_octet(failure) == 0
					Some(_) => false
				end
				Some(_) => false
			end
			Some(_) => false
		end
		Ok(_) => false
	end
	if http2::hpack::header_block_consumed(transition) == 4 and http2::hpack::dynamic_table_capacity(http2::hpack::header_block_table(transition)) == 64 and header_list_entry_matches(http2::hpack::header_block_headers(transition), 0, ":method", byte_chunk_from_hex("474554")?)? and misplaced and dynamic_entry_matches(table, 1, "x", byte_chunk_from_hex("31")?)?
		Ok(())
	else
		Err("HPACK header-block table-size update placement changed")
	end
end

test header_block_decoder_preserves_nested_failures_and_input_state() -> Result<(), String>
	let table = http2::hpack::insert_dynamic_table_entry(http2::hpack::empty_dynamic_table(64)?, "original", byte_chunk_from_hex("00ff")?)?
	let indexed = match decode_header_block_chunk(byte_chunk_from_hex("be")?, http2::hpack::empty_dynamic_table(64)?, 64)?
		Err(failure) => match http2::hpack::header_block_indexed_failure(failure)
			Some(nested) => http2::hpack::indexed_decode_failure_kind(nested) == "unavailable_dynamic_entry" and http2::hpack::indexed_decode_failure_index(nested) == 62 and http2::hpack::indexed_decode_failure_dynamic_index(nested) == 1 and http2::hpack::indexed_decode_failure_dynamic_entry_count(nested) == 0
			None => false
		end
		Ok(_) => false
	end
	let literal = match decode_header_block_chunk(byte_chunk_from_hex("040300ff")?, table, 64)?
		Err(failure) => match http2::hpack::header_block_literal_failure(failure)
			Some(nested) => http2::hpack::literal_decode_failure_kind(nested) == "truncated_raw_value" and http2::hpack::literal_decode_failure_expected_octets(nested) == 3 and http2::hpack::literal_decode_failure_available_octets(nested) == 2
			None => false
		end
		Ok(_) => false
	end
	let update = match decode_header_block_chunk(byte_chunk_from_hex("3f3a")?, table, 64)?
		Err(failure) => match http2::hpack::header_block_table_size_update_failure(failure)
			Some(nested) => http2::hpack::table_size_update_failure_kind(nested) == "capacity_limit" and http2::hpack::table_size_update_failure_capacity(nested) == 89 and http2::hpack::table_size_update_failure_peer_maximum(nested) == 64
			None => false
		end
		Ok(_) => false
	end
	let late_failure = match decode_header_block_chunk(byte_chunk_from_hex("203f2140017801317f")?, table, 64)?
		Err(failure) => http2::hpack::header_block_failure_kind(failure) == "literal_failure"
		Ok(_) => false
	end
	if indexed and literal and update and late_failure and http2::hpack::dynamic_table_capacity(table) == 64 and http2::hpack::dynamic_table_entry_count(table) == 1 and dynamic_entry_matches(table, 1, "original", byte_chunk_from_hex("00ff")?)?
		Ok(())
	else
		Err("HPACK header-block nested failure or failure-state preservation changed")
	end
end

fn require_header_encode(result: Result<HeaderEncodeTransition, HeaderEncodeFailure>) -> Result<HeaderEncodeTransition, String>
	match result
		Ok(transition) => Ok(transition)
		Err(failure) => Err(http2::hpack::header_encode_failure_kind(failure))
	end
end

fn require_header_block_encode(result: Result<HeaderBlockEncodeTransition, HeaderBlockEncodeFailure>) -> Result<HeaderBlockEncodeTransition, String>
	match result
		Ok(transition) => Ok(transition)
		Err(failure) => Err(http2::hpack::header_block_encode_failure_kind(failure))
	end
end

fn encoded_header_matches(transition: HeaderEncodeTransition, expected: String) -> Result<Bool, String>
	chunks_equal(http2::hpack::header_encode_bytes(transition), byte_chunk_from_hex(expected)?)
end

fn encoded_block_matches(transition: HeaderBlockEncodeTransition, expected: String) -> Result<Bool, String>
	chunks_equal(http2::hpack::header_block_encode_bytes(transition), byte_chunk_from_hex(expected)?)
end

test header_encoder_emits_exact_static_and_multi_octet_dynamic_indices() -> Result<(), String>
	let empty = http2::hpack::empty_dynamic_table(4096)?
	let static_transition = require_header_encode(http2::hpack::encode_indexed_header_field(http2::hpack::header_field(":method", byte_chunk_from_hex("474554")?), 2, empty))?
	# evidence http2-hpack-static-indexed-method-post
	let static_post = require_header_encode(http2::hpack::encode_indexed_header_field(http2::hpack::header_field(":method", byte_chunk_from_hex("504f5354")?), 3, empty))?
	let populated = build_indexed_dynamic_table(66, http2::hpack::empty_dynamic_table(4096)?)?
	let dynamic_transition = require_header_encode(http2::hpack::encode_indexed_header_field(http2::hpack::header_field("x", byte_write_u8_be(65)?), 127, populated))?
	if encoded_header_matches(static_transition, "82")? and encoded_header_matches(static_post, "83")? and encoded_header_matches(dynamic_transition, "ff00")? and http2::hpack::dynamic_table_entry_count(http2::hpack::header_encode_table(dynamic_transition)) == 66 and http2::hpack::dynamic_table_entry_count(empty) == 0
		Ok(())
	else
		Err("HPACK indexed encoding or immutable state changed")
	end
end

test header_block_decoder_retains_exact_huffman_nul_octets() -> Result<(), String>
	# evidence http2-hpack-literal-path-nul-huffman
	let table = http2::hpack::empty_dynamic_table(4096)?
	let transition = require_header_block(byte_chunk_from_hex("0482ffc7")?, table, 4096)?
	let headers = http2::hpack::header_block_headers(transition)
	if http2::hpack::header_block_consumed(transition) == 4 and http2::hpack::header_list_count(headers) == 1 and header_list_entry_matches(headers, 0, ":path", byte_chunk_from_hex("00")?)? and http2::hpack::dynamic_table_entry_count(http2::hpack::header_block_table(transition)) == 0 and http2::hpack::dynamic_table_entry_count(table) == 0
		Ok(())
	else
		Err("HPACK exact Huffman NUL header block or immutable decode state changed")
	end
end

test literal_encoder_covers_representations_name_sources_and_string_policies() -> Result<(), String>
	let empty = http2::hpack::empty_dynamic_table(256)?
	let named_table = http2::hpack::insert_dynamic_table_entry(empty, "x", byte_chunk_from_hex("31")?)?
	let direct_incremental = require_header_encode(http2::hpack::encode_literal_header_field(http2::hpack::header_field("x", byte_chunk_from_hex("7a")?), 0, 0, false, false, empty))?
	let direct_without = require_header_encode(http2::hpack::encode_literal_header_field(http2::hpack::header_field("x", byte_chunk_from_hex("7a")?), 1, 0, false, false, empty))?
	let direct_never = require_header_encode(http2::hpack::encode_literal_header_field(http2::hpack::header_field("x", byte_chunk_from_hex("7a")?), 2, 0, false, false, empty))?
	let static_incremental = require_header_encode(http2::hpack::encode_literal_header_field(http2::hpack::header_field(":path", byte_chunk_from_hex("7a")?), 0, 4, false, false, empty))?
	let static_without = require_header_encode(http2::hpack::encode_literal_header_field(http2::hpack::header_field(":path", byte_chunk_from_hex("7a")?), 1, 4, false, false, empty))?
	let static_never = require_header_encode(http2::hpack::encode_literal_header_field(http2::hpack::header_field(":path", byte_chunk_from_hex("7a")?), 2, 4, false, false, empty))?
	let dynamic_incremental = require_header_encode(http2::hpack::encode_literal_header_field(http2::hpack::header_field("x", byte_chunk_from_hex("7a")?), 0, 62, false, false, named_table))?
	let dynamic_without = require_header_encode(http2::hpack::encode_literal_header_field(http2::hpack::header_field("x", byte_chunk_from_hex("7a")?), 1, 62, false, false, named_table))?
	let dynamic_never = require_header_encode(http2::hpack::encode_literal_header_field(http2::hpack::header_field("x", byte_chunk_from_hex("7a")?), 2, 62, false, false, named_table))?
	let empty_value = require_header_encode(http2::hpack::encode_literal_header_field(http2::hpack::header_field(":path", byte_chunk([])), 1, 4, false, false, empty))?
	let huffman = require_header_encode(http2::hpack::encode_literal_header_field(http2::hpack::header_field("x", byte_chunk_from_visible_ascii_string("www.example.com")?), 1, 0, true, true, empty))?
	let decoded_huffman = require_literal_chunk(http2::hpack::header_encode_bytes(huffman), empty)?
	let direct_exact = encoded_header_matches(direct_incremental, "400178017a")? and encoded_header_matches(direct_without, "000178017a")? and encoded_header_matches(direct_never, "100178017a")?
	let static_exact = encoded_header_matches(static_incremental, "44017a")? and encoded_header_matches(static_without, "04017a")? and encoded_header_matches(static_never, "14017a")?
	let dynamic_exact = encoded_header_matches(dynamic_incremental, "7e017a")? and encoded_header_matches(dynamic_without, "0f2f017a")? and encoded_header_matches(dynamic_never, "1f2f017a")?
	let transitions = dynamic_entry_matches(http2::hpack::header_encode_table(direct_incremental), 1, "x", byte_chunk_from_hex("7a")?)? and dynamic_entry_matches(http2::hpack::header_encode_table(static_incremental), 1, ":path", byte_chunk_from_hex("7a")?)? and dynamic_entry_matches(http2::hpack::header_encode_table(dynamic_incremental), 1, "x", byte_chunk_from_hex("7a")?)? and http2::hpack::dynamic_table_entry_count(http2::hpack::header_encode_table(dynamic_incremental)) == 2 and http2::hpack::dynamic_table_entry_count(http2::hpack::header_encode_table(direct_without)) == 0 and http2::hpack::dynamic_table_entry_count(http2::hpack::header_encode_table(static_without)) == 0 and http2::hpack::dynamic_table_entry_count(http2::hpack::header_encode_table(dynamic_without)) == 1 and http2::hpack::dynamic_table_entry_count(http2::hpack::header_encode_table(direct_never)) == 0 and http2::hpack::dynamic_table_entry_count(http2::hpack::header_encode_table(static_never)) == 0 and http2::hpack::dynamic_table_entry_count(http2::hpack::header_encode_table(dynamic_never)) == 1
	if direct_exact and static_exact and dynamic_exact and encoded_header_matches(empty_value, "0400")? and encoded_header_matches(huffman, "0081f38cf1e3c2e5f23a6ba0ab90f4ff")? and transitions and literal_transition_matches(decoded_huffman, "without_indexing", "x", byte_chunk_from_visible_ascii_string("www.example.com")?, 16)? and http2::hpack::dynamic_table_entry_count(empty) == 0 and http2::hpack::dynamic_table_entry_count(named_table) == 1
		Ok(())
	else
		Err("HPACK literal representation, name source, string policy, or state transition changed")
	end
end

test header_block_encoder_preserves_order_reuses_in_block_state_and_round_trips() -> Result<(), String>
	let table = http2::hpack::empty_dynamic_table(256)?
	let headers = http2::hpack::prepend_header_field(http2::hpack::header_field(":method", byte_chunk_from_hex("474554")?), http2::hpack::prepend_header_field(http2::hpack::header_field("x", byte_chunk_from_hex("00ff")?), http2::hpack::prepend_header_field(http2::hpack::header_field("x", byte_chunk_from_hex("00ff")?), http2::hpack::empty_header_list())))
	let transition = require_header_block_encode(http2::hpack::encode_header_block(headers, table, 256))?
	let decoded = require_header_block(http2::hpack::header_block_encode_bytes(transition), table, 256)?
	let decoded_headers = http2::hpack::header_block_headers(decoded)
	let fields_match = header_list_entry_matches(decoded_headers, 0, ":method", byte_chunk_from_hex("474554")?)? and header_list_entry_matches(decoded_headers, 1, "x", byte_chunk_from_hex("00ff")?)? and header_list_entry_matches(decoded_headers, 2, "x", byte_chunk_from_hex("00ff")?)?
	if encoded_block_matches(transition, "824001780200ffbe")? and fields_match and http2::hpack::header_list_count(decoded_headers) == 3 and dynamic_entry_matches(http2::hpack::header_block_encode_table(transition), 1, "x", byte_chunk_from_hex("00ff")?)? and http2::hpack::dynamic_table_entry_count(table) == 0
		Ok(())
	else
		Err("HPACK ordered block encoding, in-block reuse, or round trip changed")
	end
end

test header_block_encoder_handles_empty_lists_capacity_eviction_and_recursive_lists() -> Result<(), String>
	let original = http2::hpack::insert_dynamic_table_entry(http2::hpack::insert_dynamic_table_entry(http2::hpack::empty_dynamic_table(100)?, "older", byte_chunk_from_hex("31")?)?, "newest", byte_chunk_from_hex("32")?)?
	let empty = require_header_block_encode(http2::hpack::encode_header_block(http2::hpack::empty_header_list(), original, 100))?
	let one = http2::hpack::prepend_header_field(http2::hpack::header_field("newest", byte_chunk_from_hex("32")?), http2::hpack::empty_header_list())
	let shrunk = require_header_block_encode(http2::hpack::encode_header_block(one, original, 39))?
	if encoded_block_matches(empty, "")? and encoded_block_matches(shrunk, "3f08be")? and http2::hpack::dynamic_table_entry_count(http2::hpack::header_block_encode_table(shrunk)) == 1 and dynamic_entry_matches(http2::hpack::header_block_encode_table(shrunk), 1, "newest", byte_chunk_from_hex("32")?)? and http2::hpack::dynamic_table_entry_count(original) == 2
		Ok(())
	else
		Err("HPACK empty list, capacity selection, eviction, or recursive encoding changed")
	end
end

test header_encoders_return_focused_failures_without_output_or_next_state() -> Result<(), String>
	let table = http2::hpack::insert_dynamic_table_entry(http2::hpack::empty_dynamic_table(64)?, "original", byte_chunk_from_hex("00ff")?)?
	let invalid_representation = match http2::hpack::encode_literal_header_field(http2::hpack::header_field("x", byte_chunk([])), 3, 0, false, false, table)
		Err(failure) => http2::hpack::header_encode_failure_kind(failure) == "invalid_representation"
		Ok(_) => false
	end
	let invalid_name = match http2::hpack::encode_literal_header_field(http2::hpack::header_field("Bad", byte_chunk([])), 0, 0, false, false, table)
		Err(failure) => http2::hpack::header_encode_failure_kind(failure) == "invalid_name"
		Ok(_) => false
	end
	let zero = match http2::hpack::encode_indexed_header_field(http2::hpack::header_field("x", byte_chunk([])), 0, table)
		Err(failure) => http2::hpack::header_encode_failure_kind(failure) == "zero_index"
		Ok(_) => false
	end
	let unavailable_static = match http2::hpack::encode_indexed_header_field(http2::hpack::header_field("x", byte_chunk([])), -1, table)
		Err(failure) => http2::hpack::header_encode_failure_kind(failure) == "unavailable_static_index" and http2::hpack::header_encode_failure_index(failure) == -1
		Ok(_) => false
	end
	let unavailable = match http2::hpack::encode_indexed_header_field(http2::hpack::header_field("x", byte_chunk([])), 63, table)
		Err(failure) => http2::hpack::header_encode_failure_kind(failure) == "unavailable_dynamic_index" and http2::hpack::header_encode_failure_index(failure) == 63 and http2::hpack::header_encode_failure_dynamic_index(failure) == 2 and http2::hpack::header_encode_failure_dynamic_entry_count(failure) == 1
		Ok(_) => false
	end
	let mismatch = match http2::hpack::encode_indexed_header_field(http2::hpack::header_field(":method", byte_chunk_from_hex("504f5354")?), 2, table)
		Err(failure) => http2::hpack::header_encode_failure_kind(failure) == "indexed_field_mismatch" and http2::hpack::header_encode_failure_index(failure) == 2
		Ok(_) => false
	end
	let bad_headers = http2::hpack::prepend_header_field(http2::hpack::header_field(":method", byte_chunk_from_hex("474554")?), http2::hpack::prepend_header_field(http2::hpack::header_field("Bad", byte_chunk([])), http2::hpack::empty_header_list()))
	let late = match http2::hpack::encode_header_block(bad_headers, table, 64)
		Err(failure) => match http2::hpack::header_block_encode_header_failure(failure)
			Some(header_failure) => http2::hpack::header_block_encode_failure_kind(failure) == "header_field" and http2::hpack::header_block_encode_failure_position(failure) == 1 and http2::hpack::header_encode_failure_kind(header_failure) == "invalid_name"
			None => false
		end
		Ok(_) => false
	end
	let capacity = match http2::hpack::encode_header_block(http2::hpack::empty_header_list(), table, -1)
		Err(failure) => http2::hpack::header_block_encode_failure_kind(failure) == "active_capacity" and http2::hpack::header_block_encode_failure_capacity(failure) == -1
		Ok(_) => false
	end
	let headers_unchanged = http2::hpack::header_list_count(bad_headers) == 2 and header_list_entry_matches(bad_headers, 0, ":method", byte_chunk_from_hex("474554")?)? and header_list_entry_matches(bad_headers, 1, "Bad", byte_chunk([]))?
	if invalid_representation and invalid_name and zero and unavailable_static and unavailable and mismatch and late and capacity and headers_unchanged and http2::hpack::dynamic_table_capacity(table) == 64 and dynamic_entry_matches(table, 1, "original", byte_chunk_from_hex("00ff")?)?
		Ok(())
	else
		Err("HPACK encode failure typing or input-state preservation changed")
	end
end
