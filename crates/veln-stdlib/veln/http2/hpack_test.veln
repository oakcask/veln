end

test dynamic_table_rejects_negative_capacities_without_changing_input() -> Result<(), String>
	let original = http2::hpack::insert_dynamic_table_entry(http2::hpack::empty_dynamic_table(64)?, "a", byte_chunk_from_hex("31")?)?
	let creation_rejected = match http2::hpack::empty_dynamic_table(-1)
		Ok(_) => false
		Err(failure) => failure == "HPACK dynamic table capacity must not be negative"
	end
	let transition_rejected = match http2::hpack::dynamic_table_with_capacity(original, -1)
		Ok(_) => false
		Err(failure) => failure == "HPACK dynamic table capacity must not be negative"
	end
	let original_preserved = http2::hpack::dynamic_table_capacity(original) == 64 and http2::hpack::dynamic_table_size(original) == 34 and dynamic_entry_matches(original, 1, "a", byte_chunk_from_hex("31")?)?
	if creation_rejected and transition_rejected and original_preserved
		Ok(())
	else
		Err("HPACK dynamic table negative capacity handling changed")
	end
end

