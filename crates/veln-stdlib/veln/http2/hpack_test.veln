	let older = http2::hpack::insert_dynamic_table_entry(http2::hpack::empty_dynamic_table(100)?, "a", byte_chunk_from_hex("31")?)?
	let table = http2::hpack::insert_dynamic_table_entry(older, "bb", byte_chunk_from_hex("3232")?)?
