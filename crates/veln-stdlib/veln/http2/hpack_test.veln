test static_table_lookups_reject_indices_names_and_values_outside_the_table() -> Result<(), String>
	let forward_misses: Bool = match http2::hpack::static_entry(0)
		Some(_) => false
		None => match http2::hpack::static_entry(62)
			Some(_) => false
			None => true
		end
	end
	let reverse_misses: Bool = match http2::hpack::static_entry_index(":method", "PUT")
		Some(_) => false
		None => match http2::hpack::static_entry_index("unknown-header", "")
			Some(_) => false
			None => match http2::hpack::static_name_index("unknown-header")
				Some(_) => false
				None => true
			end
		end
	end
	if forward_misses and reverse_misses
		Ok(())
	else
		Err("HPACK static table lookup unexpectedly matched")
	end
end

