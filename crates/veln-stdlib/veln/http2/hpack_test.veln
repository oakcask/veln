use prelude
use http2::hpack

type ExpectedStaticEntry
	ExpectedStaticEntry(name: String, value: String, first_name_index: Int)
end

fn expected_static_entry(index: Int) -> Option<ExpectedStaticEntry>
	match index
		1 => Some(ExpectedStaticEntry(":authority", "", 1))
		2 => Some(ExpectedStaticEntry(":method", "GET", 2))
		3 => Some(ExpectedStaticEntry(":method", "POST", 2))
		4 => Some(ExpectedStaticEntry(":path", "/", 4))
		5 => Some(ExpectedStaticEntry(":path", "/index.html", 4))
		6 => Some(ExpectedStaticEntry(":scheme", "http", 6))
		7 => Some(ExpectedStaticEntry(":scheme", "https", 6))
		8 => Some(ExpectedStaticEntry(":status", "200", 8))
		9 => Some(ExpectedStaticEntry(":status", "204", 8))
		10 => Some(ExpectedStaticEntry(":status", "206", 8))
		11 => Some(ExpectedStaticEntry(":status", "304", 8))
		12 => Some(ExpectedStaticEntry(":status", "400", 8))
		13 => Some(ExpectedStaticEntry(":status", "404", 8))
		14 => Some(ExpectedStaticEntry(":status", "500", 8))
		15 => Some(ExpectedStaticEntry("accept-charset", "", 15))
		16 => Some(ExpectedStaticEntry("accept-encoding", "gzip, deflate", 16))
		17 => Some(ExpectedStaticEntry("accept-language", "", 17))
		18 => Some(ExpectedStaticEntry("accept-ranges", "", 18))
		19 => Some(ExpectedStaticEntry("accept", "", 19))
		20 => Some(ExpectedStaticEntry("access-control-allow-origin", "", 20))
		21 => Some(ExpectedStaticEntry("age", "", 21))
		22 => Some(ExpectedStaticEntry("allow", "", 22))
		23 => Some(ExpectedStaticEntry("authorization", "", 23))
		24 => Some(ExpectedStaticEntry("cache-control", "", 24))
		25 => Some(ExpectedStaticEntry("content-disposition", "", 25))
		26 => Some(ExpectedStaticEntry("content-encoding", "", 26))
		27 => Some(ExpectedStaticEntry("content-language", "", 27))
		28 => Some(ExpectedStaticEntry("content-length", "", 28))
		29 => Some(ExpectedStaticEntry("content-location", "", 29))
		30 => Some(ExpectedStaticEntry("content-range", "", 30))
		31 => Some(ExpectedStaticEntry("content-type", "", 31))
		32 => Some(ExpectedStaticEntry("cookie", "", 32))
		33 => Some(ExpectedStaticEntry("date", "", 33))
		34 => Some(ExpectedStaticEntry("etag", "", 34))
		35 => Some(ExpectedStaticEntry("expect", "", 35))
		36 => Some(ExpectedStaticEntry("expires", "", 36))
		37 => Some(ExpectedStaticEntry("from", "", 37))
		38 => Some(ExpectedStaticEntry("host", "", 38))
		39 => Some(ExpectedStaticEntry("if-match", "", 39))
		40 => Some(ExpectedStaticEntry("if-modified-since", "", 40))
		41 => Some(ExpectedStaticEntry("if-none-match", "", 41))
		42 => Some(ExpectedStaticEntry("if-range", "", 42))
		43 => Some(ExpectedStaticEntry("if-unmodified-since", "", 43))
		44 => Some(ExpectedStaticEntry("last-modified", "", 44))
		45 => Some(ExpectedStaticEntry("link", "", 45))
		46 => Some(ExpectedStaticEntry("location", "", 46))
		47 => Some(ExpectedStaticEntry("max-forwards", "", 47))
		48 => Some(ExpectedStaticEntry("proxy-authenticate", "", 48))
		49 => Some(ExpectedStaticEntry("proxy-authorization", "", 49))
		50 => Some(ExpectedStaticEntry("range", "", 50))
		51 => Some(ExpectedStaticEntry("referer", "", 51))
		52 => Some(ExpectedStaticEntry("refresh", "", 52))
		53 => Some(ExpectedStaticEntry("retry-after", "", 53))
		54 => Some(ExpectedStaticEntry("server", "", 54))
		55 => Some(ExpectedStaticEntry("set-cookie", "", 55))
		56 => Some(ExpectedStaticEntry("strict-transport-security", "", 56))
		57 => Some(ExpectedStaticEntry("transfer-encoding", "", 57))
		58 => Some(ExpectedStaticEntry("user-agent", "", 58))
		59 => Some(ExpectedStaticEntry("vary", "", 59))
		60 => Some(ExpectedStaticEntry("via", "", 60))
		61 => Some(ExpectedStaticEntry("www-authenticate", "", 61))
		_ => None
	end
end

fn option_int_matches(actual: Option<Int>, expected: Int) -> Bool
	match actual
		Some(value) => value == expected
		None => false
	end
end

fn static_entry_matches(index: Int) -> Bool
	match expected_static_entry(index)
		Some(ExpectedStaticEntry(expected_name, expected_value, _)) => match http2::hpack::static_entry(index)
			Some(actual) => http2::hpack::static_entry_name(actual) == expected_name and http2::hpack::static_entry_value(actual) == expected_value
			None => false
		end
		None => false
	end
end

fn static_entry_reverse_matches(index: Int) -> Bool
	match expected_static_entry(index)
		Some(ExpectedStaticEntry(name, value, _)) => option_int_matches(http2::hpack::static_entry_index(name, value), index)
		None => false
	end
end

fn static_name_reverse_matches(index: Int) -> Bool
	match expected_static_entry(index)
		Some(ExpectedStaticEntry(name, _, first_name_index)) => option_int_matches(http2::hpack::static_name_index(name), first_name_index)
		None => false
	end
end

fn static_entry_range_matches(index: Int, last: Int) -> Bool
	if index > last
		true
	else if static_entry_matches(index)
		static_entry_range_matches(index + 1, last)
	else
		false
	end
end

fn every_static_entry_reverse_matches(index: Int) -> Bool
	if index > 61
		true
	else if static_entry_reverse_matches(index)
		every_static_entry_reverse_matches(index + 1)
	else
		false
	end
end

fn every_static_name_reverse_matches(index: Int) -> Bool
	if index > 61
		true
	else if static_name_reverse_matches(index)
		every_static_name_reverse_matches(index + 1)
	else
		false
	end
end

fn byte_at(chunk: ByteChunk, index: Int) -> Result<Int, String>
	byte_read_u8_be(byte_view(chunk, byte_offset(index)?, byte_count(1)?)?)
end

fn chunks_equal_at(left: ByteChunk, right: ByteChunk, index: Int, count: Int) -> Result<Bool, String>
	if index == count
		Ok(true)
	else if byte_at(left, index)? == byte_at(right, index)?
		chunks_equal_at(left, right, index + 1, count)
	else
		Ok(false)
	end
end

fn chunks_equal(left: ByteChunk, right: ByteChunk) -> Result<Bool, String>
	let left_count: Int = byte_count_to_int(byte_chunk_count(left))
	let right_count: Int = byte_count_to_int(byte_chunk_count(right))
	if left_count == right_count
		chunks_equal_at(left, right, 0, left_count)
	else
		Ok(false)
	end
end

fn dynamic_entry_matches(table: DynamicTable, index: Int, expected_name: String, expected_value: ByteChunk) -> Result<Bool, String>
	match http2::hpack::dynamic_table_entry(table, index)
		Some(entry) => Ok(http2::hpack::dynamic_entry_name(entry) == expected_name and chunks_equal(http2::hpack::dynamic_entry_value(entry), expected_value)?)
		None => Ok(false)
	end
end

fn dynamic_entry_is_missing(table: DynamicTable, index: Int) -> Bool
	match http2::hpack::dynamic_table_entry(table, index)
		Some(_) => false
		None => true
	end
end

fn decode_chunk(input: ByteChunk, prefix_bits: Int) -> Result<{ value : Int, consumed : Int }, String>
	http2::hpack::decode_integer(byte_view(input, byte_offset(0)?, byte_chunk_count(input))?, prefix_bits)
end

fn decode_huffman_chunk(input: ByteChunk) -> Result<ByteChunk, String>
	http2::hpack::decode_huffman(byte_view(input, byte_offset(0)?, byte_chunk_count(input))?)
end

fn decode_indexed_chunk(input: ByteChunk, table: DynamicTable) -> Result<Result<IndexedDecodeTransition, IndexedDecodeFailure>, String>
	Ok(http2::hpack::decode_indexed_header_field(byte_view(input, byte_offset(0)?, byte_chunk_count(input))?, table))
end

fn decode_literal_chunk(input: ByteChunk, table: DynamicTable) -> Result<Result<LiteralDecodeTransition, LiteralDecodeFailure>, String>
	Ok(http2::hpack::decode_literal_header_field(byte_view(input, byte_offset(0)?, byte_chunk_count(input))?, table))
end

fn require_literal_chunk(input: ByteChunk, table: DynamicTable) -> Result<LiteralDecodeTransition, String>
	match decode_literal_chunk(input, table)?
		Ok(transition) => Ok(transition)
		Err(failure) => Err(http2::hpack::literal_decode_failure_kind(failure))
	end
end

fn require_indexed_chunk(input: ByteChunk, table: DynamicTable) -> Result<IndexedDecodeTransition, String>
	match decode_indexed_chunk(input, table)?
		Ok(transition) => Ok(transition)
		Err(_) => Err("expected HPACK indexed header decoding to succeed")
	end
end

fn unavailable_indexed_failure_matches(failure: IndexedDecodeFailure, index: Int, dynamic_index: Int, entry_count: Int) -> Bool
	http2::hpack::indexed_decode_failure_kind(failure) == "unavailable_dynamic_entry" and http2::hpack::indexed_decode_failure_index(failure) == index and http2::hpack::indexed_decode_failure_dynamic_index(failure) == dynamic_index and http2::hpack::indexed_decode_failure_dynamic_entry_count(failure) == entry_count
end

fn indexed_transition_matches(transition: IndexedDecodeTransition, expected_name: String, expected_value: ByteChunk, expected_consumed: Int) -> Result<Bool, String>
	let header: IndexedHeaderField = http2::hpack::indexed_decode_header(transition)
	Ok(http2::hpack::indexed_header_name(header) == expected_name and chunks_equal(http2::hpack::indexed_header_value(header), expected_value)? and http2::hpack::indexed_decode_consumed(transition) == expected_consumed)
end

fn literal_transition_matches(transition: LiteralDecodeTransition, expected_representation: String, expected_name: String, expected_value: ByteChunk, expected_consumed: Int) -> Result<Bool, String>
	let header: LiteralHeaderField = http2::hpack::literal_decode_header(transition)
	Ok(http2::hpack::literal_decode_representation(transition) == expected_representation and http2::hpack::literal_header_name(header) == expected_name and chunks_equal(http2::hpack::literal_header_value(header), expected_value)? and http2::hpack::literal_decode_consumed(transition) == expected_consumed)
end

fn repeated_octet(octet: Int, count: Int) -> Result<ByteChunk, String>
	if count == 0
		Ok(byte_chunk([]))
	else
		Ok(byte_append(byte_write_u8_be(octet)?, repeated_octet(octet, count - 1)?))
	end
end

fn literal_failure_kind(input: ByteChunk, table: DynamicTable, expected: String) -> Result<Bool, String>
	match decode_literal_chunk(input, table)?
		Err(failure) => Ok(http2::hpack::literal_decode_failure_kind(failure) == expected)
		Ok(_) => Ok(false)
	end
end

fn table_matches_two_entries(table: DynamicTable, expected_capacity: Int, expected_size: Int) -> Result<Bool, String>
	Ok(http2::hpack::dynamic_table_capacity(table) == expected_capacity and http2::hpack::dynamic_table_size(table) == expected_size and http2::hpack::dynamic_table_entry_count(table) == 2 and dynamic_entry_matches(table, 1, "newest", byte_chunk_from_hex("00ff")?)? and dynamic_entry_matches(table, 2, "older", byte_chunk_from_hex("31")?)?)
end

fn static_value_bytes(value: String) -> Result<ByteChunk, String>
	if value == ""
		Ok(byte_chunk([]))
	else if value == "gzip, deflate"
		byte_chunk_from_hex("677a69702c206465666c617465")
	else
		byte_chunk_from_visible_ascii_string(value)
	end
end

fn indexed_static_range_matches(index: Int) -> Result<Bool, String>
	if index > 61
		Ok(true)
	else
		match http2::hpack::static_entry(index)
			Some(entry) => match decode_indexed_chunk(byte_write_u8_be(128 + index)?, http2::hpack::empty_dynamic_table(0)?)?
				Ok(transition) => if indexed_transition_matches(transition, http2::hpack::static_entry_name(entry), static_value_bytes(http2::hpack::static_entry_value(entry))?, 1)?
					indexed_static_range_matches(index + 1)
				else
					Err(int_to_string(index))
				end
				Err(failure) => Err(http2::hpack::indexed_decode_failure_kind(failure))
			end
			None => Err(int_to_string(index))
		end
	end
end

fn build_indexed_dynamic_table(remaining: Int, table: DynamicTable) -> Result<DynamicTable, String>
	if remaining == 0
		Ok(table)
	else
		build_indexed_dynamic_table(remaining - 1, http2::hpack::insert_dynamic_table_entry(table, "x", byte_write_u8_be(remaining - 1)?)?)
	end
end

fn expect_huffman_encoding(input_hex: String, expected_hex: String) -> Result<(), String>
	let actual: ByteChunk = http2::hpack::encode_huffman(byte_chunk_from_hex(input_hex)?)?
	if chunks_equal(actual, byte_chunk_from_hex(expected_hex)?)?
		Ok(())
	else
		Err("HPACK Huffman encoding changed")
	end
end

fn expect_huffman_decoding(input_hex: String, expected_hex: String) -> Result<(), String>
	let actual: ByteChunk = decode_huffman_chunk(byte_chunk_from_hex(input_hex)?)?
	if chunks_equal(actual, byte_chunk_from_hex(expected_hex)?)?
		Ok(())
	else
		Err("HPACK Huffman decoding changed")
	end
end

fn expect_huffman_decode_error(input_hex: String, expected: String) -> Result<(), String>
	match decode_huffman_chunk(byte_chunk_from_hex(input_hex)?)
		Ok(_) => Err("expected HPACK Huffman decoding to fail")
		Err(actual) => if actual == expected
			Ok(())
		else
			Err("unexpected HPACK Huffman decoding failure")
		end
	end
end

fn every_huffman_octet_round_trips(symbol: Int) -> Result<Bool, String>
	let input: ByteChunk = byte_write_u8_be(symbol)?
	let encoded: ByteChunk = http2::hpack::encode_huffman(input)?
	let decoded: ByteChunk = decode_huffman_chunk(encoded)?
	if chunks_equal(input, decoded)?
		if symbol == 255
			Ok(true)
		else
			every_huffman_octet_round_trips(symbol + 1)
		end
	else
		Ok(false)
	end
end

fn octet_sequence(first: Int, last: Int) -> Result<ByteChunk, String>
	if first > last
		Ok(byte_chunk([]))
	else
		Ok(byte_append(byte_write_u8_be(first)?, octet_sequence(first + 1, last)?))
	end
end

fn expect_encoding(value: Int, prefix_bits: Int, representation_bits: Int, expected_hex: String) -> Result<(), String>
	let actual: ByteChunk = http2::hpack::encode_integer(value, prefix_bits, representation_bits)?
	let equal: Bool = chunks_equal(actual, byte_chunk_from_hex(expected_hex)?)?
	if equal
		Ok(())
	else
		Err("HPACK prefixed integer encoding changed")
	end
end

fn expect_encode_error(value: Int, prefix_bits: Int, representation_bits: Int, expected: String) -> Result<(), String>
	match http2::hpack::encode_integer(value, prefix_bits, representation_bits)
		Ok(_) => Err("expected HPACK prefixed integer encoding to fail")
		Err(actual) => if actual == expected
			Ok(())
		else
			Err("unexpected HPACK prefixed integer encoding failure")
		end
	end
end

fn expect_decode_error(input: ByteChunk, prefix_bits: Int, expected: String) -> Result<(), String>
	match decode_chunk(input, prefix_bits)
		Ok(_) => Err("expected HPACK prefixed integer decoding to fail")
		Err(actual) => if actual == expected
			Ok(())
		else
			Err("unexpected HPACK prefixed integer decoding failure")
		end
	end
end

fn expect_decoding(input_hex: String, prefix_bits: Int, expected_value: Int, expected_consumed: Int) -> Result<(), String>
	let decoded: { value : Int, consumed : Int } = decode_chunk(byte_chunk_from_hex(input_hex)?, prefix_bits)?
	if http2::hpack::decoded_integer_value(decoded) == expected_value and http2::hpack::decoded_integer_consumed(decoded) == expected_consumed
		Ok(())
	else
		Err("HPACK prefixed integer decoding changed")
	end
end

fn round_trip_prefix_width(prefix_bits: Int) -> Result<(), String>
	let prefix_max: Int = (1 << prefix_bits) - 1
	let representation_bits: Int = 256 - (1 << prefix_bits)
	let direct: ByteChunk = http2::hpack::encode_integer(prefix_max - 1, prefix_bits, representation_bits)?
	let boundary: ByteChunk = http2::hpack::encode_integer(prefix_max, prefix_bits, representation_bits)?
	let continued: ByteChunk = http2::hpack::encode_integer(prefix_max + 128, prefix_bits, representation_bits)?
	let direct_decoded: { value : Int, consumed : Int } = decode_chunk(direct, prefix_bits)?
	let boundary_decoded: { value : Int, consumed : Int } = decode_chunk(boundary, prefix_bits)?
	let continued_decoded: { value : Int, consumed : Int } = decode_chunk(continued, prefix_bits)?
	let encodings_match: Bool = chunks_equal(direct, byte_chunk_from_hex("fe")?)? and chunks_equal(boundary, byte_chunk_from_hex("ff00")?)? and chunks_equal(continued, byte_chunk_from_hex("ff8001")?)?
	let values_match: Bool = http2::hpack::decoded_integer_value(direct_decoded) == prefix_max - 1 and http2::hpack::decoded_integer_value(boundary_decoded) == prefix_max and http2::hpack::decoded_integer_value(continued_decoded) == prefix_max + 128
	let consumed_match: Bool = http2::hpack::decoded_integer_consumed(direct_decoded) == 1 and http2::hpack::decoded_integer_consumed(boundary_decoded) == 2 and http2::hpack::decoded_integer_consumed(continued_decoded) == 3
	if encodings_match and values_match and consumed_match
		match prefix_bits
			8 => Ok(())
			_ => round_trip_prefix_width(prefix_bits + 1)
		end
	else
		Err("HPACK prefixed integer width round trip changed")
	end
end

test integer_encode_direct_boundary_and_continuation() -> Result<(), String>
	let _ = expect_encoding(10, 5, 224, "ea")?
	let _ = expect_encoding(31, 5, 224, "ff00")?
	let _ = expect_encoding(1337, 5, 0, "1f9a0a")?
	let decoded: { value : Int, consumed : Int } = decode_chunk(byte_chunk_from_hex("1f9a0a")?, 5)?
	if http2::hpack::decoded_integer_value(decoded) == 1337 and http2::hpack::decoded_integer_consumed(decoded) == 3
		Ok(())
	else
		Err("canonical HPACK prefixed integer decoding changed")
	end
end

test integer_codec_preserves_retired_fixture_vectors() -> Result<(), String>
	let _ = expect_encoding(127, 7, 128, "ff00")?
	let _ = expect_encoding(160, 5, 32, "3f8101")?
	let _ = expect_encoding(128, 7, 0, "7f01")?
	let _ = expect_decoding("ff8001", 7, 255, 3)?
	let _ = expect_decoding("3f8202", 5, 289, 3)?
	expect_decoding("7f01", 7, 128, 2)
end

test integer_round_trips_every_prefix_width() -> Result<(), String>
	round_trip_prefix_width(1)
end

test integer_round_trips_maximum_int() -> Result<(), String>
	let encoded: ByteChunk = http2::hpack::encode_integer(9223372036854775807, 8, 0)?
	let decoded: { value : Int, consumed : Int } = decode_chunk(encoded, 8)?
	let encoded_matches: Bool = chunks_equal(encoded, byte_chunk_from_hex("ff80feffffffffffff7f")?)?
	if encoded_matches and http2::hpack::decoded_integer_value(decoded) == 9223372036854775807 and http2::hpack::decoded_integer_consumed(decoded) == 10
		Ok(())
	else
		Err("maximum HPACK prefixed integer round trip changed")
	end
end

test integer_encode_rejects_invalid_inputs() -> Result<(), String>
	let _ = expect_encode_error(-1, 5, 0, "HPACK integer value must not be negative")?
	let _ = expect_encode_error(1, 0, 0, "HPACK integer prefix width must be between 1 and 8")?
	let _ = expect_encode_error(1, 9, 0, "HPACK integer prefix width must be between 1 and 8")?
	let _ = expect_encode_error(1, 5, -1, "HPACK integer representation bits must fit outside the prefix")?
	let _ = expect_encode_error(1, 5, 1, "HPACK integer representation bits must fit outside the prefix")?
	let _ = expect_encode_error(1, 5, 256, "HPACK integer representation bits must fit outside the prefix")?
	expect_encode_error(1, 8, 128, "HPACK integer representation bits must fit outside the prefix")
end

test integer_decode_rejects_empty_invalid_and_incomplete_inputs() -> Result<(), String>
	let _ = expect_decode_error(byte_chunk([]), 5, "HPACK integer input must not be empty")?
	let _ = expect_decode_error(byte_chunk_from_hex("00")?, 0, "HPACK integer prefix width must be between 1 and 8")?
	let _ = expect_decode_error(byte_chunk_from_hex("00")?, 9, "HPACK integer prefix width must be between 1 and 8")?
	let _ = expect_decode_error(byte_chunk_from_hex("1f")?, 5, "incomplete HPACK integer continuation")?
	expect_decode_error(byte_chunk_from_hex("1f80")?, 5, "incomplete HPACK integer continuation")
end

test integer_decode_rejects_values_and_sequences_beyond_int() -> Result<(), String>
	let _ = expect_decode_error(byte_chunk_from_hex("ff81feffffffffffff7f")?, 8, "HPACK integer continuation is too large")?
	expect_decode_error(byte_chunk_from_hex("ff80808080808080808000")?, 8, "HPACK integer continuation is too large")
end

test integer_decode_direct_value() -> Result<(), String>
	let decoded: { value : Int, consumed : Int } = decode_chunk(byte_chunk_from_hex("ea")?, 5)?
	if http2::hpack::decoded_integer_value(decoded) == 10 and http2::hpack::decoded_integer_consumed(decoded) == 1
		Ok(())
	else
		Err("direct HPACK prefixed integer decoding changed")
	end
end

test integer_decode_stops_after_terminal_octet() -> Result<(), String>
	let decoded: { value : Int, consumed : Int } = decode_chunk(byte_chunk_from_hex("1f9a0aff")?, 5)?
	if http2::hpack::decoded_integer_value(decoded) == 1337 and http2::hpack::decoded_integer_consumed(decoded) == 3
		Ok(())
	else
		Err("HPACK prefixed integer consumed trailing input")
	end
end

test huffman_codec_preserves_canonical_vectors() -> Result<(), String>
	let _ = expect_huffman_encoding("7777772e6578616d706c652e636f6d", "f1e3c2e5f23a6ba0ab90f4ff")?
	let _ = expect_huffman_encoding("6e6f2d6361636865", "a8eb10649cbf")?
	let _ = expect_huffman_decoding("25a849e95ba97d7f", "637573746f6d2d6b6579")?
	expect_huffman_decoding("25a849e95bb8e8b4bf", "637573746f6d2d76616c7565")
end

test huffman_codec_accepts_empty_input() -> Result<(), String>
	let encoded: ByteChunk = http2::hpack::encode_huffman(byte_chunk([]))?
	let decoded: ByteChunk = decode_huffman_chunk(encoded)?
	if byte_count_to_int(byte_chunk_count(encoded)) == 0 and byte_count_to_int(byte_chunk_count(decoded)) == 0
		Ok(())
	else
		Err("empty HPACK Huffman input changed")
	end
end

test huffman_codec_round_trips_every_single_octet() -> Result<(), String>
	if every_huffman_octet_round_trips(0)?
		Ok(())
	else
		Err("HPACK Huffman single-octet round trip changed")
	end
end

test huffman_codec_round_trips_recursive_multi_octet_input() -> Result<(), String>
	let input: ByteChunk = octet_sequence(0, 3)?
	let encoded: ByteChunk = http2::hpack::encode_huffman(input)?
	let decoded: ByteChunk = decode_huffman_chunk(encoded)?
	if chunks_equal(input, decoded)?
		Ok(())
	else
		Err("HPACK Huffman recursive octet round trip changed")
	end
end

test huffman_codec_preserves_non_visible_octets() -> Result<(), String>
	let _ = expect_huffman_encoding("00ff", "ffc7ffffdd")?
	expect_huffman_decoding("ffc7ffffdd", "00ff")
end

test huffman_encoder_uses_eos_prefix_padding_at_bit_boundaries() -> Result<(), String>
	let _ = expect_huffman_encoding("30", "07")?
	let _ = expect_huffman_encoding("26", "f8")?
	expect_huffman_encoding("65", "2f")
end

test huffman_decoder_rejects_eos_invalid_padding_and_truncated_codes() -> Result<(), String>
	let _ = expect_huffman_decode_error("ffffffff", "HPACK Huffman payload contains EOS symbol")?
	let _ = expect_huffman_decode_error("00", "invalid HPACK Huffman padding")?
	let _ = expect_huffman_decode_error("ff", "invalid HPACK Huffman padding")?
	expect_huffman_decode_error("fe", "invalid HPACK Huffman code sequence")
end

test huffman_decode_failure_exposes_no_partial_output() -> Result<(), String>
	expect_huffman_decode_error("1e", "invalid HPACK Huffman padding")
end

test static_table_contains_entries_one_through_fourteen() -> Result<(), String>
	if static_entry_range_matches(1, 14)
		Ok(())
	else
		Err("HPACK static table entry changed")
	end
end

