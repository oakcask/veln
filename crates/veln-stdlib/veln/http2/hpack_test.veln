test indexed_header_decoder_returns_focused_integer_and_zero_failures() -> Result<(), String>
	let table = http2::hpack::insert_dynamic_table_entry(http2::hpack::empty_dynamic_table(64)?, "x", byte_chunk_from_hex("00ff")?)?
	let empty = match decode_indexed_chunk(byte_chunk([]), table)?
		Err(failure) => http2::hpack::indexed_decode_failure_kind(failure) == "incomplete_integer"
		_ => false
	end
	let incomplete = match decode_indexed_chunk(byte_chunk_from_hex("ff80")?, table)?
		Err(failure) => http2::hpack::indexed_decode_failure_kind(failure) == "incomplete_integer"
		_ => false
	end
	let malformed = match decode_indexed_chunk(byte_chunk_from_hex("ff80808080808080808000")?, table)?
		Err(failure) => http2::hpack::indexed_decode_failure_kind(failure) == "malformed_integer"
		_ => false
	end
	let zero = match decode_indexed_chunk(byte_chunk_from_hex("80")?, table)?
		Err(failure) => http2::hpack::indexed_decode_failure_kind(failure) == "zero_index"
		_ => false
	end
	if empty and incomplete and malformed and zero and http2::hpack::dynamic_table_size(table) == 35 and dynamic_entry_matches(table, 1, "x", byte_chunk_from_hex("00ff")?)?
		Ok(())
	else
		Err("HPACK indexed integer failure classification or state preservation changed")
	end
end

