		_ => false
	end
	let wide_unavailable: Bool = match decode_indexed_chunk(byte_chunk_from_hex("ff00")?, table)?
		Err(failure) => unavailable_indexed_failure_matches(failure, 127, 66, 1)
		_ => false
	end
	if unavailable and wide_unavailable and http2::hpack::dynamic_table_size(table) == 35 and dynamic_entry_matches(table, 1, "x", byte_chunk_from_hex("00ff")?)?
		Ok(())
	else
		Err("HPACK unavailable indexed entry failure or input state changed")
	end
end

test literal_header_decoder_supports_all_representations_and_table_transitions() -> Result<(), String>
	let table: DynamicTable = http2::hpack::insert_dynamic_table_entry(http2::hpack::empty_dynamic_table(256)?, "older", byte_chunk_from_hex("31")?)?
	let incremental: LiteralDecodeTransition = require_literal_chunk(byte_chunk_from_hex("44072f746172676574")?, table)?
	let without: LiteralDecodeTransition = require_literal_chunk(byte_chunk_from_hex("04052f736b6970")?, table)?
	let never: LiteralDecodeTransition = require_literal_chunk(byte_chunk_from_hex("14072f736563726574")?, table)?
	let results_match: Bool = literal_transition_matches(incremental, "incremental_indexing", ":path", byte_chunk_from_hex("2f746172676574")?, 9)? and literal_transition_matches(without, "without_indexing", ":path", byte_chunk_from_hex("2f736b6970")?, 7)? and literal_transition_matches(never, "never_indexed", ":path", byte_chunk_from_hex("2f736563726574")?, 9)?
	let inserted: DynamicTable = http2::hpack::literal_decode_table(incremental)
	let states_match: Bool = dynamic_entry_matches(inserted, 1, ":path", byte_chunk_from_hex("2f746172676574")?)? and dynamic_entry_matches(inserted, 2, "older", byte_chunk_from_hex("31")?)? and dynamic_entry_matches(http2::hpack::literal_decode_table(without), 1, "older", byte_chunk_from_hex("31")?)? and dynamic_entry_matches(http2::hpack::literal_decode_table(never), 1, "older", byte_chunk_from_hex("31")?)?
	if results_match and states_match and http2::hpack::dynamic_table_entry_count(table) == 1
		Ok(())
	else
		Err("HPACK literal representation or immutable table transition changed")
	end
end

test literal_header_decoder_preserves_raw_and_huffman_octets() -> Result<(), String>
	let table: DynamicTable = http2::hpack::empty_dynamic_table(128)?
	let raw: LiteralDecodeTransition = require_literal_chunk(byte_chunk_from_hex("4001780200ff")?, table)?
	let huffman_name: LiteralDecodeTransition = require_literal_chunk(byte_chunk_from_hex("008349509f026f6b")?, table)?
	let huffman_value: LiteralDecodeTransition = require_literal_chunk(byte_chunk_from_hex("0485ffc7ffffdd")?, table)?
	if literal_transition_matches(raw, "incremental_indexing", "x", byte_chunk_from_hex("00ff")?, 6)? and literal_transition_matches(huffman_name, "without_indexing", "test", byte_chunk_from_hex("6f6b")?, 8)? and literal_transition_matches(huffman_value, "without_indexing", ":path", byte_chunk_from_hex("00ff")?, 7)?
		Ok(())
	else
		Err("HPACK literal raw or Huffman octet decoding changed")
	end
end

test literal_header_decoder_resolves_dynamic_names_and_multi_octet_prefixes() -> Result<(), String>
	let table: DynamicTable = build_indexed_dynamic_table(66, http2::hpack::empty_dynamic_table(4096)?)?
	let direct: LiteralDecodeTransition = require_literal_chunk(byte_chunk_from_hex("0f7000")?, table)?
	let long_name: ByteChunk = repeated_octet(97, 128)?
	let long_input: ByteChunk = byte_append(byte_chunk_from_hex("007f01")?, byte_append(long_name, byte_chunk_from_hex("00")?))
	let long: LiteralDecodeTransition = require_literal_chunk(long_input, table)?
	let long_value: ByteChunk = repeated_octet(255, 128)?
	let long_value_input: ByteChunk = byte_append(byte_chunk_from_hex("047f01")?, long_value)
	let long_value_transition: LiteralDecodeTransition = require_literal_chunk(long_value_input, table)?
	if literal_transition_matches(direct, "without_indexing", "x", byte_chunk([]), 3)? and http2::hpack::literal_decode_consumed(long) == 132 and http2::hpack::literal_header_name(http2::hpack::literal_decode_header(long)) == "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa" and literal_transition_matches(long_value_transition, "without_indexing", ":path", long_value, 131)?
		Ok(())
	else
		Err("HPACK literal multi-octet name index or length decoding changed")
	end
end

