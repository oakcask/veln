test indexed_header_decoder_resolves_dynamic_entries_newest_first() -> Result<(), String>
	let older: DynamicTable = http2::hpack::insert_dynamic_table_entry(http2::hpack::empty_dynamic_table(128)?, "older", byte_chunk_from_hex("31")?)?
	let table: DynamicTable = http2::hpack::insert_dynamic_table_entry(older, "newest", byte_chunk_from_hex("00ff")?)?
	let newest: IndexedDecodeTransition = require_indexed_chunk(byte_chunk_from_hex("be")?, table)?
	let previous: IndexedDecodeTransition = require_indexed_chunk(byte_chunk_from_hex("bf")?, table)?
	let matches: Bool = indexed_transition_matches(newest, "newest", byte_chunk_from_hex("00ff")?, 1)? and indexed_transition_matches(previous, "older", byte_chunk_from_hex("31")?, 1)?
	let states_preserved: Bool = table_matches_two_entries(table, 128, 78)? and table_matches_two_entries(http2::hpack::indexed_decode_table(newest), 128, 78)? and table_matches_two_entries(http2::hpack::indexed_decode_table(previous), 128, 78)?
	if matches and states_preserved
		Ok(())
	else
		Err("HPACK indexed dynamic entry order or state preservation changed")
	end
end

