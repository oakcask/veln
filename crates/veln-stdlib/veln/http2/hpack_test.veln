test literal_header_decoder_supports_all_representations_and_table_transitions() -> Result<(), String>
	let table = http2::hpack::insert_dynamic_table_entry(http2::hpack::empty_dynamic_table(256)?, "older", byte_chunk_from_hex("31")?)?
	let incremental = require_literal_chunk(byte_chunk_from_hex("44072f746172676574")?, table)?
	let without = require_literal_chunk(byte_chunk_from_hex("04052f736b6970")?, table)?
	let never = require_literal_chunk(byte_chunk_from_hex("14072f736563726574")?, table)?
	let results_match = literal_transition_matches(incremental, "incremental_indexing", ":path", byte_chunk_from_hex("2f746172676574")?, 9)? and literal_transition_matches(without, "without_indexing", ":path", byte_chunk_from_hex("2f736b6970")?, 7)? and literal_transition_matches(never, "never_indexed", ":path", byte_chunk_from_hex("2f736563726574")?, 9)?
	let inserted = http2::hpack::literal_decode_table(incremental)
	let states_match = dynamic_entry_matches(inserted, 1, ":path", byte_chunk_from_hex("2f746172676574")?)? and dynamic_entry_matches(inserted, 2, "older", byte_chunk_from_hex("31")?)? and dynamic_entry_matches(http2::hpack::literal_decode_table(without), 1, "older", byte_chunk_from_hex("31")?)? and dynamic_entry_matches(http2::hpack::literal_decode_table(never), 1, "older", byte_chunk_from_hex("31")?)?
	if results_match and states_match and http2::hpack::dynamic_table_entry_count(table) == 1
		Ok(())
	else
		Err("HPACK literal representation or immutable table transition changed")
	end
end

