	let shrunk = http2::hpack::table_size_update_table(shrunk_transition)
	let grown_transition = require_table_size_update_chunk(byte_chunk_from_hex("3f8101")?, shrunk, 160)?
	let grown = http2::hpack::table_size_update_table(grown_transition)
	let shrink_match = http2::hpack::dynamic_table_capacity(shrunk) == 36 and http2::hpack::dynamic_table_size(shrunk) == 36 and dynamic_entry_matches(shrunk, 1, "bb", byte_chunk_from_hex("3232")?)? and dynamic_entry_is_missing(shrunk, 2)
