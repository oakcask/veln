fn flow_control_initial_rejects(result: Result<CoreInitialWindowSize, FlowControlDomainFailure>, expected_domain: String, expected_observed: Int, expected_min: Int, expected_max: Int) -> Bool
	match result
		Ok(_) => false
		Err(failure) => http2::core::flow_control_failure_domain(failure) == expected_domain and http2::core::flow_control_failure_observed_value(failure) == expected_observed and http2::core::flow_control_failure_accepted_min_value(failure) == expected_min and http2::core::flow_control_failure_accepted_max_value(failure) == expected_max
	end
