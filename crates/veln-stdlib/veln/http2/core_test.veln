use prelude
use http2::core
use http2::core::settings_ack

fn byte_at(chunk: ByteChunk, index: Int) -> Result<Int, String>
	byte_read_u8_be(byte_view(chunk, byte_offset(index)?, byte_count(1)?)?)
end

fn chunks_equal_at(left: ByteChunk, right: ByteChunk, index: Int, count: Int) -> Result<Bool, String>
	if index == count
		Ok(true)
	else if byte_at(left, index)? == byte_at(right, index)?
		chunks_equal_at(left, right, index + 1, count)
	else
		Ok(false)
	end
end

fn chunks_equal(left: ByteChunk, right: ByteChunk) -> Result<Bool, String>
	let count: Int = byte_count_to_int(byte_chunk_count(left))
	if count == byte_count_to_int(byte_chunk_count(right))
		chunks_equal_at(left, right, 0, count)
	else
		Ok(false)
	end
end

fn require_transition(result: Result<HeaderBlockTransition, HeaderBlockFailure>) -> Result<HeaderBlockTransition, String>
	match result
		Ok(transition) => Ok(transition)
		Err(failure) => Err(http2::core::header_block_failure_kind(failure))
	end
end

fn require_preface_transition(result: Result<ConnectionPrefaceTransition, ConnectionPrefaceFailure>) -> Result<ConnectionPrefaceTransition, String>
	match result
		Ok(transition) => Ok(transition)
		Err(failure) => Err(http2::core::connection_preface_failure_kind(failure))
	end
end

fn accept_preface_byte_by_byte(state: ConnectionPrefaceState, input: ByteChunk, index: Int, count: Int) -> Result<ConnectionPrefaceTransition, String>
	let remaining: ByteChunk = byte_drop(input, byte_count(index)?)?
	let octet: ByteChunk = byte_take(remaining, byte_count(1)?)?
	let transition: ConnectionPrefaceTransition = require_preface_transition(http2::core::accept_connection_preface(state, octet))?
	if index + 1 == count
		Ok(transition)
	else if http2::core::connection_preface_is_complete(transition)
		Err("connection preface completed before the final octet")
	else
		accept_preface_byte_by_byte(http2::core::connection_preface_state(transition), input, index + 1, count)
	end
end

fn active_headers(fragment: ByteChunk) -> PendingHeaderBlock
	http2::core::header_block_state(http2::core::start_header_block(1, 1, 17, 1, true, 0, fragment, false))
end

fn payload_length_accepts(kind: Int, flags: Int, length: Int) -> Bool
	match http2::core::validate_frame_payload_length(17, kind, flags, 3, length, "test-state", byte_chunk([]))
		Ok(_) => true
		Err(_) => false
	end
end

fn payload_length_rejects(kind: Int, flags: Int, length: Int, expected: Int, active_state: String, rule: String) -> Bool
	match http2::core::validate_frame_payload_length(17, kind, flags, 3, length, active_state, byte_chunk([]))
		Ok(_) => false
		Err(failure) => http2::core::frame_payload_length_failure_offset(failure) == 17 and http2::core::frame_payload_length_failure_frame_kind(failure) == kind and http2::core::frame_payload_length_failure_stream_id(failure) == 3 and http2::core::frame_payload_length_failure_observed_length(failure) == length and http2::core::frame_payload_length_failure_expected_length(failure) == expected and http2::core::frame_payload_length_failure_active_state(failure) == active_state and http2::core::frame_payload_length_failure_rule_provenance(failure) == rule
	end
end

fn fail_settings_ack_header(length: Int, kind: Int, flags: Int, stream_id: Int) -> Result<ByteChunk, String>
	Err("injected SETTINGS ACK header failure")
end

fn initial_settings_accepts(state: InitialPeerSettingsGateState) -> Result<Bool, String>
	let preview: ByteChunk = byte_chunk_from_hex("000000040000000000")?
	Ok(match http2::core::accept_initial_peer_settings(state, 24, 4, 0, 0, preview)
		Ok(_) => true
		Err(_) => false
	end)
end

fn initial_settings_rejects(state: InitialPeerSettingsGateState, kind: Int, flags: Int) -> Result<Bool, String>
	let preview: ByteChunk = byte_chunk_from_hex("000000060100000000")?
	Ok(match http2::core::accept_initial_peer_settings(state, 24, kind, flags, 0, preview)
		Ok(_) => false
		Err(_) => true
	end)
end

fn require_initial_settings_transition(result: Result<InitialPeerSettingsTransition, InitialPeerSettingsFailure>) -> Result<InitialPeerSettingsTransition, String>
	match result
		Ok(transition) => Ok(transition)
		Err(failure) => Err(http2::core::initial_peer_settings_failure_id(failure))
	end
end

fn require_ping_request_failure(decision: PingRequestDecision) -> Result<FramePayloadLengthFailure, String>
	http2::core::ping_request_failure(decision)
end

fn require_local_settings_sent(decision: LocalSettingsSendDecision) -> Result<LocalSettingsSendDecision, String>
	match http2::core::local_settings_send_status(decision)
		"accepted" => Ok(decision)
		"rejected" => Err(http2::core::local_settings_failure_id(require_local_settings_failure(decision)?))
		_ => Err(http2::core::local_settings_send_encode_reason(decision))
	end
end

fn require_local_settings_failure(decision: LocalSettingsSendDecision) -> Result<LocalSettingsFailure, String>
	match decision
		LocalSettingsRejected(failure) => Ok(failure)
		_ => Err("local SETTINGS send did not reject")
	end
end

fn local_setting_accepts(item: LocalSettingsItem, expected_identifier: Int, expected_hex: String) -> Result<Bool, String>
	let decision: LocalSettingsSendDecision = require_local_settings_sent(http2::core::send_local_setting(item, "server", http2::core::empty_local_settings_policy(), http2::core::empty_settings_ack_state())?)?
	Ok(http2::core::local_settings_send_identifier(decision) == expected_identifier and chunks_equal(http2::core::local_settings_send_bytes(decision), byte_chunk_from_hex(expected_hex)?)? and http2::core::outstanding_settings_identifier(http2::core::settings_ack_outstanding(http2::core::local_settings_send_ack_state(decision))) == expected_identifier and http2::core::outstanding_settings_batch_count(http2::core::settings_ack_outstanding(http2::core::local_settings_send_ack_state(decision))) == 1)
end

fn local_setting_rejects(item: LocalSettingsItem, expected_identifier: Int, expected_name: String, expected_observed: Int, expected_min: Int, expected_max: Int) -> Result<Bool, String>
	let decision: LocalSettingsSendDecision = http2::core::send_local_setting(item, "server", http2::core::empty_local_settings_policy(), http2::core::empty_settings_ack_state())?
	match decision
		LocalSettingsRejected(failure) => Ok(http2::core::local_settings_failure_id(failure) == "http2.peer_limit.settings_value_out_of_range" and http2::core::local_settings_failure_offset(failure) == 0 and http2::core::local_settings_failure_setting_identifier(failure) == expected_identifier and http2::core::local_settings_failure_setting_name(failure) == expected_name and http2::core::local_settings_failure_observed_value(failure) == expected_observed and http2::core::local_settings_failure_accepted_min_value(failure) == expected_min and http2::core::local_settings_failure_accepted_max_value(failure) == expected_max and http2::core::local_settings_failure_peer_limit_provenance(failure) == "local_settings" and byte_count_to_int(byte_chunk_count(http2::core::local_settings_send_bytes(decision))) == 0)
		_ => Ok(false)
	end
end

fn peer_settings_accepts(hex: String, endpoint_role: String, expected_count: Int) -> Result<Bool, String>
	match http2::core::validate_peer_settings_payload(9, endpoint_role, byte_chunk_from_hex(hex)?)
		Ok(validation) => Ok(http2::core::peer_settings_validation_status(validation) == "accepted" and http2::core::peer_settings_accepted_item_count(validation) == expected_count)
		Err(_) => Ok(false)
	end
end

fn peer_settings_rejects(hex: String, endpoint_role: String, expected_offset: Int, expected_identifier: Int, expected_name: String, expected_observed: Int, expected_min: Int, expected_max: Int, expected_preview_hex: String) -> Result<Bool, String>
	match http2::core::validate_peer_settings_payload(9, endpoint_role, byte_chunk_from_hex(hex)?)
		Ok(validation) => peer_settings_value_rejection_matches(validation, expected_offset, expected_identifier, expected_name, expected_observed, expected_min, expected_max, expected_preview_hex)
		Err(_) => Ok(false)
	end
end

fn peer_settings_value_rejection_matches(validation: PeerSettingsValidation, expected_offset: Int, expected_identifier: Int, expected_name: String, expected_observed: Int, expected_min: Int, expected_max: Int, expected_preview_hex: String) -> Result<Bool, String>
	match http2::core::peer_settings_validation_status(validation)
		"rejected" => peer_settings_value_failure_matches(http2::core::peer_settings_validation_failure(validation)?, expected_offset, expected_identifier, expected_name, expected_observed, expected_min, expected_max, expected_preview_hex)
		_ => Ok(false)
	end
end

fn peer_settings_value_failure_matches(failure: PeerSettingsFailure, expected_offset: Int, expected_identifier: Int, expected_name: String, expected_observed: Int, expected_min: Int, expected_max: Int, expected_preview_hex: String) -> Result<Bool, String>
	Ok(http2::core::peer_settings_failure_id(failure) == "http2.peer_limit.settings_value_out_of_range" and http2::core::peer_settings_failure_offset(failure) == expected_offset and http2::core::peer_settings_failure_setting_identifier(failure) == expected_identifier and http2::core::peer_settings_failure_setting_name(failure) == expected_name and http2::core::peer_settings_failure_observed_value(failure) == expected_observed and http2::core::peer_settings_failure_accepted_min_value(failure) == expected_min and http2::core::peer_settings_failure_accepted_max_value(failure) == expected_max and http2::core::peer_settings_failure_peer_limit_provenance(failure) == "peer_settings" and chunks_equal(byte_view_to_chunk(http2::core::peer_settings_failure_preview(failure)), byte_chunk_from_hex(expected_preview_hex)?)?)
end

fn peer_settings_role_rejects(hex: String, endpoint_role: String, expected_offset: Int, expected_identifier: Int, expected_name: String, expected_rule: String, expected_preview_hex: String) -> Result<Bool, String>
	match http2::core::validate_peer_settings_payload(9, endpoint_role, byte_chunk_from_hex(hex)?)
		Ok(validation) => peer_settings_role_rejection_matches(validation, endpoint_role, expected_offset, expected_identifier, expected_name, expected_rule, expected_preview_hex)
		Err(_) => Ok(false)
	end
end

fn peer_settings_role_rejection_matches(validation: PeerSettingsValidation, endpoint_role: String, expected_offset: Int, expected_identifier: Int, expected_name: String, expected_rule: String, expected_preview_hex: String) -> Result<Bool, String>
	match http2::core::peer_settings_validation_status(validation)
		"rejected" => peer_settings_role_failure_matches(http2::core::peer_settings_validation_failure(validation)?, endpoint_role, expected_offset, expected_identifier, expected_name, expected_rule, expected_preview_hex)
		_ => Ok(false)
	end
end

fn peer_settings_role_failure_matches(failure: PeerSettingsFailure, endpoint_role: String, expected_offset: Int, expected_identifier: Int, expected_name: String, expected_rule: String, expected_preview_hex: String) -> Result<Bool, String>
	Ok(http2::core::peer_settings_failure_id(failure) == "http2.protocol.settings_not_allowed_for_endpoint" and http2::core::peer_settings_failure_offset(failure) == expected_offset and http2::core::peer_settings_failure_setting_identifier(failure) == expected_identifier and http2::core::peer_settings_failure_setting_name(failure) == expected_name and http2::core::peer_settings_failure_endpoint_role(failure) == endpoint_role and http2::core::peer_settings_failure_frame_kind(failure) == 4 and http2::core::peer_settings_failure_active_state(failure) == "peer-settings" and http2::core::peer_settings_failure_rule_provenance(failure) == expected_rule and chunks_equal(byte_view_to_chunk(http2::core::peer_settings_failure_preview(failure)), byte_chunk_from_hex(expected_preview_hex)?)?)
end

fn stream_id_accepts(result: Result<StreamId, String>, expected: Int) -> Bool
	match result
		Ok(stream_id) => http2::core::stream_id_value(stream_id) == expected
		Err(_) => false
	end
end

fn stream_id_rejects(result: Result<StreamId, String>) -> Bool
	match result
		Ok(_) => false
		Err(_) => true
	end
end

