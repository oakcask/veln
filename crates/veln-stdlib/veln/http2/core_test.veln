test connection_shutdown_applies_goaway_and_completes_drain() -> Result<(), String>
	let base: CoreConnectionState = http2::core::server_connection_state(31)?
	let active_stream: CoreStreamEntry = require_stream_entry(http2::core::stream_entry(5, http2::core::stream_open_lifecycle(), 14, 21, 0, 0))?
	let active_state: CoreConnectionState = http2::core::connection_state_with_streams(base, http2::core::stream_collection_add_or_replace(http2::core::connection_state_streams(base), active_stream))
	let first: CoreConnectionShutdownDecision = http2::core::apply_goaway_receive_shutdown(active_state, 31, byte_chunk_from_hex("000000050000000b")?, byte_chunk_from_hex("000008070000000000")?)
	let first_state: CoreConnectionState = require_connection_shutdown_state(first)?
	let closed_stream: CoreStreamEntry = require_stream_entry(http2::core::stream_entry(5, http2::core::stream_closed_lifecycle(), 14, 21, 0, 0))?
	let ready_to_drain: CoreConnectionState = http2::core::connection_state_with_streams(first_state, http2::core::stream_collection_add_or_replace(http2::core::connection_state_streams(first_state), closed_stream))
	let drained: CoreConnectionState = http2::core::complete_connection_shutdown_drain(ready_to_drain)
	let tightened: CoreConnectionShutdownDecision = http2::core::apply_goaway_receive_shutdown(first_state, 44, byte_chunk_from_hex("0000000300000016")?, byte_chunk_from_hex("000008070000000000")?)
	let tightened_state: CoreConnectionState = require_connection_shutdown_state(tightened)?
	if http2::core::connection_shutdown_status(first) == "accepted" and http2::core::connection_lifecycle_label(http2::core::connection_state_lifecycle(first_state)) == "draining" and http2::core::connection_lifecycle_last_stream_id(http2::core::connection_state_lifecycle(first_state)) == 5 and http2::core::connection_lifecycle_error_code(http2::core::connection_state_lifecycle(first_state)) == 11 and http2::core::connection_lifecycle_label(http2::core::connection_state_lifecycle(drained)) == "closed" and http2::core::connection_lifecycle_last_stream_id(http2::core::connection_state_lifecycle(drained)) == 5 and http2::core::connection_lifecycle_label(http2::core::connection_state_lifecycle(tightened_state)) == "closed" and http2::core::connection_lifecycle_last_stream_id(http2::core::connection_state_lifecycle(tightened_state)) == 3 and http2::core::connection_lifecycle_error_code(http2::core::connection_state_lifecycle(tightened_state)) == 22 and http2::core::connection_lifecycle_label(http2::core::connection_state_lifecycle(active_state)) == "open"
		Ok(())
	else
		Err("HTTP/2 GOAWAY receive shutdown did not update lifecycle and drain immutably")
	end
end

test connection_shutdown_rejects_relaxed_goaway_boundary_without_state() -> Result<(), String>
	let state: CoreConnectionState = http2::core::connection_state_with_lifecycle(http2::core::server_connection_state(31)?, http2::core::connection_lifecycle_draining(3, 11))
	let decision: CoreConnectionShutdownDecision = http2::core::apply_goaway_receive_shutdown(state, 44, byte_chunk_from_hex("0000000500000016")?, byte_chunk_from_hex("000008070000000000")?)
