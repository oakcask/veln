test settings_ack_accepts_local_batches_fifo() -> Result<(), String>
	let initial: SettingsAckState = http2::core::empty_settings_ack_state()
	let first: SettingsAckState = http2::core::record_local_settings_batch(initial, 5, 1)
	let second: SettingsAckState = http2::core::record_local_settings_batch(first, 4, 2)
	let preview: ByteView = byte_view(byte_chunk_from_hex("000000040100000000")?, byte_offset(0)?, byte_count(9)?)?
	let acknowledged_first: SettingsAckState = match http2::core::accept_settings_ack(second, 17, preview)
		Ok(state) => state
		Err(_) => Err("first SETTINGS ACK was rejected")?
	end
	let acknowledged_second: SettingsAckState = match http2::core::accept_settings_ack(acknowledged_first, 26, preview)
		Ok(state) => state
		Err(_) => Err("second SETTINGS ACK was rejected")?
	end
	if http2::core::outstanding_settings_identifier(http2::core::settings_ack_outstanding(second)) == 5 and http2::core::outstanding_settings_count(http2::core::settings_ack_outstanding(second)) == 1 and http2::core::outstanding_settings_batch_count(http2::core::settings_ack_outstanding(second)) == 2 and http2::core::outstanding_settings_identifier(http2::core::settings_ack_outstanding(acknowledged_first)) == 4 and http2::core::outstanding_settings_count(http2::core::settings_ack_outstanding(acknowledged_first)) == 2 and http2::core::outstanding_settings_batch_count(http2::core::settings_ack_outstanding(acknowledged_first)) == 1 and http2::core::outstanding_settings_label(http2::core::settings_ack_outstanding(acknowledged_second)) == "none"
		Ok(())
	else
		Err("SETTINGS ACK did not remove outstanding local batches in FIFO order")
	end
end

test settings_ack_unexpected_failure_preserves_context() -> Result<(), String>
	let state: SettingsAckState = http2::core::empty_settings_ack_state()
