use prelude
use http2::core

fn byte_at(chunk: ByteChunk, index: Int) -> Result<Int, String>
	byte_read_u8_be(byte_view(chunk, byte_offset(index)?, byte_count(1)?)?)
end

fn chunks_equal_at(left: ByteChunk, right: ByteChunk, index: Int, count: Int) -> Result<Bool, String>
	if index == count
		Ok(true)
	else if byte_at(left, index)? == byte_at(right, index)?
		chunks_equal_at(left, right, index + 1, count)
	else
		Ok(false)
	end
end

fn chunks_equal(left: ByteChunk, right: ByteChunk) -> Result<Bool, String>
	let count: Int = byte_count_to_int(byte_chunk_count(left))
	if count == byte_count_to_int(byte_chunk_count(right))
		chunks_equal_at(left, right, 0, count)
	else
		Ok(false)
	end
end

fn require_transition(result: Result<HeaderBlockTransition, HeaderBlockFailure>) -> Result<HeaderBlockTransition, String>
	match result
		Ok(transition) => Ok(transition)
		Err(failure) => Err(http2::core::header_block_failure_kind(failure))
	end
end

fn require_preface_transition(result: Result<ConnectionPrefaceTransition, ConnectionPrefaceFailure>) -> Result<ConnectionPrefaceTransition, String>
	match result
		Ok(transition) => Ok(transition)
		Err(failure) => Err(http2::core::connection_preface_failure_kind(failure))
	end
end

fn accept_preface_byte_by_byte(state: ConnectionPrefaceState, input: ByteChunk, index: Int, count: Int) -> Result<ConnectionPrefaceTransition, String>
	let remaining: ByteChunk = byte_drop(input, byte_count(index)?)?
	let octet: ByteChunk = byte_take(remaining, byte_count(1)?)?
	let transition: ConnectionPrefaceTransition = require_preface_transition(http2::core::accept_connection_preface(state, octet))?
	if index + 1 == count
		Ok(transition)
	else if http2::core::connection_preface_is_complete(transition)
		Err("connection preface completed before the final octet")
	else
		accept_preface_byte_by_byte(http2::core::connection_preface_state(transition), input, index + 1, count)
	end
end

fn active_headers(fragment: ByteChunk) -> PendingHeaderBlock
	http2::core::header_block_state(http2::core::start_header_block(1, 1, 17, 1, true, 0, fragment, false))
end

fn payload_length_accepts(kind: Int, flags: Int, length: Int) -> Bool
	match http2::core::validate_frame_payload_length(17, kind, flags, 3, length, "test-state", byte_chunk([]))
		Ok(_) => true
		Err(_) => false
	end
end

fn payload_length_rejects(kind: Int, flags: Int, length: Int, expected: Int, active_state: String, rule: String) -> Bool
	match http2::core::validate_frame_payload_length(17, kind, flags, 3, length, active_state, byte_chunk([]))
		Ok(_) => false
		Err(failure) => http2::core::frame_payload_length_failure_offset(failure) == 17 and http2::core::frame_payload_length_failure_frame_kind(failure) == kind and http2::core::frame_payload_length_failure_stream_id(failure) == 3 and http2::core::frame_payload_length_failure_observed_length(failure) == length and http2::core::frame_payload_length_failure_expected_length(failure) == expected and http2::core::frame_payload_length_failure_active_state(failure) == active_state and http2::core::frame_payload_length_failure_rule_provenance(failure) == rule
	end
end

fn initial_settings_accepts(state: InitialPeerSettingsGateState) -> Result<Bool, String>
	let preview: ByteChunk = byte_chunk_from_hex("000000040000000000")?
	Ok(match http2::core::accept_initial_peer_settings(state, 24, 4, 0, 0, preview)
		Ok(_) => true
		Err(_) => false
	end)
end

fn initial_settings_rejects(state: InitialPeerSettingsGateState, kind: Int, flags: Int) -> Result<Bool, String>
	let preview: ByteChunk = byte_chunk_from_hex("000000060100000000")?
	Ok(match http2::core::accept_initial_peer_settings(state, 24, kind, flags, 0, preview)
		Ok(_) => false
		Err(_) => true
	end)
end

fn require_initial_settings_transition(result: Result<InitialPeerSettingsTransition, InitialPeerSettingsFailure>) -> Result<InitialPeerSettingsTransition, String>
	match result
		Ok(transition) => Ok(transition)
		Err(failure) => Err(http2::core::initial_peer_settings_failure_id(failure))
	end
end

fn require_ping_request_failure(decision: PingRequestDecision) -> Result<FramePayloadLengthFailure, String>
	http2::core::ping_request_failure(decision)
end

test stream_domains_are_role_aware() -> Result<(), String>
	let client: StreamId = http2::core::client_stream_id(1)?
	let server: StreamId = http2::core::server_stream_id(2)?
	match http2::core::stream_id_value(client) == 1 and http2::core::stream_id_value(server) == 2
		true => Ok(())
		false => Err("HTTP/2 stream domains did not retain validated values")
	end
end

test stream_domains_project_connection_and_real_references() -> Result<(), String>
	let client: StreamId = http2::core::client_stream_id(1)?
	let server: StreamId = http2::core::server_stream_id(2)?
	let connection: StreamRef = http2::core::connection_stream_ref()
	let client_ref: StreamRef = http2::core::real_stream_ref(client)
	let server_ref: StreamRef = http2::core::real_stream_ref(server)
	if http2::core::stream_ref_is_connection(connection) and not http2::core::stream_ref_is_real(connection) and http2::core::stream_ref_value(connection) == 0 and not http2::core::stream_ref_is_connection(client_ref) and http2::core::stream_ref_is_real(client_ref) and http2::core::stream_ref_value(client_ref) == 1 and not http2::core::stream_ref_is_connection(server_ref) and http2::core::stream_ref_is_real(server_ref) and http2::core::stream_ref_value(server_ref) == 2
		Ok(())
	else
		Err("HTTP/2 stream references did not preserve connection or real-stream projections")
	end
end

test stream_domains_accept_lower_bounds_and_reject_invalid_boundaries() -> Result<(), String>
	match http2::core::client_stream_id(0)
		Ok(_) => Err("zero entered the HTTP/2 stream id domain")
		Err(_) => match http2::core::server_stream_id(2147483648)
			Ok(_) => Err("one above the HTTP/2 stream id upper bound entered the domain")
			Err(_) => match http2::core::client_stream_id(2)
				Ok(_) => Err("even stream id entered the client stream domain")
				Err(_) => match http2::core::server_stream_id(3)
					Ok(_) => Err("odd stream id entered the server stream domain")
					Err(_) => Ok(())
				end
			end
		end
	end
end

test initial_peer_settings_gate_accepts_server_and_client_roles() -> Result<(), String>
	let server: InitialPeerSettingsGateState = http2::core::server_initial_peer_settings_gate()
	let client: InitialPeerSettingsGateState = http2::core::client_initial_peer_settings_gate()
	if initial_settings_accepts(server)? and initial_settings_accepts(client)?
		Ok(())
	else
		Err("initial peer SETTINGS gate rejected a non-ACK SETTINGS frame")
	end
end

test initial_peer_settings_gate_accepts_without_changing_input_state_or_preview() -> Result<(), String>
	let state: InitialPeerSettingsGateState = http2::core::server_initial_peer_settings_gate()
	let preview: ByteChunk = byte_chunk_from_hex("000006040000000000000500008000")?
	let transition: InitialPeerSettingsTransition = require_initial_settings_transition(http2::core::accept_initial_peer_settings(state, 24, 4, 0, 0, preview))?
	let accepted: InitialPeerSettingsAcceptedState = http2::core::initial_peer_settings_state(transition)
	if http2::core::initial_peer_settings_is_waiting(state) and http2::core::initial_peer_settings_endpoint_role(state) == "server" and http2::core::accepted_initial_peer_settings_endpoint_role(accepted) == "server" and chunks_equal(preview, byte_chunk_from_hex("000006040000000000000500008000")?)?
		Ok(())
	else
		Err("accepted initial peer SETTINGS changed the input state or preview")
	end
end

test initial_peer_settings_gate_preserves_role_in_successful_next_state() -> Result<(), String>
	let server: InitialPeerSettingsTransition = match http2::core::accept_initial_peer_settings(http2::core::server_initial_peer_settings_gate(), 24, 4, 0, 0, byte_chunk([]))
		Ok(transition) => transition
		Err(_) => Err("server initial peer SETTINGS transition failed")?
	end
	let client: InitialPeerSettingsTransition = match http2::core::accept_initial_peer_settings(http2::core::client_initial_peer_settings_gate(), 0, 4, 2, 0, byte_chunk([]))
		Ok(transition) => transition
		Err(_) => Err("client initial peer SETTINGS transition failed")?
	end
	let server_state: InitialPeerSettingsAcceptedState = http2::core::initial_peer_settings_state(server)
	let client_state: InitialPeerSettingsAcceptedState = http2::core::initial_peer_settings_state(client)
	if http2::core::accepted_initial_peer_settings_endpoint_role(server_state) == "server" and http2::core::accepted_initial_peer_settings_endpoint_role(client_state) == "client"
		Ok(())
	else
		Err("accepted initial peer SETTINGS transition lost its endpoint role or next state")
	end
end

test initial_peer_settings_gate_rejects_non_settings_and_ack_frames() -> Result<(), String>
	if initial_settings_rejects(http2::core::server_initial_peer_settings_gate(), 6, 0)? and initial_settings_rejects(http2::core::client_initial_peer_settings_gate(), 6, 0)? and initial_settings_rejects(http2::core::server_initial_peer_settings_gate(), 4, 1)? and initial_settings_rejects(http2::core::client_initial_peer_settings_gate(), 4, 1)? and initial_settings_rejects(http2::core::server_initial_peer_settings_gate(), 4, 5)? and initial_settings_rejects(http2::core::client_initial_peer_settings_gate(), 4, 5)?
		Ok(())
	else
		Err("initial peer SETTINGS gate accepted a non-SETTINGS or SETTINGS ACK frame")
	end
end

test initial_peer_settings_gate_failure_preserves_exact_context() -> Result<(), String>
	let preview: ByteChunk = byte_chunk_from_hex("000000060100000000")?
	match http2::core::accept_initial_peer_settings(http2::core::server_initial_peer_settings_gate(), 24, 6, 1, 0, preview)
		Ok(_) => Err("invalid initial peer frame exposed a successful transition")
		Err(failure) => if http2::core::initial_peer_settings_failure_id(failure) == "http2.protocol.initial_peer_settings_required" and http2::core::initial_peer_settings_failure_offset(failure) == 24 and http2::core::initial_peer_settings_failure_frame_kind(failure) == 6 and http2::core::initial_peer_settings_failure_flags(failure) == 1 and http2::core::initial_peer_settings_failure_stream_id(failure) == 0 and http2::core::initial_peer_settings_failure_endpoint_role(failure) == "server" and http2::core::initial_peer_settings_failure_active_state(failure) == "expect-initial-peer-settings" and http2::core::initial_peer_settings_failure_rule_provenance(failure) == "rfc9113_initial_peer_frame_requires_non_ack_settings" and chunks_equal(http2::core::initial_peer_settings_failure_preview(failure), preview)?
			Ok(())
		else
			Err("initial peer SETTINGS failure lost exact diagnostic context")
		end
	end
end

test initial_peer_settings_gate_failure_preserves_input_state_and_preview() -> Result<(), String>
	let state: InitialPeerSettingsGateState = http2::core::client_initial_peer_settings_gate()
	let preview: ByteChunk = byte_chunk_from_hex("000000040100000000")?
	let rejected: Bool = match http2::core::accept_initial_peer_settings(state, 41, 4, 1, 0, preview)
		Ok(_) => false
		Err(failure) => http2::core::initial_peer_settings_failure_endpoint_role(failure) == "client" and chunks_equal(http2::core::initial_peer_settings_failure_preview(failure), preview)?
	end
	if rejected and http2::core::initial_peer_settings_is_waiting(state) and http2::core::initial_peer_settings_endpoint_role(state) == "client" and chunks_equal(preview, byte_chunk_from_hex("000000040100000000")?)?
		Ok(())
	else
		Err("initial peer SETTINGS rejection changed the input state or preview")
	end
end

test frame_payload_length_validates_fixed_and_minimum_boundaries() -> Result<(), String>
	if payload_length_rejects(6, 0, 7, 8, "connection-control", "rfc9113_ping_payload_length") and payload_length_accepts(6, 0, 8) and payload_length_rejects(6, 0, 9, 8, "connection-control", "rfc9113_ping_payload_length") and payload_length_rejects(7, 0, 7, 8, "connection-control", "rfc9113_goaway_payload_length") and payload_length_accepts(7, 0, 8) and payload_length_accepts(7, 0, 9) and payload_length_rejects(8, 0, 3, 4, "flow-control", "rfc9113_window_update_payload_length") and payload_length_accepts(8, 0, 4) and payload_length_rejects(8, 0, 5, 4, "flow-control", "rfc9113_window_update_payload_length") and payload_length_rejects(3, 0, 3, 4, "stream-control", "rfc9113_rst_stream_payload_length") and payload_length_accepts(3, 0, 4) and payload_length_rejects(3, 0, 5, 4, "stream-control", "rfc9113_rst_stream_payload_length") and payload_length_rejects(2, 0, 4, 5, "stream-control", "rfc9113_priority_payload_length") and payload_length_accepts(2, 0, 5) and payload_length_rejects(2, 0, 6, 5, "stream-control", "rfc9113_priority_payload_length")
		Ok(())
	else
		Err("fixed or minimum frame payload boundaries were not enforced")
	end
end

test frame_payload_length_validates_settings_ack_and_item_boundaries() -> Result<(), String>
	if payload_length_accepts(4, 1, 0) and payload_length_rejects(4, 1, 1, 0, "connection-control", "rfc9113_settings_ack_payload_length") and payload_length_accepts(4, 0, 0) and payload_length_rejects(4, 0, 5, 6, "connection-control", "rfc9113_settings_payload_item_length") and payload_length_accepts(4, 0, 6) and payload_length_rejects(4, 0, 7, 6, "connection-control", "rfc9113_settings_payload_item_length") and payload_length_accepts(4, 0, 12)
		Ok(())
	else
		Err("SETTINGS ACK or item payload boundaries were not enforced")
	end
end

test frame_payload_length_validates_headers_prefix_flag_matrix() -> Result<(), String>
	if payload_length_accepts(1, 0, 0) and payload_length_accepts(1, 0, 1) and payload_length_rejects(1, 8, 0, 1, "stream-control", "rfc9113_headers_padded_prefix_length") and payload_length_accepts(1, 8, 1) and payload_length_accepts(1, 8, 2) and payload_length_rejects(1, 32, 4, 5, "stream-control", "rfc9113_headers_priority_payload_length") and payload_length_accepts(1, 32, 5) and payload_length_accepts(1, 32, 6) and payload_length_rejects(1, 40, 5, 6, "stream-control", "rfc9113_headers_padded_prefix_length") and payload_length_accepts(1, 40, 6) and payload_length_accepts(1, 40, 7)
		Ok(())
	else
		Err("HEADERS payload prefixes did not follow PADDED and PRIORITY flags")
	end
end

test frame_payload_length_validates_push_promise_prefix_flag_matrix() -> Result<(), String>
	if payload_length_rejects(5, 0, 3, 4, "stream-control", "rfc9113_push_promise_payload_length") and payload_length_accepts(5, 0, 4) and payload_length_accepts(5, 0, 5) and payload_length_rejects(5, 8, 4, 5, "stream-control", "rfc9113_push_promise_padded_prefix_length") and payload_length_accepts(5, 8, 5) and payload_length_accepts(5, 8, 6)
		Ok(())
	else
		Err("PUSH_PROMISE payload prefixes did not follow PADDED")
	end
end

test frame_payload_length_leaves_unconstrained_kinds_unrestricted() -> Result<(), String>
	if payload_length_accepts(0, 0, 0) and payload_length_accepts(0, 0, 9) and payload_length_accepts(9, 0, 0) and payload_length_accepts(9, 0, 9) and payload_length_accepts(10, 255, 0) and payload_length_accepts(10, 255, 9)
		Ok(())
	else
		Err("an unconstrained frame kind acquired a payload length restriction")
	end
end

test frame_payload_length_failure_preserves_exact_preview_without_output() -> Result<(), String>
	let preview: ByteChunk = byte_chunk_from_hex("00010203040506")?
	match http2::core::validate_frame_payload_length(29, 6, 0, 0, 7, "connection-control", preview)
		Ok(_) => Err("invalid PING exposed a successful validation result")
		Err(failure) => if http2::core::frame_payload_length_failure_offset(failure) == 29 and http2::core::frame_payload_length_failure_frame_kind(failure) == 6 and http2::core::frame_payload_length_failure_stream_id(failure) == 0 and http2::core::frame_payload_length_failure_observed_length(failure) == 7 and http2::core::frame_payload_length_failure_expected_length(failure) == 8 and chunks_equal(http2::core::frame_payload_length_failure_preview(failure), preview)? and chunks_equal(preview, byte_chunk_from_hex("00010203040506")?)?
			Ok(())
		else
			Err("payload length failure lost data or changed caller input")
		end
	end
end

test ping_request_accepts_exact_payload_bytes() -> Result<(), String>
	let payload: ByteChunk = byte_chunk_from_hex("0102030405060708")?
	let decision: PingRequestDecision = http2::core::send_ping(payload)
	if http2::core::ping_request_status(decision) == "accepted" and http2::core::ping_request_payload_length(decision) == 8 and http2::core::ping_request_expected_payload_length(decision) == 8 and chunks_equal(http2::core::ping_request_bytes(decision), byte_chunk_from_hex("0000080600000000000102030405060708")?)? and chunks_equal(payload, byte_chunk_from_hex("0102030405060708")?)?
		Ok(())
	else
		Err("PING request did not emit exact frame bytes")
	end
end

test ping_request_rejects_seven_and_nine_octets_without_output() -> Result<(), String>
	let short_payload: ByteChunk = byte_chunk_from_hex("01020304050607")?
	let long_payload: ByteChunk = byte_chunk_from_hex("010203040506070809")?
	let short: PingRequestDecision = http2::core::send_ping(short_payload)
	let long: PingRequestDecision = http2::core::send_ping(long_payload)
	if http2::core::ping_request_status(short) == "rejected" and http2::core::ping_request_payload_length(short) == 7 and http2::core::ping_request_expected_payload_length(short) == 8 and byte_count_to_int(byte_chunk_count(http2::core::ping_request_bytes(short))) == 0 and http2::core::ping_request_status(long) == "rejected" and http2::core::ping_request_payload_length(long) == 9 and http2::core::ping_request_expected_payload_length(long) == 8 and byte_count_to_int(byte_chunk_count(http2::core::ping_request_bytes(long))) == 0
		Ok(())
	else
		Err("PING request rejection did not preserve focused length failure and empty output")
	end
end

test ping_request_failure_preserves_input_and_failure_preview() -> Result<(), String>
	let short_payload: ByteChunk = byte_chunk_from_hex("01020304050607")?
	let long_payload: ByteChunk = byte_chunk_from_hex("010203040506070809")?
	let short_failure: FramePayloadLengthFailure = require_ping_request_failure(http2::core::send_ping(short_payload))?
	let long_failure: FramePayloadLengthFailure = require_ping_request_failure(http2::core::send_ping(long_payload))?
	if http2::core::frame_payload_length_failure_frame_kind(short_failure) == 6 and http2::core::frame_payload_length_failure_stream_id(short_failure) == 0 and http2::core::frame_payload_length_failure_observed_length(short_failure) == 7 and http2::core::frame_payload_length_failure_expected_length(short_failure) == 8 and http2::core::frame_payload_length_failure_active_state(short_failure) == "connection-control" and http2::core::frame_payload_length_failure_rule_provenance(short_failure) == "rfc9113_ping_payload_length" and chunks_equal(http2::core::frame_payload_length_failure_preview(short_failure), short_payload)? and chunks_equal(short_payload, byte_chunk_from_hex("01020304050607")?)? and http2::core::frame_payload_length_failure_frame_kind(long_failure) == 6 and http2::core::frame_payload_length_failure_stream_id(long_failure) == 0 and http2::core::frame_payload_length_failure_observed_length(long_failure) == 9 and http2::core::frame_payload_length_failure_expected_length(long_failure) == 8 and http2::core::frame_payload_length_failure_active_state(long_failure) == "connection-control" and http2::core::frame_payload_length_failure_rule_provenance(long_failure) == "rfc9113_ping_payload_length" and chunks_equal(http2::core::frame_payload_length_failure_preview(long_failure), long_payload)? and chunks_equal(long_payload, byte_chunk_from_hex("010203040506070809")?)?
		Ok(())
	else
		Err("PING request failure changed input or failure context")
	end
end

test ping_response_ack_preserves_payload_and_emits_exact_bytes() -> Result<(), String>
	let payload: ByteChunk = byte_chunk_from_hex("0102030405060708")?
	let decision: PingResponseDecision = http2::core::respond_to_ping(0, payload)
	if http2::core::ping_response_status(decision) == "accepted" and http2::core::ping_response_reason(decision) == "none" and chunks_equal(http2::core::ping_response_bytes(decision), byte_chunk_from_hex("0000080601000000000102030405060708")?)? and chunks_equal(payload, byte_chunk_from_hex("0102030405060708")?)?
		Ok(())
	else
		Err("PING response did not emit exact ACK bytes")
	end
end

test ping_response_ack_received_has_no_response() -> Result<(), String>
	let payload: ByteChunk = byte_chunk_from_hex("0102030405060708")?
	let decision: PingResponseDecision = http2::core::respond_to_ping(1, payload)
	if http2::core::ping_response_status(decision) == "no_response" and http2::core::ping_response_reason(decision) == "ack_received" and byte_count_to_int(byte_chunk_count(http2::core::ping_response_bytes(decision))) == 0 and chunks_equal(payload, byte_chunk_from_hex("0102030405060708")?)?
		Ok(())
	else
		Err("received PING ACK did not suppress the response")
	end
end

test connection_preface_accepts_complete_input_and_preserves_trailing_bytes() -> Result<(), String>
	let input: ByteChunk = byte_chunk_from_hex("505249202a20485454502f322e300d0a0d0a534d0d0a0d0aaabbcc")?
	let transition: ConnectionPrefaceTransition = require_preface_transition(http2::core::accept_connection_preface(http2::core::empty_connection_preface(0), input))?
	let state: ConnectionPrefaceState = http2::core::connection_preface_state(transition)
	if http2::core::connection_preface_is_complete(transition) and http2::core::connection_preface_state_is_complete(state) and http2::core::connection_preface_starting_offset(state) == 0 and http2::core::connection_preface_matched_count(state) == 24 and chunks_equal(http2::core::connection_preface_suffix(transition), byte_chunk_from_hex("aabbcc")?)?
		Ok(())
	else
		Err("complete connection preface did not preserve its trailing input")
	end
end

test connection_preface_accepts_byte_by_byte_input() -> Result<(), String>
	let input: ByteChunk = byte_chunk_from_hex("505249202a20485454502f322e300d0a0d0a534d0d0a0d0a")?
	let transition: ConnectionPrefaceTransition = accept_preface_byte_by_byte(http2::core::empty_connection_preface(17), input, 0, 24)?
	if http2::core::connection_preface_is_complete(transition) and http2::core::connection_preface_starting_offset(http2::core::connection_preface_state(transition)) == 17 and byte_count_to_int(byte_chunk_count(http2::core::connection_preface_suffix(transition))) == 0
		Ok(())
	else
		Err("byte-by-byte connection preface did not complete at the final octet")
	end
end

test connection_preface_accepts_uneven_chunks_and_retains_matched_prefix() -> Result<(), String>
	let first: ConnectionPrefaceTransition = require_preface_transition(http2::core::accept_connection_preface(http2::core::empty_connection_preface(9), byte_chunk_from_hex("505249202a")?))?
	let first_state: ConnectionPrefaceState = http2::core::connection_preface_state(first)
	let second: ConnectionPrefaceTransition = require_preface_transition(http2::core::accept_connection_preface(first_state, byte_chunk_from_hex("20485454502f32")?))?
	let second_state: ConnectionPrefaceState = http2::core::connection_preface_state(second)
	let done: ConnectionPrefaceTransition = require_preface_transition(http2::core::accept_connection_preface(second_state, byte_chunk_from_hex("2e300d0a0d0a534d0d0a0d0a")?))?
	if not http2::core::connection_preface_is_complete(first) and http2::core::connection_preface_matched_count(first_state) == 5 and chunks_equal(http2::core::connection_preface_matched_prefix(first_state), byte_chunk_from_hex("505249202a")?)? and not http2::core::connection_preface_is_complete(second) and http2::core::connection_preface_matched_count(second_state) == 12 and http2::core::connection_preface_is_complete(done)
		Ok(())
	else
		Err("uneven connection-preface chunks lost their matched prefix")
	end
end

test connection_preface_reports_first_middle_and_final_mismatches() -> Result<(), String>
	let first: Bool = match http2::core::accept_connection_preface(http2::core::empty_connection_preface(100), byte_chunk_from_hex("00")?)
		Ok(_) => false
		Err(failure) => http2::core::connection_preface_failure_kind(failure) == "invalid_preface" and http2::core::connection_preface_failure_offset(failure) == 100 and http2::core::connection_preface_failure_expected_octet(failure) == 80 and http2::core::connection_preface_failure_actual_octet(failure) == 0 and http2::core::connection_preface_failure_matched_count(failure) == 0
	end
	let middle: Bool = match http2::core::accept_connection_preface(http2::core::empty_connection_preface(100), byte_chunk_from_hex("505249202a20485454502f322f")?)
		Ok(_) => false
		Err(failure) => http2::core::connection_preface_failure_offset(failure) == 112 and http2::core::connection_preface_failure_expected_octet(failure) == 46 and http2::core::connection_preface_failure_actual_octet(failure) == 47 and http2::core::connection_preface_failure_matched_count(failure) == 12
	end
	let prefix: ConnectionPrefaceTransition = require_preface_transition(http2::core::accept_connection_preface(http2::core::empty_connection_preface(100), byte_chunk_from_hex("505249202a20485454502f322e300d0a0d0a534d0d0a0d")?))?
	let final: Bool = match http2::core::accept_connection_preface(http2::core::connection_preface_state(prefix), byte_chunk_from_hex("00")?)
		Ok(_) => false
		Err(failure) => http2::core::connection_preface_failure_offset(failure) == 123 and http2::core::connection_preface_failure_expected_octet(failure) == 10 and http2::core::connection_preface_failure_actual_octet(failure) == 0 and http2::core::connection_preface_failure_matched_count(failure) == 23
	end
	if first and middle and final
		Ok(())
	else
		Err("connection-preface mismatch coordinates were not exact")
	end
end

test connection_preface_close_reports_partial_input() -> Result<(), String>
	let partial: ByteChunk = byte_chunk_from_hex("505249202a20485454502f32")?
	let transition: ConnectionPrefaceTransition = require_preface_transition(http2::core::accept_connection_preface(http2::core::empty_connection_preface(40), partial))?
	match http2::core::close_connection_preface(http2::core::connection_preface_state(transition))
		Ok(_) => Err("partial connection preface accepted end of input")
		Err(failure) => if http2::core::connection_preface_failure_kind(failure) == "partial_preface" and http2::core::connection_preface_failure_offset(failure) == 40 and http2::core::connection_preface_failure_pending_count(failure) == 12 and chunks_equal(http2::core::connection_preface_failure_preview(failure), partial)?
			Ok(())
		else
			Err("partial connection-preface failure lost its starting offset, count, or preview")
		end
	end
end

test connection_preface_failures_preserve_immutable_input_state() -> Result<(), String>
	let prefix: ByteChunk = byte_chunk_from_hex("505249202a20")?
	let transition: ConnectionPrefaceTransition = require_preface_transition(http2::core::accept_connection_preface(http2::core::empty_connection_preface(7), prefix))?
	let state: ConnectionPrefaceState = http2::core::connection_preface_state(transition)
	let mismatch_preview: ByteChunk = byte_chunk_from_hex("505249202a2000")?
	let mismatch: Bool = match http2::core::accept_connection_preface(state, byte_chunk_from_hex("00")?)
		Ok(_) => false
		Err(failure) => chunks_equal(http2::core::connection_preface_failure_preview(failure), mismatch_preview)?
	end
	let closed: Bool = match http2::core::close_connection_preface(state)
		Ok(_) => false
		Err(failure) => chunks_equal(http2::core::connection_preface_failure_preview(failure), prefix)?
	end
	if mismatch and closed and http2::core::connection_preface_starting_offset(state) == 7 and http2::core::connection_preface_matched_count(state) == 6 and chunks_equal(http2::core::connection_preface_matched_prefix(state), prefix)?
		Ok(())
	else
		Err("connection-preface failure changed its input state or diagnostic input")
	end
end

test pending_header_block_completes_immediate_headers() -> Result<(), String>
	let transition: HeaderBlockTransition = http2::core::start_header_block(1, 1, 17, 5, true, 0, byte_chunk_from_hex("aabbcc")?, true)
	if http2::core::header_block_is_complete(transition) and not http2::core::pending_header_block_is_active(http2::core::header_block_state(transition)) and http2::core::completed_header_block_end_stream(transition) and http2::core::completed_header_block_is_trailer(transition) and http2::core::completed_header_block_promised_stream_id(transition) == 0 and chunks_equal(http2::core::completed_header_block(transition), byte_chunk_from_hex("aabbcc")?)?
		Ok(())
	else
		Err("immediate HEADERS completion lost its initiating metadata or octets")
	end
end

test pending_header_block_completes_multi_frame_headers_in_wire_order() -> Result<(), String>
	let started: HeaderBlockTransition = http2::core::start_header_block(1, 1, 17, 1, true, 0, byte_chunk_from_hex("aabbcc")?, false)
	let more: HeaderBlockTransition = require_transition(http2::core::continue_header_block(http2::core::header_block_state(started), 29, 9, 0, 1, byte_chunk_from_hex("ddee")?, byte_chunk_from_hex("000002090000000001")?))?
	let done: HeaderBlockTransition = require_transition(http2::core::continue_header_block(http2::core::header_block_state(more), 40, 9, 4, 1, byte_chunk_from_hex("ff010203")?, byte_chunk_from_hex("000004090400000001")?))?
	if not http2::core::header_block_is_complete(more) and http2::core::pending_header_block_is_active(http2::core::header_block_state(more)) and http2::core::header_block_is_complete(done) and http2::core::completed_header_block_end_stream(done) and http2::core::completed_header_block_is_trailer(done) and chunks_equal(http2::core::completed_header_block(done), byte_chunk_from_hex("aabbccddeeff010203")?)?
		Ok(())
	else
		Err("multi-frame HEADERS completion did not preserve wire order and initiating flags")
	end
end

test pending_header_block_completes_multi_frame_push_promise() -> Result<(), String>
	let started: HeaderBlockTransition = http2::core::start_header_block(1, 5, 23, 0, false, 2, byte_chunk_from_hex("8287")?, false)
	let done: HeaderBlockTransition = require_transition(http2::core::continue_header_block(http2::core::header_block_state(started), 34, 9, 4, 1, byte_chunk_from_hex("84")?, byte_chunk_from_hex("000001090400000001")?))?
	if http2::core::header_block_is_complete(done) and not http2::core::completed_header_block_end_stream(done) and not http2::core::completed_header_block_is_trailer(done) and http2::core::completed_header_block_promised_stream_id(done) == 2 and chunks_equal(http2::core::completed_header_block(done), byte_chunk_from_hex("828784")?)?
		Ok(())
	else
		Err("PUSH_PROMISE continuation lost its promised stream or header octets")
	end
end

test pending_header_block_preserves_non_final_accumulation_and_metadata() -> Result<(), String>
	let initial: PendingHeaderBlock = active_headers(byte_chunk_from_hex("aabb")?)
	let more: HeaderBlockTransition = require_transition(http2::core::continue_header_block(initial, 29, 9, 0, 1, byte_chunk_from_hex("ccdd")?, byte_chunk_from_hex("000002090000000001")?))?
	let state: PendingHeaderBlock = http2::core::header_block_state(more)
	if not http2::core::header_block_is_complete(more) and http2::core::pending_header_block_is_active(state) and http2::core::pending_header_block_expected_stream(state) == 1 and http2::core::pending_header_block_started_kind(state) == 1 and http2::core::pending_header_block_started_offset(state) == 17 and http2::core::pending_header_block_started_flags(state) == 1 and http2::core::pending_header_block_is_trailer(state) and http2::core::pending_header_block_promised_stream_id(state) == 0 and chunks_equal(http2::core::pending_header_block_bytes(state), byte_chunk_from_hex("aabbccdd")?)? and byte_count_to_int(byte_chunk_count(http2::core::completed_header_block(more))) == 0
		Ok(())
	else
		Err("non-final CONTINUATION did not preserve pending state and hide completion")
	end
end

test pending_header_block_rejects_wrong_kind_and_stream_without_next_output() -> Result<(), String>
	let state: PendingHeaderBlock = active_headers(byte_chunk_from_hex("aabbcc")?)
	let wrong_kind: Bool = match http2::core::continue_header_block(state, 29, 0, 0, 1, byte_chunk([]), byte_chunk_from_hex("000000000000000001")?)
		Ok(_) => false
		Err(failure) => http2::core::header_block_failure_kind(failure) == "continuation_kind" and http2::core::header_block_failure_offset(failure) == 29 and http2::core::header_block_failure_actual_kind(failure) == 0 and http2::core::header_block_failure_actual_stream(failure) == 1 and http2::core::header_block_failure_expected_stream(failure) == 1 and http2::core::header_block_failure_started_kind(failure) == 1 and http2::core::header_block_failure_started_offset(failure) == 17 and http2::core::header_block_failure_accumulated_count(failure) == 3 and http2::core::header_block_failure_rule_provenance(failure) == "rfc9113_continuation_sequence"
	end
	let wrong_stream: Bool = match http2::core::continue_header_block(state, 29, 9, 4, 3, byte_chunk_from_hex("dd")?, byte_chunk_from_hex("000001090400000003")?)
		Ok(_) => false
		Err(failure) => http2::core::header_block_failure_kind(failure) == "continuation_stream" and http2::core::header_block_failure_actual_stream(failure) == 3 and http2::core::header_block_failure_expected_stream(failure) == 1 and http2::core::header_block_failure_accumulated_count(failure) == 3
	end
	if wrong_kind and wrong_stream and chunks_equal(http2::core::pending_header_block_bytes(state), byte_chunk_from_hex("aabbcc")?)?
		Ok(())
	else
		Err("CONTINUATION failure exposed output or changed the input state")
	end
end

test pending_header_block_rejects_closed_input_without_changing_state() -> Result<(), String>
	let state: PendingHeaderBlock = active_headers(byte_chunk_from_hex("aabbcc")?)
	let rejected: Bool = match http2::core::close_pending_header_block(state, 29, 0, byte_chunk([]))
		Ok(_) => false
		Err(failure) => http2::core::header_block_failure_kind(failure) == "closed_pending" and http2::core::header_block_failure_offset(failure) == 29 and http2::core::header_block_failure_pending_count(failure) == 0 and http2::core::header_block_failure_expected_stream(failure) == 1 and http2::core::header_block_failure_started_kind(failure) == 1 and http2::core::header_block_failure_started_offset(failure) == 17 and http2::core::header_block_failure_accumulated_count(failure) == 3
	end
	if rejected and http2::core::pending_header_block_is_active(state) and chunks_equal(http2::core::pending_header_block_bytes(state), byte_chunk_from_hex("aabbcc")?)?
		Ok(())
	else
		Err("closed-input failure changed or discarded the pending header block")
	end
end

test pending_header_block_accepts_closed_input_while_idle() -> Result<(), String>
	let state: PendingHeaderBlock = http2::core::empty_pending_header_block()
	match http2::core::close_pending_header_block(state, 29, 0, byte_chunk([]))
		Ok(closed) => if not http2::core::pending_header_block_is_active(closed) and byte_count_to_int(byte_chunk_count(http2::core::pending_header_block_bytes(closed))) == 0
			Ok(())
		else
			Err("closing idle input created pending header-block state")
		end
		Err(_) => Err("closing idle input unexpectedly failed")
	end
end

test pending_header_block_failures_preserve_diagnostic_input() -> Result<(), String>
	let state: PendingHeaderBlock = active_headers(byte_chunk_from_hex("aabbcc")?)
	let frame_preview: ByteChunk = byte_chunk_from_hex("000001090400000003dd")?
	let wrong_stream: Bool = match http2::core::continue_header_block(state, 29, 9, 4, 3, byte_chunk_from_hex("dd")?, frame_preview)
		Ok(_) => false
		Err(failure) => chunks_equal(http2::core::header_block_failure_preview(failure), frame_preview)?
	end
	let pending_preview: ByteChunk = byte_chunk_from_hex("010203")?
	let closed: Bool = match http2::core::close_pending_header_block(state, 40, 7, pending_preview)
		Ok(_) => false
		Err(failure) => http2::core::header_block_failure_pending_count(failure) == 7 and chunks_equal(http2::core::header_block_failure_preview(failure), pending_preview)?
	end
	if wrong_stream and closed and chunks_equal(http2::core::pending_header_block_bytes(state), byte_chunk_from_hex("aabbcc")?)?
		Ok(())
	else
		Err("CONTINUATION failure did not preserve diagnostic input or pending state")
	end
end
