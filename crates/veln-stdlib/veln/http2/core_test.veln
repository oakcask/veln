	if local_setting_rejects(http2::core::local_settings_header_table_size(-1), 1, "SETTINGS_HEADER_TABLE_SIZE", -1, 0, 4294967295)? and local_setting_rejects(http2::core::local_settings_header_table_size(4294967296), 1, "SETTINGS_HEADER_TABLE_SIZE", 4294967296, 0, 4294967295)? and local_setting_rejects(http2::core::local_settings_enable_push(-1), 2, "SETTINGS_ENABLE_PUSH", -1, 0, 1)? and local_setting_rejects(http2::core::local_settings_enable_push(2), 2, "SETTINGS_ENABLE_PUSH", 2, 0, 1)? and local_setting_rejects(http2::core::local_settings_max_concurrent_streams(-1), 3, "SETTINGS_MAX_CONCURRENT_STREAMS", -1, 0, 4294967295)? and local_setting_rejects(http2::core::local_settings_max_concurrent_streams(4294967296), 3, "SETTINGS_MAX_CONCURRENT_STREAMS", 4294967296, 0, 4294967295)? and local_setting_rejects(http2::core::local_settings_initial_window_size(-1), 4, "SETTINGS_INITIAL_WINDOW_SIZE", -1, 0, 2147483647)? and local_setting_rejects(http2::core::local_settings_initial_window_size(2147483648), 4, "SETTINGS_INITIAL_WINDOW_SIZE", 2147483648, 0, 2147483647)? and local_setting_rejects(http2::core::local_settings_max_frame_size(16383), 5, "SETTINGS_MAX_FRAME_SIZE", 16383, 16384, 16777215)? and local_setting_rejects(http2::core::local_settings_max_frame_size(16777216), 5, "SETTINGS_MAX_FRAME_SIZE", 16777216, 16384, 16777215)? and local_setting_rejects(http2::core::local_settings_max_header_list_size(-1), 6, "SETTINGS_MAX_HEADER_LIST_SIZE", -1, 0, 4294967295)? and local_setting_rejects(http2::core::local_settings_max_header_list_size(4294967296), 6, "SETTINGS_MAX_HEADER_LIST_SIZE", 4294967296, 0, 4294967295)? and local_setting_rejects(http2::core::local_settings_enable_connect_protocol(-1), 8, "SETTINGS_ENABLE_CONNECT_PROTOCOL", -1, 0, 1)? and local_setting_rejects(http2::core::local_settings_enable_connect_protocol(2), 8, "SETTINGS_ENABLE_CONNECT_PROTOCOL", 2, 0, 1)?
		Ok(())
	else
