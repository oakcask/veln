		Ok(transition) => transition
		Err(_) => Err("server initial peer SETTINGS transition failed")?
	end
	let client: InitialPeerSettingsTransition = match http2::core::accept_initial_peer_settings(http2::core::client_initial_peer_settings_gate(), 0, 4, 2, 0, byte_chunk([]))
		Ok(transition) => transition
		Err(_) => Err("client initial peer SETTINGS transition failed")?
	end
	let server_state: InitialPeerSettingsAcceptedState = http2::core::initial_peer_settings_state(server)
	let client_state: InitialPeerSettingsAcceptedState = http2::core::initial_peer_settings_state(client)
	if http2::core::accepted_initial_peer_settings_endpoint_role(server_state) == "server" and http2::core::accepted_initial_peer_settings_endpoint_role(client_state) == "client"
