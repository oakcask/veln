	let preview: ByteView = byte_view(preview_chunk, byte_offset(0)?, byte_count(9)?)?
	match http2::core::accept_settings_ack(state, 41, preview)
		Ok(_) => Err("unexpected SETTINGS ACK exposed a next state")
