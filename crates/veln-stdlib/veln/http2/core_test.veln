test connection_preface_failures_preserve_immutable_input_state() -> Result<(), String>
	let prefix: ByteChunk = byte_chunk_from_hex("505249202a20")?
	let transition: ConnectionPrefaceTransition = require_preface_transition(http2::core::accept_connection_preface(http2::core::empty_connection_preface(7), prefix))?
	let state: ConnectionPrefaceState = http2::core::connection_preface_state(transition)
	let mismatch_preview: ByteChunk = byte_chunk_from_hex("505249202a2000")?
	let mismatch: Bool = match http2::core::accept_connection_preface(state, byte_chunk_from_hex("00")?)
		Ok(_) => false
		Err(failure) => chunks_equal(http2::core::connection_preface_failure_preview(failure), mismatch_preview)?
	end
	let closed: Bool = match http2::core::close_connection_preface(state)
		Ok(_) => false
		Err(failure) => chunks_equal(http2::core::connection_preface_failure_preview(failure), prefix)?
	end
	if mismatch and closed and http2::core::connection_preface_starting_offset(state) == 7 and http2::core::connection_preface_matched_count(state) == 6 and chunks_equal(http2::core::connection_preface_matched_prefix(state), prefix)?
		Ok(())
	else
		Err("connection-preface failure changed its input state or diagnostic input")
	end
end

test pending_header_block_completes_immediate_headers() -> Result<(), String>
	let transition: HeaderBlockTransition = http2::core::start_header_block(1, 1, 17, 5, true, 0, byte_chunk_from_hex("aabbcc")?, true)
	if http2::core::header_block_is_complete(transition) and not http2::core::pending_header_block_is_active(http2::core::header_block_state(transition)) and http2::core::completed_header_block_end_stream(transition) and http2::core::completed_header_block_is_trailer(transition) and http2::core::completed_header_block_promised_stream_id(transition) == 0 and chunks_equal(http2::core::completed_header_block(transition), byte_chunk_from_hex("aabbcc")?)?
		Ok(())
	else
