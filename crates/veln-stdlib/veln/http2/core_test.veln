end

test pending_header_block_completes_multi_frame_headers_in_wire_order() -> Result<(), String>
	let started: HeaderBlockTransition = http2::core::start_header_block(1, 1, 17, 1, true, 0, byte_chunk_from_hex("aabbcc")?, false)
	let more: HeaderBlockTransition = require_transition(http2::core::continue_header_block(http2::core::header_block_state(started), 29, 9, 0, 1, byte_chunk_from_hex("ddee")?, byte_chunk_from_hex("000002090000000001")?))?
	let done: HeaderBlockTransition = require_transition(http2::core::continue_header_block(http2::core::header_block_state(more), 40, 9, 4, 1, byte_chunk_from_hex("ff010203")?, byte_chunk_from_hex("000004090400000001")?))?
	if not http2::core::header_block_is_complete(more) and http2::core::pending_header_block_is_active(http2::core::header_block_state(more)) and http2::core::header_block_is_complete(done) and http2::core::completed_header_block_end_stream(done) and http2::core::completed_header_block_is_trailer(done) and chunks_equal(http2::core::completed_header_block(done), byte_chunk_from_hex("aabbccddeeff010203")?)?
		Ok(())
	else
		Err("multi-frame HEADERS completion did not preserve wire order and initiating flags")
	end
end

test pending_header_block_completes_multi_frame_push_promise() -> Result<(), String>
	let started: HeaderBlockTransition = http2::core::start_header_block(1, 5, 23, 0, false, 2, byte_chunk_from_hex("8287")?, false)
	let done: HeaderBlockTransition = require_transition(http2::core::continue_header_block(http2::core::header_block_state(started), 34, 9, 4, 1, byte_chunk_from_hex("84")?, byte_chunk_from_hex("000001090400000001")?))?
	if http2::core::header_block_is_complete(done) and not http2::core::completed_header_block_end_stream(done) and not http2::core::completed_header_block_is_trailer(done) and http2::core::completed_header_block_promised_stream_id(done) == 2 and chunks_equal(http2::core::completed_header_block(done), byte_chunk_from_hex("828784")?)?
		Ok(())
	else
		Err("PUSH_PROMISE continuation lost its promised stream or header octets")
	end
end

test pending_header_block_preserves_non_final_accumulation_and_metadata() -> Result<(), String>
	let initial: PendingHeaderBlock = active_headers(byte_chunk_from_hex("aabb")?)
	let more: HeaderBlockTransition = require_transition(http2::core::continue_header_block(initial, 29, 9, 0, 1, byte_chunk_from_hex("ccdd")?, byte_chunk_from_hex("000002090000000001")?))?
	let state: PendingHeaderBlock = http2::core::header_block_state(more)
	if not http2::core::header_block_is_complete(more) and http2::core::pending_header_block_is_active(state) and http2::core::pending_header_block_expected_stream(state) == 1 and http2::core::pending_header_block_started_kind(state) == 1 and http2::core::pending_header_block_started_offset(state) == 17 and http2::core::pending_header_block_started_flags(state) == 1 and http2::core::pending_header_block_is_trailer(state) and http2::core::pending_header_block_promised_stream_id(state) == 0 and chunks_equal(http2::core::pending_header_block_bytes(state), byte_chunk_from_hex("aabbccdd")?)? and byte_count_to_int(byte_chunk_count(http2::core::completed_header_block(more))) == 0
		Ok(())
	else
		Err("non-final CONTINUATION did not preserve pending state and hide completion")
	end
end

test pending_header_block_rejects_wrong_kind_and_stream_without_next_output() -> Result<(), String>
	let state: PendingHeaderBlock = active_headers(byte_chunk_from_hex("aabbcc")?)
	let wrong_kind: Bool = match http2::core::continue_header_block(state, 29, 0, 0, 1, byte_chunk([]), byte_chunk_from_hex("000000000000000001")?)
		Ok(_) => false
		Err(failure) => http2::core::header_block_failure_kind(failure) == "continuation_kind" and http2::core::header_block_failure_offset(failure) == 29 and http2::core::header_block_failure_actual_kind(failure) == 0 and http2::core::header_block_failure_actual_stream(failure) == 1 and http2::core::header_block_failure_expected_stream(failure) == 1 and http2::core::header_block_failure_started_kind(failure) == 1 and http2::core::header_block_failure_started_offset(failure) == 17 and http2::core::header_block_failure_accumulated_count(failure) == 3 and http2::core::header_block_failure_rule_provenance(failure) == "rfc9113_continuation_sequence"
	end
	let wrong_stream: Bool = match http2::core::continue_header_block(state, 29, 9, 4, 3, byte_chunk_from_hex("dd")?, byte_chunk_from_hex("000001090400000003")?)
		Ok(_) => false
		Err(failure) => http2::core::header_block_failure_kind(failure) == "continuation_stream" and http2::core::header_block_failure_actual_stream(failure) == 3 and http2::core::header_block_failure_expected_stream(failure) == 1 and http2::core::header_block_failure_accumulated_count(failure) == 3
	end
	if wrong_kind and wrong_stream and chunks_equal(http2::core::pending_header_block_bytes(state), byte_chunk_from_hex("aabbcc")?)?
		Ok(())
	else
		Err("CONTINUATION failure exposed output or changed the input state")
	end
end

test pending_header_block_rejects_closed_input_without_changing_state() -> Result<(), String>
	let state: PendingHeaderBlock = active_headers(byte_chunk_from_hex("aabbcc")?)
	let rejected: Bool = match http2::core::close_pending_header_block(state, 29, 0, byte_chunk([]))
		Ok(_) => false
		Err(failure) => http2::core::header_block_failure_kind(failure) == "closed_pending" and http2::core::header_block_failure_offset(failure) == 29 and http2::core::header_block_failure_pending_count(failure) == 0 and http2::core::header_block_failure_expected_stream(failure) == 1 and http2::core::header_block_failure_started_kind(failure) == 1 and http2::core::header_block_failure_started_offset(failure) == 17 and http2::core::header_block_failure_accumulated_count(failure) == 3
	end
	if rejected and http2::core::pending_header_block_is_active(state) and chunks_equal(http2::core::pending_header_block_bytes(state), byte_chunk_from_hex("aabbcc")?)?
		Ok(())
	else
		Err("closed-input failure changed or discarded the pending header block")
	end
end

test pending_header_block_accepts_closed_input_while_idle() -> Result<(), String>
	let state: PendingHeaderBlock = http2::core::empty_pending_header_block()
	match http2::core::close_pending_header_block(state, 29, 0, byte_chunk([]))
		Ok(closed) => if not http2::core::pending_header_block_is_active(closed) and byte_count_to_int(byte_chunk_count(http2::core::pending_header_block_bytes(closed))) == 0
			Ok(())
		else
			Err("closing idle input created pending header-block state")
		end
		Err(_) => Err("closing idle input unexpectedly failed")
	end
end

test pending_header_block_failures_preserve_diagnostic_input() -> Result<(), String>
	let state: PendingHeaderBlock = active_headers(byte_chunk_from_hex("aabbcc")?)
	let frame_preview: ByteChunk = byte_chunk_from_hex("000001090400000003dd")?
	let wrong_stream: Bool = match http2::core::continue_header_block(state, 29, 9, 4, 3, byte_chunk_from_hex("dd")?, frame_preview)
		Ok(_) => false
		Err(failure) => chunks_equal(http2::core::header_block_failure_preview(failure), frame_preview)?
	end
	let pending_preview: ByteChunk = byte_chunk_from_hex("010203")?
	let closed: Bool = match http2::core::close_pending_header_block(state, 40, 7, pending_preview)
		Ok(_) => false
		Err(failure) => http2::core::header_block_failure_pending_count(failure) == 7 and chunks_equal(http2::core::header_block_failure_preview(failure), pending_preview)?
	end
	if wrong_stream and closed and chunks_equal(http2::core::pending_header_block_bytes(state), byte_chunk_from_hex("aabbcc")?)?
		Ok(())
	else
		Err("CONTINUATION failure did not preserve diagnostic input or pending state")
	end
end

test settings_ack_state_starts_empty() -> Result<(), String>
	let state: SettingsAckState = http2::core::empty_settings_ack_state()
	if http2::core::outstanding_settings_label(http2::core::settings_ack_outstanding(state)) == "none" and http2::core::outstanding_settings_identifier(http2::core::settings_ack_outstanding(state)) == 0 and http2::core::outstanding_settings_count(http2::core::settings_ack_outstanding(state)) == 0 and http2::core::outstanding_settings_batch_count(http2::core::settings_ack_outstanding(state)) == 0 and http2::core::pending_settings_ack_label(http2::core::settings_ack_pending_peer_ack(state)) == "none"
		Ok(())
	else
		Err("SETTINGS ACK state did not start empty")
	end
end

test settings_ack_accepts_local_batches_fifo() -> Result<(), String>
	let initial: SettingsAckState = http2::core::empty_settings_ack_state()
	let first: SettingsAckState = http2::core::record_local_settings_batch(initial, 5, 1)
	let second: SettingsAckState = http2::core::record_local_settings_batch(first, 4, 2)
	let preview: ByteView = byte_view(byte_chunk_from_hex("000000040100000000")?, byte_offset(0)?, byte_count(9)?)?
	let acknowledged_first: SettingsAckState = match http2::core::accept_settings_ack(second, 17, preview)
		Ok(state) => state
		Err(_) => Err("first SETTINGS ACK was rejected")?
	end
	let acknowledged_second: SettingsAckState = match http2::core::accept_settings_ack(acknowledged_first, 26, preview)
		Ok(state) => state
		Err(_) => Err("second SETTINGS ACK was rejected")?
	end
	if http2::core::outstanding_settings_identifier(http2::core::settings_ack_outstanding(second)) == 5 and http2::core::outstanding_settings_count(http2::core::settings_ack_outstanding(second)) == 1 and http2::core::outstanding_settings_batch_count(http2::core::settings_ack_outstanding(second)) == 2 and http2::core::outstanding_settings_identifier(http2::core::settings_ack_outstanding(acknowledged_first)) == 4 and http2::core::outstanding_settings_count(http2::core::settings_ack_outstanding(acknowledged_first)) == 2 and http2::core::outstanding_settings_batch_count(http2::core::settings_ack_outstanding(acknowledged_first)) == 1 and http2::core::outstanding_settings_label(http2::core::settings_ack_outstanding(acknowledged_second)) == "none"
		Ok(())
	else
		Err("SETTINGS ACK did not remove outstanding local batches in FIFO order")
	end
end

test settings_ack_unexpected_failure_preserves_context() -> Result<(), String>
	let state: SettingsAckState = http2::core::empty_settings_ack_state()
	let preview_chunk: ByteChunk = byte_chunk_from_hex("000000040100000000")?
	let preview: ByteView = byte_view(preview_chunk, byte_offset(0)?, byte_count(9)?)?
	match http2::core::accept_settings_ack(state, 41, preview)
		Ok(_) => Err("unexpected SETTINGS ACK exposed a next state")
		Err(failure) => if http2::core::settings_ack_failure_id(failure) == "http2.protocol.unexpected_settings_ack" and http2::core::settings_ack_failure_offset(failure) == 41 and http2::core::settings_ack_failure_active_state(failure) == "connection-control" and http2::core::settings_ack_failure_rule_provenance(failure) == "rfc9113_settings_ack_requires_outstanding_local_settings" and chunks_equal(byte_view_to_chunk(http2::core::settings_ack_failure_preview(failure)), preview_chunk)? and http2::core::outstanding_settings_label(http2::core::settings_ack_outstanding(state)) == "none" and http2::core::pending_settings_ack_label(http2::core::settings_ack_pending_peer_ack(state)) == "none" and chunks_equal(preview_chunk, byte_chunk_from_hex("000000040100000000")?)?
			Ok(())
		else
			Err("unexpected SETTINGS ACK failure lost diagnostic context or changed input")
		end
	end
end

test settings_ack_keeps_local_and_peer_ack_state_independent() -> Result<(), String>
	let with_local: SettingsAckState = http2::core::record_local_settings_batch(http2::core::empty_settings_ack_state(), 5, 1)
	let with_both: SettingsAckState = http2::core::settings_ack_after_peer_frame(with_local, 4, 0, 6)
	let preview: ByteView = byte_view(byte_chunk_from_hex("000000040100000000")?, byte_offset(0)?, byte_count(9)?)?
	let after_local_ack: SettingsAckState = match http2::core::accept_settings_ack(with_both, 17, preview)
		Ok(state) => state
		Err(_) => Err("SETTINGS ACK unexpectedly failed")?
	end
	let sent: PeerSettingsAckSendDecision = http2::core::send_pending_settings_ack(after_local_ack)
	let after_peer_ack: SettingsAckState = http2::core::pending_settings_ack_send_state(sent)
	if http2::core::outstanding_settings_label(http2::core::settings_ack_outstanding(with_both)) == "active" and http2::core::pending_settings_ack_label(http2::core::settings_ack_pending_peer_ack(with_both)) == "active" and http2::core::outstanding_settings_label(http2::core::settings_ack_outstanding(after_local_ack)) == "none" and http2::core::pending_settings_ack_label(http2::core::settings_ack_pending_peer_ack(after_local_ack)) == "active" and http2::core::outstanding_settings_label(http2::core::settings_ack_outstanding(after_peer_ack)) == "none" and http2::core::pending_settings_ack_label(http2::core::settings_ack_pending_peer_ack(after_peer_ack)) == "none"
		Ok(())
	else
		Err("SETTINGS ACK state did not keep local and peer ACK directions independent")
	end
end

test settings_ack_peer_ack_coalesces_and_no_pending_preserves_state() -> Result<(), String>
	let initial: SettingsAckState = http2::core::empty_settings_ack_state()
	let no_pending: PeerSettingsAckSendDecision = http2::core::send_pending_settings_ack(initial)
	let first: SettingsAckState = http2::core::settings_ack_after_peer_frame(initial, 4, 0, 6)
	let second: SettingsAckState = http2::core::settings_ack_after_peer_frame(first, 4, 0, 12)
	let ignored_ack_frame: SettingsAckState = http2::core::settings_ack_after_peer_frame(second, 4, 1, 0)
	if http2::core::pending_settings_ack_send_status(no_pending) == "no_pending" and byte_count_to_int(byte_chunk_count(http2::core::pending_settings_ack_send_bytes(no_pending))) == 0 and http2::core::pending_settings_ack_label(http2::core::settings_ack_pending_peer_ack(http2::core::pending_settings_ack_send_state(no_pending))) == "none" and http2::core::pending_settings_ack_label(http2::core::settings_ack_pending_peer_ack(first)) == "active" and http2::core::pending_settings_ack_label(http2::core::settings_ack_pending_peer_ack(second)) == "active" and http2::core::pending_settings_ack_label(http2::core::settings_ack_pending_peer_ack(ignored_ack_frame)) == "active"
		Ok(())
	else
		Err("peer SETTINGS ACK state did not coalesce or preserve no-pending input")
	end
end

test settings_ack_peer_ack_send_emits_exact_bytes_and_clears_only_pending() -> Result<(), String>
	let outstanding: SettingsAckState = http2::core::record_local_settings_batch(http2::core::empty_settings_ack_state(), 3, 1)
	let pending: SettingsAckState = http2::core::settings_ack_after_peer_frame(outstanding, 4, 0, 6)
	let decision: PeerSettingsAckSendDecision = http2::core::send_pending_settings_ack(pending)
	let next: SettingsAckState = http2::core::pending_settings_ack_send_state(decision)
	if http2::core::pending_settings_ack_send_status(decision) == "accepted" and chunks_equal(http2::core::pending_settings_ack_send_bytes(decision), byte_chunk_from_hex("000000040100000000")?)? and http2::core::outstanding_settings_identifier(http2::core::settings_ack_outstanding(next)) == 3 and http2::core::outstanding_settings_batch_count(http2::core::settings_ack_outstanding(next)) == 1 and http2::core::pending_settings_ack_label(http2::core::settings_ack_pending_peer_ack(next)) == "none" and http2::core::pending_settings_ack_label(http2::core::settings_ack_pending_peer_ack(pending)) == "active"
		Ok(())
	else
		Err("peer SETTINGS ACK send did not emit exact bytes or preserve local state")
	end
end

test settings_ack_peer_ack_encode_failure_preserves_state_reason_and_output() -> Result<(), String>
	let outstanding: SettingsAckState = http2::core::record_local_settings_batch(http2::core::empty_settings_ack_state(), 3, 1)
	let pending: SettingsAckState = http2::core::settings_ack_after_peer_frame(outstanding, 4, 0, 6)
	let decision: PeerSettingsAckSendDecision = http2::core::settings_ack::send_pending_peer_ack_with_encoder(pending, fail_settings_ack_header)
	let next: SettingsAckState = http2::core::pending_settings_ack_send_state(decision)
	if http2::core::pending_settings_ack_send_status(decision) == "encode_error" and byte_count_to_int(byte_chunk_count(http2::core::pending_settings_ack_send_bytes(decision))) == 0 and http2::core::pending_settings_ack_encode_reason(decision) == "injected SETTINGS ACK header failure" and http2::core::outstanding_settings_identifier(http2::core::settings_ack_outstanding(next)) == 3 and http2::core::outstanding_settings_batch_count(http2::core::settings_ack_outstanding(next)) == 1 and http2::core::pending_settings_ack_label(http2::core::settings_ack_pending_peer_ack(next)) == "active" and http2::core::outstanding_settings_identifier(http2::core::settings_ack_outstanding(pending)) == 3 and http2::core::pending_settings_ack_label(http2::core::settings_ack_pending_peer_ack(pending)) == "active"
		Ok(())
	else
		Err("peer SETTINGS ACK encode failure changed state, reason, or output")
	end
end

test local_settings_send_accepts_every_supported_setting_boundary() -> Result<(), String>
	if local_setting_accepts(http2::core::local_settings_header_table_size(0), 1, "000006040000000000000100000000")? and local_setting_accepts(http2::core::local_settings_header_table_size(4294967295), 1, "0000060400000000000001ffffffff")? and local_setting_accepts(http2::core::local_settings_enable_push(0), 2, "000006040000000000000200000000")? and local_setting_accepts(http2::core::local_settings_enable_push(1), 2, "000006040000000000000200000001")? and local_setting_accepts(http2::core::local_settings_max_concurrent_streams(0), 3, "000006040000000000000300000000")? and local_setting_accepts(http2::core::local_settings_max_concurrent_streams(4294967295), 3, "0000060400000000000003ffffffff")? and local_setting_accepts(http2::core::local_settings_initial_window_size(0), 4, "000006040000000000000400000000")? and local_setting_accepts(http2::core::local_settings_initial_window_size(2147483647), 4, "00000604000000000000047fffffff")? and local_setting_accepts(http2::core::local_settings_max_frame_size(16384), 5, "000006040000000000000500004000")? and local_setting_accepts(http2::core::local_settings_max_frame_size(16777215), 5, "000006040000000000000500ffffff")? and local_setting_accepts(http2::core::local_settings_max_header_list_size(0), 6, "000006040000000000000600000000")? and local_setting_accepts(http2::core::local_settings_max_header_list_size(4294967295), 6, "0000060400000000000006ffffffff")? and local_setting_accepts(http2::core::local_settings_enable_connect_protocol(0), 8, "000006040000000000000800000000")? and local_setting_accepts(http2::core::local_settings_enable_connect_protocol(1), 8, "000006040000000000000800000001")?
		Ok(())
	else
		Err("local SETTINGS send did not accept every supported setting boundary")
	end
end

