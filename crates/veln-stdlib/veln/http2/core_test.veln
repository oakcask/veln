	if http2::core::stream_frame_admission_status(settings) == "accepted" and http2::core::stream_frame_admission_status(ping) == "accepted" and http2::core::stream_frame_admission_status(goaway) == "accepted" and http2::core::stream_frame_admission_status(connection_window) == "accepted" and http2::core::stream_frame_admission_status(unknown_connection) == "accepted" and http2::core::stream_frame_admission_status(unknown_stream) == "accepted"
