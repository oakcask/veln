end

test local_settings_send_rejects_every_supported_setting_outside_range() -> Result<(), String>
	if local_setting_rejects(http2::core::local_settings_header_table_size(-1), 1, "SETTINGS_HEADER_TABLE_SIZE", -1, 0, 4294967295)? and local_setting_rejects(http2::core::local_settings_header_table_size(4294967296), 1, "SETTINGS_HEADER_TABLE_SIZE", 4294967296, 0, 4294967295)? and local_setting_rejects(http2::core::local_settings_enable_push(-1), 2, "SETTINGS_ENABLE_PUSH", -1, 0, 1)? and local_setting_rejects(http2::core::local_settings_enable_push(2), 2, "SETTINGS_ENABLE_PUSH", 2, 0, 1)? and local_setting_rejects(http2::core::local_settings_max_concurrent_streams(-1), 3, "SETTINGS_MAX_CONCURRENT_STREAMS", -1, 0, 4294967295)? and local_setting_rejects(http2::core::local_settings_max_concurrent_streams(4294967296), 3, "SETTINGS_MAX_CONCURRENT_STREAMS", 4294967296, 0, 4294967295)? and local_setting_rejects(http2::core::local_settings_initial_window_size(-1), 4, "SETTINGS_INITIAL_WINDOW_SIZE", -1, 0, 2147483647)? and local_setting_rejects(http2::core::local_settings_initial_window_size(2147483648), 4, "SETTINGS_INITIAL_WINDOW_SIZE", 2147483648, 0, 2147483647)? and local_setting_rejects(http2::core::local_settings_max_frame_size(16383), 5, "SETTINGS_MAX_FRAME_SIZE", 16383, 16384, 16777215)? and local_setting_rejects(http2::core::local_settings_max_frame_size(16777216), 5, "SETTINGS_MAX_FRAME_SIZE", 16777216, 16384, 16777215)? and local_setting_rejects(http2::core::local_settings_max_header_list_size(-1), 6, "SETTINGS_MAX_HEADER_LIST_SIZE", -1, 0, 4294967295)? and local_setting_rejects(http2::core::local_settings_max_header_list_size(4294967296), 6, "SETTINGS_MAX_HEADER_LIST_SIZE", 4294967296, 0, 4294967295)? and local_setting_rejects(http2::core::local_settings_enable_connect_protocol(-1), 8, "SETTINGS_ENABLE_CONNECT_PROTOCOL", -1, 0, 1)? and local_setting_rejects(http2::core::local_settings_enable_connect_protocol(2), 8, "SETTINGS_ENABLE_CONNECT_PROTOCOL", 2, 0, 1)?
		Ok(())
	else
		Err("local SETTINGS send accepted an out-of-range supported setting")
	end
end

test local_settings_send_preserves_order_policy_offsets_and_ack_fifo() -> Result<(), String>
	let items: List<LocalSettingsItem> = Cons(http2::core::local_settings_header_table_size(4096), Cons(http2::core::local_settings_enable_push(0), Cons(http2::core::local_settings_max_concurrent_streams(100), Cons(http2::core::local_settings_initial_window_size(65535), Cons(http2::core::local_settings_max_frame_size(32768), Cons(http2::core::local_settings_max_header_list_size(8192), Cons(http2::core::local_settings_enable_connect_protocol(1), Nil)))))))
	let first: LocalSettingsSendDecision = require_local_settings_sent(http2::core::send_local_settings_batch(items, "server", http2::core::empty_local_settings_policy(), http2::core::empty_settings_ack_state())?)?
	let second: LocalSettingsSendDecision = require_local_settings_sent(http2::core::send_local_setting(http2::core::local_settings_enable_push(1), "server", http2::core::local_settings_send_policy(first), http2::core::local_settings_send_ack_state(first))?)?
	let ack_preview: ByteView = byte_view(byte_chunk_from_hex("000000040100000000")?, byte_offset(0)?, byte_count(9)?)?
	let acknowledged_first: SettingsAckState = match http2::core::accept_settings_ack(http2::core::local_settings_send_ack_state(second), 17, ack_preview)
		Ok(state) => state
		Err(_) => Err("first local SETTINGS batch ACK failed")?
	end
	if chunks_equal(http2::core::local_settings_send_bytes(first), byte_chunk_from_hex("00002a04000000000000010000100000020000000000030000006400040000ffff000500008000000600002000000800000001")?)? and http2::core::local_settings_policy_enable_push_value(http2::core::local_settings_send_policy(first)) == 0 and http2::core::local_settings_policy_enable_push_offset(http2::core::local_settings_send_policy(first)) == 6 and http2::core::local_settings_policy_enable_connect_protocol_value(http2::core::local_settings_send_policy(first)) == 1 and http2::core::local_settings_policy_enable_connect_protocol_offset(http2::core::local_settings_send_policy(first)) == 36 and http2::core::outstanding_settings_identifier(http2::core::settings_ack_outstanding(http2::core::local_settings_send_ack_state(second))) == 1 and http2::core::outstanding_settings_count(http2::core::settings_ack_outstanding(http2::core::local_settings_send_ack_state(second))) == 7 and http2::core::outstanding_settings_batch_count(http2::core::settings_ack_outstanding(http2::core::local_settings_send_ack_state(second))) == 2 and http2::core::outstanding_settings_identifier(http2::core::settings_ack_outstanding(acknowledged_first)) == 2 and http2::core::outstanding_settings_count(http2::core::settings_ack_outstanding(acknowledged_first)) == 1
		Ok(())
	else
		Err("ordered local SETTINGS send lost bytes, policy offsets, or FIFO ACK state")
	end
end

test local_settings_send_empty_batch_emits_frame_and_records_ack() -> Result<(), String>
	let initial_policy: LocalSettingsPolicy = http2::core::local_settings_policy_with_enable_push(http2::core::empty_local_settings_policy(), 0, 12)
	let decision: LocalSettingsSendDecision = require_local_settings_sent(http2::core::send_local_settings_batch(Nil, "server", initial_policy, http2::core::empty_settings_ack_state())?)?
	let ack_state: SettingsAckState = http2::core::local_settings_send_ack_state(decision)
	if http2::core::local_settings_send_identifier(decision) == 0 and http2::core::local_settings_send_value(decision) == 0 and chunks_equal(http2::core::local_settings_send_bytes(decision), byte_chunk_from_hex("000000040000000000")?)? and http2::core::outstanding_settings_identifier(http2::core::settings_ack_outstanding(ack_state)) == 0 and http2::core::outstanding_settings_count(http2::core::settings_ack_outstanding(ack_state)) == 0 and http2::core::outstanding_settings_batch_count(http2::core::settings_ack_outstanding(ack_state)) == 1 and http2::core::local_settings_policy_has_enable_push(http2::core::local_settings_send_policy(decision)) and http2::core::local_settings_policy_enable_push_value(http2::core::local_settings_send_policy(decision)) == 0 and http2::core::local_settings_policy_enable_push_offset(http2::core::local_settings_send_policy(decision)) == 12
		Ok(())
	else
		Err("empty local SETTINGS batch lost frame bytes, ACK tracking, or policy state")
	end
end

test local_settings_send_failure_preserves_policy_ack_state_and_output() -> Result<(), String>
	let initial_ack: SettingsAckState = http2::core::record_local_settings_batch(http2::core::empty_settings_ack_state(), 5, 1)
	let initial_policy: LocalSettingsPolicy = http2::core::local_settings_send_policy(require_local_settings_sent(http2::core::send_local_setting(http2::core::local_settings_enable_push(0), "server", http2::core::empty_local_settings_policy(), http2::core::empty_settings_ack_state())?)?)
	let items: List<LocalSettingsItem> = Cons(http2::core::local_settings_header_table_size(4096), Cons(http2::core::local_settings_enable_connect_protocol(2), Cons(http2::core::local_settings_enable_push(1), Nil)))
	let decision: LocalSettingsSendDecision = http2::core::send_local_settings_batch(items, "server", initial_policy, initial_ack)?
	match decision
		LocalSettingsRejected(failure) => if http2::core::local_settings_failure_offset(failure) == 6 and http2::core::local_settings_failure_setting_identifier(failure) == 8 and http2::core::local_settings_policy_enable_push_value(initial_policy) == 0 and http2::core::local_settings_policy_enable_push_offset(initial_policy) == 0 and http2::core::outstanding_settings_identifier(http2::core::settings_ack_outstanding(initial_ack)) == 5 and http2::core::outstanding_settings_batch_count(http2::core::settings_ack_outstanding(initial_ack)) == 1 and byte_count_to_int(byte_chunk_count(http2::core::local_settings_send_bytes(decision))) == 0
			Ok(())
		else
			Err("local SETTINGS range failure changed policy, ACK state, or output")
		end
		_ => Err("invalid local SETTINGS batch was accepted")
	end
end

test local_settings_send_rejects_client_enable_connect_protocol_without_output() -> Result<(), String>
	let decision: LocalSettingsSendDecision = http2::core::send_local_setting(http2::core::local_settings_enable_connect_protocol(1), "client", http2::core::empty_local_settings_policy(), http2::core::empty_settings_ack_state())?
	match decision
		LocalSettingsRejected(failure) => if http2::core::local_settings_failure_id(failure) == "http2.protocol.settings_not_allowed_for_endpoint" and http2::core::local_settings_failure_setting_identifier(failure) == 8 and http2::core::local_settings_failure_endpoint_role(failure) == "client" and http2::core::local_settings_failure_active_state(failure) == "local-settings" and http2::core::local_settings_failure_rule_provenance(failure) == "rfc8441_only_servers_send_settings_enable_connect_protocol" and byte_count_to_int(byte_chunk_count(http2::core::local_settings_send_bytes(decision))) == 0
			Ok(())
		else
			Err("client local SETTINGS_ENABLE_CONNECT_PROTOCOL rejection lost context")
		end
		_ => Err("client local SETTINGS_ENABLE_CONNECT_PROTOCOL was accepted")
	end
end

test peer_settings_validation_accepts_every_supported_setting_boundary() -> Result<(), String>
	if peer_settings_accepts("0001000000000001ffffffff0002000000000002000000010003000000000003ffffffff00040000000000047fffffff000500004000000500ffffff0006000000000006ffffffff", "server", 12)? and peer_settings_accepts("0001000000000001ffffffff0003000000000003ffffffff00040000000000047fffffff000500004000000500ffffff0006000000000006ffffffff000800000000000800000001", "client", 12)?
		Ok(())
	else
		Err("peer SETTINGS validation did not accept every supported setting boundary")
	end
end

test peer_settings_validation_rejects_supported_out_of_range_values() -> Result<(), String>
	if peer_settings_rejects("000200000002", "server", 9, 2, "SETTINGS_ENABLE_PUSH", 2, 0, 1, "000200000002")? and peer_settings_rejects("000480000000", "server", 9, 4, "SETTINGS_INITIAL_WINDOW_SIZE", 2147483648, 0, 2147483647, "000480000000")? and peer_settings_rejects("000500003fff", "server", 9, 5, "SETTINGS_MAX_FRAME_SIZE", 16383, 16384, 16777215, "000500003fff")? and peer_settings_rejects("000501000000", "server", 9, 5, "SETTINGS_MAX_FRAME_SIZE", 16777216, 16384, 16777215, "000501000000")? and peer_settings_rejects("000800000002", "client", 9, 8, "SETTINGS_ENABLE_CONNECT_PROTOCOL", 2, 0, 1, "000800000002")?
		Ok(())
	else
		Err("peer SETTINGS validation accepted an out-of-range supported setting")
	end
end

test peer_settings_validation_ignores_unknown_items_and_preserves_wire_order() -> Result<(), String>
	let accepted: Bool = peer_settings_accepts("aaaa12345678000500004000bbbb00000000000200000001", "server", 4)?
	let invalid_after_unknown: Bool = peer_settings_rejects("aaaa12345678000500003fff", "server", 15, 5, "SETTINGS_MAX_FRAME_SIZE", 16383, 16384, 16777215, "000500003fff")?
	let duplicate_later_invalid: Bool = peer_settings_rejects("000500004000aaaa12345678000500003fff", "server", 21, 5, "SETTINGS_MAX_FRAME_SIZE", 16383, 16384, 16777215, "000500003fff")?
	if accepted and invalid_after_unknown and duplicate_later_invalid
		Ok(())
	else
		Err("peer SETTINGS validation lost unknown-item, wire-order, or duplicate precedence")
	end
end

test peer_settings_validation_rejects_endpoint_role_rules() -> Result<(), String>
	if peer_settings_role_rejects("000200000001", "client", 9, 2, "SETTINGS_ENABLE_PUSH", "rfc9113_client_must_not_receive_settings_enable_push", "000200000001")? and peer_settings_role_rejects("000800000001", "server", 9, 8, "SETTINGS_ENABLE_CONNECT_PROTOCOL", "rfc8441_client_must_not_send_settings_enable_connect_protocol", "000800000001")?
		Ok(())
	else
		Err("peer SETTINGS validation accepted a setting disallowed for the endpoint role")
	end
end

test peer_settings_validation_failure_preserves_input_and_exact_context() -> Result<(), String>
	let payload: ByteChunk = byte_chunk_from_hex("aaaa12345678000200000002000500003fff")?
	match http2::core::validate_peer_settings_payload(33, "server", payload)
		Ok(validation) => peer_settings_failure_preserves_input(validation, payload)
		Err(error) => Err(error)
	end
end

fn peer_settings_failure_preserves_input(validation: PeerSettingsValidation, payload: ByteChunk) -> Result<(), String>
	match http2::core::peer_settings_validation_status(validation)
		"rejected" => peer_settings_failure_context_matches(http2::core::peer_settings_validation_failure(validation)?, payload)
		_ => Err("invalid peer SETTINGS payload exposed success")
	end
end

fn peer_settings_failure_context_matches(failure: PeerSettingsFailure, payload: ByteChunk) -> Result<(), String>
	if http2::core::peer_settings_failure_id(failure) == "http2.peer_limit.settings_value_out_of_range" and http2::core::peer_settings_failure_offset(failure) == 39 and http2::core::peer_settings_failure_setting_identifier(failure) == 2 and http2::core::peer_settings_failure_setting_name(failure) == "SETTINGS_ENABLE_PUSH" and http2::core::peer_settings_failure_observed_value(failure) == 2 and http2::core::peer_settings_failure_accepted_min_value(failure) == 0 and http2::core::peer_settings_failure_accepted_max_value(failure) == 1 and http2::core::peer_settings_failure_active_state(failure) == "peer-settings" and http2::core::peer_settings_failure_rule_provenance(failure) == "http2_settings_value_range" and chunks_equal(byte_view_to_chunk(http2::core::peer_settings_failure_preview(failure)), byte_chunk_from_hex("000200000002")?)? and chunks_equal(payload, byte_chunk_from_hex("aaaa12345678000200000002000500003fff")?)?
		Ok(())
	else
		Err("peer SETTINGS validation failure lost exact context or mutated input")
	end
end

test peer_settings_state_starts_with_protocol_defaults() -> Result<(), String>
	let state: PeerSettingsState = http2::core::empty_peer_settings_state()
	if http2::core::peer_settings_max_frame_size(state) == 0 and http2::core::peer_settings_active_max_frame_size(state) == 16384 and http2::core::peer_settings_initial_window_size(state) == 0 and http2::core::peer_settings_active_initial_window_size(state) == 65535 and http2::core::peer_settings_max_concurrent_streams(state) == 0 and http2::core::peer_settings_active_max_concurrent_streams(state) == 2147483647 and http2::core::peer_settings_header_table_size(state) == 0 and http2::core::peer_settings_active_header_table_size(state) == 4096 and http2::core::peer_settings_max_header_list_size(state) == 0 and http2::core::peer_settings_highest_peer_created_stream_id(state) == 0
		Ok(())
	else
		Err("empty peer SETTINGS state did not expose protocol defaults")
	end
end

test peer_settings_state_applies_known_items_and_ignores_unknown_items() -> Result<(), String>
	let payload: ByteChunk = byte_chunk_from_hex("aaaa12345678000500008000000400000003000200000000000300000002000100001000000600002000000800000001")?
	let state: PeerSettingsState = http2::core::apply_peer_settings_payload(http2::core::empty_peer_settings_state(), 9, payload)?
	if http2::core::peer_settings_max_frame_size(state) == 32768 and http2::core::peer_settings_max_frame_size_offset(state) == 15 and http2::core::peer_settings_initial_window_size(state) == 3 and http2::core::peer_settings_initial_window_size_offset(state) == 21 and http2::core::peer_settings_enable_push(state) == 0 and http2::core::peer_settings_enable_push_offset(state) == 27 and http2::core::peer_settings_max_concurrent_streams(state) == 2 and http2::core::peer_settings_max_concurrent_streams_offset(state) == 33 and http2::core::peer_settings_header_table_size(state) == 4096 and http2::core::peer_settings_header_table_size_offset(state) == 39 and http2::core::peer_settings_max_header_list_size(state) == 8192 and http2::core::peer_settings_max_header_list_size_offset(state) == 45 and http2::core::peer_settings_enable_connect_protocol(state) == 1 and http2::core::peer_settings_enable_connect_protocol_offset(state) == 51
		Ok(())
	else
		Err("peer SETTINGS state did not apply known items with absolute offsets")
	end
end

test peer_settings_state_uses_last_duplicate_value() -> Result<(), String>
	let payload: ByteChunk = byte_chunk_from_hex("000500008000000500010000")?
	let state: PeerSettingsState = http2::core::apply_peer_settings_payload(http2::core::empty_peer_settings_state(), 9, payload)?
	if http2::core::peer_settings_max_frame_size(state) == 65536 and http2::core::peer_settings_max_frame_size_offset(state) == 15 and http2::core::peer_settings_active_max_frame_size(state) == 65536
		Ok(())
	else
		Err("duplicate peer SETTINGS item did not leave the last value active")
	end
end

test peer_settings_state_preserves_enable_push_and_connect_offsets_independently() -> Result<(), String>
	let payload: ByteChunk = byte_chunk_from_hex("000800000001000200000001000800000000000200000000")?
	let state: PeerSettingsState = http2::core::apply_peer_settings_payload(http2::core::empty_peer_settings_state(), 30, payload)?
	if http2::core::peer_settings_enable_push(state) == 0 and http2::core::peer_settings_enable_push_offset(state) == 48 and http2::core::peer_settings_enable_connect_protocol(state) == 0 and http2::core::peer_settings_enable_connect_protocol_offset(state) == 42
		Ok(())
	else
		Err("peer SETTINGS enable-push and connect-protocol offsets were not preserved independently")
	end
end

test peer_settings_state_preserves_state_for_partial_payloads() -> Result<(), String>
	let initial: PeerSettingsState = http2::core::apply_peer_settings_payload(http2::core::empty_peer_settings_state(), 9, byte_chunk_from_hex("000500008000")?)?
	let partial: PeerSettingsState = http2::core::apply_peer_settings_payload(initial, 15, byte_chunk_from_hex("0006000020")?)?
	if http2::core::peer_settings_max_frame_size(partial) == 32768 and http2::core::peer_settings_max_frame_size_offset(partial) == 9 and http2::core::peer_settings_max_header_list_size(partial) == 0
		Ok(())
	else
		Err("partial peer SETTINGS payload changed advertised state")
	end
end

test peer_settings_state_records_peer_created_stream_high_water() -> Result<(), String>
	let initial: PeerSettingsState = http2::core::apply_peer_settings_payload(http2::core::empty_peer_settings_state(), 9, byte_chunk_from_hex("000500008000000400000003")?)?
	let raised: PeerSettingsState = http2::core::peer_settings_with_highest_peer_created_stream_id(initial, 7)
	if http2::core::peer_settings_highest_peer_created_stream_id(raised) == 7 and http2::core::peer_settings_highest_peer_created_stream_id(initial) == 0 and http2::core::peer_settings_max_frame_size(raised) == 32768 and http2::core::peer_settings_max_frame_size_offset(raised) == 9 and http2::core::peer_settings_initial_window_size(raised) == 3 and http2::core::peer_settings_initial_window_size_offset(raised) == 15
		Ok(())
	else
		Err("peer-created stream high-water update mutated the input SETTINGS state")
	end
end
