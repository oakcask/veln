fn require_peer_stream_admission_failure(decision: CorePeerStreamAdmissionDecision) -> Result<CorePeerStreamAdmissionFailure, String>
	http2::core::peer_stream_admission_decision_failure(decision)
end

test stream_domains_are_role_aware() -> Result<(), String>
	let client: StreamId = http2::core::client_stream_id(1)?
	let server: StreamId = http2::core::server_stream_id(2)?
	if http2::core::stream_id_value(client) == 1 and http2::core::stream_id_value(server) == 2
		Ok(())
	else
		Err("HTTP/2 stream domains did not retain validated values")
	end
end

test stream_domains_project_connection_and_real_references() -> Result<(), String>
	let client: StreamId = http2::core::client_stream_id(1)?
	let server: StreamId = http2::core::server_stream_id(2)?
	let connection: StreamRef = http2::core::connection_stream_ref()
	let client_ref: StreamRef = http2::core::real_stream_ref(client)
	let server_ref: StreamRef = http2::core::real_stream_ref(server)
	if http2::core::stream_ref_is_connection(connection) and not http2::core::stream_ref_is_real(connection) and http2::core::stream_ref_value(connection) == 0 and not http2::core::stream_ref_is_connection(client_ref) and http2::core::stream_ref_is_real(client_ref) and http2::core::stream_ref_value(client_ref) == 1 and not http2::core::stream_ref_is_connection(server_ref) and http2::core::stream_ref_is_real(server_ref) and http2::core::stream_ref_value(server_ref) == 2
		Ok(())
	else
		Err("HTTP/2 stream references did not preserve connection or real-stream projections")
	end
end

test stream_domains_accept_lower_bounds_and_reject_invalid_boundaries() -> Result<(), String>
	if stream_id_accepts(http2::core::client_stream_id(1), 1) and stream_id_accepts(http2::core::server_stream_id(2), 2) and stream_id_rejects(http2::core::client_stream_id(0)) and stream_id_rejects(http2::core::server_stream_id(0)) and stream_id_rejects(http2::core::client_stream_id(2147483648)) and stream_id_rejects(http2::core::server_stream_id(2147483648)) and stream_id_rejects(http2::core::client_stream_id(2)) and stream_id_rejects(http2::core::server_stream_id(3))
		Ok(())
	else
		Err("HTTP/2 stream id domains did not preserve lower-bound, upper-bound, zero, and parity invariants")
	end
end

test flow_control_domains_accept_boundaries() -> Result<(), String>
	if connection_credit_accepts(0) and connection_credit_accepts(2147483647) and stream_credit_accepts(0 - 2147483647) and stream_credit_accepts(0) and stream_credit_accepts(2147483647) and initial_window_accepts(0) and initial_window_accepts(2147483647) and window_update_increment_accepts(1) and window_update_increment_accepts(2147483647)
		Ok(())
	else
		Err("HTTP/2 flow-control domains rejected accepted boundary values")
	end
end

test flow_control_domains_reject_out_of_range_values() -> Result<(), String>
	if flow_control_rejects(http2::core::connection_window_credit(0 - 1), "connection_window_credit", 0 - 1, 0, 2147483647) and flow_control_rejects(http2::core::connection_window_credit(2147483648), "connection_window_credit", 2147483648, 0, 2147483647) and flow_control_stream_rejects(http2::core::stream_window_credit(0 - 2147483648), "stream_window_credit", 0 - 2147483648, 0 - 2147483647, 2147483647) and flow_control_stream_rejects(http2::core::stream_window_credit(2147483648), "stream_window_credit", 2147483648, 0 - 2147483647, 2147483647) and flow_control_initial_rejects(http2::core::initial_window_size(0 - 1), "initial_window_size", 0 - 1, 0, 2147483647) and flow_control_initial_rejects(http2::core::initial_window_size(2147483648), "initial_window_size", 2147483648, 0, 2147483647) and flow_control_increment_rejects(http2::core::window_update_increment(0), "window_update_increment", 0, 1, 2147483647) and flow_control_increment_rejects(http2::core::window_update_increment(2147483648), "window_update_increment", 2147483648, 1, 2147483647)
		Ok(())
	else
		Err("HTTP/2 flow-control domains accepted an out-of-range value")
	end
end

test flow_control_debit_and_refill_are_immutable() -> Result<(), String>
	let connection: CoreConnectionWindowCredit = require_connection_credit(10)?
	let stream: CoreStreamWindowCredit = require_stream_credit(0 - 5)?
	let increment: CoreWindowUpdateIncrement = require_window_update_increment(8)?
	let debited_connection: FlowControlCreditDecision = http2::core::debit_connection_window(connection, 4)
	let debited_stream: FlowControlCreditDecision = http2::core::debit_stream_window(stream, 2)
	let refilled_connection: FlowControlCreditDecision = http2::core::refill_connection_window(connection, increment)
	let refilled_stream: FlowControlCreditDecision = http2::core::refill_stream_window(stream, increment)
	if http2::core::flow_control_credit_decision_status(debited_connection) == "accepted" and http2::core::flow_control_credit_decision_value(debited_connection) == 6 and http2::core::flow_control_credit_decision_status(debited_stream) == "accepted" and http2::core::flow_control_credit_decision_value(debited_stream) == 0 - 7 and http2::core::flow_control_credit_decision_status(refilled_connection) == "accepted" and http2::core::flow_control_credit_decision_value(refilled_connection) == 18 and http2::core::flow_control_credit_decision_status(refilled_stream) == "accepted" and http2::core::flow_control_credit_decision_value(refilled_stream) == 3 and http2::core::connection_window_credit_value(connection) == 10 and http2::core::stream_window_credit_value(stream) == 0 - 5 and http2::core::window_update_increment_value(increment) == 8
		Ok(())
	else
		Err("HTTP/2 flow-control debit or refill did not preserve immutable inputs")
	end
end

test flow_control_failures_preserve_input_credit() -> Result<(), String>
	let connection: CoreConnectionWindowCredit = require_connection_credit(3)?
	let stream: CoreStreamWindowCredit = require_stream_credit(2147483646)?
	let increment: CoreWindowUpdateIncrement = require_window_update_increment(2)?
	let debited: FlowControlCreditDecision = http2::core::debit_connection_window(connection, 4)
	let refilled: FlowControlCreditDecision = http2::core::refill_stream_window(stream, increment)
	let debit_failure: FlowControlDomainFailure = http2::core::flow_control_credit_decision_failure(debited)?
	let refill_failure: FlowControlDomainFailure = http2::core::flow_control_credit_decision_failure(refilled)?
	if http2::core::flow_control_failure_domain(debit_failure) == "connection_window_credit" and http2::core::flow_control_failure_observed_value(debit_failure) == 0 - 1 and http2::core::flow_control_failure_domain(refill_failure) == "stream_window_credit" and http2::core::flow_control_failure_observed_value(refill_failure) == 2147483648 and http2::core::connection_window_credit_value(connection) == 3 and http2::core::stream_window_credit_value(stream) == 2147483646
		Ok(())
	else
		Err("HTTP/2 flow-control failure changed input credit or lost diagnostic data")
	end
end

test peer_stream_admission_records_only_new_non_trailer_headers() -> Result<(), String>
	let empty: CorePeerStreamAdmissionState = http2::core::empty_peer_stream_admission()
	let first: CorePeerStreamAdmissionState = http2::core::record_new_headers_peer_stream(1, 1, false, false, empty)
	let trailer: CorePeerStreamAdmissionState = http2::core::record_new_headers_peer_stream(1, 3, true, false, first)
	let known: CorePeerStreamAdmissionState = http2::core::record_new_headers_peer_stream(1, 5, false, true, trailer)
	let data: CorePeerStreamAdmissionState = http2::core::record_new_headers_peer_stream(0, 7, false, false, known)
	let higher: CorePeerStreamAdmissionState = http2::core::record_new_headers_peer_stream(1, 9, false, false, data)
	if http2::core::peer_stream_admission_highest_stream_id(empty) == 0 and http2::core::peer_stream_admission_highest_stream_id(first) == 1 and http2::core::peer_stream_admission_highest_stream_id(trailer) == 1 and http2::core::peer_stream_admission_highest_stream_id(known) == 1 and http2::core::peer_stream_admission_highest_stream_id(data) == 1 and http2::core::peer_stream_admission_highest_stream_id(higher) == 9
		Ok(())
	else
		Err("peer stream admission recorded the wrong HEADERS high-water state")
	end
end

test peer_stream_admission_rejects_non_increasing_stream_ids_without_next_state() -> Result<(), String>
	let state: CorePeerStreamAdmissionState = http2::core::record_peer_stream_id(5, http2::core::empty_peer_stream_admission())
	let accepted: CorePeerStreamAdmissionDecision = http2::core::validate_new_peer_stream(17, 7, "server", state, byte_chunk_from_hex("000000010400000007")?)
	let rejected: CorePeerStreamAdmissionDecision = http2::core::validate_new_peer_stream(29, 3, "server", state, byte_chunk_from_hex("000000010400000003")?)
	let failure: CorePeerStreamAdmissionFailure = require_peer_stream_admission_failure(rejected)?
	if http2::core::peer_stream_admission_decision_status(accepted) == "accepted" and http2::core::peer_stream_admission_highest_stream_id(http2::core::peer_stream_admission_decision_state(accepted)?) == 5 and http2::core::peer_stream_admission_decision_status(rejected) == "rejected" and http2::core::peer_stream_admission_failure_offset(failure) == 29 and http2::core::peer_stream_admission_failure_stream_id(failure) == 3 and http2::core::peer_stream_admission_failure_previous_stream_id(failure) == 5 and http2::core::peer_stream_admission_failure_endpoint_role(failure) == "server" and http2::core::peer_stream_admission_failure_active_state(failure) == "idle-stream" and http2::core::peer_stream_admission_failure_rule_provenance(failure) == "peer_created_stream_ids_increase" and chunks_equal(http2::core::peer_stream_admission_failure_preview(failure), byte_chunk_from_hex("000000010400000003")?)? and http2::core::peer_stream_admission_highest_stream_id(state) == 5
		Ok(())
	else
		Err("peer stream admission failure lost data or changed input state")
	end
end

test initial_peer_settings_gate_accepts_server_and_client_roles() -> Result<(), String>
