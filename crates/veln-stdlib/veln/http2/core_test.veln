test receive_frame_dispatch_preserves_state_on_failures() -> Result<(), String>
	let base: CoreConnectionState = http2::core::connection_state_with_receive_credit(http2::core::server_connection_state(41)?, require_connection_credit(5)?)
	let stream: CoreStreamEntry = require_stream_entry(http2::core::stream_entry(5, http2::core::stream_open_lifecycle(), 4, 2147483640, 0, 0))?
	let state: CoreConnectionState = http2::core::connection_state_with_streams(base, http2::core::stream_collection_add_or_replace(http2::core::connection_state_streams(base), stream))
	let admission_failure: CoreReceiveFrameFailure = require_receive_frame_failure(http2::core::apply_receive_frame(state, byte_chunk_from_hex("000001000000000000ff")?))?
	let padded_data_failure: CoreReceiveFrameFailure = require_receive_frame_failure(http2::core::apply_receive_frame(state, byte_chunk_from_hex("000000000800000005")?))?
	let data_failure: CoreReceiveFrameFailure = require_receive_frame_failure(http2::core::apply_receive_frame(state, byte_chunk_from_hex("000006000000000005010203040506")?))?
	let stream_window_failure: CoreReceiveFrameFailure = require_receive_frame_failure(http2::core::apply_receive_frame(state, byte_chunk_from_hex("00000408000000000500000009")?))?
	let connection_window_state: CoreConnectionState = http2::core::connection_state_with_receive_credit(state, require_connection_credit(2147483640)?)
	let connection_window_failure: CoreReceiveFrameFailure = require_receive_frame_failure(http2::core::apply_receive_frame(connection_window_state, byte_chunk_from_hex("00000408000000000000000009")?))?
	let found: CoreStreamEntry = require_found_stream(http2::core::stream_collection_find(http2::core::connection_state_streams(state), 5))?
	if http2::core::receive_frame_failure_source(admission_failure) == "stream-frame-admission" and http2::core::receive_frame_failure_id(admission_failure) == "http2.protocol.invalid_frame_kind" and http2::core::receive_frame_failure_stream_id(admission_failure) == 0 and http2::core::receive_frame_failure_source(padded_data_failure) == "payload-read" and http2::core::receive_frame_failure_id(padded_data_failure) == "http2.frame.payload_read_failure" and http2::core::receive_frame_failure_reason(padded_data_failure) == "padded DATA frame has no pad-length octet" and http2::core::receive_frame_failure_offset(padded_data_failure) == 41 and http2::core::receive_frame_failure_frame_kind(padded_data_failure) == 0 and http2::core::receive_frame_failure_stream_id(padded_data_failure) == 5 and byte_count_to_int(byte_chunk_count(http2::core::receive_frame_failure_preview(padded_data_failure))) == 9 and http2::core::receive_frame_failure_source(data_failure) == "data-flow-control" and http2::core::receive_frame_failure_id(data_failure) == "http2.flow_control.window_exceeded" and http2::core::receive_frame_failure_source(stream_window_failure) == "stream-window-update-flow-control" and http2::core::receive_frame_failure_id(stream_window_failure) == "http2.flow_control.window_exceeded" and http2::core::receive_frame_failure_source(connection_window_failure) == "connection-window-update-flow-control" and http2::core::receive_frame_failure_id(connection_window_failure) == "http2.flow_control.window_exceeded" and http2::core::connection_state_next_offset(state) == 41 and http2::core::connection_window_credit_value(http2::core::connection_state_receive_credit(state)) == 5 and http2::core::stream_window_credit_value(http2::core::stream_entry_receive_credit(found)) == 4 and http2::core::stream_window_credit_value(http2::core::stream_entry_send_credit(found)) == 2147483640
		Ok(())
	else
		Err("HTTP/2 receive-frame dispatch did not preserve state and classify failures")
	end
end

