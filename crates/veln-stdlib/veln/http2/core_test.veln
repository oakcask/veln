test connection_preface_accepts_complete_input_and_preserves_trailing_bytes() -> Result<(), String>
	let input: ByteChunk = byte_chunk_from_hex("505249202a20485454502f322e300d0a0d0a534d0d0a0d0aaabbcc")?
	let transition: ConnectionPrefaceTransition = require_preface_transition(http2::core::accept_connection_preface(http2::core::empty_connection_preface(0), input))?
	let state: ConnectionPrefaceState = http2::core::connection_preface_state(transition)
	if http2::core::connection_preface_is_complete(transition) and http2::core::connection_preface_state_is_complete(state) and http2::core::connection_preface_starting_offset(state) == 0 and http2::core::connection_preface_matched_count(state) == 24 and chunks_equal(http2::core::connection_preface_suffix(transition), byte_chunk_from_hex("aabbcc")?)?
		Ok(())
	else
		Err("complete connection preface did not preserve its trailing input")
	end
end

test connection_preface_accepts_byte_by_byte_input() -> Result<(), String>
