	let connection_window_state: CoreConnectionState = http2::core::receive_frame_state(connection_window_decision)?
	let rst_decision: CoreReceiveFrameDecision = require_receive_frame_decision(http2::core::apply_receive_frame(state, byte_chunk_from_hex("00000403000000000500000008")?))?
	let rst_state: CoreConnectionState = http2::core::receive_frame_state(rst_decision)?
	let rst_stream: CoreStreamEntry = require_found_stream(http2::core::stream_collection_find(http2::core::connection_state_streams(rst_state), 5))?
	if http2::core::receive_frame_status(data_decision) == "accepted" and http2::core::receive_frame_applied_transition(data_decision) == "data" and http2::core::connection_state_next_offset(data_state) == 44 and http2::core::connection_window_credit_value(http2::core::connection_state_receive_credit(data_state)) == 16 and http2::core::stream_window_credit_value(http2::core::stream_entry_receive_credit(data_stream)) == 10 and http2::core::stream_lifecycle_label(http2::core::stream_entry_lifecycle(data_stream)) == "half-closed-remote" and http2::core::receive_frame_applied_transition(stream_window_decision) == "stream-window-update" and http2::core::stream_window_credit_value(http2::core::stream_entry_send_credit(stream_window_stream)) == 27 and http2::core::connection_state_next_offset(stream_window_state) == 57 and http2::core::receive_frame_applied_transition(connection_window_decision) == "connection-window-update" and http2::core::connection_window_credit_value(http2::core::connection_state_receive_credit(connection_window_state)) == 23 and http2::core::connection_state_next_offset(connection_window_state) == 70 and http2::core::receive_frame_applied_transition(rst_decision) == "rst-stream" and http2::core::stream_lifecycle_label(http2::core::stream_entry_lifecycle(rst_stream)) == "reset" and http2::core::stream_lifecycle_error_code(http2::core::stream_entry_lifecycle(rst_stream)) == 8 and http2::core::connection_state_next_offset(rst_state) == 44 and http2::core::connection_state_next_offset(state) == 31
		Ok(())
	else
