use prelude
use http2::hpack::dynamic_table
use http2::hpack::header_codec
use http2::hpack::header_list_decoder
use http2::hpack::huffman
use http2::hpack::integer
use http2::hpack::static_table
use http2::hpack::table_size_update

pub type DynamicTable = http2::hpack::dynamic_table::DynamicTable

pub type DynamicEntry = http2::hpack::dynamic_table::DynamicEntry

pub type IndexedHeaderField
	IndexedHeaderField(name: String, value: ByteChunk)
end

pub type IndexedDecodeFailure
	MalformedIndexedInteger
	IncompleteIndexedInteger
	ZeroIndexedHeader
	UnavailableStaticEntry(index: Int)
	UnavailableDynamicEntry(index: Int, dynamic_index: Int, entry_count: Int)
end

pub type IndexedDecodeTransition
	IndexedDecodeTransition(header: IndexedHeaderField, consumed: Int, table: DynamicTable)
end

pub type LiteralHeaderField
	LiteralHeaderField(name: String, value: ByteChunk)
end

pub type LiteralDecodeFailure
	MalformedLiteralNameIndex
	IncompleteLiteralNameIndex
	UnavailableLiteralStaticName(index: Int)
	UnavailableLiteralDynamicName(index: Int, dynamic_index: Int, entry_count: Int)
	MalformedLiteralNameLength
	IncompleteLiteralNameLength
	TruncatedLiteralRawName(expected: Int, available: Int)
	LiteralNameHuffmanFailure
	InvalidLiteralNameOctets
	MalformedLiteralValueLength
	IncompleteLiteralValueLength
	TruncatedLiteralRawValue(expected: Int, available: Int)
	LiteralValueHuffmanFailure
end

pub type LiteralDecodeTransition
	LiteralDecodeTransition(header: LiteralHeaderField, consumed: Int, table: DynamicTable, representation: Int)
end

pub type HeaderField
	HeaderField(name: String, value: ByteChunk)
end

pub type HeaderList
	EmptyHeaderList
	HeaderListField(header: HeaderField, remaining: HeaderList)
end

pub type HeaderBlockDecodeFailure
	UnsupportedHeaderRepresentation(first_octet: Int)
	MisplacedTableSizeUpdate
	HeaderBlockIndexedFailure(failure: IndexedDecodeFailure)
	HeaderBlockLiteralFailure(failure: LiteralDecodeFailure)
	HeaderBlockTableSizeUpdateFailure(failure: TableSizeUpdateFailure)
end

pub type HeaderBlockDecodeTransition
	HeaderBlockDecodeTransition(headers: HeaderList, consumed: Int, table: DynamicTable)
end

pub type TableSizeUpdateFailure
	NotTableSizeUpdate
	MalformedTableSizeUpdateInteger
	IncompleteTableSizeUpdateInteger
	TableSizeUpdateCapacityLimit(capacity: Int, peer_maximum: Int)
end

pub type TableSizeUpdateTransition
	TableSizeUpdateTransition(capacity: Int, consumed: Int, table: DynamicTable)
end

pub type StaticEntry
	StaticEntry(name: String, value: String)
end

pub fn encode_integer(value: Int, prefix_bits: Int, representation_bits: Int) -> Result<ByteChunk, String>
	http2::hpack::integer::encode_prefixed(value, prefix_bits, representation_bits)
end

pub fn decode_integer(input: ByteView, prefix_bits: Int) -> Result<{ value : Int, consumed : Int }, String>
	http2::hpack::integer::decode(input, prefix_bits)
end

pub fn decoded_integer_value(decoded: { value : Int, consumed : Int }) -> Int
	http2::hpack::integer::value(decoded)
end

pub fn decoded_integer_consumed(decoded: { value : Int, consumed : Int }) -> Int
	http2::hpack::integer::consumed(decoded)
end

pub fn encode_huffman(bytes: ByteChunk) -> Result<ByteChunk, String>
	http2::hpack::huffman::encode_bytes(bytes)
end

pub fn decode_huffman(input: ByteView) -> Result<ByteChunk, String>
	http2::hpack::huffman::decode_bytes(input)
end

pub fn static_entry(index: Int) -> Option<StaticEntry>
	match http2::hpack::static_table::lookup(index)
		Some(entry) => Some(StaticEntry(entry.name, entry.value))
		None => None
	end
end

pub fn static_entry_name(entry: StaticEntry) -> String
	match entry
		StaticEntry(name, _) => name
	end
end

pub fn static_entry_value(entry: StaticEntry) -> String
	match entry
		StaticEntry(_, value) => value
	end
end

pub fn static_entry_index(name: String, value: String) -> Option<Int>
	http2::hpack::static_table::entry_index(name, value)
end

pub fn static_name_index(name: String) -> Option<Int>
	http2::hpack::static_table::name_index(name)
end

pub fn empty_dynamic_table(capacity: Int) -> Result<DynamicTable, String>
	http2::hpack::dynamic_table::empty(capacity)
end

pub fn dynamic_table_capacity(table: DynamicTable) -> Int
	http2::hpack::dynamic_table::capacity(table)
end

pub fn dynamic_table_size(table: DynamicTable) -> Int
	http2::hpack::dynamic_table::size(table)
end

pub fn dynamic_table_entry_count(table: DynamicTable) -> Int
	http2::hpack::dynamic_table::entry_count(table)
end

pub fn insert_dynamic_table_entry(table: DynamicTable, name: String, value: ByteChunk) -> Result<DynamicTable, String>
	http2::hpack::dynamic_table::insert(table, name, value)
end

pub fn dynamic_table_with_capacity(table: DynamicTable, capacity: Int) -> Result<DynamicTable, String>
	http2::hpack::dynamic_table::with_capacity(table, capacity)
end

pub fn dynamic_table_entry(table: DynamicTable, index: Int) -> Option<DynamicEntry>
	http2::hpack::dynamic_table::lookup(table, index)
end

pub fn dynamic_entry_name(entry: DynamicEntry) -> String
	http2::hpack::dynamic_table::entry_name(entry)
end

pub fn dynamic_entry_value(entry: DynamicEntry) -> ByteChunk
	http2::hpack::dynamic_table::entry_value(entry)
end

fn table_size_update_failure(failure: TableSizeUpdateCodecFailure) -> TableSizeUpdateFailure
	match http2::hpack::table_size_update::failure_kind(failure)
		0 => NotTableSizeUpdate
		1 => MalformedTableSizeUpdateInteger
		2 => IncompleteTableSizeUpdateInteger
		_ => TableSizeUpdateCapacityLimit(http2::hpack::table_size_update::failure_capacity(failure), http2::hpack::table_size_update::failure_peer_maximum(failure))
	end
end

fn table_size_update_transition(transition: TableSizeUpdateCodecTransition) -> TableSizeUpdateTransition
	TableSizeUpdateTransition(http2::hpack::table_size_update::transition_capacity(transition), http2::hpack::table_size_update::transition_consumed(transition), http2::hpack::table_size_update::transition_table(transition))
end

pub fn decode_table_size_update(input: ByteView, table: DynamicTable, peer_maximum: Int) -> Result<TableSizeUpdateTransition, TableSizeUpdateFailure>
	match http2::hpack::table_size_update::decode(input, table, peer_maximum)
		Ok(transition) => Ok(table_size_update_transition(transition))
		Err(failure) => Err(table_size_update_failure(failure))
	end
end

pub fn table_size_update_capacity(transition: TableSizeUpdateTransition) -> Int
	match transition
		TableSizeUpdateTransition(capacity, _, _) => capacity
	end
end

pub fn table_size_update_consumed(transition: TableSizeUpdateTransition) -> Int
	match transition
		TableSizeUpdateTransition(_, consumed, _) => consumed
	end
end

pub fn table_size_update_table(transition: TableSizeUpdateTransition) -> DynamicTable
	match transition
		TableSizeUpdateTransition(_, _, table) => table
	end
end

pub fn table_size_update_failure_kind(failure: TableSizeUpdateFailure) -> String
	match failure
		NotTableSizeUpdate => "not_table_size_update"
		MalformedTableSizeUpdateInteger => "malformed_integer"
		IncompleteTableSizeUpdateInteger => "incomplete_integer"
		TableSizeUpdateCapacityLimit(_, _) => "capacity_limit"
	end
end

pub fn table_size_update_failure_capacity(failure: TableSizeUpdateFailure) -> Int
	match failure
		TableSizeUpdateCapacityLimit(capacity, _) => capacity
		_ => 0
	end
end

pub fn table_size_update_failure_peer_maximum(failure: TableSizeUpdateFailure) -> Int
	match failure
		TableSizeUpdateCapacityLimit(_, peer_maximum) => peer_maximum
		_ => 0
	end
end

fn indexed_decode_failure(failure: HeaderCodecFailure) -> IndexedDecodeFailure
	match http2::hpack::header_codec::failure_kind(failure)
		0 => MalformedIndexedInteger
		1 => IncompleteIndexedInteger
		2 => ZeroIndexedHeader
		3 => UnavailableStaticEntry(http2::hpack::header_codec::failure_index(failure))
		_ => UnavailableDynamicEntry(http2::hpack::header_codec::failure_index(failure), http2::hpack::header_codec::failure_dynamic_index(failure), http2::hpack::header_codec::failure_dynamic_entry_count(failure))
	end
end

fn indexed_decode_transition(transition: HeaderCodecTransition) -> IndexedDecodeTransition
	let header: HeaderCodecField = http2::hpack::header_codec::transition_header(transition)
	IndexedDecodeTransition(IndexedHeaderField(http2::hpack::header_codec::header_name(header), http2::hpack::header_codec::header_value(header)), http2::hpack::header_codec::transition_consumed(transition), http2::hpack::header_codec::transition_table(transition))
end

pub fn decode_indexed_header_field(input: ByteView, table: DynamicTable) -> Result<IndexedDecodeTransition, IndexedDecodeFailure>
	match http2::hpack::header_codec::decode_indexed(input, table)
		Ok(transition) => Ok(indexed_decode_transition(transition))
		Err(failure) => Err(indexed_decode_failure(failure))
	end
end

pub fn indexed_decode_header(transition: IndexedDecodeTransition) -> IndexedHeaderField
	match transition
		IndexedDecodeTransition(header, _, _) => header
	end
end

pub fn indexed_decode_consumed(transition: IndexedDecodeTransition) -> Int
	match transition
		IndexedDecodeTransition(_, consumed, _) => consumed
	end
end

pub fn indexed_decode_table(transition: IndexedDecodeTransition) -> DynamicTable
	match transition
		IndexedDecodeTransition(_, _, table) => table
	end
end

pub fn indexed_header_name(header: IndexedHeaderField) -> String
	match header
		IndexedHeaderField(name, _) => name
	end
end

pub fn indexed_header_value(header: IndexedHeaderField) -> ByteChunk
	match header
		IndexedHeaderField(_, value) => value
	end
end

pub fn indexed_decode_failure_kind(failure: IndexedDecodeFailure) -> String
	match failure
		MalformedIndexedInteger => "malformed_integer"
		IncompleteIndexedInteger => "incomplete_integer"
		ZeroIndexedHeader => "zero_index"
		UnavailableStaticEntry(_) => "unavailable_static_entry"
		UnavailableDynamicEntry(_, _, _) => "unavailable_dynamic_entry"
	end
end

pub fn indexed_decode_failure_index(failure: IndexedDecodeFailure) -> Int
	match failure
		UnavailableStaticEntry(index) => index
		UnavailableDynamicEntry(index, _, _) => index
		_ => 0
	end
end

pub fn indexed_decode_failure_dynamic_index(failure: IndexedDecodeFailure) -> Int
	match failure
		UnavailableDynamicEntry(_, dynamic_index, _) => dynamic_index
		_ => 0
	end
end

pub fn indexed_decode_failure_dynamic_entry_count(failure: IndexedDecodeFailure) -> Int
	match failure
		UnavailableDynamicEntry(_, _, entry_count) => entry_count
		_ => 0
	end
end

fn literal_decode_failure(failure: HeaderCodecFailure) -> LiteralDecodeFailure
	match http2::hpack::header_codec::failure_kind(failure)
		5 => MalformedLiteralNameIndex
		6 => IncompleteLiteralNameIndex
		7 => UnavailableLiteralStaticName(http2::hpack::header_codec::failure_index(failure))
		8 => UnavailableLiteralDynamicName(http2::hpack::header_codec::failure_index(failure), http2::hpack::header_codec::failure_dynamic_index(failure), http2::hpack::header_codec::failure_dynamic_entry_count(failure))
		9 => MalformedLiteralNameLength
		10 => IncompleteLiteralNameLength
		11 => TruncatedLiteralRawName(http2::hpack::header_codec::failure_expected(failure), http2::hpack::header_codec::failure_available(failure))
		12 => LiteralNameHuffmanFailure
		13 => InvalidLiteralNameOctets
		14 => MalformedLiteralValueLength
		15 => IncompleteLiteralValueLength
		16 => TruncatedLiteralRawValue(http2::hpack::header_codec::failure_expected(failure), http2::hpack::header_codec::failure_available(failure))
		_ => LiteralValueHuffmanFailure
	end
end

fn literal_decode_transition(decoded: { transition : HeaderCodecTransition, representation : Int }) -> LiteralDecodeTransition
	let transition: HeaderCodecTransition = decoded.transition
	let header: HeaderCodecField = http2::hpack::header_codec::transition_header(transition)
	LiteralDecodeTransition(LiteralHeaderField(http2::hpack::header_codec::header_name(header), http2::hpack::header_codec::header_value(header)), http2::hpack::header_codec::transition_consumed(transition), http2::hpack::header_codec::transition_table(transition), decoded.representation)
end

pub fn decode_literal_header_field(input: ByteView, table: DynamicTable) -> Result<LiteralDecodeTransition, LiteralDecodeFailure>
	match http2::hpack::header_codec::decode_literal(input, table)
		Ok(decoded) => Ok(literal_decode_transition(decoded))
		Err(failure) => Err(literal_decode_failure(failure))
	end
end

pub fn literal_decode_header(transition: LiteralDecodeTransition) -> LiteralHeaderField
	match transition
		LiteralDecodeTransition(header, _, _, _) => header
	end
end

pub fn literal_decode_consumed(transition: LiteralDecodeTransition) -> Int
	match transition
		LiteralDecodeTransition(_, consumed, _, _) => consumed
	end
end

pub fn literal_decode_table(transition: LiteralDecodeTransition) -> DynamicTable
	match transition
		LiteralDecodeTransition(_, _, table, _) => table
	end
end

pub fn literal_decode_representation(transition: LiteralDecodeTransition) -> String
	match transition
		LiteralDecodeTransition(_, _, _, representation) => match representation
			0 => "incremental_indexing"
			1 => "without_indexing"
			_ => "never_indexed"
		end
	end
end

pub fn literal_header_name(header: LiteralHeaderField) -> String
	match header
		LiteralHeaderField(name, _) => name
	end
end

pub fn literal_header_value(header: LiteralHeaderField) -> ByteChunk
	match header
		LiteralHeaderField(_, value) => value
	end
end

pub fn literal_decode_failure_kind(failure: LiteralDecodeFailure) -> String
	match failure
		MalformedLiteralNameIndex => "malformed_name_index"
		IncompleteLiteralNameIndex => "incomplete_name_index"
		UnavailableLiteralStaticName(_) => "unavailable_static_name"
		UnavailableLiteralDynamicName(_, _, _) => "unavailable_dynamic_name"
		MalformedLiteralNameLength => "malformed_name_length"
		IncompleteLiteralNameLength => "incomplete_name_length"
		TruncatedLiteralRawName(_, _) => "truncated_raw_name"
		LiteralNameHuffmanFailure => "name_huffman_failure"
		InvalidLiteralNameOctets => "invalid_name_octets"
		MalformedLiteralValueLength => "malformed_value_length"
		IncompleteLiteralValueLength => "incomplete_value_length"
		TruncatedLiteralRawValue(_, _) => "truncated_raw_value"
		LiteralValueHuffmanFailure => "value_huffman_failure"
	end
end

pub fn literal_decode_failure_index(failure: LiteralDecodeFailure) -> Int
	match failure
		UnavailableLiteralStaticName(index) => index
		UnavailableLiteralDynamicName(index, _, _) => index
		_ => 0
	end
end

pub fn literal_decode_failure_dynamic_index(failure: LiteralDecodeFailure) -> Int
	match failure
		UnavailableLiteralDynamicName(_, dynamic_index, _) => dynamic_index
		_ => 0
	end
end

pub fn literal_decode_failure_dynamic_entry_count(failure: LiteralDecodeFailure) -> Int
	match failure
		UnavailableLiteralDynamicName(_, _, entry_count) => entry_count
		_ => 0
	end
end

pub fn literal_decode_failure_expected_octets(failure: LiteralDecodeFailure) -> Int
	match failure
		TruncatedLiteralRawName(expected, _) => expected
		TruncatedLiteralRawValue(expected, _) => expected
		_ => 0
	end
end

pub fn literal_decode_failure_available_octets(failure: LiteralDecodeFailure) -> Int
	match failure
		TruncatedLiteralRawName(_, available) => available
		TruncatedLiteralRawValue(_, available) => available
		_ => 0
	end
end

fn header_list_fields(fields: List<HeaderCodecField>) -> HeaderList
	match fields
		Nil => EmptyHeaderList
		Cons(field, remaining) => HeaderListField(HeaderField(http2::hpack::header_codec::header_name(field), http2::hpack::header_codec::header_value(field)), header_list_fields(remaining))
	end
end

fn header_block_failure(failure: HeaderBlockCodecFailure) -> HeaderBlockDecodeFailure
	match failure
		HeaderBlockCodecUnsupportedRepresentation(first_octet) => UnsupportedHeaderRepresentation(first_octet)
		HeaderBlockCodecMisplacedTableSizeUpdate => MisplacedTableSizeUpdate
		HeaderBlockCodecIndexedFailure(indexed) => HeaderBlockIndexedFailure(indexed_decode_failure(indexed))
		HeaderBlockCodecLiteralFailure(literal) => HeaderBlockLiteralFailure(literal_decode_failure(literal))
		HeaderBlockCodecTableSizeUpdateFailure(update) => HeaderBlockTableSizeUpdateFailure(table_size_update_failure(update))
		_ => UnsupportedHeaderRepresentation(0)
	end
end

fn header_block_transition(transition: HeaderBlockCodecTransition) -> HeaderBlockDecodeTransition
	HeaderBlockDecodeTransition(header_list_fields(http2::hpack::header_list_decoder::transition_headers(transition)), http2::hpack::header_list_decoder::transition_consumed(transition), http2::hpack::header_list_decoder::transition_table(transition))
end

pub fn decode_header_block(input: ByteView, table: DynamicTable, peer_maximum: Int) -> Result<HeaderBlockDecodeTransition, HeaderBlockDecodeFailure>
	match http2::hpack::header_list_decoder::decode(input, table, peer_maximum)
		Ok(transition) => Ok(header_block_transition(transition))
		Err(failure) => Err(header_block_failure(failure))
	end
end

pub fn header_block_headers(transition: HeaderBlockDecodeTransition) -> HeaderList
	match transition
		HeaderBlockDecodeTransition(headers, _, _) => headers
	end
end

pub fn header_block_consumed(transition: HeaderBlockDecodeTransition) -> Int
	match transition
		HeaderBlockDecodeTransition(_, consumed, _) => consumed
	end
end

pub fn header_block_table(transition: HeaderBlockDecodeTransition) -> DynamicTable
	match transition
		HeaderBlockDecodeTransition(_, _, table) => table
	end
end

pub fn header_field_name(header: HeaderField) -> String
	match header
		HeaderField(name, _) => name
	end
end

pub fn header_field_value(header: HeaderField) -> ByteChunk
	match header
		HeaderField(_, value) => value
	end
end

pub fn header_list_count(headers: HeaderList) -> Int
	match headers
		EmptyHeaderList => 0
		HeaderListField(_, remaining) => 1 + header_list_count(remaining)
	end
end

pub fn header_list_at(headers: HeaderList, index: Int) -> Option<HeaderField>
	match headers
		EmptyHeaderList => None
		HeaderListField(header, remaining) => if index == 0
			Some(header)
		else if index < 0
			None
		else
			header_list_at(remaining, index - 1)
		end
	end
end

pub fn header_block_failure_kind(failure: HeaderBlockDecodeFailure) -> String
	match failure
		UnsupportedHeaderRepresentation(_) => "unsupported_representation"
		MisplacedTableSizeUpdate => "misplaced_table_size_update"
		HeaderBlockIndexedFailure(_) => "indexed_failure"
		HeaderBlockLiteralFailure(_) => "literal_failure"
		HeaderBlockTableSizeUpdateFailure(_) => "table_size_update_failure"
	end
end

pub fn header_block_failure_first_octet(failure: HeaderBlockDecodeFailure) -> Int
	match failure
		UnsupportedHeaderRepresentation(first_octet) => first_octet
		_ => 0
	end
end

pub fn header_block_indexed_failure(failure: HeaderBlockDecodeFailure) -> Option<IndexedDecodeFailure>
	match failure
		HeaderBlockIndexedFailure(indexed) => Some(indexed)
		_ => None
	end
end

pub fn header_block_literal_failure(failure: HeaderBlockDecodeFailure) -> Option<LiteralDecodeFailure>
	match failure
		HeaderBlockLiteralFailure(literal) => Some(literal)
		_ => None
	end
end

pub fn header_block_table_size_update_failure(failure: HeaderBlockDecodeFailure) -> Option<TableSizeUpdateFailure>
	match failure
		HeaderBlockTableSizeUpdateFailure(update) => Some(update)
		_ => None
	end
end
