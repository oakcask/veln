use prelude
use http2::hpack::huffman
use http2::hpack::integer

pub type StringCodecFailure
	MalformedLength
	IncompleteLength
	TruncatedRawOctets(expected: Int, available: Int)
	HuffmanFailure
end

pub type StringCodecValue
	StringCodecValue(ByteChunk, consumed: Int)
end

fn incomplete_integer(failure: String) -> Bool
	failure == "HPACK integer input must not be empty" or failure == "incomplete HPACK integer continuation"
end

pub fn decode(input: ByteView) -> Result<StringCodecValue, StringCodecFailure>
	match http2::hpack::integer::decode(input, 7)
		Ok(decoded) => decode_value(input, decoded)
		Err(failure) => if incomplete_integer(failure)
			Err(StringCodecFailure::IncompleteLength)
		else
			Err(StringCodecFailure::MalformedLength)
		end
	end
end

fn decode_value(input: ByteView, decoded: { value : Int, consumed : Int }) -> Result<StringCodecValue, StringCodecFailure>
	let length = http2::hpack::integer::value(decoded)
	let prefix_consumed = http2::hpack::integer::consumed(decoded)
	let available = byte_count_to_int(byte_view_count(input)) - prefix_consumed
	if length > available
		Err(StringCodecFailure::TruncatedRawOctets(length, available))
	else
		match byte_count(prefix_consumed)
			Err(_) => Err(StringCodecFailure::MalformedLength)
			Ok(prefix_count) => match byte_view_drop(input, prefix_count)
				Err(_) => Err(StringCodecFailure::MalformedLength)
				Ok(payload_input) => decode_payload(input, payload_input, length, prefix_consumed)
			end
		end
	end
end

fn decode_payload(input: ByteView, payload_input: ByteView, length: Int, prefix_consumed: Int) -> Result<StringCodecValue, StringCodecFailure>
	match byte_count(length)
		Err(_) => Err(StringCodecFailure::MalformedLength)
		Ok(payload_count) => match byte_view_take(payload_input, payload_count)
			Err(_) => Err(StringCodecFailure::TruncatedRawOctets(length, byte_count_to_int(byte_view_count(payload_input))))
			Ok(payload) => decode_payload_encoding(input, byte_view_to_chunk(payload), prefix_consumed + length)
		end
	end
end

fn decode_payload_encoding(input: ByteView, payload: ByteChunk, consumed: Int) -> Result<StringCodecValue, StringCodecFailure>
	match byte_read_u8_be(input)
		Err(_) => Err(StringCodecFailure::IncompleteLength)
		Ok(first) => if (first & 128) == 0
			Ok(StringCodecValue(payload, consumed))
		else
			match byte_offset(0)
				Err(_) => Err(StringCodecFailure::HuffmanFailure)
				Ok(offset) => match byte_view(payload, offset, byte_chunk_count(payload))
					Err(_) => Err(StringCodecFailure::HuffmanFailure)
					Ok(payload_view) => match http2::hpack::huffman::decode_bytes(payload_view)
						Ok(value) => Ok(StringCodecValue(value, consumed))
						Err(_) => Err(StringCodecFailure::HuffmanFailure)
					end
				end
			end
		end
	end
end

pub fn value(decoded: StringCodecValue) -> ByteChunk
	match decoded
		StringCodecValue(value, _) => value
	end
end

pub fn consumed(decoded: StringCodecValue) -> Int
	match decoded
		StringCodecValue(_, consumed) => consumed
	end
end

pub fn failure_kind(failure: StringCodecFailure) -> Int
	match failure
		StringCodecFailure::MalformedLength => 0
		StringCodecFailure::IncompleteLength => 1
		StringCodecFailure::TruncatedRawOctets(_, _) => 2
		StringCodecFailure::HuffmanFailure => 3
	end
end

pub fn failure_expected(failure: StringCodecFailure) -> Int
	match failure
		StringCodecFailure::TruncatedRawOctets(expected, _) => expected
		_ => 0
	end
end

pub fn failure_available(failure: StringCodecFailure) -> Int
	match failure
		StringCodecFailure::TruncatedRawOctets(_, available) => available
		_ => 0
	end
end
