use prelude
use http2::hpack::dynamic_table
use http2::hpack::integer

pub type TableSizeUpdateCodecFailure
	NotRepresentation
	MalformedInteger
	IncompleteInteger
	CapacityLimit(capacity: Int, peer_maximum: Int)
end

pub type TableSizeUpdateCodecTransition
	TableSizeUpdateCodecTransition(capacity: Int, consumed: Int, table: DynamicTable)
end

fn incomplete_integer(failure: String) -> Bool
	failure == "HPACK integer input must not be empty" or failure == "incomplete HPACK integer continuation"
end

fn decode_integer(input: ByteView) -> Result<{ value : Int, consumed : Int }, TableSizeUpdateCodecFailure>
	match http2::hpack::integer::decode(input, 5)
		Ok(decoded) => Ok(decoded)
		Err(failure) => if incomplete_integer(failure)
			Err(TableSizeUpdateCodecFailure::IncompleteInteger)
		else
			Err(TableSizeUpdateCodecFailure::MalformedInteger)
		end
	end
end

fn apply_update(decoded: { value : Int, consumed : Int }, table: DynamicTable, peer_maximum: Int) -> Result<TableSizeUpdateCodecTransition, TableSizeUpdateCodecFailure>
	let capacity = http2::hpack::integer::value(decoded)
	if capacity > peer_maximum
		Err(TableSizeUpdateCodecFailure::CapacityLimit(capacity, peer_maximum))
	else
		match http2::hpack::dynamic_table::with_capacity(table, capacity)
			Ok(next_table) => Ok(TableSizeUpdateCodecTransition(capacity, http2::hpack::integer::consumed(decoded), next_table))
			Err(_) => Err(TableSizeUpdateCodecFailure::MalformedInteger)
		end
	end
end

pub fn decode(input: ByteView, table: DynamicTable, peer_maximum: Int) -> Result<TableSizeUpdateCodecTransition, TableSizeUpdateCodecFailure>
	match byte_read_u8_be(input)
		Err(_) => Err(TableSizeUpdateCodecFailure::IncompleteInteger)
		Ok(first) => if (first & 224) != 32
			Err(TableSizeUpdateCodecFailure::NotRepresentation)
		else
			apply_update(decode_integer(input)?, table, peer_maximum)
		end
	end
end

pub fn transition_capacity(transition: TableSizeUpdateCodecTransition) -> Int
	match transition
		TableSizeUpdateCodecTransition(capacity, _, _) => capacity
	end
end

pub fn transition_consumed(transition: TableSizeUpdateCodecTransition) -> Int
	match transition
		TableSizeUpdateCodecTransition(_, consumed, _) => consumed
	end
end

pub fn transition_table(transition: TableSizeUpdateCodecTransition) -> DynamicTable
	match transition
		TableSizeUpdateCodecTransition(_, _, table) => table
	end
end

pub fn failure_kind(failure: TableSizeUpdateCodecFailure) -> Int
	match failure
		TableSizeUpdateCodecFailure::NotRepresentation => 0
		TableSizeUpdateCodecFailure::MalformedInteger => 1
		TableSizeUpdateCodecFailure::IncompleteInteger => 2
		TableSizeUpdateCodecFailure::CapacityLimit(_, _) => 3
	end
end

pub fn failure_capacity(failure: TableSizeUpdateCodecFailure) -> Int
	match failure
		TableSizeUpdateCodecFailure::CapacityLimit(capacity, _) => capacity
		_ => 0
	end
end

pub fn failure_peer_maximum(failure: TableSizeUpdateCodecFailure) -> Int
	match failure
		TableSizeUpdateCodecFailure::CapacityLimit(_, peer_maximum) => peer_maximum
		_ => 0
	end
end
