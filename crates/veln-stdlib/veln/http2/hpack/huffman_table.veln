pub fn matching_symbol(value_to_match: Int, length_to_match: Int, symbol: Int) -> Option<Int>
	let candidate: HuffmanCode = code(symbol)
	if value(candidate) == value_to_match and length(candidate) == length_to_match
		Some(symbol)
	else if symbol == 256
		None
	else
		matching_symbol(value_to_match, length_to_match, symbol + 1)
	end
end
