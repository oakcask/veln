use prelude

pub type HuffmanCode
	HuffmanCode(value: Int, length: Int)
end

pub fn value(code: HuffmanCode) -> Int
	match code
		HuffmanCode(inner, _) => inner
	end
end

pub fn length(code: HuffmanCode) -> Int
	match code
		HuffmanCode(_, inner) => inner
	end
end

