use prelude

pub fn encode_prefixed(value: Int, prefix_bits: Int, representation_bits: Int) -> Result<ByteChunk, String>
	if prefix_bits < 1 or prefix_bits > 8
		Err("HPACK integer prefix width must be between 1 and 8")
	else
		encode_with_prefix(value, (1 << prefix_bits) - 1, representation_bits)
	end
end

fn encode_with_prefix(value: Int, prefix_max: Int, representation_bits: Int) -> Result<ByteChunk, String>
	if value < 0
		Err("HPACK integer value must not be negative")
	else if representation_bits < 0 or representation_bits > 255 or (representation_bits & prefix_max) != 0
		Err("HPACK integer representation bits must fit outside the prefix")
	else if value < prefix_max
		byte_write_u8_be(representation_bits + value)
	else
		Ok(byte_append(byte_write_u8_be(representation_bits + prefix_max)?, encode_continuation(value - prefix_max)?))
	end
end

fn encode_continuation(remaining: Int) -> Result<ByteChunk, String>
	if remaining < 128
		byte_write_u8_be(remaining)
	else
		Ok(byte_append(byte_write_u8_be((remaining & 127) + 128)?, encode_continuation(remaining / 128)?))
	end
end

pub fn decode(input: ByteView, prefix_bits: Int) -> Result<{ value : Int, consumed : Int }, String>
	if prefix_bits < 1 or prefix_bits > 8
		Err("HPACK integer prefix width must be between 1 and 8")
	else
		match byte_count_to_int(byte_view_count(input)) == 0
			true => Err("HPACK integer input must not be empty")
			false => decode_first(input, (1 << prefix_bits) - 1)
		end
	end
end

fn decode_first(input: ByteView, prefix_max: Int) -> Result<{ value : Int, consumed : Int }, String>
	let first = byte_read_u8_be(input)?
	let value = first & prefix_max
	if value < prefix_max
		Ok({ value: value, consumed: 1 })
	else
		decode_continuation(byte_view_drop(input, byte_count(1)?)?, prefix_max, 0, 1)
	end
end

fn decode_continuation(input: ByteView, value: Int, shift: Int, consumed: Int) -> Result<{ value : Int, consumed : Int }, String>
	match byte_count_to_int(byte_view_count(input)) == 0
		true => Err("incomplete HPACK integer continuation")
		false => if shift > 56
			Err("HPACK integer continuation is too large")
		else
			decode_continuation_byte(input, value, shift, consumed, byte_read_u8_be(input)?)
		end
	end
end

fn decode_continuation_byte(input: ByteView, value: Int, shift: Int, consumed: Int, next: Int) -> Result<{ value : Int, consumed : Int }, String>
	let payload = next & 127
	if shift == 56 and payload == 127 and value > 72057594037927935
		Err("HPACK integer continuation is too large")
	else
		decode_accumulated(input, value + (payload << shift), shift, consumed, next)
	end
end

fn decode_accumulated(input: ByteView, accumulated: Int, shift: Int, consumed: Int, next: Int) -> Result<{ value : Int, consumed : Int }, String>
	match (next & 128) == 0
		true => Ok({ value: accumulated, consumed: consumed + 1 })
		false => decode_continuation(byte_view_drop(input, byte_count(1)?)?, accumulated, shift + 7, consumed + 1)
	end
end

pub fn value(decoded: { value : Int, consumed : Int }) -> Int
	decoded.value
end

pub fn consumed(decoded: { value : Int, consumed : Int }) -> Int
	decoded.consumed
end
