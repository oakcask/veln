use prelude
use net
use host_effects

fn failure(operation: String, message: String) -> net::NetError
	net::NetError(operation, Some(net::Tcp4), Some("192.0.2.10:443"), net::ConnectionReset, message)
end

fn trace_push(trace: { tx : Sender<List<String>>, rx : Receiver<List<String>> }, operation: String) -> List<String> effects [concurrency]
	let observed: List<String> = option_unwrap_or(channel::recv(trace.rx), list_nil())
	let _ = channel::send(trace.tx, list_cons(operation, observed))
	observed
end

fn trace_contains(trace: List<String>, operation: String) -> Bool
	match trace
		Nil => false
		Cons(head, tail) => head == operation or trace_contains(tail, operation)
	end
end

pub handler scripted_network(mode: String, request: ByteChunk, trace: { tx : Sender<List<String>>, rx : Receiver<List<String>> }) for host_effects::Network effects [concurrency]
	request(operation, subject, bytes, remaining_ms, cancelled) => scripted_network_reply(mode, request, trace, operation, subject, bytes)
end

pub handler later_connection_network(mode: String, request: ByteChunk, trace: { tx : Sender<List<String>>, rx : Receiver<List<String>> }) for host_effects::Network effects [concurrency]
	request(operation, subject, bytes, remaining_ms, cancelled) => later_connection_network_reply(mode, request, trace, operation, subject, bytes)
end

pub handler many_connections_network(limit: Int, request: ByteChunk, accepted: { tx : Sender<Int>, rx : Receiver<Int> }, read_ready: { tx : Sender<Bool>, rx : Receiver<Bool> }, stream_closes: { tx : Sender<Int>, rx : Receiver<Int> }, listener_closes: { tx : Sender<Int>, rx : Receiver<Int> }) for host_effects::Network effects [concurrency]
	request(operation, subject, bytes, remaining_ms, cancelled) => many_connections_network_reply(limit, request, accepted, read_ready, stream_closes, listener_closes, operation, subject, bytes)
end

fn scripted_network_reply(mode: String, request: ByteChunk, trace: { tx : Sender<List<String>>, rx : Receiver<List<String>> }, operation: String, subject: String, bytes: ByteChunk) -> { status : String, value : String, local : String, peer : String, bytes : ByteChunk, resolved_endpoints : List<{ network : String, address : String }>, bytes_committed : Int, category : String, phase : String, input_committed : Int, output_committed : Int, ownership_committed : Int, cause : String } effects [concurrency]
	if operation == "resolve_tcp4"
		service_network_reply("ok", "", byte_chunk([]), list_cons({ network: "tcp4", address: subject }, list_nil()), 0, "", 0, "")
	else if operation == "listen"
		service_network_reply("ok", subject, byte_chunk([]), list_nil(), 0, "", 0, "")
	else if operation == "accept"
		begin
			let observed = trace_push(trace, "accept")
			if mode == "accept-failure" or trace_contains(observed, "accept")
				service_network_reply("error", "", byte_chunk([]), list_nil(), 0, "connection_reset", 0, "scripted accept failure")
			else
				service_network_reply("ok", "service-stream", byte_chunk([]), list_nil(), 0, "", 0, "")
			end
		end
	else if operation == "read"
		begin
			let observed = trace_push(trace, "read")
			if subject != "service-stream"
				service_network_reply("error", "", byte_chunk([]), list_nil(), 0, "connection_reset", 0, "service used the wrong stream")
			else if mode == "read-failure"
				service_network_reply("error", "", byte_chunk([]), list_nil(), 0, "connection_reset", 0, "scripted read failure")
			else if trace_contains(observed, "read")
				service_network_reply("end", "", byte_chunk([]), list_nil(), 0, "", 0, "")
			else
				service_network_reply("ok", "", request, list_nil(), 0, "", 0, "")
			end
		end
	else if operation == "write"
		begin
			let _ = trace_push(trace, "write")
			if subject != "service-stream"
				service_network_reply("error", "", byte_chunk([]), list_nil(), 0, "connection_reset", 0, "service used the wrong stream")
			else if mode == "write-failure"
				service_network_reply("error", "", byte_chunk([]), list_nil(), 0, "connection_reset", 0, "scripted write failure")
			else
				service_network_reply("ok", "", byte_chunk([]), list_nil(), byte_count_to_int(byte_chunk_count(bytes)), "", 0, "")
			end
		end
	else if operation == "close_stream"
		begin
			let _ = trace_push(trace, "close-stream")
			if mode == "success-close-failure" or mode == "callback-close-failure" or mode == "protocol-close-failure" or mode == "join-close-failure" or mode == "both-close-failure"
				service_network_reply("error", "", byte_chunk([]), list_nil(), 0, "connection_reset", 1, "scripted stream close failure")
			else
				service_network_reply("ok", "", byte_chunk([]), list_nil(), 0, "", 0, "")
			end
		end
	else if operation == "close_listener"
		begin
			let _ = trace_push(trace, "close-listener")
			if mode == "callback-listener-failure" or mode == "protocol-listener-failure" or mode == "join-listener-failure" or mode == "both-close-failure"
				service_network_reply("error", "", byte_chunk([]), list_nil(), 0, "connection_reset", 1, "scripted listener close failure")
			else
				service_network_reply("ok", "", byte_chunk([]), list_nil(), 0, "", 0, "")
			end
		end
	else
		service_network_reply("error", "", byte_chunk([]), list_nil(), 0, "connection_reset", 0, "unexpected network operation")
	end
end

fn service_network_reply(status: String, value: String, bytes: ByteChunk, resolved_endpoints: List<{ network : String, address : String }>, bytes_committed: Int, category: String, ownership_committed: Int, cause: String) -> { status : String, value : String, local : String, peer : String, bytes : ByteChunk, resolved_endpoints : List<{ network : String, address : String }>, bytes_committed : Int, category : String, phase : String, input_committed : Int, output_committed : Int, ownership_committed : Int, cause : String }
	{ status: status, value: value, local: "192.0.2.11:50000", peer: "192.0.2.10:443", bytes: bytes, resolved_endpoints: resolved_endpoints, bytes_committed: bytes_committed, category: category, phase: "during_operation", input_committed: 0, output_committed: if status == "error" bytes_committed else 0 end, ownership_committed: ownership_committed, cause: cause }
end

fn later_connection_network_reply(mode: String, request: ByteChunk, trace: { tx : Sender<List<String>>, rx : Receiver<List<String>> }, operation: String, subject: String, bytes: ByteChunk) -> { status : String, value : String, local : String, peer : String, bytes : ByteChunk, resolved_endpoints : List<{ network : String, address : String }>, bytes_committed : Int, category : String, phase : String, input_committed : Int, output_committed : Int, ownership_committed : Int, cause : String } effects [concurrency]
	if operation == "resolve_tcp4"
		service_network_reply("ok", "", byte_chunk([]), list_cons({ network: "tcp4", address: subject }, list_nil()), 0, "", 0, "")
	else if operation == "listen"
		service_network_reply("ok", subject, byte_chunk([]), list_nil(), 0, "", 0, "")
	else if operation == "accept"
		begin
			let observed: List<String> = option_unwrap_or(channel::recv(trace.rx), list_nil())
			if not trace_contains(observed, "accept-first")
				begin
					let _ = channel::send(trace.tx, list_cons("accept-first", observed))
					service_network_reply("ok", "later-service-stream-first", byte_chunk([]), list_nil(), 0, "", 0, "")
				end
			else if not trace_contains(observed, "accept-second")
				begin
					let _ = channel::send(trace.tx, list_cons("accept-second", observed))
					service_network_reply("ok", "later-service-stream-second", byte_chunk([]), list_nil(), 0, "", 0, "")
				end
			else
				begin
					let _ = channel::send(trace.tx, list_cons("accept-extra", observed))
					service_network_reply("error", "", byte_chunk([]), list_nil(), 0, "connection_reset", 0, "service accepted after the planned failure")
				end
			end
		end
	else if operation == "read"
		begin
			let trace_operation = if subject == "later-service-stream-first" "read-first" else "read-second" end
			let observed = trace_push(trace, trace_operation)
			if subject == "later-service-stream-second" and (mode == "later-read-failure" or mode == "later-all-failure")
				service_network_reply("error", "", byte_chunk([]), list_nil(), 0, "connection_reset", 0, "scripted later read failure")
			else if trace_contains(observed, trace_operation)
				service_network_reply("end", "", byte_chunk([]), list_nil(), 0, "", 0, "")
			else
				service_network_reply("ok", "", request, list_nil(), 0, "", 0, "")
			end
		end
	else if operation == "write"
		begin
			let trace_operation = if subject == "later-service-stream-first" "write-first" else "write-second" end
			let _ = trace_push(trace, trace_operation)
			if subject == "later-service-stream-second" and mode == "later-write-failure"
				service_network_reply("error", "", byte_chunk([]), list_nil(), 0, "connection_reset", 0, "scripted later write failure")
			else
				service_network_reply("ok", "", byte_chunk([]), list_nil(), byte_count_to_int(byte_chunk_count(bytes)), "", 0, "")
			end
		end
	else if operation == "close_stream"
		begin
			let trace_operation = if subject == "later-service-stream-first" "close-first" else "close-second" end
			let _ = trace_push(trace, trace_operation)
			if subject == "later-service-stream-second" and (mode == "later-close-failure" or mode == "later-all-failure")
				service_network_reply("error", "", byte_chunk([]), list_nil(), 0, "connection_reset", 1, "scripted later stream close failure")
			else
				service_network_reply("ok", "", byte_chunk([]), list_nil(), 0, "", 0, "")
			end
		end
	else if operation == "close_listener"
		begin
			let _ = trace_push(trace, "close-listener")
			if mode == "later-all-failure"
				service_network_reply("error", "", byte_chunk([]), list_nil(), 0, "connection_reset", 1, "scripted later listener close failure")
			else
				service_network_reply("ok", "", byte_chunk([]), list_nil(), 0, "", 0, "")
			end
		end
	else
		service_network_reply("error", "", byte_chunk([]), list_nil(), 0, "connection_reset", 0, "unexpected network operation")
	end
end

fn many_connections_network_reply(limit: Int, request: ByteChunk, accepted: { tx : Sender<Int>, rx : Receiver<Int> }, read_ready: { tx : Sender<Bool>, rx : Receiver<Bool> }, stream_closes: { tx : Sender<Int>, rx : Receiver<Int> }, listener_closes: { tx : Sender<Int>, rx : Receiver<Int> }, operation: String, subject: String, bytes: ByteChunk) -> { status : String, value : String, local : String, peer : String, bytes : ByteChunk, resolved_endpoints : List<{ network : String, address : String }>, bytes_committed : Int, category : String, phase : String, input_committed : Int, output_committed : Int, ownership_committed : Int, cause : String } effects [concurrency]
	if operation == "resolve_tcp4"
		service_network_reply("ok", "", byte_chunk([]), list_cons({ network: "tcp4", address: subject }, list_nil()), 0, "", 0, "")
	else if operation == "listen"
		service_network_reply("ok", subject, byte_chunk([]), list_nil(), 0, "", 0, "")
	else if operation == "accept"
		begin
			let observed = option_unwrap_or(channel::recv(accepted.rx), 0)
			if observed == limit
				begin
					let _ = channel::send(accepted.tx, observed)
					service_network_reply("error", "", byte_chunk([]), list_nil(), 0, "connection_reset", 0, "scripted accept failure")
				end
			else
				begin
					let _ = channel::recv(read_ready.rx)
					let _ = channel::send(read_ready.tx, true)
					let _ = channel::send(accepted.tx, observed + 1)
					service_network_reply("ok", "many-service-stream", byte_chunk([]), list_nil(), 0, "", 0, "")
				end
			end
		end
	else if operation == "read"
		begin
			let ready = option_unwrap_or(channel::recv(read_ready.rx), false)
			let _ = channel::send(read_ready.tx, false)
			if ready service_network_reply("ok", "", request, list_nil(), 0, "", 0, "") else service_network_reply("end", "", byte_chunk([]), list_nil(), 0, "", 0, "") end
		end
	else if operation == "write"
		service_network_reply("ok", "", byte_chunk([]), list_nil(), byte_count_to_int(byte_chunk_count(bytes)), "", 0, "")
	else if operation == "close_stream"
		begin
			let _ = integer_counter_increment(stream_closes)
			service_network_reply("ok", "", byte_chunk([]), list_nil(), 0, "", 0, "")
		end
	else if operation == "close_listener"
		begin
			let _ = integer_counter_increment(listener_closes)
			service_network_reply("ok", "", byte_chunk([]), list_nil(), 0, "", 0, "")
		end
	else
		service_network_reply("error", "", byte_chunk([]), list_nil(), 0, "connection_reset", 0, "unexpected network operation")
	end
end

fn same_listener(actual: net::Listener, expected: net::Listener) -> Bool
	actual == expected
end

fn same_stream(actual: net::Stream, expected: net::Stream) -> Bool
	actual == expected
end

pub handler scripted_io(expected_listener: net::Listener, expected_stream: net::Stream, mode: String, request: ByteChunk, trace: { tx : Sender<List<String>>, rx : Receiver<List<String>> }) for net::IO effects [concurrency]
	resolve(address) => unexpected_endpoints(trace, "resolve")
	listen(address) => unexpected_listener(trace, "listen")
	connect(address, deadline, token) => unexpected_stream(trace, "connect")
	accept(listener, deadline, token) => scripted_accept(listener, expected_listener, expected_stream, mode, trace)
	listener_address(listener) => unexpected_endpoint(trace, "listener-address")
	close_listener(listener) => scripted_close_listener(listener, expected_listener, mode, trace)
	read(stream, deadline, token) => scripted_read(stream, expected_stream, mode, request, trace)
	write(stream, bytes, deadline, token) => scripted_write(stream, expected_stream, mode, bytes, trace)
	local_address(stream) => unexpected_endpoint(trace, "local-address")
	peer_address(stream) => unexpected_endpoint(trace, "peer-address")
	shutdown_read(stream) => unexpected_unit(trace, "shutdown-read")
	shutdown_write(stream) => unexpected_unit(trace, "shutdown-write")
	close_stream(stream) => scripted_close_stream(stream, expected_stream, mode, trace)
end

pub handler many_successful_connections(expected_listener: net::Listener, expected_stream: net::Stream, limit: Int, request: ByteChunk, accepted: { tx : Sender<Int>, rx : Receiver<Int> }, read_ready: { tx : Sender<Bool>, rx : Receiver<Bool> }, stream_closes: { tx : Sender<Int>, rx : Receiver<Int> }, listener_closes: { tx : Sender<Int>, rx : Receiver<Int> }) for net::IO effects [concurrency]
	resolve(address) => unexpected_endpoints_without_trace("resolve")
	listen(address) => unexpected_listener_without_trace("listen")
	connect(address, deadline, token) => unexpected_stream_without_trace("connect")
	accept(listener, deadline, token) => many_connections_accept(listener, expected_listener, expected_stream, limit, accepted, read_ready)
	listener_address(listener) => unexpected_endpoint_without_trace("listener-address")
	close_listener(listener) => many_connections_close_listener(listener, expected_listener, listener_closes)
	read(stream, deadline, token) => many_connections_read(stream, expected_stream, request, read_ready)
	write(stream, bytes, deadline, token) => many_connections_write(stream, expected_stream, bytes)
	local_address(stream) => unexpected_endpoint_without_trace("local-address")
	peer_address(stream) => unexpected_endpoint_without_trace("peer-address")
	shutdown_read(stream) => unexpected_unit_without_trace("shutdown-read")
	shutdown_write(stream) => unexpected_unit_without_trace("shutdown-write")
	close_stream(stream) => many_connections_close_stream(stream, expected_stream, stream_closes)
end

pub handler later_connection_failure(expected_listener: net::Listener, first_stream: net::Stream, second_stream: net::Stream, mode: String, request: ByteChunk, trace: { tx : Sender<List<String>>, rx : Receiver<List<String>> }) for net::IO effects [concurrency]
	resolve(address) => unexpected_endpoints(trace, "resolve")
	listen(address) => unexpected_listener(trace, "listen")
	connect(address, deadline, token) => unexpected_stream(trace, "connect")
	accept(listener, deadline, token) => later_connection_accept(listener, expected_listener, first_stream, second_stream, trace)
	listener_address(listener) => unexpected_endpoint(trace, "listener-address")
	close_listener(listener) => later_connection_close_listener(listener, expected_listener, mode, trace)
	read(stream, deadline, token) => later_connection_read(stream, first_stream, second_stream, mode, request, trace)
	write(stream, bytes, deadline, token) => later_connection_write(stream, first_stream, second_stream, mode, bytes, trace)
	local_address(stream) => unexpected_endpoint(trace, "local-address")
	peer_address(stream) => unexpected_endpoint(trace, "peer-address")
	shutdown_read(stream) => unexpected_unit(trace, "shutdown-read")
	shutdown_write(stream) => unexpected_unit(trace, "shutdown-write")
	close_stream(stream) => later_connection_close_stream(stream, first_stream, second_stream, mode, trace)
end

fn later_connection_accept(listener: net::Listener, expected_listener: net::Listener, first_stream: net::Stream, second_stream: net::Stream, trace: { tx : Sender<List<String>>, rx : Receiver<List<String>> }) -> Result<net::Stream, net::NetError> effects [concurrency]
	let observed: List<String> = option_unwrap_or(channel::recv(trace.rx), list_nil())
	if not same_listener(listener, expected_listener)
		begin
			let _ = channel::send(trace.tx, list_cons("accept-wrong-listener", observed))
			Err(failure("accept", "service used the wrong listener"))
		end
	else if not trace_contains(observed, "accept-first")
		begin
			let _ = channel::send(trace.tx, list_cons("accept-first", observed))
			Ok(first_stream)
		end
	else if not trace_contains(observed, "accept-second")
		begin
			let _ = channel::send(trace.tx, list_cons("accept-second", observed))
			Ok(second_stream)
		end
	else
		begin
			let _ = channel::send(trace.tx, list_cons("accept-extra", observed))
			Err(failure("accept", "service accepted after the planned failure"))
		end
	end
end

fn later_connection_read(stream: net::Stream, first_stream: net::Stream, second_stream: net::Stream, mode: String, request: ByteChunk, trace: { tx : Sender<List<String>>, rx : Receiver<List<String>> }) -> Result<net::ReadOutcome, net::NetError> effects [concurrency]
	if same_stream(stream, first_stream)
		later_stream_read("read-first", false, request, trace)
	else if same_stream(stream, second_stream)
		later_stream_read("read-second", mode == "later-read-failure" or mode == "later-all-failure", request, trace)
	else
		Err(failure("read", "service used an unknown stream"))
	end
end

fn later_stream_read(operation: String, fails: Bool, request: ByteChunk, trace: { tx : Sender<List<String>>, rx : Receiver<List<String>> }) -> Result<net::ReadOutcome, net::NetError> effects [concurrency]
	let observed = trace_push(trace, operation)
	if fails
		Err(failure("read", "scripted later read failure"))
	else if trace_contains(observed, operation)
		Ok(net::ReadEnd)
	else
		Ok(net::ReadChunk(request))
	end
end

fn later_connection_write(stream: net::Stream, first_stream: net::Stream, second_stream: net::Stream, mode: String, bytes: ByteChunk, trace: { tx : Sender<List<String>>, rx : Receiver<List<String>> }) -> net::WriteOutcome effects [concurrency]
	if same_stream(stream, first_stream)
		later_stream_write("write-first", false, bytes, trace)
	else if same_stream(stream, second_stream)
		later_stream_write("write-second", mode == "later-write-failure", bytes, trace)
	else
		net::WriteFailed(net::ByteCount(0), failure("write", "service used an unknown stream"))
	end
end

fn later_stream_write(operation: String, fails: Bool, bytes: ByteChunk, trace: { tx : Sender<List<String>>, rx : Receiver<List<String>> }) -> net::WriteOutcome effects [concurrency]
	let _ = trace_push(trace, operation)
	if fails
		net::WriteFailed(net::ByteCount(0), failure("write", "scripted later write failure"))
	else
		net::Written(byte_chunk_count(bytes))
	end
end

fn later_connection_close_stream(stream: net::Stream, first_stream: net::Stream, second_stream: net::Stream, mode: String, trace: { tx : Sender<List<String>>, rx : Receiver<List<String>> }) -> Result<(), net::NetError> effects [concurrency]
	if same_stream(stream, first_stream)
		begin
			let _ = trace_push(trace, "close-first")
			Ok(())
		end
	else if same_stream(stream, second_stream)
		begin
			let _ = trace_push(trace, "close-second")
			if mode == "later-close-failure" or mode == "later-all-failure"
				Err(failure("close_stream", "scripted later stream close failure"))
			else
				Ok(())
			end
		end
	else
		Err(failure("close_stream", "service used an unknown stream"))
	end
end

fn later_connection_close_listener(listener: net::Listener, expected_listener: net::Listener, mode: String, trace: { tx : Sender<List<String>>, rx : Receiver<List<String>> }) -> Result<(), net::NetError> effects [concurrency]
	let _ = trace_push(trace, "close-listener")
	if not same_listener(listener, expected_listener)
		Err(failure("close_listener", "service used the wrong listener"))
	else if mode == "later-all-failure"
		Err(failure("close_listener", "scripted later listener close failure"))
	else
		Ok(())
	end
end

fn integer_counter_increment(counter: { tx : Sender<Int>, rx : Receiver<Int> }) -> Int effects [concurrency]
	let observed = option_unwrap_or(channel::recv(counter.rx), 0)
	let next = observed + 1
	let _ = channel::send(counter.tx, next)
	next
end

fn many_connections_accept(listener: net::Listener, expected_listener: net::Listener, stream: net::Stream, limit: Int, accepted: { tx : Sender<Int>, rx : Receiver<Int> }, read_ready: { tx : Sender<Bool>, rx : Receiver<Bool> }) -> Result<net::Stream, net::NetError> effects [concurrency]
	let observed = option_unwrap_or(channel::recv(accepted.rx), 0)
	if not same_listener(listener, expected_listener)
		begin
			let _ = channel::send(accepted.tx, observed)
			Err(failure("accept", "service used the wrong listener"))
		end
	else if observed == limit
		begin
			let _ = channel::send(accepted.tx, observed)
			Err(failure("accept", "scripted accept failure"))
		end
	else
		begin
			let _ = channel::recv(read_ready.rx)
			let _ = channel::send(read_ready.tx, true)
			let _ = channel::send(accepted.tx, observed + 1)
			Ok(stream)
		end
	end
end

fn many_connections_read(stream: net::Stream, expected_stream: net::Stream, request: ByteChunk, read_ready: { tx : Sender<Bool>, rx : Receiver<Bool> }) -> Result<net::ReadOutcome, net::NetError> effects [concurrency]
	let ready = option_unwrap_or(channel::recv(read_ready.rx), false)
	let _ = channel::send(read_ready.tx, false)
	if not same_stream(stream, expected_stream)
		Err(failure("read", "service used the wrong stream"))
	else if ready
		Ok(net::ReadChunk(request))
	else
		Ok(net::ReadEnd)
	end
end

fn many_connections_write(stream: net::Stream, expected_stream: net::Stream, bytes: ByteChunk) -> net::WriteOutcome
	if same_stream(stream, expected_stream)
		net::Written(byte_chunk_count(bytes))
	else
		net::WriteFailed(net::ByteCount(0), failure("write", "service used the wrong stream"))
	end
end

fn many_connections_close_stream(stream: net::Stream, expected_stream: net::Stream, closes: { tx : Sender<Int>, rx : Receiver<Int> }) -> Result<(), net::NetError> effects [concurrency]
	if same_stream(stream, expected_stream)
		begin
			let _ = integer_counter_increment(closes)
			Ok(())
		end
	else
		Err(failure("close_stream", "service used the wrong stream"))
	end
end

fn many_connections_close_listener(listener: net::Listener, expected_listener: net::Listener, closes: { tx : Sender<Int>, rx : Receiver<Int> }) -> Result<(), net::NetError> effects [concurrency]
	if same_listener(listener, expected_listener)
		begin
			let _ = integer_counter_increment(closes)
			Ok(())
		end
	else
		Err(failure("close_listener", "service used the wrong listener"))
	end
end

fn unexpected_endpoints_without_trace(operation: String) -> Result<List<net::Endpoint>, net::NetError>
	Err(failure(operation, "unexpected network operation"))
end

fn unexpected_listener_without_trace(operation: String) -> Result<net::Listener, net::NetError>
	Err(failure(operation, "unexpected network operation"))
end

fn unexpected_stream_without_trace(operation: String) -> Result<net::Stream, net::NetError>
	Err(failure(operation, "unexpected network operation"))
end

fn unexpected_endpoint_without_trace(operation: String) -> Result<net::Endpoint, net::NetError>
	Err(failure(operation, "unexpected network operation"))
end

fn unexpected_unit_without_trace(operation: String) -> Result<(), net::NetError>
	Err(failure(operation, "unexpected network operation"))
end

fn scripted_accept(listener: net::Listener, expected_listener: net::Listener, stream: net::Stream, mode: String, trace: { tx : Sender<List<String>>, rx : Receiver<List<String>> }) -> Result<net::Stream, net::NetError> effects [concurrency]
	let observed = trace_push(trace, "accept")
	if not same_listener(listener, expected_listener)
		Err(failure("accept", "service used the wrong listener"))
	else if mode == "accept-failure" or trace_contains(observed, "accept")
		Err(failure("accept", "scripted accept failure"))
	else
		Ok(stream)
	end
end

fn scripted_read(stream: net::Stream, expected_stream: net::Stream, mode: String, request: ByteChunk, trace: { tx : Sender<List<String>>, rx : Receiver<List<String>> }) -> Result<net::ReadOutcome, net::NetError> effects [concurrency]
	let observed = trace_push(trace, "read")
	if not same_stream(stream, expected_stream)
		Err(failure("read", "service used the wrong stream"))
	else if mode == "read-failure"
		Err(failure("read", "scripted read failure"))
	else if trace_contains(observed, "read")
		Ok(net::ReadEnd)
	else
		Ok(net::ReadChunk(request))
	end
end

fn scripted_write(stream: net::Stream, expected_stream: net::Stream, mode: String, bytes: ByteChunk, trace: { tx : Sender<List<String>>, rx : Receiver<List<String>> }) -> net::WriteOutcome effects [concurrency]
	let _ = trace_push(trace, "write")
	if not same_stream(stream, expected_stream)
		net::WriteFailed(net::ByteCount(0), failure("write", "service used the wrong stream"))
	else if mode == "write-failure"
		net::WriteFailed(net::ByteCount(0), failure("write", "scripted write failure"))
	else
		net::Written(byte_chunk_count(bytes))
	end
end

fn scripted_close_stream(stream: net::Stream, expected_stream: net::Stream, mode: String, trace: { tx : Sender<List<String>>, rx : Receiver<List<String>> }) -> Result<(), net::NetError> effects [concurrency]
	let _ = trace_push(trace, "close-stream")
	if not same_stream(stream, expected_stream)
		Err(failure("close_stream", "service used the wrong stream"))
	else if stream_close_fails(mode)
		Err(failure("close_stream", "scripted stream close failure"))
	else
		Ok(())
	end
end

fn stream_close_fails(mode: String) -> Bool
	mode == "success-close-failure" or mode == "callback-close-failure" or mode == "protocol-close-failure" or mode == "join-close-failure" or mode == "both-close-failure"
end

fn scripted_close_listener(listener: net::Listener, expected_listener: net::Listener, mode: String, trace: { tx : Sender<List<String>>, rx : Receiver<List<String>> }) -> Result<(), net::NetError> effects [concurrency]
	let _ = trace_push(trace, "close-listener")
	if not same_listener(listener, expected_listener)
		Err(failure("close_listener", "service used the wrong listener"))
	else if listener_close_fails(mode)
		Err(failure("close_listener", "scripted listener close failure"))
	else
		Ok(())
	end
end

fn listener_close_fails(mode: String) -> Bool
	mode == "callback-listener-failure" or mode == "protocol-listener-failure" or mode == "join-listener-failure" or mode == "both-close-failure"
end

fn unexpected_endpoints(trace: { tx : Sender<List<String>>, rx : Receiver<List<String>> }, operation: String) -> Result<List<net::Endpoint>, net::NetError> effects [concurrency]
	let _ = trace_push(trace, operation)
	Err(failure(operation, "unexpected network operation"))
end

