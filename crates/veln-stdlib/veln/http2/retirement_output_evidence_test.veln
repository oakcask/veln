use prelude
use http2::core

fn byte_at(chunk: ByteChunk, index: Int) -> Result<Int, String>
	byte_read_u8_be(byte_view(chunk, byte_offset(index)?, byte_count(1)?)?)
end

fn chunks_equal_at(left: ByteChunk, right: ByteChunk, index: Int, count: Int) -> Result<Bool, String>
	if index == count
		Ok(true)
	else if byte_at(left, index)? == byte_at(right, index)?
		chunks_equal_at(left, right, index + 1, count)
	else
		Ok(false)
	end
end

fn chunks_equal(left: ByteChunk, right: ByteChunk) -> Result<Bool, String>
	let count: Int = byte_count_to_int(byte_chunk_count(left))
	if count == byte_count_to_int(byte_chunk_count(right))
		chunks_equal_at(left, right, 0, count)
	else
		Ok(false)
	end
end

fn require_stream_entry(result: Result<CoreStreamEntry, FlowControlDomainFailure>) -> Result<CoreStreamEntry, String>
	match result
		Ok(entry) => Ok(entry)
		Err(failure) => Err(http2::core::flow_control_failure_domain(failure))
	end
end

fn assert_retired_output_table(name: String, expected: ByteChunk) -> Result<(), String>
	let entry: CoreStreamEntry = require_stream_entry(http2::core::stream_entry(1, http2::core::stream_open_lifecycle(), 16777215, 16777215, 0 - 1, 0))?
	let state: CoreConnectionState = http2::core::connection_state_with_streams(http2::core::server_connection_state(0)?, http2::core::stream_collection_add_or_replace(http2::core::empty_stream_collection(), entry))
	let decision: CoreDataSendDecision = http2::core::send_data(state, 0, 1, expected, false)
	let output: CoreOutputBuffer = http2::core::output_buffer_append_data(http2::core::empty_output_buffer(), decision)
	match http2::core::output_buffer_chunk_at(output, 0)
		Some(emitted) => validate_retired_emitted_output(name, expected, decision, output, emitted)
		None => Err(name)
	end
end

fn validate_retired_emitted_output(name: String, expected: ByteChunk, decision: CoreDataSendDecision, output: CoreOutputBuffer, emitted: ByteChunk) -> Result<(), String>
	let payload: ByteChunk = byte_view_to_chunk(byte_view(emitted, byte_offset(9)?, byte_chunk_count(expected))?)
	if http2::core::data_send_status(decision) == "accepted" and http2::core::output_buffer_count(output) == 1 and chunks_equal(payload, expected)? and chunks_equal(http2::core::output_buffer_bytes(output), emitted)?
		Ok(())
	else
		Err(name)
	end
end

fn assert_retired_empty_output_table(name: String) -> Result<(), String>
	let entry: CoreStreamEntry = require_stream_entry(http2::core::stream_entry(1, http2::core::stream_open_lifecycle(), 1, 0, 0 - 1, 0))?
	let state: CoreConnectionState = http2::core::connection_state_with_streams(http2::core::server_connection_state(0)?, http2::core::stream_collection_add_or_replace(http2::core::empty_stream_collection(), entry))
	let decision: CoreDataSendDecision = http2::core::send_data(state, 0, 1, byte_chunk_from_hex("00")?, false)
	let output: CoreOutputBuffer = http2::core::output_buffer_append_data(http2::core::empty_output_buffer(), decision)
	if http2::core::data_send_status(decision) == "rejected" and byte_count_to_int(byte_chunk_count(http2::core::data_send_bytes(decision))) == 0 and http2::core::output_buffer_count(output) == 0
		Ok(())
	else
		Err(name)
	end
end

test retirement_output_connection_framing() -> Result<(), String>
	let checked_1: () = assert_retired_output_table("http2-peer-header-table-size-lower-inbound-receive-limit", byte_chunk_from_hex("3f8101")?)?
	let checked_2: () = assert_retired_output_table("http2-half-closed-local-padded-content", byte_chunk_from_hex("aabbcc")?)?
	let checked_3: () = assert_retired_output_table("http2-content-length-padded", byte_chunk_from_hex("00000800090000000102aabbccddee0000")?)?
	let checked_4: () = assert_retired_empty_output_table("http2-content-length-over")?
	let checked_5: () = assert_retired_output_table("preface-unknown", byte_chunk_from_hex("aabbcc")?)?
	let checked_6: () = assert_retired_output_table("unknown-extension", byte_chunk_from_hex("aabbcc")?)?
	Ok(())
end

