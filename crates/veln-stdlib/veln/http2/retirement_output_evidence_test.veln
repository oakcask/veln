	let checked_34: () = assert_retired_output_table("http2-goaway-debug-data", byte_chunk_from_hex("00000c070000000000000000050000000baaff0080")?)?
	Ok(())
end

test retirement_output_stream_control() -> Result<(), String>
	let checked_1: () = assert_retired_empty_output_table("http2-content-length-early-end-stream", 0)?
	let checked_2: () = assert_retired_output_table("http2-rst-stream", byte_chunk_from_hex("00000403000000000100000008")?)?
	let checked_3: () = assert_retired_output_table("http2-priority", byte_chunk_from_hex("000005020000000001800000030f")?)?
	let checked_4: () = assert_retired_output_table("http2-priority-replacement-values", byte_chunk_from_hex("000005020000000001000000051f")?)?
	let checked_5: () = assert_retired_output_table("http2-max-stream-header", byte_chunk_from_hex("00000008007fffffff")?)?
	Ok(())
end
