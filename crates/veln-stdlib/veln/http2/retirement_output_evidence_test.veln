use prelude
use http2::core
use http2::frame
use http2::hpack

fn byte_at(chunk: ByteChunk, index: Int) -> Result<Int, String>
	byte_read_u8_be(byte_view(chunk, byte_offset(index)?, byte_count(1)?)?)
end

fn chunks_equal_at(left: ByteChunk, right: ByteChunk, index: Int, count: Int) -> Result<Bool, String>
	if index == count
		Ok(true)
	else if byte_at(left, index)? == byte_at(right, index)?
		chunks_equal_at(left, right, index + 1, count)
	else
		Ok(false)
	end
end

fn chunks_equal(left: ByteChunk, right: ByteChunk) -> Result<Bool, String>
	let count: Int = byte_count_to_int(byte_chunk_count(left))
	if count == byte_count_to_int(byte_chunk_count(right))
		chunks_equal_at(left, right, 0, count)
	else
		Ok(false)
	end
end

fn require_stream_entry(result: Result<CoreStreamEntry, FlowControlDomainFailure>) -> Result<CoreStreamEntry, String>
	match result
		Ok(entry) => Ok(entry)
		Err(failure) => Err(http2::core::flow_control_failure_domain(failure))
	end
end

fn require_connection_credit(value: Int) -> Result<CoreConnectionWindowCredit, String>
	match http2::core::connection_window_credit(value)
		Ok(credit) => Ok(credit)
		Err(failure) => Err(http2::core::flow_control_failure_domain(failure))
	end
end

fn request_headers() -> Result<HeaderList, String>
	Ok(http2::hpack::prepend_header_field(http2::hpack::header_field(":method", byte_chunk_from_hex("474554")?), http2::hpack::prepend_header_field(http2::hpack::header_field(":scheme", byte_chunk_from_hex("6874747073")?), http2::hpack::prepend_header_field(http2::hpack::header_field(":path", byte_chunk_from_hex("2f")?), http2::hpack::empty_header_list()))))
end

fn require_header_block_encode(result: Result<HeaderBlockEncodeTransition, HeaderBlockEncodeFailure>) -> Result<HeaderBlockEncodeTransition, String>
	match result
		Ok(transition) => Ok(transition)
		Err(failure) => Err(http2::hpack::header_block_encode_failure_kind(failure))
	end
end

fn validate_retired_nonempty_frame_sequence(name: String, remaining: ByteChunk) -> Result<(), String>
	let decoded: { length : Int, kind : Int, flags : Int, stream_id : Int, payload : ByteView } = http2::frame::decode(byte_view(remaining, byte_offset(0)?, byte_chunk_count(remaining))?)?
	let frame_count: Int = 9 + decoded.length
	let encoded: ByteChunk = byte_append(http2::frame::encode_header(decoded.length, decoded.kind, decoded.flags, decoded.stream_id)?, byte_view_to_chunk(decoded.payload))
	let retained: ByteChunk = byte_take(remaining, byte_count(frame_count)?)?
	if chunks_equal(encoded, retained)?
		validate_retired_frame_sequence(name, byte_drop(remaining, byte_count(frame_count)?)?)
	else
		Err(name)
	end
end

fn validate_retired_frame_sequence(name: String, remaining: ByteChunk) -> Result<(), String>
	if byte_count_to_int(byte_chunk_count(remaining)) == 0
		Ok(())
	else
		validate_retired_nonempty_frame_sequence(name, remaining)
	end
end

fn validate_retired_hpack_block(name: String, expected: ByteChunk) -> Result<(), String>
	let input: ByteView = byte_view(expected, byte_offset(0)?, byte_chunk_count(expected))?
	let table: DynamicTable = http2::hpack::empty_dynamic_table(4096)?
	match http2::hpack::decode_header_block(input, table, 4096)
		Ok(transition) => validate_retired_hpack_production_encode(name, expected, table, transition)
		Err(failure) => if http2::hpack::header_block_failure_kind(failure) == expected_retired_hpack_failure_kind(name, expected)? and http2::hpack::dynamic_table_entry_count(table) == 0 and http2::hpack::dynamic_table_capacity(table) == 4096
			Ok(())
		else
			Err(name)
		end
	end
end

fn validate_retired_hpack_production_encode(name: String, expected: ByteChunk, table: DynamicTable, decoded: HeaderBlockDecodeTransition) -> Result<(), String>
	let encoded: HeaderBlockEncodeTransition = require_header_block_encode(http2::hpack::encode_header_block(http2::hpack::header_block_headers(decoded), table, 4096))?
	let encoded_input: ByteChunk = http2::hpack::header_block_encode_bytes(encoded)
	if http2::hpack::header_block_consumed(decoded) == byte_count_to_int(byte_chunk_count(expected)) and byte_count_to_int(byte_chunk_count(encoded_input)) >= 0 and http2::hpack::dynamic_table_entry_count(table) == 0
		Ok(())
	else
		Err(name)
	end
end

fn expected_retired_hpack_failure_kind(name: String, expected: ByteChunk) -> Result<String, String>
	let first: Int = byte_at(expected, 0)?
	if first >= 128
		Ok("indexed_failure")
	else if first >= 64
		Ok("literal_failure")
	else if first >= 32
		Ok("table_size_update_failure")
	else if first >= 16
		Ok("literal_failure")
	else
		Ok("literal_failure")
	end
end

fn assert_retired_hpack_long_length_output_table(name: String, expected: ByteChunk) -> Result<(), String>
	let encoded_length: ByteChunk = byte_drop(expected, byte_count(1)?)?
	let input: ByteView = byte_view(encoded_length, byte_offset(0)?, byte_chunk_count(encoded_length))?
	let decoded: { value : Int, consumed : Int } = http2::hpack::decode_integer(input, 7)?
	if http2::hpack::decoded_integer_value(decoded) == 128 and http2::hpack::decoded_integer_consumed(decoded) == 2 and chunks_equal(byte_view_to_chunk(input), encoded_length)?
		Ok(())
	else
		Err(name)
	end
end

fn assert_retired_output_table(name: String, expected: ByteChunk) -> Result<(), String>
	match validate_retired_frame_sequence(name, expected)
		Ok(()) => Ok(())
		Err(_) => validate_retired_hpack_block(name, expected)
	end
end

fn assert_retired_zero_length_headers_output(name: String) -> Result<(), String>
	let state: CoreConnectionState = http2::core::connection_state_with_lifecycle(http2::core::client_connection_state(0)?, http2::core::connection_lifecycle_draining(0, 0))
	let headers: HeaderList = http2::hpack::prepend_header_field(http2::hpack::header_field(":method", byte_chunk_from_hex("474554")?), http2::hpack::prepend_header_field(http2::hpack::header_field(":scheme", byte_chunk_from_hex("6874747073")?), http2::hpack::prepend_header_field(http2::hpack::header_field(":path", byte_chunk_from_hex("2f")?), http2::hpack::empty_header_list())))
	let decision: CoreHeadersSendDecision = http2::core::send_request_headers(state, 0, 1, headers, false)
	let output: CoreOutputBuffer = http2::core::output_buffer_append_headers(http2::core::empty_output_buffer(), decision)
	if http2::core::headers_send_status(decision) == "rejected" and byte_count_to_int(byte_chunk_count(http2::core::headers_send_bytes(decision))) == 0 and http2::core::output_buffer_count(output) == 0
		Ok(())
	else
		Err(name)
	end
end

fn assert_retired_zero_length_window_update_output(name: String) -> Result<(), String>
	let state: CoreConnectionState = http2::core::connection_state_with_lifecycle(http2::core::client_connection_state(0)?, http2::core::connection_lifecycle_draining(0, 0))
	let decision: CoreWindowUpdateSendDecision = http2::core::send_window_update(state, 0, 1, 1)
	let output: CoreOutputBuffer = http2::core::output_buffer_append_window_update(http2::core::empty_output_buffer(), decision)
	if http2::core::window_update_send_status(decision) == "rejected" and byte_count_to_int(byte_chunk_count(http2::core::window_update_send_bytes(decision))) == 0 and http2::core::output_buffer_count(output) == 0
		Ok(())
	else
		Err(name)
	end
end

fn assert_retired_zero_length_output_table(name: String) -> Result<(), String>
	if name == "http2-headers-after-narrow-local-goaway-late"
		assert_retired_zero_length_headers_output(name)
	else
		assert_retired_zero_length_window_update_output(name)
	end
end

fn assert_retired_empty_data_output_table(name: String) -> Result<(), String>
	let entry: CoreStreamEntry = require_stream_entry(http2::core::stream_entry(1, http2::core::stream_open_lifecycle(), 1, 0, 0 - 1, 0))?
	let state: CoreConnectionState = http2::core::connection_state_with_streams(http2::core::server_connection_state(0)?, http2::core::stream_collection_add_or_replace(http2::core::empty_stream_collection(), entry))
	let decision: CoreDataSendDecision = http2::core::send_data(state, 0, 1, byte_chunk_from_hex("00")?, false)
	let output: CoreOutputBuffer = http2::core::output_buffer_append_data(http2::core::empty_output_buffer(), decision)
	match http2::core::data_send_failure(decision)
		Ok(failure) => if expected_retired_empty_data_family(name)? != "" and http2::core::outbound_data_flow_failure_id(failure) != "" and http2::core::data_send_status(decision) == "rejected" and byte_count_to_int(byte_chunk_count(http2::core::data_send_bytes(decision))) == 0 and http2::core::output_buffer_count(output) == 0
			Ok(())
		else
			Err(name)
		end
		Err(_) => Err(name)
	end
end

fn assert_retired_empty_headers_output_table(name: String) -> Result<(), String>
	let state: CoreConnectionState = http2::core::connection_state_with_lifecycle(http2::core::client_connection_state(0)?, http2::core::connection_lifecycle_draining(0, 0))
	let decision: CoreHeadersSendDecision = http2::core::send_request_headers(state, 0, 1, request_headers()?, false)
	let output: CoreOutputBuffer = http2::core::output_buffer_append_headers(http2::core::empty_output_buffer(), decision)
	match http2::core::headers_send_failure(decision)
		Ok(failure) => if expected_retired_empty_headers_family(name)? != "" and http2::core::headers_send_status(decision) == "rejected" and http2::core::outbound_headers_failure_id(failure) == "http2.protocol.stream_after_goaway" and byte_count_to_int(byte_chunk_count(http2::core::headers_send_bytes(decision))) == 0 and http2::core::output_buffer_count(output) == 0
			Ok(())
		else
			Err(name)
		end
		Err(_) => Err(name)
	end
end

