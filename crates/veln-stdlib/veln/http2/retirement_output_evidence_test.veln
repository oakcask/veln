fn assert_retired_empty_goaway_output_table(name: String) -> Result<(), String>
	let closed: CoreConnectionState = http2::core::connection_state_with_lifecycle(http2::core::server_connection_state(0)?, http2::core::connection_lifecycle_closed(3, 0))
	let decision: CoreGoawaySendDecision = http2::core::send_goaway_shutdown(closed, 0, 5, 0, byte_chunk([]))
	let output: CoreOutputBuffer = http2::core::output_buffer_append_goaway(http2::core::empty_output_buffer(), decision)
	match http2::core::goaway_send_failure(decision)
		Ok(failure) => if expected_retired_empty_goaway_family(name)? != "" and http2::core::goaway_send_status(decision) == "rejected" and http2::core::goaway_send_failure_id(failure) == "http2.protocol.stream_after_goaway" and byte_count_to_int(byte_chunk_count(http2::core::goaway_send_bytes(decision))) == 0 and http2::core::output_buffer_count(output) == 0
			Ok(())
		else
			Err(name)
		end
		Err(_) => Err(name)
	end
end

fn assert_retired_empty_ping_output_table(name: String) -> Result<(), String>
	let decision: PingRequestDecision = http2::core::send_ping(retired_empty_ping_payload(name)?)
	let output: CoreOutputBuffer = http2::core::output_buffer_append_ping_request(http2::core::empty_output_buffer(), decision)
	match http2::core::ping_request_failure(decision)
		Ok(failure) => if expected_retired_empty_ping_family(name)? != "" and http2::core::frame_payload_length_failure_active_state(failure) != "" and http2::core::ping_request_status(decision) == "rejected" and byte_count_to_int(byte_chunk_count(http2::core::ping_request_bytes(decision))) == 0 and http2::core::output_buffer_count(output) == 0
			Ok(())
		else
			Err(name)
		end
		Err(_) => Err(name)
	end
end

fn assert_retired_empty_settings_output_table(name: String) -> Result<(), String>
	let no_pending: PeerSettingsAckSendDecision = http2::core::send_pending_settings_ack(http2::core::empty_settings_ack_state())
	let no_pending_output: CoreOutputBuffer = http2::core::output_buffer_append_pending_settings_ack(http2::core::empty_output_buffer(), no_pending)
	match http2::core::send_local_setting(retired_empty_settings_item(name), "server", http2::core::empty_local_settings_policy(), http2::core::empty_settings_ack_state())
		Ok(local_failure) => if http2::core::local_settings_send_status(local_failure) == "rejected" and byte_count_to_int(byte_chunk_count(http2::core::local_settings_send_bytes(local_failure))) == 0 and http2::core::pending_settings_ack_send_status(no_pending) == "no_pending" and byte_count_to_int(byte_chunk_count(http2::core::pending_settings_ack_send_bytes(no_pending))) == 0 and http2::core::output_buffer_count(no_pending_output) == 0
			Ok(())
		else
			Err(name)
		end
		Err(_) => Err(name)
	end
end

fn expected_retired_empty_data_family(name: String) -> Result<String, String>
	if name == "http2-content-length-over" or name == "http2-content-length-early-end-stream"
		Ok("content-length")
	else if name == "http2-data-padded-connection-window" or name == "http2-data-padded-frame-size" or name == "http2-data-connection-zero" or name == "http2-data-stream-zero" or name == "http2-data-connection-refill-before" or name == "http2-data-stream-refill-before" or name == "http2-data-after-local-window-update-no-refill" or name == "http2-data-after-initial-window-reduce" or name == "http2-data-after-goaway-late" or name == "http2-data-after-local-goaway-late" or name == "http2-data-after-narrow-local-goaway-late"
		Ok("no-output-data")
	else
		Err(name)
	end
end

