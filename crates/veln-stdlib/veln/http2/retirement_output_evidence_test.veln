fn retired_empty_ping_payload(name: String) -> Result<ByteChunk, String>
	if name == "http2-outbound-ping-long"
		Ok(byte_chunk_from_hex("010203040506070809")?)
	else
		Ok(byte_chunk_from_hex("0102")?)
	end
end

fn retired_empty_settings_item(name: String) -> LocalSettingsItem
	if name == "http2-local-enable-push-settings-range"
		http2::core::local_settings_enable_push(2)
	else if name == "http2-local-initial-window-size-settings-range"
		http2::core::local_settings_initial_window_size(2147483648)
	else if name == "http2-local-settings-max-frame-size-range" or name == "http2-local-settings-batch-max-frame-size-range"
		http2::core::local_settings_max_frame_size(1)
	else if name == "http2-local-max-concurrent-streams-settings-range" or name == "http2-local-settings-max-concurrent-streams-batch-range"
		http2::core::local_settings_max_concurrent_streams(4294967296)
	else if name == "http2-local-header-list-size-settings-range" or name == "http2-local-settings-max-header-list-size-batch-range"
		http2::core::local_settings_max_header_list_size(4294967296)
	else
		http2::core::local_settings_header_table_size(4294967296)
	end
end

fn assert_retired_empty_output_table(name: String, kind: Int) -> Result<(), String>
	if kind == 0
		assert_retired_empty_data_output_table(name)
	else if kind == 1
		assert_retired_empty_headers_output_table(name)
	else if kind == 2
		assert_retired_empty_priority_output_table(name)
	else if kind == 4
		assert_retired_empty_settings_output_table(name)
	else if kind == 5
		assert_retired_empty_push_promise_output_table(name)
	else if kind == 6
		assert_retired_empty_ping_output_table(name)
	else if kind == 7
		assert_retired_empty_goaway_output_table(name)
	else if kind == 8
		assert_retired_empty_window_update_output_table(name)
	else
		Err(name)
	end
end

test retirement_output_connection_framing() -> Result<(), String>
	let checked_1: () = assert_retired_output_table("http2-peer-header-table-size-lower-inbound-receive-limit", byte_chunk_from_hex("3f8101")?)?
	let checked_2: () = assert_retired_output_table("http2-half-closed-local-padded-content", byte_chunk_from_hex("aabbcc")?)?
	let checked_3: () = assert_retired_output_table("http2-content-length-padded", byte_chunk_from_hex("00000800090000000102aabbccddee0000")?)?
	let checked_4: () = assert_retired_empty_output_table("http2-content-length-over", 0)?
	let checked_5: () = assert_retired_output_table("preface-unknown", byte_chunk_from_hex("aabbcc")?)?
	let checked_6: () = assert_retired_output_table("unknown-extension", byte_chunk_from_hex("aabbcc")?)?
	Ok(())
end

test retirement_output_flow_control() -> Result<(), String>
	let checked_1: () = assert_retired_output_table("http2-data", byte_chunk_from_hex("0000020000000000010102")?)?
	let checked_2: () = assert_retired_output_table("http2-content-length-data-first", byte_chunk_from_hex("000002000000000001aabb")?)?
	let checked_3: () = assert_retired_output_table("http2-content-length-data-exact", byte_chunk_from_hex("000003000100000001ccddee")?)?
	let checked_4: () = assert_retired_output_table("http2-data-connection-boundary", byte_chunk_from_hex("0000020000000000010102")?)?
	let checked_5: () = assert_retired_output_table("http2-data-stream-boundary", byte_chunk_from_hex("0000020000000000010102")?)?
	let checked_6: () = assert_retired_output_table("http2-data-split", byte_chunk_from_hex("0000010000000000010100000100000000000102")?)?
	let checked_7: () = assert_retired_output_table("http2-data-padded", byte_chunk_from_hex("00000500080000000102aabb0000")?)?
	let checked_8: () = assert_retired_output_table("http2-data-padded-split", byte_chunk_from_hex("00000400080000000101aabb0000000300080000000101cc00")?)?
	let checked_9: () = assert_retired_empty_output_table("http2-data-padded-connection-window", 0)?
	let checked_10: () = assert_retired_empty_output_table("http2-data-padded-frame-size", 0)?
	let checked_11: () = assert_retired_empty_output_table("http2-data-connection-zero", 0)?
	let checked_12: () = assert_retired_empty_output_table("http2-data-stream-zero", 0)?
	let checked_13: () = assert_retired_empty_output_table("http2-data-connection-refill-before", 0)?
	let checked_14: () = assert_retired_output_table("http2-data-connection-refill-after", byte_chunk_from_hex("0000020000000000010102")?)?
	let checked_15: () = assert_retired_empty_output_table("http2-data-stream-refill-before", 0)?
	let checked_16: () = assert_retired_output_table("http2-data-stream-refill-after", byte_chunk_from_hex("0000020000000000010102")?)?
	let checked_17: () = assert_retired_empty_output_table("http2-data-after-local-window-update-no-refill", 0)?
	let checked_18: () = assert_retired_output_table("http2-data-after-initial-window-restore", byte_chunk_from_hex("0000020000000000010102")?)?
	let checked_19: () = assert_retired_output_table("http2-peer-closed-data", byte_chunk_from_hex("000001000000000001aa000001000000000001bb")?)?
