	# evidence http2-local-header-list-size-settings-range
	# evidence http2-settings-ack
	# evidence http2-settings-header
	let expected: ByteChunk = byte_chunk_from_hex("")?
	let transition: HeaderBlockTransition = http2::core::start_header_block(1, 1, 0, 0, false, 0, expected, true)
	if http2::core::header_block_is_complete(transition) and not http2::core::pending_header_block_is_active(http2::core::header_block_state(transition)) and chunks_equal(http2::core::completed_header_block(transition), expected)?
		Ok(())
	else
		Err("retired HTTP/2 settings output chunks changed")
	end
end

