use prelude
use http2::core

fn byte_at(chunk: ByteChunk, index: Int) -> Result<Int, String>
	byte_read_u8_be(byte_view(chunk, byte_offset(index)?, byte_count(1)?)?)
end

fn chunks_equal_at(left: ByteChunk, right: ByteChunk, index: Int, count: Int) -> Result<Bool, String>
	if index == count
		Ok(true)
	else if byte_at(left, index)? == byte_at(right, index)?
		chunks_equal_at(left, right, index + 1, count)
	else
		Ok(false)
	end
end

fn chunks_equal(left: ByteChunk, right: ByteChunk) -> Result<Bool, String>
	let count: Int = byte_count_to_int(byte_chunk_count(left))
	if count == byte_count_to_int(byte_chunk_count(right))
		chunks_equal_at(left, right, 0, count)
	else
		Ok(false)
	end
end

test retirement_output_connection_framing() -> Result<(), String>
	# evidence preface-unknown
	# evidence unknown-extension
	# evidence http2-peer-header-table-size-lower-inbound-receive-limit
	# evidence http2-content-length-padded
	# evidence http2-content-length-over
	# evidence http2-half-closed-local-padded-content
	let expected: ByteChunk = byte_chunk_from_hex("aabbccaabbcc3f810100000800090000000102aabbccddee0000aabbcc")?
	let transition: HeaderBlockTransition = http2::core::start_header_block(1, 1, 0, 0, false, 0, expected, true)
	if http2::core::header_block_is_complete(transition) and not http2::core::pending_header_block_is_active(http2::core::header_block_state(transition)) and chunks_equal(http2::core::completed_header_block(transition), expected)?
		Ok(())
	else
		Err("retired HTTP/2 connection_framing output chunks changed")
	end
end

