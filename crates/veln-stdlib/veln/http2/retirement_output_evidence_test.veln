		Ok(failure) => if expected_retired_empty_push_promise_family(name)? != "" and http2::core::push_promise_send_status(decision) == "rejected" and http2::core::outbound_headers_failure_id(failure) == "http2.protocol.invalid_stream_id" and byte_count_to_int(byte_chunk_count(http2::core::push_promise_send_bytes(decision))) == 0 and http2::core::output_buffer_count(output) == 0
			Ok(())
		else
			Err(name)
		end
		Err(_) => Err(name)
	end
end

fn assert_retired_empty_window_update_output_table(name: String) -> Result<(), String>
	let state: CoreConnectionState = http2::core::connection_state_with_receive_credit(http2::core::server_connection_state(0)?, require_connection_credit(2147483647)?)
	let decision: CoreWindowUpdateSendDecision = http2::core::send_window_update(state, 0, 0, 1)
	let output: CoreOutputBuffer = http2::core::output_buffer_append_window_update(http2::core::empty_output_buffer(), decision)
	match http2::core::window_update_send_failure(decision)
		Ok(failure) => if expected_retired_empty_window_update_family(name)? != "" and http2::core::outbound_data_flow_failure_id(failure) != "" and http2::core::window_update_send_status(decision) == "rejected" and byte_count_to_int(byte_chunk_count(http2::core::window_update_send_bytes(decision))) == 0 and http2::core::output_buffer_count(output) == 0
			Ok(())
