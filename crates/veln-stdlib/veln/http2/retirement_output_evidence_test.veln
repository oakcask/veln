end

fn assert_retired_empty_priority_output_table(name: String) -> Result<(), String>
	let state: CoreConnectionState = http2::core::connection_state_with_lifecycle(http2::core::client_connection_state(0)?, http2::core::connection_lifecycle_draining(1, 0))
	let decision: CorePrioritySendDecision = http2::core::send_priority(state, 0, 3, 1, false, 16)
