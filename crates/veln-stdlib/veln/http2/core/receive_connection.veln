use prelude
use http2::frame
use http2::core::connection_preface
use http2::core::connection_state
use http2::core::initial_peer_settings
use http2::core::output_buffer
use http2::core::pending_header_block
use http2::core::ping
use http2::core::receive_frame
use http2::core::settings_ack

pub type CoreReceiveConnectionState
	CoreReceiveConnectionState(connection: CoreConnectionState, input: ByteChunk, output: CoreOutputBuffer, initial_settings_accepted: Bool, application_events: List<Http2ApplicationEvent>)
end

pub type Http2ApplicationEvent = http2::core::receive_frame::Http2ApplicationEvent

pub type CoreApplicationEventDrain
	CoreApplicationEventDrain(events: List<Http2ApplicationEvent>, state: CoreReceiveConnectionState)
end

pub type CoreReceiveConnectionDecision
	Accepted(CoreReceiveConnectionState, applied_transition: String)
	Rejected(CoreReceiveConnectionFailure)
end

pub type CoreReceiveConnectionEofDecision
	Accepted(CoreConnectionState)
	Rejected(CoreReceiveConnectionEofFailure)
end

pub type CoreReceiveConnectionFailure
	PrefaceFailure(ConnectionPrefaceFailure)
	InitialSettingsFailure(InitialPeerSettingsFailure)
	FrameFailure(CoreReceiveFrameFailure)
end

pub type CoreReceiveConnectionEofFailure
	PrefaceFailure(ConnectionPrefaceFailure)
	InitialSettingsFailure(offset: Int, pending_count: Int, preview: ByteChunk)
	FrameFailure(offset: Int, pending_count: Int, expected_count: Int, preview: ByteChunk)
	HeaderBlockFailure(HeaderBlockFailure)
end

pub fn state(connection: CoreConnectionState, input: ByteChunk, output: CoreOutputBuffer) -> CoreReceiveConnectionState
	CoreReceiveConnectionState(connection, input, output, false, Nil)
end

pub fn state_after_initial_settings(connection: CoreConnectionState, input: ByteChunk, output: CoreOutputBuffer) -> CoreReceiveConnectionState
	CoreReceiveConnectionState(connection, input, output, true, Nil)
end

pub fn receive_chunk(state: CoreReceiveConnectionState, chunk: ByteChunk) -> Result<CoreReceiveConnectionDecision, String>
	match state
		CoreReceiveConnectionState(connection, input, output, initial_settings_accepted, events) => receive_buffered(connection, byte_append(input, chunk), output, initial_settings_accepted, events)
	end
end

pub fn finalize_eof(state: CoreReceiveConnectionState) -> Result<CoreReceiveConnectionEofDecision, String>
	match state
		CoreReceiveConnectionState(connection, input, _, initial_settings_accepted, _) => finalize_connection_eof(connection, input, initial_settings_accepted)
	end
end

pub fn drain_application_events(state: CoreReceiveConnectionState) -> CoreApplicationEventDrain
	match state
		CoreReceiveConnectionState(connection, input, output, initial_settings_accepted, events) => CoreApplicationEventDrain(events, CoreReceiveConnectionState(connection, input, output, initial_settings_accepted, Nil))
	end
end

fn finalize_connection_eof(connection: CoreConnectionState, input: ByteChunk, initial_settings_accepted: Bool) -> Result<CoreReceiveConnectionEofDecision, String>
	if http2::core::connection_state::endpoint_role(connection) == "server" and not http2::core::connection_preface::state_completed(http2::core::connection_state::preface(connection))
		match http2::core::connection_preface::close(http2::core::connection_state::preface(connection))
			Ok(_) => finalize_after_preface_eof(connection, input, initial_settings_accepted)
			Err(failure) => Ok(CoreReceiveConnectionEofDecision::Rejected(CoreReceiveConnectionEofFailure::PrefaceFailure(failure)))
		end
	else
		finalize_after_preface_eof(connection, input, initial_settings_accepted)
	end
end

fn finalize_after_preface_eof(connection: CoreConnectionState, input: ByteChunk, initial_settings_accepted: Bool) -> Result<CoreReceiveConnectionEofDecision, String>
	let pending_count = byte_count_to_int(byte_chunk_count(input))
	if pending_count > 0
		Ok(CoreReceiveConnectionEofDecision::Rejected(CoreReceiveConnectionEofFailure::FrameFailure(http2::core::connection_state::next_offset(connection), pending_count, expected_frame_count(input)?, input)))
	else if not initial_settings_accepted
		Ok(CoreReceiveConnectionEofDecision::Rejected(CoreReceiveConnectionEofFailure::InitialSettingsFailure(http2::core::connection_state::next_offset(connection), 0, input)))
	else
		finalize_pending_header_block(connection, input)
	end
end

fn finalize_pending_header_block(connection: CoreConnectionState, input: ByteChunk) -> Result<CoreReceiveConnectionEofDecision, String>
	match http2::core::pending_header_block::close(http2::core::connection_state::pending_header_block(connection), http2::core::connection_state::next_offset(connection), byte_count_to_int(byte_chunk_count(input)), input)
		Ok(_) => Ok(CoreReceiveConnectionEofDecision::Accepted(connection))
		Err(failure) => Ok(CoreReceiveConnectionEofDecision::Rejected(CoreReceiveConnectionEofFailure::HeaderBlockFailure(failure)))
	end
end

fn expected_frame_count(input: ByteChunk) -> Result<Int, String>
	let pending_count = byte_count_to_int(byte_chunk_count(input))
	if pending_count < 9
		Ok(9)
	else
		Ok(9 + frame_payload_length(input)?)
	end
end

fn receive_buffered(connection: CoreConnectionState, buffered: ByteChunk, output: CoreOutputBuffer, initial_settings_accepted: Bool, events: List<Http2ApplicationEvent>) -> Result<CoreReceiveConnectionDecision, String>
	if http2::core::connection_state::endpoint_role(connection) == "server" and not http2::core::connection_preface::state_completed(http2::core::connection_state::preface(connection))
		receive_preface(connection, buffered, output, initial_settings_accepted, events)
	else
		receive_frame_from_buffer(connection, buffered, output, initial_settings_accepted, events)
	end
end

fn receive_preface(connection: CoreConnectionState, buffered: ByteChunk, output: CoreOutputBuffer, initial_settings_accepted: Bool, events: List<Http2ApplicationEvent>) -> Result<CoreReceiveConnectionDecision, String>
	match http2::core::connection_preface::advance(http2::core::connection_state::preface(connection), buffered)
		Ok(transition) => accept_preface_transition(connection, output, initial_settings_accepted, events, transition)
		Err(failure) => Ok(CoreReceiveConnectionDecision::Rejected(CoreReceiveConnectionFailure::PrefaceFailure(failure)))
	end
end

fn accept_preface_transition(connection: CoreConnectionState, output: CoreOutputBuffer, initial_settings_accepted: Bool, events: List<Http2ApplicationEvent>, transition: ConnectionPrefaceTransition) -> Result<CoreReceiveConnectionDecision, String>
	let next_connection = http2::core::connection_state::with_next_offset(http2::core::connection_state::with_preface(connection, http2::core::connection_preface::transition_state(transition)), preface_next_offset(connection, transition))
	if http2::core::connection_preface::transition_completed(transition)
		receive_frame_from_buffer(next_connection, http2::core::connection_preface::transition_suffix(transition), output, initial_settings_accepted, events)
	else
		Ok(CoreReceiveConnectionDecision::Accepted(CoreReceiveConnectionState(next_connection, byte_chunk([]), output, initial_settings_accepted, events), "preface-pending"))
	end
end

fn preface_next_offset(connection: CoreConnectionState, transition: ConnectionPrefaceTransition) -> Int
	if http2::core::connection_preface::transition_completed(transition)
		http2::core::connection_preface::state_starting_offset(http2::core::connection_preface::transition_state(transition)) + http2::core::connection_preface::state_matched_count(http2::core::connection_preface::transition_state(transition))
	else
		http2::core::connection_state::next_offset(connection)
	end
end

fn receive_frame_from_buffer(connection: CoreConnectionState, buffered: ByteChunk, output: CoreOutputBuffer, initial_settings_accepted: Bool, events: List<Http2ApplicationEvent>) -> Result<CoreReceiveConnectionDecision, String>
	let buffered_count = byte_count_to_int(byte_chunk_count(buffered))
	if buffered_count < 9
		Ok(CoreReceiveConnectionDecision::Accepted(CoreReceiveConnectionState(connection, buffered, output, initial_settings_accepted, events), "buffered"))
	else
		receive_complete_or_buffered(connection, buffered, output, initial_settings_accepted, events, buffered_count, frame_payload_length(buffered)?)
	end
end

fn receive_complete_or_buffered(connection: CoreConnectionState, buffered: ByteChunk, output: CoreOutputBuffer, initial_settings_accepted: Bool, events: List<Http2ApplicationEvent>, buffered_count: Int, payload_length: Int) -> Result<CoreReceiveConnectionDecision, String>
	let frame_count = 9 + payload_length
	if buffered_count < frame_count
		Ok(CoreReceiveConnectionDecision::Accepted(CoreReceiveConnectionState(connection, buffered, output, initial_settings_accepted, events), "buffered"))
	else
		receive_complete_frame(connection, output, initial_settings_accepted, events, byte_take(buffered, byte_count(frame_count)?)?, byte_drop(buffered, byte_count(frame_count)?)?)
	end
end

fn receive_complete_frame(connection: CoreConnectionState, output: CoreOutputBuffer, initial_settings_accepted: Bool, events: List<Http2ApplicationEvent>, frame_bytes: ByteChunk, suffix: ByteChunk) -> Result<CoreReceiveConnectionDecision, String>
	if initial_settings_accepted
		apply_complete_frame(connection, output, true, events, frame_bytes, suffix)
	else
		require_initial_settings(connection, output, events, frame_bytes, suffix)
	end
end

fn require_initial_settings(connection: CoreConnectionState, output: CoreOutputBuffer, events: List<Http2ApplicationEvent>, frame_bytes: ByteChunk, suffix: ByteChunk) -> Result<CoreReceiveConnectionDecision, String>
	match decode_header(frame_bytes)
		Ok(header) => match http2::core::initial_peer_settings::advance(http2::core::connection_state::initial_peer_settings(connection), http2::core::connection_state::next_offset(connection), header_kind(header), header_flags(header), header_stream_id(header), header_preview(frame_bytes)?)
			Ok(_) => apply_complete_frame(connection, output, true, events, frame_bytes, suffix)
			Err(failure) => Ok(CoreReceiveConnectionDecision::Rejected(CoreReceiveConnectionFailure::InitialSettingsFailure(failure)))
		end
		Err(failure) => Ok(CoreReceiveConnectionDecision::Rejected(CoreReceiveConnectionFailure::FrameFailure(failure)))
	end
end

fn apply_complete_frame(connection: CoreConnectionState, output: CoreOutputBuffer, initial_settings_accepted: Bool, events: List<Http2ApplicationEvent>, frame_bytes: ByteChunk, suffix: ByteChunk) -> Result<CoreReceiveConnectionDecision, String>
	match decode_header(frame_bytes)
		Ok(header) => match http2::core::receive_frame::apply(connection, frame_bytes)
			Ok(decision) => match http2::core::receive_frame::decision_status(decision)
				"accepted" => accept_receive_frame(decision, output, initial_settings_accepted, events, header, suffix)
				_ => Ok(CoreReceiveConnectionDecision::Rejected(CoreReceiveConnectionFailure::FrameFailure(http2::core::receive_frame::decision_failure(decision)?)))
			end
			Err(reason) => Ok(CoreReceiveConnectionDecision::Rejected(CoreReceiveConnectionFailure::FrameFailure(http2::core::receive_frame::decode_failure(reason, frame_bytes))))
		end
		Err(failure) => Ok(CoreReceiveConnectionDecision::Rejected(CoreReceiveConnectionFailure::FrameFailure(failure)))
	end
end

fn accept_receive_frame(decision: CoreReceiveFrameDecision, output: CoreOutputBuffer, initial_settings_accepted: Bool, events: List<Http2ApplicationEvent>, header: FrameHeader, suffix: ByteChunk) -> Result<CoreReceiveConnectionDecision, String>
	let next_connection = http2::core::receive_frame::decision_state(decision)?
	let next_events = append_decision_event(events, http2::core::receive_frame::decision_application_event(decision))
	let output_transition = output_after_frame(next_connection, output, header)?
	let after_frame = CoreReceiveConnectionState(output_transition_connection(output_transition), suffix, output_transition_output(output_transition), initial_settings_accepted, next_events)
	if byte_count_to_int(byte_chunk_count(suffix)) == 0
		Ok(CoreReceiveConnectionDecision::Accepted(after_frame, http2::core::receive_frame::decision_applied_transition(decision)))
	else
		receive_frame_from_buffer(output_transition_connection(output_transition), suffix, output_transition_output(output_transition), initial_settings_accepted, next_events)
	end
end

fn append_decision_event(events: List<Http2ApplicationEvent>, event: Option<Http2ApplicationEvent>) -> List<Http2ApplicationEvent>
	match event
		Some(value) => append_event(events, value)
		None => events
	end
end

fn append_event(events: List<Http2ApplicationEvent>, event: Http2ApplicationEvent) -> List<Http2ApplicationEvent>
	match events
		Nil => Cons(event, Nil)
		Cons(head, tail) => Cons(head, append_event(tail, event))
	end
end

type ReceiveOutputTransition
	ReceiveOutputTransition(connection: CoreConnectionState, output: CoreOutputBuffer)
end

fn output_after_frame(connection: CoreConnectionState, output: CoreOutputBuffer, header: FrameHeader) -> Result<ReceiveOutputTransition, String>
	if header_kind(header) == 4 and header_flags(header) == 0
		append_pending_settings_ack(connection, output, http2::core::settings_ack::send_pending_peer_ack(http2::core::connection_state::settings_ack(connection)))
	else if header_kind(header) == 6
		append_ping_response(connection, output, http2::core::ping::response(header_flags(header), header_payload(header)))
	else
		Ok(ReceiveOutputTransition(connection, output))
	end
end

fn append_pending_settings_ack(connection: CoreConnectionState, output: CoreOutputBuffer, decision: PeerSettingsAckSendDecision) -> Result<ReceiveOutputTransition, String>
	let next_connection = http2::core::connection_state::with_settings_ack(connection, http2::core::settings_ack::send_state(decision))
	match http2::core::settings_ack::send_status(decision)
		"accepted" => Ok(ReceiveOutputTransition(next_connection, http2::core::output_buffer::append_chunk(output, http2::core::settings_ack::send_bytes(decision))))
		_ => Ok(ReceiveOutputTransition(next_connection, output))
	end
end

fn append_ping_response(connection: CoreConnectionState, output: CoreOutputBuffer, decision: PingResponseDecision) -> Result<ReceiveOutputTransition, String>
	match http2::core::ping::response_status(decision)
		"accepted" => Ok(ReceiveOutputTransition(connection, http2::core::output_buffer::append_chunk(output, http2::core::ping::response_bytes(decision))))
		_ => Ok(ReceiveOutputTransition(connection, output))
	end
end

fn output_transition_connection(transition: ReceiveOutputTransition) -> CoreConnectionState
	match transition
		ReceiveOutputTransition(connection, _) => connection
	end
end

fn output_transition_output(transition: ReceiveOutputTransition) -> CoreOutputBuffer
	match transition
		ReceiveOutputTransition(_, output) => output
	end
end

type FrameHeader
	FrameHeader(length: Int, kind: Int, flags: Int, stream_id: Int, payload: ByteChunk)
end

fn decode_header(frame_bytes: ByteChunk) -> Result<FrameHeader, CoreReceiveFrameFailure>
	match byte_offset(0)
		Ok(offset) => match byte_view(frame_bytes, offset, byte_chunk_count(frame_bytes))
			Ok(view) => match http2::frame::decode(view)
				Ok(decoded) => Ok(FrameHeader(decoded.length, decoded.kind, decoded.flags, decoded.stream_id, byte_view_to_chunk(decoded.payload)))
				Err(reason) => Err(http2::core::receive_frame::decode_failure(reason, frame_bytes))
			end
			Err(reason) => Err(http2::core::receive_frame::decode_failure(reason, frame_bytes))
		end
		Err(reason) => Err(http2::core::receive_frame::decode_failure(reason, frame_bytes))
	end
end

fn frame_payload_length(buffered: ByteChunk) -> Result<Int, String>
	byte_read_u24_be(byte_view(buffered, byte_offset(0)?, byte_count(3)?)?)
end

fn header_preview(frame_bytes: ByteChunk) -> Result<ByteChunk, String>
	byte_take(frame_bytes, byte_count(9)?)
end

fn header_length(header: FrameHeader) -> Int
	match header
		FrameHeader(length, _, _, _, _) => length
	end
end

fn header_kind(header: FrameHeader) -> Int
	match header
		FrameHeader(_, kind, _, _, _) => kind
	end
end

fn header_flags(header: FrameHeader) -> Int
	match header
		FrameHeader(_, _, flags, _, _) => flags
	end
end

fn header_stream_id(header: FrameHeader) -> Int
	match header
		FrameHeader(_, _, _, stream_id, _) => stream_id
	end
end

fn header_payload(header: FrameHeader) -> ByteChunk
	match header
		FrameHeader(_, _, _, _, payload) => payload
	end
end

pub fn decision_status(decision: CoreReceiveConnectionDecision) -> String
	match decision
		CoreReceiveConnectionDecision::Accepted(_, _) => "accepted"
		CoreReceiveConnectionDecision::Rejected(_) => "rejected"
	end
end

pub fn decision_state(decision: CoreReceiveConnectionDecision) -> Result<CoreReceiveConnectionState, String>
	match decision
		CoreReceiveConnectionDecision::Accepted(state, _) => Ok(state)
		CoreReceiveConnectionDecision::Rejected(_) => Err("rejected receive connection decision has no state")
	end
end

pub fn decision_failure(decision: CoreReceiveConnectionDecision) -> Result<CoreReceiveConnectionFailure, String>
	match decision
		CoreReceiveConnectionDecision::Accepted(_, _) => Err("accepted receive connection decision has no failure")
		CoreReceiveConnectionDecision::Rejected(failure) => Ok(failure)
	end
end

pub fn decision_applied_transition(decision: CoreReceiveConnectionDecision) -> String
	match decision
		CoreReceiveConnectionDecision::Accepted(_, applied_transition) => applied_transition
		CoreReceiveConnectionDecision::Rejected(_) => "rejected"
	end
end

pub fn state_connection(state: CoreReceiveConnectionState) -> CoreConnectionState
	match state
		CoreReceiveConnectionState(connection, _, _, _, _) => connection
	end
end

pub fn state_input(state: CoreReceiveConnectionState) -> ByteChunk
	match state
		CoreReceiveConnectionState(_, input, _, _, _) => input
	end
end

pub fn state_output(state: CoreReceiveConnectionState) -> CoreOutputBuffer
	match state
		CoreReceiveConnectionState(_, _, output, _, _) => output
	end
end

pub fn state_initial_settings_accepted(state: CoreReceiveConnectionState) -> Bool
	match state
		CoreReceiveConnectionState(_, _, _, accepted, _) => accepted
	end
end

pub fn state_application_events(state: CoreReceiveConnectionState) -> List<Http2ApplicationEvent>
	match state
		CoreReceiveConnectionState(_, _, _, _, events) => events
	end
end

pub fn application_event_drain_events(drain: CoreApplicationEventDrain) -> List<Http2ApplicationEvent>
	match drain
		CoreApplicationEventDrain(events, _) => events
	end
end

pub fn application_event_drain_state(drain: CoreApplicationEventDrain) -> CoreReceiveConnectionState
	match drain
		CoreApplicationEventDrain(_, state) => state
	end
end

pub fn failure_source(failure: CoreReceiveConnectionFailure) -> String
	match failure
		CoreReceiveConnectionFailure::PrefaceFailure(_) => "connection-preface"
		CoreReceiveConnectionFailure::InitialSettingsFailure(_) => "initial-peer-settings"
		CoreReceiveConnectionFailure::FrameFailure(inner) => http2::core::receive_frame::failure_source(inner)
	end
end

pub fn failure_id(failure: CoreReceiveConnectionFailure) -> String
	match failure
		CoreReceiveConnectionFailure::PrefaceFailure(inner) => if http2::core::connection_preface::failure_kind(inner) == "partial_preface"
			"http2.protocol.partial_preface"
		else
			"http2.protocol.invalid_preface"
		end
		CoreReceiveConnectionFailure::InitialSettingsFailure(inner) => http2::core::initial_peer_settings::failure_id(inner)
		CoreReceiveConnectionFailure::FrameFailure(inner) => http2::core::receive_frame::failure_id(inner)
	end
end

pub fn failure_offset(failure: CoreReceiveConnectionFailure) -> Int
	match failure
		CoreReceiveConnectionFailure::PrefaceFailure(inner) => http2::core::connection_preface::failure_offset(inner)
		CoreReceiveConnectionFailure::InitialSettingsFailure(inner) => http2::core::initial_peer_settings::failure_offset(inner)
		CoreReceiveConnectionFailure::FrameFailure(inner) => http2::core::receive_frame::failure_offset(inner)
	end
end

pub fn failure_frame_kind(failure: CoreReceiveConnectionFailure) -> Int
	match failure
		CoreReceiveConnectionFailure::PrefaceFailure(_) => 0
		CoreReceiveConnectionFailure::InitialSettingsFailure(inner) => http2::core::initial_peer_settings::failure_frame_kind(inner)
		CoreReceiveConnectionFailure::FrameFailure(inner) => http2::core::receive_frame::failure_frame_kind(inner)
	end
end

pub fn failure_stream_id(failure: CoreReceiveConnectionFailure) -> Int
	match failure
		CoreReceiveConnectionFailure::PrefaceFailure(_) => 0
		CoreReceiveConnectionFailure::InitialSettingsFailure(inner) => http2::core::initial_peer_settings::failure_stream_id(inner)
		CoreReceiveConnectionFailure::FrameFailure(inner) => http2::core::receive_frame::failure_stream_id(inner)
	end
end

pub fn failure_reason(failure: CoreReceiveConnectionFailure) -> String
	match failure
		CoreReceiveConnectionFailure::PrefaceFailure(inner) => http2::core::connection_preface::failure_kind(inner)
		CoreReceiveConnectionFailure::InitialSettingsFailure(inner) => http2::core::initial_peer_settings::failure_rule_provenance(inner)
		CoreReceiveConnectionFailure::FrameFailure(inner) => http2::core::receive_frame::failure_reason(inner)
	end
end

pub fn failure_preview(failure: CoreReceiveConnectionFailure) -> ByteChunk
	match failure
		CoreReceiveConnectionFailure::PrefaceFailure(inner) => http2::core::connection_preface::failure_preview(inner)
		CoreReceiveConnectionFailure::InitialSettingsFailure(inner) => http2::core::initial_peer_settings::failure_preview(inner)
		CoreReceiveConnectionFailure::FrameFailure(inner) => http2::core::receive_frame::failure_preview(inner)
	end
end

pub fn eof_decision_status(decision: CoreReceiveConnectionEofDecision) -> String
	match decision
		CoreReceiveConnectionEofDecision::Accepted(_) => "accepted"
		CoreReceiveConnectionEofDecision::Rejected(_) => "rejected"
	end
end

pub fn eof_decision_state(decision: CoreReceiveConnectionEofDecision) -> Result<CoreConnectionState, String>
	match decision
		CoreReceiveConnectionEofDecision::Accepted(state) => Ok(state)
		CoreReceiveConnectionEofDecision::Rejected(_) => Err("rejected receive connection EOF decision has no state")
	end
end

pub fn eof_decision_failure(decision: CoreReceiveConnectionEofDecision) -> Result<CoreReceiveConnectionEofFailure, String>
	match decision
		CoreReceiveConnectionEofDecision::Accepted(_) => Err("accepted receive connection EOF decision has no failure")
		CoreReceiveConnectionEofDecision::Rejected(failure) => Ok(failure)
	end
end

pub fn eof_failure_source(failure: CoreReceiveConnectionEofFailure) -> String
	match failure
		CoreReceiveConnectionEofFailure::PrefaceFailure(_) => "connection-preface"
		CoreReceiveConnectionEofFailure::InitialSettingsFailure(_, _, _) => "initial-peer-settings"
		CoreReceiveConnectionEofFailure::FrameFailure(_, _, _, _) => "frame"
		CoreReceiveConnectionEofFailure::HeaderBlockFailure(_) => "pending-header-block"
	end
end

pub fn eof_failure_id(failure: CoreReceiveConnectionEofFailure) -> String
	match failure
		CoreReceiveConnectionEofFailure::PrefaceFailure(inner) => if http2::core::connection_preface::failure_kind(inner) == "partial_preface"
			"http2.protocol.partial_preface"
		else
			"http2.protocol.invalid_preface"
		end
		CoreReceiveConnectionEofFailure::InitialSettingsFailure(_, _, _) => "http2.protocol.incomplete_initial_peer_settings"
		CoreReceiveConnectionEofFailure::FrameFailure(_, _, _, _) => "http2.protocol.incomplete_frame"
		CoreReceiveConnectionEofFailure::HeaderBlockFailure(_) => "http2.protocol.incomplete_header_block"
	end
end

pub fn eof_failure_offset(failure: CoreReceiveConnectionEofFailure) -> Int
	match failure
		CoreReceiveConnectionEofFailure::PrefaceFailure(inner) => http2::core::connection_preface::failure_offset(inner)
		CoreReceiveConnectionEofFailure::InitialSettingsFailure(offset, _, _) => offset
		CoreReceiveConnectionEofFailure::FrameFailure(offset, _, _, _) => offset
		CoreReceiveConnectionEofFailure::HeaderBlockFailure(inner) => http2::core::pending_header_block::failure_offset(inner)
	end
end

pub fn eof_failure_pending_count(failure: CoreReceiveConnectionEofFailure) -> Int
	match failure
		CoreReceiveConnectionEofFailure::PrefaceFailure(inner) => http2::core::connection_preface::failure_pending_count(inner)
		CoreReceiveConnectionEofFailure::InitialSettingsFailure(_, pending_count, _) => pending_count
		CoreReceiveConnectionEofFailure::FrameFailure(_, pending_count, _, _) => pending_count
		CoreReceiveConnectionEofFailure::HeaderBlockFailure(inner) => http2::core::pending_header_block::failure_pending_count(inner)
	end
end

pub fn eof_failure_expected_count(failure: CoreReceiveConnectionEofFailure) -> Int
	match failure
		CoreReceiveConnectionEofFailure::PrefaceFailure(_) => 24
		CoreReceiveConnectionEofFailure::InitialSettingsFailure(_, _, _) => 9
		CoreReceiveConnectionEofFailure::FrameFailure(_, _, expected_count, _) => expected_count
		CoreReceiveConnectionEofFailure::HeaderBlockFailure(_) => 0
	end
end

pub fn eof_failure_frame_kind(failure: CoreReceiveConnectionEofFailure) -> Int
	match failure
		CoreReceiveConnectionEofFailure::PrefaceFailure(_) => 0
		CoreReceiveConnectionEofFailure::InitialSettingsFailure(_, _, _) => 4
		CoreReceiveConnectionEofFailure::FrameFailure(_, _, _, _) => 0
		CoreReceiveConnectionEofFailure::HeaderBlockFailure(inner) => http2::core::pending_header_block::failure_started_kind(inner)
	end
end

pub fn eof_failure_stream_id(failure: CoreReceiveConnectionEofFailure) -> Int
	match failure
		CoreReceiveConnectionEofFailure::PrefaceFailure(_) => 0
		CoreReceiveConnectionEofFailure::InitialSettingsFailure(_, _, _) => 0
		CoreReceiveConnectionEofFailure::FrameFailure(_, _, _, _) => 0
		CoreReceiveConnectionEofFailure::HeaderBlockFailure(inner) => http2::core::pending_header_block::failure_expected_stream(inner)
	end
end

pub fn eof_failure_reason(failure: CoreReceiveConnectionEofFailure) -> String
	match failure
		CoreReceiveConnectionEofFailure::PrefaceFailure(inner) => http2::core::connection_preface::failure_kind(inner)
		CoreReceiveConnectionEofFailure::InitialSettingsFailure(_, _, _) => "rfc9113_initial_peer_frame_requires_non_ack_settings"
		CoreReceiveConnectionEofFailure::FrameFailure(_, _, _, _) => "clean_end_before_complete_frame"
		CoreReceiveConnectionEofFailure::HeaderBlockFailure(inner) => http2::core::pending_header_block::failure_rule_provenance(inner)
	end
end

pub fn eof_failure_preview(failure: CoreReceiveConnectionEofFailure) -> ByteChunk
	match failure
		CoreReceiveConnectionEofFailure::PrefaceFailure(inner) => http2::core::connection_preface::failure_preview(inner)
		CoreReceiveConnectionEofFailure::InitialSettingsFailure(_, _, preview) => preview
		CoreReceiveConnectionEofFailure::FrameFailure(_, _, _, preview) => preview
		CoreReceiveConnectionEofFailure::HeaderBlockFailure(inner) => http2::core::pending_header_block::failure_preview(inner)
	end
end
