use prelude
use http2::core::connection_state
use http2::core::stream_state
use http2::frame

pub type CoreRstStreamSendDecision
	Accepted(CoreConnectionState, stream_id: Int, error_code: Int, bytes: ByteChunk)
	Rejected(CoreOutboundStreamControlFailure)
	EncodeFailed(stream_id: Int, error_code: Int, reason: String)
end

pub type CorePrioritySendDecision
	Accepted(CoreConnectionState, stream_id: Int, dependency_stream_id: Int, exclusive: Bool, weight: Int, bytes: ByteChunk)
	Rejected(CoreOutboundStreamControlFailure)
	EncodeFailed(stream_id: Int, dependency_stream_id: Int, exclusive: Bool, weight: Int, reason: String)
end

pub type CoreOutboundStreamControlFailure
	StreamInvalidStreamId(offset: Int, frame_kind: Int, stream_id: Int, expected: String, endpoint_role: String, active_state: String, rule_provenance: String, preview: ByteChunk)
	StreamInvalidFrameKind(offset: Int, frame_kind: Int, stream_id: Int, expected_kind: Int, active_state: String, rule_provenance: String, preview: ByteChunk)
	PriorityDependency(offset: Int, stream_id: Int, dependency_stream_id: Int, active_state: String, rule_provenance: String, preview: ByteChunk)
	StreamAfterGoaway(offset: Int, stream_id: Int, last_stream_id: Int, shutdown_state: String, endpoint_role: String, rule_provenance: String, preview: ByteChunk)
end

pub fn send_rst_stream(state: CoreConnectionState, offset: Int, stream_id: Int, error_code: Int) -> CoreRstStreamSendDecision
	if stream_id == 0
		CoreRstStreamSendDecision::Rejected(CoreOutboundStreamControlFailure::StreamInvalidStreamId(offset, 3, stream_id, "nonzero open stream id", http2::core::connection_state::endpoint_role(state), "stream-id-domain", "outbound_rst_stream_requires_open_stream", byte_chunk([])))
	else
		match http2::core::stream_state::find_entry(http2::core::connection_state::streams(state), stream_id)
			Some(entry) => send_rst_stream_for_entry(state, offset, stream_id, error_code, http2::core::stream_state::entry_lifecycle(entry))
			None => CoreRstStreamSendDecision::Rejected(CoreOutboundStreamControlFailure::StreamInvalidFrameKind(offset, 3, stream_id, 1, "idle-stream", "idle_streams_require_headers", byte_chunk([])))
		end
	end
end

fn send_rst_stream_for_entry(state: CoreConnectionState, offset: Int, stream_id: Int, error_code: Int, lifecycle: CoreStreamLifecycle) -> CoreRstStreamSendDecision
	if http2::core::stream_state::lifecycle_accepts_reset(lifecycle)
		encode_rst_stream(state, stream_id, error_code)
	else
		CoreRstStreamSendDecision::Rejected(CoreOutboundStreamControlFailure::StreamInvalidFrameKind(offset, 3, stream_id, 1, http2::core::stream_state::lifecycle_active_state(lifecycle), http2::core::stream_state::lifecycle_rejection_rule(lifecycle), byte_chunk([])))
	end
end

fn encode_rst_stream(state: CoreConnectionState, stream_id: Int, error_code: Int) -> CoreRstStreamSendDecision
	match http2::frame::encode_header(4, 3, 0, stream_id)
		Ok(header) => match byte_write_u32_be(error_code)
			Ok(payload) => CoreRstStreamSendDecision::Accepted(reset_stream_state(state, stream_id, error_code), stream_id, error_code, byte_append(header, payload))
			Err(reason) => CoreRstStreamSendDecision::EncodeFailed(stream_id, error_code, reason)
		end
		Err(reason) => CoreRstStreamSendDecision::EncodeFailed(stream_id, error_code, reason)
	end
end

fn reset_stream_state(state: CoreConnectionState, stream_id: Int, error_code: Int) -> CoreConnectionState
	http2::core::connection_state::with_streams(state, http2::core::stream_state::with_lifecycle(http2::core::connection_state::streams(state), stream_id, http2::core::stream_state::reset_lifecycle(error_code)))
end

pub fn send_priority(state: CoreConnectionState, offset: Int, stream_id: Int, dependency_stream_id: Int, exclusive: Bool, weight: Int) -> CorePrioritySendDecision
	if stream_id == 0
		CorePrioritySendDecision::Rejected(CoreOutboundStreamControlFailure::StreamInvalidStreamId(offset, 2, stream_id, "nonzero open stream id", http2::core::connection_state::endpoint_role(state), "stream-id-domain", "outbound_priority_requires_open_stream", byte_chunk([])))
	else
		match http2::core::stream_state::find_entry(http2::core::connection_state::streams(state), stream_id)
			Some(entry) => send_priority_for_entry(state, offset, stream_id, dependency_stream_id, exclusive, weight, http2::core::stream_state::entry_lifecycle(entry))
			None => CorePrioritySendDecision::Rejected(CoreOutboundStreamControlFailure::StreamInvalidFrameKind(offset, 2, stream_id, 1, "idle-stream", "idle_streams_require_headers", byte_chunk([])))
		end
	end
end

fn send_priority_for_entry(state: CoreConnectionState, offset: Int, stream_id: Int, dependency_stream_id: Int, exclusive: Bool, weight: Int, lifecycle: CoreStreamLifecycle) -> CorePrioritySendDecision
	if not http2::core::stream_state::lifecycle_accepts_priority(lifecycle)
		CorePrioritySendDecision::Rejected(CoreOutboundStreamControlFailure::StreamInvalidFrameKind(offset, 2, stream_id, 1, http2::core::stream_state::lifecycle_active_state(lifecycle), http2::core::stream_state::lifecycle_rejection_rule(lifecycle), byte_chunk([])))
	else if stream_id == dependency_stream_id
		CorePrioritySendDecision::Rejected(CoreOutboundStreamControlFailure::PriorityDependency(offset, stream_id, dependency_stream_id, "stream-control", "rfc9113_priority_dependency", byte_chunk([])))
	else
		validate_priority_goaway(state, offset, stream_id, dependency_stream_id, exclusive, weight)
	end
end

fn validate_priority_goaway(state: CoreConnectionState, offset: Int, stream_id: Int, dependency_stream_id: Int, exclusive: Bool, weight: Int) -> CorePrioritySendDecision
	let lifecycle = http2::core::connection_state::lifecycle(state)
	let label = http2::core::connection_state::lifecycle_label(lifecycle)
	let last_stream_id = http2::core::connection_state::lifecycle_last_stream_id(lifecycle)
	if label != "open" and stream_id > last_stream_id
		CorePrioritySendDecision::Rejected(CoreOutboundStreamControlFailure::StreamAfterGoaway(offset, stream_id, last_stream_id, label, http2::core::connection_state::endpoint_role(state), "goaway_last_stream_id", byte_chunk([])))
	else
		encode_priority(state, stream_id, dependency_stream_id, exclusive, weight)
	end
end

fn encode_priority(state: CoreConnectionState, stream_id: Int, dependency_stream_id: Int, exclusive: Bool, weight: Int) -> CorePrioritySendDecision
	match http2::frame::encode_header(5, 2, 0, stream_id)
		Ok(header) => match byte_write_u31_be(dependency_stream_id)
			Ok(dependency_payload) => match priority_dependency_payload_with_exclusive(dependency_payload, exclusive)
				Ok(marked_dependency_payload) => match byte_write_u8_be(weight - 1)
					Ok(weight_payload) => CorePrioritySendDecision::Accepted(state, stream_id, dependency_stream_id, exclusive, weight, byte_append(header, byte_append(marked_dependency_payload, weight_payload)))
					Err(reason) => CorePrioritySendDecision::EncodeFailed(stream_id, dependency_stream_id, exclusive, weight, reason)
				end
				Err(reason) => CorePrioritySendDecision::EncodeFailed(stream_id, dependency_stream_id, exclusive, weight, reason)
			end
			Err(reason) => CorePrioritySendDecision::EncodeFailed(stream_id, dependency_stream_id, exclusive, weight, reason)
		end
		Err(reason) => CorePrioritySendDecision::EncodeFailed(stream_id, dependency_stream_id, exclusive, weight, reason)
	end
end

fn priority_dependency_payload_with_exclusive(payload: ByteChunk, exclusive: Bool) -> Result<ByteChunk, String>
	let first = byte_read_u8_be(byte_view(payload, byte_offset(0)?, byte_count(1)?)?)?
	let second = byte_read_u8_be(byte_view(payload, byte_offset(1)?, byte_count(1)?)?)?
	let third = byte_read_u8_be(byte_view(payload, byte_offset(2)?, byte_count(1)?)?)?
	let fourth = byte_read_u8_be(byte_view(payload, byte_offset(3)?, byte_count(1)?)?)?
	Ok(byte_append(byte_append(byte_append(byte_write_u8_be(first + exclusive_bit_value(exclusive))?, byte_write_u8_be(second)?), byte_write_u8_be(third)?), byte_write_u8_be(fourth)?))
end

fn exclusive_bit_value(exclusive: Bool) -> Int
	if exclusive
		128
	else
		0
	end
end

pub fn rst_stream_status(decision: CoreRstStreamSendDecision) -> String
	match decision
		CoreRstStreamSendDecision::Accepted(_, _, _, _) => "accepted"
		CoreRstStreamSendDecision::Rejected(_) => "rejected"
		CoreRstStreamSendDecision::EncodeFailed(_, _, _) => "encode_error"
	end
end

pub fn rst_stream_state(decision: CoreRstStreamSendDecision) -> Result<CoreConnectionState, String>
	match decision
		CoreRstStreamSendDecision::Accepted(state, _, _, _) => Ok(state)
		CoreRstStreamSendDecision::Rejected(_) => Err("rejected RST_STREAM send decision has no state")
		CoreRstStreamSendDecision::EncodeFailed(_, _, _) => Err("encode-failed RST_STREAM send decision has no state")
	end
end

pub fn rst_stream_failure(decision: CoreRstStreamSendDecision) -> Result<CoreOutboundStreamControlFailure, String>
	match decision
		CoreRstStreamSendDecision::Accepted(_, _, _, _) => Err("accepted RST_STREAM send decision has no failure")
		CoreRstStreamSendDecision::Rejected(failure) => Ok(failure)
		CoreRstStreamSendDecision::EncodeFailed(_, _, _) => Err("encode-failed RST_STREAM send decision has no protocol failure")
	end
end

pub fn rst_stream_bytes(decision: CoreRstStreamSendDecision) -> ByteChunk
	match decision
		CoreRstStreamSendDecision::Accepted(_, _, _, bytes) => bytes
		_ => byte_chunk([])
	end
end

pub fn rst_stream_encode_reason(decision: CoreRstStreamSendDecision) -> String
	match decision
		CoreRstStreamSendDecision::EncodeFailed(_, _, reason) => reason
		_ => "none"
	end
end

pub fn priority_status(decision: CorePrioritySendDecision) -> String
	match decision
		CorePrioritySendDecision::Accepted(_, _, _, _, _, _) => "accepted"
		CorePrioritySendDecision::Rejected(_) => "rejected"
		CorePrioritySendDecision::EncodeFailed(_, _, _, _, _) => "encode_error"
	end
end

pub fn priority_state(decision: CorePrioritySendDecision) -> Result<CoreConnectionState, String>
	match decision
		CorePrioritySendDecision::Accepted(state, _, _, _, _, _) => Ok(state)
		CorePrioritySendDecision::Rejected(_) => Err("rejected PRIORITY send decision has no state")
		CorePrioritySendDecision::EncodeFailed(_, _, _, _, _) => Err("encode-failed PRIORITY send decision has no state")
	end
end

pub fn priority_failure(decision: CorePrioritySendDecision) -> Result<CoreOutboundStreamControlFailure, String>
	match decision
		CorePrioritySendDecision::Accepted(_, _, _, _, _, _) => Err("accepted PRIORITY send decision has no failure")
		CorePrioritySendDecision::Rejected(failure) => Ok(failure)
		CorePrioritySendDecision::EncodeFailed(_, _, _, _, _) => Err("encode-failed PRIORITY send decision has no protocol failure")
	end
end

pub fn priority_bytes(decision: CorePrioritySendDecision) -> ByteChunk
	match decision
		CorePrioritySendDecision::Accepted(_, _, _, _, _, bytes) => bytes
		_ => byte_chunk([])
	end
end

pub fn priority_encode_reason(decision: CorePrioritySendDecision) -> String
	match decision
		CorePrioritySendDecision::EncodeFailed(_, _, _, _, reason) => reason
		_ => "none"
	end
end

pub fn failure_id(failure: CoreOutboundStreamControlFailure) -> String
	match failure
		CoreOutboundStreamControlFailure::StreamInvalidStreamId(_, _, _, _, _, _, _, _) => "http2.protocol.invalid_stream_id"
		CoreOutboundStreamControlFailure::StreamInvalidFrameKind(_, _, _, _, _, _, _) => "http2.protocol.invalid_frame_kind"
		CoreOutboundStreamControlFailure::PriorityDependency(_, _, _, _, _, _) => "http2.protocol.priority_dependency"
		CoreOutboundStreamControlFailure::StreamAfterGoaway(_, _, _, _, _, _, _) => "http2.protocol.stream_after_goaway"
	end
end

pub fn failure_offset(failure: CoreOutboundStreamControlFailure) -> Int
	match failure
		CoreOutboundStreamControlFailure::StreamInvalidStreamId(offset, _, _, _, _, _, _, _) => offset
		CoreOutboundStreamControlFailure::StreamInvalidFrameKind(offset, _, _, _, _, _, _) => offset
		CoreOutboundStreamControlFailure::PriorityDependency(offset, _, _, _, _, _) => offset
		CoreOutboundStreamControlFailure::StreamAfterGoaway(offset, _, _, _, _, _, _) => offset
	end
end

pub fn failure_frame_kind(failure: CoreOutboundStreamControlFailure) -> Int
	match failure
		CoreOutboundStreamControlFailure::StreamInvalidStreamId(_, frame_kind, _, _, _, _, _, _) => frame_kind
		CoreOutboundStreamControlFailure::StreamInvalidFrameKind(_, frame_kind, _, _, _, _, _) => frame_kind
		CoreOutboundStreamControlFailure::PriorityDependency(_, _, _, _, _, _) => 2
		CoreOutboundStreamControlFailure::StreamAfterGoaway(_, _, _, _, _, _, _) => 2
	end
end

pub fn failure_stream_id(failure: CoreOutboundStreamControlFailure) -> Int
	match failure
		CoreOutboundStreamControlFailure::StreamInvalidStreamId(_, _, stream_id, _, _, _, _, _) => stream_id
		CoreOutboundStreamControlFailure::StreamInvalidFrameKind(_, _, stream_id, _, _, _, _) => stream_id
		CoreOutboundStreamControlFailure::PriorityDependency(_, stream_id, _, _, _, _) => stream_id
		CoreOutboundStreamControlFailure::StreamAfterGoaway(_, stream_id, _, _, _, _, _) => stream_id
	end
end

pub fn failure_dependency_stream_id(failure: CoreOutboundStreamControlFailure) -> Int
	match failure
		CoreOutboundStreamControlFailure::PriorityDependency(_, _, dependency_stream_id, _, _, _) => dependency_stream_id
		_ => 0
	end
end

pub fn failure_last_stream_id(failure: CoreOutboundStreamControlFailure) -> Int
	match failure
		CoreOutboundStreamControlFailure::StreamAfterGoaway(_, _, last_stream_id, _, _, _, _) => last_stream_id
		_ => 0
	end
end

pub fn failure_active_state(failure: CoreOutboundStreamControlFailure) -> String
	match failure
		CoreOutboundStreamControlFailure::StreamInvalidStreamId(_, _, _, _, _, active_state, _, _) => active_state
		CoreOutboundStreamControlFailure::StreamInvalidFrameKind(_, _, _, _, active_state, _, _) => active_state
		CoreOutboundStreamControlFailure::PriorityDependency(_, _, _, active_state, _, _) => active_state
		CoreOutboundStreamControlFailure::StreamAfterGoaway(_, _, _, shutdown_state, _, _, _) => shutdown_state
	end
end

pub fn failure_rule_provenance(failure: CoreOutboundStreamControlFailure) -> String
	match failure
		CoreOutboundStreamControlFailure::StreamInvalidStreamId(_, _, _, _, _, _, rule_provenance, _) => rule_provenance
		CoreOutboundStreamControlFailure::StreamInvalidFrameKind(_, _, _, _, _, rule_provenance, _) => rule_provenance
		CoreOutboundStreamControlFailure::PriorityDependency(_, _, _, _, rule_provenance, _) => rule_provenance
		CoreOutboundStreamControlFailure::StreamAfterGoaway(_, _, _, _, _, rule_provenance, _) => rule_provenance
	end
end

pub fn failure_preview(failure: CoreOutboundStreamControlFailure) -> ByteChunk
	match failure
		CoreOutboundStreamControlFailure::StreamInvalidStreamId(_, _, _, _, _, _, _, preview) => preview
		CoreOutboundStreamControlFailure::StreamInvalidFrameKind(_, _, _, _, _, _, preview) => preview
		CoreOutboundStreamControlFailure::PriorityDependency(_, _, _, _, _, preview) => preview
		CoreOutboundStreamControlFailure::StreamAfterGoaway(_, _, _, _, _, _, preview) => preview
	end
end
