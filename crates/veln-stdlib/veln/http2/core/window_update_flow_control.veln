use prelude
use http2::core::connection_state
use http2::core::flow_control
use http2::core::stream_state

pub type CoreStreamWindowUpdateFlowControlDecision
	Accepted(CoreConnectionState)
	Rejected(CoreStreamWindowUpdateFlowControlFailure)
end

pub type CoreStreamWindowUpdateFlowControlFailure
	MissingStream(offset: Int, stream_id: Int, increment: Int, preview: ByteChunk)
	InvalidIncrement(offset: Int, stream_id: Int, increment: Int, accepted_min_value: Int, accepted_max_value: Int, stream_credit: Int, preview: ByteChunk)
	WindowExceeded(offset: Int, stream_id: Int, increment: Int, observed_value: Int, accepted_min_value: Int, accepted_max_value: Int, stream_credit: Int, preview: ByteChunk)
end

pub type CoreConnectionWindowUpdateFlowControlDecision
	Accepted(CoreConnectionState)
	Rejected(CoreConnectionWindowUpdateFlowControlFailure)
end

pub type CoreConnectionWindowUpdateFlowControlFailure
	InvalidIncrement(offset: Int, increment: Int, accepted_min_value: Int, accepted_max_value: Int, connection_credit: Int, preview: ByteChunk)
	WindowExceeded(offset: Int, increment: Int, observed_value: Int, accepted_min_value: Int, accepted_max_value: Int, connection_credit: Int, preview: ByteChunk)
end

pub fn apply_stream_window_update(state: CoreConnectionState, offset: Int, stream_id: Int, increment: Int, preview: ByteChunk) -> CoreStreamWindowUpdateFlowControlDecision
	match http2::core::stream_state::find_entry(http2::core::connection_state::streams(state), stream_id)
		Some(entry) => apply_existing_stream(state, offset, stream_id, increment, entry, preview)
		None => CoreStreamWindowUpdateFlowControlDecision::Rejected(CoreStreamWindowUpdateFlowControlFailure::MissingStream(offset, stream_id, increment, preview))
	end
end

pub fn apply_connection_window_update(state: CoreConnectionState, offset: Int, increment: Int, preview: ByteChunk) -> CoreConnectionWindowUpdateFlowControlDecision
	let connection_credit = http2::core::connection_state::connection_receive_credit(state)
	match http2::core::flow_control::window_update_increment(increment)
		Ok(checked_increment) => apply_connection_checked_increment(state, offset, checked_increment, connection_credit, preview)
		Err(failure) => CoreConnectionWindowUpdateFlowControlDecision::Rejected(CoreConnectionWindowUpdateFlowControlFailure::InvalidIncrement(offset, increment, http2::core::flow_control::failure_accepted_min_value(failure), http2::core::flow_control::failure_accepted_max_value(failure), http2::core::flow_control::connection_window_credit_value(connection_credit), preview))
	end
end

fn apply_existing_stream(state: CoreConnectionState, offset: Int, stream_id: Int, increment: Int, entry: CoreStreamEntry, preview: ByteChunk) -> CoreStreamWindowUpdateFlowControlDecision
	let stream_credit = http2::core::stream_state::entry_send_credit(entry)
	match http2::core::flow_control::window_update_increment(increment)
		Ok(checked_increment) => apply_checked_increment(state, offset, stream_id, checked_increment, stream_credit, preview)
		Err(failure) => CoreStreamWindowUpdateFlowControlDecision::Rejected(CoreStreamWindowUpdateFlowControlFailure::InvalidIncrement(offset, stream_id, increment, http2::core::flow_control::failure_accepted_min_value(failure), http2::core::flow_control::failure_accepted_max_value(failure), http2::core::flow_control::stream_window_credit_value(stream_credit), preview))
	end
end

fn apply_checked_increment(state: CoreConnectionState, offset: Int, stream_id: Int, increment: CoreWindowUpdateIncrement, stream_credit: CoreStreamWindowCredit, preview: ByteChunk) -> CoreStreamWindowUpdateFlowControlDecision
	let decision = http2::core::flow_control::refill_stream_window(stream_credit, increment)
	match http2::core::flow_control::credit_decision_status(decision)
		"accepted" => accept_state(state, stream_id, http2::core::flow_control::credit_decision_value(decision))
		_ => match http2::core::flow_control::credit_decision_failure(decision)
			Ok(failure) => CoreStreamWindowUpdateFlowControlDecision::Rejected(CoreStreamWindowUpdateFlowControlFailure::WindowExceeded(offset, stream_id, http2::core::flow_control::window_update_increment_value(increment), http2::core::flow_control::failure_observed_value(failure), http2::core::flow_control::failure_accepted_min_value(failure), http2::core::flow_control::failure_accepted_max_value(failure), http2::core::flow_control::stream_window_credit_value(stream_credit), preview))
			Err(_) => CoreStreamWindowUpdateFlowControlDecision::Rejected(CoreStreamWindowUpdateFlowControlFailure::MissingStream(offset, stream_id, http2::core::flow_control::window_update_increment_value(increment), preview))
		end
	end
end

fn accept_state(state: CoreConnectionState, stream_id: Int, next_stream_credit: Int) -> CoreStreamWindowUpdateFlowControlDecision
	match http2::core::flow_control::stream_window_credit(next_stream_credit)
		Ok(credit) => CoreStreamWindowUpdateFlowControlDecision::Accepted(http2::core::connection_state::with_streams(state, http2::core::stream_state::with_send_credit(http2::core::connection_state::streams(state), stream_id, credit)))
		Err(failure) => CoreStreamWindowUpdateFlowControlDecision::Rejected(CoreStreamWindowUpdateFlowControlFailure::WindowExceeded(0, stream_id, 0, http2::core::flow_control::failure_observed_value(failure), http2::core::flow_control::failure_accepted_min_value(failure), http2::core::flow_control::failure_accepted_max_value(failure), 0, byte_chunk([])))
	end
end

fn apply_connection_checked_increment(state: CoreConnectionState, offset: Int, increment: CoreWindowUpdateIncrement, connection_credit: CoreConnectionWindowCredit, preview: ByteChunk) -> CoreConnectionWindowUpdateFlowControlDecision
	let decision = http2::core::flow_control::refill_connection_window(connection_credit, increment)
	match http2::core::flow_control::credit_decision_status(decision)
		"accepted" => accept_connection_state(state, http2::core::flow_control::credit_decision_value(decision))
		_ => match http2::core::flow_control::credit_decision_failure(decision)
			Ok(failure) => CoreConnectionWindowUpdateFlowControlDecision::Rejected(CoreConnectionWindowUpdateFlowControlFailure::WindowExceeded(offset, http2::core::flow_control::window_update_increment_value(increment), http2::core::flow_control::failure_observed_value(failure), http2::core::flow_control::failure_accepted_min_value(failure), http2::core::flow_control::failure_accepted_max_value(failure), http2::core::flow_control::connection_window_credit_value(connection_credit), preview))
			Err(_) => CoreConnectionWindowUpdateFlowControlDecision::Rejected(CoreConnectionWindowUpdateFlowControlFailure::InvalidIncrement(offset, http2::core::flow_control::window_update_increment_value(increment), 1, http2::core::flow_control::max_value(), http2::core::flow_control::connection_window_credit_value(connection_credit), preview))
		end
	end
end

fn accept_connection_state(state: CoreConnectionState, next_connection_credit: Int) -> CoreConnectionWindowUpdateFlowControlDecision
	match http2::core::flow_control::connection_window_credit(next_connection_credit)
		Ok(credit) => CoreConnectionWindowUpdateFlowControlDecision::Accepted(http2::core::connection_state::with_connection_receive_credit(state, credit))
		Err(failure) => CoreConnectionWindowUpdateFlowControlDecision::Rejected(CoreConnectionWindowUpdateFlowControlFailure::WindowExceeded(0, 0, http2::core::flow_control::failure_observed_value(failure), http2::core::flow_control::failure_accepted_min_value(failure), http2::core::flow_control::failure_accepted_max_value(failure), 0, byte_chunk([])))
	end
end

pub fn decision_status(decision: CoreStreamWindowUpdateFlowControlDecision) -> String
	match decision
		CoreStreamWindowUpdateFlowControlDecision::Accepted(_) => "accepted"
		CoreStreamWindowUpdateFlowControlDecision::Rejected(_) => "rejected"
	end
end

pub fn decision_state(decision: CoreStreamWindowUpdateFlowControlDecision) -> Result<CoreConnectionState, String>
	match decision
		CoreStreamWindowUpdateFlowControlDecision::Accepted(state) => Ok(state)
		CoreStreamWindowUpdateFlowControlDecision::Rejected(_) => Err("rejected stream WINDOW_UPDATE flow-control decision has no state")
	end
end

pub fn decision_failure(decision: CoreStreamWindowUpdateFlowControlDecision) -> Result<CoreStreamWindowUpdateFlowControlFailure, String>
	match decision
		CoreStreamWindowUpdateFlowControlDecision::Accepted(_) => Err("accepted stream WINDOW_UPDATE flow-control decision has no failure")
		CoreStreamWindowUpdateFlowControlDecision::Rejected(failure) => Ok(failure)
	end
end

pub fn failure_id(failure: CoreStreamWindowUpdateFlowControlFailure) -> String
	match failure
		CoreStreamWindowUpdateFlowControlFailure::MissingStream(_, _, _, _) => "http2.protocol.invalid_stream_reference"
		CoreStreamWindowUpdateFlowControlFailure::InvalidIncrement(_, _, _, _, _, _, _) => "http2.flow_control.invalid_window_update_increment"
		CoreStreamWindowUpdateFlowControlFailure::WindowExceeded(_, _, _, _, _, _, _, _) => "http2.flow_control.window_exceeded"
	end
end

pub fn failure_offset(failure: CoreStreamWindowUpdateFlowControlFailure) -> Int
	match failure
		CoreStreamWindowUpdateFlowControlFailure::MissingStream(offset, _, _, _) => offset
		CoreStreamWindowUpdateFlowControlFailure::InvalidIncrement(offset, _, _, _, _, _, _) => offset
		CoreStreamWindowUpdateFlowControlFailure::WindowExceeded(offset, _, _, _, _, _, _, _) => offset
	end
end

pub fn failure_stream_id(failure: CoreStreamWindowUpdateFlowControlFailure) -> Int
	match failure
		CoreStreamWindowUpdateFlowControlFailure::MissingStream(_, stream_id, _, _) => stream_id
		CoreStreamWindowUpdateFlowControlFailure::InvalidIncrement(_, stream_id, _, _, _, _, _) => stream_id
		CoreStreamWindowUpdateFlowControlFailure::WindowExceeded(_, stream_id, _, _, _, _, _, _) => stream_id
	end
end

pub fn failure_increment(failure: CoreStreamWindowUpdateFlowControlFailure) -> Int
	match failure
		CoreStreamWindowUpdateFlowControlFailure::MissingStream(_, _, increment, _) => increment
		CoreStreamWindowUpdateFlowControlFailure::InvalidIncrement(_, _, increment, _, _, _, _) => increment
		CoreStreamWindowUpdateFlowControlFailure::WindowExceeded(_, _, increment, _, _, _, _, _) => increment
	end
end

pub fn failure_domain(failure: CoreStreamWindowUpdateFlowControlFailure) -> String
	match failure
		CoreStreamWindowUpdateFlowControlFailure::MissingStream(_, _, _, _) => "stream_reference"
		CoreStreamWindowUpdateFlowControlFailure::InvalidIncrement(_, _, _, _, _, _, _) => "window_update_increment"
		CoreStreamWindowUpdateFlowControlFailure::WindowExceeded(_, _, _, _, _, _, _, _) => "stream_window_credit"
	end
end

pub fn failure_observed_value(failure: CoreStreamWindowUpdateFlowControlFailure) -> Int
	match failure
		CoreStreamWindowUpdateFlowControlFailure::MissingStream(_, _, _, _) => 0
		CoreStreamWindowUpdateFlowControlFailure::InvalidIncrement(_, _, increment, _, _, _, _) => increment
		CoreStreamWindowUpdateFlowControlFailure::WindowExceeded(_, _, _, observed_value, _, _, _, _) => observed_value
	end
end

pub fn failure_stream_credit(failure: CoreStreamWindowUpdateFlowControlFailure) -> Int
	match failure
		CoreStreamWindowUpdateFlowControlFailure::MissingStream(_, _, _, _) => 0
		CoreStreamWindowUpdateFlowControlFailure::InvalidIncrement(_, _, _, _, _, stream_credit, _) => stream_credit
		CoreStreamWindowUpdateFlowControlFailure::WindowExceeded(_, _, _, _, _, _, stream_credit, _) => stream_credit
	end
end

pub fn failure_preview(failure: CoreStreamWindowUpdateFlowControlFailure) -> ByteChunk
	match failure
		CoreStreamWindowUpdateFlowControlFailure::MissingStream(_, _, _, preview) => preview
		CoreStreamWindowUpdateFlowControlFailure::InvalidIncrement(_, _, _, _, _, _, preview) => preview
		CoreStreamWindowUpdateFlowControlFailure::WindowExceeded(_, _, _, _, _, _, _, preview) => preview
	end
end

pub fn connection_decision_status(decision: CoreConnectionWindowUpdateFlowControlDecision) -> String
	match decision
		CoreConnectionWindowUpdateFlowControlDecision::Accepted(_) => "accepted"
		CoreConnectionWindowUpdateFlowControlDecision::Rejected(_) => "rejected"
	end
end

pub fn connection_decision_state(decision: CoreConnectionWindowUpdateFlowControlDecision) -> Result<CoreConnectionState, String>
	match decision
		CoreConnectionWindowUpdateFlowControlDecision::Accepted(state) => Ok(state)
		CoreConnectionWindowUpdateFlowControlDecision::Rejected(_) => Err("rejected connection WINDOW_UPDATE flow-control decision has no state")
	end
end

pub fn connection_decision_failure(decision: CoreConnectionWindowUpdateFlowControlDecision) -> Result<CoreConnectionWindowUpdateFlowControlFailure, String>
	match decision
		CoreConnectionWindowUpdateFlowControlDecision::Accepted(_) => Err("accepted connection WINDOW_UPDATE flow-control decision has no failure")
		CoreConnectionWindowUpdateFlowControlDecision::Rejected(failure) => Ok(failure)
	end
end

pub fn connection_failure_id(failure: CoreConnectionWindowUpdateFlowControlFailure) -> String
	match failure
		CoreConnectionWindowUpdateFlowControlFailure::InvalidIncrement(_, _, _, _, _, _) => "http2.flow_control.invalid_window_update_increment"
		CoreConnectionWindowUpdateFlowControlFailure::WindowExceeded(_, _, _, _, _, _, _) => "http2.flow_control.window_exceeded"
	end
end

pub fn connection_failure_offset(failure: CoreConnectionWindowUpdateFlowControlFailure) -> Int
	match failure
		CoreConnectionWindowUpdateFlowControlFailure::InvalidIncrement(offset, _, _, _, _, _) => offset
		CoreConnectionWindowUpdateFlowControlFailure::WindowExceeded(offset, _, _, _, _, _, _) => offset
	end
end

pub fn connection_failure_increment(failure: CoreConnectionWindowUpdateFlowControlFailure) -> Int
	match failure
		CoreConnectionWindowUpdateFlowControlFailure::InvalidIncrement(_, increment, _, _, _, _) => increment
		CoreConnectionWindowUpdateFlowControlFailure::WindowExceeded(_, increment, _, _, _, _, _) => increment
	end
end

pub fn connection_failure_domain(failure: CoreConnectionWindowUpdateFlowControlFailure) -> String
	match failure
		CoreConnectionWindowUpdateFlowControlFailure::InvalidIncrement(_, _, _, _, _, _) => "window_update_increment"
		CoreConnectionWindowUpdateFlowControlFailure::WindowExceeded(_, _, _, _, _, _, _) => "connection_window_credit"
	end
end

pub fn connection_failure_observed_value(failure: CoreConnectionWindowUpdateFlowControlFailure) -> Int
	match failure
		CoreConnectionWindowUpdateFlowControlFailure::InvalidIncrement(_, increment, _, _, _, _) => increment
		CoreConnectionWindowUpdateFlowControlFailure::WindowExceeded(_, _, observed_value, _, _, _, _) => observed_value
	end
end

pub fn connection_failure_connection_credit(failure: CoreConnectionWindowUpdateFlowControlFailure) -> Int
	match failure
		CoreConnectionWindowUpdateFlowControlFailure::InvalidIncrement(_, _, _, _, connection_credit, _) => connection_credit
		CoreConnectionWindowUpdateFlowControlFailure::WindowExceeded(_, _, _, _, _, connection_credit, _) => connection_credit
	end
end

pub fn connection_failure_preview(failure: CoreConnectionWindowUpdateFlowControlFailure) -> ByteChunk
	match failure
		CoreConnectionWindowUpdateFlowControlFailure::InvalidIncrement(_, _, _, _, _, preview) => preview
		CoreConnectionWindowUpdateFlowControlFailure::WindowExceeded(_, _, _, _, _, _, preview) => preview
	end
end
