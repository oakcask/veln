	http2::core::local_settings::policy_with_enable_connect_protocol(policy, value, item_offset)
end

pub fn local_settings_send_status(decision: LocalSettingsSendDecision) -> String
	match decision
		LocalSettingsSent(_, _, _, _, _) => "accepted"
		LocalSettingsRejected(_) => "rejected"
		LocalSettingsEncodeFailed(_, _, _) => "encode_error"
	end
end

pub fn local_settings_send_identifier(decision: LocalSettingsSendDecision) -> Int
	match decision
		LocalSettingsSent(identifier, _, _, _, _) => identifier
		LocalSettingsRejected(failure) => http2::core::local_settings::failure_setting_identifier(failure)
		LocalSettingsEncodeFailed(_, _, _) => 0
	end
end

pub fn local_settings_send_value(decision: LocalSettingsSendDecision) -> Int
	match decision
		LocalSettingsSent(_, value, _, _, _) => value
		LocalSettingsRejected(failure) => http2::core::local_settings::failure_observed_value(failure)
		LocalSettingsEncodeFailed(_, _, _) => 0
	end
end

pub fn local_settings_send_policy(decision: LocalSettingsSendDecision) -> LocalSettingsPolicy
	match decision
		LocalSettingsSent(_, _, policy, _, _) => policy
		LocalSettingsRejected(_) => http2::core::local_settings::empty_policy()
		LocalSettingsEncodeFailed(policy, _, _) => policy
	end
end

pub fn local_settings_send_ack_state(decision: LocalSettingsSendDecision) -> SettingsAckState
	match decision
		LocalSettingsSent(_, _, _, ack_state, _) => ack_state
		LocalSettingsRejected(_) => http2::core::settings_ack::empty()
		LocalSettingsEncodeFailed(_, ack_state, _) => ack_state
	end
end

pub fn local_settings_send_bytes(decision: LocalSettingsSendDecision) -> ByteChunk
	match decision
		LocalSettingsSent(_, _, _, _, bytes) => bytes
		LocalSettingsRejected(_) => byte_chunk([])
		LocalSettingsEncodeFailed(_, _, _) => byte_chunk([])
	end
end

pub fn local_settings_send_encode_reason(decision: LocalSettingsSendDecision) -> String
	match decision
		LocalSettingsSent(_, _, _, _, _) => "none"
		LocalSettingsRejected(_) => "none"
		LocalSettingsEncodeFailed(_, _, reason) => reason
	end
end

pub fn local_settings_send_failure(decision: LocalSettingsSendDecision) -> Result<LocalSettingsFailure, String>
	match decision
		LocalSettingsSent(_, _, _, _, _) => Err("accepted local SETTINGS send has no failure")
		LocalSettingsRejected(failure) => Ok(failure)
		LocalSettingsEncodeFailed(_, _, _) => Err("encoded local SETTINGS send has no protocol failure")
	end
end

