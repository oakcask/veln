pub fn send_local_settings_batch(items: List<LocalSettingsItem>, endpoint_role: String, policy: LocalSettingsPolicy, ack_state: SettingsAckState) -> Result<LocalSettingsSendDecision, String>
	local_settings_transition_to_decision(policy, ack_state, http2::core::local_settings::send_batch(items, endpoint_role, policy)?)
end

pub fn send_local_setting(item: LocalSettingsItem, endpoint_role: String, policy: LocalSettingsPolicy, ack_state: SettingsAckState) -> Result<LocalSettingsSendDecision, String>
	local_settings_transition_to_decision(policy, ack_state, http2::core::local_settings::send_single(item, endpoint_role, policy)?)
end

fn local_settings_transition_to_decision(input_policy: LocalSettingsPolicy, input_ack_state: SettingsAckState, transition: LocalSettingsTransition) -> Result<LocalSettingsSendDecision, String>
	match http2::core::local_settings::status(transition)
		"accepted" => Ok(LocalSettingsSent(http2::core::local_settings::first_identifier(transition), http2::core::local_settings::first_value(transition), http2::core::local_settings::policy(transition), http2::core::settings_ack::record_local_batch(input_ack_state, http2::core::local_settings::first_identifier(transition), http2::core::local_settings::item_count(transition)), http2::core::local_settings::bytes(transition)))
		"rejected" => Ok(LocalSettingsRejected(http2::core::local_settings::transition_failure(transition)?))
		_ => Ok(LocalSettingsEncodeFailed(input_policy, input_ack_state, http2::core::local_settings::encode_reason(transition)))
	end
end

