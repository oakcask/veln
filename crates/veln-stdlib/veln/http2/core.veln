pub type ConnectionPrefaceFailure = http2::core::connection_preface::ConnectionPrefaceFailure

pub type FramePayloadLength = http2::core::frame_payload_length::FramePayloadLength

pub type FramePayloadLengthFailure = http2::core::frame_payload_length::FramePayloadLengthFailure

pub type InitialPeerSettingsGateState = http2::core::initial_peer_settings::InitialPeerSettingsGateState

pub type InitialPeerSettingsAcceptedState = http2::core::initial_peer_settings::InitialPeerSettingsAcceptedState

pub type InitialPeerSettingsTransition = http2::core::initial_peer_settings::InitialPeerSettingsTransition

pub type InitialPeerSettingsFailure = http2::core::initial_peer_settings::InitialPeerSettingsFailure

pub type PendingHeaderBlock = http2::core::pending_header_block::PendingHeaderBlock

pub type HeaderBlockTransition = http2::core::pending_header_block::HeaderBlockTransition

