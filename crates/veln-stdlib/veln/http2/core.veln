pub type LocalSettingsSendDecision
	LocalSettingsSent(Int, Int, LocalSettingsPolicy, SettingsAckState, ByteChunk)
	LocalSettingsRejected(LocalSettingsFailure)
	LocalSettingsEncodeFailed(LocalSettingsPolicy, SettingsAckState, String)
end

pub type StreamId
	ValidatedStreamId(Int)
end

pub type StreamRef
	ConnectionStream
	RealStream(StreamId)
end

pub fn stream_id(value: Int) -> Result<StreamId, String>
	if value > 0 and value <= 2147483647
		Ok(ValidatedStreamId(value))
	else
		Err("stream id must be between 1 and 2147483647")
	end
end

pub fn client_stream_id(value: Int) -> Result<StreamId, String>
	let validated: StreamId = stream_id(value)?
	if value / 2 * 2 != value
		Ok(validated)
	else
		Err("client-initiated stream id must be odd")
	end
end

pub fn server_stream_id(value: Int) -> Result<StreamId, String>
	let validated: StreamId = stream_id(value)?
	if value / 2 * 2 == value
		Ok(validated)
	else
		Err("server-initiated stream id must be even")
	end
end

pub fn connection_stream_ref() -> StreamRef
	ConnectionStream
end

pub fn real_stream_ref(stream_id: StreamId) -> StreamRef
	RealStream(stream_id)
end

pub fn stream_id_value(stream_id: StreamId) -> Int
	match stream_id
		ValidatedStreamId(value) => value
	end
end

pub fn stream_ref_value(stream_ref: StreamRef) -> Int
	match stream_ref
		ConnectionStream => 0
		RealStream(ValidatedStreamId(value)) => value
	end
end

pub fn stream_ref_is_connection(stream_ref: StreamRef) -> Bool
	match stream_ref
		ConnectionStream => true
		RealStream(_) => false
	end
end

pub fn stream_ref_is_real(stream_ref: StreamRef) -> Bool
	match stream_ref
		ConnectionStream => false
		RealStream(_) => true
	end
end

