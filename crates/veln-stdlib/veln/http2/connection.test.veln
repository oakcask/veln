use prelude
use transport
use net
use http2::connection_test_support_test
use http2::connection_client_test_support_test
use http2::connection_client_system_test_support_test
use http2::connection_service_test_support_test
use http2::connection
use http2::core
use http2::hpack
use transport::net_resource_test_support_test
use test_clock

fn ascii_header(name: String, value: String) -> Result<HeaderField, String>
	Ok(http2::hpack::header_field(name, byte_chunk_from_visible_ascii_string(value)?))
end

fn response_headers() -> Result<HeaderList, String>
	Ok(http2::hpack::prepend_header_field(ascii_header(":status", "204")?, http2::hpack::empty_header_list()))
end

fn response_headers_with_length(length: String) -> Result<HeaderList, String>
	Ok(http2::hpack::prepend_header_field(ascii_header(":status", "200")?, http2::hpack::prepend_header_field(ascii_header("content-length", length)?, http2::hpack::empty_header_list())))
end

fn client_request_headers() -> Result<HeaderList, String>
	Ok(http2::hpack::prepend_header_field(ascii_header(":method", "GET")?, http2::hpack::prepend_header_field(ascii_header(":scheme", "https")?, http2::hpack::prepend_header_field(ascii_header(":path", "/")?, http2::hpack::empty_header_list()))))
end

fn client_one_request() -> Result<List<Http2ClientRequest>, String>
	Ok(list_cons(http2::connection::client_bodyless_request(client_request_headers()?), list_nil()))
end

fn observe_client_response_with_db(response: Http2ClientResponse) -> Result<(), String> effects [db]
	let _ = http2::connection::client_response_stream_id(response)
	Ok(())
end

test production_client_installs_system_handler_and_preserves_callback_effects() -> Result<(), String> effects [net, time, concurrency, db]
	let calls = channel::bounded<List<String>>(1)
	let _ = channel::send(calls.tx, list_nil())
	let result = handle handle http2::connection::request_endpoint_sequence_tcp(net::Address(net::Tcp4, "production-client.test", 443), client_one_request()?, observe_client_response_with_db) with http2::connection_client_system_test_support_test::failing_resolution(calls) with test_clock::clock(0, 0, 0, 0, 0)
	let observed: List<String> = option_unwrap_or(channel::recv(calls.rx), list_nil())
	match result
		Err(Http2ClientServiceFailure::Http2ClientServiceNetworkFailure(completed, net::NetError(_, _, _, net::NameNotFound, _))) => if completed == 0
			match observed
				Cons(operation, Nil) => if operation == "resolve_tcp4"
					Ok(())
				else
					Err("HTTP/2 production client used an unexpected host network operation")
				end
				_ => Err("HTTP/2 production client did not perform exactly one host resolution")
			end
		else
			Err("HTTP/2 production client changed the completed request count")
		end
		Err(_) => Err("HTTP/2 production client did not preserve the system handler failure")
		Ok(_) => Err("HTTP/2 production client ignored the system handler failure")
	end
end

fn application_request_chunk() -> Result<ByteChunk, String>
	byte_chunk_from_hex("505249202a20485454502f322e300d0a0d0a534d0d0a0d0a000006040000000000000500008000000003010500000001828784")
end

fn application_body_request_chunk() -> Result<ByteChunk, String>
	byte_chunk_from_hex("505249202a20485454502f322e300d0a0d0a534d0d0a0d0a000006040000000000000500008000000003010400000001828784")
end

fn application_two_request_chunk() -> Result<ByteChunk, String>
	byte_chunk_from_hex("505249202a20485454502f322e300d0a0d0a534d0d0a0d0a000006040000000000000500008000000003010500000001828784000003010500000003828785")
end

fn service_protocol_failure_chunk() -> Result<ByteChunk, String>
	byte_chunk_from_hex("505249202a20485454502f322e300d0a0d0a534d0d0a0d0a000006040000000000000500008000000003010500000000")
end

fn fail_if_called_handler(event: Http2ApplicationEvent) -> Result<List<Http2ApplicationAction>, String>
	let _ = http2::core::application_event_stream_id(event)
	Err("callback should not run")
end

fn bodyless_handler(event: Http2ApplicationEvent) -> Result<List<Http2ApplicationAction>, String>
	Ok(list_cons(Http2ApplicationAction::Http2SendResponseHeaders(http2::core::application_event_stream_id(event), response_headers()?, true), list_nil()))
end

fn reject_client_response(response: Http2ClientResponse) -> Result<(), String>
	let _ = http2::connection::client_response_stream_id(response)
	Err("callback rejected response")
end

fn invalid_action_handler(event: Http2ApplicationEvent) -> Result<List<Http2ApplicationAction>, String>
	Ok(list_cons(Http2ApplicationAction::Http2SendResponseData(http2::core::application_event_stream_id(event), byte_chunk_from_hex("0a")?, true), list_nil()))
end

fn mismatched_stream_handler(event: Http2ApplicationEvent) -> Result<List<Http2ApplicationAction>, String>
	Ok(list_cons(Http2ApplicationAction::Http2SendResponseHeaders(http2::core::application_event_stream_id(event) + 2, response_headers()?, true), list_nil()))
end

fn rejected_data_handler(event: Http2ApplicationEvent) -> Result<List<Http2ApplicationAction>, String>
	let stream_id = http2::core::application_event_stream_id(event)
	Ok(list_cons(Http2ApplicationAction::Http2SendResponseHeaders(stream_id, response_headers_with_length("5")?, false), list_cons(Http2ApplicationAction::Http2SendResponseData(stream_id, byte_chunk_from_hex("0a0b")?, true), list_nil())))
end

fn join_failure_handler(event: Http2ApplicationEvent) -> Result<List<Http2ApplicationAction>, String>
	require false
	bodyless_handler(event)
end

fn run_tcp_service<effect E>(mode: String, request: ByteChunk, handler: fn(Http2ApplicationEvent) -> Result<List<Http2ApplicationAction>, String> effects [...E]) -> Result<{ result : Result<(), Http2ServiceFailure>, trace : List<String> }, String> effects [net, time, concurrency, ...E]
	let trace = channel::bounded<List<String>>(1)
	let _ = channel::send(trace.tx, list_nil())
	handle handle run_tcp_service_with_resources(handler, trace) with net::system() with http2::connection_service_test_support_test::scripted_network(mode, request, trace)
end

fn run_tcp_service_with_resources<effect E>(handler: fn(Http2ApplicationEvent) -> Result<List<Http2ApplicationAction>, String> effects [...E], trace: { tx : Sender<List<String>>, rx : Receiver<List<String>> }) -> Result<{ result : Result<(), Http2ServiceFailure>, trace : List<String> }, String> effects [net::IO, concurrency, ...E]
	let listener = transport::net_resource_test_support_test::listener_or_message("service-listener")?
	let result = http2::connection::serve_tcp(listener, handler)
	let observed: List<String> = option_unwrap_or(channel::recv(trace.rx), list_nil())
	Ok({ result: result, trace: observed })
end

fn run_later_connection_failure(mode: String) -> Result<{ result : Result<(), Http2ServiceFailure>, trace : List<String> }, String> effects [net, time, concurrency]
	let trace = channel::bounded<List<String>>(1)
	let _ = channel::send(trace.tx, list_nil())
	handle handle run_later_connection_failure_with_resources(trace) with net::system() with http2::connection_service_test_support_test::later_connection_network(mode, application_request_chunk()?, trace)
end

fn run_later_connection_failure_with_resources(trace: { tx : Sender<List<String>>, rx : Receiver<List<String>> }) -> Result<{ result : Result<(), Http2ServiceFailure>, trace : List<String> }, String> effects [net::IO, concurrency]
	let listener = transport::net_resource_test_support_test::listener_or_message("later-service-listener")?
	let result = http2::connection::serve_tcp(listener, bodyless_handler)
	let observed: List<String> = option_unwrap_or(channel::recv(trace.rx), list_nil())
	Ok({ result: result, trace: observed })
end

fn service_network_failure_matches(result: Result<(), Http2ServiceFailure>, accepted: Int, operation: String, message: String) -> Bool
	match result
		Err(failure) => if http2::connection::service_failure_kind(failure) == "network" and http2::connection::service_failure_id(failure) == "http2.service.network_failure" and http2::connection::service_failure_accepted(failure) == accepted
			match failure
				Http2ServiceFailure::Http2ServiceNetworkFailure(observed_accepted, net::NetError(observed_operation, _, _, net::ConnectionReset, _)) => observed_accepted == accepted and observed_operation == operation
				_ => false
			end
		else
			false
		end
		Ok(_) => false
	end
end

fn trace_count(trace: List<String>, operation: String) -> Int
	match trace
		Nil => 0
		Cons(head, tail) => if head == operation
			1 + trace_count(tail, operation)
		else
			trace_count(tail, operation)
		end
	end
end

fn service_cleanup_trace_matches(trace: List<String>) -> Bool
	match trace
		Cons("close-listener", Cons("close-stream", _)) => trace_count(trace, "close-listener") == 1 and trace_count(trace, "close-stream") == 1 and trace_count(trace, "accept") == 1
		_ => false
	end
end

fn trace_operation_has_earlier(trace: List<String>, operation: String, earlier: String) -> Bool
	match trace
		Nil => false
		Cons(head, tail) => if head == operation
			trace_count(tail, earlier) > 0
		else
			trace_operation_has_earlier(tail, operation, earlier)
		end
	end
end

fn later_connection_cleanup_trace_matches(trace: List<String>) -> Bool
	match trace
		Cons("close-listener", _) => trace_count(trace, "accept-first") == 1 and trace_count(trace, "accept-second") == 1 and trace_count(trace, "accept-extra") == 0 and trace_count(trace, "close-first") == 1 and trace_count(trace, "close-second") == 1 and trace_count(trace, "close-listener") == 1 and trace_operation_has_earlier(trace, "accept-second", "close-first") and trace_operation_has_earlier(trace, "close-listener", "close-second")
		_ => false
	end
end

fn transport_failure(operation: String, message: String) -> net::NetError
	net::NetError(operation, Some(net::Tcp6), Some("[2001:db8::1]:443"), net::ConnectionReset, message)
end

fn connection_transport_failure_matches(result: Result<CoreConnectionState, Http2ConnectionFailure>, operation: String, message: String) -> Result<(), String>
	match result
		Err(failure) => if http2::connection::connection_failure_kind(failure) == "transport" and http2::connection::connection_failure_id(failure) == "http2.connection.transport_failure" and http2::connection::connection_failure_source(failure) == operation and http2::connection::connection_failure_reason(failure) == message
			match failure
				Http2ConnectionFailure::Http2ConnectionTransportFailure(net::NetError(observed_operation, Some(net::Tcp6), Some("[2001:db8::1]:443"), net::ConnectionReset, observed_message)) => if observed_operation == operation and observed_message == message
					Ok(())
				else
					Err("HTTP/2 connection changed the network failure fields")
				end
				_ => Err("HTTP/2 connection transport projections did not identify a transport variant")
			end
		else
			Err(string::concat("HTTP/2 connection misclassified transport failure as ", http2::connection::connection_failure_kind(failure)))
		end
		Ok(_) => Err("HTTP/2 connection ignored the transport failure")
	end
end

fn application_transport_failure_matches(result: Result<CoreConnectionState, Http2ApplicationBoundaryFailure>, operation: String, message: String) -> Result<(), String>
	match result
		Err(failure) => if http2::connection::application_failure_kind(failure) == "transport" and http2::connection::application_failure_id(failure) == "http2.application.transport_failure" and http2::connection::application_failure_reason(failure) == message
			match failure
				Http2ApplicationBoundaryFailure::Http2ApplicationTransportFailure(net::NetError(observed_operation, Some(net::Tcp6), Some("[2001:db8::1]:443"), net::ConnectionReset, observed_message)) => if observed_operation == operation and observed_message == message
					Ok(())
				else
					Err("HTTP/2 application changed the network failure fields")
				end
				_ => Err("HTTP/2 application transport projections did not identify a transport variant")
			end
		else
			Err(string::concat("HTTP/2 application misclassified transport failure as ", http2::connection::application_failure_kind(failure)))
		end
		Ok(_) => Err("HTTP/2 application ignored the transport failure")
	end
end

test server_connection_preserves_duplex_write_failure() -> Result<(), String>
	let result = handle http2::connection::drive_server(http2::core::server_connection_state(0)?) with http2::connection_test_support_test::failing_duplex_write(transport_failure("write", "server write"))
	connection_transport_failure_matches(result, "write", "server write")
end

test server_connection_preserves_duplex_read_failure() -> Result<(), String>
	let result = handle http2::connection::drive_server(http2::core::server_connection_state(0)?) with http2::connection_test_support_test::failing_duplex_read(transport_failure("read", "server read"))
	connection_transport_failure_matches(result, "read", "server read")
end

test client_connection_preserves_duplex_write_failure() -> Result<(), String>
	let result = handle http2::connection::drive_client(http2::core::client_connection_state(0)?) with http2::connection_test_support_test::failing_duplex_write(transport_failure("write", "client write"))
	connection_transport_failure_matches(result, "write", "client write")
end

test application_boundary_preserves_duplex_read_failure_without_callback_classification() -> Result<(), String>
	let result = handle http2::connection::drive_server_application(http2::core::server_connection_state(0)?, fail_if_called_handler) with http2::connection_test_support_test::failing_duplex_read(transport_failure("read", "application read"))
	application_transport_failure_matches(result, "read", "application read")
end

test application_boundary_preserves_duplex_write_failure() -> Result<(), String>
	let result = handle http2::connection::drive_server_application(http2::core::server_connection_state(0)?, fail_if_called_handler) with http2::connection_test_support_test::failing_duplex_write(transport_failure("write", "application write"))
	application_transport_failure_matches(result, "write", "application write")
end

test tcp_service_preserves_accept_failure_before_progress() -> Result<(), String> effects [net, time, concurrency]
	match run_tcp_service("accept-failure", application_request_chunk()?, bodyless_handler)?
		{ result: result, trace: Cons("close-listener", Cons("accept", Nil)) } => if service_network_failure_matches(result, 0, "accept", "scripted accept failure")
			Ok(())
		else
			Err("HTTP/2 TCP service changed the accept failure or initial progress count")
		end
		_ => Err("HTTP/2 TCP service did not accept and close its listener exactly once")
	end
end

test tcp_service_preserves_accept_failure_after_one_completed_connection() -> Result<(), String> effects [net, time, concurrency]
	match run_tcp_service("ordinary", application_request_chunk()?, bodyless_handler)?
		{ result: result, trace: trace } => if service_network_failure_matches(result, 1, "accept", "scripted accept failure") and trace_count(trace, "accept") == 2 and trace_count(trace, "close-stream") == 1 and trace_count(trace, "close-listener") == 1
			Ok(())
		else
			Err("HTTP/2 TCP service did not retain progress through the next accept failure")
		end
	end
end

test tcp_service_iteration_is_bounded_across_many_completed_connections() -> Result<(), String> effects [net, time, concurrency]
	let connection_count = 5000
	let accepted = channel::bounded<Int>(1)
	let read_ready = channel::bounded<Bool>(1)
	let stream_closes = channel::bounded<Int>(1)
	let listener_closes = channel::bounded<Int>(1)
	let _ = channel::send(accepted.tx, 0)
	let _ = channel::send(read_ready.tx, false)
	let _ = channel::send(stream_closes.tx, 0)
	let _ = channel::send(listener_closes.tx, 0)
	handle handle tcp_service_many_completed_connections_with_resources(connection_count, accepted, read_ready, stream_closes, listener_closes) with net::system() with http2::connection_service_test_support_test::many_connections_network(connection_count, application_request_chunk()?, accepted, read_ready, stream_closes, listener_closes)
end

fn tcp_service_many_completed_connections_with_resources(connection_count: Int, accepted: { tx : Sender<Int>, rx : Receiver<Int> }, read_ready: { tx : Sender<Bool>, rx : Receiver<Bool> }, stream_closes: { tx : Sender<Int>, rx : Receiver<Int> }, listener_closes: { tx : Sender<Int>, rx : Receiver<Int> }) -> Result<(), String> effects [net::IO, concurrency]
	let listener = transport::net_resource_test_support_test::listener_or_message("many-service-listener")?
	let result = http2::connection::serve_tcp(listener, bodyless_handler)
	let observed_accepted: Int = option_unwrap_or(channel::recv(accepted.rx), -1)
	let observed_stream_closes: Int = option_unwrap_or(channel::recv(stream_closes.rx), -1)
	let observed_listener_closes: Int = option_unwrap_or(channel::recv(listener_closes.rx), -1)
	if service_network_failure_matches(result, connection_count, "accept", "scripted accept failure") and observed_accepted == connection_count and observed_stream_closes == connection_count and observed_listener_closes == 1
		Ok(())
	else
		match result
			Err(failure) => Err(string::concat(string::concat(string::concat(string::concat(string::concat(string::concat("HTTP/2 TCP service stopped as ", http2::connection::service_failure_kind(failure)), " after "), int_to_string(http2::connection::service_failure_accepted(failure))), " accepted; handler observed "), int_to_string(observed_accepted)), " accepts"))
			Ok(_) => Err("HTTP/2 TCP service completed without the terminal accept failure")
		end
	end
end

test tcp_service_promotes_adapter_read_failure_to_network_failure() -> Result<(), String> effects [net, time, concurrency]
	match run_tcp_service("read-failure", application_request_chunk()?, bodyless_handler)?
		{ result: result, trace: trace } => if service_network_failure_matches(result, 1, "read", "scripted read failure") and service_cleanup_trace_matches(trace)
			Ok(())
		else
			Err("HTTP/2 TCP service changed the adapter read failure or cleanup order")
		end
	end
end

