test application_action_values_are_public_and_immutable() -> Result<(), String>
	let headers = Http2ApplicationAction::Http2SendResponseHeaders(1, response_headers()?, true)
	let data = Http2ApplicationAction::Http2SendResponseData(1, byte_chunk_from_hex("0a0b")?, true)
	if http2::connection::application_action_kind(headers) == "headers" and http2::connection::application_action_stream_id(headers) == 1 and http2::connection::application_action_end_stream(headers) and http2::connection::application_action_kind(data) == "data" and http2::connection::application_action_stream_id(data) == 1 and http2::connection::application_action_end_stream(data)
		Ok(())
	else
		Err("HTTP/2 application action values did not expose stable immutable response fields")
	end
end

test application_failure_variants_remain_distinguishable() -> Result<(), String>
	let callback = Http2ApplicationBoundaryFailure::Http2ApplicationCallbackFailure("boom")
	let unsupported_shape = Http2ApplicationBoundaryFailure::Http2ApplicationUnsupportedRequestShape(1, "body")
	let unsupported_count = Http2ApplicationBoundaryFailure::Http2ApplicationUnsupportedRequestCount(3)
	let invalid = Http2ApplicationBoundaryFailure::Http2ApplicationInvalidActionSequence("bad", 2, 5, 1)
	if http2::connection::application_failure_kind(callback) == "callback" and http2::connection::application_failure_reason(callback) == "boom" and http2::connection::application_failure_kind(unsupported_shape) == "unsupported-request-shape" and http2::connection::application_failure_stream_id(unsupported_shape) == 1 and http2::connection::application_failure_kind(unsupported_count) == "unsupported-request-count" and http2::connection::application_failure_stream_id(unsupported_count) == 3 and http2::connection::application_failure_kind(invalid) == "invalid-action-sequence" and http2::connection::application_failure_action_index(invalid) == 2 and http2::connection::application_failure_stream_id(invalid) == 5
		Ok(())
	else
		Err("HTTP/2 application failure variants were not distinguishable")
	end
end

test application_driver_effect_boundary_handles_closed_state_without_callback() -> Result<(), String>
	let open = http2::core::server_connection_state(0)?
	let closed = http2::core::connection_state_with_lifecycle(open, http2::core::connection_lifecycle_closed(0, 0))
	let result = handle http2::connection::drive_server_application(closed, fail_if_called_handler) with http2::connection_test_support_test::fixed_duplex(byte_chunk([]))
	match result
		Ok(state) => if http2::core::connection_lifecycle_label(http2::core::connection_state_lifecycle(state)) == "closed"
			Ok(())
		else
			Err("HTTP/2 application driver did not preserve closed state")
		end
		Err(failure) => Err(http2::connection::application_failure_reason(failure))
	end
end

test client_reuse_decision_uses_public_lifecycle_and_capacity() -> Result<(), String>
	let open = http2::core::client_connection_state(0)?
	let closed = http2::core::connection_state_with_lifecycle(open, http2::core::connection_lifecycle_closed(0, 0))
	let draining = http2::core::connection_state_with_lifecycle(open, http2::core::connection_lifecycle_draining(0, 0))
	let zero_capacity = http2::core::connection_state_with_peer_settings(open, http2::core::apply_peer_settings_payload(http2::core::connection_state_peer_settings(open), 11, byte_chunk_from_hex("000300000000")?)?)
	if http2::connection::client_connection_reusable(open) and not http2::connection::client_connection_reusable(closed) and not http2::connection::client_connection_reusable(draining) and not http2::connection::client_connection_reusable(zero_capacity)
		Ok(())
	else
		Err("HTTP/2 client reuse decision did not respect lifecycle and peer stream capacity")
	end
end

test client_service_callback_failure_uses_ordinary_cleanup_path() -> Result<(), String> effects [net, time, concurrency]
	match run_client_service("ordinary", client_one_request()?, reject_client_response)?
		{ result: Err(failure), trace: trace } => if client_callback_failure_matches(failure)
			client_ordinary_trace_matches(trace)
		else
			Err("HTTP/2 client callback failure did not use the ordinary cleanup path")
		end
		_ => Err("HTTP/2 client service did not return the callback failure")
	end
end

fn client_ordinary_trace_matches(trace: List<{ operation : String, bytes : ByteChunk }>) -> Result<(), String>
	match trace
		Cons(closed, Cons(read, Cons(request, Cons(settings, Cons(preface, Cons(connected, Nil)))))) => if connected.operation == "connect" and preface.operation == "write" and settings.operation == "write" and request.operation == "write" and read.operation == "read" and closed.operation == "close"
			if client_write_matches(preface.bytes, "505249202a20485454502f322e300d0a0d0a534d0d0a0d0a")? and client_write_matches(settings.bytes, "000000040000000000")? and client_write_matches(request.bytes, "000003010500000001828784")?
				Ok(())
			else
				Err("HTTP/2 client changed the preface, SETTINGS, or request write bytes")
			end
		else
			Err("HTTP/2 client did not connect, write the preface, SETTINGS, and request, read, and close in order")
		end
		_ => Err("HTTP/2 client ordinary path performed an unexpected number of network operations")
	end
end

fn client_write_matches(actual: ByteChunk, expected_hex: String) -> Result<Bool, String>
	let expected = byte_chunk_from_hex(expected_hex)?
	let count = byte_count_to_int(byte_chunk_count(expected))
	if byte_count_to_int(byte_chunk_count(actual)) == count
		client_bytes_match_at(actual, expected, 0, count)
	else
		Ok(false)
	end
end

fn client_bytes_match_at(actual: ByteChunk, expected: ByteChunk, index: Int, count: Int) -> Result<Bool, String>
	if index == count
		Ok(true)
	else
		begin
			let actual_byte = byte_read_u8_be(byte_view(actual, byte_offset(index)?, byte_count(1)?)?)?
			let expected_byte = byte_read_u8_be(byte_view(expected, byte_offset(index)?, byte_count(1)?)?)?
			if actual_byte == expected_byte
				client_bytes_match_at(actual, expected, index + 1, count)
			else
				Ok(false)
			end
		end
	end
end

fn accept_client_response(response: Http2ClientResponse) -> Result<(), String>
	let _ = http2::connection::client_response_stream_id(response)
	Ok(())
end

fn client_two_requests() -> Result<List<Http2ClientRequest>, String>
	let request = http2::connection::client_bodyless_request(client_request_headers()?)
	Ok(list_cons(request, list_cons(request, list_nil())))
end

fn run_client_service<effect E>(mode: String, requests: List<Http2ClientRequest>, handler: fn(Http2ClientResponse) -> Result<(), String> effects [...E]) -> Result<{ result : Result<(), Http2ClientServiceFailure>, trace : List<{operation:String, bytes:ByteChunk}> }, String> effects [net, time, concurrency, ...E]
	let responses = channel::bounded<List<ByteChunk>>(1)
	let _ = channel::send(responses.tx, client_responses(mode)?)
	let trace = channel::bounded<List<{operation:String, bytes:ByteChunk}>>(1)
	let _ = channel::send(trace.tx, list_nil())
	handle handle run_client_service_with_resources(requests, handler, responses, trace) with net::system() with http2::connection_client_test_support_test::scripted_network(mode, responses, trace)
end

fn run_client_service_with_resources<effect E>(requests: List<Http2ClientRequest>, handler: fn(Http2ClientResponse) -> Result<(), String> effects [...E], responses: { tx : Sender<List<ByteChunk>>, rx : Receiver<List<ByteChunk>> }, trace: { tx : Sender<List<{operation:String, bytes:ByteChunk}>>, rx : Receiver<List<{operation:String, bytes:ByteChunk}>> }) -> Result<{ result : Result<(), Http2ClientServiceFailure>, trace : List<{operation:String, bytes:ByteChunk}> }, String> effects [net::IO, concurrency, ...E]
	let result = http2::connection::request_endpoint_sequence(net::Address(net::Tcp4, "127.0.0.1", 443), requests, handler)
	let observed: List<{ operation : String, bytes : ByteChunk }> = option_unwrap_or(channel::recv(trace.rx), list_nil())
	Ok({ result: result, trace: observed })
end

fn client_responses(mode: String) -> Result<List<ByteChunk>, String>
	if mode == "later-connect-failure" or mode == "replacement-close-failure"
		Ok(list_cons(byte_chunk_from_hex("00000604000000000000030000000000000101050000000189")?, list_nil()))
	else
		Ok(list_cons(byte_chunk_from_hex("00000004000000000000000101050000000189")?, list_cons(byte_chunk_from_hex("00000101050000000389")?, list_nil())))
	end
end

fn client_callback_failure_matches(failure: Http2ClientServiceFailure) -> Bool
	http2::connection::client_service_failure_kind(failure) == "callback" and http2::connection::client_service_failure_id(failure) == "http2.client_service.callback_failure" and http2::connection::client_service_failure_completed(failure) == 0 and http2::connection::client_service_failure_reason(failure) == "callback rejected response"
end

fn client_network_failure_matches(failure: Http2ClientServiceFailure, completed: Int, operation: String, message: String) -> Bool
	if http2::connection::client_service_failure_kind(failure) == "network" and http2::connection::client_service_failure_id(failure) == "http2.client_service.network_failure" and http2::connection::client_service_failure_completed(failure) == completed
		match failure
			Http2ClientServiceFailure::Http2ClientServiceNetworkFailure(observed_completed, net::NetError(observed_operation, _, _, net::ConnectionReset, _)) => observed_completed == completed and observed_operation == operation
			_ => false
		end
	else
		false
	end
end

fn client_trace_count(trace: List<{operation:String, bytes:ByteChunk}>, operation: String) -> Int
	match trace
		Nil => 0
		Cons(head, tail) => if head.operation == operation
			1 + client_trace_count(tail, operation)
		else
			client_trace_count(tail, operation)
		end
	end
end

test client_service_preserves_connect_failure() -> Result<(), String> effects [net, time, concurrency]
	match run_client_service("connect-failure", client_one_request()?, accept_client_response)?
		{ result: Err(failure), trace: Cons(connected, Nil) } => if connected.operation == "connect" and client_network_failure_matches(failure, 0, "connect", "scripted client connect failure")
			Ok(())
		else
			Err("HTTP/2 client changed the connect failure or completed count")
		end
		_ => Err("HTTP/2 client performed work after connect failed")
	end
end

test client_service_promotes_stream_read_failure_to_network_failure() -> Result<(), String> effects [net, time, concurrency]
	match run_client_service("read-failure", client_one_request()?, accept_client_response)?
		{ result: Err(failure), trace: trace } => if client_network_failure_matches(failure, 0, "read", "scripted client read failure") and client_trace_count(trace, "close") == 1
			Ok(())
		else
			Err("HTTP/2 client did not preserve and clean up after the read failure")
		end
		_ => Err("HTTP/2 client ignored the read failure")
	end
end

