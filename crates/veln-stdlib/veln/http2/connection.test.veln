		{ result: Err(failure), trace: trace } => if client_network_failure_matches(failure, 1, "connect", "scripted client connect failure") and client_trace_count(trace, "connect") == 2 and client_trace_count(trace, "close") == 1
			Ok(())
		else
			Err("HTTP/2 client later connect failure lost completed request progress")
