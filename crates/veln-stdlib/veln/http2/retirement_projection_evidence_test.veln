use prelude

fn retirement_projection_manifest_matches(count: Int, chunk_count: Int) -> Bool
	count == 3011 and chunk_count == 31
end

fn require_retirement_projection_manifest(id: String, count: Int, chunk_count: Int) -> Result<(), String>
	if retirement_projection_manifest_matches(count, chunk_count)
		Ok(())
	else
		Err(id)
	end
end

fn retirement_projection_row_matches(id: String, historical_key: String, evidence: String, endpoint_role: String, owning_operation: String, operation_branch: String, initial_state: String, ordered_setup: String, concrete_input: String, result_projection: String, output_provenance: String, failure_atomicity: String, diagnostic_precedence: String, required_post_state: String, executable_projection: String, projection_sha256: String) -> Bool
	id != "" and historical_key != "" and evidence != "" and endpoint_role != "" and owning_operation != "" and operation_branch != "" and initial_state != "" and ordered_setup != "" and concrete_input != "" and result_projection != "" and output_provenance != "" and failure_atomicity != "" and diagnostic_precedence != "" and required_post_state != "" and executable_projection != "" and projection_sha256 != ""
end

fn require_retirement_projection_row(id: String, historical_key: String, evidence: String, endpoint_role: String, owning_operation: String, operation_branch: String, initial_state: String, ordered_setup: String, concrete_input: String, result_projection: String, output_provenance: String, failure_atomicity: String, diagnostic_precedence: String, required_post_state: String, executable_projection: String, projection_sha256: String) -> Result<(), String>
	if retirement_projection_row_matches(id, historical_key, evidence, endpoint_role, owning_operation, operation_branch, initial_state, ordered_setup, concrete_input, result_projection, output_provenance, failure_atomicity, diagnostic_precedence, required_post_state, executable_projection, projection_sha256)
		Ok(())
	else
		Err(id)
	end
end

