	let checked: () = require_retirement_projection_chunk("http2-retirement-projection-chunk-0601_0700", 601, 700, 100, "9dd7a4996b7db7923b5fe7fb58979337d31a8087c8c9ac275d35931d7b382135", expected_retirement_projection_chunk_sha_0601_0700())?
	Ok(())
end

