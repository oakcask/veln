test retirement_projection_manifest_chunk_0801_0900() -> Result<(), String>
	let checked_rows_0801_0820: Int = require_retirement_projection_rows_0801_0820()?
	let checked_rows_0821_0840: Int = require_retirement_projection_rows_0821_0840()?
	let checked_rows_0841_0860: Int = require_retirement_projection_rows_0841_0860()?
