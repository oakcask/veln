	"a3638325e7b6e57ccf5b17df178664895f5c6edd61bed3987410d2e5eef463be"
end

test retirement_projection_manifest_chunk_0001_0100() -> Result<(), String>
	let checked: () = require_retirement_projection_chunk("http2-retirement-projection-chunk-0001_0100", 1, 100, 100, "a3638325e7b6e57ccf5b17df178664895f5c6edd61bed3987410d2e5eef463be", expected_retirement_projection_chunk_sha_0001_0100())?
	Ok(())
end

