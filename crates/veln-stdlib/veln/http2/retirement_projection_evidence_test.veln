	"9a9de252be66557df09e6047408f8ea72c48d12e898676b423703c7213cb5eec"
end

fn expected_retirement_projection_chunk_fingerprint_1801_1900() -> Int
	3019047151
end

test retirement_projection_manifest_chunk_1801_1900() -> Result<(), String>
	let checked_rows_1801_1820: Int = require_retirement_projection_rows_1801_1820()?
	let checked_rows_1821_1840: Int = require_retirement_projection_rows_1821_1840()?
	let checked_rows_1841_1860: Int = require_retirement_projection_rows_1841_1860()?
	let checked_rows_1861_1880: Int = require_retirement_projection_rows_1861_1880()?
	let checked_rows_1881_1900: Int = require_retirement_projection_rows_1881_1900()?
	let checked_fingerprint: () = require_retirement_projection_chunk_fingerprint("http2-retirement-projection-chunk-fingerprint-1801_1900", checked_rows_1801_1820 + checked_rows_1821_1840 + checked_rows_1841_1860 + checked_rows_1861_1880 + checked_rows_1881_1900, expected_retirement_projection_chunk_fingerprint_1801_1900())?
	let checked: () = require_retirement_projection_chunk("http2-retirement-projection-chunk-1801_1900", 1801, 1900, 100, "9a9de252be66557df09e6047408f8ea72c48d12e898676b423703c7213cb5eec", expected_retirement_projection_chunk_sha_1801_1900())?
	Ok(())
end

