fn expected_retirement_projection_chunk_sha_1901_2000() -> String
	"88c0ff9a3969ebb6246b2e2f12b8728916a9ee933c27bc42eb646748a1b86dbc"
end

fn expected_retirement_projection_chunk_fingerprint_1901_2000() -> Int
	3361490991
end

test retirement_projection_manifest_chunk_1901_2000() -> Result<(), String>
	let checked_rows_1901_1920: Int = require_retirement_projection_rows_1901_1920()?
	let checked_rows_1921_1940: Int = require_retirement_projection_rows_1921_1940()?
	let checked_rows_1941_1960: Int = require_retirement_projection_rows_1941_1960()?
	let checked_rows_1961_1980: Int = require_retirement_projection_rows_1961_1980()?
	let checked_rows_1981_2000: Int = require_retirement_projection_rows_1981_2000()?
	let checked_fingerprint: () = require_retirement_projection_chunk_fingerprint("http2-retirement-projection-chunk-fingerprint-1901_2000", checked_rows_1901_1920 + checked_rows_1921_1940 + checked_rows_1941_1960 + checked_rows_1961_1980 + checked_rows_1981_2000, expected_retirement_projection_chunk_fingerprint_1901_2000())?
	let checked: () = require_retirement_projection_chunk("http2-retirement-projection-chunk-1901_2000", 1901, 2000, 100, "88c0ff9a3969ebb6246b2e2f12b8728916a9ee933c27bc42eb646748a1b86dbc", expected_retirement_projection_chunk_sha_1901_2000())?
	Ok(())
end

