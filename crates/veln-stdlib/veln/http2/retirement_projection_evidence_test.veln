use prelude

fn expected_retirement_projection_manifest_sha() -> String
	"bf3bb9fb78078d7ef70ee9803f62647f694c25cc5591437310de99ddb390d67f"
end

fn retirement_projection_manifest_matches(count: Int, projection_sha256: String, expected_sha256: String) -> Bool
	count == 3011 and projection_sha256 == expected_sha256
end

fn require_retirement_projection_manifest(id: String, count: Int, projection_sha256: String) -> Result<(), String>
	let expected_sha256: String = expected_retirement_projection_manifest_sha()
	if retirement_projection_manifest_matches(count, projection_sha256, expected_sha256)
		Ok(())
	else
		Err(id)
	end
end

fn retirement_projection_row_matches(id: String, executable_projection: String, expected_projection: String, projection_sha256: String, expected_sha256: String) -> Bool
	id != "" and executable_projection == expected_projection and projection_sha256 == expected_sha256
end

fn require_retirement_projection_row(id: String, executable_projection: String, expected_projection: String, projection_sha256: String, expected_sha256: String) -> Result<(), String>
	if retirement_projection_row_matches(id, executable_projection, expected_projection, projection_sha256, expected_sha256)
		Ok(())
	else
		Err(id)
	end
end

