	3650322867
end

test retirement_projection_manifest_chunk_2001_2100() -> Result<(), String>
	let checked_rows_2001_2020: Int = require_retirement_projection_rows_2001_2020()?
	let checked_rows_2021_2040: Int = require_retirement_projection_rows_2021_2040()?
	let checked_rows_2041_2060: Int = require_retirement_projection_rows_2041_2060()?
	let checked_rows_2061_2080: Int = require_retirement_projection_rows_2061_2080()?
	let checked_rows_2081_2100: Int = require_retirement_projection_rows_2081_2100()?
	let checked_fingerprint: () = require_retirement_projection_chunk_fingerprint("http2-retirement-projection-chunk-fingerprint-2001_2100", checked_rows_2001_2020 + checked_rows_2021_2040 + checked_rows_2041_2060 + checked_rows_2061_2080 + checked_rows_2081_2100, expected_retirement_projection_chunk_fingerprint_2001_2100())?
	let checked: () = require_retirement_projection_chunk("http2-retirement-projection-chunk-2001_2100", 2001, 2100, 100, "a0098c6add1be6da2af6f1927ce2759d2637ed9980af9ce778da42d0149abe7a", expected_retirement_projection_chunk_sha_2001_2100())?
	Ok(())
end

