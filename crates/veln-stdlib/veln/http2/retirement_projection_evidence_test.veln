test retirement_projection_manifest_chunk_1001_1100() -> Result<(), String>
	let checked_rows_1001_1020: Int = require_retirement_projection_rows_1001_1020()?
	let checked_rows_1021_1040: Int = require_retirement_projection_rows_1021_1040()?
	let checked_rows_1041_1060: Int = require_retirement_projection_rows_1041_1060()?
	let checked_rows_1061_1080: Int = require_retirement_projection_rows_1061_1080()?
	let checked_rows_1081_1100: Int = require_retirement_projection_rows_1081_1100()?
	let checked_fingerprint: () = require_retirement_projection_chunk_fingerprint("http2-retirement-projection-chunk-fingerprint-1001_1100", checked_rows_1001_1020 + checked_rows_1021_1040 + checked_rows_1041_1060 + checked_rows_1061_1080 + checked_rows_1081_1100, expected_retirement_projection_chunk_fingerprint_1001_1100())?
	let checked: () = require_retirement_projection_chunk("http2-retirement-projection-chunk-1001_1100", 1001, 1100, 100, "b14f02dc5cab0e6063dbb539c2dc6c7f91536d3b250b18cb9d9059f85f09eb67", expected_retirement_projection_chunk_sha_1001_1100())?
	Ok(())
end

