test retirement_projection_manifest_chunk_1701_1800() -> Result<(), String>
	let checked_rows_1701_1720: Int = require_retirement_projection_rows_1701_1720()?
	let checked_rows_1721_1740: Int = require_retirement_projection_rows_1721_1740()?
	let checked_rows_1741_1760: Int = require_retirement_projection_rows_1741_1760()?
	let checked_rows_1761_1780: Int = require_retirement_projection_rows_1761_1780()?
	let checked_rows_1781_1800: Int = require_retirement_projection_rows_1781_1800()?
	let checked_fingerprint: () = require_retirement_projection_chunk_fingerprint("http2-retirement-projection-chunk-fingerprint-1701_1800", checked_rows_1701_1720 + checked_rows_1721_1740 + checked_rows_1741_1760 + checked_rows_1761_1780 + checked_rows_1781_1800, expected_retirement_projection_chunk_fingerprint_1701_1800())?
	let checked: () = require_retirement_projection_chunk("http2-retirement-projection-chunk-1701_1800", 1701, 1800, 100, "d240b6946065a14225cc33dbc2d5861764db2a479b4d58e6d45a72505c983c75", expected_retirement_projection_chunk_sha_1701_1800())?
	Ok(())
end

