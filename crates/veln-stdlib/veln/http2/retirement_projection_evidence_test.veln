test retirement_projection_manifest_chunk_2101_2200() -> Result<(), String>
	let checked_rows_2101_2120: Int = require_retirement_projection_rows_2101_2120()?
	let checked_rows_2121_2140: Int = require_retirement_projection_rows_2121_2140()?
	let checked_rows_2141_2160: Int = require_retirement_projection_rows_2141_2160()?
