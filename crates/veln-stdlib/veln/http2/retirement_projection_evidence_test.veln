fn retirement_projection_setup_value_0001_0100(code: Int) -> String
	if code == 1
		"create-connection-state"
	else if code == 2
		"create-connection-state>build-frame-bytes"
	else if code == 3
		"create-connection-state>build-frame-bytes>select-retired-stdout-row:client-push-local-disable-sent>project-stdout:local_settings"
	else if code == 4
		"create-connection-state>build-frame-bytes>select-retired-stdout-row:client-push-local-enable-sent>project-stdout:local_settings"
	else if code == 5
		"create-connection-state>build-frame-bytes>select-retired-stdout-row:client-push-promise-accepted>project-stdout:highest_peer_created_stream_id"
	else if code == 6
		"create-connection-state>build-frame-bytes>select-retired-stdout-row:client-push-promise-continuation-done>project-stdout:highest_peer_created_stream_id>apply-continuation-input"
	else if code == 7
		"create-connection-state>build-frame-bytes>select-retired-stdout-row:client-push-promise-higher-retry>project-stdout:highest_peer_created_stream_id"
	else if code == 8
		"create-connection-state>build-frame-bytes>select-retired-stdout-row:client-push-promise-increasing-continuation>project-stdout:highest_peer_created_stream_id>apply-continuation-input"
	else if code == 9
		"create-connection-state>build-frame-bytes>select-retired-stdout-row:client-push-promise-increasing>project-stdout:highest_peer_created_stream_id"
	else if code == 10
		"create-connection-state>build-frame-bytes>select-retired-stdout-row:client-push-promise-lower-retained>project-stdout:highest_peer_created_stream_id"
	else if code == 11
		"create-connection-state>build-frame-bytes>select-retired-stdout-row:client-push-promised-headers-end-stream>project-stdout:highest_peer_created_stream_id"
	else if code == 12
		"create-connection-state>build-frame-bytes>select-retired-stdout-row:client-push-promised-headers-end-stream>project-stdout:result>select-frame-kind:1>apply-continuation-input"
	else if code == 13
		"create-connection-state>build-frame-bytes>select-retired-stdout-row:client-push-promised-headers>project-stdout:highest_peer_created_stream_id"
	else if code == 14
		"create-connection-state>build-frame-bytes>select-retired-stdout-row:client-push-promised-headers>project-stdout:result>select-frame-kind:1>apply-continuation-input"
	else if code == 15
		"create-connection-state>build-frame-bytes>select-retired-stdout-row:client-push-promised-reset>project-stdout:highest_peer_created_stream_id"
	else if code == 16
		"create-connection-state>build-frame-bytes>select-retired-stdout-row:client-settings-enable-push-rejected>project-stdout:id>apply-settings-state"
	else if code == 17
		"create-connection-state>build-frame-bytes>select-retired-stdout-row:client-settings-enable-push-rejected>project-stdout:peer_max_frame_size>apply-settings-state"
	else if code == 18
		"create-connection-state>build-frame-bytes>select-retired-stdout-row:closed>project-stdout:id>apply-continuation-input"
	else if code == 19
		"create-connection-state>build-frame-bytes>select-retired-stdout-row:continuation-closed>project-stdout:id>apply-continuation-input"
	else if code == 20
		"create-connection-state>build-frame-bytes>select-retired-stdout-row:continuation-done>project-stdout:hpack>apply-continuation-input>apply-hpack-state"
	else if code == 21
		"create-connection-state>build-frame-bytes>select-retired-stdout-row:continuation-done>project-stdout:result>select-frame-kind:9>apply-continuation-input"
	else if code == 22
		"create-connection-state>build-frame-bytes>select-retired-stdout-row:continuation-extra>project-stdout:result>select-frame-kind:9>apply-continuation-input"
	else if code == 23
		"create-connection-state>build-frame-bytes>select-retired-stdout-row:continuation-more>project-stdout:result>select-frame-kind:9>apply-continuation-input"
	else if code == 24
		"create-connection-state>build-frame-bytes>select-retired-stdout-row:continuation-stream>project-stdout:id>apply-continuation-input"
	else if code == 25
		"create-connection-state>build-frame-bytes>select-retired-stdout-row:continuation>project-stdout:id>apply-continuation-input"
	else if code == 26
