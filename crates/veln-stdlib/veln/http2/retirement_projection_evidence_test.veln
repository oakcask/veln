	4011837011
end

test retirement_projection_manifest_chunk_1101_1200() -> Result<(), String>
	let checked_rows_1101_1120: Int = require_retirement_projection_rows_1101_1120()?
	let checked_rows_1121_1140: Int = require_retirement_projection_rows_1121_1140()?
	let checked_rows_1141_1160: Int = require_retirement_projection_rows_1141_1160()?
	let checked_rows_1161_1180: Int = require_retirement_projection_rows_1161_1180()?
	let checked_rows_1181_1200: Int = require_retirement_projection_rows_1181_1200()?
	let checked_fingerprint: () = require_retirement_projection_chunk_fingerprint("http2-retirement-projection-chunk-fingerprint-1101_1200", checked_rows_1101_1120 + checked_rows_1121_1140 + checked_rows_1141_1160 + checked_rows_1161_1180 + checked_rows_1181_1200, expected_retirement_projection_chunk_fingerprint_1101_1200())?
	let checked: () = require_retirement_projection_chunk("http2-retirement-projection-chunk-1101_1200", 1101, 1200, 100, "383481366b869a29f0c6abdd3ca1ee2656d593719636c7e18c2df7d0e3c0f837", expected_retirement_projection_chunk_sha_1101_1200())?
	Ok(())
