test retirement_projection_manifest_chunk_1501_1600() -> Result<(), String>
	let checked_rows_1501_1520: Int = require_retirement_projection_rows_1501_1520()?
	let checked_rows_1521_1540: Int = require_retirement_projection_rows_1521_1540()?
	let checked_rows_1541_1560: Int = require_retirement_projection_rows_1541_1560()?
	let checked_rows_1561_1580: Int = require_retirement_projection_rows_1561_1580()?
	let checked_rows_1581_1600: Int = require_retirement_projection_rows_1581_1600()?
	let checked_fingerprint: () = require_retirement_projection_chunk_fingerprint("http2-retirement-projection-chunk-fingerprint-1501_1600", checked_rows_1501_1520 + checked_rows_1521_1540 + checked_rows_1541_1560 + checked_rows_1561_1580 + checked_rows_1581_1600, expected_retirement_projection_chunk_fingerprint_1501_1600())?
	let checked: () = require_retirement_projection_chunk("http2-retirement-projection-chunk-1501_1600", 1501, 1600, 100, "3ab187fe306f18527e5d47a1defd2c4d446053b8dd661de623ad90d9e4bb09cf", expected_retirement_projection_chunk_sha_1501_1600())?
	Ok(())
end

