use prelude
use http2::core
use http2::frame
use http2::hpack

fn require_retirement_projection_public_boundary() -> Result<(), String>
	let frame_header: ByteChunk = http2::frame::encode_header(8, 6, 0, 0)?
	let ping: PingRequestDecision = http2::core::send_ping(byte_chunk_from_hex("0102030405060708")?)
	let table: DynamicTable = http2::hpack::empty_dynamic_table(4096)?
	let headers: HeaderList = http2::hpack::prepend_header_field(http2::hpack::header_field(":method", byte_chunk_from_hex("474554")?), http2::hpack::empty_header_list())
	match http2::hpack::encode_header_block(headers, table, 4096)
		Ok(encoded) => match http2::hpack::decode_header_block(byte_view(http2::hpack::header_block_encode_bytes(encoded), byte_offset(0)?, byte_chunk_count(http2::hpack::header_block_encode_bytes(encoded)))?, table, 4096)
			Ok(decoded) => if byte_count_to_int(byte_chunk_count(frame_header)) == 9 and http2::core::ping_request_status(ping) == "accepted" and byte_count_to_int(byte_chunk_count(http2::core::ping_request_bytes(ping))) == 17 and http2::hpack::header_list_count(http2::hpack::header_block_headers(decoded)) == 1 and http2::hpack::header_block_consumed(decoded) == byte_count_to_int(byte_chunk_count(http2::hpack::header_block_encode_bytes(encoded)))
				Ok(())
			else
				Err("retirement projection public boundary mismatch")
			end
			Err(failure) => Err(http2::hpack::header_block_failure_kind(failure))
		end
		Err(failure) => Err(http2::hpack::header_block_encode_failure_kind(failure))
	end
end

fn expected_retirement_projection_manifest_sha() -> String
	"616b462c420c559c796447b1ea391610a8c119ec292febfd1ccfe6bfc625c654"
end

fn retirement_projection_manifest_matches(count: Int, projection_sha256: String, expected_sha256: String) -> Bool
	count == 3011 and projection_sha256 == expected_sha256
end

fn require_retirement_projection_manifest(id: String, count: Int, projection_sha256: String) -> Result<(), String>
	let expected_sha256: String = expected_retirement_projection_manifest_sha()
	if retirement_projection_manifest_matches(count, projection_sha256, expected_sha256)
		Ok(())
	else
		Err(id)
	end
end

fn require_retirement_projection_row(id: String, ordinal: Int, endpoint_role: String, operation: String, branch: String, initial: String, setup: String, input: String, result_projection: String, post: String, output: String, diagnostic: String, projection_sha256: String, endpoint_role_code: Int, operation_code: Int, branch_code: Int, initial_code: Int, setup_code: Int, input_code: Int, result_code: Int, post_code: Int, output_code: Int, diagnostic_code: Int, semantic_code: Int) -> Result<Int, String>
	if retirement_projection_row_dimensions_match(id, ordinal, endpoint_role, operation, branch, initial, setup, input, result_projection, post, output, diagnostic, projection_sha256, endpoint_role_code, operation_code, branch_code, initial_code, setup_code, input_code, result_code, post_code, output_code, diagnostic_code, semantic_code)
		Ok(retirement_projection_row_fingerprint(ordinal, endpoint_role_code, operation_code, branch_code, initial_code, setup_code, input_code, result_code, post_code, output_code, diagnostic_code, semantic_code))
	else
		Err(id)
	end
end

fn retirement_projection_row_dimensions_match(id: String, ordinal: Int, endpoint_role: String, operation: String, branch: String, initial: String, setup: String, input: String, result_projection: String, post: String, output: String, diagnostic: String, projection_sha256: String, endpoint_role_code: Int, operation_code: Int, branch_code: Int, initial_code: Int, setup_code: Int, input_code: Int, result_code: Int, post_code: Int, output_code: Int, diagnostic_code: Int, semantic_code: Int) -> Bool
	id != "" and ordinal > 0 and endpoint_role != "" and operation != "" and branch != "" and initial != "" and setup != "" and input != "" and result_projection != "" and post != "" and output != "" and diagnostic != "" and projection_sha256 != "" and endpoint_role_code > 0 and operation_code > 0 and branch_code > 0 and initial_code > 0 and setup_code > 0 and input_code > 0 and result_code == ordinal and post_code > 0 and output_code > 0 and diagnostic_code > 0 and semantic_code == retirement_projection_row_semantic_code(endpoint_role_code, operation_code, branch_code, initial_code, setup_code, input_code, result_code, post_code, output_code, diagnostic_code)
end

fn retirement_projection_row_semantic_code(endpoint_role_code: Int, operation_code: Int, branch_code: Int, initial_code: Int, setup_code: Int, input_code: Int, result_code: Int, post_code: Int, output_code: Int, diagnostic_code: Int) -> Int
	endpoint_role_code * 59 + operation_code * 61 + branch_code * 67 + initial_code * 71 + setup_code * 73 + input_code * 79 + result_code * 83 + post_code * 89 + output_code * 97 + diagnostic_code * 101
end

fn retirement_projection_row_fingerprint(ordinal: Int, endpoint_role_code: Int, operation_code: Int, branch_code: Int, initial_code: Int, setup_code: Int, input_code: Int, result_code: Int, post_code: Int, output_code: Int, diagnostic_code: Int, semantic_code: Int) -> Int
	ordinal * 13 + endpoint_role_code * 17 + operation_code * 19 + branch_code * 23 + initial_code * 29 + setup_code * 31 + input_code * 37 + result_code * 41 + post_code * 43 + output_code * 47 + diagnostic_code * 53 + semantic_code * 59
end

fn retirement_projection_chunk_matches(id: String, start_row: Int, end_row: Int, row_count: Int, projection_sha256: String, expected_sha256: String) -> Bool
	id != "" and start_row > 0 and end_row >= start_row and row_count == (end_row - start_row + 1) and projection_sha256 == expected_sha256
end

fn require_retirement_projection_chunk(id: String, start_row: Int, end_row: Int, row_count: Int, projection_sha256: String, expected_sha256: String) -> Result<(), String>
	if retirement_projection_chunk_matches(id, start_row, end_row, row_count, projection_sha256, expected_sha256)
		Ok(())
	else
		Err(id)
	end
end

fn require_retirement_projection_chunk_fingerprint(id: String, observed: Int, expected: Int) -> Result<(), String>
	if observed == expected
		Ok(())
	else
		Err(id)
	end
end

