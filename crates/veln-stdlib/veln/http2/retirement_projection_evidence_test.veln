use prelude
use http2::core
use http2::frame
use http2::hpack

fn require_retirement_projection_public_boundary() -> Result<(), String>
	let frame_header: ByteChunk = http2::frame::encode_header(8, 6, 0, 0)?
	let ping: PingRequestDecision = http2::core::send_ping(byte_chunk_from_hex("0102030405060708")?)
	let table: DynamicTable = http2::hpack::empty_dynamic_table(4096)?
	let headers: HeaderList = http2::hpack::prepend_header_field(http2::hpack::header_field(":method", byte_chunk_from_hex("474554")?), http2::hpack::empty_header_list())
	match http2::hpack::encode_header_block(headers, table, 4096)
		Ok(encoded) => match http2::hpack::decode_header_block(byte_view(http2::hpack::header_block_encode_bytes(encoded), byte_offset(0)?, byte_chunk_count(http2::hpack::header_block_encode_bytes(encoded)))?, table, 4096)
			Ok(decoded) => if byte_count_to_int(byte_chunk_count(frame_header)) == 9 and http2::core::ping_request_status(ping) == "accepted" and byte_count_to_int(byte_chunk_count(http2::core::ping_request_bytes(ping))) == 17 and http2::hpack::header_list_count(http2::hpack::header_block_headers(decoded)) == 1 and http2::hpack::header_block_consumed(decoded) == byte_count_to_int(byte_chunk_count(http2::hpack::header_block_encode_bytes(encoded)))
				Ok(())
			else
				Err("retirement projection public boundary mismatch")
			end
			Err(failure) => Err(http2::hpack::header_block_failure_kind(failure))
		end
		Err(failure) => Err(http2::hpack::header_block_encode_failure_kind(failure))
	end
end

fn expected_retirement_projection_manifest_sha() -> String
	"29dbec6c6bedbab6f42906a2bb2def5246111aa5e9c1ef4a91bc53a252603327"
end

fn retirement_projection_manifest_matches(count: Int, projection_sha256: String, expected_sha256: String) -> Bool
	count == 3011 and projection_sha256 == expected_sha256
end

fn require_retirement_projection_manifest(id: String, count: Int, projection_sha256: String) -> Result<(), String>
	let expected_sha256: String = expected_retirement_projection_manifest_sha()
	if retirement_projection_manifest_matches(count, projection_sha256, expected_sha256)
		Ok(())
	else
		Err(id)
	end
end

fn require_retirement_projection_row(id: String, ordinal: Int, operation_code: Int, branch_code: Int, initial_code: Int, setup_code: Int, input_code: Int, result_code: Int, post_code: Int, output_code: Int, diagnostic_code: Int, projection_sha256: String) -> Result<(), String>
	if id != "" and ordinal > 0 and operation_code > 0 and branch_code > 0 and initial_code > 0 and setup_code > 0 and input_code > 0 and result_code > 0 and post_code > 0 and output_code > 0 and diagnostic_code > 0 and projection_sha256 != ""
		Ok(())
	else
		Err(id)
	end
end

fn retirement_projection_chunk_matches(id: String, start_row: Int, end_row: Int, row_count: Int, projection_sha256: String, expected_sha256: String) -> Bool
	id != "" and start_row > 0 and end_row >= start_row and row_count == (end_row - start_row + 1) and projection_sha256 == expected_sha256
end

fn require_retirement_projection_chunk(id: String, start_row: Int, end_row: Int, row_count: Int, projection_sha256: String, expected_sha256: String) -> Result<(), String>
	if retirement_projection_chunk_matches(id, start_row, end_row, row_count, projection_sha256, expected_sha256)
		Ok(())
	else
		Err(id)
	end
end

fn expected_retirement_projection_chunk_sha_0001_0100() -> String
	"a3638325e7b6e57ccf5b17df178664895f5c6edd61bed3987410d2e5eef463be"
end

