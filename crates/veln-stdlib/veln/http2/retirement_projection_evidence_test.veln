	let checked_rows_0881_0900: Int = require_retirement_projection_rows_0881_0900()?
	let checked_fingerprint: () = require_retirement_projection_chunk_fingerprint("http2-retirement-projection-chunk-fingerprint-0801_0900", checked_rows_0801_0820 + checked_rows_0821_0840 + checked_rows_0841_0860 + checked_rows_0861_0880 + checked_rows_0881_0900, expected_retirement_projection_chunk_fingerprint_0801_0900())?
	let checked: () = require_retirement_projection_chunk("http2-retirement-projection-chunk-0801_0900", 801, 900, 100, "5b715ba876361569e4722a8c5f36146f6fe28241e374aa8370b9c17a20e1d6f9", expected_retirement_projection_chunk_sha_0801_0900())?
	Ok(())
end

