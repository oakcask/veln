use prelude

fn expected_retirement_projection_manifest_sha() -> String
	"bf3bb9fb78078d7ef70ee9803f62647f694c25cc5591437310de99ddb390d67f"
end

fn retirement_projection_manifest_matches(count: Int, projection_sha256: String, expected_sha256: String) -> Bool
	count == 3011 and projection_sha256 == expected_sha256
end

fn require_retirement_projection_manifest(id: String, count: Int, projection_sha256: String) -> Result<(), String>
	let expected_sha256: String = expected_retirement_projection_manifest_sha()
	if retirement_projection_manifest_matches(count, projection_sha256, expected_sha256)
		Ok(())
	else
		Err(id)
	end
end

fn retirement_projection_chunk_matches(id: String, start_row: Int, end_row: Int, row_count: Int, projection_sha256: String, expected_sha256: String) -> Bool
	id != "" and start_row > 0 and end_row >= start_row and row_count == (end_row - start_row + 1) and projection_sha256 == expected_sha256
end

fn require_retirement_projection_chunk(id: String, start_row: Int, end_row: Int, row_count: Int, projection_sha256: String, expected_sha256: String) -> Result<(), String>
	if retirement_projection_chunk_matches(id, start_row, end_row, row_count, projection_sha256, expected_sha256)
		Ok(())
	else
		Err(id)
	end
end

