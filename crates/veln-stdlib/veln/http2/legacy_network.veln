use prelude
use transport

pub fn accept_or_end(listener: NetListener) -> Option<NetStream> effects [net]
	net::accept_or_end(listener)
end

pub fn connect(endpoint: String) -> NetStream effects [net]
	net::connect(endpoint)
end

pub fn close_listener(listener: NetListener) -> () effects [net]
	net::close_listener(listener)
end

pub fn close_stream(stream: NetStream) -> () effects [net]
	net::close_stream(stream)
end

fn read_stream_chunk(stream: NetStream) -> Result<Option<ByteChunk>, std::net::NetError> effects [net]
	Ok(net::read_chunk_or_end(stream))
end

fn write_stream_chunks(stream: NetStream, chunks: List<ByteChunk>) -> Result<(), std::net::NetError> effects [net]
	net::write_chunks(stream, chunks)
	Ok(())
end

pub handler duplex_stream(stream: NetStream) for transport::DuplexStream effects [net]
	read_chunk() => read_stream_chunk(stream)
	write_chunks(chunks) => write_stream_chunks(stream, chunks)
end
