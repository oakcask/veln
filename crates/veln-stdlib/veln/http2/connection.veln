use prelude
use transport
use transport::network
use net
use http2::core

pub type Http2ConnectionFailure
	pub TransportFailure(error: net::NetError)
	ProtocolFailure(CoreReceiveConnectionFailure)
	IncompleteInput(CoreReceiveConnectionEofFailure)
	LocalSettingsFailure(LocalSettingsFailure)
	LocalSettingsEncodeFailure(reason: String)
end

pub type Http2ApplicationAction
	pub Headers(stream_id: Int, headers: HeaderList, end_stream: Bool)
	pub Data(stream_id: Int, data: ByteChunk, end_stream: Bool)
end

pub type Http2ApplicationBoundaryFailure
	pub TransportFailure(error: net::NetError)
	pub ConnectionFailure(Http2ConnectionFailure)
	pub CallbackFailure(reason: String)
	pub UnsupportedRequestShape(stream_id: Int, reason: String)
	pub UnsupportedRequestCount(stream_id: Int)
	pub InvalidActionSequence(reason: String, action_index: Int, stream_id: Int, expected_stream_id: Int)
	pub RejectedHeadersAction(CoreOutboundHeadersFailure)
	pub RejectedDataAction(CoreOutboundDataFlowFailure)
	pub CoreActionEncodeFailure(action_kind: String, stream_id: Int, reason: String)
end

pub type Http2ServiceFailure
	pub StateFailure(reason: String)
	pub NetworkFailure(accepted: Int, error: net::NetError)
	pub ApplicationFailure(accepted: Int, failure: Http2ApplicationBoundaryFailure)
	pub JoinFailure(accepted: Int, reason: String)
end

pub type Http2ClientRequest
	pub Http2ClientBodylessRequest(headers: HeaderList)
end

pub type Http2ClientResponse
	pub Http2ClientFinalResponse(stream_id: Int, reused: Bool, connection_lifecycle: String, active_stream_count: Int, peer_stream_capacity: Int)
end

pub type Http2ClientServiceFailure
	pub StateFailure(reason: String)
	pub NetworkFailure(completed: Int, error: net::NetError)
	pub RequestFailure(completed: Int, failure: CoreOutboundHeadersFailure)
	pub RequestEncodeFailure(completed: Int, reason: String)
	pub ConnectionFailure(completed: Int, failure: Http2ConnectionFailure)
	pub CallbackFailure(completed: Int, reason: String)
	pub JoinFailure(completed: Int, reason: String)
	pub IncompleteResponse(completed: Int, stream_id: Int, lifecycle: String)
end

type Http2ClientTaskResult
	Http2ClientTaskResult(response: Http2ClientResponse, state: CoreConnectionState)
end

type Http2ClientRetainedConnection
	NoRetainedClientConnection
	RetainedClientConnection(stream: NetStream, state: CoreConnectionState)
end

pub fn drive_server(state: CoreConnectionState) -> Result<CoreConnectionState, Http2ConnectionFailure> effects [std::transport::DuplexStream]
	if http2::core::connection_lifecycle_label(http2::core::connection_state_lifecycle(state)) == "closed"
		Ok(state)
	else
		start_server(state)
	end
end

pub fn drive_client(state: CoreConnectionState) -> Result<CoreConnectionState, Http2ConnectionFailure> effects [std::transport::DuplexStream]
	if http2::core::connection_lifecycle_label(http2::core::connection_state_lifecycle(state)) == "closed"
		Ok(state)
	else
		start_client(state)
	end
end

pub fn drive_server_application<effect E>(state: CoreConnectionState, handler: fn(Http2ApplicationEvent) -> Result<List<Http2ApplicationAction>, String> effects [...E]) -> Result<CoreConnectionState, Http2ApplicationBoundaryFailure> effects [std::transport::DuplexStream, ...E]
	if http2::core::connection_lifecycle_label(http2::core::connection_state_lifecycle(state)) == "closed"
		Ok(state)
	else
		start_server_application(state, handler)
	end
end

pub fn serve_connection<effect E>(handler: fn(Http2ApplicationEvent) -> Result<List<Http2ApplicationAction>, String> effects [...E]) -> Result<(), Http2ServiceFailure> effects [std::transport::DuplexStream, ...E]
	let state = service_initial_state()?
	match drive_server_application(state, handler)
		Ok(_) => Ok(())
		Err(failure) => Err(Http2ServiceFailure::ApplicationFailure(1, failure))
	end
end

pub fn serve_tcp<effect E>(listener: net::Listener, handler: fn(Http2ApplicationEvent) -> Result<List<Http2ApplicationAction>, String> effects [...E]) -> Result<(), Http2ServiceFailure> effects [net::IO, concurrency, ...E]
	service_finish(listener, service_accept_next(listener, 0, handler))
end

pub fn client_bodyless_request(headers: HeaderList) -> Http2ClientRequest
	Http2ClientBodylessRequest(headers)
end

pub fn request_endpoint_sequence<effect E>(endpoint: net::Address, requests: List<Http2ClientRequest>, handler: fn(Http2ClientResponse) -> Result<(), String> effects [...E]) -> Result<(), Http2ClientServiceFailure> effects [net::IO, concurrency, ...E]
	client_request_next(endpoint, requests, NoRetainedClientConnection, 0, handler)
end

pub fn request_endpoint_sequence_tcp<effect E>(endpoint: net::Address, requests: List<Http2ClientRequest>, handler: fn(Http2ClientResponse) -> Result<(), String> effects [...E]) -> Result<(), Http2ClientServiceFailure> effects [net, time, concurrency, ...E]
	handle request_endpoint_sequence(endpoint, requests, handler) with net::system()
end

pub fn client_connection_reusable(state: CoreConnectionState) -> Bool
	http2::core::connection_lifecycle_label(http2::core::connection_state_lifecycle(state)) == "open" and http2::core::stream_collection_active_count(http2::core::connection_state_streams(state)) < http2::core::peer_settings_active_max_concurrent_streams(http2::core::connection_state_peer_settings(state))
end

pub fn client_response_stream_id(response: Http2ClientResponse) -> Int
	match response
		Http2ClientFinalResponse(stream_id, _, _, _, _) => stream_id
	end
end

pub fn client_response_reused_connection(response: Http2ClientResponse) -> Bool
	match response
		Http2ClientFinalResponse(_, reused, _, _, _) => reused
	end
end

pub fn client_response_connection_lifecycle(response: Http2ClientResponse) -> String
	match response
		Http2ClientFinalResponse(_, _, lifecycle, _, _) => lifecycle
	end
end

pub fn client_response_active_stream_count(response: Http2ClientResponse) -> Int
	match response
		Http2ClientFinalResponse(_, _, _, active_stream_count, _) => active_stream_count
	end
end

pub fn client_response_peer_stream_capacity(response: Http2ClientResponse) -> Int
	match response
		Http2ClientFinalResponse(_, _, _, _, peer_stream_capacity) => peer_stream_capacity
	end
end

pub fn client_service_failure_kind(failure: Http2ClientServiceFailure) -> String
	match failure
		Http2ClientServiceFailure::StateFailure(_) => "state"
		Http2ClientServiceFailure::NetworkFailure(_, _) => "network"
		Http2ClientServiceFailure::RequestFailure(_, _) => "request"
		Http2ClientServiceFailure::RequestEncodeFailure(_, _) => "request-encode"
		Http2ClientServiceFailure::ConnectionFailure(_, inner) => connection_failure_kind(inner)
		Http2ClientServiceFailure::CallbackFailure(_, _) => "callback"
		Http2ClientServiceFailure::JoinFailure(_, _) => "join"
		Http2ClientServiceFailure::IncompleteResponse(_, _, _) => "incomplete-response"
	end
end

pub fn client_service_failure_id(failure: Http2ClientServiceFailure) -> String
	match failure
		Http2ClientServiceFailure::StateFailure(_) => "http2.client_service.state_failure"
		Http2ClientServiceFailure::NetworkFailure(_, _) => "http2.client_service.network_failure"
		Http2ClientServiceFailure::RequestFailure(_, inner) => http2::core::outbound_headers_failure_id(inner)
		Http2ClientServiceFailure::RequestEncodeFailure(_, _) => "http2.client_service.request_encode_failure"
		Http2ClientServiceFailure::ConnectionFailure(_, inner) => connection_failure_id(inner)
		Http2ClientServiceFailure::CallbackFailure(_, _) => "http2.client_service.callback_failure"
		Http2ClientServiceFailure::JoinFailure(_, _) => "http2.client_service.join_failure"
		Http2ClientServiceFailure::IncompleteResponse(_, _, _) => "http2.client_service.incomplete_response"
	end
end

pub fn client_service_failure_reason(failure: Http2ClientServiceFailure) -> String
	match failure
		Http2ClientServiceFailure::StateFailure(reason) => reason
		Http2ClientServiceFailure::NetworkFailure(_, net::NetError(_, _, _, _, message)) => message
		Http2ClientServiceFailure::RequestFailure(_, inner) => http2::core::outbound_headers_failure_rule_provenance(inner)
		Http2ClientServiceFailure::RequestEncodeFailure(_, reason) => reason
		Http2ClientServiceFailure::ConnectionFailure(_, inner) => connection_failure_reason(inner)
		Http2ClientServiceFailure::CallbackFailure(_, reason) => reason
		Http2ClientServiceFailure::JoinFailure(_, reason) => reason
		Http2ClientServiceFailure::IncompleteResponse(_, _, lifecycle) => lifecycle
	end
end

pub fn client_service_failure_completed(failure: Http2ClientServiceFailure) -> Int
	match failure
		Http2ClientServiceFailure::StateFailure(_) => 0
		Http2ClientServiceFailure::NetworkFailure(completed, _) => completed
		Http2ClientServiceFailure::RequestFailure(completed, _) => completed
		Http2ClientServiceFailure::RequestEncodeFailure(completed, _) => completed
		Http2ClientServiceFailure::ConnectionFailure(completed, _) => completed
		Http2ClientServiceFailure::CallbackFailure(completed, _) => completed
		Http2ClientServiceFailure::JoinFailure(completed, _) => completed
		Http2ClientServiceFailure::IncompleteResponse(completed, _, _) => completed
	end
end

pub fn client_service_failure_stream_id(failure: Http2ClientServiceFailure) -> Int
	match failure
		Http2ClientServiceFailure::RequestFailure(_, inner) => http2::core::outbound_headers_failure_stream_id(inner)
		Http2ClientServiceFailure::ConnectionFailure(_, inner) => connection_failure_stream_id(inner)
		Http2ClientServiceFailure::IncompleteResponse(_, stream_id, _) => stream_id
		_ => 0
	end
end

fn service_initial_state() -> Result<CoreConnectionState, Http2ServiceFailure>
	match http2::core::server_connection_state(0)
		Ok(state) => Ok(state)
		Err(reason) => Err(Http2ServiceFailure::StateFailure(reason))
	end
end

fn service_connection_task<effect E>(context: { stream : NetStream, callback : fn(Http2ApplicationEvent) -> Result<List<Http2ApplicationAction>, String> effects [...E] }) -> Result<CoreConnectionState, Http2ApplicationBoundaryFailure> effects [net::IO, ...E]
	let state = service_application_initial_state()?
	handle drive_server_application(state, context.callback) with transport::network::net_stream(context.stream)
end

fn service_application_initial_state() -> Result<CoreConnectionState, Http2ApplicationBoundaryFailure>
	match http2::core::server_connection_state(0)
		Ok(state) => Ok(state)
		Err(reason) => Err(Http2ApplicationBoundaryFailure::ConnectionFailure(Http2ConnectionFailure::LocalSettingsEncodeFailure(reason)))
	end
end

fn service_spawn_connection<effect E>(stream: NetStream, handler: fn(Http2ApplicationEvent) -> Result<List<Http2ApplicationAction>, String> effects [...E]) -> Task<Result<CoreConnectionState, Http2ApplicationBoundaryFailure>> effects [net::IO, concurrency, ...E]
	let context = { stream: stream, callback: handler }
	task::spawn_with<Result<CoreConnectionState, Http2ApplicationBoundaryFailure>, { stream : NetStream, callback : fn(Http2ApplicationEvent) -> Result<List<Http2ApplicationAction>, String> effects [...E] }>(service_connection_task, context)
end

fn service_accept_next<effect E>(listener: net::Listener, accepted: Int, handler: fn(Http2ApplicationEvent) -> Result<List<Http2ApplicationAction>, String> effects [...E]) -> Result<(), Http2ServiceFailure> effects [net::IO, concurrency, ...E]
	match net::accept(listener)
		Ok(stream) => match service_run_one(stream, service_spawn_connection(stream, handler), accepted + 1)
			Ok(_) => service_accept_next(listener, accepted + 1, handler)
			Err(failure) => Err(failure)
		end
		Err(error) => Err(Http2ServiceFailure::NetworkFailure(accepted, error))
	end
end

fn service_run_one(stream: net::Stream, worker: Task<Result<CoreConnectionState, Http2ApplicationBoundaryFailure>>, accepted: Int) -> Result<(), Http2ServiceFailure> effects [net::IO, concurrency]
	match task::join(worker)
		Ok(Ok(_)) => service_close_after_success(stream, accepted)
		Ok(Err(failure)) => service_fail_close(stream, service_application_failure(accepted, failure))
		Err(_) => service_fail_close(stream, Http2ServiceFailure::JoinFailure(accepted, "failed"))
	end
end

fn service_application_failure(accepted: Int, failure: Http2ApplicationBoundaryFailure) -> Http2ServiceFailure
	match failure
		Http2ApplicationBoundaryFailure::TransportFailure(error) => Http2ServiceFailure::NetworkFailure(accepted, error)
		_ => Http2ServiceFailure::ApplicationFailure(accepted, failure)
	end
end

fn service_close_after_success(stream: net::Stream, accepted: Int) -> Result<(), Http2ServiceFailure> effects [net::IO]
	match net::close_stream(stream)
		Ok(_) => Ok(())
		Err(error) => Err(Http2ServiceFailure::NetworkFailure(accepted, error))
	end
end

fn service_fail_close(stream: net::Stream, failure: Http2ServiceFailure) -> Result<(), Http2ServiceFailure> effects [net::IO]
	match net::close_stream(stream)
		Ok(_) => Err(failure)
		Err(error) => Err(Http2ServiceFailure::NetworkFailure(service_failure_accepted(failure), error))
	end
end

fn service_finish(listener: net::Listener, result: Result<(), Http2ServiceFailure>) -> Result<(), Http2ServiceFailure> effects [net::IO]
	match net::close_listener(listener)
		Ok(_) => result
		Err(error) => Err(Http2ServiceFailure::NetworkFailure(service_result_accepted(result), error))
	end
end

fn service_result_accepted(result: Result<(), Http2ServiceFailure>) -> Int
	match result
		Ok(_) => 0
		Err(failure) => service_failure_accepted(failure)
	end
end

fn client_request_next<effect E>(endpoint: net::Address, requests: List<Http2ClientRequest>, retained: Http2ClientRetainedConnection, completed: Int, handler: fn(Http2ClientResponse) -> Result<(), String> effects [...E]) -> Result<(), Http2ClientServiceFailure> effects [net::IO, concurrency, ...E]
	match requests
		Nil => client_close_retained(retained, completed)
		Cons(request, tail) => client_dispatch_request(endpoint, request, tail, retained, completed, handler)
	end
end

fn client_dispatch_request<effect E>(endpoint: net::Address, request: Http2ClientRequest, tail: List<Http2ClientRequest>, retained: Http2ClientRetainedConnection, completed: Int, handler: fn(Http2ClientResponse) -> Result<(), String> effects [...E]) -> Result<(), Http2ClientServiceFailure> effects [net::IO, concurrency, ...E]
	match retained
		NoRetainedClientConnection => client_connect_and_run(endpoint, request, tail, completed, handler)
		RetainedClientConnection(stream, state) => if client_connection_reusable(state)
			client_run_one(endpoint, stream, state, true, request, tail, completed, handler)
		else
			client_replace_connection(endpoint, stream, request, tail, completed, handler)
		end
	end
end

fn client_connect_and_run<effect E>(endpoint: net::Address, request: Http2ClientRequest, tail: List<Http2ClientRequest>, completed: Int, handler: fn(Http2ClientResponse) -> Result<(), String> effects [...E]) -> Result<(), Http2ClientServiceFailure> effects [net::IO, concurrency, ...E]
	let stream = client_connect(endpoint, completed)?
	match client_service_initial_state()
		Ok(state) => client_run_one(endpoint, stream, state, false, request, tail, completed, handler)
		Err(failure) => client_fail_close(stream, failure)
	end
end

fn client_connect(endpoint: net::Address, completed: Int) -> Result<net::Stream, Http2ClientServiceFailure> effects [net::IO]
	match net::connect(endpoint)
		Ok(stream) => Ok(stream)
		Err(error) => Err(Http2ClientServiceFailure::NetworkFailure(completed, error))
	end
end

fn client_replace_connection<effect E>(endpoint: net::Address, stream: NetStream, request: Http2ClientRequest, tail: List<Http2ClientRequest>, completed: Int, handler: fn(Http2ClientResponse) -> Result<(), String> effects [...E]) -> Result<(), Http2ClientServiceFailure> effects [net::IO, concurrency, ...E]
	match net::close_stream(stream)
		Ok(_) => client_connect_and_run(endpoint, request, tail, completed, handler)
		Err(error) => Err(Http2ClientServiceFailure::NetworkFailure(completed, error))
	end
end

fn client_service_initial_state() -> Result<CoreConnectionState, Http2ClientServiceFailure>
	match http2::core::client_connection_state(0)
		Ok(state) => Ok(state)
		Err(reason) => Err(Http2ClientServiceFailure::StateFailure(reason))
	end
end

fn client_run_one<effect E>(endpoint: net::Address, stream: NetStream, state: CoreConnectionState, reused: Bool, request: Http2ClientRequest, tail: List<Http2ClientRequest>, completed: Int, handler: fn(Http2ClientResponse) -> Result<(), String> effects [...E]) -> Result<(), Http2ClientServiceFailure> effects [net::IO, concurrency, ...E]
	let worker = client_spawn_request(stream, state, reused, request)
	match task::join(worker)
		Ok(Ok(result)) => client_handle_response(endpoint, stream, result, tail, completed, handler)
		Ok(Err(failure)) => client_fail_close(stream, client_connection_task_failure(completed, failure))
		Err(_) => client_fail_close(stream, Http2ClientServiceFailure::JoinFailure(completed, "failed"))
	end
end

fn client_handle_response<effect E>(endpoint: net::Address, stream: NetStream, result: Http2ClientTaskResult, tail: List<Http2ClientRequest>, completed: Int, handler: fn(Http2ClientResponse) -> Result<(), String> effects [...E]) -> Result<(), Http2ClientServiceFailure> effects [net::IO, concurrency, ...E]
	match result
		Http2ClientTaskResult(response, state) => match handler(response)
			Ok(_) => client_request_next(endpoint, tail, RetainedClientConnection(stream, state), completed + 1, handler)
			Err(reason) => client_fail_close(stream, Http2ClientServiceFailure::CallbackFailure(completed, reason))
		end
	end
end

fn client_close_retained(retained: Http2ClientRetainedConnection, completed: Int) -> Result<(), Http2ClientServiceFailure> effects [net::IO]
	match retained
		NoRetainedClientConnection => Ok(())
		RetainedClientConnection(stream, _) => client_close_stream_ok(stream, completed)
	end
end

fn client_close_stream_ok(stream: NetStream, completed: Int) -> Result<(), Http2ClientServiceFailure> effects [net::IO]
	match net::close_stream(stream)
		Ok(_) => Ok(())
		Err(error) => Err(Http2ClientServiceFailure::NetworkFailure(completed, error))
	end
end

fn client_fail_close(stream: NetStream, failure: Http2ClientServiceFailure) -> Result<(), Http2ClientServiceFailure> effects [net::IO]
	match net::close_stream(stream)
		Ok(_) => Err(failure)
		Err(error) => Err(Http2ClientServiceFailure::NetworkFailure(client_service_failure_completed(failure), error))
	end
end

fn client_connection_task_failure(completed: Int, failure: Http2ClientServiceFailure) -> Http2ClientServiceFailure
	match failure
		Http2ClientServiceFailure::NetworkFailure(_, error) => Http2ClientServiceFailure::NetworkFailure(completed, error)
		Http2ClientServiceFailure::RequestFailure(_, inner) => Http2ClientServiceFailure::RequestFailure(completed, inner)
		Http2ClientServiceFailure::RequestEncodeFailure(_, reason) => Http2ClientServiceFailure::RequestEncodeFailure(completed, reason)
		Http2ClientServiceFailure::ConnectionFailure(_, Http2ConnectionFailure::TransportFailure(error)) => Http2ClientServiceFailure::NetworkFailure(completed, error)
		Http2ClientServiceFailure::ConnectionFailure(_, inner) => Http2ClientServiceFailure::ConnectionFailure(completed, inner)
		Http2ClientServiceFailure::IncompleteResponse(_, stream_id, lifecycle) => Http2ClientServiceFailure::IncompleteResponse(completed, stream_id, lifecycle)
		_ => failure
	end
end

fn client_spawn_request(stream: NetStream, state: CoreConnectionState, reused: Bool, request: Http2ClientRequest) -> Task<Result<Http2ClientTaskResult, Http2ClientServiceFailure>> effects [net::IO, concurrency]
	let context = { stream: stream, state: state, reused: reused, request: request }
	task::spawn_with<Result<Http2ClientTaskResult, Http2ClientServiceFailure>, { stream : NetStream, state : CoreConnectionState, reused : Bool, request : Http2ClientRequest }>(client_request_task, context)
end

fn client_request_task(context: { stream : NetStream, state : CoreConnectionState, reused : Bool, request : Http2ClientRequest }) -> Result<Http2ClientTaskResult, Http2ClientServiceFailure> effects [net::IO]
	handle client_request_body(context.state, context.reused, context.request) with transport::network::net_stream(context.stream)
end

fn start_server(state: CoreConnectionState) -> Result<CoreConnectionState, Http2ConnectionFailure> effects [std::transport::DuplexStream]
	let decision = require_local_settings_decision(http2::core::send_local_settings_batch(list_nil(), "server", http2::core::connection_state_local_settings_policy(state), http2::core::connection_state_settings_ack(state)))?
	match http2::core::local_settings_send_status(decision)
		"accepted" => drive_loop(http2::core::receive_connection_state(state_after_local_settings(state, decision), byte_chunk([]), http2::core::output_buffer_append_local_settings(http2::core::empty_output_buffer(), decision)), 0)
		"rejected" => Err(Http2ConnectionFailure::LocalSettingsFailure(require_local_settings_failure(decision)?))
		_ => Err(Http2ConnectionFailure::LocalSettingsEncodeFailure(http2::core::local_settings_send_encode_reason(decision)))
	end
end

fn start_server_application<effect E>(state: CoreConnectionState, handler: fn(Http2ApplicationEvent) -> Result<List<Http2ApplicationAction>, String> effects [...E]) -> Result<CoreConnectionState, Http2ApplicationBoundaryFailure> effects [std::transport::DuplexStream, ...E]
	let decision = application_local_settings_decision(http2::core::send_local_settings_batch(list_nil(), "server", http2::core::connection_state_local_settings_policy(state), http2::core::connection_state_settings_ack(state)))?
	match http2::core::local_settings_send_status(decision)
		"accepted" => application_drive_loop(http2::core::receive_connection_state(state_after_local_settings(state, decision), byte_chunk([]), http2::core::output_buffer_append_local_settings(http2::core::empty_output_buffer(), decision)), 0, false, handler)
		"rejected" => Err(Http2ApplicationBoundaryFailure::ConnectionFailure(Http2ConnectionFailure::LocalSettingsFailure(application_local_settings_failure(decision)?)))
		_ => Err(Http2ApplicationBoundaryFailure::ConnectionFailure(Http2ConnectionFailure::LocalSettingsEncodeFailure(http2::core::local_settings_send_encode_reason(decision))))
	end
end

fn start_client(state: CoreConnectionState) -> Result<CoreConnectionState, Http2ConnectionFailure> effects [std::transport::DuplexStream]
	let decision = require_local_settings_decision(http2::core::send_local_settings_batch(list_nil(), "client", http2::core::connection_state_local_settings_policy(state), http2::core::connection_state_settings_ack(state)))?
	match http2::core::local_settings_send_status(decision)
		"accepted" => drive_loop(http2::core::receive_connection_state(state_after_local_settings(state, decision), byte_chunk([]), client_initial_output(decision)?), 0)
		"rejected" => Err(Http2ConnectionFailure::LocalSettingsFailure(require_local_settings_failure(decision)?))
		_ => Err(Http2ConnectionFailure::LocalSettingsEncodeFailure(http2::core::local_settings_send_encode_reason(decision)))
	end
end

fn client_initial_output(decision: LocalSettingsSendDecision) -> Result<CoreOutputBuffer, Http2ConnectionFailure>
	Ok(http2::core::output_buffer_append_local_settings(http2::core::output_buffer_append_chunk(http2::core::empty_output_buffer(), client_preface_bytes()?), decision))
end

fn client_preface_bytes() -> Result<ByteChunk, Http2ConnectionFailure>
	match byte_chunk_from_hex("505249202a20485454502f322e300d0a0d0a534d0d0a0d0a")
		Ok(chunk) => Ok(chunk)
		Err(reason) => Err(Http2ConnectionFailure::LocalSettingsEncodeFailure(reason))
	end
end

fn client_request_body(state: CoreConnectionState, reused: Bool, request: Http2ClientRequest) -> Result<Http2ClientTaskResult, Http2ClientServiceFailure> effects [std::transport::DuplexStream]
	if reused
		client_start_request(http2::core::receive_connection_state_after_initial_settings(state, byte_chunk([]), http2::core::empty_output_buffer()), reused, request)
	else
		client_start_fresh_request(state, request)
	end
end

fn client_start_fresh_request(state: CoreConnectionState, request: Http2ClientRequest) -> Result<Http2ClientTaskResult, Http2ClientServiceFailure> effects [std::transport::DuplexStream]
	let decision = client_local_settings_decision(http2::core::send_local_settings_batch(list_nil(), "client", http2::core::connection_state_local_settings_policy(state), http2::core::connection_state_settings_ack(state)))?
	match http2::core::local_settings_send_status(decision)
		"accepted" => client_start_request(http2::core::receive_connection_state(state_after_local_settings(state, decision), byte_chunk([]), client_initial_output_for_service(decision)?), false, request)
		"rejected" => Err(Http2ClientServiceFailure::ConnectionFailure(0, Http2ConnectionFailure::LocalSettingsFailure(client_local_settings_failure(decision)?)))
		_ => Err(Http2ClientServiceFailure::ConnectionFailure(0, Http2ConnectionFailure::LocalSettingsEncodeFailure(http2::core::local_settings_send_encode_reason(decision))))
	end
end

fn client_initial_output_for_service(decision: LocalSettingsSendDecision) -> Result<CoreOutputBuffer, Http2ClientServiceFailure>
	match client_initial_output(decision)
		Ok(output) => Ok(output)
		Err(failure) => Err(Http2ClientServiceFailure::ConnectionFailure(0, failure))
	end
end

fn client_local_settings_decision(result: Result<LocalSettingsSendDecision, String>) -> Result<LocalSettingsSendDecision, Http2ClientServiceFailure>
	match result
		Ok(decision) => Ok(decision)
		Err(reason) => Err(Http2ClientServiceFailure::ConnectionFailure(0, Http2ConnectionFailure::LocalSettingsEncodeFailure(reason)))
	end
end

fn client_local_settings_failure(decision: LocalSettingsSendDecision) -> Result<LocalSettingsFailure, Http2ClientServiceFailure>
	match http2::core::local_settings_send_failure(decision)
		Ok(failure) => Ok(failure)
		Err(reason) => Err(Http2ClientServiceFailure::ConnectionFailure(0, Http2ConnectionFailure::LocalSettingsEncodeFailure(reason)))
	end
end

fn client_start_request(state: CoreReceiveConnectionState, reused: Bool, request: Http2ClientRequest) -> Result<Http2ClientTaskResult, Http2ClientServiceFailure> effects [std::transport::DuplexStream]
	match request
		Http2ClientBodylessRequest(headers) => client_send_request_headers(state, reused, next_client_request_stream_id(http2::core::receive_connection_connection(state)), headers)
	end
end

fn next_client_request_stream_id(state: CoreConnectionState) -> Int
	http2::core::stream_collection_count(http2::core::connection_state_streams(state)) * 2 + 1
end

fn client_send_request_headers(state: CoreReceiveConnectionState, reused: Bool, stream_id: Int, headers: HeaderList) -> Result<Http2ClientTaskResult, Http2ClientServiceFailure> effects [std::transport::DuplexStream]
	let connection = http2::core::receive_connection_connection(state)
	let decision = http2::core::send_request_headers(connection, http2::core::connection_state_next_offset(connection), stream_id, headers, true)
	match http2::core::headers_send_status(decision)
		"accepted" => client_drive_response(receive_state_with_connection_and_output(state, client_headers_send_state(decision)?, http2::core::output_buffer_append_headers(http2::core::receive_connection_output(state), decision)), 0, stream_id, reused)
		"rejected" => Err(Http2ClientServiceFailure::RequestFailure(0, client_headers_send_failure(decision)?))
		_ => Err(Http2ClientServiceFailure::RequestEncodeFailure(0, http2::core::headers_send_encode_reason(decision)))
	end
end

fn client_headers_send_state(decision: CoreHeadersSendDecision) -> Result<CoreConnectionState, Http2ClientServiceFailure>
	match http2::core::headers_send_state(decision)
		Ok(state) => Ok(state)
		Err(reason) => Err(Http2ClientServiceFailure::RequestEncodeFailure(0, reason))
	end
end

fn client_headers_send_failure(decision: CoreHeadersSendDecision) -> Result<CoreOutboundHeadersFailure, Http2ClientServiceFailure>
	match http2::core::headers_send_failure(decision)
		Ok(failure) => Ok(failure)
		Err(reason) => Err(Http2ClientServiceFailure::RequestEncodeFailure(0, reason))
	end
end

fn client_drive_response(state: CoreReceiveConnectionState, written_count: Int, stream_id: Int, reused: Bool) -> Result<Http2ClientTaskResult, Http2ClientServiceFailure> effects [std::transport::DuplexStream]
	let after_write = client_write_new_output(state, written_count)?
	if client_stream_is_final(http2::core::receive_connection_connection(after_write.state), stream_id)
		Ok(Http2ClientTaskResult(client_response_from(http2::core::receive_connection_connection(after_write.state), stream_id, reused), http2::core::receive_connection_connection(after_write.state)))
	else
		match perform transport::DuplexStream::read_chunk()
			Ok(Some(chunk)) => client_receive_and_continue(after_write.state, chunk, after_write.written_count, stream_id, reused)
			Ok(None) => Err(Http2ClientServiceFailure::IncompleteResponse(0, stream_id, client_stream_lifecycle_label(http2::core::receive_connection_connection(after_write.state), stream_id)))
			Err(error) => Err(Http2ClientServiceFailure::ConnectionFailure(0, Http2ConnectionFailure::TransportFailure(error)))
		end
	end
end

fn client_receive_and_continue(state: CoreReceiveConnectionState, chunk: ByteChunk, written_count: Int, stream_id: Int, reused: Bool) -> Result<Http2ClientTaskResult, Http2ClientServiceFailure> effects [std::transport::DuplexStream]
	let decision = client_receive_decision(http2::core::receive_connection_chunk(state, chunk))?
	match http2::core::receive_connection_status(decision)
		"accepted" => client_drive_response(client_receive_state(decision)?, written_count, stream_id, reused)
		_ => Err(Http2ClientServiceFailure::ConnectionFailure(0, Http2ConnectionFailure::ProtocolFailure(client_receive_failure(decision)?)))
	end
end

fn client_receive_decision(result: Result<CoreReceiveConnectionDecision, String>) -> Result<CoreReceiveConnectionDecision, Http2ClientServiceFailure>
	match result
		Ok(decision) => Ok(decision)
		Err(reason) => Err(Http2ClientServiceFailure::ConnectionFailure(0, Http2ConnectionFailure::LocalSettingsEncodeFailure(reason)))
	end
end

fn client_receive_state(decision: CoreReceiveConnectionDecision) -> Result<CoreReceiveConnectionState, Http2ClientServiceFailure>
	match http2::core::receive_connection_state_from_decision(decision)
		Ok(state) => Ok(state)
		Err(reason) => Err(Http2ClientServiceFailure::ConnectionFailure(0, Http2ConnectionFailure::LocalSettingsEncodeFailure(reason)))
	end
end

fn client_receive_failure(decision: CoreReceiveConnectionDecision) -> Result<CoreReceiveConnectionFailure, Http2ClientServiceFailure>
	match http2::core::receive_connection_failure(decision)
		Ok(failure) => Ok(failure)
		Err(reason) => Err(Http2ClientServiceFailure::ConnectionFailure(0, Http2ConnectionFailure::LocalSettingsEncodeFailure(reason)))
	end
end

fn client_write_new_output(state: CoreReceiveConnectionState, written_count: Int) -> Result<{ state : CoreReceiveConnectionState, written_count : Int }, Http2ClientServiceFailure> effects [std::transport::DuplexStream]
	let output = http2::core::receive_connection_output(state)
	let total = http2::core::output_buffer_count(output)
	if written_count == total
		Ok({ state: state, written_count: written_count })
	else
		client_write_output_range(state, output, written_count, total)
	end
end

fn client_write_output_range(state: CoreReceiveConnectionState, output: CoreOutputBuffer, written_count: Int, total: Int) -> Result<{ state : CoreReceiveConnectionState, written_count : Int }, Http2ClientServiceFailure> effects [std::transport::DuplexStream]
	let chunks = output_chunks_from(output, written_count, total)
	match perform transport::DuplexStream::write_chunks(chunks)
		Ok(()) => Ok({ state: state, written_count: total })
		Err(error) => Err(Http2ClientServiceFailure::ConnectionFailure(0, Http2ConnectionFailure::TransportFailure(error)))
	end
end

fn client_stream_is_final(state: CoreConnectionState, stream_id: Int) -> Bool
	let label = client_stream_lifecycle_label(state, stream_id)
	label == "closed" or label == "reset"
end

fn client_stream_lifecycle_label(state: CoreConnectionState, stream_id: Int) -> String
	match http2::core::stream_collection_find(http2::core::connection_state_streams(state), stream_id)
		Some(entry) => http2::core::stream_lifecycle_label(http2::core::stream_entry_lifecycle(entry))
		None => "missing"
	end
end

fn client_response_from(state: CoreConnectionState, stream_id: Int, reused: Bool) -> Http2ClientResponse
	Http2ClientFinalResponse(stream_id, reused, http2::core::connection_lifecycle_label(http2::core::connection_state_lifecycle(state)), http2::core::stream_collection_active_count(http2::core::connection_state_streams(state)), http2::core::peer_settings_active_max_concurrent_streams(http2::core::connection_state_peer_settings(state)))
end

fn require_local_settings_decision(result: Result<LocalSettingsSendDecision, String>) -> Result<LocalSettingsSendDecision, Http2ConnectionFailure>
	match result
		Ok(decision) => Ok(decision)
		Err(reason) => Err(Http2ConnectionFailure::LocalSettingsEncodeFailure(reason))
	end
end

fn require_local_settings_failure(decision: LocalSettingsSendDecision) -> Result<LocalSettingsFailure, Http2ConnectionFailure>
	match http2::core::local_settings_send_failure(decision)
		Ok(failure) => Ok(failure)
		Err(reason) => Err(Http2ConnectionFailure::LocalSettingsEncodeFailure(reason))
	end
end

fn state_after_local_settings(state: CoreConnectionState, decision: LocalSettingsSendDecision) -> CoreConnectionState
	http2::core::connection_state_with_settings_ack(http2::core::connection_state_with_local_settings_policy(state, http2::core::local_settings_send_policy(decision)), http2::core::local_settings_send_ack_state(decision))
end

fn application_local_settings_decision(result: Result<LocalSettingsSendDecision, String>) -> Result<LocalSettingsSendDecision, Http2ApplicationBoundaryFailure>
	match result
		Ok(decision) => Ok(decision)
		Err(reason) => Err(Http2ApplicationBoundaryFailure::ConnectionFailure(Http2ConnectionFailure::LocalSettingsEncodeFailure(reason)))
	end
end

fn application_local_settings_failure(decision: LocalSettingsSendDecision) -> Result<LocalSettingsFailure, Http2ApplicationBoundaryFailure>
	match http2::core::local_settings_send_failure(decision)
		Ok(failure) => Ok(failure)
		Err(reason) => Err(Http2ApplicationBoundaryFailure::ConnectionFailure(Http2ConnectionFailure::LocalSettingsEncodeFailure(reason)))
	end
end

fn drive_loop(state: CoreReceiveConnectionState, written_count: Int) -> Result<CoreConnectionState, Http2ConnectionFailure> effects [std::transport::DuplexStream]
	let after_write = write_new_output(state, written_count)?
	match perform transport::DuplexStream::read_chunk()
		Ok(Some(chunk)) => receive_and_continue(after_write.state, chunk, after_write.written_count)
		Ok(None) => finish_eof(after_write.state)
		Err(error) => Err(Http2ConnectionFailure::TransportFailure(error))
	end
end

fn application_drive_loop<effect E>(state: CoreReceiveConnectionState, written_count: Int, handled_request: Bool, handler: fn(Http2ApplicationEvent) -> Result<List<Http2ApplicationAction>, String> effects [...E]) -> Result<CoreConnectionState, Http2ApplicationBoundaryFailure> effects [std::transport::DuplexStream, ...E]
	let after_write = write_new_application_output(state, written_count)?
	match perform transport::DuplexStream::read_chunk()
		Ok(Some(chunk)) => application_receive_and_continue(after_write.state, chunk, after_write.written_count, handled_request, handler)
		Ok(None) => application_finish_eof(after_write.state)
		Err(error) => Err(Http2ApplicationBoundaryFailure::TransportFailure(error))
	end
end

fn receive_and_continue(state: CoreReceiveConnectionState, chunk: ByteChunk, written_count: Int) -> Result<CoreConnectionState, Http2ConnectionFailure> effects [std::transport::DuplexStream]
	let decision = require_receive_decision(http2::core::receive_connection_chunk(state, chunk))?
	match http2::core::receive_connection_status(decision)
		"accepted" => drive_loop(require_receive_state(decision)?, written_count)
		_ => Err(Http2ConnectionFailure::ProtocolFailure(require_receive_failure(decision)?))
	end
end

fn application_receive_and_continue<effect E>(state: CoreReceiveConnectionState, chunk: ByteChunk, written_count: Int, handled_request: Bool, handler: fn(Http2ApplicationEvent) -> Result<List<Http2ApplicationAction>, String> effects [...E]) -> Result<CoreConnectionState, Http2ApplicationBoundaryFailure> effects [std::transport::DuplexStream, ...E]
	let decision = application_receive_decision(http2::core::receive_connection_chunk(state, chunk))?
	match http2::core::receive_connection_status(decision)
		"accepted" => application_handle_events(application_receive_state(decision)?, written_count, handled_request, handler)
		_ => Err(Http2ApplicationBoundaryFailure::ConnectionFailure(Http2ConnectionFailure::ProtocolFailure(application_receive_failure(decision)?)))
	end
end

fn application_handle_events<effect E>(state: CoreReceiveConnectionState, written_count: Int, handled_request: Bool, handler: fn(Http2ApplicationEvent) -> Result<List<Http2ApplicationAction>, String> effects [...E]) -> Result<CoreConnectionState, Http2ApplicationBoundaryFailure> effects [std::transport::DuplexStream, ...E]
	let drain = http2::core::drain_application_events(state)
	let events = http2::core::application_event_drain_events(drain)
	let drained_state = http2::core::application_event_drain_state(drain)
	application_handle_event_list(drained_state, events, written_count, handled_request, handler)
end

fn application_handle_event_list<effect E>(state: CoreReceiveConnectionState, events: List<Http2ApplicationEvent>, written_count: Int, handled_request: Bool, handler: fn(Http2ApplicationEvent) -> Result<List<Http2ApplicationAction>, String> effects [...E]) -> Result<CoreConnectionState, Http2ApplicationBoundaryFailure> effects [std::transport::DuplexStream, ...E]
	match events
		Nil => application_drive_loop(state, written_count, handled_request, handler)
		Cons(event, tail) => if handled_request
			Err(Http2ApplicationBoundaryFailure::UnsupportedRequestCount(http2::core::application_event_stream_id(event)))
		else
			application_handle_first_event(state, event, tail, written_count, handler)
		end
	end
end

fn application_handle_first_event<effect E>(state: CoreReceiveConnectionState, event: Http2ApplicationEvent, tail: List<Http2ApplicationEvent>, written_count: Int, handler: fn(Http2ApplicationEvent) -> Result<List<Http2ApplicationAction>, String> effects [...E]) -> Result<CoreConnectionState, Http2ApplicationBoundaryFailure> effects [std::transport::DuplexStream, ...E]
	let stream_id = http2::core::application_event_stream_id(event)
	if not http2::core::application_event_end_stream(event)
		Err(Http2ApplicationBoundaryFailure::UnsupportedRequestShape(stream_id, "request headers do not end the request stream"))
	else
		application_invoke_handler(state, event, tail, written_count, stream_id, handler)
	end
end

fn application_invoke_handler<effect E>(state: CoreReceiveConnectionState, event: Http2ApplicationEvent, tail: List<Http2ApplicationEvent>, written_count: Int, stream_id: Int, handler: fn(Http2ApplicationEvent) -> Result<List<Http2ApplicationAction>, String> effects [...E]) -> Result<CoreConnectionState, Http2ApplicationBoundaryFailure> effects [std::transport::DuplexStream, ...E]
	let actions = application_callback_actions(handler(event))?
	let checked = validate_application_actions(actions, stream_id)?
	let applied = apply_application_actions(state, checked, written_count)?
	application_handle_event_list(applied.state, tail, applied.written_count, true, handler)
end

fn application_callback_actions(result: Result<List<Http2ApplicationAction>, String>) -> Result<List<Http2ApplicationAction>, Http2ApplicationBoundaryFailure>
	match result
		Ok(actions) => Ok(actions)
		Err(reason) => Err(Http2ApplicationBoundaryFailure::CallbackFailure(reason))
	end
end

fn require_receive_decision(result: Result<CoreReceiveConnectionDecision, String>) -> Result<CoreReceiveConnectionDecision, Http2ConnectionFailure>
	match result
		Ok(decision) => Ok(decision)
		Err(reason) => Err(Http2ConnectionFailure::LocalSettingsEncodeFailure(reason))
	end
end

fn application_receive_decision(result: Result<CoreReceiveConnectionDecision, String>) -> Result<CoreReceiveConnectionDecision, Http2ApplicationBoundaryFailure>
	match result
		Ok(decision) => Ok(decision)
		Err(reason) => Err(Http2ApplicationBoundaryFailure::ConnectionFailure(Http2ConnectionFailure::LocalSettingsEncodeFailure(reason)))
	end
end

fn require_receive_state(decision: CoreReceiveConnectionDecision) -> Result<CoreReceiveConnectionState, Http2ConnectionFailure>
	match http2::core::receive_connection_state_from_decision(decision)
		Ok(state) => Ok(state)
		Err(reason) => Err(Http2ConnectionFailure::LocalSettingsEncodeFailure(reason))
	end
end

fn application_receive_state(decision: CoreReceiveConnectionDecision) -> Result<CoreReceiveConnectionState, Http2ApplicationBoundaryFailure>
	match http2::core::receive_connection_state_from_decision(decision)
		Ok(state) => Ok(state)
		Err(reason) => Err(Http2ApplicationBoundaryFailure::ConnectionFailure(Http2ConnectionFailure::LocalSettingsEncodeFailure(reason)))
	end
end

fn require_receive_failure(decision: CoreReceiveConnectionDecision) -> Result<CoreReceiveConnectionFailure, Http2ConnectionFailure>
	match http2::core::receive_connection_failure(decision)
		Ok(failure) => Ok(failure)
		Err(reason) => Err(Http2ConnectionFailure::LocalSettingsEncodeFailure(reason))
	end
end

fn application_receive_failure(decision: CoreReceiveConnectionDecision) -> Result<CoreReceiveConnectionFailure, Http2ApplicationBoundaryFailure>
	match http2::core::receive_connection_failure(decision)
		Ok(failure) => Ok(failure)
		Err(reason) => Err(Http2ApplicationBoundaryFailure::ConnectionFailure(Http2ConnectionFailure::LocalSettingsEncodeFailure(reason)))
	end
end

fn finish_eof(state: CoreReceiveConnectionState) -> Result<CoreConnectionState, Http2ConnectionFailure>
	let decision = require_eof_decision(http2::core::finalize_receive_connection_eof(state))?
	match http2::core::receive_connection_eof_status(decision)
		"accepted" => Ok(require_eof_state(decision)?)
		_ => Err(Http2ConnectionFailure::IncompleteInput(require_eof_failure(decision)?))
	end
end

fn application_finish_eof(state: CoreReceiveConnectionState) -> Result<CoreConnectionState, Http2ApplicationBoundaryFailure>
	let decision = application_eof_decision(http2::core::finalize_receive_connection_eof(state))?
	match http2::core::receive_connection_eof_status(decision)
		"accepted" => Ok(application_eof_state(decision)?)
		_ => Err(Http2ApplicationBoundaryFailure::ConnectionFailure(Http2ConnectionFailure::IncompleteInput(application_eof_failure(decision)?)))
	end
end

fn require_eof_decision(result: Result<CoreReceiveConnectionEofDecision, String>) -> Result<CoreReceiveConnectionEofDecision, Http2ConnectionFailure>
	match result
		Ok(decision) => Ok(decision)
		Err(reason) => Err(Http2ConnectionFailure::LocalSettingsEncodeFailure(reason))
	end
end

fn application_eof_decision(result: Result<CoreReceiveConnectionEofDecision, String>) -> Result<CoreReceiveConnectionEofDecision, Http2ApplicationBoundaryFailure>
	match result
		Ok(decision) => Ok(decision)
		Err(reason) => Err(Http2ApplicationBoundaryFailure::ConnectionFailure(Http2ConnectionFailure::LocalSettingsEncodeFailure(reason)))
	end
end

fn require_eof_state(decision: CoreReceiveConnectionEofDecision) -> Result<CoreConnectionState, Http2ConnectionFailure>
	match http2::core::receive_connection_eof_state(decision)
		Ok(state) => Ok(state)
		Err(reason) => Err(Http2ConnectionFailure::LocalSettingsEncodeFailure(reason))
	end
end

fn application_eof_state(decision: CoreReceiveConnectionEofDecision) -> Result<CoreConnectionState, Http2ApplicationBoundaryFailure>
	match http2::core::receive_connection_eof_state(decision)
		Ok(state) => Ok(state)
		Err(reason) => Err(Http2ApplicationBoundaryFailure::ConnectionFailure(Http2ConnectionFailure::LocalSettingsEncodeFailure(reason)))
	end
end

fn require_eof_failure(decision: CoreReceiveConnectionEofDecision) -> Result<CoreReceiveConnectionEofFailure, Http2ConnectionFailure>
	match http2::core::receive_connection_eof_failure(decision)
		Ok(failure) => Ok(failure)
		Err(reason) => Err(Http2ConnectionFailure::LocalSettingsEncodeFailure(reason))
	end
end

fn application_eof_failure(decision: CoreReceiveConnectionEofDecision) -> Result<CoreReceiveConnectionEofFailure, Http2ApplicationBoundaryFailure>
	match http2::core::receive_connection_eof_failure(decision)
		Ok(failure) => Ok(failure)
		Err(reason) => Err(Http2ApplicationBoundaryFailure::ConnectionFailure(Http2ConnectionFailure::LocalSettingsEncodeFailure(reason)))
	end
end

fn write_new_output(state: CoreReceiveConnectionState, written_count: Int) -> Result<{ state : CoreReceiveConnectionState, written_count : Int }, Http2ConnectionFailure> effects [std::transport::DuplexStream]
	let output = http2::core::receive_connection_output(state)
	let total = http2::core::output_buffer_count(output)
	if written_count == total
		Ok({ state: state, written_count: written_count })
	else
		write_output_range(state, output, written_count, total)
	end
end

fn write_new_application_output(state: CoreReceiveConnectionState, written_count: Int) -> Result<{ state : CoreReceiveConnectionState, written_count : Int }, Http2ApplicationBoundaryFailure> effects [std::transport::DuplexStream]
	let output = http2::core::receive_connection_output(state)
	let total = http2::core::output_buffer_count(output)
	if written_count == total
		Ok({ state: state, written_count: written_count })
	else
		write_application_output_range(state, output, written_count, total)
	end
end

fn write_output_range(state: CoreReceiveConnectionState, output: CoreOutputBuffer, written_count: Int, total: Int) -> Result<{ state : CoreReceiveConnectionState, written_count : Int }, Http2ConnectionFailure> effects [std::transport::DuplexStream]
	let chunks = output_chunks_from(output, written_count, total)
	match perform transport::DuplexStream::write_chunks(chunks)
		Ok(()) => Ok({ state: state, written_count: total })
		Err(error) => Err(Http2ConnectionFailure::TransportFailure(error))
	end
end

fn write_application_output_range(state: CoreReceiveConnectionState, output: CoreOutputBuffer, written_count: Int, total: Int) -> Result<{ state : CoreReceiveConnectionState, written_count : Int }, Http2ApplicationBoundaryFailure> effects [std::transport::DuplexStream]
	let chunks = output_chunks_from(output, written_count, total)
	match perform transport::DuplexStream::write_chunks(chunks)
		Ok(()) => Ok({ state: state, written_count: total })
		Err(error) => Err(Http2ApplicationBoundaryFailure::TransportFailure(error))
	end
end

fn output_chunks_from(output: CoreOutputBuffer, index: Int, total: Int) -> List<ByteChunk>
	if index == total
		list_nil()
	else
		match http2::core::output_buffer_chunk_at(output, index)
			Some(chunk) => list_cons(chunk, output_chunks_from(output, index + 1, total))
			None => list_nil()
		end
	end
end

fn validate_application_actions(actions: List<Http2ApplicationAction>, stream_id: Int) -> Result<List<Http2ApplicationAction>, Http2ApplicationBoundaryFailure>
	match actions
		Nil => Err(Http2ApplicationBoundaryFailure::InvalidActionSequence("response action list must start with HEADERS", 0, 0, stream_id))
		Cons(first, tail) => validate_first_application_action(first, tail, stream_id)
	end
end

fn validate_first_application_action(first: Http2ApplicationAction, tail: List<Http2ApplicationAction>, stream_id: Int) -> Result<List<Http2ApplicationAction>, Http2ApplicationBoundaryFailure>
	match first
		Http2ApplicationAction::Headers(first_stream_id, _, end_stream) => if first_stream_id != stream_id
			Err(Http2ApplicationBoundaryFailure::InvalidActionSequence("response action stream id must match request stream id", 0, first_stream_id, stream_id))
		else if end_stream
			validate_bodyless_response_tail(first, tail, stream_id)
		else
			validate_response_data_tail(first, tail, stream_id)
		end
		Http2ApplicationAction::Data(first_stream_id, _, _) => Err(Http2ApplicationBoundaryFailure::InvalidActionSequence("DATA cannot appear before response HEADERS", 0, first_stream_id, stream_id))
	end
end

fn validate_bodyless_response_tail(first: Http2ApplicationAction, tail: List<Http2ApplicationAction>, stream_id: Int) -> Result<List<Http2ApplicationAction>, Http2ApplicationBoundaryFailure>
	match tail
		Nil => Ok(Cons(first, Nil))
		Cons(extra, _) => Err(Http2ApplicationBoundaryFailure::InvalidActionSequence("response action appears after final action", 1, application_action_stream_id(extra), stream_id))
	end
end

fn validate_response_data_tail(first: Http2ApplicationAction, tail: List<Http2ApplicationAction>, stream_id: Int) -> Result<List<Http2ApplicationAction>, Http2ApplicationBoundaryFailure>
	match tail
		Nil => Err(Http2ApplicationBoundaryFailure::InvalidActionSequence("response DATA must follow non-final HEADERS", 1, 0, stream_id))
		Cons(second, remaining) => match second
			Http2ApplicationAction::Headers(second_stream_id, _, _) => Err(Http2ApplicationBoundaryFailure::InvalidActionSequence("second response action must be final DATA", 1, second_stream_id, stream_id))
			Http2ApplicationAction::Data(second_stream_id, _, end_stream) => if second_stream_id != stream_id
				Err(Http2ApplicationBoundaryFailure::InvalidActionSequence("response action stream id must match request stream id", 1, second_stream_id, stream_id))
			else if not end_stream
				Err(Http2ApplicationBoundaryFailure::InvalidActionSequence("DATA response action must end the response stream", 1, second_stream_id, stream_id))
			else
				validate_final_data_tail(first, second, remaining, stream_id)
			end
		end
	end
end

fn validate_final_data_tail(first: Http2ApplicationAction, second: Http2ApplicationAction, remaining: List<Http2ApplicationAction>, stream_id: Int) -> Result<List<Http2ApplicationAction>, Http2ApplicationBoundaryFailure>
	match remaining
		Nil => Ok(Cons(first, Cons(second, Nil)))
		Cons(extra, _) => Err(Http2ApplicationBoundaryFailure::InvalidActionSequence("response action appears after final action", 2, application_action_stream_id(extra), stream_id))
	end
end

fn apply_application_actions(state: CoreReceiveConnectionState, actions: List<Http2ApplicationAction>, written_count: Int) -> Result<{ state : CoreReceiveConnectionState, written_count : Int }, Http2ApplicationBoundaryFailure> effects [std::transport::DuplexStream]
	match actions
		Nil => Ok({ state: state, written_count: written_count })
		Cons(action, tail) => apply_application_action(state, action, tail, written_count)
	end
end

fn apply_application_action(state: CoreReceiveConnectionState, action: Http2ApplicationAction, tail: List<Http2ApplicationAction>, written_count: Int) -> Result<{ state : CoreReceiveConnectionState, written_count : Int }, Http2ApplicationBoundaryFailure> effects [std::transport::DuplexStream]
	match action
		Http2ApplicationAction::Headers(stream_id, headers, end_stream) => apply_application_headers(state, stream_id, headers, end_stream, tail, written_count)
		Http2ApplicationAction::Data(stream_id, data, end_stream) => apply_application_data(state, stream_id, data, end_stream, tail, written_count)
	end
end

fn apply_application_headers(state: CoreReceiveConnectionState, stream_id: Int, headers: HeaderList, end_stream: Bool, tail: List<Http2ApplicationAction>, written_count: Int) -> Result<{ state : CoreReceiveConnectionState, written_count : Int }, Http2ApplicationBoundaryFailure> effects [std::transport::DuplexStream]
	let connection = http2::core::receive_connection_connection(state)
	let decision = http2::core::send_response_headers(connection, http2::core::connection_state_next_offset(connection), stream_id, headers, end_stream)
	match http2::core::headers_send_status(decision)
		"accepted" => continue_after_committed_action(receive_state_with_connection_and_output(state, application_headers_send_state(decision, stream_id)?, http2::core::output_buffer_append_headers(http2::core::receive_connection_output(state), decision)), tail, written_count)
		"rejected" => Err(Http2ApplicationBoundaryFailure::RejectedHeadersAction(application_headers_send_failure(decision, stream_id)?))
		_ => Err(Http2ApplicationBoundaryFailure::CoreActionEncodeFailure("headers", stream_id, http2::core::headers_send_encode_reason(decision)))
	end
end

fn apply_application_data(state: CoreReceiveConnectionState, stream_id: Int, data: ByteChunk, end_stream: Bool, tail: List<Http2ApplicationAction>, written_count: Int) -> Result<{ state : CoreReceiveConnectionState, written_count : Int }, Http2ApplicationBoundaryFailure> effects [std::transport::DuplexStream]
	let connection = http2::core::receive_connection_connection(state)
	let decision = http2::core::send_data(connection, http2::core::connection_state_next_offset(connection), stream_id, data, end_stream)
	match http2::core::data_send_status(decision)
		"accepted" => continue_after_committed_action(receive_state_with_connection_and_output(state, application_data_send_state(decision, stream_id)?, http2::core::output_buffer_append_data(http2::core::receive_connection_output(state), decision)), tail, written_count)
		"rejected" => Err(Http2ApplicationBoundaryFailure::RejectedDataAction(application_data_send_failure(decision, stream_id)?))
		_ => Err(Http2ApplicationBoundaryFailure::CoreActionEncodeFailure("data", stream_id, http2::core::data_send_encode_reason(decision)))
	end
end

fn application_headers_send_state(decision: CoreHeadersSendDecision, stream_id: Int) -> Result<CoreConnectionState, Http2ApplicationBoundaryFailure>
	match http2::core::headers_send_state(decision)
		Ok(state) => Ok(state)
		Err(reason) => Err(Http2ApplicationBoundaryFailure::CoreActionEncodeFailure("headers", stream_id, reason))
	end
end

fn application_headers_send_failure(decision: CoreHeadersSendDecision, stream_id: Int) -> Result<CoreOutboundHeadersFailure, Http2ApplicationBoundaryFailure>
	match http2::core::headers_send_failure(decision)
		Ok(failure) => Ok(failure)
		Err(reason) => Err(Http2ApplicationBoundaryFailure::CoreActionEncodeFailure("headers", stream_id, reason))
	end
end

fn application_data_send_state(decision: CoreDataSendDecision, stream_id: Int) -> Result<CoreConnectionState, Http2ApplicationBoundaryFailure>
	match http2::core::data_send_state(decision)
		Ok(state) => Ok(state)
		Err(reason) => Err(Http2ApplicationBoundaryFailure::CoreActionEncodeFailure("data", stream_id, reason))
	end
end

fn application_data_send_failure(decision: CoreDataSendDecision, stream_id: Int) -> Result<CoreOutboundDataFlowFailure, Http2ApplicationBoundaryFailure>
	match http2::core::data_send_failure(decision)
		Ok(failure) => Ok(failure)
		Err(reason) => Err(Http2ApplicationBoundaryFailure::CoreActionEncodeFailure("data", stream_id, reason))
	end
end

fn continue_after_committed_action(state: CoreReceiveConnectionState, tail: List<Http2ApplicationAction>, written_count: Int) -> Result<{ state : CoreReceiveConnectionState, written_count : Int }, Http2ApplicationBoundaryFailure> effects [std::transport::DuplexStream]
	let after_write = write_new_application_output(state, written_count)?
	apply_application_actions(after_write.state, tail, after_write.written_count)
end

fn receive_state_with_connection_and_output(state: CoreReceiveConnectionState, connection: CoreConnectionState, output: CoreOutputBuffer) -> CoreReceiveConnectionState
	if http2::core::receive_connection_initial_settings_accepted(state)
		http2::core::receive_connection_state_after_initial_settings(connection, http2::core::receive_connection_input(state), output)
	else
		http2::core::receive_connection_state(connection, http2::core::receive_connection_input(state), output)
	end
end

pub fn application_action_kind(action: Http2ApplicationAction) -> String
	match action
		Http2ApplicationAction::Headers(_, _, _) => "headers"
		Http2ApplicationAction::Data(_, _, _) => "data"
	end
end

pub fn application_action_stream_id(action: Http2ApplicationAction) -> Int
	match action
		Http2ApplicationAction::Headers(stream_id, _, _) => stream_id
		Http2ApplicationAction::Data(stream_id, _, _) => stream_id
	end
end

pub fn application_action_end_stream(action: Http2ApplicationAction) -> Bool
	match action
		Http2ApplicationAction::Headers(_, _, end_stream) => end_stream
		Http2ApplicationAction::Data(_, _, end_stream) => end_stream
	end
end

pub fn application_failure_kind(failure: Http2ApplicationBoundaryFailure) -> String
	match failure
		Http2ApplicationBoundaryFailure::TransportFailure(_) => "transport"
		Http2ApplicationBoundaryFailure::ConnectionFailure(_) => "connection"
		Http2ApplicationBoundaryFailure::CallbackFailure(_) => "callback"
		Http2ApplicationBoundaryFailure::UnsupportedRequestShape(_, _) => "unsupported-request-shape"
		Http2ApplicationBoundaryFailure::UnsupportedRequestCount(_) => "unsupported-request-count"
		Http2ApplicationBoundaryFailure::InvalidActionSequence(_, _, _, _) => "invalid-action-sequence"
		Http2ApplicationBoundaryFailure::RejectedHeadersAction(_) => "rejected-headers-action"
		Http2ApplicationBoundaryFailure::RejectedDataAction(_) => "rejected-data-action"
		Http2ApplicationBoundaryFailure::CoreActionEncodeFailure(_, _, _) => "core-action-encode"
	end
end

pub fn application_failure_reason(failure: Http2ApplicationBoundaryFailure) -> String
	match failure
		Http2ApplicationBoundaryFailure::TransportFailure(net::NetError(_, _, _, _, message)) => message
		Http2ApplicationBoundaryFailure::ConnectionFailure(inner) => connection_failure_reason(inner)
		Http2ApplicationBoundaryFailure::CallbackFailure(reason) => reason
		Http2ApplicationBoundaryFailure::UnsupportedRequestShape(_, reason) => reason
		Http2ApplicationBoundaryFailure::UnsupportedRequestCount(_) => "only one request is supported"
		Http2ApplicationBoundaryFailure::InvalidActionSequence(reason, _, _, _) => reason
		Http2ApplicationBoundaryFailure::RejectedHeadersAction(inner) => http2::core::outbound_headers_failure_rule_provenance(inner)
		Http2ApplicationBoundaryFailure::RejectedDataAction(inner) => http2::core::outbound_data_flow_failure_rule_provenance(inner)
		Http2ApplicationBoundaryFailure::CoreActionEncodeFailure(_, _, reason) => reason
	end
end

pub fn application_failure_id(failure: Http2ApplicationBoundaryFailure) -> String
	match failure
		Http2ApplicationBoundaryFailure::TransportFailure(_) => "http2.application.transport_failure"
		Http2ApplicationBoundaryFailure::ConnectionFailure(inner) => connection_failure_id(inner)
		Http2ApplicationBoundaryFailure::CallbackFailure(_) => "http2.application.callback_failure"
		Http2ApplicationBoundaryFailure::UnsupportedRequestShape(_, _) => "http2.application.unsupported_request_shape"
		Http2ApplicationBoundaryFailure::UnsupportedRequestCount(_) => "http2.application.unsupported_request_count"
		Http2ApplicationBoundaryFailure::InvalidActionSequence(_, _, _, _) => "http2.application.invalid_action_sequence"
		Http2ApplicationBoundaryFailure::RejectedHeadersAction(inner) => http2::core::outbound_headers_failure_id(inner)
		Http2ApplicationBoundaryFailure::RejectedDataAction(inner) => http2::core::outbound_data_flow_failure_id(inner)
		Http2ApplicationBoundaryFailure::CoreActionEncodeFailure(_, _, _) => "http2.application.core_action_encode_failure"
	end
end

pub fn application_failure_stream_id(failure: Http2ApplicationBoundaryFailure) -> Int
	match failure
		Http2ApplicationBoundaryFailure::TransportFailure(_) => 0
		Http2ApplicationBoundaryFailure::ConnectionFailure(inner) => connection_failure_stream_id(inner)
		Http2ApplicationBoundaryFailure::CallbackFailure(_) => 0
		Http2ApplicationBoundaryFailure::UnsupportedRequestShape(stream_id, _) => stream_id
		Http2ApplicationBoundaryFailure::UnsupportedRequestCount(stream_id) => stream_id
		Http2ApplicationBoundaryFailure::InvalidActionSequence(_, _, stream_id, _) => stream_id
		Http2ApplicationBoundaryFailure::RejectedHeadersAction(inner) => http2::core::outbound_headers_failure_stream_id(inner)
		Http2ApplicationBoundaryFailure::RejectedDataAction(inner) => http2::core::outbound_data_flow_failure_stream_id(inner)
		Http2ApplicationBoundaryFailure::CoreActionEncodeFailure(_, stream_id, _) => stream_id
	end
end

pub fn application_failure_action_index(failure: Http2ApplicationBoundaryFailure) -> Int
	match failure
		Http2ApplicationBoundaryFailure::InvalidActionSequence(_, action_index, _, _) => action_index
		_ => -1
	end
end

pub fn service_failure_kind(failure: Http2ServiceFailure) -> String
	match failure
		Http2ServiceFailure::StateFailure(_) => "state"
		Http2ServiceFailure::NetworkFailure(_, _) => "network"
		Http2ServiceFailure::ApplicationFailure(_, inner) => application_failure_kind(inner)
		Http2ServiceFailure::JoinFailure(_, _) => "join"
	end
end

pub fn service_failure_id(failure: Http2ServiceFailure) -> String
	match failure
		Http2ServiceFailure::StateFailure(_) => "http2.service.state_failure"
		Http2ServiceFailure::NetworkFailure(_, _) => "http2.service.network_failure"
		Http2ServiceFailure::ApplicationFailure(_, inner) => application_failure_id(inner)
		Http2ServiceFailure::JoinFailure(_, _) => "http2.service.join_failure"
	end
end

pub fn service_failure_reason(failure: Http2ServiceFailure) -> String
	match failure
		Http2ServiceFailure::StateFailure(reason) => reason
		Http2ServiceFailure::NetworkFailure(_, net::NetError(_, _, _, _, message)) => message
		Http2ServiceFailure::ApplicationFailure(_, inner) => application_failure_reason(inner)
		Http2ServiceFailure::JoinFailure(_, reason) => reason
	end
end

pub fn service_failure_accepted(failure: Http2ServiceFailure) -> Int
	match failure
		Http2ServiceFailure::StateFailure(_) => 0
		Http2ServiceFailure::NetworkFailure(accepted, _) => accepted
		Http2ServiceFailure::ApplicationFailure(accepted, _) => accepted
		Http2ServiceFailure::JoinFailure(accepted, _) => accepted
	end
end

pub fn service_failure_stream_id(failure: Http2ServiceFailure) -> Int
	match failure
		Http2ServiceFailure::StateFailure(_) => 0
		Http2ServiceFailure::NetworkFailure(_, _) => 0
		Http2ServiceFailure::ApplicationFailure(_, inner) => application_failure_stream_id(inner)
		Http2ServiceFailure::JoinFailure(_, _) => 0
	end
end

pub fn connection_failure_kind(failure: Http2ConnectionFailure) -> String
	match failure
		Http2ConnectionFailure::TransportFailure(_) => "transport"
		Http2ConnectionFailure::ProtocolFailure(_) => "protocol"
		Http2ConnectionFailure::IncompleteInput(_) => "incomplete-input"
		Http2ConnectionFailure::LocalSettingsFailure(_) => "local-settings"
		Http2ConnectionFailure::LocalSettingsEncodeFailure(_) => "local-settings-encode"
	end
end

pub fn connection_failure_source(failure: Http2ConnectionFailure) -> String
	match failure
		Http2ConnectionFailure::TransportFailure(net::NetError(operation, _, _, _, _)) => operation
		Http2ConnectionFailure::ProtocolFailure(inner) => http2::core::receive_connection_failure_source(inner)
		Http2ConnectionFailure::IncompleteInput(inner) => http2::core::receive_connection_eof_failure_source(inner)
		Http2ConnectionFailure::LocalSettingsFailure(_) => "local-settings"
		Http2ConnectionFailure::LocalSettingsEncodeFailure(_) => "local-settings"
	end
end

pub fn connection_failure_id(failure: Http2ConnectionFailure) -> String
	match failure
		Http2ConnectionFailure::TransportFailure(_) => "http2.connection.transport_failure"
		Http2ConnectionFailure::ProtocolFailure(inner) => http2::core::receive_connection_failure_id(inner)
		Http2ConnectionFailure::IncompleteInput(inner) => http2::core::receive_connection_eof_failure_id(inner)
		Http2ConnectionFailure::LocalSettingsFailure(inner) => http2::core::local_settings_failure_id(inner)
		Http2ConnectionFailure::LocalSettingsEncodeFailure(_) => "http2.local_settings.encode_failure"
	end
end

pub fn connection_failure_offset(failure: Http2ConnectionFailure) -> Int
	match failure
		Http2ConnectionFailure::TransportFailure(_) => 0
		Http2ConnectionFailure::ProtocolFailure(inner) => http2::core::receive_connection_failure_offset(inner)
		Http2ConnectionFailure::IncompleteInput(inner) => http2::core::receive_connection_eof_failure_offset(inner)
		Http2ConnectionFailure::LocalSettingsFailure(inner) => http2::core::local_settings_failure_offset(inner)
		Http2ConnectionFailure::LocalSettingsEncodeFailure(_) => 0
	end
end

pub fn connection_failure_frame_kind(failure: Http2ConnectionFailure) -> Int
	match failure
		Http2ConnectionFailure::TransportFailure(_) => 0
		Http2ConnectionFailure::ProtocolFailure(inner) => http2::core::receive_connection_failure_frame_kind(inner)
		Http2ConnectionFailure::IncompleteInput(inner) => http2::core::receive_connection_eof_failure_frame_kind(inner)
		Http2ConnectionFailure::LocalSettingsFailure(inner) => http2::core::local_settings_failure_frame_kind(inner)
		Http2ConnectionFailure::LocalSettingsEncodeFailure(_) => 4
	end
end

pub fn connection_failure_stream_id(failure: Http2ConnectionFailure) -> Int
	match failure
		Http2ConnectionFailure::TransportFailure(_) => 0
		Http2ConnectionFailure::ProtocolFailure(inner) => http2::core::receive_connection_failure_stream_id(inner)
		Http2ConnectionFailure::IncompleteInput(inner) => http2::core::receive_connection_eof_failure_stream_id(inner)
		Http2ConnectionFailure::LocalSettingsFailure(_) => 0
		Http2ConnectionFailure::LocalSettingsEncodeFailure(_) => 0
	end
end

pub fn connection_failure_reason(failure: Http2ConnectionFailure) -> String
	match failure
		Http2ConnectionFailure::TransportFailure(net::NetError(_, _, _, _, message)) => message
		Http2ConnectionFailure::ProtocolFailure(inner) => http2::core::receive_connection_failure_reason(inner)
		Http2ConnectionFailure::IncompleteInput(inner) => http2::core::receive_connection_eof_failure_reason(inner)
		Http2ConnectionFailure::LocalSettingsFailure(inner) => http2::core::local_settings_failure_rule_provenance(inner)
		Http2ConnectionFailure::LocalSettingsEncodeFailure(reason) => reason
	end
end

pub fn connection_failure_pending_count(failure: Http2ConnectionFailure) -> Int
	match failure
		Http2ConnectionFailure::TransportFailure(_) => 0
		Http2ConnectionFailure::ProtocolFailure(_) => 0
		Http2ConnectionFailure::IncompleteInput(inner) => http2::core::receive_connection_eof_failure_pending_count(inner)
		Http2ConnectionFailure::LocalSettingsFailure(_) => 0
		Http2ConnectionFailure::LocalSettingsEncodeFailure(_) => 0
	end
end

pub fn connection_failure_expected_count(failure: Http2ConnectionFailure) -> Int
	match failure
		Http2ConnectionFailure::TransportFailure(_) => 0
		Http2ConnectionFailure::ProtocolFailure(_) => 0
		Http2ConnectionFailure::IncompleteInput(inner) => http2::core::receive_connection_eof_failure_expected_count(inner)
		Http2ConnectionFailure::LocalSettingsFailure(_) => 0
		Http2ConnectionFailure::LocalSettingsEncodeFailure(_) => 0
	end
end

pub fn connection_failure_preview(failure: Http2ConnectionFailure) -> ByteChunk
	match failure
		Http2ConnectionFailure::TransportFailure(_) => byte_chunk([])
		Http2ConnectionFailure::ProtocolFailure(inner) => http2::core::receive_connection_failure_preview(inner)
		Http2ConnectionFailure::IncompleteInput(inner) => http2::core::receive_connection_eof_failure_preview(inner)
		Http2ConnectionFailure::LocalSettingsFailure(inner) => byte_view_to_chunk(http2::core::local_settings_failure_preview(inner))
		Http2ConnectionFailure::LocalSettingsEncodeFailure(_) => byte_chunk([])
	end
end
