use prelude
use net
use transport
use transport::network
use transport::net_test_support_test
use transport::net_resource_test_support_test

fn canonical_read() -> Result<Option<ByteChunk>, std::net::NetError> effects [transport::DuplexStream]
	perform transport::DuplexStream::read_chunk()
end

fn canonical_read_result(mode: String) -> Result<{ result : Result<Option<ByteChunk>, std::net::NetError>, trace : List<String> }, String> effects [net, time, concurrency]
	let trace = channel::bounded<List<String>>(1)
	let _ = channel::send(trace.tx, list_nil())
	handle handle canonical_read_result_with_resources(trace) with net::system() with transport::net_test_support_test::scripted_network(mode, trace)
end

fn canonical_read_result_with_resources(trace: { tx : Sender<List<String>>, rx : Receiver<List<String>> }) -> Result<{ result : Result<Option<ByteChunk>, std::net::NetError>, trace : List<String> }, String> effects [net::IO, concurrency]
	let seed = transport::net_resource_test_support_test::stream_or_message("captured")?
	let result: Result<Option<ByteChunk>, std::net::NetError> = handle canonical_read() with transport::network::net_stream(seed)
	let observed: List<String> = option_unwrap_or(channel::recv(trace.rx), list_nil())
	Ok({ result: result, trace: observed })
end

test adapter_read_preserves_data_on_captured_stream_only() -> Result<(), String> effects [net, time, concurrency]
	match transport::net_test_support_test::read_result("data")?
		{ result: Ok(Some(bytes)), trace: Cons("read:captured", Nil) } => if byte_chunk_to_visible_ascii_string(bytes)? == "data"
			Ok(())
		else
			Err("adapter changed the read bytes")
		end
		_ => Err("adapter did not return data from exactly one read of the captured stream")
	end
end

test canonical_adapter_preserves_the_documented_read_boundary() -> Result<(), String> effects [net, time, concurrency]
	match canonical_read_result("data")?
		{ result: Ok(Some(bytes)), trace: Cons("read:captured", Nil) } => if byte_chunk_to_visible_ascii_string(bytes)? == "data"
			Ok(())
		else
			Err("canonical adapter changed the read bytes")
		end
		_ => Err("canonical adapter did not use the captured-stream boundary")
	end
end

test adapter_read_preserves_clean_end_on_captured_stream_only() -> Result<(), String> effects [net, time, concurrency]
	match transport::net_test_support_test::read_result("end")?
		{ result: Ok(None), trace: Cons("read:captured", Nil) } => Ok(())
		_ => Err("adapter did not preserve clean end from exactly one read of the captured stream")
	end
end

test adapter_read_preserves_network_failure_on_captured_stream_only() -> Result<(), String> effects [net, time, concurrency]
	match transport::net_test_support_test::read_result("failure")?
		{ result: result, trace: Cons("read:captured", Nil) } => if transport::net_test_support_test::read_failure_matches(result, "read", "read failed")
			Ok(())
		else
			Err("adapter changed the network failure")
		end
		_ => Err("adapter changed the failure or did not use exactly one read of the captured stream")
	end
end

test adapter_rejects_successful_empty_read_as_typed_non_progress() -> Result<(), String> effects [net, time, concurrency]
	match transport::net_test_support_test::read_result("empty")?
		{ result: result, trace: Cons("read:captured", Nil) } => if transport::net_test_support_test::empty_read_failure_matches(result)
			Ok(())
		else
			Err("adapter changed the typed non-progress failure")
		end
		_ => Err("adapter did not reject one empty read of the captured stream")
	end
end

test adapter_writes_chunks_in_order_and_completes_partial_writes() -> Result<(), String> effects [net, time, concurrency]
	let chunks = list_cons(byte_chunk_from_visible_ascii_string("abc")?, list_cons(byte_chunk_from_visible_ascii_string("xy")?, list_nil()))
	match transport::net_test_support_test::write_result("ordered", chunks)?
		{ result: Ok(()), trace: Cons("write:xy", Cons("write:bc", Cons("write:abc", Nil))) } => Ok(())
		_ => Err("adapter did not complete chunks in list order")
	end
end

test adapter_empty_write_performs_no_io() -> Result<(), String> effects [net, time, concurrency]
	match transport::net_test_support_test::write_result("ordered", list_nil())?
		{ result: Ok(()), trace: Nil } => Ok(())
		_ => Err("adapter performed I/O for an empty chunk list")
	end
end

test adapter_returns_first_write_failure_unchanged() -> Result<(), String> effects [net, time, concurrency]
	let chunks = list_cons(byte_chunk_from_visible_ascii_string("bad")?, list_cons(byte_chunk_from_visible_ascii_string("later")?, list_nil()))
	match transport::net_test_support_test::write_result("write-failure", chunks)?
		{ result: result, trace: Cons("write:bad", Nil) } => if transport::net_test_support_test::write_failure_matches(result, "write", "write failed")
			Ok(())
		else
			Err("adapter changed the first write failure")
		end
		_ => Err("adapter changed the first write failure or continued writing")
	end
end
