use prelude
use net from "std"
use transport
use transport::net
use transport_net_test_support_test

fn read_from_duplex() -> Result<Option<ByteChunk>, net::NetError> effects [transport::DuplexStream]
	perform transport::DuplexStream::read_chunk()
end

fn write_to_duplex(chunks: List<ByteChunk>) -> Result<(), net::NetError> effects [transport::DuplexStream]
	perform transport::DuplexStream::write_chunks(chunks)
end

fn with_adapter_read(scenario: String, state: { tx : Sender<{ index : Int, writes : List<ByteChunk>, operations : List<String> }>, rx : Receiver<{ index : Int, writes : List<ByteChunk>, operations : List<String> }> }) -> Result<Option<ByteChunk>, net::NetError> effects [net, concurrency]
	handle handle read_from_duplex() with transport::net::net_stream(transport_net_test_support_test::legacy_stream()) with transport_net_test_support_test::scripted_io(scenario, state)
end

fn with_adapter_write(scenario: String, state: { tx : Sender<{ index : Int, writes : List<ByteChunk>, operations : List<String> }>, rx : Receiver<{ index : Int, writes : List<ByteChunk>, operations : List<String> }> }, chunks: List<ByteChunk>) -> Result<(), net::NetError> effects [net, concurrency]
	handle handle write_to_duplex(chunks) with transport::net::net_stream(transport_net_test_support_test::legacy_stream()) with transport_net_test_support_test::scripted_io(scenario, state)
end

fn one_operation(observation: { index : Int, writes : List<ByteChunk>, operations : List<String> }, expected: String) -> Bool
	match observation.operations
		Cons(operation, Nil) => observation.index == 1 and operation == expected
		_ => false
	end
end

test adapter_maps_chunk_and_clean_end_without_taking_ownership() -> Result<(), String> effects [net, concurrency]
	let chunk_state = transport_net_test_support_test::adapter_state()
	let chunk = with_adapter_read("read-chunk", chunk_state)
	let chunk_observation = transport_net_test_support_test::adapter_observation(chunk_state)
	let end_state = transport_net_test_support_test::adapter_state()
	let ended = with_adapter_read("read-end", end_state)
	let end_observation = transport_net_test_support_test::adapter_observation(end_state)
	match chunk
		Ok(Some(bytes)) => if chunk_matches(bytes, "0102")? and is_clean_end(ended) and one_operation(chunk_observation, "read") and one_operation(end_observation, "read")
			Ok(())
		else
			Err("inspect net_stream read handling: preserve successful reads and clean end without close or shutdown")
		end
		_ => Err("adapter did not return the successful read chunk")
	end
end

test adapter_rejects_empty_source_read_once_without_taking_ownership() -> Result<(), String> effects [net, concurrency]
	let state = transport_net_test_support_test::adapter_state()
	let result = with_adapter_read("empty-read", state)
	let observation = transport_net_test_support_test::adapter_observation(state)
	match result
		Err(net::NetError("read_stream_chunk", None, None, net::Other, "read returned an empty chunk")) => if one_operation(observation, "read")
			Ok(())
		else
			Err("inspect net_stream read handling: reject an empty read after one IO::read without close or shutdown")
		end
		_ => Err("adapter did not reject the empty source read")
	end
end

fn is_clean_end(result: Result<Option<ByteChunk>, net::NetError>) -> Bool
	match result
		Ok(None) => true
		_ => false
	end
end

test adapter_retries_partial_writes_in_order_without_taking_ownership() -> Result<(), String> effects [net, concurrency]
	let state = transport_net_test_support_test::adapter_state()
	let first = byte_chunk_from_hex("010203")?
	let second = byte_chunk_from_hex("0a0b")?
	let result = with_adapter_write("partial-write", state, list_cons(first, list_cons(second, list_nil())))
	let observation = transport_net_test_support_test::adapter_observation(state)
	match result
		Ok(()) => if write_sequence_matches(observation)?
			Ok(())
		else
			Err("inspect net_stream write handling: retry exact suffixes in list order without close or shutdown")
		end
		Err(_) => Err("adapter did not complete partial writes")
	end
end

fn write_sequence_matches(observation: { index : Int, writes : List<ByteChunk>, operations : List<String> }) -> Result<Bool, String>
	match observation.operations
		Cons(third_operation, Cons(second_operation, Cons(first_operation, Nil))) => match observation.writes
			Cons(third, Cons(second, Cons(first, Nil))) => Ok(observation.index == 3 and first_operation == "write" and second_operation == "write" and third_operation == "write" and chunk_matches(first, "010203")? and chunk_matches(second, "0203")? and chunk_matches(third, "0a0b")?)
			_ => Ok(false)
		end
		_ => Ok(false)
	end
end

fn chunk_matches(actual: ByteChunk, expected_hex: String) -> Result<Bool, String>
	let expected = byte_chunk_from_hex(expected_hex)?
	let count = byte_count_to_int(byte_chunk_count(expected))
	if byte_count_to_int(byte_chunk_count(actual)) == count
		chunk_matches_at(actual, expected, 0, count)
	else
		Ok(false)
	end
end

fn chunk_matches_at(actual: ByteChunk, expected: ByteChunk, index: Int, count: Int) -> Result<Bool, String>
	if index == count
		Ok(true)
	else
		chunk_matches_next(actual, expected, index, count)
	end
end

fn chunk_matches_next(actual: ByteChunk, expected: ByteChunk, index: Int, count: Int) -> Result<Bool, String>
	let one = byte_count(1)?
	let offset = byte_offset(index)?
	if byte_read_u8_be(byte_view(actual, offset, one)?)? == byte_read_u8_be(byte_view(expected, offset, one)?)?
		chunk_matches_at(actual, expected, index + 1, count)
	else
		Ok(false)
	end
end

test adapter_preserves_typed_read_failure_without_taking_ownership() -> Result<(), String> effects [net, concurrency]
	let state = transport_net_test_support_test::adapter_state()
	let result = with_adapter_read("read-failure", state)
	let observation = transport_net_test_support_test::adapter_observation(state)
	match result
		Err(net::NetError("read", _, _, net::PermissionDenied, _)) => if one_operation(observation, "read")
			Ok(())
		else
			Err("inspect net_stream read failure handling: preserve the typed error without close or shutdown")
		end
		_ => Err("adapter did not preserve the typed read failure")
	end
end

test adapter_preserves_typed_write_failure_without_taking_ownership() -> Result<(), String> effects [net, concurrency]
	let state = transport_net_test_support_test::adapter_state()
	let result = with_adapter_write("write-failure", state, list_cons(byte_chunk_from_hex("0102")?, list_nil()))
	let observation = transport_net_test_support_test::adapter_observation(state)
	match result
		Err(net::NetError("write", _, _, net::ConnectionReset, _)) => if one_operation(observation, "write")
			Ok(())
		else
			Err("inspect net_stream write failure handling: stop after the typed error without close or shutdown")
		end
		_ => Err("adapter did not preserve the typed write failure")
	end
end
