use prelude
use net

pub fn stream(label: String) -> Result<net::Stream, net::NetError> effects [net::IO]
	net::connect(net::Address(net::Tcp4, label, 443))
end

pub fn stream_or_message(label: String) -> Result<net::Stream, String> effects [net::IO]
	match stream(label)
		Ok(stream) => Ok(stream)
		Err(net::NetError(_, _, _, _, message)) => Err(message)
	end
end

pub fn listener(label: String) -> Result<net::Listener, net::NetError> effects [net::IO]
	net::listen(net::Address(net::Tcp4, label, 0))
end

pub fn listener_or_message(label: String) -> Result<net::Listener, String> effects [net::IO]
	match listener(label)
		Ok(listener) => Ok(listener)
		Err(net::NetError(_, _, _, _, message)) => Err(message)
	end
end
