use prelude
use transport

pub fn read_stream_chunk(stream: NetStream) -> Option<ByteChunk> effects [net]
	net::read_chunk_or_end(stream)
end

pub fn write_stream_chunks(stream: NetStream, chunks: List<ByteChunk>) -> () effects [net]
	net::write_chunks(stream, chunks)
end

pub handler net_stream(stream: NetStream) handles transport::DuplexStream effects [net]
	read_chunk = read_stream_chunk
	write_chunks = write_stream_chunks
end
