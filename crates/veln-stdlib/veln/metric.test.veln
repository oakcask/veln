use event
use log
use metric
use observe

type CardinalityCase
	CardinalityCase(limit: Int, observations: List<Observation>, expected_series: Int, expected_admitted: Int, expected_drops: Int)
end

fn emit_wrapped() -> () effects [observe::Observe] callsite
	metric::counter_increment(Some(observe::TraceContext("trace-1", "span-2", true)), "request.duration", 3, list_cons(observe::Attribute("route", observe::StringValue("checkout")), list_nil()))
end

fn emit_without_recording() -> Int effects [observe::Observe]
	metric::counter_increment(None, "discarded", 1, list_nil())
	metric::histogram_sample(None, "discarded", 9, list_nil())
	37
end

test metric_records_preserve_kind_values_context_callsite_and_mixed_order() -> Result<(), String> effects [time, concurrency]
	let recording = observe::new_recording("metrics")
	let attributes = list_cons(observe::Attribute("route", observe::StringValue("checkout")), list_nil())
	let result = handle begin
		emit_wrapped()
		event::emit(None, "between", list_nil())
		metric::histogram_sample(Some(observe::TraceContext("trace-1", "span-2", true)), "request.duration", 17, attributes)
		83
	end with observe::recording(recording)
	let first = observe::recorded(recording)
	let second = observe::recorded(recording)
	if result == 83
		match first
			Cons(observe::Emitted(observe::CounterIncrement(observe::CounterIncrementRecord("request.duration", 3, Cons(observe::Attribute("route", observe::StringValue("checkout")), Nil), Some(observe::TraceContext("trace-1", "span-2", true)), counter_source))), Cons(observe::Emitted(observe::Event(observe::EventRecord("between", Nil, None, _))), Cons(observe::Emitted(observe::HistogramSample(observe::HistogramSampleRecord("request.duration", 17, Cons(observe::Attribute("route", observe::StringValue("checkout")), Nil), Some(observe::TraceContext("trace-1", "span-2", true)), histogram_source))), Nil))) => if counter_source.file == "metric.test.veln" and counter_source.start_line == 24 and histogram_source.file == "metric.test.veln" and histogram_source.start_line == 26
				match second
					Cons(observe::Emitted(observe::CounterIncrement(_)), Cons(observe::Emitted(observe::Event(_)), Cons(observe::Emitted(observe::HistogramSample(_)), Nil))) => Ok(())
					_ => Err("second metric snapshot consumed or reordered observations")
				end
			else
				Err("metric helper did not propagate its caller location")
			end
			_ => Err("recording did not preserve metric kinds, values, attributes, context, or mixed order")
		end
	else
		Err("recording changed the handled metric body result")
	end
end

test noop_discards_metric_observations_and_preserves_result() -> Result<(), String>
	let result = handle emit_without_recording() with observe::noop()
	if result == 37
		Ok(())
	else
		Err("no-op observation handler changed the metric body result")
	end
end

test production_metric_cardinality_cases() -> Result<(), String> effects [concurrency]
	let route = observe::Attribute("route", observe::StringValue("checkout"))
	let attempt = observe::Attribute("attempt", observe::IntValue(1))
	let reordered = list_cons(attempt, list_cons(route, list_nil()))
	let ordered = list_cons(route, list_cons(attempt, list_nil()))
	let typed_difference = list_cons(route, list_cons(observe::Attribute("attempt", observe::StringValue("1")), list_nil()))
	let duplicate_difference = list_cons(route, list_cons(attempt, list_cons(attempt, list_nil())))
	let cases = list_cons(
		CardinalityCase(0, list_cons(counter_record("zero", 1, list_nil(), None), list_nil()), 0, 0, 1),
		list_cons(
			CardinalityCase(-1, list_cons(histogram_record("negative", 1, list_nil(), None), list_nil()), 0, 0, 1),
			list_cons(
				CardinalityCase(2, list_cons(counter_record("first", 1, list_nil(), None), list_cons(counter_record("second", 1, list_nil(), None), list_cons(counter_record("first", 99, list_nil(), Some(observe::TraceContext("different-trace", "different-span", false))), list_cons(counter_record("third", 1, list_nil(), None), list_nil())))), 2, 3, 1),
				list_cons(
					CardinalityCase(2, list_cons(counter_record("same-name", 1, list_nil(), None), list_cons(histogram_record("same-name", 1, list_nil(), None), list_nil())), 2, 2, 0),
					list_cons(
						CardinalityCase(1, list_cons(histogram_record("histogram-value", 7, ordered, Some(observe::TraceContext("trace-a", "span-a", true))), list_cons(histogram_record("histogram-value", 99, reordered, Some(observe::TraceContext("trace-b", "span-b", false))), list_nil())), 1, 2, 0),
						list_cons(CardinalityCase(3, list_cons(counter_record("attributes", 1, ordered, None), list_cons(counter_record("attributes", 2, reordered, None), list_cons(counter_record("attributes", 3, typed_difference, None), list_cons(counter_record("attributes", 4, duplicate_difference, None), list_nil())))), 3, 4, 0), list_nil())
					)
				)
			)
		)
	)
	if cardinality_cases_pass(cases)
		Ok(())
	else
		Err("production metric cardinality table did not preserve its boundary, identity, or drop rules")
	end
end

test production_cardinality_index_work_scales_below_complete_series_scans() -> Result<(), String> effects [concurrency]
	let small = indexed_cardinality_work(256, 64)
	let large = indexed_cardinality_work(1024, 64)
	if small.correct and large.correct and small.fill_work <= 96 * 512 and large.fill_work <= 96 * 2048 and large.fill_work <= 7 * small.fill_work + 256 and small.full_work <= 64 * 128 and large.full_work <= 64 * 128 and large.full_work <= 2 * small.full_work + 256
		Ok(())
	else
		begin
			let fill = string::concat(string::concat("small fill ", int_to_string(small.fill_work)), string::concat(", large fill ", int_to_string(large.fill_work)))
			let full = string::concat(string::concat(", small full ", int_to_string(small.full_work)), string::concat(", large full ", int_to_string(large.full_work)))
			Err(string::concat("production metric identity index work grew like a complete retained-series scan: ", string::concat(fill, full)))
		end
	end
end

test production_cardinality_preserves_results_and_non_metric_operations() -> Result<(), String> effects [concurrency]
	let production = observe::new_production(1)
	let result = handle begin
		log::info(None, "before", list_nil())
		event::emit(None, "domain.event", list_nil())
		let span = perform observe::Observe::start_span(observe::SpanRequest("work", None, list_nil()))
		perform observe::Observe::finish_span(observe::finish(span))
		metric::counter_increment(None, "admitted", 1, list_nil())
		metric::counter_increment(None, "dropped", 1, list_nil())
		73
	end with observe::production(production)
	match observe::production_health(production)
		observe::ProductionHealth(1, 1, 1) => match observe::production_health(production)
			observe::ProductionHealth(1, 1, 1) => if result == 73
				Ok(())
			else
				Err("dropping a metric changed the handled application result")
			end
			_ => Err("production health snapshot consumed or changed metric state")
		end
		_ => Err("non-metric observations changed production metric health or a full policy admitted an unseen series")
	end
end

test production_cardinality_state_is_isolated_per_handler() -> Result<(), String> effects [concurrency]
	let first = observe::new_production(1)
	let second = observe::new_production(1)
	let _ = handle begin
		metric::counter_increment(None, "first", 1, list_nil())
		metric::counter_increment(None, "second", 1, list_nil())
	end with observe::production(first)
	let _ = handle begin
		metric::counter_increment(None, "second", 1, list_nil())
		metric::counter_increment(None, "second", 2, list_nil())
	end with observe::production(second)
	match observe::production_health(first)
		observe::ProductionHealth(1, 1, 1) => match observe::production_health(second)
			observe::ProductionHealth(1, 2, 0) => Ok(())
			_ => Err("second production handler did not retain isolated cardinality state")
		end
		_ => Err("first production handler did not retain isolated cardinality state")
	end
end

test production_cardinality_serializes_concurrent_emissions() -> Result<(), String> effects [concurrency]
	let distinct = observe::new_production(1)
	let distinct_result = handle concurrent_metric_body("concurrent-first", "concurrent-second") with observe::production(distinct)
	let repeated = observe::new_production(1)
	let repeated_result = handle concurrent_metric_body("concurrent-known", "concurrent-known") with observe::production(repeated)
	match observe::production_health(distinct)
		observe::ProductionHealth(1, 1, 1) => match observe::production_health(repeated)
			observe::ProductionHealth(1, 2, 0) => if distinct_result == 2 and repeated_result == 2
				Ok(())
			else
				Err("concurrent metric workers changed their application results")
			end
			_ => Err("concurrent known-series emissions were not both admitted")
		end
		_ => Err("concurrent distinct emissions oversubscribed the final series slot")
	end
end

test production_cardinality_completes_increasing_mixed_emission_and_health_batches_with_correct_final_health() -> Result<(), String> effects [concurrency]
	if mixed_production_batch_passes(2) and mixed_production_batch_passes(8) and mixed_production_batch_passes(32)
		Ok(())
	else
		Err("mixed concurrent metric emissions and health reads did not all complete with correct final health")
	end
end

fn counter_record(name: String, value: Int, attributes: List<Attribute>, context: Option<TraceContext>) -> Observation callsite
	observe::CounterIncrement(observe::CounterIncrementRecord(name, value, attributes, context, callsite))
end

fn histogram_record(name: String, value: Int, attributes: List<Attribute>, context: Option<TraceContext>) -> Observation callsite
	observe::HistogramSample(observe::HistogramSampleRecord(name, value, attributes, context, callsite))
end

fn cardinality_cases_pass(cases: List<CardinalityCase>) -> Bool effects [concurrency]
	match cases
		Nil => true
		Cons(case, remaining) => if cardinality_case_passes(case)
			cardinality_cases_pass(remaining)
		else
			false
		end
	end
end

fn cardinality_case_passes(case: CardinalityCase) -> Bool effects [concurrency]
	match case
		CardinalityCase(limit, observations, expected_series, expected_admitted, expected_drops) => begin
			let production = observe::new_production(limit)
			let _ = handle emit_observations(observations) with observe::production(production)
			match observe::production_health(production)
				observe::ProductionHealth(series, admitted, drops) => series == expected_series and admitted == expected_admitted and drops == expected_drops
			end
		end
	end
end

fn emit_observations(observations: List<Observation>) -> () effects [observe::Observe]
	match observations
		Nil => ()
		Cons(observation, remaining) => begin
			perform observe::Observe::emit(observation)
			emit_observations(remaining)
		end
	end
end

fn concurrent_metric_body(first_name: String, second_name: String) -> Int effects [observe::Observe, concurrency]
	let first = task::spawn_with<Int, String>(concurrent_metric_worker, first_name)
	let second = task::spawn_with<Int, String>(concurrent_metric_worker, second_name)
	let first_result = match task::join(first)
		Ok(value) => value
		Err(_) => 0
	end
	let second_result = match task::join(second)
		Ok(value) => value
		Err(_) => 0
	end
	first_result + second_result
end

fn concurrent_metric_worker(name: String) -> Int effects [observe::Observe]
	metric::counter_increment(None, name, 1, list_nil())
	1
end

fn mixed_production_batch_passes(worker_count: Int) -> Bool effects [concurrency]
	let production = observe::new_production(1)
	let entered = channel::bounded<()>(worker_count)
	let release = channel::bounded<()>(worker_count)
	let workers = handle spawn_mixed_production_workers(worker_count, true, production, entered.tx, release.rx, list_nil()) with observe::production(production)
	let entered_count = receive_units(worker_count, entered.rx, 0)
	let _ = send_units(worker_count, release.tx)
	let completed = join_mixed_production_workers(workers, 0)
	match observe::production_health(production)
		observe::ProductionHealth(series, admitted, dropped) => entered_count == worker_count and completed == worker_count and series == 1 and admitted == (worker_count + 1) / 2 and dropped == 0
	end
end

fn spawn_mixed_production_workers(remaining: Int, emit_metric: Bool, production: Production, entered: Sender<()>, release: Receiver<()>, workers: List<Task<Int>>) -> List<Task<Int>> effects [observe::Observe, concurrency]
	if remaining == 0
		workers
	else
		begin
			let worker = task::spawn_with<Int, { emit_metric : Bool, production : Production, entered : Sender<()>, release : Receiver<()> }>(mixed_production_worker, { emit_metric: emit_metric, production: production, entered: entered, release: release })
			let next_emit_metric = if emit_metric
				false
			else
				true
			end
			spawn_mixed_production_workers(remaining - 1, next_emit_metric, production, entered, release, list_cons(worker, workers))
		end
	end
end

fn mixed_production_worker(context: { emit_metric : Bool, production : Production, entered : Sender<()>, release : Receiver<()> }) -> Int effects [observe::Observe, concurrency]
	let _ = channel::send(context.entered, ())
	let _ = channel::recv(context.release)
	let _ = if context.emit_metric
		metric::counter_increment(None, "mixed-known", 1, list_nil())
	else
		begin
			let _ = observe::production_health(context.production)
			()
		end
	end
	1
end

fn receive_units(remaining: Int, receiver: Receiver<()>, received: Int) -> Int effects [concurrency]
	if remaining == 0
		received
	else
		match channel::recv(receiver)
			Some(_) => receive_units(remaining - 1, receiver, received + 1)
			None => received
		end
	end
end

fn send_units(remaining: Int, sender: Sender<()>) -> () effects [concurrency]
	if remaining == 0
		()
	else
		begin
			let _ = channel::send(sender, ())
			send_units(remaining - 1, sender)
		end
	end
end

fn join_mixed_production_workers(workers: List<Task<Int>>, completed: Int) -> Int effects [concurrency]
	match workers
		Nil => completed
		Cons(worker, remaining) => match task::join(worker)
			Ok(value) => join_mixed_production_workers(remaining, completed + value)
			Err(_) => join_mixed_production_workers(remaining, completed)
		end
	end
end

fn indexed_cardinality_work(distinct_values: Int, fixed_checks: Int) -> { fill_work : Int, full_work : Int, correct : Bool } effects [concurrency]
	let production = observe::new_production(distinct_values * 2)
	let _ = handle emit_indexed_distinct_series(distinct_values) with observe::production(production)
	let fill_work = observe::production_index_work_for_test(production)
	observe::reset_production_index_work_for_test(production)
	let _ = handle begin
		emit_indexed_known_series(fixed_checks, distinct_values)
		emit_indexed_unseen_series(fixed_checks, distinct_values)
	end with observe::production(production)
	let full_work = observe::production_index_work_for_test(production)
	match observe::production_health(production)
		observe::ProductionHealth(series, admitted, dropped) => { fill_work: fill_work, full_work: full_work, correct: series == distinct_values * 2 and admitted == distinct_values * 2 + fixed_checks and dropped == fixed_checks }
	end
end

fn emit_indexed_distinct_series(remaining: Int) -> () effects [observe::Observe] callsite
	if remaining == 0
		()
	else
		begin
			metric::counter_increment(None, "indexed", 1, list_cons(observe::Attribute("value", observe::IntValue(remaining)), list_nil()))
			metric::counter_increment(None, "indexed", 1, list_cons(observe::Attribute("value", observe::StringValue(int_to_string(remaining))), list_nil()))
			emit_indexed_distinct_series(remaining - 1)
		end
	end
end

fn emit_indexed_known_series(remaining: Int, distinct_values: Int) -> () effects [observe::Observe] callsite
	if remaining == 0
		()
	else
		begin
			metric::counter_increment(None, "indexed", remaining, list_cons(observe::Attribute("value", observe::IntValue(distinct_values - remaining + 1)), list_nil()))
			emit_indexed_known_series(remaining - 1, distinct_values)
		end
	end
end

fn emit_indexed_unseen_series(remaining: Int, distinct_values: Int) -> () effects [observe::Observe] callsite
	if remaining == 0
		()
	else
		begin
			metric::counter_increment(None, "indexed", remaining, list_cons(observe::Attribute("value", observe::IntValue(distinct_values + remaining)), list_nil()))
			emit_indexed_unseen_series(remaining - 1, distinct_values)
		end
	end
end
