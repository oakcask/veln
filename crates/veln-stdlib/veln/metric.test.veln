use event
use metric
use observe

fn emit_wrapped() -> () effects [observe::Observe] callsite
	metric::counter_increment(Some(observe::TraceContext("trace-1", "span-2")), "request.duration", 3, list_cons(observe::Attribute("route", observe::StringValue("checkout")), list_nil()))
end

fn emit_without_recording() -> Int effects [observe::Observe]
	metric::counter_increment(None, "discarded", 1, list_nil())
	metric::histogram_sample(None, "discarded", 9, list_nil())
	37
end

test metric_records_preserve_kind_values_context_callsite_and_mixed_order() -> Result<(), String> effects [time, concurrency]
	let recording = observe::new_recording("metrics")
	let attributes = list_cons(observe::Attribute("route", observe::StringValue("checkout")), list_nil())
	let result = handle begin
		emit_wrapped()
		event::emit(None, "between", list_nil())
		metric::histogram_sample(Some(observe::TraceContext("trace-1", "span-2")), "request.duration", 17, attributes)
		83
	end with observe::recording(recording)
	let first = observe::recorded(recording)
	let second = observe::recorded(recording)
	if result == 83
		match first
			Cons(observe::Emitted(observe::CounterIncrement(observe::CounterIncrementRecord("request.duration", 3, Cons(observe::Attribute("route", observe::StringValue("checkout")), Nil), Some(observe::TraceContext("trace-1", "span-2")), counter_source))), Cons(observe::Emitted(observe::Event(observe::EventRecord("between", Nil, None, _))), Cons(observe::Emitted(observe::HistogramSample(observe::HistogramSampleRecord("request.duration", 17, Cons(observe::Attribute("route", observe::StringValue("checkout")), Nil), Some(observe::TraceContext("trace-1", "span-2")), histogram_source))), Nil))) => if counter_source.file == "metric.test.veln" and counter_source.start_line == 19 and histogram_source.file == "metric.test.veln" and histogram_source.start_line == 21
				match second
					Cons(observe::Emitted(observe::CounterIncrement(_)), Cons(observe::Emitted(observe::Event(_)), Cons(observe::Emitted(observe::HistogramSample(_)), Nil))) => Ok(())
					_ => Err("second metric snapshot consumed or reordered observations")
				end
			else
				Err("metric helper did not propagate its caller location")
			end
			_ => Err("recording did not preserve metric kinds, values, attributes, context, or mixed order")
		end
	else
		Err("recording changed the handled metric body result")
	end
end

test noop_discards_metric_observations_and_preserves_result() -> Result<(), String>
	let result = handle emit_without_recording() with observe::noop()
	if result == 37
		Ok(())
	else
		Err("no-op observation handler changed the metric body result")
	end
end
