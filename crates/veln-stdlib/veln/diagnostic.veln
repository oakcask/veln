use bytes

type RuntimeDiagnostic
	pub RuntimeDiagnostic(id: String, message: String, detail: RuntimeDiagnosticDetail)
end

type RuntimeDiagnosticDetail
	pub ByteDiagnostic(byte_offset: ByteOffset, field_path: List<RuntimeDiagnosticFieldPathSegment>, facts: RuntimeByteDiagnosticFacts, preview: RuntimeBytePreview)
	pub ValueDiagnostic(field_path: List<RuntimeDiagnosticFieldPathSegment>, reason: String)
	pub Http2Diagnostic(detail: Http2DiagnosticDetail)
	pub Http2HpackDiagnostic(detail: HpackDiagnosticDetail)
end

type HpackDiagnosticDetail
	pub Diagnostic(byte_offset: Int, observed_header_block_size: Int, observed_first_byte: Int, expected_fixture: String, codec_module: String, preview: ByteChunk)
	pub DynamicIndexDiagnostic(byte_offset: Int, observed_header_block_size: Int, observed_first_byte: Int, requested_dynamic_index: Int, dynamic_table_entry_count: Int, expected_fixture: String, codec_module: String, preview: ByteChunk)
	pub DynamicNameDiagnostic(byte_offset: Int, observed_header_block_size: Int, observed_first_byte: Int, requested_dynamic_index: Int, dynamic_table_entry_count: Int, expected_fixture: String, codec_module: String, preview: ByteChunk)
	pub TableSizeUpdateDiagnostic(byte_offset: Int, observed_header_block_size: Int, observed_first_byte: Int, observed_header_table_size: Int, frame_kind: Int, stream_id: Int, active_state: String, expected_fixture: String, codec_module: String, preview: ByteChunk)
end

type Http2DiagnosticDetail
	pub ProtocolClosedWithPendingDiagnostic(byte_offset: Int, pending_count: Int, active_continuation: String, expected_stream_id: Int, started_frame_kind: Int, started_byte_offset: Int, accumulated_header_block_bytes: Int, rule_provenance: String, preview: ByteChunk)
	pub ProtocolPartialPrefaceDiagnostic(byte_offset: Int, pending_count: Int, expected_count: Int, active_state: String, rule_provenance: String, preview: ByteChunk)
	pub ProtocolInvalidPrefaceDiagnostic(byte_offset: Int, expected_byte: Int, actual_byte: Int, matched_prefix_count: Int, expected_count: Int, active_state: String, rule_provenance: String, preview: ByteChunk)
	pub ProtocolInitialPeerSettingsRequiredDiagnostic(byte_offset: Int, actual_frame_kind: Int, actual_flags: Int, stream_id: Int, endpoint_role: String, active_state: String, rule_provenance: String, preview: ByteChunk)
	pub ProtocolContinuationExpectedDiagnostic(byte_offset: Int, actual_frame_kind: Int, actual_stream_id: Int, expected_stream_id: Int, started_frame_kind: Int, started_byte_offset: Int, active_continuation: String, accumulated_header_block_bytes: Int, rule_provenance: String, preview: ByteChunk)
	pub ProtocolInvalidFrameKindDiagnostic(byte_offset: Int, actual_frame_kind: Int, stream_id: Int, expected_frame_kind: Int, active_state: String, rule_provenance: String, preview: ByteChunk)
	pub ProtocolInvalidStreamIdDiagnostic(byte_offset: Int, frame_kind: Int, stream_id: Int, required_stream_id_domain: String, endpoint_role: String, active_state: String, rule_provenance: String, preview: ByteChunk)
	pub ProtocolPeerStreamIdNotIncreasingDiagnostic(byte_offset: Int, stream_id: Int, previous_peer_stream_id: Int, endpoint_role: String, active_state: String, rule_provenance: String, preview: ByteChunk)
	pub PeerLimitFrameSizeDiagnostic(byte_offset: Int, observed_payload_length: Int, allowed_max_frame_size: Int, frame_kind: Int, stream_id: Int, receive_limit_provenance: String, preview: ByteChunk)
	pub PeerLimitHeaderListSizeDiagnostic(byte_offset: Int, observed_header_list_size: Int, allowed_header_list_size: Int, frame_kind: Int, stream_id: Int, receive_limit_provenance: String, rule_provenance: String, preview: ByteChunk)
	pub PeerLimitHeaderTableSizeDiagnostic(byte_offset: Int, observed_header_table_size: Int, allowed_header_table_size: Int, frame_kind: Int, stream_id: Int, receive_limit_provenance: String, rule_provenance: String, preview: ByteChunk)
	pub PeerLimitConcurrentStreamsDiagnostic(byte_offset: Int, stream_id: Int, attempted_concurrent_stream_count: Int, allowed_concurrent_stream_count: Int, endpoint_role: String, active_state: String, receive_limit_provenance: String, rule_provenance: String, preview: ByteChunk)
	pub PeerLimitSettingsValueDiagnostic(byte_offset: Int, setting_identifier: Int, setting_name: String, observed_value: Int, accepted_min_value: Int, accepted_max_value: Int, peer_limit_provenance: String, preview: ByteChunk)
	pub ProtocolInvalidPayloadLengthDiagnostic(byte_offset: Int, frame_kind: Int, stream_id: Int, observed_payload_length: Int, expected_payload_length: Int, active_state: String, rule_provenance: String, preview: ByteChunk)
	pub ProtocolInvalidDataPaddingDiagnostic(byte_offset: Int, stream_id: Int, pad_length: Int, remaining_payload_length: Int, active_state: String, rule_provenance: String, preview: ByteChunk)
	pub PeerLimitFlowControlWindowDiagnostic(byte_offset: Int, observed_payload_length: Int, allowed_window_credit: Int, frame_kind: Int, stream_id: Int, active_state: String, rule_provenance: String, preview: ByteChunk)
	pub ProtocolContentLengthMismatchDiagnostic(byte_offset: Int, frame_kind: Int, stream_id: Int, expected_content_length: Int, observed_body_length: Int, active_state: String, rule_provenance: String, preview: ByteChunk)
	pub ProtocolInvalidRequestHeaderListDiagnostic(byte_offset: Int, frame_kind: Int, stream_id: Int, failed_header_fact: String, header_name: String, decoded_header_names: String, active_state: String, rule_provenance: String, preview: ByteChunk)
	pub ProtocolInvalidResponseHeaderListDiagnostic(byte_offset: Int, frame_kind: Int, stream_id: Int, failed_header_fact: String, header_name: String, decoded_header_names: String, active_state: String, rule_provenance: String, preview: ByteChunk)
	pub ProtocolInvalidWindowUpdateIncrementDiagnostic(byte_offset: Int, stream_id: Int, observed_window_increment: Int, accepted_min_window_increment: Int, accepted_max_window_increment: Int, active_state: String, rule_provenance: String, preview: ByteChunk)
	pub ProtocolUnexpectedSettingsAckDiagnostic(byte_offset: Int, active_state: String, rule_provenance: String, preview: ByteChunk)
	pub ProtocolSettingsNotAllowedForEndpointDiagnostic(byte_offset: Int, setting_identifier: Int, setting_name: String, endpoint_role: String, frame_kind: Int, active_state: String, rule_provenance: String, preview: ByteChunk)
	pub ProtocolPriorityDependencyDiagnostic(byte_offset: Int, stream_id: Int, dependency_stream_id: Int, active_state: String, rule_provenance: String, preview: ByteChunk)
	pub ProtocolStreamAfterGoawayDiagnostic(byte_offset: Int, stream_id: Int, last_stream_id: Int, shutdown_state: String, endpoint_role: String, rule_provenance: String, preview: ByteChunk)
end

type RuntimeDiagnosticFieldPathSegment
	pub RuntimeDiagnosticFieldPathSegment(kind: String, name: String)
end

type RuntimeByteDiagnosticFacts
	pub CountFacts(expected_count: ByteCount, available_count: ByteCount, readiness: String)
	pub RangeFacts(requested_count: ByteCount, available_count: ByteCount)
	pub FixedValueFacts(expected_value: Int, actual_value: Int)
	pub ReasonFacts(reason: String)
end

type RuntimeBytePreview
	pub RuntimeBytePreview(data: String, preview_byte_count: ByteCount, total_byte_count: ByteCount, truncated: Bool)
	pub NoRuntimeBytePreview
end
