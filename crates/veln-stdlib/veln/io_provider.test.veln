		Err("missing io::Read did not reject Duplex before publication")
	else if not is_unsupported(duplex_without_write(owner, 133, calls.tx)) or not no_handler_calls(calls.rx) or not registration_succeeded(complete_duplex_registration(owner, 133, calls.tx)) or not no_handler_calls(calls.rx)
		Err("missing io::Write did not reject Duplex before publication")
	else if not is_unsupported(duplex_without_close(owner, 134, calls.tx)) or not no_handler_calls(calls.rx) or not registration_succeeded(complete_duplex_registration(owner, 134, calls.tx)) or not no_handler_calls(calls.rx)
