fn update_registration_and_projection_observations() -> Result<(), String> effects [io_provider::Scope, concurrency]
	let owner = io_provider::owner()
	let slot = 91
	let calls = channel::bounded<String>(32)
	match complete_update_registration(owner, slot, calls.tx)
		Ok(resource) => if not no_handler_calls(calls.rx) or not projected_update_slots_match(owner, resource, slot)
			Err("UpdateFile registration or projection did not retain all identities")
		else
			match io_provider::read_file(resource)
				Err(io::Error::Error(_, io::ErrorKind::Unsupported, _, _, _, _, _)) => match io_provider::write_file(resource)
					Err(io::Error::Error(_, io::ErrorKind::Unsupported, _, _, _, _, _)) => match io_provider::append_file(resource)
						Err(io::Error::Error(_, io::ErrorKind::Unsupported, _, _, _, _, _)) => match io_provider::duplex(resource)
							Err(io::Error::Error(_, io::ErrorKind::Unsupported, _, _, _, _, _)) => if projected_update_slots_match(owner, resource, slot) and no_handler_calls(calls.rx)
								Ok(())
							else
								Err("failed projections changed the UpdateFile resource or invoked a handler")
							end
							_ => Err("UpdateFile resource accepted an incompatible Duplex projection")
						end
						_ => Err("UpdateFile resource accepted an incompatible AppendFile projection")
					end
					_ => Err("UpdateFile resource accepted an incompatible WriteFile projection")
				end
				_ => Err("UpdateFile resource accepted an incompatible ReadFile projection")
			end
		end
		Err(_) => Err("complete UpdateFile registration failed")
	end
end

fn update_missing_handlers_preserve_slots() -> Result<(), String> effects [io_provider::Scope, concurrency]
	let owner = io_provider::owner()
	let calls = channel::bounded<String>(32)
	if not is_unsupported(update_without_read(owner, 101, calls.tx)) or not no_handler_calls(calls.rx) or not registration_succeeded(complete_update_registration(owner, 101, calls.tx)) or not no_handler_calls(calls.rx)
		Err("missing io::Read did not reject UpdateFile before publication")
	else if not is_unsupported(update_without_write(owner, 102, calls.tx)) or not no_handler_calls(calls.rx) or not registration_succeeded(complete_update_registration(owner, 102, calls.tx)) or not no_handler_calls(calls.rx)
		Err("missing io::Write did not reject UpdateFile before publication")
	else if not is_unsupported(update_without_seek(owner, 103, calls.tx)) or not no_handler_calls(calls.rx) or not registration_succeeded(complete_update_registration(owner, 103, calls.tx)) or not no_handler_calls(calls.rx)
		Err("missing io::Seek did not reject UpdateFile before publication")
	else if not is_unsupported(update_without_read_at(owner, 104, calls.tx)) or not no_handler_calls(calls.rx) or not registration_succeeded(complete_update_registration(owner, 104, calls.tx)) or not no_handler_calls(calls.rx)
		Err("missing io::ReadAt did not reject UpdateFile before publication")
	else if not is_unsupported(update_without_write_at(owner, 105, calls.tx)) or not no_handler_calls(calls.rx) or not registration_succeeded(complete_update_registration(owner, 105, calls.tx)) or not no_handler_calls(calls.rx)
		Err("missing io::WriteAt did not reject UpdateFile before publication")
	else if not is_unsupported(update_without_close(owner, 106, calls.tx)) or not no_handler_calls(calls.rx) or not registration_succeeded(complete_update_registration(owner, 106, calls.tx)) or not no_handler_calls(calls.rx)
		Err("missing io::Close did not reject UpdateFile before publication")
	else if not is_unsupported(update_without_sync(owner, 107, calls.tx)) or not no_handler_calls(calls.rx) or not registration_succeeded(complete_update_registration(owner, 107, calls.tx)) or not no_handler_calls(calls.rx)
		Err("missing io::Sync did not reject UpdateFile before publication")
	else if not is_unsupported(update_without_mutate(owner, 108, calls.tx)) or not no_handler_calls(calls.rx) or not registration_succeeded(complete_update_registration(owner, 108, calls.tx)) or not no_handler_calls(calls.rx)
		Err("missing fs::Mutate did not reject UpdateFile before publication")
	else
		Ok(())
	end
end

fn update_duplicate_registrations_preserve_originals() -> Result<(), String> effects [io_provider::Scope, concurrency]
	let owner = io_provider::owner()
	let calls = channel::bounded<String>(32)
	if not is_invalid_input(complete_update_registration(owner, -1, calls.tx)) or not no_handler_calls(calls.rx)
		Err("UpdateFile registration accepted a negative private slot")
	else
		match complete_update_registration(owner, 111, calls.tx)
			Ok(update_resource) => if not is_invalid_input(complete_update_registration(owner, 111, calls.tx)) or not is_invalid_input(complete_registration(owner, 111, calls.tx)) or not is_invalid_input(complete_write_registration(owner, 111, calls.tx)) or not is_invalid_input(complete_append_registration(owner, 111, calls.tx)) or not no_handler_calls(calls.rx) or not projected_update_slots_match(owner, update_resource, 111)
				Err("same-family or incoming existing-family duplicate changed UpdateFile")
			else
				match complete_registration(owner, 112, calls.tx)
					Ok(read_resource) => if not is_invalid_input(complete_update_registration(owner, 112, calls.tx)) or not projected_slots_match(owner, read_resource, 112)
						Err("incoming UpdateFile duplicate changed ReadFile")
					else
						match complete_write_registration(owner, 113, calls.tx)
							Ok(write_resource) => if not is_invalid_input(complete_update_registration(owner, 113, calls.tx)) or not projected_write_slots_match(owner, write_resource, 113)
								Err("incoming UpdateFile duplicate changed WriteFile")
							else
								match complete_append_registration(owner, 114, calls.tx)
									Ok(append_resource) => if not is_invalid_input(complete_update_registration(owner, 114, calls.tx)) or not projected_append_slots_match(owner, append_resource, 114) or not no_handler_calls(calls.rx)
										Err("incoming UpdateFile duplicate changed AppendFile or invoked a handler")
									else
										Ok(())
									end
									Err(_) => Err("AppendFile setup failed for UpdateFile duplicate check")
								end
							end
							Err(_) => Err("WriteFile setup failed for UpdateFile duplicate check")
						end
					end
					Err(_) => Err("ReadFile setup failed for UpdateFile duplicate check")
				end
			end
			Err(_) => Err("initial UpdateFile registration failed")
		end
	end
end

fn existing_families_reject_update_projection() -> Result<(), String> effects [io_provider::Scope, concurrency]
	let owner = io_provider::owner()
	let calls = channel::bounded<String>(32)
	match complete_registration(owner, 121, calls.tx)
		Ok(read_resource) => match io_provider::update_file(read_resource)
			Err(io::Error::Error(_, io::ErrorKind::Unsupported, _, _, _, _, _)) => if not projected_slots_match(owner, read_resource, 121)
				Err("failed UpdateFile projection changed ReadFile")
			else
				match complete_write_registration(owner, 122, calls.tx)
					Ok(write_resource) => match io_provider::update_file(write_resource)
						Err(io::Error::Error(_, io::ErrorKind::Unsupported, _, _, _, _, _)) => if not projected_write_slots_match(owner, write_resource, 122)
							Err("failed UpdateFile projection changed WriteFile")
						else
							match complete_append_registration(owner, 123, calls.tx)
								Ok(append_resource) => match io_provider::update_file(append_resource)
									Err(io::Error::Error(_, io::ErrorKind::Unsupported, _, _, _, _, _)) => if projected_append_slots_match(owner, append_resource, 123) and no_handler_calls(calls.rx)
										Ok(())
									else
										Err("failed UpdateFile projection changed AppendFile or invoked a handler")
									end
									_ => Err("AppendFile resource accepted UpdateFile projection")
								end
								Err(_) => Err("AppendFile setup failed for projection check")
							end
						end
						_ => Err("WriteFile resource accepted UpdateFile projection")
					end
					Err(_) => Err("WriteFile setup failed for projection check")
				end
			end
			_ => Err("ReadFile resource accepted UpdateFile projection")
		end
		Err(_) => Err("ReadFile setup failed for projection check")
	end
end

fn duplex_registration_and_projection_observations() -> Result<(), String> effects [io_provider::Scope, concurrency]
	let owner = io_provider::owner()
	let slot = 131
	let calls = channel::bounded<String>(32)
	match complete_duplex_registration(owner, slot, calls.tx)
		Ok(resource) => if projected_duplex_slots_match(owner, resource, slot) and no_handler_calls(calls.rx)
			Ok(())
		else
			Err("Duplex registration or projection did not retain all identities")
		end
		Err(_) => Err("complete Duplex registration failed")
	end
end

fn duplex_missing_handlers_preserve_slots() -> Result<(), String> effects [io_provider::Scope, concurrency]
	let owner = io_provider::owner()
	let calls = channel::bounded<String>(32)
	if not is_unsupported(duplex_without_read(owner, 132, calls.tx)) or not no_handler_calls(calls.rx) or not registration_succeeded(complete_duplex_registration(owner, 132, calls.tx)) or not no_handler_calls(calls.rx)
		Err("missing io::Read did not reject Duplex before publication")
	else if not is_unsupported(duplex_without_write(owner, 133, calls.tx)) or not no_handler_calls(calls.rx) or not registration_succeeded(complete_duplex_registration(owner, 133, calls.tx)) or not no_handler_calls(calls.rx)
		Err("missing io::Write did not reject Duplex before publication")
	else if not is_unsupported(duplex_without_close(owner, 134, calls.tx)) or not no_handler_calls(calls.rx) or not registration_succeeded(complete_duplex_registration(owner, 134, calls.tx)) or not no_handler_calls(calls.rx)
		Err("missing io::Close did not reject Duplex before publication")
	else
		Ok(())
	end
end

fn all_family_projection_combinations_preserve_resources() -> Result<(), String> effects [io_provider::Scope, concurrency]
	let owner = io_provider::owner()
	let calls = channel::bounded<String>(32)
	match complete_family_registration(owner, 141, io_provider::ViewFamily::ReadFile, calls.tx)
		Ok(read_resource) => if not family_projection_boundary(owner, read_resource, io_provider::ViewFamily::ReadFile, 141, calls.rx)
			Err("ReadFile projection compatibility boundary failed")
		else
			match complete_family_registration(owner, 142, io_provider::ViewFamily::WriteFile, calls.tx)
				Ok(write_resource) => if not family_projection_boundary(owner, write_resource, io_provider::ViewFamily::WriteFile, 142, calls.rx)
					Err("WriteFile projection compatibility boundary failed")
				else
					match complete_family_registration(owner, 143, io_provider::ViewFamily::UpdateFile, calls.tx)
						Ok(update_resource) => if not family_projection_boundary(owner, update_resource, io_provider::ViewFamily::UpdateFile, 143, calls.rx)
							Err("UpdateFile projection compatibility boundary failed")
						else
							match complete_family_registration(owner, 144, io_provider::ViewFamily::AppendFile, calls.tx)
								Ok(append_resource) => if not family_projection_boundary(owner, append_resource, io_provider::ViewFamily::AppendFile, 144, calls.rx)
									Err("AppendFile projection compatibility boundary failed")
								else
									match complete_family_registration(owner, 145, io_provider::ViewFamily::Duplex, calls.tx)
										Ok(duplex_resource) => if family_projection_boundary(owner, duplex_resource, io_provider::ViewFamily::Duplex, 145, calls.rx)
											Ok(())
										else
											Err("Duplex projection compatibility boundary failed")
										end
										Err(_) => Err("Duplex setup failed for projection compatibility boundary")
									end
								end
								Err(_) => Err("AppendFile setup failed for projection compatibility boundary")
							end
						end
						Err(_) => Err("UpdateFile setup failed for projection compatibility boundary")
					end
				end
				Err(_) => Err("WriteFile setup failed for projection compatibility boundary")
			end
		end
		Err(_) => Err("ReadFile setup failed for projection compatibility boundary")
	end
end

fn duplicate_row_preserves_first(owner: io_provider::Owner, slot: Int, family: io_provider::ViewFamily, calls: {tx: Sender<String>, rx: Receiver<String>}) -> Bool effects [concurrency]
	match complete_family_registration(owner, slot, family, calls.tx)
		Ok(original) => is_invalid_input(complete_family_registration(owner, slot, io_provider::ViewFamily::ReadFile, calls.tx)) and is_invalid_input(complete_family_registration(owner, slot, io_provider::ViewFamily::WriteFile, calls.tx)) and is_invalid_input(complete_family_registration(owner, slot, io_provider::ViewFamily::UpdateFile, calls.tx)) and is_invalid_input(complete_family_registration(owner, slot, io_provider::ViewFamily::AppendFile, calls.tx)) and is_invalid_input(complete_family_registration(owner, slot, io_provider::ViewFamily::Duplex, calls.tx)) and family_projection_boundary(owner, original, family, slot, calls.rx)
		Err(_) => false
	end
end

fn all_family_duplicate_orders_preserve_first() -> Result<(), String> effects [io_provider::Scope, concurrency]
	let owner = io_provider::owner()
	let calls = channel::bounded<String>(64)
	if not is_invalid_input(duplex_without_read(owner, -1, calls.tx)) or not no_handler_calls(calls.rx)
		Err("negative Duplex slot resolved handlers before validation")
	else if not duplicate_row_preserves_first(owner, 151, io_provider::ViewFamily::ReadFile, calls)
		Err("duplicate registrations changed the first ReadFile resource")
	else if not duplicate_row_preserves_first(owner, 152, io_provider::ViewFamily::WriteFile, calls)
		Err("duplicate registrations changed the first WriteFile resource")
	else if not duplicate_row_preserves_first(owner, 153, io_provider::ViewFamily::UpdateFile, calls)
		Err("duplicate registrations changed the first UpdateFile resource")
	else if not duplicate_row_preserves_first(owner, 154, io_provider::ViewFamily::AppendFile, calls)
		Err("duplicate registrations changed the first AppendFile resource")
	else if not duplicate_row_preserves_first(owner, 155, io_provider::ViewFamily::Duplex, calls)
		Err("duplicate registrations changed the first Duplex resource")
	else
		Ok(())
	end
end

