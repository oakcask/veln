fn network_factory_shadow(cell: io_provider::State<net_support::State>) -> Result<(), io::Error> effects [net::IO, concurrency, net, time]
	let original: net::Stream = match net::connect(net::Address(net::Tcp4, "original.test", 443))
		Ok(value) => Ok(value)
		Err(_) => Err(net_support::error("original stream was not created"))
	end?
	let shadow = io_provider::state(net_support::initial(net_support::bytes("wrong")?, "normal", 0, false))
	let _ = (handle handle io_provider::with_network(original, network_short_write_body) with net_support::operations(shadow) with net_support::allocation(shadow))?
	let unused = net_support::observe(net_support::snapshot(shadow))
	let original_state = net_support::observe(net_support::snapshot(cell))
	let no_shadow_call = match unused.events
		Nil => true
		_ => false
	end
	if no_shadow_call and net_support::text(unused.input)? == "wrong" and byte_count_to_int(byte_chunk_count(unused.output)) == 0 and original_state.closes == 1 and original_state.releases == 1
		Ok(())
	else
		Err(net_support::error("factory captured a newer lexical IO provider instead of the stream's creator"))
	end
end

test network_adapter_factory_keeps_stream_creator_when_adapting_under_a_shadow() -> Result<(), String> effects [net, time, concurrency]
	let cell = io_provider::state(net_support::initial(byte_chunk_from_visible_ascii_string("abcdef")?, "short-write", 0, false))
	let result = handle handle network_factory_shadow(cell) with net_support::operations(cell) with net_support::allocation(cell)
	match result
		Ok(()) => Ok(())
		Err(error) => Err(error.message)
	end
end

test network_plain_close_error_retains_unknown_release_without_inventing_commit_facts() -> Result<(), String> effects [net, time, concurrency]
	let cell = io_provider::state(net_support::initial(byte_chunk_from_visible_ascii_string("abcdef")?, "plain-close-failure", 0, false))
	let _ = net_support::run(cell, network_close_unknown)?
	let observed = net_support::observe(net_support::snapshot(cell))
	if observed.closes == 2 and observed.releases == 1 and not observed.live and byte_chunk_to_visible_ascii_string(observed.input)? == "abcdef"
		Ok(())
	else
		Err("plain network close error fabricated a release fact or consumed input after unknown release")
	end
end
