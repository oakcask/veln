	match handle f3_closed_dispatch_task(events.tx, state, foreign_owner, maximum, ready.tx, start.rx) with io_provider::scope()
		Err(_) => Err("closed-owner dispatch setup failed")
		Ok(worker) => begin
			let started: Option<()> = channel::recv(ready.rx)
			let _ = channel::send(start.tx, ())
			match task::join(worker)
				Ok(io_provider_lifecycle_test_support_test::ClosedDispatchReport(facade_rejected, lexical_rejected, state_unchanged)) => if started != None and facade_rejected and lexical_rejected and state_unchanged and f3_release_event_matches(events.rx) and io_provider_lifecycle_test_support_test::observe_state(state) == 17
					Ok(())
