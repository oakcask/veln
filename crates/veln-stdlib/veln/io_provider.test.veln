test atomic_state_allocations_are_independent_and_publish_result_with_replacement() -> Result<(), String> effects [concurrency]
	let first: io_provider::State<String> = io_provider::state("first")
	let second: io_provider::State<String> = io_provider::state("first")
	let prior: String = io_provider::update(first, "replacement", io_provider_state_test_support_test::replace_string)
	let first_after: String = io_provider::update(first, (), io_provider_state_test_support_test::observe_string)
	let second_after: String = io_provider::update(second, (), io_provider_state_test_support_test::observe_string)
	if prior == "first" and first_after == "replacement" and second_after == "first"
		Ok(())
	else
		Err("atomic state did not keep allocations independent or publish replacement and result together")
	end
end

fn atomic_state_add_one(cell: io_provider::State<Int>) -> Int effects [concurrency]
	io_provider::update(cell, 1, io_provider_state_test_support_test::add)
end

fn atomic_state_fail(cell: io_provider::State<Int>) -> Int effects [concurrency]
	io_provider::update(cell, (), io_provider_state_test_support_test::fail_int)
end

test atomic_state_identity_is_shared_with_children_and_completed_updates_are_serialized() -> Result<(), String> effects [concurrency]
	let cell: io_provider::State<Int> = io_provider::state(0)
	let first = task::spawn_with(atomic_state_add_one, cell)
	let second = task::spawn_with(atomic_state_add_one, cell)
	let first_joined = task::join(first)
	let second_joined = task::join(second)
	let after: Int = io_provider::update(cell, (), io_provider_state_test_support_test::observe_int)
	match first_joined
		Ok(first_before) => match second_joined
			Ok(second_before) => if after == 2 and ((first_before == 0 and second_before == 1) or (first_before == 1 and second_before == 0))
				Ok(())
			else
				Err("completed child updates did not observe one serialized transition sequence")
			end
			Err(_) => Err("second atomic-state child did not complete")
		end
		Err(_) => Err("first atomic-state child did not complete")
	end
end


test atomic_state_callback_failure_preserves_state_and_releases_admission() -> Result<(), String> effects [concurrency]
	let cell: io_provider::State<Int> = io_provider::state(7)
	let failed = task::spawn_with(atomic_state_fail, cell)
	let failure_observed = match task::join(failed)
		Err(_) => true
		Ok(_) => false
	end
	let before_survivor: Int = io_provider::update(cell, (), io_provider_state_test_support_test::observe_int)
	let survivor_result: Int = io_provider::update(cell, 1, io_provider_state_test_support_test::add)
	let after_survivor: Int = io_provider::update(cell, (), io_provider_state_test_support_test::observe_int)
	if failure_observed and before_survivor == 7 and survivor_result == 7 and after_survivor == 8
		Ok(())
	else
		Err("failed atomic-state callback changed state or retained admission")
	end
end

fn namespace_facade_dispatch_observations(filesystem: fs::MutableFilesystem, captured: Receiver<String>, fallback: Receiver<String>) -> Result<(), String> effects [fs::Read, fs::Mutate, concurrency]
	let readonly = fs::read_only(filesystem)
	let root = path::root()
	let _ = fs::open_read(readonly, root)
	let _ = fs::metadata(readonly, root, fs::FollowLinks::Follow)
	let _ = fs::entries(readonly, root)
	let _ = fs::open_write(filesystem, root, fs::WriteMode::WriteMode(fs::CreateMode::Existing, false))
	let _ = fs::open_read_write(filesystem, root, fs::UpdateMode::UpdateMode(fs::CreateMode::Existing, false))
	let _ = fs::open_append(filesystem, root, fs::CreateMode::Existing)
	let _ = fs::create_directory(filesystem, root)
	let _ = fs::remove_file(filesystem, root)
	let _ = fs::remove_directory(filesystem, root)
	let _ = fs::rename(filesystem, root, root)
	if next_handler_call_is(captured, "open_read") and next_handler_call_is(captured, "metadata") and next_handler_call_is(captured, "entries") and next_handler_call_is(captured, "open_write") and next_handler_call_is(captured, "open_read_write") and next_handler_call_is(captured, "open_append") and next_handler_call_is(captured, "create_directory") and next_handler_call_is(captured, "remove_file") and next_handler_call_is(captured, "remove_directory") and next_handler_call_is(captured, "rename") and no_handler_calls(captured) and no_handler_calls(fallback)
		Ok(())
	else
		Err("filesystem namespace facades did not dispatch every operation to their captured handlers")
	end
end

fn namespace_facade_dispatch_setup() -> Result<(), String> effects [io_provider::Scope, concurrency]
	let owner = io_provider::owner()
	let captured = channel::bounded<String>(16)
	let fallback = channel::bounded<String>(16)
	match mutable_filesystem(owner, 181, captured.tx)
		Ok(filesystem) => handle handle namespace_facade_dispatch_observations(filesystem, captured.rx, fallback.rx) with io_provider_test_support_test::filesystem_read(fallback.tx) with io_provider_test_support_test::mutate(fallback.tx)
		Err(_) => Err("filesystem namespace dispatch setup failed")
	end
end

