fn no_handler_calls(calls: Receiver<String>) -> Bool effects [concurrency]
	match channel::select_many_timeout(list_cons(calls, list_nil()), 0)
		None => true
		Some(_) => false
	end
end

fn next_handler_call_is(calls: Receiver<String>, expected: String) -> Bool effects [concurrency]
	match channel::select_many_timeout(list_cons(calls, list_nil()), 0)
		Some(selected) => selected.index == 0 and selected.value == expected
		None => false
	end
end

fn registration_succeeded(result: Result<io_provider::Resource, io::Error>) -> Bool
	match result
		Ok(_) => true
		Err(_) => false
	end
end

fn slot_matches(result: Result<Int, io::Error>, expected: Int) -> Bool
	match result
		Ok(actual) => actual == expected
		Err(_) => false
	end
end

fn projected_slots_match(owner: io_provider::Owner, resource: io_provider::Resource, slot: Int) -> Bool effects [concurrency]
	match io_provider::read_file(resource)
		Ok(fs::ReadFile::ReadFile(reader, seeker, reader_at, closer)) => slot_matches(io_provider::slot(owner, resource), slot) and slot_matches(io_provider::reader_slot(owner, reader), slot) and slot_matches(io_provider::seeker_slot(owner, seeker), slot) and slot_matches(io_provider::reader_at_slot(owner, reader_at), slot) and slot_matches(io_provider::closer_slot(owner, closer), slot)
		_ => false
	end
end

fn projected_append_slots_match(owner: io_provider::Owner, resource: io_provider::Resource, slot: Int) -> Bool effects [concurrency]
	match io_provider::append_file(resource)
		Ok(fs::AppendFile::AppendFile(writer, closer, syncer)) => slot_matches(io_provider::slot(owner, resource), slot) and slot_matches(io_provider::writer_slot(owner, writer), slot) and slot_matches(io_provider::closer_slot(owner, closer), slot) and slot_matches(io_provider::syncer_slot(owner, syncer), slot)
		_ => false
	end
end

fn projected_write_slots_match(owner: io_provider::Owner, resource: io_provider::Resource, slot: Int) -> Bool effects [concurrency]
	match io_provider::write_file(resource)
		Ok(fs::WriteFile::WriteFile(writer, seeker, writer_at, closer, syncer, truncater)) => slot_matches(io_provider::slot(owner, resource), slot) and slot_matches(io_provider::writer_slot(owner, writer), slot) and slot_matches(io_provider::seeker_slot(owner, seeker), slot) and slot_matches(io_provider::writer_at_slot(owner, writer_at), slot) and slot_matches(io_provider::closer_slot(owner, closer), slot) and slot_matches(io_provider::syncer_slot(owner, syncer), slot) and slot_matches(io_provider::truncater_slot(owner, truncater), slot)
		_ => false
	end
end

fn projected_update_slots_match(owner: io_provider::Owner, resource: io_provider::Resource, slot: Int) -> Bool effects [concurrency]
	match io_provider::update_file(resource)
		Ok(fs::UpdateFile::UpdateFile(reader, writer, seeker, reader_at, writer_at, closer, syncer, truncater)) => slot_matches(io_provider::slot(owner, resource), slot) and slot_matches(io_provider::reader_slot(owner, reader), slot) and slot_matches(io_provider::writer_slot(owner, writer), slot) and slot_matches(io_provider::seeker_slot(owner, seeker), slot) and slot_matches(io_provider::reader_at_slot(owner, reader_at), slot) and slot_matches(io_provider::writer_at_slot(owner, writer_at), slot) and slot_matches(io_provider::closer_slot(owner, closer), slot) and slot_matches(io_provider::syncer_slot(owner, syncer), slot) and slot_matches(io_provider::truncater_slot(owner, truncater), slot)
		_ => false
	end
end

fn projected_duplex_slots_match(owner: io_provider::Owner, resource: io_provider::Resource, slot: Int) -> Bool effects [concurrency]
	match io_provider::duplex(resource)
		Ok(view) => slot_matches(io_provider::slot(owner, resource), slot) and slot_matches(io_provider::reader_slot(owner, view.reader), slot) and slot_matches(io_provider::writer_slot(owner, view.writer), slot) and slot_matches(io_provider::closer_slot(owner, view.closer), slot)
