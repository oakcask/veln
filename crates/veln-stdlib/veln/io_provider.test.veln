fn family_projection_boundary(owner: io_provider::Owner, resource: io_provider::Resource, family: io_provider::ViewFamily, slot: Int, calls: Receiver<String>) -> Bool effects [concurrency]
	match family
		io_provider::ViewFamily::ReadFile => projected_slots_match(owner, resource, slot) and write_file_unsupported(resource) and projected_slots_match(owner, resource, slot) and update_file_unsupported(resource) and projected_slots_match(owner, resource, slot) and append_file_unsupported(resource) and projected_slots_match(owner, resource, slot) and duplex_unsupported(resource) and projected_slots_match(owner, resource, slot) and no_handler_calls(calls)
		io_provider::ViewFamily::WriteFile => projected_write_slots_match(owner, resource, slot) and read_file_unsupported(resource) and projected_write_slots_match(owner, resource, slot) and update_file_unsupported(resource) and projected_write_slots_match(owner, resource, slot) and append_file_unsupported(resource) and projected_write_slots_match(owner, resource, slot) and duplex_unsupported(resource) and projected_write_slots_match(owner, resource, slot) and no_handler_calls(calls)
		io_provider::ViewFamily::UpdateFile => projected_update_slots_match(owner, resource, slot) and read_file_unsupported(resource) and projected_update_slots_match(owner, resource, slot) and write_file_unsupported(resource) and projected_update_slots_match(owner, resource, slot) and append_file_unsupported(resource) and projected_update_slots_match(owner, resource, slot) and duplex_unsupported(resource) and projected_update_slots_match(owner, resource, slot) and no_handler_calls(calls)
		io_provider::ViewFamily::AppendFile => projected_append_slots_match(owner, resource, slot) and read_file_unsupported(resource) and projected_append_slots_match(owner, resource, slot) and write_file_unsupported(resource) and projected_append_slots_match(owner, resource, slot) and update_file_unsupported(resource) and projected_append_slots_match(owner, resource, slot) and duplex_unsupported(resource) and projected_append_slots_match(owner, resource, slot) and no_handler_calls(calls)
		io_provider::ViewFamily::Duplex => projected_duplex_slots_match(owner, resource, slot) and read_file_unsupported(resource) and projected_duplex_slots_match(owner, resource, slot) and write_file_unsupported(resource) and projected_duplex_slots_match(owner, resource, slot) and update_file_unsupported(resource) and projected_duplex_slots_match(owner, resource, slot) and append_file_unsupported(resource) and projected_duplex_slots_match(owner, resource, slot) and no_handler_calls(calls)
	end
end

fn registration_and_projection_observations() -> Result<(), String> effects [io_provider::Scope, concurrency]
	let owner = io_provider::owner()
	let slot = 41
	let calls = channel::bounded<String>(32)
	match complete_registration(owner, slot, calls.tx)
		Ok(resource) => if not no_handler_calls(calls.rx)
			Err("ReadFile registration invoked a captured handler")
		else if not projected_slots_match(owner, resource, slot)
			Err("ReadFile projection did not retain the resource owner and slot")
		else
			match io_provider::duplex(resource)
				Err(io::Error::Error(_, io::ErrorKind::Unsupported, _, _, _, _, _)) => if projected_slots_match(owner, resource, slot)
					Ok(())
				else
					Err("failed Duplex projection changed the ReadFile resource")
				end
				_ => Err("ReadFile resource accepted an incompatible Duplex projection")
			end
		end
		Err(_) => Err("complete ReadFile registration failed")
	end
end

fn missing_handlers_preserve_slots() -> Result<(), String> effects [io_provider::Scope, concurrency]
	let owner = io_provider::owner()
	let calls = channel::bounded<String>(32)
	if not is_unsupported(without_read(owner, 51, calls.tx)) or not no_handler_calls(calls.rx) or not registration_succeeded(complete_registration(owner, 51, calls.tx)) or not no_handler_calls(calls.rx)
		Err("missing io::Read did not reject before publication")
	else if not is_unsupported(without_seek(owner, 52, calls.tx)) or not no_handler_calls(calls.rx) or not registration_succeeded(complete_registration(owner, 52, calls.tx)) or not no_handler_calls(calls.rx)
		Err("missing io::Seek did not reject before publication")
	else if not is_unsupported(without_read_at(owner, 53, calls.tx)) or not no_handler_calls(calls.rx) or not registration_succeeded(complete_registration(owner, 53, calls.tx)) or not no_handler_calls(calls.rx)
		Err("missing io::ReadAt did not reject before publication")
	else if not is_unsupported(without_close(owner, 54, calls.tx)) or not no_handler_calls(calls.rx) or not registration_succeeded(complete_registration(owner, 54, calls.tx)) or not no_handler_calls(calls.rx)
		Err("missing io::Close did not reject before publication")
	else
		Ok(())
	end
end

fn negative_slot_is_rejected() -> Result<(), String> effects [io_provider::Scope, concurrency]
	let owner = io_provider::owner()
	let calls = channel::bounded<String>(32)
	match complete_registration(owner, -1, calls.tx)
		Err(io::Error::Error(_, io::ErrorKind::InvalidInput, _, _, _, _, _)) => Ok(())
		_ => Err("ReadFile registration accepted a negative private slot")
	end
end

fn duplicate_slot_preserves_original_resource() -> Result<(), String> effects [io_provider::Scope, concurrency]
	let owner = io_provider::owner()
	let slot = 61
	let calls = channel::bounded<String>(32)
	match complete_registration(owner, slot, calls.tx)
		Ok(original) => if not no_handler_calls(calls.rx)
			Err("initial ReadFile registration invoked a captured handler")
		else if not is_invalid_input(without_read(owner, slot, calls.tx)) or not no_handler_calls(calls.rx) or not projected_slots_match(owner, original, slot)
			Err("duplicate registration without io::Read did not preserve the original resource")
		else if not is_invalid_input(without_seek(owner, slot, calls.tx)) or not no_handler_calls(calls.rx) or not projected_slots_match(owner, original, slot)
			Err("duplicate registration without io::Seek did not preserve the original resource")
		else if not is_invalid_input(without_read_at(owner, slot, calls.tx)) or not no_handler_calls(calls.rx) or not projected_slots_match(owner, original, slot)
			Err("duplicate registration without io::ReadAt did not preserve the original resource")
		else if not is_invalid_input(without_close(owner, slot, calls.tx)) or not no_handler_calls(calls.rx) or not projected_slots_match(owner, original, slot)
			Err("duplicate registration without io::Close did not preserve the original resource")
		else if not is_invalid_input(complete_registration(owner, slot, calls.tx)) or not no_handler_calls(calls.rx) or not projected_slots_match(owner, original, slot)
			Err("complete duplicate registration did not preserve the original resource")
		else if not is_invalid_input(complete_write_registration(owner, slot, calls.tx)) or not no_handler_calls(calls.rx) or not projected_slots_match(owner, original, slot)
			Err("cross-family duplicate registration changed the ReadFile resource")
		else
			Ok(())
		end
		Err(_) => Err("initial ReadFile registration failed")
	end
end

