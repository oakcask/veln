fn add(value: Int, increment: Int) -> {state: Int, result: Int}
	{state: value + increment, result: value}
end

fn dispatch_body(owner: io_provider::Owner, first_cell: io_provider::State<memory::MemoryState>, second_cell: io_provider::State<memory::MemoryState>) -> Result<(), String> effects [io::Read, io::Write, io::Close, concurrency]
	let first: {reader: io::Reader, writer: io::Writer, closer: io::Closer} = match memory::memory(owner, 1, first_cell)
		Ok(value) => Ok(value)
		Err(error) => Err(error.message)
	end?
	let second: {reader: io::Reader, writer: io::Writer, closer: io::Closer} = match memory::memory(owner, 2, second_cell)
		Ok(value) => Ok(value)
		Err(error) => Err(error.message)
	end?
	let maximum = byte_count(2)?
	let direct_rejected = match perform io::Read::read(first.reader, maximum)
		io::ReadOutcome::ReadFailed(_, _, error) => is_invalid_resource(error.kind)
		_ => false
	end
	let bytes = match io::read(first.reader, maximum)
		io::ReadOutcome::Data(bytes) => Ok(bytes)
		_ => Err("captured first provider did not read its own bytes")
	end?
	let copied = match io::write(second.writer, bytes)
		io::WriteOutcome::Written(count) => byte_count_to_int(count) == 2
		_ => false
	end
	let second_read: String = match io::read(second.reader, maximum)
		io::ReadOutcome::Data(second_bytes) => byte_chunk_to_visible_ascii_string(second_bytes)
		_ => Err("second provider did not read its own bytes")
	end?
	if direct_rejected and copied and byte_chunk_to_visible_ascii_string(bytes)? == "ab" and second_read == "z"
		Ok(())
	else
		Err("resource facade redirected to a lexical shadow or foreign provider")
	end
end

fn dispatch_scope(first: io_provider::State<memory::MemoryState>, second: io_provider::State<memory::MemoryState>) -> Result<(), String> effects [io_provider::Scope, concurrency]
	let owner = io_provider::owner()
	handle handle handle dispatch_body(owner, first, second) with memory::memory_read(owner, 2, second) with memory::memory_write(owner, 2, second) with memory::memory_close(owner, 2, second)
end

test captured_providers_and_lexical_perform_remain_distinct() -> Result<(), String> effects [concurrency]
	let first_initial = memory::initial(byte_chunk_from_visible_ascii_string("abc")?)
	let second_initial = memory::initial(byte_chunk_from_visible_ascii_string("z")?)
	let first = io_provider::state(first_initial)
	let second = io_provider::state(second_initial)
	let _ = (handle dispatch_scope(first, second) with io_provider::scope())?
	match memory::snapshot(first)
		memory::MemoryState(input, _, reads, _, closes) => if byte_chunk_to_visible_ascii_string(input)? == "c" and reads == 1 and closes == 1
			match memory::snapshot(second)
				memory::MemoryState(_, output, second_reads, writes, second_closes) => if byte_chunk_to_visible_ascii_string(output)? == "ab" and second_reads == 1 and writes == 1 and second_closes == 1
					Ok(())
				else
					Err("second provider lost its state or scope cleanup")
				end
			end
		else
			Err("first provider lost its state or scope cleanup")
		end
	end
end

fn snapshot(value: Int, ignored: ()) -> {state: Int, result: Int}
	{state: value, result: value}
end

fn child(cell: io_provider::State<Int>) -> Int effects [concurrency]
	io_provider::update(cell, 1, add)
end

test independent_cells_and_committed_results() -> Result<(), String> effects [concurrency]
	let first = io_provider::state(7)
	let second = io_provider::state(20)
	let old = io_provider::update(first, 3, add)
	let observed = io_provider::update(first, (), snapshot)
	let untouched = io_provider::update(second, (), snapshot)
	if old == 7 and observed == 10 and untouched == 20
		Ok(())
	else
		Err("state update lost commit, result, or instance isolation")
	end
end

test child_tasks_share_one_cell() -> Result<(), String> effects [concurrency]
	let cell = io_provider::state(0)
	let first = task::spawn_with(child, cell)
	let second = task::spawn_with(child, cell)
	let a = match task::join(first)
		Ok(value) => Ok(value)
		Err(_) => Err("first state task failed")
	end?
	let b = match task::join(second)
		Ok(value) => Ok(value)
		Err(_) => Err("second state task failed")
	end?
	let total = io_provider::update(cell, (), snapshot)
	if total == 2 and a + b == 1
		Ok(())
	else
		Err("child state identity or atomic update was lost")
	end
end

test explicit_state_and_update_type_arguments() -> Result<(), String> effects [concurrency]
	let cell = io_provider::state<Int>(4)
	let old = io_provider::update<Int, Int, Int>(cell, 2, add)
	if old == 4 and io_provider::update(cell, (), snapshot) == 6
		Ok(())
	else
		Err("explicit provider adapter type arguments changed the transition")
	end
end

fn missing_handlers_scope() -> Result<(), String> effects [io_provider::Scope, concurrency]
	let owner = io_provider::owner()
	match io_provider::resource(owner, 1, io_provider::ViewFamily::ReadFile)
		Err(error) => if is_unsupported(error.kind)
			Ok(())
		else
			Err("missing view handlers returned the wrong failure")
		end
		Ok(_) => Err("incomplete provider published a resource")
	end
end

test registration_requires_the_complete_view_family() -> Result<(), String> effects [concurrency]
	handle missing_handlers_scope() with io_provider::scope()
end

fn projection_scope(cell: io_provider::State<memory::MemoryState>) -> Result<(), String> effects [io_provider::Scope, concurrency]
	let owner = io_provider::owner()
	let resource = match memory::raw_memory(owner, 1, cell)
		Ok(resource) => Ok(resource)
		Err(error) => Err(error.message)
	end?
	let duplicate_rejected = match memory::raw_memory(owner, 1, cell)
		Err(error) => is_invalid_resource(error.kind)
		Ok(_) => false
	end
	let cannot_upgrade = match io_provider::read_file(resource)
		Err(error) => is_unsupported(error.kind)
		Ok(_) => false
	end
	if duplicate_rejected and cannot_upgrade
		Ok(())
	else
		Err("resource slots aliased or duplex gained seek capability")
	end
end

test resource_slots_and_projection_rights_are_checked() -> Result<(), String> effects [concurrency]
	let initial = memory::initial(byte_chunk([]))
	let cell = io_provider::state(initial)
	handle projection_scope(cell) with io_provider::scope()
end

fn is_invalid_resource(kind: io::ErrorKind) -> Bool
	match kind
		io::ErrorKind::InvalidResource => true
		_ => false
	end
end

fn is_unsupported(kind: io::ErrorKind) -> Bool
	match kind
		io::ErrorKind::Unsupported => true
		_ => false
	end
end

fn retain_scope(cell: io_provider::State<memory::MemoryState>) -> Result<{reader: io::Reader, writer: io::Writer, closer: io::Closer}, String> effects [io_provider::Scope, concurrency]
	let owner = io_provider::owner()
	match memory::memory(owner, 1, cell)
		Ok(value) => Ok(value)
		Err(error) => Err(error.message)
	end
end

fn expired_in_new_scope(reader: io::Reader, cell: io_provider::State<memory::MemoryState>) -> Result<(), String> effects [io_provider::Scope, concurrency]
	let owner = io_provider::owner()
	let maximum = byte_count(1)?
	let expired = handle io::read(reader, maximum) with memory::memory_read(owner, 3, cell)
	match expired
		io::ReadOutcome::ReadFailed(_, _, error) => match error.kind
			io::ErrorKind::Closed => Ok(())
			_ => Err("expired resource returned the wrong error")
		end
		_ => Err("expired resource was redirected to a new provider")
	end
end

test owner_exit_invalidates_retained_aliases_without_fallback() -> Result<(), String> effects [concurrency]
	let first_initial = memory::initial(byte_chunk_from_visible_ascii_string("a")?)
	let second_initial = memory::initial(byte_chunk_from_visible_ascii_string("b")?)
	let first = io_provider::state(first_initial)
	let second = io_provider::state(second_initial)
	let retained: {reader: io::Reader, writer: io::Writer, closer: io::Closer} = (handle retain_scope(first) with io_provider::scope())?
	let _ = (handle expired_in_new_scope(retained.reader, second) with io_provider::scope())?
	match memory::snapshot(first)
		memory::MemoryState(_, _, first_reads, _, closes) => match memory::snapshot(second)
			memory::MemoryState(_, _, second_reads, _, _) => if first_reads == 0 and second_reads == 0 and closes == 1
				Ok(())
			else
				Err("expired alias reached a provider or escaped scope cleanup")
			end
		end
	end
end

fn wrong_owner_inner(outer: io_provider::Owner, resource: io_provider::Resource, cell: io_provider::State<memory::MemoryState>) -> Result<(), String> effects [io_provider::Scope, concurrency]
	let inner = io_provider::owner()
	let wrong_slot = match io_provider::slot(inner, resource)
		Err(error) => is_invalid_resource(error.kind)
		Ok(_) => false
	end
	let wrong_publication = match memory::raw_memory(outer, 2, cell)
		Err(error) => is_invalid_resource(error.kind)
		Ok(_) => false
	end
	let own_slot = match io_provider::slot(outer, resource)
		Ok(slot) => slot == 1
		Err(_) => false
	end
	if wrong_slot and wrong_publication and own_slot
		Ok(())
	else
		Err("provider ownership admitted foreign slot access or publication")
	end
end

fn wrong_owner_outer(cell: io_provider::State<memory::MemoryState>) -> Result<(), String> effects [io_provider::Scope, concurrency]
	let outer = io_provider::owner()
	let resource = match memory::raw_memory(outer, 1, cell)
		Ok(value) => Ok(value)
		Err(error) => Err(error.message)
	end?
	handle wrong_owner_inner(outer, resource, cell) with io_provider::scope()
end

test wrong_owner_access_and_publication_are_rejected() -> Result<(), String> effects [concurrency]
	let initial = memory::initial(byte_chunk([]))
	let cell = io_provider::state(initial)
	handle wrong_owner_outer(cell) with io_provider::scope()
end

fn close_alias_body(owner: io_provider::Owner, cell: io_provider::State<memory::MemoryState>) -> Result<(), String> effects [io::Read, io::Close, concurrency]
	let file: {reader: io::Reader, writer: io::Writer, closer: io::Closer} = match memory::memory(owner, 1, cell)
		Ok(value) => Ok(value)
		Err(error) => Err(error.message)
	end?
	let first_closed = match io::close(file.closer)
		io::CloseOutcome::Closed => true
		_ => false
	end
	let repeated_closed = match io::close(file.closer)
		io::CloseOutcome::Closed => true
		_ => false
	end
	let empty = byte_count(0)?
	let reader_closed = match io::read(file.reader, empty)
		io::ReadOutcome::ReadFailed(_, _, error) => match error.kind
			io::ErrorKind::Closed => true
			_ => false
		end
		_ => false
	end
	if first_closed and repeated_closed and reader_closed
		Ok(())
	else
		Err("close did not invalidate aliases before zero-size transfer")
	end
end

fn close_alias_scope(cell: io_provider::State<memory::MemoryState>) -> Result<(), String> effects [io_provider::Scope, concurrency]
	let owner = io_provider::owner()
	handle handle close_alias_body(owner, cell) with memory::memory_read(owner, 1, cell) with memory::memory_close(owner, 1, cell)
end

test close_invalidates_every_view_and_is_idempotent() -> Result<(), String> effects [concurrency]
	let initial = memory::initial(byte_chunk([]))
	let cell = io_provider::state(initial)
	let _ = (handle close_alias_scope(cell) with io_provider::scope())?
	match memory::snapshot(cell)
		memory::MemoryState(_, _, reads, _, closes) => if reads == 0 and closes == 1
			Ok(())
		else
			Err("closed aliases transferred bytes or repeated provider close")
		end
	end
end

fn release_name(commit: io::Commit) -> String
	match commit
		io::Commit::No => "no"
		io::Commit::Yes => "yes"
		io::Commit::Unknown => "unknown"
	end
end

fn released(outcome: io::CloseOutcome) -> Bool
	match outcome
		io::CloseOutcome::Closed => true
		_ => false
	end
end

fn closed_read(outcome: io::ReadOutcome) -> Bool
	match outcome
		io::ReadOutcome::ReadFailed(_, io::Progress::Known(count), failure) => match failure.kind
			io::ErrorKind::Closed => byte_count_to_int(count) == 0
			_ => false
		end
		_ => false
	end
end

fn release_body(owner: io_provider::Owner, cell: io_provider::State<lifecycle::State>, expected: String, readable: Bool) -> Result<(), String> effects [io::Read, io::Close, concurrency]
	let resource: {reader: io::Reader, writer: io::Writer, closer: io::Closer} = match lifecycle::resource(owner, 1, cell)
		Ok(value) => Ok(value)
		Err(failure) => Err(failure.message)
	end?
	let alias = resource.reader
	let first = match io::close(resource.closer)
		io::CloseOutcome::CloseFailed(commit, failure) => release_name(commit) == expected and failure.message == "scripted release failure"
		_ => false
	end
	let usable = match io::read(alias, byte_count(1)?)
		io::ReadOutcome::Data(bytes) => readable and byte_chunk_to_visible_ascii_string(bytes)? == "x"
		outcome => not readable and closed_read(outcome)
	end
	let retried = released(io::close(resource.closer))
	let repeated = released(io::close(resource.closer))
	let invalidated = closed_read(io::read(alias, byte_count(0)?))
	if first and usable and retried and repeated and invalidated
		Ok(())
	else
		Err("close failure lost release facts, usability, retry, or alias invalidation")
	end
end

fn release_scope(cell: io_provider::State<lifecycle::State>, expected: String, readable: Bool) -> Result<(), String> effects [io_provider::Scope, concurrency]
	let owner = io_provider::owner()
	handle handle release_body(owner, cell, expected, readable) with lifecycle::reader(owner, cell) with lifecycle::closer(owner, cell)
end

fn check_release(commit: io::Commit, actual_release: Bool, readable: Bool, expected_calls: Int) -> Result<(), String> effects [concurrency]
	let failed = lifecycle::CloseStep(1, io::CloseOutcome::CloseFailed(commit, lifecycle::failure("close")), actual_release)
	let steps = if expected_calls == 1
		Cons(failed, Nil)
	else
		Cons(failed, Cons(lifecycle::CloseStep(1, io::CloseOutcome::Closed, true), Nil))
	end
	let cell = io_provider::state(lifecycle::initial(steps))
	let _ = (handle release_scope(cell, release_name(commit), readable) with io_provider::scope())?
	match lifecycle::snapshot(cell)
		lifecycle::State(remaining, live, closes, reads) => begin
			let no_remaining = list_is_empty(remaining)
			let closed = match dict_get(live, 1)
				Some(false) => true
				_ => false
			end
			let calls: Int = list_fold(closes, 0, count_close)
			if no_remaining and closed and calls == expected_calls and reads == if readable
				1
			else
				0
			end
				Ok(())
			else
				Err("release trace shows an extra close, provider read, or retained live resource")
			end
		end
	end
end

fn count_close(count: Int, event: lifecycle::CloseEvent) -> Int
	count + 1
end

test close_failure_no_preserves_usability_and_allows_retry() -> Result<(), String> effects [concurrency]
	check_release(io::Commit::No, false, true, 2)
end

test close_failure_yes_invalidates_aliases_without_releasing_twice() -> Result<(), String> effects [concurrency]
	check_release(io::Commit::Yes, true, false, 1)
end

test close_failure_unknown_blocks_transfer_and_allows_retry_when_still_open() -> Result<(), String> effects [concurrency]
	check_release(io::Commit::Unknown, false, false, 2)
end

test close_failure_unknown_allows_retry_when_release_actually_completed() -> Result<(), String> effects [concurrency]
	check_release(io::Commit::Unknown, true, false, 2)
end

fn allocate_three(cell: io_provider::State<lifecycle::State>) -> Result<(), String> effects [io_provider::Scope, concurrency]
	let owner = io_provider::owner()
	let first = lifecycle::resource(owner, 1, cell)
	let second = lifecycle::resource(owner, 2, cell)
	let third = lifecycle::resource(owner, 3, cell)
	match first
		Err(failure) => Err(failure.message)
		Ok(_) => match second
			Err(failure) => Err(failure.message)
			Ok(_) => match third
				Err(failure) => Err(failure.message)
				Ok(_) => Ok(())
			end
		end
	end
end

fn cleanup_order(events: List<lifecycle::CloseEvent>) -> String
	match events
		Nil => ""
		Cons(lifecycle::CloseEvent(slot, _, _), rest) => string::concat(int_to_string(slot), cleanup_order(rest))
	end
end

test owner_cleanup_releases_resources_in_reverse_publication_order() -> Result<(), String> effects [concurrency]
	let steps = Cons(lifecycle::CloseStep(3, io::CloseOutcome::Closed, true), Cons(lifecycle::CloseStep(2, io::CloseOutcome::Closed, true), Cons(lifecycle::CloseStep(1, io::CloseOutcome::Closed, true), Nil)))
	let cell = io_provider::state(lifecycle::initial(steps))
	let _ = (handle allocate_three(cell) with io_provider::scope())?
	match lifecycle::snapshot(cell)
		lifecycle::State(remaining, live, events, reads) => if list_is_empty(remaining) and cleanup_order(list_reverse(events)) == "321" and reads == 0
			Ok(())
		else
			Err("scope cleanup changed release order or left planned resources unattempted")
		end
	end
end

fn gated_read(context: {reader: io::Reader, gate: Receiver<Int>}) -> io::ReadOutcome effects [io::Read, concurrency]
	let _ = channel::recv(context.gate)
	match byte_count(1)
		Ok(count) => io::read(context.reader, count)
		Err(_) => io::ReadOutcome::End
	end
end

fn spawn_retained_child(owner: io_provider::Owner, cell: io_provider::State<lifecycle::State>, gate: Receiver<Int>) -> Result<Task<io::ReadOutcome>, String> effects [io::Read, concurrency]
	let resource: {reader: io::Reader, writer: io::Writer, closer: io::Closer} = match lifecycle::resource(owner, 1, cell)
		Ok(value) => Ok(value)
		Err(failure) => Err(failure.message)
	end?
	Ok(task::spawn_with(gated_read, {reader: resource.reader, gate: gate}))
end

fn retained_child_scope(cell: io_provider::State<lifecycle::State>, gate: Receiver<Int>) -> Result<Task<io::ReadOutcome>, String> effects [io_provider::Scope, concurrency]
	let owner = io_provider::owner()
	handle spawn_retained_child(owner, cell, gate) with lifecycle::reader(owner, cell)
end

test child_retaining_an_alias_does_not_extend_its_owner_lifetime() -> Result<(), String> effects [concurrency]
	let steps = Cons(lifecycle::CloseStep(1, io::CloseOutcome::Closed, true), Nil)
	let cell = io_provider::state(lifecycle::initial(steps))
	let gate = channel::bounded<Int>(1)
	let worker: Task<io::ReadOutcome> = (handle retained_child_scope(cell, gate.rx) with io_provider::scope())?
	let _ = channel::send(gate.tx, 0)
	let closed = match task::join(worker)
		Ok(outcome) => closed_read(outcome)
		Err(_) => false
	end
	match lifecycle::snapshot(cell)
		lifecycle::State(remaining, _, events, reads) => if closed and list_is_empty(remaining) and cleanup_order(events) == "1" and reads == 0
			Ok(())
		else
			Err("retained child alias survived owner exit or reached a provider")
		end
	end
end

fn uncertain_retry_body(owner: io_provider::Owner, cell: io_provider::State<lifecycle::State>) -> Result<(), String> effects [io::Read, io::Close, concurrency]
	let resource: {reader: io::Reader, writer: io::Writer, closer: io::Closer} = match lifecycle::resource(owner, 1, cell)
		Ok(value) => Ok(value)
		Err(error) => Err(error.message)
	end?
	let uncertain = match io::close(resource.closer)
		io::CloseOutcome::CloseFailed(io::Commit::Unknown, _) => true
		_ => false
	end
	let retry_no = match io::close(resource.closer)
		io::CloseOutcome::CloseFailed(io::Commit::No, _) => true
		_ => false
	end
	let still_unavailable = closed_read(io::read(resource.reader, byte_count(1)?))
	let finally_closed = released(io::close(resource.closer))
	if uncertain and retry_no and still_unavailable and finally_closed
		Ok(())
	else
		Err("a non-releasing retry cleared an earlier unknown release state")
	end
end

fn uncertain_retry_scope(cell: io_provider::State<lifecycle::State>) -> Result<(), String> effects [io_provider::Scope, concurrency]
	let owner = io_provider::owner()
	handle handle uncertain_retry_body(owner, cell) with lifecycle::reader(owner, cell) with lifecycle::closer(owner, cell)
end

test close_retry_no_cannot_clear_an_earlier_unknown_release() -> Result<(), String> effects [concurrency]
	let steps = Cons(lifecycle::CloseStep(1, io::CloseOutcome::CloseFailed(io::Commit::Unknown, lifecycle::failure("close")), false), Cons(lifecycle::CloseStep(1, io::CloseOutcome::CloseFailed(io::Commit::No, lifecycle::failure("close")), false), Cons(lifecycle::CloseStep(1, io::CloseOutcome::Closed, true), Nil)))
	let cell = io_provider::state(lifecycle::initial(steps))
	let _ = (handle uncertain_retry_scope(cell) with io_provider::scope())?
	match lifecycle::snapshot(cell)
		lifecycle::State(remaining, _, events, reads) => if list_is_empty(remaining) and list_fold(events, 0, count_close) == 3 and reads == 0
			Ok(())
		else
			Err("uncertain retry transferred bytes or lost a release obligation")
		end
	end
end

type PublicationControl
	PublicationControl(cell: io_provider::State<lifecycle::State>, entered: Sender<String>, gate: Receiver<String>, views: Sender<fs::Filesystem>, results: Sender<Result<fs::ReadFile, io::Error>>, leave: Receiver<String>)
end

fn publication_child(context: {filesystem: fs::Filesystem, results: Sender<Result<fs::ReadFile, io::Error>>}) -> () effects [fs::Read, concurrency]
	let result = fs::open_read(context.filesystem, path::root())
	let _ = channel::send(context.results, result)
	()
end

fn publication_body(context: PublicationControl) -> Result<(), String> effects [io_provider::Scope, concurrency]
	match context
		PublicationControl(cell, entered, gate, views, results, leave) => begin
			let owner = io_provider::owner()
			let filesystem: fs::Filesystem = match publication::filesystem(owner, cell, entered, gate)
				Ok(value) => Ok(value)
				Err(error) => Err(error.message)
			end?
			let child = handle task::spawn_with(publication_child, {filesystem: filesystem, results: results}) with publication::namespace(owner, cell, entered, gate)
			let _ = channel::send(views, filesystem)
			let _ = channel::recv(leave)
			Ok(())
		end
	end
end

fn publication_owner(context: PublicationControl) -> Result<(), String> effects [concurrency]
	handle publication_body(context) with io_provider::scope()
end

test owner_exit_releases_an_open_completing_after_publication_closes() -> Result<(), String> effects [concurrency]
	let cell = io_provider::state(lifecycle::initial(Cons(lifecycle::CloseStep(1, io::CloseOutcome::Closed, true), Nil)))
	let entered = channel::bounded<String>(1)
	let gate = channel::bounded<String>(1)
	let views = channel::bounded<fs::Filesystem>(1)
	let results = channel::bounded<Result<fs::ReadFile, io::Error>>(1)
	let leave = channel::bounded<String>(1)
	let owner = task::spawn_with(publication_owner, PublicationControl(cell, entered.tx, gate.rx, views.tx, results.tx, leave.rx))
	let filesystem: fs::Filesystem = match channel::recv(views.rx)
		Some(value) => Ok(value)
		None => Err("missing filesystem view")
	end?
	let _ = channel::recv(entered.rx)
	let _ = channel::send(leave.tx, "leave")
	let _ = handle publication::wait_closed(filesystem) with publication::inactive()
	let _ = channel::send(gate.tx, "complete open")
	let owner_ok = match task::join(owner)
		Ok(Ok(())) => true
		_ => false
	end
	let result: Option<Result<fs::ReadFile, io::Error>> = channel::recv(results.rx)
	let rejected = match result
		Some(Err(error)) => match error.kind
			io::ErrorKind::Closed => true
			_ => false
		end
		_ => false
	end
	match lifecycle::snapshot(cell)
		lifecycle::State(remaining, live, events, reads) => if not owner_ok
			Err("owner did not confirm cleanup of the admitted open")
		else if not rejected
			Err("late open did not return Closed")
		else if not list_is_empty(remaining)
			Err("late close did not consume its release plan")
		else if not publication_released(live)
			Err("late resource remains live")
		else if list_fold(events, 0, count_close) != 1
			Err("late release callback count differs from one")
		else if reads != 0
			Err("late resource reached a reader")
		else
			Ok(())
		end
	end
end

fn publication_released(live: Dict<Int, Bool>) -> Bool
	match dict_get(live, 1)
		Some(false) => true
		_ => false
	end
end

fn overlap_reply(reply: overlap::ChildResult, expected: Int) -> Bool
	match reply
		overlap::Cancelled => expected == -1
		overlap::Completed(outcome) => match outcome
			io::CloseOutcome::Closed => expected == 0
			io::CloseOutcome::CloseFailed(commit, error) => error.operation == "explicit close" and match commit
				io::Commit::No => expected == 1
				io::Commit::Yes => expected == 2
				io::Commit::Unknown => expected == 3
			end
		end
	end
end

fn check_close_overlap(first: io::CloseOutcome, actually_released: Bool, expected: Int, calls: Int, mode: overlap::Mode) -> Result<(), String> effects [concurrency]
	let tail = if calls == 2
		Cons(lifecycle::CloseStep(1, io::CloseOutcome::Closed, true), Nil)
	else
		Nil
	end
	let cell = io_provider::state(lifecycle::initial(Cons(lifecycle::CloseStep(1, first, actually_released), tail)))
	let reply = overlap::run(cell, mode)?
	match lifecycle::snapshot(cell)
		lifecycle::State(remaining, live, closes, reads) => if not overlap_reply(reply, expected)
			Err("explicit close outcome changed during owner cleanup")
		else if not list_is_empty(remaining) or list_fold(closes, 0, count_close) != calls
			Err("owner cleanup duplicated or omitted a close attempt")
		else if not publication_released(live) or reads != 0
			Err("close overlap leaked a resource or admitted a read")
		else
			Ok(())
		end
	end
end

test owner_exit_observes_an_already_admitted_successful_close_once() -> Result<(), String> effects [concurrency]
	check_close_overlap(io::CloseOutcome::Closed, true, 0, 1, overlap::Normal)
end

test owner_exit_does_not_repeat_an_admitted_close_released_with_error() -> Result<(), String> effects [concurrency]
	check_close_overlap(io::CloseOutcome::CloseFailed(io::Commit::Yes, lifecycle::failure("explicit close")), true, 2, 1, overlap::Normal)
end

test owner_exit_retries_an_admitted_close_that_did_not_release() -> Result<(), String> effects [concurrency]
	check_close_overlap(io::CloseOutcome::CloseFailed(io::Commit::No, lifecycle::failure("explicit close")), false, 1, 2, overlap::Normal)
end

test owner_exit_retries_an_admitted_close_with_unknown_release() -> Result<(), String> effects [concurrency]
	check_close_overlap(io::CloseOutcome::CloseFailed(io::Commit::Unknown, lifecycle::failure("explicit close")), false, 3, 2, overlap::Normal)
end

test owner_exit_confirms_unknown_release_even_if_the_resource_was_released() -> Result<(), String> effects [concurrency]
	check_close_overlap(io::CloseOutcome::CloseFailed(io::Commit::Unknown, lifecycle::failure("explicit close")), true, 3, 2, overlap::Normal)
end

test cancellation_during_close_preserves_release_before_join_reports_cancelled() -> Result<(), String> effects [concurrency]
	check_close_overlap(io::CloseOutcome::Closed, true, -1, 1, overlap::CancelClose)
end

fn retained_close_in_new_scope(closer: io::Closer, cell: io_provider::State<memory::MemoryState>) -> Result<(), String> effects [io_provider::Scope, concurrency]
	let owner = io_provider::owner()
	let outcome = handle io::close(closer) with memory::memory_close(owner, 3, cell)
	match outcome
		io::CloseOutcome::Closed => Ok(())
		_ => Err("confirmed closure lost idempotence after owner exit")
	end
end

test owner_exit_keeps_confirmed_close_idempotent_without_redirecting() -> Result<(), String> effects [concurrency]
	let first = io_provider::state(memory::initial(byte_chunk([])))
	let second = io_provider::state(memory::initial(byte_chunk([])))
	let retained: {reader: io::Reader, writer: io::Writer, closer: io::Closer} = (handle retain_scope(first) with io_provider::scope())?
	let _ = (handle retained_close_in_new_scope(retained.closer, second) with io_provider::scope())?
	match memory::snapshot(first)
		memory::MemoryState(_, _, _, _, closes) => match memory::snapshot(second)
			memory::MemoryState(_, _, _, _, other_closes) => if closes == 1 and other_closes == 0
				Ok(())
			else
				Err("repeated close reached the original or a newer provider")
			end
		end
	end
end

fn network_short_write_body(views: {reader: io::Reader, writer: io::Writer, closer: io::Closer}) -> Result<(), io::Error> effects [io::Read, io::Write]
	let read = match io::read_exact(views.reader, net_support::count(5)?)
		io::ExactOutcome::Complete(bytes) => net_support::text(bytes)? == "abcde"
		_ => false
	end
	let written = match io::write_all(views.writer, net_support::bytes("12345")?)
		io::WriteOutcome::Written(amount) => byte_count_to_int(amount) == 5
		_ => false
	end
	if read and written
		Ok(())
	else
		Err(net_support::error("network byte helpers lost requested bytes or short-write progress"))
	end
end

test network_byte_adapter_preserves_bounded_reads_and_short_write_suffixes() -> Result<(), String> effects [net, time, concurrency]
	let initial = net_support::initial(byte_chunk_from_visible_ascii_string("abcdef")?, "short-write", 0, false)
	let cell = io_provider::state(initial)
	let _ = net_support::run(cell, network_short_write_body)?
	let observed = net_support::observe(net_support::snapshot(cell))
	let trace = match observed.events
		Cons(net_support::Event::Close, Cons(net_support::Event::Write(last), Cons(net_support::Event::Write(middle), Cons(net_support::Event::Write(first), Cons(net_support::Event::Read(5), Nil))))) => byte_chunk_to_visible_ascii_string(first)? == "12345" and byte_chunk_to_visible_ascii_string(middle)? == "345" and byte_chunk_to_visible_ascii_string(last)? == "5"
		_ => false
	end
	if trace and byte_chunk_to_visible_ascii_string(observed.input)? == "f" and byte_chunk_to_visible_ascii_string(observed.output)? == "12345" and observed.closes == 1 and observed.releases == 1 and not observed.live
		Ok(())
	else
		Err("network adapter disagreed with independently observed input/output and release state")
	end
end

fn original_network_error(failure: io::Error, operation: String) -> Bool
	failure.operation == operation and (match failure.network
		Some(net::NetError(original, Some(net::Tcp4), Some("192.0.2.1:443"), kind, "selected network provider failure")) => if operation == "read"
			original == "provider_read" and (match kind
				net::ConnectionReset => true
				_ => false
			end)
		else
			original == "provider_write" and (match kind
				net::TimedOut => true
				_ => false
			end)
		end
		_ => false
	end)
end

fn network_read_failure_body(views: {reader: io::Reader, writer: io::Writer, closer: io::Closer}) -> Result<(), io::Error> effects [io::Read, io::Write]
	match io::copy(views.reader, views.writer, net_support::count(3)?)
		io::CopyOutcome::CopyFailed(io::Progress::Unknown(consumed), io::Progress::Known(committed), failure) => if byte_count_to_int(consumed) == 0 and byte_count_to_int(committed) == 0 and original_network_error(failure, "read")
			Ok(())
		else
			Err(net_support::error("network read failure fabricated known progress or lost its original error"))
		end
		_ => Err(net_support::error("network read failure did not stop copy"))
	end
end

test network_read_failure_retains_unknown_consumption_and_original_context() -> Result<(), String> effects [net, time, concurrency]
	let cell = io_provider::state(net_support::initial(byte_chunk_from_visible_ascii_string("abcdef")?, "read-failure", 0, false))
	let _ = net_support::run(cell, network_read_failure_body)?
	let observed = net_support::observe(net_support::snapshot(cell))
	let calls = match observed.events
		Cons(net_support::Event::Close, Cons(net_support::Event::Read(3), Nil)) => true
		_ => false
	end
	if calls and byte_chunk_to_visible_ascii_string(observed.input)? == "cdef" and byte_count_to_int(byte_chunk_count(observed.output)) == 0 and observed.releases == 1
		Ok(())
	else
		Err("unknown network consumption was retried or failing input was written")
	end
end

fn network_write_failure_body(views: {reader: io::Reader, writer: io::Writer, closer: io::Closer}) -> Result<(), io::Error> effects [io::Write]
	match io::write_all(views.writer, net_support::bytes("abcde")?)
		io::WriteOutcome::WriteFailed(io::Progress::Known(committed), failure) => if byte_count_to_int(committed) == 2 and original_network_error(failure, "write")
			Ok(())
		else
			Err(net_support::error("network write lost exact committed prefix or original error"))
		end
		_ => Err(net_support::error("network write failure was converted to success"))
	end
end

test network_write_failure_retains_exact_committed_prefix_without_retry() -> Result<(), String> effects [net, time, concurrency]
	let cell = io_provider::state(net_support::initial(byte_chunk([]), "write-failure", 0, false))
	let _ = net_support::run(cell, network_write_failure_body)?
	let observed = net_support::observe(net_support::snapshot(cell))
	let calls = match observed.events
		Cons(net_support::Event::Close, Cons(net_support::Event::Write(bytes), Nil)) => byte_chunk_to_visible_ascii_string(bytes)? == "abcde"
		_ => false
	end
	if calls and byte_chunk_to_visible_ascii_string(observed.output)? == "ab" and observed.releases == 1
		Ok(())
	else
		Err("network write failure retried or disagreed with actual committed bytes")
	end
end

fn network_read_is(views: {reader: io::Reader, writer: io::Writer, closer: io::Closer}, expected: String) -> Result<Bool, io::Error> effects [io::Read]
	match io::read(views.reader, net_support::count(1)?)
		io::ReadOutcome::Data(bytes) => Ok(net_support::text(bytes)? == expected)
		_ => Ok(false)
	end
end

fn network_shadow_body(first: {reader: io::Reader, writer: io::Writer, closer: io::Closer}) -> Result<(), io::Error> effects [net::IO, io::Read, io::Write, io_provider::Scope, concurrency]
	let stream = match net::connect(net::Address(net::Tcp4, "shadow.test", 443))
		Ok(value) => Ok(value)
		Err(_) => Err(net_support::error("shadow network did not connect"))
	end?
	let second = io_provider::network(stream)?
	let first_read = network_read_is(first, "a")?
	let second_read = network_read_is(second, "w")?
	let first_write = match io::write(first.writer, net_support::bytes("A")?)
		io::WriteOutcome::Written(count) => byte_count_to_int(count) == 1
		_ => false
	end
	let second_write = match io::write(second.writer, net_support::bytes("B")?)
		io::WriteOutcome::Written(count) => byte_count_to_int(count) == 1
		_ => false
	end
	if first_read and second_read and first_write and second_write
		Ok(())
	else
		Err(net_support::error("network byte views followed a lexical shadow instead of their creating provider"))
	end
end

fn network_shadow(first: {reader: io::Reader, writer: io::Writer, closer: io::Closer}) -> Result<(), io::Error> effects [net::IO, io::Read, io::Write, io_provider::Scope, concurrency, net, time]
	let cell = io_provider::state(net_support::initial(net_support::bytes("wrong")?, "normal", 0, false))
	let _ = (handle handle network_shadow_body(first) with net_support::operations(cell) with net_support::allocation(cell))?
	let after_shadow = network_read_is(first, "b")?
	let observed = net_support::observe(net_support::snapshot(cell))
	if after_shadow and net_support::text(observed.input)? == "rong" and net_support::text(observed.output)? == "B" and observed.closes == 1 and observed.releases == 1
		Ok(())
	else
		Err(net_support::error("ending the shadow provider changed the older network view or selected the wrong bytes"))
	end
end

test network_byte_views_keep_their_creating_provider_under_shadowing_and_scope_exit() -> Result<(), String> effects [net, time, concurrency]
	let cell = io_provider::state(net_support::initial(byte_chunk_from_visible_ascii_string("abcdef")?, "normal", 0, false))
	let _ = net_support::run(cell, network_shadow)?
	let observed = net_support::observe(net_support::snapshot(cell))
	if byte_chunk_to_visible_ascii_string(observed.input)? == "cdef" and byte_chunk_to_visible_ascii_string(observed.output)? == "A" and observed.closes == 1 and observed.releases == 1
		Ok(())
	else
		Err("network shadow changed the original provider's independent bytes or release state")
	end
end

fn network_zero_read_rejected(reader: io::Reader, expected: String) -> Result<Bool, io::Error> effects [io::Read]
	match io::read(reader, net_support::count(0)?)
		io::ReadOutcome::ReadFailed(bytes, io::Progress::Known(count), failure) => Ok(byte_count_to_int(byte_chunk_count(bytes)) == 0 and byte_count_to_int(count) == 0 and failure.operation == "read" and (match failure.kind
			io::ErrorKind::Closed => expected == "Closed"
			io::ErrorKind::InvalidResource => expected == "InvalidResource"
			_ => false
		end))
		_ => Ok(false)
	end
end

fn network_close_fact(views: {reader: io::Reader, writer: io::Writer, closer: io::Closer}, expected: String) -> Result<(), io::Error> effects [io::Read, io::Close]
	let failed = match io::close(views.closer)
		io::CloseOutcome::CloseFailed(commit, failure) => failure.operation == "close" and (match commit
			io::Commit::No => expected == "No"
			io::Commit::Yes => expected == "Yes"
			io::Commit::Unknown => expected == "Unknown"
		end) and (match failure.network
			Some(net::NetError("close_stream", _, Some("192.0.2.1:443"), net::Other, _)) => true
			_ => false
		end)
		_ => false
	end
	let admission = if expected == "No"
		network_read_is(views, "a")?
	else
		network_zero_read_rejected(views.reader, "Closed")?
	end
	let confirmed = if expected == "No"
		true
	else
		match io::close(views.closer)
			io::CloseOutcome::Closed => true
			_ => false
		end
	end
	if failed and admission and confirmed
		Ok(())
	else
		Err(net_support::error("network close lost release facts, alias admission, or retry confirmation"))
	end
end

fn network_close_no(views: {reader: io::Reader, writer: io::Writer, closer: io::Closer}) -> Result<(), io::Error> effects [io::Read, io::Close]
	network_close_fact(views, "No")
end

fn network_close_yes(views: {reader: io::Reader, writer: io::Writer, closer: io::Closer}) -> Result<(), io::Error> effects [io::Read, io::Close]
	network_close_fact(views, "Yes")
end

fn network_close_unknown(views: {reader: io::Reader, writer: io::Writer, closer: io::Closer}) -> Result<(), io::Error> effects [io::Read, io::Close]
	network_close_fact(views, "Unknown")
end

fn network_close_case(commit: Int, actual: Bool) -> Result<(), String> effects [net, time, concurrency]
	let cell = io_provider::state(net_support::initial(byte_chunk_from_visible_ascii_string("abcdef")?, "close-failure", commit, actual))
	let _ = if commit == 0
		net_support::run(cell, network_close_no)
	else if commit == 1
		net_support::run(cell, network_close_yes)
	else
		net_support::run(cell, network_close_unknown)
	end?
	let observed = net_support::observe(net_support::snapshot(cell))
	if observed.closes == (if commit == 1
		1
	else
		2
	end) and observed.releases == 1 and not observed.live and byte_chunk_to_visible_ascii_string(observed.input)? == (if commit == 0
		"bcdef"
	else
		"abcdef"
	end)
		Ok(())
	else
		Err("network close commit disagreed with actual release state or duplicated a release")
	end
end

test network_close_no_preserves_actual_live_state_until_owner_retry() -> Result<(), String> effects [net, time, concurrency]
	network_close_case(0, false)
end

test network_close_yes_confirms_actual_release_without_a_second_callback() -> Result<(), String> effects [net, time, concurrency]
	network_close_case(1, true)
end

test network_close_unknown_retries_when_actual_resource_remains_live() -> Result<(), String> effects [net, time, concurrency]
	network_close_case(-1, false)
end

test network_close_unknown_retries_without_repeating_an_actual_release() -> Result<(), String> effects [net, time, concurrency]
	network_close_case(-1, true)
end

fn network_external_close() -> Result<{reader: io::Reader, writer: io::Writer, closer: io::Closer}, io::Error> effects [net::IO, io::Read, io::Write, io_provider::Scope, concurrency]
	let stream = match net::connect(net::Address(net::Tcp4, "external-close.test", 443))
		Ok(value) => Ok(value)
		Err(_) => Err(net_support::error("external-close stream did not connect"))
	end?
	let views = io_provider::network(stream)?
	let _ = net::close_stream(stream)
	let read = network_zero_read_rejected(views.reader, "Closed")?
	let write = match io::write(views.writer, byte_chunk([]))
		io::WriteOutcome::WriteFailed(io::Progress::Known(count), failure) => byte_count_to_int(count) == 0 and (match failure.kind
			io::ErrorKind::Closed => true
			_ => false
		end)
		_ => false
	end
	if read and write
		Ok(views)
	else
		Err(net_support::error("zero-size byte operation revived a stream closed through its original API"))
	end
end

fn network_external_close_body(ignored: {reader: io::Reader, writer: io::Writer, closer: io::Closer}) -> Result<(), io::Error> effects [net::IO, io::Read, io::Write, io_provider::Scope, concurrency, net, time]
	let cell = io_provider::state(net_support::initial(net_support::bytes("closed")?, "normal", 0, false))
	let views = (handle handle network_external_close() with net_support::operations(cell) with net_support::allocation(cell))?
	let expired = network_zero_read_rejected(views.reader, "InvalidResource")?
	let observed = net_support::observe(net_support::snapshot(cell))
	if expired and observed.closes == 1 and observed.releases == 1 and net_support::text(observed.input)? == "closed"
		Ok(())
	else
		Err(net_support::error("expired network provider was invoked or an externally closed view consumed bytes"))
	end
end

test network_byte_zero_size_operations_validate_external_close_and_provider_lifetime() -> Result<(), String> effects [net, time, concurrency]
	let cell = io_provider::state(net_support::initial(byte_chunk([]), "normal", 0, false))
	net_support::run(cell, network_external_close_body)
end

fn network_memory_copy(filesystem: fs::MutableFilesystem, views: {reader: io::Reader, writer: io::Writer, closer: io::Closer}) -> Result<(), io::Error> effects [fs::Read, fs::Mutate, io::Read, io::Write]
	let output = match path::parse("output")
		Ok(value) => Ok(value)
		Err(_) => Err(net_support::error("invalid output fixture path"))
	end?
	let input = match path::parse("input")
		Ok(value) => Ok(value)
		Err(_) => Err(net_support::error("invalid input fixture path"))
	end?
	let target: fs::WriteFile = fs::open_write(filesystem, output, {create: fs::CreateMode::Existing, truncate: false})?
	let source: fs::ReadFile = fs::open_read(fs::read_only(filesystem), input)?
	let received = match io::copy(views.reader, target.writer, net_support::count(2)?)
		io::CopyOutcome::Copied(count) => byte_count_to_int(count) == 3
		_ => false
	end
	let sent = match io::copy(source.reader, views.writer, net_support::count(2)?)
		io::CopyOutcome::Copied(count) => byte_count_to_int(count) == 3
		_ => false
	end
	if received and sent
		Ok(())
	else
		Err(net_support::error("cross-provider byte copy changed consumed or committed counts"))
	end
end

fn network_memory_body(views: {reader: io::Reader, writer: io::Writer, closer: io::Closer}) -> Result<(), io::Error> effects [io::Read, io::Write, io_provider::Scope, concurrency]
	let seeded = fs_model::seed_file(fs_model::initial(101), "input", net_support::bytes("MEM")?)
	let cell = fs_memory::cell(fs_model::seed_file(seeded, "output", byte_chunk([])))
	let owner = io_provider::owner()
	let filesystem: fs::MutableFilesystem = fs_memory::filesystem(owner, 100, cell)?
	let _ = (handle handle network_memory_copy(filesystem, views) with fs_memory::namespace(owner, 100, cell) with fs_memory::mutations(owner, 100, cell))?
	let after = fs_memory::snapshot(cell)
	let stored = match dict_get(fs_model::contents(after), 2)
		Some(bytes) => net_support::text(bytes)? == "NET"
		None => false
	end
	let input = match dict_get(fs_model::contents(after), 1)
		Some(bytes) => net_support::text(bytes)? == "MEM"
		None => false
	end
	let cursors = match fs_model::cursor(after, 101)
		Some(3) => match fs_model::cursor(after, 102)
			Some(3) => true
			_ => false
		end
		_ => false
	end
	if stored and input and cursors
		Ok(())
	else
		Err(net_support::error("network/memory copy selected the wrong bindings, bytes, or cursors"))
	end
end

test network_and_memory_filesystem_copy_keep_independent_bytes_and_progress() -> Result<(), String> effects [net, time, concurrency]
	let cell = io_provider::state(net_support::initial(byte_chunk_from_visible_ascii_string("NET")?, "normal", 0, false))
	let _ = net_support::run(cell, network_memory_body)?
