test owner_exit_restricts_cleanup_access_and_preserves_state() -> Result<(), String> effects [concurrency]
	let foreign_owner = f3_closed_foreign_owner()
	let events = channel::bounded<String>(3)
	let state = io_provider::state(17)
	let normal = handle f3_owner_exit(events.tx, state, foreign_owner, false, false) with io_provider::scope()
	let failed = handle f3_owner_exit(events.tx, state, foreign_owner, true, true) with io_provider::scope()
	match normal
		Err(_) => Err("normal owner exit changed the body result")
		Ok(()) => match failed
			Ok(()) => Err("owner cleanup replaced the propagated body failure")
			Err(message) => if message != "planned owner body failure"
				Err("owner cleanup changed the propagated body failure")
			else if not f3_release_event_matches(events.rx) or not f3_release_event_matches(events.rx)
				Err("normal or failed owner exit did not enforce restricted release access")
			else if io_provider_lifecycle_test_support_test::observe_state(state) != 17
				Err("owner cleanup changed unrelated provider state")
			else
				Ok(())
			end
		end
	end
end

type F3CancelRequest
	F3CancelRequest(foreign_owner: io_provider::Owner, state: io_provider::State<Int>, events: Sender<String>, ready: Sender<()>, blocked: Receiver<()>)
end

type F3ReleaseCancelRequest
	F3ReleaseCancelRequest(foreign_owner: io_provider::Owner, state: io_provider::State<Int>, events: Sender<String>, entered: Sender<()>, blocked: Receiver<()>)
end

fn f3_cancellable_body(request: F3CancelRequest) -> () effects [io_provider::Scope, concurrency]
	let owner = io_provider::owner()
	match request
		F3CancelRequest(foreign_owner, state, events, ready, blocked) => begin
			let plan = io_provider_lifecycle_test_support_test::ReleasePlan(owner, foreign_owner, 401, state, events, false)
			let _ = io_provider_lifecycle_test_support_test::register(owner, plan)
			let _ = channel::send(ready, ())
			let _: Option<()> = channel::recv(blocked)
			()
		end
	end
end

fn f3_cancellable(request: F3CancelRequest) -> () effects [concurrency]
	handle f3_cancellable_body(request) with io_provider::scope()
end

fn f3_release_cancellable_body(request: F3ReleaseCancelRequest) -> () effects [io_provider::Scope, concurrency]
	let owner = io_provider::owner()
	match request
		F3ReleaseCancelRequest(foreign_owner, state, events, entered, blocked) => begin
			let plan = io_provider_lifecycle_test_support_test::CancellationReleasePlan(owner, foreign_owner, state, events, entered, blocked)
			let _ = io_provider_lifecycle_test_support_test::register_cancellation_resources(owner, plan)
			()
		end
	end
end

fn f3_mark_continued(current: Int, context: ()) -> {state: Int, result: ()}
	{state: 18, result: ()}
end

fn f3_release_cancellable(request: F3ReleaseCancelRequest) -> () effects [concurrency]
	handle f3_release_cancellable_body(request) with io_provider::scope()
	match request
		F3ReleaseCancelRequest(_, state, _, _, _) => io_provider::update(state, (), f3_mark_continued)
	end
end

test cancelled_owner_exit_runs_restricted_cleanup() -> Result<(), String> effects [concurrency]
	let foreign_owner = f3_closed_foreign_owner()
	let events = channel::bounded<String>(1)
	let ready = channel::bounded<()>(1)
	let blocked = channel::bounded<()>(1)
	let state = io_provider::state(17)
	let request = F3CancelRequest(foreign_owner, state, events.tx, ready.tx, blocked.rx)
	let worker = task::spawn_with<(), F3CancelRequest>(f3_cancellable, request)
	let started: Option<()> = channel::recv(ready.rx)
	task::cancel(worker)
	let joined: Result<(), task::JoinError> = task::join(worker)
	if started == None
		Err("cancelled owner task did not reach its gate")
	else match joined
		Err(error) => if task::join_error_is_cancelled(error) and f3_release_event_matches(events.rx) and io_provider_lifecycle_test_support_test::observe_state(state) == 17
			Ok(())
		else
			Err("cancelled owner exit did not preserve cancellation, release access, and unrelated state")
		end
		Ok(_) => Err("cancelled owner task completed normally")
	end
end
end

test cancellation_first_delivered_by_release_remains_primary() -> Result<(), String> effects [concurrency]
	let foreign_owner = f3_closed_foreign_owner()
	let events = channel::bounded<String>(2)
	let entered = channel::bounded<()>(1)
	let blocked = channel::bounded<()>(1)
	let state = io_provider::state(17)
	let request = F3ReleaseCancelRequest(foreign_owner, state, events.tx, entered.tx, blocked.rx)
	let worker = task::spawn_with<(), F3ReleaseCancelRequest>(f3_release_cancellable, request)
	let release_started: Option<()> = channel::recv(entered.rx)
	task::cancel(worker)
	let joined: Result<(), task::JoinError> = task::join(worker)
	let first = f3_named_release_event_matches(events.rx, "release-checkpoint")
	let second = f3_named_release_event_matches(events.rx, "remaining-release")
	if release_started == None
		Err("owner release did not reach its cancellation checkpoint")
	else if not first
		Err("cancelled owner release did not preserve its checkpoint boundary")
	else if not second
		Err("cancelled owner release did not preserve its remaining release attempt")
	else if io_provider_lifecycle_test_support_test::observe_state(state) != 17
		Err("release-delivered cancellation allowed post-scope continuation or changed unrelated state")
	else match joined
		Err(error) => if task::join_error_is_cancelled(error)
			Ok(())
		else
			Err("release-delivered cancellation changed its terminal failure")
		end
		Ok(_) => Err("release-delivered cancellation completed normally")
	end
end
end

fn f4_copy_error(kind: io::ErrorKind, message: String) -> io::Error
	io::Error::Error("scripted", kind, None, None, None, None, message)
end

fn f4_copy(script: io_copy_test_support_test::Script, chunk_size: ByteCount) -> Result<io_copy_test_support_test::Observation, String> effects [concurrency]
	handle io_copy_test_support_test::execute(script, chunk_size) with io_provider::scope()
end

fn f4_snapshot_is_empty(snapshot: io_copy_test_support_test::Snapshot) -> Bool
	match snapshot
		io_copy_test_support_test::Snapshot(output, Nil, Nil, Cons(_, Nil), Nil) => byte_count_to_int(byte_chunk_count(output)) == 0
		_ => false
	end
end

fn f4_snapshot_output(snapshot: io_copy_test_support_test::Snapshot, expected: String) -> Bool
	match snapshot
		io_copy_test_support_test::Snapshot(output, _, _, _, _) => match byte_chunk_to_visible_ascii_string(output)
			Ok(actual) => actual == expected
			Err(_) => false
		end
	end
end

fn f4_inputs_match_two(inputs: List<ByteChunk>, first: String, second: String) -> Bool
	match inputs
		Cons(first_bytes, Cons(second_bytes, Nil)) => byte_chunk_to_visible_ascii_string(first_bytes)? == first and byte_chunk_to_visible_ascii_string(second_bytes)? == second
		_ => false
	end
end

fn f4_inputs_match_four(inputs: List<ByteChunk>, first: String, second: String, third: String, fourth: String) -> Bool
	match inputs
		Cons(first_bytes, Cons(second_bytes, Cons(third_bytes, Cons(fourth_bytes, Nil)))) => match byte_chunk_to_visible_ascii_string(first_bytes)
			Ok(first_actual) => match byte_chunk_to_visible_ascii_string(second_bytes)
				Ok(second_actual) => match byte_chunk_to_visible_ascii_string(third_bytes)
					Ok(third_actual) => match byte_chunk_to_visible_ascii_string(fourth_bytes)
						Ok(fourth_actual) => first_actual == first and second_actual == second and third_actual == third and fourth_actual == fourth
						Err(_) => false
					end
					Err(_) => false
				end
				Err(_) => false
			end
			Err(_) => false
		end
		_ => false
	end
end

test copy_rejects_zero_chunk_without_provider_calls() -> Result<(), String> effects [concurrency]
	let script = io_copy_test_support_test::Script(list_cons(io::ReadOutcome::End, list_nil()), list_nil())
	match f4_copy(script, byte_count(0)?)?
		io_copy_test_support_test::Observation(io::CopyOutcome::CopyFailed(io::Progress::Known(consumed), io::Progress::Known(committed), io::Error::Error("copy", io::ErrorKind::InvalidInput, _, _, _, _, _)), snapshot) => if byte_count_to_int(consumed) == 0 and byte_count_to_int(committed) == 0 and f4_snapshot_is_empty(snapshot)
			Ok(())
		else
			Err("zero-sized copy changed progress or invoked a provider")
		end
		_ => Err("zero-sized copy did not return InvalidInput with known zero progress")
	end
end

test copy_rejects_negative_chunk_without_provider_calls() -> Result<(), String> effects [concurrency]
	let script = io_copy_test_support_test::Script(list_cons(io::ReadOutcome::End, list_nil()), list_nil())
	match f4_copy(script, ByteCount(-1))?
		io_copy_test_support_test::Observation(io::CopyOutcome::CopyFailed(io::Progress::Known(consumed), io::Progress::Known(committed), io::Error::Error("copy", io::ErrorKind::InvalidInput, _, _, _, _, _)), snapshot) => if byte_count_to_int(consumed) == 0 and byte_count_to_int(committed) == 0 and f4_snapshot_is_empty(snapshot)
			Ok(())
		else
			Err("negative-sized copy changed progress or invoked a provider")
		end
		_ => Err("negative-sized copy did not return InvalidInput with known zero progress")
	end
end

test copy_stops_on_empty_successful_read() -> Result<(), String> effects [concurrency]
	let reads = list_cons(io::ReadOutcome::Data(byte_chunk([])), list_cons(io::ReadOutcome::End, list_nil()))
	let script = io_copy_test_support_test::Script(reads, list_nil())
	match f4_copy(script, byte_count(4)?)?
		io_copy_test_support_test::Observation(io::CopyOutcome::CopyFailed(io::Progress::Known(consumed), io::Progress::Known(committed), io::Error::Error("copy", io::ErrorKind::NoProgress, _, _, _, _, _)), io_copy_test_support_test::Snapshot(output, Cons(maximum, Nil), Nil, Cons(io::ReadOutcome::End, Nil), Nil)) => if byte_count_to_int(consumed) == 0 and byte_count_to_int(committed) == 0 and byte_count_to_int(byte_chunk_count(output)) == 0 and maximum == 4
			Ok(())
		else
			Err("empty successful read did not stop after one provider call")
		end
		_ => Err("empty successful read did not return NoProgress")
	end
end

test copy_retries_only_unwritten_suffixes_across_short_reads() -> Result<(), String> effects [concurrency]
	let reads = list_cons(io::ReadOutcome::Data(byte_chunk_from_visible_ascii_string("abc")?), list_cons(io::ReadOutcome::Data(byte_chunk_from_visible_ascii_string("de")?), list_cons(io::ReadOutcome::End, list_nil())))
	let writes = list_cons(io::WriteOutcome::Written(byte_count(1)?), list_cons(io::WriteOutcome::Written(byte_count(2)?), list_cons(io::WriteOutcome::Written(byte_count(1)?), list_cons(io::WriteOutcome::Written(byte_count(1)?), list_nil()))))
	let script = io_copy_test_support_test::Script(reads, writes)
	match f4_copy(script, byte_count(4)?)?
		io_copy_test_support_test::Observation(io::CopyOutcome::Copied(count), io_copy_test_support_test::Snapshot(output, Cons(4, Cons(4, Cons(4, Nil))), inputs, Nil, Nil)) => if byte_count_to_int(count) == 5 and byte_chunk_to_visible_ascii_string(output)? == "abcde" and f4_inputs_match_four(inputs, "e", "de", "bc", "abc")
			Ok(())
		else
			Err("copy did not preserve short reads and exact unwritten suffixes")
		end
		_ => Err("copy did not complete multiple short reads and partial writes")
	end
end

test copy_stops_on_zero_write_after_partial_success() -> Result<(), String> effects [concurrency]
	let reads = list_cons(io::ReadOutcome::Data(byte_chunk_from_visible_ascii_string("ab")?), list_nil())
	let writes = list_cons(io::WriteOutcome::Written(byte_count(1)?), list_cons(io::WriteOutcome::Written(byte_count(0)?), list_nil()))
	let script = io_copy_test_support_test::Script(reads, writes)
	match f4_copy(script, byte_count(2)?)?
		io_copy_test_support_test::Observation(io::CopyOutcome::CopyFailed(io::Progress::Known(consumed), io::Progress::Known(committed), io::Error::Error("copy", io::ErrorKind::NoProgress, _, _, _, _, _)), snapshot) => if byte_count_to_int(consumed) == 2 and byte_count_to_int(committed) == 1 and f4_snapshot_output(snapshot, "a")
			Ok(())
		else
			Err("zero write did not preserve consumed and committed progress")
		end
		_ => Err("zero write did not stop with NoProgress")
	end
end

test copy_accumulates_known_read_failure_without_writing_failure_bytes() -> Result<(), String> effects [concurrency]
	let failure = f4_copy_error(io::ErrorKind::Other, "known read failure")
	let reads = list_cons(io::ReadOutcome::Data(byte_chunk_from_visible_ascii_string("ab")?), list_cons(io::ReadOutcome::ReadFailed(byte_chunk_from_visible_ascii_string("x")?, io::Progress::Known(byte_count(1)?), failure), list_nil()))
	let script = io_copy_test_support_test::Script(reads, list_nil())
	match f4_copy(script, byte_count(4)?)?
		io_copy_test_support_test::Observation(io::CopyOutcome::CopyFailed(io::Progress::Known(consumed), io::Progress::Known(committed), io::Error::Error("scripted", io::ErrorKind::Other, _, _, _, _, "known read failure")), snapshot) => if byte_count_to_int(consumed) == 3 and byte_count_to_int(committed) == 2 and f4_snapshot_output(snapshot, "ab")
			Ok(())
		else
			Err("known read failure did not preserve progress or excluded bytes")
		end
		_ => Err("known read failure did not preserve its original error")
	end
end

