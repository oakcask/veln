fn f2_non_nearest_namespace_rejection(filesystem: fs::Filesystem, cell: io_provider::State<filesystem_provider_test_support_test::FakeState>) -> Result<(), String> effects [io_provider::Scope, fs::Read, concurrency]
	let _ = io_provider::owner()
	let before = filesystem_provider_test_support_test::snapshot(cell)
	let rejected = fs::open_read(filesystem, path::root())
	let after = filesystem_provider_test_support_test::snapshot(cell)
	if not f2_open_is_invalid_input(rejected)
		Err("captured dispatch registered a namespace for a non-nearest owner")
	else if not f2_snapshot_matches(before, "authority", "", 0, "") or not f2_snapshot_matches(after, "authority", "", 0, "")
		Err("non-nearest namespace rejection changed fake-provider state")
	else
		Ok(())
	end
end

