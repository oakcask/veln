test closed_owner_facade_and_lexical_dispatch_reject_before_provider_call() -> Result<(), String> effects [concurrency]
	let foreign_owner = f3_closed_foreign_owner()
	let events = channel::bounded<String>(1)
	let ready = channel::bounded<()>(1)
	let start = channel::bounded<()>(1)
