end

fn is_unsupported(result: Result<io_provider::Resource, io::Error>) -> Bool
	match result
		Err(io::Error::Error(_, io::ErrorKind::Unsupported, _, _, _, _, _)) => true
		_ => false
	end
end

fn is_invalid_input(result: Result<io_provider::Resource, io::Error>) -> Bool
	match result
		Err(io::Error::Error(_, io::ErrorKind::InvalidInput, _, _, _, _, _)) => true
		_ => false
	end
end

fn is_invalid_input_filesystem(result: Result<fs::Filesystem, io::Error>) -> Bool
	match result
		Err(io::Error::Error(_, io::ErrorKind::InvalidInput, _, _, _, _, _)) => true
		_ => false
	end
end

fn is_invalid_input_mutable_filesystem(result: Result<fs::MutableFilesystem, io::Error>) -> Bool
	match result
		Err(io::Error::Error(_, io::ErrorKind::InvalidInput, _, _, _, _, _)) => true
		_ => false
	end
