fn f2_shared_inner_observations(first_owner: io_provider::Owner, first_filesystem: fs::Filesystem, first_state: io_provider::State<filesystem_provider_test_support_test::FakeState>, second_state: io_provider::State<filesystem_provider_test_support_test::FakeState>, providers: io_provider::State<filesystem_provider_test_support_test::SharedProviders>) -> Result<(), String> effects [io_provider::Scope, fs::Read, io::Read, concurrency]
	let second_owner = io_provider::owner()
	let second = filesystem_provider_test_support_test::SharedProvider(second_owner, 59, 71, second_state)
	let _ = filesystem_provider_test_support_test::register_second(providers, second)
	match io_provider::filesystem(second_owner, 59)
		Err(_) => Err("second owner could not reuse the shared namespace handler")
		Ok(second_filesystem) => begin
			let before_foreign_first = filesystem_provider_test_support_test::snapshot(first_state)
			let before_foreign_second = filesystem_provider_test_support_test::snapshot(second_state)
			let foreign_namespace = perform fs::Read::open_read(first_filesystem, path::root())
			let after_foreign_first = filesystem_provider_test_support_test::snapshot(first_state)
			let after_foreign_second = filesystem_provider_test_support_test::snapshot(second_state)
			if not f2_foreign_filesystem_rejected(foreign_namespace)
				Err("shared-frame foreign namespace token was not rejected")
			else if not f2_snapshot_matches(before_foreign_first, "first", "", 0, "") or not f2_snapshot_matches(after_foreign_first, "first", "", 0, "")
				Err("shared-frame foreign namespace token changed the first provider")
			else if not f2_snapshot_matches(before_foreign_second, "second", "", 0, "") or not f2_snapshot_matches(after_foreign_second, "second", "", 0, "")
				Err("shared-frame foreign namespace token changed the second provider")
			else match fs::open_read(first_filesystem, path::root())
				Err(_) => Err("shared namespace handler did not dispatch the first owner")
				Ok(fs::ReadFile(first_reader, _, _, _)) => match fs::open_read(second_filesystem, path::root())
					Err(_) => Err("shared namespace handler did not dispatch the second owner")
					Ok(fs::ReadFile(second_reader, _, _, _)) => match byte_count(6)
						Err(_) => Err("could not construct the shared-provider read bound")
						Ok(maximum) => begin
							let before_foreign_capability_first = filesystem_provider_test_support_test::snapshot(first_state)
							let before_foreign_capability_second = filesystem_provider_test_support_test::snapshot(second_state)
							let foreign_capability = perform io::Read::read(first_reader, maximum)
							let after_foreign_capability_first = filesystem_provider_test_support_test::snapshot(first_state)
							let after_foreign_capability_second = filesystem_provider_test_support_test::snapshot(second_state)
							if not f2_foreign_reader_rejected(foreign_capability)
								Err("shared-frame foreign byte capability was not rejected")
							else if not f2_snapshot_matches(before_foreign_capability_first, "first", "", 0, "open_read;") or not f2_snapshot_matches(after_foreign_capability_first, "first", "", 0, "open_read;")
								Err("shared-frame foreign byte capability changed the first provider")
							else if not f2_snapshot_matches(before_foreign_capability_second, "second", "", 0, "open_read;") or not f2_snapshot_matches(after_foreign_capability_second, "second", "", 0, "open_read;")
								Err("shared-frame foreign byte capability changed the second provider")
							else begin
								let first_read = io::read(first_reader, maximum)
								let second_read = io::read(second_reader, maximum)
								let final_first = filesystem_provider_test_support_test::snapshot(first_state)
								let final_second = filesystem_provider_test_support_test::snapshot(second_state)
								if f2_read_matches(first_read, "first") and f2_read_matches(second_read, "second") and f2_snapshot_matches(final_first, "first", "", 1, "open_read;read;") and f2_snapshot_matches(final_second, "second", "", 1, "open_read;read;")
									Ok(())
								else
									Err("shared handler frames did not preserve independent provider bytes and logs")
								end
							end
							end
						end
					end
				end
			end
		end
	end
end

end

