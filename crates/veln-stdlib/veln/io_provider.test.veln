fn update_duplicate_registrations_preserve_originals() -> Result<(), String> effects [io_provider::Scope, concurrency]
	let owner = io_provider::owner()
	let calls = channel::bounded<String>(32)
	if not is_invalid_input(complete_update_registration(owner, -1, calls.tx)) or not no_handler_calls(calls.rx)
		Err("UpdateFile registration accepted a negative private slot")
	else
		match complete_update_registration(owner, 111, calls.tx)
			Ok(update_resource) => if not is_invalid_input(complete_update_registration(owner, 111, calls.tx)) or not is_invalid_input(complete_registration(owner, 111, calls.tx)) or not is_invalid_input(complete_write_registration(owner, 111, calls.tx)) or not is_invalid_input(complete_append_registration(owner, 111, calls.tx)) or not no_handler_calls(calls.rx) or not projected_update_slots_match(owner, update_resource, 111)
				Err("same-family or incoming existing-family duplicate changed UpdateFile")
			else
				match complete_registration(owner, 112, calls.tx)
					Ok(read_resource) => if not is_invalid_input(complete_update_registration(owner, 112, calls.tx)) or not projected_slots_match(owner, read_resource, 112)
						Err("incoming UpdateFile duplicate changed ReadFile")
					else
						match complete_write_registration(owner, 113, calls.tx)
							Ok(write_resource) => if not is_invalid_input(complete_update_registration(owner, 113, calls.tx)) or not projected_write_slots_match(owner, write_resource, 113)
								Err("incoming UpdateFile duplicate changed WriteFile")
							else
								match complete_append_registration(owner, 114, calls.tx)
									Ok(append_resource) => if not is_invalid_input(complete_update_registration(owner, 114, calls.tx)) or not projected_append_slots_match(owner, append_resource, 114) or not no_handler_calls(calls.rx)
										Err("incoming UpdateFile duplicate changed AppendFile or invoked a handler")
									else
										Ok(())
									end
									Err(_) => Err("AppendFile setup failed for UpdateFile duplicate check")
								end
							end
							Err(_) => Err("WriteFile setup failed for UpdateFile duplicate check")
						end
					end
					Err(_) => Err("ReadFile setup failed for UpdateFile duplicate check")
				end
			end
			Err(_) => Err("initial UpdateFile registration failed")
		end
	end
end

fn existing_families_reject_update_projection() -> Result<(), String> effects [io_provider::Scope, concurrency]
	let owner = io_provider::owner()
	let calls = channel::bounded<String>(32)
	match complete_registration(owner, 121, calls.tx)
		Ok(read_resource) => match io_provider::update_file(read_resource)
			Err(io::Error::Error(_, io::ErrorKind::Unsupported, _, _, _, _, _)) => if not projected_slots_match(owner, read_resource, 121)
				Err("failed UpdateFile projection changed ReadFile")
			else
				match complete_write_registration(owner, 122, calls.tx)
					Ok(write_resource) => match io_provider::update_file(write_resource)
						Err(io::Error::Error(_, io::ErrorKind::Unsupported, _, _, _, _, _)) => if not projected_write_slots_match(owner, write_resource, 122)
							Err("failed UpdateFile projection changed WriteFile")
						else
							match complete_append_registration(owner, 123, calls.tx)
								Ok(append_resource) => match io_provider::update_file(append_resource)
									Err(io::Error::Error(_, io::ErrorKind::Unsupported, _, _, _, _, _)) => if projected_append_slots_match(owner, append_resource, 123) and no_handler_calls(calls.rx)
										Ok(())
									else
										Err("failed UpdateFile projection changed AppendFile or invoked a handler")
									end
									_ => Err("AppendFile resource accepted UpdateFile projection")
								end
								Err(_) => Err("AppendFile setup failed for projection check")
							end
						end
						_ => Err("WriteFile resource accepted UpdateFile projection")
					end
					Err(_) => Err("WriteFile setup failed for projection check")
				end
			end
			_ => Err("ReadFile resource accepted UpdateFile projection")
		end
		Err(_) => Err("ReadFile setup failed for projection check")
	end
end

