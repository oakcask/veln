fn all_family_projection_combinations_preserve_resources() -> Result<(), String> effects [io_provider::Scope, concurrency]
	let owner = io_provider::owner()
	let calls = channel::bounded<String>(32)
	match complete_family_registration(owner, 141, io_provider::ViewFamily::ReadFile, calls.tx)
		Ok(read_resource) => if not family_projection_boundary(owner, read_resource, io_provider::ViewFamily::ReadFile, 141, calls.rx)
			Err("ReadFile projection compatibility boundary failed")
		else
			match complete_family_registration(owner, 142, io_provider::ViewFamily::WriteFile, calls.tx)
				Ok(write_resource) => if not family_projection_boundary(owner, write_resource, io_provider::ViewFamily::WriteFile, 142, calls.rx)
					Err("WriteFile projection compatibility boundary failed")
				else
					match complete_family_registration(owner, 143, io_provider::ViewFamily::UpdateFile, calls.tx)
						Ok(update_resource) => if not family_projection_boundary(owner, update_resource, io_provider::ViewFamily::UpdateFile, 143, calls.rx)
							Err("UpdateFile projection compatibility boundary failed")
						else
							match complete_family_registration(owner, 144, io_provider::ViewFamily::AppendFile, calls.tx)
								Ok(append_resource) => if not family_projection_boundary(owner, append_resource, io_provider::ViewFamily::AppendFile, 144, calls.rx)
									Err("AppendFile projection compatibility boundary failed")
								else
									match complete_family_registration(owner, 145, io_provider::ViewFamily::Duplex, calls.tx)
										Ok(duplex_resource) => if family_projection_boundary(owner, duplex_resource, io_provider::ViewFamily::Duplex, 145, calls.rx)
											Ok(())
										else
											Err("Duplex projection compatibility boundary failed")
										end
										Err(_) => Err("Duplex setup failed for projection compatibility boundary")
									end
								end
								Err(_) => Err("AppendFile setup failed for projection compatibility boundary")
							end
						end
						Err(_) => Err("UpdateFile setup failed for projection compatibility boundary")
					end
				end
				Err(_) => Err("WriteFile setup failed for projection compatibility boundary")
			end
		end
		Err(_) => Err("ReadFile setup failed for projection compatibility boundary")
	end
end

fn duplicate_row_preserves_first(owner: io_provider::Owner, slot: Int, family: io_provider::ViewFamily, calls: {tx: Sender<String>, rx: Receiver<String>}) -> Bool effects [concurrency]
	match complete_family_registration(owner, slot, family, calls.tx)
		Ok(original) => is_invalid_input(complete_family_registration(owner, slot, io_provider::ViewFamily::ReadFile, calls.tx)) and is_invalid_input(complete_family_registration(owner, slot, io_provider::ViewFamily::WriteFile, calls.tx)) and is_invalid_input(complete_family_registration(owner, slot, io_provider::ViewFamily::UpdateFile, calls.tx)) and is_invalid_input(complete_family_registration(owner, slot, io_provider::ViewFamily::AppendFile, calls.tx)) and is_invalid_input(complete_family_registration(owner, slot, io_provider::ViewFamily::Duplex, calls.tx)) and family_projection_boundary(owner, original, family, slot, calls.rx)
		Err(_) => false
	end
end

fn all_family_duplicate_orders_preserve_first() -> Result<(), String> effects [io_provider::Scope, concurrency]
	let owner = io_provider::owner()
	let calls = channel::bounded<String>(64)
	if not is_invalid_input(duplex_without_read(owner, -1, calls.tx)) or not no_handler_calls(calls.rx)
		Err("negative Duplex slot resolved handlers before validation")
	else if not duplicate_row_preserves_first(owner, 151, io_provider::ViewFamily::ReadFile, calls)
		Err("duplicate registrations changed the first ReadFile resource")
	else if not duplicate_row_preserves_first(owner, 152, io_provider::ViewFamily::WriteFile, calls)
		Err("duplicate registrations changed the first WriteFile resource")
	else if not duplicate_row_preserves_first(owner, 153, io_provider::ViewFamily::UpdateFile, calls)
		Err("duplicate registrations changed the first UpdateFile resource")
	else if not duplicate_row_preserves_first(owner, 154, io_provider::ViewFamily::AppendFile, calls)
		Err("duplicate registrations changed the first AppendFile resource")
	else if not duplicate_row_preserves_first(owner, 155, io_provider::ViewFamily::Duplex, calls)
		Err("duplicate registrations changed the first Duplex resource")
	else
		Ok(())
	end
end

