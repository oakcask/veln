end

fn capability_facade_dispatch_observations(view: fs::UpdateFile, captured: Receiver<String>, fallback: Receiver<String>) -> Result<(), String> effects [io::Read, io::Write, io::Seek, io::ReadAt, io::WriteAt, io::Close, io::Sync, fs::Mutate, concurrency]
	match view
		fs::UpdateFile::UpdateFile(reader, writer, seeker, reader_at, writer_at, closer, syncer, truncater) => begin
			let maximum = byte_count(2)?
			let offset = byte_offset(3)?
			let bytes = byte_chunk_from_hex("6162")?
			let _ = io::read(reader, maximum)
			let _ = io::write(writer, bytes)
			let _ = io::seek(seeker, io::SeekOrigin::Start(offset))
			let _ = io::read_at(reader_at, offset, maximum)
			let _ = io::write_at(writer_at, offset, bytes)
			let _ = io::close(closer)
			let _ = io::sync(syncer)
			let _ = fs::truncate(truncater, offset)
			if next_handler_call_is(captured, "read") and next_handler_call_is(captured, "write") and next_handler_call_is(captured, "seek") and next_handler_call_is(captured, "read_at") and next_handler_call_is(captured, "write_at") and next_handler_call_is(captured, "close") and next_handler_call_is(captured, "sync") and next_handler_call_is(captured, "truncate") and no_handler_calls(captured) and no_handler_calls(fallback)
				Ok(())
			else
				Err("projected capability facades did not dispatch every operation to their captured handlers")
			end
		end
	end
end

fn capability_facade_dispatch_setup() -> Result<(), String> effects [io_provider::Scope, concurrency]
	let owner = io_provider::owner()
	let captured = channel::bounded<String>(16)
	let fallback = channel::bounded<String>(16)
	match complete_update_registration(owner, 182, captured.tx)
		Err(_) => Err("projected capability dispatch registration failed")
		Ok(resource) => match io_provider::update_file(resource)
			Err(_) => Err("projected capability dispatch projection failed")
			Ok(view) => handle handle handle handle handle handle handle handle capability_facade_dispatch_observations(view, captured.rx, fallback.rx) with io_provider_test_support_test::read(fallback.tx) with io_provider_test_support_test::write(fallback.tx) with io_provider_test_support_test::seek(fallback.tx) with io_provider_test_support_test::read_at(fallback.tx) with io_provider_test_support_test::write_at(fallback.tx) with io_provider_test_support_test::close(fallback.tx) with io_provider_test_support_test::sync(fallback.tx) with io_provider_test_support_test::mutate(fallback.tx)
		end
	end
end

