use log
use observe_test_support_test

test debug_emits_one_typed_record_with_user_callsite() -> Result<(), String> effects [concurrency]
	let records = observe_test_support_test::records(2)
	let _ = handle log::debug(observe_test_support_test::o1_context(), "accepted", observe_test_support_test::o1_attributes()) with observe_test_support_test::recording(records.tx)
	channel::close(records.tx)
	match channel::recv(records.rx)
		Some(record) => if observe_test_support_test::is_o1_debug(record, "log.test.veln", 6)
			match channel::recv(records.rx)
				None => Ok(())
				Some(_) => Err("debug emitted more than one observation")
			end
		else
			Err("debug observation fields changed")
		end
		None => Err("debug emitted no observation")
	end
end

