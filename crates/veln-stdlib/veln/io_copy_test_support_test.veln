use prelude
use io
use io_provider

pub type Script
	pub Script(reads: List<io::ReadOutcome>, writes: List<io::WriteOutcome>)
end

type State
	State(reads: List<io::ReadOutcome>, writes: List<io::WriteOutcome>, output: ByteChunk, read_maximums: List<Int>, write_inputs: List<ByteChunk>)
end

pub type Snapshot
	pub Snapshot(output: ByteChunk, read_maximums: List<Int>, write_inputs: List<ByteChunk>, remaining_reads: List<io::ReadOutcome>, remaining_writes: List<io::WriteOutcome>)
end

pub type Observation
	pub Observation(outcome: io::CopyOutcome, snapshot: Snapshot)
end

fn error(kind: io::ErrorKind, message: String) -> io::Error
	io::Error::Error("copy-test", kind, None, None, None, None, message)
end

fn zero_progress() -> io::Progress
	io::Progress::Known(byte_chunk_count(byte_chunk([])))
end

fn slot_matches(actual: Result<Int, io::Error>, expected: Int) -> Bool
	match actual
		Ok(slot) => slot == expected
		Err(_) => false
	end
end

fn next_read(current: State, maximum: ByteCount) -> {state: State, result: io::ReadOutcome}
	match current
		State(reads, writes, output, maximums, inputs) => match reads
			Cons(next, remaining) => {state: State(remaining, writes, output, Cons(byte_count_to_int(maximum), maximums), inputs), result: next}
			Nil => {state: State(Nil, writes, output, Cons(byte_count_to_int(maximum), maximums), inputs), result: io::ReadOutcome::End}
		end
	end
end

fn progress_count(progress: io::Progress) -> ByteCount
	match progress
		io::Progress::Known(count) => count
		io::Progress::Unknown(count) => count
	end
end

fn committed_prefix(bytes: ByteChunk, outcome: io::WriteOutcome) -> ByteChunk
	let count = match outcome
		io::WriteOutcome::Written(written) => written
		io::WriteOutcome::WriteFailed(progress, _) => progress_count(progress)
	end
	match byte_take(bytes, count)
		Ok(prefix) => prefix
		Err(_) => byte_chunk([])
	end
end

fn next_write(current: State, bytes: ByteChunk) -> {state: State, result: io::WriteOutcome}
	match current
		State(reads, writes, output, maximums, inputs) => match writes
			Cons(next, remaining) => begin
				let next_output = byte_append(output, committed_prefix(bytes, next))
				{state: State(reads, remaining, next_output, maximums, Cons(bytes, inputs)), result: next}
			end
			Nil => begin
				let next_output = byte_append(output, bytes)
				{state: State(reads, Nil, next_output, maximums, Cons(bytes, inputs)), result: io::WriteOutcome::Written(byte_chunk_count(bytes))}
			end
		end
	end
end

fn observe(current: State, context: ()) -> {state: State, result: Snapshot}
	match current
		State(reads, writes, output, maximums, inputs) => {state: current, result: Snapshot(output, maximums, inputs, reads, writes)}
	end
end

handler scripted_read(owner: io_provider::Owner, slot: Int, state: io_provider::State<State>) for io::Read effects [concurrency]
	read(reader, maximum) => if slot_matches(io_provider::reader_slot(owner, reader), slot)
		io_provider::update(state, maximum, next_read)
	else
		io::ReadOutcome::ReadFailed(byte_chunk([]), zero_progress(), error(io::ErrorKind::InvalidResource, "reader belongs to another provider"))
	end
end

handler scripted_write(owner: io_provider::Owner, slot: Int, state: io_provider::State<State>) for io::Write effects [concurrency]
	write(writer, bytes) => if slot_matches(io_provider::writer_slot(owner, writer), slot)
		io_provider::update(state, bytes, next_write)
	else
		io::WriteOutcome::WriteFailed(zero_progress(), error(io::ErrorKind::InvalidResource, "writer belongs to another provider"))
	end
end

handler scripted_close() for io::Close
	close(closer) => io::CloseOutcome::Closed
end

fn execute_body(owner: io_provider::Owner, slot: Int, cell: io_provider::State<State>, chunk_size: ByteCount) -> Result<Observation, String> effects [io::Read, io::Write, concurrency]
	let registered = io_provider::resource(owner, slot, io_provider::ViewFamily::Duplex)
	match registered
		Err(_) => Err("could not register scripted copy resource")
		Ok(resource) => match io_provider::duplex(resource)
			Err(_) => Err("could not project scripted copy resource")
			Ok(view) => begin
				let outcome = io::copy(view.reader, view.writer, chunk_size)
				let snapshot = io_provider::update(cell, (), observe)
				Ok(Observation(outcome, snapshot))
			end
		end
	end
end

pub fn execute(script: Script, chunk_size: ByteCount) -> Result<Observation, String> effects [io_provider::Scope, concurrency]
	let owner = io_provider::owner()
	let slot = 904
	let cell = match script
		Script(reads, writes) => io_provider::state(State(reads, writes, byte_chunk([]), list_nil(), list_nil()))
	end
	handle handle handle execute_body(owner, slot, cell, chunk_size) with scripted_read(owner, slot, cell) with scripted_write(owner, slot, cell) with scripted_close()
end
