mod core_prelude

fn vec_len(items: Vec(A)) -> Int effects []
	vec_fold(items, 0, vec_len_step)
end

fn vec_len_step(count: Int, item: A) -> Int effects []
	count + 1
end

fn vec_is_empty(items: Vec(A)) -> Bool effects []
	vec_len(items) == 0
end

fn vec_push(items: Vec(A), value: A) -> Vec(A) effects []
	vec_concat(items, [value])
end

fn vec_concat(left: Vec(A), right: Vec(A)) -> Vec(A) effects []
	vec_fold(right, left, vec_append)
end

fn vec_append(items: Vec(A), item: A) -> Vec(A) effects []
	vec_push(items, item)
end

fn vec_map(items: Vec(Item), f: fn(Item) -> A) -> Vec(A) effects []
	let state: {values: Vec(A), map: fn(Item) -> A} = vec_fold(items, {values: [], map: f}, vec_map_step)
	state.values
end

fn vec_map_step(state: {values: Vec(A), map: fn(Item) -> A}, item: Item) -> {values: Vec(A), map: fn(Item) -> A} effects []
	let map = state.map
	{values: vec_push(state.values, map(item)), map: map}
end

fn vec_filter(items: Vec(A), f: fn(A) -> Bool) -> Vec(A) effects []
	let state: {values: Vec(A), keep: fn(A) -> Bool} = vec_fold(items, {values: [], keep: f}, vec_filter_step)
	state.values
end

fn vec_filter_step(state: {values: Vec(A), keep: fn(A) -> Bool}, item: A) -> {values: Vec(A), keep: fn(A) -> Bool} effects []
	let keep = state.keep
	match keep(item)
		true => {values: vec_push(state.values, item), keep: keep}
		false => state
	end
end

fn vec_try_map(items: Vec(Item), f: fn(Item) -> Result(A, E)) -> Result(Vec(A), E) effects []
	let state: {values: Result(Vec(A), E), map: fn(Item) -> Result(A, E)} = vec_fold(items, {values: Ok([]), map: f}, vec_try_map_step)
	state.values
end

fn vec_try_map_step(state: {values: Result(Vec(A), E), map: fn(Item) -> Result(A, E)}, item: Item) -> {values: Result(Vec(A), E), map: fn(Item) -> Result(A, E)} effects []
	let map = state.map
	match state.values
		Ok(values) => match map(item)
			Ok(mapped) => {values: Ok(vec_push(values, mapped)), map: map}
			Err(error) => {values: Err(error), map: map}
		end
		Err(error) => {values: Err(error), map: map}
	end
end

fn vec_try_map_with(context: C, items: Vec(Item), f: fn(C, Item) -> Result(A, E)) -> Result(Vec(A), E) effects []
	let state: {values: Result(Vec(A), E), map: fn(C, Item) -> Result(A, E), context: C} = vec_fold(items, {values: Ok([]), map: f, context: context}, vec_try_map_with_step)
	state.values
end

fn vec_try_map_with_step(state: {values: Result(Vec(A), E), map: fn(C, Item) -> Result(A, E), context: C}, item: Item) -> {values: Result(Vec(A), E), map: fn(C, Item) -> Result(A, E), context: C} effects []
	let map = state.map
	let context = state.context
	match state.values
		Ok(values) => match map(context, item)
			Ok(mapped) => {values: Ok(vec_push(values, mapped)), map: map, context: context}
			Err(error) => {values: Err(error), map: map, context: context}
		end
		Err(error) => {values: Err(error), map: map, context: context}
	end
end

fn dict_get(dict: Dict(K, V), key: K) -> Option(V) effects []
	dict_get(dict, key)
end

fn dict_contains(dict: Dict(K, V), key: K) -> Bool effects []
	match dict_get(dict, key)
		Some(_) => true
		None => false
	end
end

fn dict_insert(dict: Dict(K, V), key: K, value: V) -> Dict(K, V) effects []
	dict_insert(dict, key, value)
end

fn dict_remove(dict: Dict(K, V), key: K) -> Dict(K, V) effects []
	dict_remove(dict, key)
end

fn option_map(value: Option(A), f: fn(A) -> B) -> Option(B) effects []
	match value
		Some(inner) => Some(f(inner))
		None => None
	end
end

fn option_and_then(value: Option(A), f: fn(A) -> Option(B)) -> Option(B) effects []
	match value
		Some(inner) => f(inner)
		None => None
	end
end

fn option_unwrap_or(value: Option(A), fallback: A) -> A effects []
	match value
		Some(inner) => inner
		None => fallback
	end
end

fn result_map(value: Result(A, E), f: fn(A) -> B) -> Result(B, E) effects []
	match value
		Ok(inner) => Ok(f(inner))
		Err(error) => Err(error)
	end
end

fn result_map_err(value: Result(A, E), f: fn(E) -> F) -> Result(A, F) effects []
	match value
		Ok(inner) => Ok(inner)
		Err(error) => Err(f(error))
	end
end

fn result_and_then(value: Result(A, E), f: fn(A) -> Result(B, E)) -> Result(B, E) effects []
	match value
		Ok(inner) => f(inner)
		Err(error) => Err(error)
	end
end

fn int_to_string(value: Int) -> String effects []
	int_to_string(value)
end
