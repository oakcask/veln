pub type Path
	PortablePath(value: String)
end

pub type InvalidPath
	pub Empty
	pub Nul
	pub LeadingSeparator
	pub TrailingSeparator
	pub EmptyComponent
	pub CurrentComponent
	pub ParentComponent
end

pub fn parse(value: String) -> Result<Path, InvalidPath>
	if value == ""
		Err(Empty)
	else if prelude_builtin::string_contains_nul(value)
		Err(Nul)
	else if value == "."
		Ok(root())
	else if starts_with_separator(value)
		Err(LeadingSeparator)
	else if ends_with_separator(value)
		Err(TrailingSeparator)
	else if has_component(value, "")
		Err(EmptyComponent)
	else if has_component(value, ".")
		Err(CurrentComponent)
	else if has_component(value, "..")
		Err(ParentComponent)
	else
		Ok(PortablePath(value))
	end
end

pub fn root() -> Path
	PortablePath(".")
end

pub fn text(value: Path) -> String
	match value
		PortablePath(spelling) => spelling
	end
end

pub fn equal(left: Path, right: Path) -> Bool
	text(left) == text(right)
end

pub fn components(value: Path) -> List<String>
	let spelling = text(value)
	if spelling == "."
		Nil
	else
		components_from(spelling)
	end
end

pub fn join(left: Path, right: Path) -> Path
	let left_text = text(left)
	let right_text = text(right)
	if left_text == "."
		right
	else if right_text == "."
		left
	else
		PortablePath(string::concat(string::concat(left_text, "/"), right_text))
	end
end

pub fn parent(value: Path) -> Option<Path>
	let spelling = text(value)
	if spelling == "."
		None
	else
		match string_split_once(spelling, "/")
			None => Some(root())
			Some(_) => Some(PortablePath(parent_text(spelling)))
		end
	end
end

pub fn name(value: Path) -> Option<String>
	let spelling = text(value)
	if spelling == "."
		None
	else
		Some(last_component(spelling))
	end
end

fn starts_with_separator(value: String) -> Bool
	match string_split_once(value, "/")
		Some(parts) => parts.left == ""
		None => false
	end
end

fn ends_with_separator(value: String) -> Bool
	match string_split_once(value, "/")
		None => false
		Some(parts) => if parts.right == ""
			true
		else
			ends_with_separator(parts.right)
		end
	end
end

fn has_component(value: String, expected: String) -> Bool
	match string_split_once(value, "/")
		None => value == expected
		Some(parts) => parts.left == expected or has_component(parts.right, expected)
	end
end

fn components_from(value: String) -> List<String>
	match string_split_once(value, "/")
		None => Cons(value, Nil)
		Some(parts) => Cons(parts.left, components_from(parts.right))
	end
end

fn parent_text(value: String) -> String
	match string_split_once(value, "/")
		None => "."
		Some(parts) => match string_split_once(parts.right, "/")
			None => parts.left
			Some(_) => string::concat(string::concat(parts.left, "/"), parent_text(parts.right))
		end
	end
end

fn last_component(value: String) -> String
	match string_split_once(value, "/")
		None => value
		Some(parts) => last_component(parts.right)
	end
end
