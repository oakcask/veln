use prelude
use net
use io
use io_provider as provider
use host_effects

pub type Event
	pub Read(maximum: Int)
	pub Write(bytes: ByteChunk)
	pub Close
end

pub type State
	pub State(input: ByteChunk, output: ByteChunk, events: List<Event>, mode: String, close_commit: Int, close_actual: Bool, closes: Int, live: Bool, releases: Int)
end

pub fn initial(input: ByteChunk, mode: String, close_commit: Int, close_actual: Bool) -> State
	State(input, byte_chunk([]), Nil, mode, close_commit, close_actual, 0, true, 0)
end

pub fn observe(state: State) -> {input: ByteChunk, output: ByteChunk, events: List<Event>, closes: Int, live: Bool, releases: Int}
	match state
		State(input, output, events, mode, commit, actual, closes, live, releases) => {input: input, output: output, events: events, closes: closes, live: live, releases: releases}
	end
end

fn failure(operation: String, kind: net::NetErrorKind) -> net::NetError
	net::NetError(operation, Some(net::Tcp4), Some("192.0.2.1:443"), kind, "selected network provider failure")
end

fn amount(maximum: ByteCount, bytes: ByteChunk, limit: Int) -> ByteCount
	let count = byte_count_to_int(byte_chunk_count(bytes))
	let requested = byte_count_to_int(maximum)
	let selected = if requested < count
		requested
	else
		count
	end
	match byte_count(if selected < limit
		selected
	else
		limit
	end)
		Ok(value) => value
		Err(_) => byte_chunk_count(byte_chunk([]))
	end
end

fn read_step(state: State, maximum: ByteCount) -> {state: State, result: Result<net::ReadOutcome, net::NetError>}
	match state
		State(input, output, events, mode, commit, actual, closes, live, releases) => begin
			let selected = amount(maximum, input, if mode == "read-failure"
				2
			else
				9223372036854775807
			end)
			let bytes = match byte_take(input, selected)
				Ok(value) => value
				Err(_) => byte_chunk([])
			end
			let remaining = match byte_drop(input, selected)
				Ok(value) => value
				Err(_) => input
			end
			let result: Result<net::ReadOutcome, net::NetError> = if mode == "read-failure"
				Err(failure("provider_read", net::ConnectionReset))
			else if byte_count_to_int(byte_chunk_count(input)) == 0 and byte_count_to_int(maximum) > 0
				Ok(net::End)
			else
				Ok(net::Chunk(bytes))
			end
			{state: State(remaining, output, Cons(Event::Read(byte_count_to_int(maximum)), events), mode, commit, actual, closes, live, releases), result: result}
		end
	end
end

fn write_step(state: State, bytes: ByteChunk) -> {state: State, result: net::WriteOutcome}
	match state
		State(input, output, events, mode, commit, actual, closes, live, releases) => begin
			let selected = amount(byte_chunk_count(bytes), bytes, if mode == "short-write" or mode == "write-failure"
				2
			else
				9223372036854775807
			end)
			let prefix = match byte_take(bytes, selected)
				Ok(value) => value
				Err(_) => byte_chunk([])
			end
			let result = if mode == "write-failure"
				net::WriteFailed(selected, failure("provider_write", net::TimedOut))
			else
				net::Written(selected)
			end
			{state: State(input, byte_append(output, prefix), Cons(Event::Write(bytes), events), mode, commit, actual, closes, live, releases), result: result}
		end
	end
end

fn read(cell: provider::State<State>, stream: net::Stream, maximum: ByteCount) -> Result<net::ReadOutcome, net::NetError> effects [net, time, concurrency]
	match prelude_builtin::net_system_read_bounded(stream, byte_chunk_count(byte_chunk([])), None, None)
		Err(error) => Err(error)
		Ok(_) => provider::update(cell, maximum, read_step)
	end
end

fn write(cell: provider::State<State>, stream: net::Stream, bytes: ByteChunk) -> net::WriteOutcome effects [net, time, concurrency]
	match prelude_builtin::net_system_write(stream, byte_chunk([]), None, None)
		net::WriteFailed(count, error) => net::WriteFailed(count, error)
		net::Written(_) => provider::update(cell, bytes, write_step)
	end
end

fn close(cell: provider::State<State>, stream: net::Stream) -> Result<(), net::NetError> effects [concurrency, net, time]
	let mode = match snapshot(cell)
		State(_, _, _, selected, _, _, _, _, _) => selected
	end
	let result: Result<(), net::NetError> = prelude_builtin::net_system_close_stream(stream)
	if mode == "plain-close-failure"
		match result
			Ok(()) => Ok(())
			Err(net::NetError(operation, network, address, kind, message)) => Err(net::NetError(operation, network, address, kind, message))
		end
	else
		result
	end
end

pub handler operations(cell: provider::State<State>) for net::IO effects [net, time, concurrency]
	resolve(address) => prelude_builtin::net_system_resolve(address)
	listen(address) => prelude_builtin::net_system_listen(address)
	connect(address, deadline, token) => prelude_builtin::net_system_connect(address, deadline, token)
	accept(listener, deadline, token) => prelude_builtin::net_system_accept(listener, deadline, token)
	listener_address(listener) => prelude_builtin::net_system_listener_address(listener)
	close_listener(listener) => prelude_builtin::net_system_close_listener(listener)
	read(stream, deadline, token) => prelude_builtin::net_system_read(stream, deadline, token)
	read_bounded(stream, maximum, deadline, token) => read(cell, stream, maximum)
	write(stream, bytes, deadline, token) => write(cell, stream, bytes)
	local_address(stream) => prelude_builtin::net_system_local_address(stream)
	peer_address(stream) => prelude_builtin::net_system_peer_address(stream)
	shutdown_read(stream) => prelude_builtin::net_system_shutdown_read(stream)
	shutdown_write(stream) => prelude_builtin::net_system_shutdown_write(stream)
	close_stream(stream) => close(cell, stream)
end

fn reply(status: String, value: String, ownership: Int) -> {status: String, value: String, local: String, peer: String, bytes: ByteChunk, resolved_endpoints: List<{network: String, address: String}>, bytes_committed: Int, category: String, phase: String, input_committed: Int, output_committed: Int, ownership_committed: Int, cause: String}
	{status: status, value: value, local: "192.0.2.2:5000", peer: "192.0.2.1:443", bytes: byte_chunk([]), resolved_endpoints: Cons({network: "tcp4", address: "192.0.2.1"}, Nil), bytes_committed: 0, category: "other", phase: "during_operation", input_committed: 0, output_committed: 0, ownership_committed: ownership, cause: "selected close failure"}
end

fn close_step(state: State, ignored: ()) -> {state: State, result: {status: String, value: String, local: String, peer: String, bytes: ByteChunk, resolved_endpoints: List<{network: String, address: String}>, bytes_committed: Int, category: String, phase: String, input_committed: Int, output_committed: Int, ownership_committed: Int, cause: String}}
	match state
		State(input, output, events, mode, commit, actual, closes, live, releases) => begin
			let failing = (mode == "close-failure" or mode == "plain-close-failure") and closes == 0
			let release = not failing or actual
			{state: State(input, output, Cons(Event::Close, events), mode, commit, actual, closes + 1, live and not release, releases + (if live and release
				1
			else
				0
			end)), result: reply(if failing
				"error"
			else
				"ok"
			end, "", if failing
				commit
			else
				1
			end)}
		end
	end
end

pub handler allocation(cell: provider::State<State>) for host_effects::Network effects [concurrency]
	request(operation, subject, bytes, remaining_ms, cancelled) => if operation == "close_stream"
		provider::update(cell, (), close_step)
	else if operation == "resolve_tcp4"
		reply("ok", "", 0)
	else if operation == "connect"
		reply("ok", "adapter-stream", 0)
	else if operation == "stream_local_addr"
		reply("ok", "192.0.2.2:5000", 0)
	else if operation == "stream_peer_addr"
		reply("ok", "192.0.2.1:443", 0)
	else
		reply("error", "", 0)
	end
end

fn unchanged(state: State, ignored: ()) -> {state: State, result: State}
	{state: state, result: state}
end

pub fn snapshot(cell: provider::State<State>) -> State effects [concurrency]
	provider::update(cell, (), unchanged)
end

pub fn connect() -> Result<net::Stream, String> effects [net::IO]
	match net::connect(net::Address(net::Tcp4, "adapter.test", 443))
		Ok(value) => Ok(value)
		Err(_) => Err("network adapter fixture did not connect")
	end
end

pub fn bind(stream: net::Stream) -> Result<{reader: io::Reader, writer: io::Writer, closer: io::Closer}, String> effects [net::IO, provider::Scope, concurrency]
	match provider::network(stream)
		Ok(value) => Ok(value)
		Err(error) => Err(error.message)
	end
end

pub fn error(message: String) -> io::Error
	{operation: "network-conformance", kind: io::ErrorKind::Other, path: None, other_path: None, network: None, commit: None, message: message}
end

pub fn count(raw: Int) -> Result<ByteCount, io::Error>
	match byte_count(raw)
		Ok(value) => Ok(value)
		Err(message) => Err(error(message))
	end
end

pub fn bytes(text: String) -> Result<ByteChunk, io::Error>
	match byte_chunk_from_visible_ascii_string(text)
		Ok(value) => Ok(value)
		Err(message) => Err(error(message))
	end
end

pub fn text(bytes: ByteChunk) -> Result<String, io::Error>
	match byte_chunk_to_visible_ascii_string(bytes)
		Ok(value) => Ok(value)
		Err(message) => Err(error(message))
	end
end

fn bridge(cell: provider::State<State>, body: fn({reader: io::Reader, writer: io::Writer, closer: io::Closer}) -> Result<(), io::Error> effects [io::Read, io::Write, io::Close, provider::Scope, net::IO, concurrency, net, time]) -> Result<(), io::Error> effects [net::IO, concurrency, net, time]
	let stream: net::Stream = match net::connect(net::Address(net::Tcp4, "adapter.test", 443))
		Ok(value) => Ok(value)
		Err(_) => Err(error("fixture connection failed"))
	end?
	provider::with_network(stream, body)
end

pub fn run(cell: provider::State<State>, body: fn({reader: io::Reader, writer: io::Writer, closer: io::Closer}) -> Result<(), io::Error> effects [io::Read, io::Write, io::Close, provider::Scope, net::IO, concurrency, net, time]) -> Result<(), String> effects [net, time, concurrency]
	match handle handle bridge(cell, body) with operations(cell) with allocation(cell)
		Ok(()) => Ok(())
		Err(error) => Err(error.message)
	end
end
