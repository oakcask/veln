use prelude
use fs
use io

pub handler filesystem_read(calls: Sender<String>) for fs::Read effects [concurrency]
	open_read(filesystem, path) => begin
		let _ = channel::send(calls, "open_read")
		Err(io::Error::Error("open_read", io::ErrorKind::Unsupported, None, Some(path), None, None, "fake namespace handler does not open resources"))
	end
	metadata(filesystem, path, follow) => begin
		let _ = channel::send(calls, "metadata")
		Err(io::Error::Error("metadata", io::ErrorKind::Unsupported, None, Some(path), None, None, "fake namespace handler does not provide metadata"))
	end
	entries(filesystem, path) => begin
		let _ = channel::send(calls, "entries")
		Err(io::Error::Error("entries", io::ErrorKind::Unsupported, None, Some(path), None, None, "fake namespace handler does not enumerate directories"))
	end
end

pub handler read(calls: Sender<String>) for io::Read effects [concurrency]
	read(reader, maximum) => begin
		let _ = channel::send(calls, "read")
		io::ReadOutcome::End
	end
end

pub handler write(calls: Sender<String>) for io::Write effects [concurrency]
	write(writer, chunk) => begin
		let _ = channel::send(calls, "write")
		io::WriteOutcome::Written(byte_chunk_count(chunk))
	end
end

pub handler seek(calls: Sender<String>) for io::Seek effects [concurrency]
	seek(seeker, origin) => begin
		let _ = channel::send(calls, "seek")
		match origin
			io::SeekOrigin::Start(offset) => Ok(offset)
			_ => Err(io::Error::Error("seek", io::ErrorKind::Unsupported, None, None, None, None, "fake seek supports only absolute offsets"))
		end
	end
end

pub handler read_at(calls: Sender<String>) for io::ReadAt effects [concurrency]
	read_at(reader, offset, maximum) => begin
		let _ = channel::send(calls, "read_at")
		io::ReadOutcome::End
	end
end

pub handler write_at(calls: Sender<String>) for io::WriteAt effects [concurrency]
	write_at(writer, offset, chunk) => begin
		let _ = channel::send(calls, "write_at")
		io::WriteOutcome::Written(byte_chunk_count(chunk))
	end
end

pub handler close(calls: Sender<String>) for io::Close effects [concurrency]
	close(closer) => begin
		let _ = channel::send(calls, "close")
		io::CloseOutcome::Closed
	end
end


pub handler sync(calls: Sender<String>) for io::Sync effects [concurrency]
	sync(syncer) => begin
		let _ = channel::send(calls, "sync")
		Ok(())
	end
end

fn unsupported(operation: String) -> io::Error
	io::Error::Error(operation, io::ErrorKind::Unsupported, None, None, None, None, "fake mutation handler does not open resources")
end

pub handler mutate(calls: Sender<String>) for fs::Mutate effects [concurrency]
	open_write(filesystem, path, mode) => begin
		let _ = channel::send(calls, "open_write")
		Err(unsupported("open_write"))
	end
	open_read_write(filesystem, path, mode) => begin
		let _ = channel::send(calls, "open_read_write")
		Err(unsupported("open_read_write"))
	end
	open_append(filesystem, path, create) => begin
		let _ = channel::send(calls, "open_append")
		Err(unsupported("open_append"))
	end
	create_directory(filesystem, path) => begin
		let _ = channel::send(calls, "create_directory")
		fs::MutationOutcome::Applied
	end
	remove_file(filesystem, path) => begin
		let _ = channel::send(calls, "remove_file")
		fs::MutationOutcome::Applied
	end
	remove_directory(filesystem, path) => begin
		let _ = channel::send(calls, "remove_directory")
		fs::MutationOutcome::Applied
	end
	rename(filesystem, from_path, to_path) => begin
		let _ = channel::send(calls, "rename")
		fs::MutationOutcome::Applied
	end
	truncate(file, size) => begin
		let _ = channel::send(calls, "truncate")
		fs::MutationOutcome::Applied
	end
end
