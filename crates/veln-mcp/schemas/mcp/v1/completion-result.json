{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "code": { "enum": ["invalid_path", "invalid_position", "snapshot_changed"] },
        "message": { "type": "string" },
        "details": { "type": "object" }
      },
      "required": ["code", "message", "details"]
    }
  },
  "type": "object",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "label": { "type": "string", "minLength": 1 },
              "kind": { "enum": ["modifier", "builtin_local", "function", "type", "constructor"] },
              "detail": { "type": "string" },
              "qualifier": { "type": "string", "minLength": 1 },
              "package": { "type": ["string", "null"] },
              "module": { "type": "string", "minLength": 1 }
            },
            "required": ["label", "kind", "detail"],
            "allOf": [
              {
                "if": { "properties": { "kind": { "enum": ["modifier", "builtin_local"] } } },
                "then": { "properties": { "label": { "const": "callsite" } } },
                "else": { "required": ["qualifier", "package", "module"] }
              }
            ]
          }
        }
      },
      "required": ["items"]
    },
    { "$ref": "#/$defs/failure" }
  ]
}
