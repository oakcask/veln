{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "position": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "line": { "type": "integer", "minimum": 1 },
        "column": { "type": "integer", "minimum": 1 }
      },
      "required": ["line", "column"]
    },
    "range": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "start": { "$ref": "#/$defs/position" },
        "end": { "$ref": "#/$defs/position" }
      },
      "required": ["start", "end"]
    },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "uri": { "type": "string" },
        "range": { "$ref": "#/$defs/range" }
      },
      "required": ["uri", "range"]
    },
    "scope": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": { "const": "project" },
            "project": { "type": "string" }
          },
          "required": ["mode", "project"]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": { "const": "single_file" },
            "source": { "type": "string" }
          },
          "required": ["mode", "source"]
        }
      ]
    },
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "code": { "enum": ["invalid_path", "invalid_position", "snapshot_changed", "invalid_cursor", "stale_snapshot"] },
        "message": { "type": "string" },
        "details": { "type": "object" }
      },
      "required": ["code", "message", "details"]
    }
  },
  "type": "object",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "references": { "type": "array", "items": { "$ref": "#/$defs/location" } },
        "scope": { "$ref": "#/$defs/scope" },
        "project_wide": { "type": "boolean" },
        "cursor": { "oneOf": [{ "type": "string" }, { "type": "null" }] }
      },
      "required": ["references", "scope", "project_wide", "cursor"]
    },
    { "$ref": "#/$defs/failure" }
  ]
}
