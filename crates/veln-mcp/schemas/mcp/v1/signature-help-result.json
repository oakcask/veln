{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "code": { "enum": ["invalid_path", "invalid_position", "snapshot_changed"] },
        "message": { "type": "string" },
        "details": { "type": "object" }
      },
      "required": ["code", "message", "details"]
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "label": { "type": "string" },
        "parameters": { "type": "array", "items": { "type": "string" } },
        "activeParameter": { "type": "integer", "minimum": 0 }
      },
      "required": ["label", "parameters", "activeParameter"]
    }
  },
  "type": "object",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "signature": { "oneOf": [{ "$ref": "#/$defs/signature" }, { "type": "null" }] }
      },
      "required": ["signature"]
    },
    { "$ref": "#/$defs/failure" }
  ]
}
