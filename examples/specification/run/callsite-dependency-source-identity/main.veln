use alpha_wrapper
use beta_wrapper

fn print_location(location: SourceLocation) -> () effects [stdio]
	stdio::println(location.package)
	stdio::println(location.module)
	stdio::println(location.file)
	stdio::println(int_to_string(location.start_line))
	stdio::println(int_to_string(location.start_column))
	stdio::println(int_to_string(location.start_offset))
	stdio::println(int_to_string(location.end_line))
	stdio::println(int_to_string(location.end_column))
	stdio::println(int_to_string(location.end_offset))
end

pub fn main() -> () effects [stdio]
	print_location(alpha_wrapper::from_alpha())
	print_location(beta_wrapper::from_beta())
end
