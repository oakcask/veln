use http2::hpack::diagnostic from "std"
# HPACK fixture helpers return string-length RuntimeDiagnostic payloads.
fn invalid_payload(error: String) -> RuntimeDiagnostic
	RuntimeDiagnostic(
		"hpack.fixture.malformed_string_length",
		error,
		RuntimeHpackFixtureDiagnostic(9, 0, -1, "fixture HPACK string length", "hpack_fixture", byte_chunk([]))
	)
end

fn preview_view() -> Result<ByteView, RuntimeDiagnostic>
	match byte_chunk_from_hex("04ff")
		Ok(block) => match byte_offset(0)
			Ok(offset) => match byte_view(block, offset, byte_chunk_count(block))
				Ok(view) => Ok(view)
				Err(error) => Err(invalid_payload(error))
			end
			Err(error) => Err(invalid_payload(error))
		end
		Err(error) => Err(invalid_payload(error))
	end
end

pub fn main() -> Result<(), RuntimeDiagnostic>
	let preview: ByteView = preview_view()?
	http2::hpack::diagnostic::malformed_string_length(9, 2, 4, "fixture HPACK string length", "hpack_fixture", preview)
end
