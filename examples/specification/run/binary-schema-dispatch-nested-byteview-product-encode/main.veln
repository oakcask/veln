# Nested dispatch payload encode accepts ByteView product lengths.
use stdio

schema ProductPayload
	format binary

	row_count: UInt8
	column_count: UInt8
	payload: ByteView(row_count * column_count)
end

schema ClosedProductWritePacket
	format binary

	kind: UInt8
	payload: Dispatch(kind, 1 => ProductPayload)
end

schema ExtensionProductWritePacket
	format binary

	length: UInt8
	kind: UInt8
	payload: ExtensionDispatch(kind, length, 1 => ProductPayload)
end



fn emit_output_chunk(name: String, index: Int, chunk: ByteChunk, expected_hex: String) -> () effects [stdio]
	stdio::print("output_chunk ")
	stdio::print(name)
	stdio::print(" index ")
	stdio::print(int_to_string(index))
	stdio::print(" hex \"")
	stdio::print(expected_hex)
	stdio::print("\" count ")
	stdio::println(int_to_string(byte_count_to_int(byte_chunk_count(chunk))))
end

fn emit_output_chunk_list_header(name: String, count: Int) -> () effects [stdio]
	stdio::print("output_chunk_list ")
	stdio::print(name)
	stdio::print(" count ")
	stdio::println(int_to_string(count))
end

fn emit_encoded_chunk(name: String, bytes: ByteChunk, expected_hex: String) -> () effects [stdio]
	emit_output_chunk_list_header(name, 1)
	emit_output_chunk(name, 0, bytes, expected_hex)
end

fn emit_encoded_result(name: String, encoded: Result<ByteChunk, EncodeError>, expected_hex: String) -> () effects [stdio]
	match encoded
		Ok(bytes) => emit_encoded_chunk(name, bytes, expected_hex)
		Err(_) => stdio::println("unexpected encode failure")
	end
end

fn emit_encoded_step(name: String, encoded: EncodeStep<()>, expected_hex: String) -> () effects [stdio]
	match encoded
		Encoded(Cons(chunk, Nil)) => emit_encoded_chunk(name, chunk, expected_hex)
		Encoded(_) => stdio::println("unexpected encoded chunk count")
		Partial(_, _, _) => stdio::println("unexpected partial encode")
		Invalid(_) => stdio::println("unexpected encode failure")
	end
end

fn encode_result_step(encoded: Result<ByteChunk, EncodeError>) -> EncodeStep<()>
	match encoded
		Ok(chunk) => Encoded(list_cons(chunk, list_nil()))
		Err(error) => Invalid(error)
	end
end

pub fn main() -> Result<(), String> effects [stdio]
	let payload_bytes = byte_chunk_from_hex("aabbccddeeff")?
	let payload_view = byte_view(payload_bytes, byte_offset(0)?, byte_count(6)?)?
	let payload = {row_count: 2, column_count: 3, payload: payload_view}

	let closed = byte_encode_closed_product_write_packet({kind: 1, payload: payload})
	emit_encoded_result("closed-product-nested", closed, "010203aabbccddeeff")

	let extension = byte_encode_extension_product_write_packet({length: 8, kind: 1, payload: Known(payload)})
	emit_encoded_result("extension-product-nested", extension, "08010203aabbccddeeff")

	let closed_codec = encode_result_step(encode ClosedProductWritePacket from {kind: 1, payload: payload})
	emit_encoded_step("codec-closed-product-nested", closed_codec, "010203aabbccddeeff")

	let extension_codec = encode_result_step(encode ExtensionProductWritePacket from {length: 8, kind: 1, payload: Known(payload)})
	emit_encoded_step("codec-extension-product-nested", extension_codec, "08010203aabbccddeeff")
	Ok(())
end
