use http2::connection from "std"
use http2::core from "std"
use http2::hpack from "std"
use transport::net from "std"
use stdio

fn accept_next(listener: NetListener) -> Result<NetStream, String> effects [net]
	match net::accept_or_end(listener)
		Some(stream) => Ok(stream)
		None => Err("missing stream")
	end
end

fn ascii_header(name: String, value: String) -> Result<HeaderField, String>
	Ok(http2::hpack::header_field(name, byte_chunk_from_visible_ascii_string(value)?))
end

fn response_headers() -> Result<HeaderList, String>
	Ok(http2::hpack::prepend_header_field(ascii_header(":status", "200")?, http2::hpack::prepend_header_field(ascii_header("content-length", "2")?, http2::hpack::empty_header_list())))
end

fn handler(event: Http2ApplicationEvent) -> Result<List<Http2ApplicationAction>, String>
	let stream_id = http2::core::application_event_stream_id(event)
	Ok(list_cons(Http2ApplicationAction::Http2SendResponseHeaders(stream_id, response_headers()?, false), list_cons(Http2ApplicationAction::Http2SendResponseData(stream_id, byte_chunk_from_visible_ascii_string("ok")?, true), list_nil())))
end

fn run_server(stream: NetStream, state: CoreConnectionState) -> Result<CoreConnectionState, Http2ApplicationBoundaryFailure> effects [net]
	handle http2::connection::drive_server_application(state, handler) with transport::net::net_stream(stream)
end

fn print_result(result: Result<CoreConnectionState, Http2ApplicationBoundaryFailure>) -> Result<(), String> effects [stdio]
	match result
		Ok(state) => print_success(state)
		Err(failure) => print_failure(failure)
	end
end

fn print_success(state: CoreConnectionState) -> Result<(), String> effects [stdio]
	stdio::print("accepted offset ")
	stdio::println(int_to_string(http2::core::connection_state_next_offset(state)))
	Ok(())
end

fn print_failure(failure: Http2ApplicationBoundaryFailure) -> Result<(), String> effects [stdio]
	stdio::print(http2::connection::application_failure_kind(failure))
	stdio::print(" ")
	stdio::println(http2::connection::application_failure_id(failure))
	Ok(())
end

pub fn main() -> Result<(), String> effects [net, stdio]
	let listener: NetListener = net::listen("127.0.0.1:0")
	let stream: NetStream = accept_next(listener)?
	let state: CoreConnectionState = http2::core::server_connection_state(0)?
	let _ = print_result(run_server(stream, state))?
	net::close_stream(stream)
	Ok(())
end
