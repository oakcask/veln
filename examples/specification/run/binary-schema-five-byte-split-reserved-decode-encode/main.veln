use stdio

schema FiveByteSplitReservedHeader
	format binary

	lead: UInt3
	guard: ReservedBits(10, 682)
	mode: UInt5
	gap: ReservedBits(17, 87381)
	tail: UInt5
end

fn encoded_value(chunk: ByteChunk) -> Result<Int, String>
	let view: ByteView = byte_view(chunk, byte_offset(0)?, byte_count(5)?)?
	byte_read_u40_be(view)
end

fn error_id(error: EncodeError) -> String
	match error
		EncodeError(id, _, _) => id
	end
end

fn error_path(error: EncodeError) -> String
	match error
		EncodeError(_, field_path, _) => field_path
	end
end

fn error_reason(error: EncodeError) -> String
	match error
		EncodeError(_, _, reason) => reason
	end
end

fn emit_error(error: EncodeError) -> () effects [stdio]
	stdio::println(error_id(error))
	stdio::println(error_path(error))
	stdio::println(error_reason(error))
end

fn emit_encoded_chunk(chunk: ByteChunk) -> Result<(), String> effects [stdio]
	stdio::println(int_to_string(encoded_value(chunk)?))
	Ok(())
end

fn emit_encode_result(encoded: Result<ByteChunk, EncodeError>) -> Result<(), String> effects [stdio]
	match encoded
		Ok(chunk) => emit_encoded_chunk(chunk)
		Err(_) => Ok(stdio::println("unexpected encode failure"))
	end
end

fn emit_encode_error(encoded: Result<ByteChunk, EncodeError>) -> () effects [stdio]
	match encoded
		Ok(_) => stdio::println("unexpected encode success")
		Err(error) => emit_error(error)
	end
end

pub fn main() -> Result<(), String> effects [stdio]
	let bytes: ByteChunk = byte_chunk_from_hex("b5546aaab6")?
	let view: ByteView = byte_view(bytes, byte_offset(0)?, byte_count(5)?)?
	let decoded: {lead: Int, mode: Int, tail: Int} = byte_decode_five_byte_split_reserved_header(view)?
	stdio::println(int_to_string(decoded.lead))
	stdio::println(int_to_string(decoded.mode))
	stdio::println(int_to_string(decoded.tail))

	let encoded: Result<ByteChunk, EncodeError> = byte_encode_five_byte_split_reserved_header({lead: 5, mode: 17, tail: 22})
	let ignored: () = emit_encode_result(encoded)?

	let rejected: Result<ByteChunk, EncodeError> = byte_encode_five_byte_split_reserved_header({lead: 5, mode: 32, tail: 22})
	emit_encode_error(rejected)
	Ok(())
end
