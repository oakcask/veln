use http2::diagnostic from "std"
# HTTP/2 continuation stream mismatch projects pending header-block context.
fn fallback_payload(error: String) -> RuntimeDiagnostic
	RuntimeDiagnostic(
		"http2.protocol.continuation_expected",
		error,
		RuntimeHttp2ProtocolContinuationExpectedDiagnostic(12, 9, 3, 1, 1, 0, "headers", 3, "rfc9113_continuation_sequence", byte_chunk([]))
	)
end

fn preview_view() -> Result<ByteView, RuntimeDiagnostic>
	match byte_chunk_from_hex("000000090000000003")
		Ok(bytes) => match byte_offset(0)
			Ok(offset) => match byte_view(bytes, offset, byte_chunk_count(bytes))
				Ok(view) => Ok(view)
				Err(error) => Err(fallback_payload(error))
			end
			Err(error) => Err(fallback_payload(error))
		end
		Err(error) => Err(fallback_payload(error))
	end
end

pub fn main() -> Result<(), RuntimeDiagnostic>
	let preview: ByteView = preview_view()?
	http2::diagnostic::protocol_continuation_expected(12, 9, 3, 1, 1, 0, "headers", 3, "rfc9113_continuation_sequence", preview)
end
