schema TwoBytePrefixReservedGroupHeader
	format binary

	prefix: ReservedBits(10, 682)
	high: UInt3
	low: UInt3
end

pub fn main() -> Result<{high: Int, low: Int}, String>
	let bytes: ByteChunk = byte_chunk_from_hex("abab")?
	let view: ByteView = byte_view(bytes, byte_offset(0)?, byte_count(2)?)?
	byte_decode_two_byte_prefix_reserved_group_header(view)
end
