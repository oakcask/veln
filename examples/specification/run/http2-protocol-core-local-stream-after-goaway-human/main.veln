# HTTP/2 local streams opened after GOAWAY project to human diagnostics.

type Http2ProtocolFailure
	StreamAfterGoaway(Int, Int, Int)
end

type Http2DiagnosticContext
	DiagnosticContext(String, String, String)
end

fn context_shutdown_state(context: Http2DiagnosticContext) -> String
	match context
		DiagnosticContext(shutdown_state, _, _) => shutdown_state
	end
end

fn context_endpoint_role(context: Http2DiagnosticContext) -> String
	match context
		DiagnosticContext(_, endpoint_role, _) => endpoint_role
	end
end

fn context_rule_provenance(context: Http2DiagnosticContext) -> String
	match context
		DiagnosticContext(_, _, rule_provenance) => rule_provenance
	end
end

fn stream_after_goaway_payload(offset: Int, stream_id: Int, last_stream_id: Int, context: Http2DiagnosticContext) -> RuntimeDiagnostic
	RuntimeDiagnostic(
		"http2.protocol.stream_after_goaway",
		"HTTP/2 stream opened after graceful shutdown at byte offset 0",
		RuntimeHttp2ProtocolStreamAfterGoawayDiagnostic(offset, stream_id, last_stream_id, context_shutdown_state(context), context_endpoint_role(context), context_rule_provenance(context))
	)
end

fn http2_protocol_diagnostic(failure: Http2ProtocolFailure, context: Http2DiagnosticContext) -> Result<(), RuntimeDiagnostic>
	match failure
		StreamAfterGoaway(offset, stream_id, last_stream_id) => Err(stream_after_goaway_payload(offset, stream_id, last_stream_id, context))
	end
end

pub fn main() -> Result<(), RuntimeDiagnostic>
	let context: Http2DiagnosticContext = DiagnosticContext("graceful_shutdown", "local", "goaway_last_stream_id")
	http2_protocol_diagnostic(StreamAfterGoaway(0, 7, 5), context)
end
