# Binary schema mapping arithmetic can use imported public Int converter operands.
use stdio
use helpers

type Packet
	Packet {adjusted: Int}
end

schema PacketWire
	format binary

	length: UInt8
	padding: UInt8

	map to Packet
		adjusted = helpers::add_one(length) + padding
end

pub fn main() -> Result<(), String> effects [stdio]
	let bytes: ByteChunk = byte_chunk_from_hex("0c02")?
	let offset: ByteOffset = byte_offset(0)?
	let count: ByteCount = byte_count(2)?
	let view: ByteView = byte_view(bytes, offset, count)?
	let packet: {adjusted: Int} = byte_decode_packet_wire(view)?
	stdio::println(int_to_string(packet.adjusted))
	Ok(())
end
