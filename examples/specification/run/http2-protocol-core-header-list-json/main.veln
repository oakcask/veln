# HTTP/2 header-list peer-limit failures project structured runtime details.

type Http2ProtocolFailure
	HeaderListSizeExceeded(Int, Int, Int, Int)
end

type Http2DiagnosticContext
	DiagnosticContext(Int, String, String)
end

fn context_allowed_header_list_size(context: Http2DiagnosticContext) -> Int
	match context
		DiagnosticContext(allowed_size, _, _) => allowed_size
	end
end

fn context_receive_limit_provenance(context: Http2DiagnosticContext) -> String
	match context
		DiagnosticContext(_, receive_limit_provenance, _) => receive_limit_provenance
	end
end

fn context_rule_provenance(context: Http2DiagnosticContext) -> String
	match context
		DiagnosticContext(_, _, rule_provenance) => rule_provenance
	end
end

fn http2_protocol_diagnostic(failure: Http2ProtocolFailure, context: Http2DiagnosticContext, preview: ByteView) -> Result<(), String>
	match failure
		HeaderListSizeExceeded(offset, observed_size, frame_kind, stream_id) => http2_peer_limit_header_list_size_exceeded(offset, observed_size, context_allowed_header_list_size(context), frame_kind, stream_id, context_receive_limit_provenance(context), context_rule_provenance(context), preview)
	end
end

pub fn main() -> Result<(), String>
	let context: Http2DiagnosticContext = DiagnosticContext(9, "local_configuration", "header_list_receive_limit")
	let preview_chunk: ByteChunk = byte_chunk_from_hex("060708090a0b0c0d0e")?
	let preview: ByteView = byte_view(preview_chunk, byte_offset(0)?, byte_chunk_count(preview_chunk))?
	http2_protocol_diagnostic(HeaderListSizeExceeded(12, 10, 9, 1), context, preview)
end
