# HTTP/2 idle-stream frame kind failures project structured runtime details.

schema Http2FrameHeaderWire
	format binary

	length: UInt24be
	kind: UInt8
	flags: UInt8
	stream_reserved: ReservedBits(1, 0)
	stream_id: UInt31be
end

type Http2ProtocolFailure
	InvalidFrameKind {offset: Int, actual_kind: Int, stream_id: Int, expected_kind: Int, preview: ByteView}
end

type Http2DiagnosticContext
	DiagnosticContext(String, String)
end

type Http2Step
	FrameOk(Int)
	Waiting
	Failed(Http2ProtocolFailure)
end

fn receive(bytes: ByteChunk) -> Result<Http2Step, String>
	let available: Int = byte_count_to_int(byte_chunk_count(bytes))
	match available < 9
		true => Ok(Waiting)
		false => decode_header(bytes)
	end
end

fn decode_header(bytes: ByteChunk) -> Result<Http2Step, String>
	let zero: ByteOffset = byte_offset(0)?
	let header_count: ByteCount = byte_count(9)?
	let view: ByteView = byte_view(bytes, zero, header_count)?
	let header: {length: Int, kind: Int, flags: Int, stream_id: Int} = byte_decode_http2_frame_header_wire(view)?
	validate_stream_frame_kind(0, header.kind, header.stream_id, view)
end

fn validate_stream_frame_kind(offset: Int, kind: Int, stream_id: Int, preview: ByteView) -> Result<Http2Step, String>
	match stream_id == 0
		true => Ok(FrameOk(kind))
		false => match kind == 1
			true => Ok(FrameOk(kind))
			false => Ok(Failed(InvalidFrameKind(offset, kind, stream_id, 1, preview)))
		end
	end
end

fn context_active_state(context: Http2DiagnosticContext) -> String
	match context
		DiagnosticContext(active_state, _) => active_state
	end
end

fn context_rule_provenance(context: Http2DiagnosticContext) -> String
	match context
		DiagnosticContext(_, rule_provenance) => rule_provenance
	end
end

fn invalid_payload(error: String) -> RuntimeDiagnostic
	RuntimeDiagnostic(
		"http2.protocol.invalid_frame_kind",
		error,
		RuntimeHttp2ProtocolInvalidFrameKindDiagnostic(0, 0, 1, 1, "idle-stream", "idle_streams_require_headers", byte_chunk([]))
	)
end

fn http2_protocol_diagnostic(failure: Http2ProtocolFailure, context: Http2DiagnosticContext) -> Result<(), RuntimeDiagnostic>
	match failure
		InvalidFrameKind(offset, actual_kind, stream_id, expected_kind, preview) => http2_protocol_invalid_frame_kind(offset, actual_kind, stream_id, expected_kind, context_active_state(context), context_rule_provenance(context), preview)
	end
end

fn input_bytes() -> Result<ByteChunk, RuntimeDiagnostic>
	match byte_chunk_from_hex("000000000000000001")
		Ok(bytes) => Ok(bytes)
		Err(error) => Err(invalid_payload(error))
	end
end

fn receive_step(bytes: ByteChunk) -> Result<Http2Step, RuntimeDiagnostic>
	match receive(bytes)
		Ok(step) => Ok(step)
		Err(error) => Err(invalid_payload(error))
	end
end

pub fn main() -> Result<(), RuntimeDiagnostic>
	let bytes: ByteChunk = input_bytes()?
	let step: Http2Step = receive_step(bytes)?
	let context: Http2DiagnosticContext = DiagnosticContext("idle-stream", "idle_streams_require_headers")
	match step
		Failed(failure) => http2_protocol_diagnostic(failure, context)
		FrameOk(_) => Ok(())
		Waiting => Ok(())
	end
end
