# Binary schema mapping can compose Bool fields with and, or, and not.
use stdio

type Packet
	Packet {active: Bool, safe_length: Bool, not_kind_two: Bool}
end

fn bool_text(value: Bool) -> String
	match value
		true => "true"
		false => "false"
	end
end

schema PacketWire
	format binary

	kind: UInt8
	flags: UInt8
	length: UInt8
	copy_length: UInt8

	map to Packet
		active = kind == 1 and flags != 0
		safe_length = length == copy_length or not (flags != 0)
		not_kind_two = not (kind == 2)
end

fn emit_packet(packet: {active: Bool, safe_length: Bool, not_kind_two: Bool}) -> () effects [stdio]
	stdio::println(bool_text(packet.active))
	stdio::println(bool_text(packet.safe_length))
	stdio::println(bool_text(packet.not_kind_two))
end

pub fn main() -> Result<(), String> effects [stdio]
	let first_bytes: ByteChunk = byte_chunk_from_hex("01010505")?
	let first_view: ByteView = byte_view(first_bytes, byte_offset(0)?, byte_count(4)?)?
	let first: {active: Bool, safe_length: Bool, not_kind_two: Bool} = byte_decode_packet_wire(first_view)?
	emit_packet(first)

	let second_bytes: ByteChunk = byte_chunk_from_hex("02000504")?
	let second_view: ByteView = byte_view(second_bytes, byte_offset(0)?, byte_count(4)?)?
	let second: {active: Bool, safe_length: Bool, not_kind_two: Bool} = byte_decode_packet_wire(second_view)?
	emit_packet(second)

	Ok(())
end
