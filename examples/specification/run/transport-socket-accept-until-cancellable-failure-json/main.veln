# Cancellable deadline-aware socket accept host failures stay runtime failures.
pub fn main() -> Result<(), String> effects [net, time]
	let listener: NetListener = net::listen("127.0.0.1:0")
	let deadline: Deadline = time::deadline_after_ms(100)
	let token: CancelToken = time::cancel_token()
	let outcome: AcceptOutcome = net::accept_until_cancellable(listener, deadline, token)
	Ok(())
end
