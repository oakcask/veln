# Nested dispatch payload encode accepts ByteView subtraction lengths.
use stdio

schema SubtractivePayload
	format binary

	left_length: UInt8
	right_length: UInt8
	payload: ByteView(left_length - right_length)
end

schema ClosedSubtractiveWritePacket
	format binary

	kind: UInt8
	payload: Dispatch(kind, 1 => SubtractivePayload)
end

schema ExtensionSubtractiveWritePacket
	format binary

	length: UInt8
	kind: UInt8
	payload: ExtensionDispatch(kind, length, 1 => SubtractivePayload)
end



fn emit_output_chunk(name: String, index: Int, chunk: ByteChunk, expected_hex: String) -> () effects [stdio]
	stdio::print("output_chunk ")
	stdio::print(name)
	stdio::print(" index ")
	stdio::print(int_to_string(index))
	stdio::print(" hex \"")
	stdio::print(expected_hex)
	stdio::print("\" count ")
	stdio::println(int_to_string(byte_count_to_int(byte_chunk_count(chunk))))
end

fn emit_output_chunk_list_header(name: String, count: Int) -> () effects [stdio]
	stdio::print("output_chunk_list ")
	stdio::print(name)
	stdio::print(" count ")
	stdio::println(int_to_string(count))
end

fn emit_encoded_chunk(name: String, bytes: ByteChunk, expected_hex: String) -> () effects [stdio]
	emit_output_chunk_list_header(name, 1)
	emit_output_chunk(name, 0, bytes, expected_hex)
end

fn emit_encoded_result(name: String, encoded: Result<ByteChunk, EncodeError>, expected_hex: String) -> () effects [stdio]
	match encoded
		Ok(bytes) => emit_encoded_chunk(name, bytes, expected_hex)
		Err(_) => stdio::println("unexpected encode failure")
	end
end

fn emit_encoded_step(name: String, encoded: EncodeStep<()>, expected_hex: String) -> () effects [stdio]
	match encoded
		Encoded(Cons(chunk, Nil)) => emit_encoded_chunk(name, chunk, expected_hex)
		Encoded(_) => stdio::println("unexpected encoded chunk count")
		Partial(_, _, _) => stdio::println("unexpected partial encode")
		Invalid(_) => stdio::println("unexpected encode failure")
	end
end

fn encode_result_step(encoded: Result<ByteChunk, EncodeError>) -> EncodeStep<()>
	match encoded
		Ok(chunk) => Encoded(list_cons(chunk, list_nil()))
		Err(error) => Invalid(error)
	end
end

pub fn main() -> Result<(), String> effects [stdio]
	let payload_bytes = byte_chunk_from_hex("aabbcc")?
	let payload_view = byte_view(payload_bytes, byte_offset(0)?, byte_count(3)?)?
	let payload = {left_length: 5, right_length: 2, payload: payload_view}

	let closed = byte_encode_closed_subtractive_write_packet({kind: 1, payload: payload})
	emit_encoded_result("closed-subtractive-nested", closed, "010502aabbcc")

	let extension = byte_encode_extension_subtractive_write_packet({length: 5, kind: 1, payload: Known(payload)})
	emit_encoded_result("extension-subtractive-nested", extension, "05010502aabbcc")

	let closed_codec = encode_result_step(encode ClosedSubtractiveWritePacket from {kind: 1, payload: payload})
	emit_encoded_step("codec-closed-subtractive-nested", closed_codec, "010502aabbcc")

	let extension_codec = encode_result_step(encode ExtensionSubtractiveWritePacket from {length: 5, kind: 1, payload: Known(payload)})
	emit_encoded_step("codec-extension-subtractive-nested", extension_codec, "05010502aabbcc")
	Ok(())
end
