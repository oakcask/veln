use http2::diagnostic from "std"
# HTTP/2 PRIORITY self-dependency failures project structured runtime details.

type Http2ProtocolFailure
	InvalidPriorityDependency(Int, Int, Int, ByteView)
end

type Http2DiagnosticContext
	DiagnosticContext(String, String)
end

fn context_active_state(context: Http2DiagnosticContext) -> String
	match context
		DiagnosticContext(active_state, _) => active_state
	end
end

fn context_rule_provenance(context: Http2DiagnosticContext) -> String
	match context
		DiagnosticContext(_, rule_provenance) => rule_provenance
	end
end

fn invalid_payload(error: String) -> RuntimeDiagnostic
	RuntimeDiagnostic(
		"http2.protocol.invalid_priority_dependency",
		error,
		RuntimeHttp2ProtocolPriorityDependencyDiagnostic(0, 1, 1, "stream-control", "rfc9113_priority_dependency", byte_chunk([]))
	)
end

fn priority_dependency_payload(offset: Int, stream_id: Int, dependency_stream_id: Int, context: Http2DiagnosticContext, preview: ByteView) -> RuntimeDiagnostic
	RuntimeDiagnostic(
		"http2.protocol.invalid_priority_dependency",
		"HTTP/2 invalid PRIORITY dependency at byte offset 0",
		RuntimeHttp2ProtocolPriorityDependencyDiagnostic(offset, stream_id, dependency_stream_id, context_active_state(context), context_rule_provenance(context), byte_view_to_chunk(preview))
	)
end

fn http2_protocol_diagnostic(failure: Http2ProtocolFailure, context: Http2DiagnosticContext) -> Result<(), RuntimeDiagnostic>
	match failure
		InvalidPriorityDependency(offset, stream_id, dependency_stream_id, preview) => Err(priority_dependency_payload(offset, stream_id, dependency_stream_id, context, preview))
	end
end

fn preview_bytes() -> Result<ByteChunk, RuntimeDiagnostic>
	match byte_chunk_from_hex("000000010f")
		Ok(bytes) => Ok(bytes)
		Err(error) => Err(invalid_payload(error))
	end
end

fn preview_view(bytes: ByteChunk) -> Result<ByteView, RuntimeDiagnostic>
	match byte_offset(0)
		Ok(offset) => match byte_count(5)
			Ok(count) => match byte_view(bytes, offset, count)
				Ok(view) => Ok(view)
				Err(error) => Err(invalid_payload(error))
			end
			Err(error) => Err(invalid_payload(error))
		end
		Err(error) => Err(invalid_payload(error))
	end
end

pub fn main() -> Result<(), RuntimeDiagnostic>
	let context: Http2DiagnosticContext = DiagnosticContext("stream-control", "rfc9113_priority_dependency")
	let bytes: ByteChunk = preview_bytes()?
	let preview: ByteView = preview_view(bytes)?
	http2_protocol_diagnostic(InvalidPriorityDependency(0, 1, 1, preview), context)
end
