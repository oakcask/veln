# HTTP/2 PRIORITY self-dependency failures project structured runtime details.

type Http2ProtocolFailure
	InvalidPriorityDependency(Int, Int, Int)
end

type Http2DiagnosticContext
	DiagnosticContext(String, String)
end

fn context_active_state(context: Http2DiagnosticContext) -> String
	match context
		DiagnosticContext(active_state, _) => active_state
	end
end

fn context_rule_provenance(context: Http2DiagnosticContext) -> String
	match context
		DiagnosticContext(_, rule_provenance) => rule_provenance
	end
end

fn http2_protocol_diagnostic(failure: Http2ProtocolFailure, context: Http2DiagnosticContext) -> Result<(), String>
	match failure
		InvalidPriorityDependency(offset, stream_id, dependency_stream_id) => http2_protocol_invalid_priority_dependency(offset, stream_id, dependency_stream_id, context_active_state(context), context_rule_provenance(context))
	end
end

pub fn main() -> Result<(), String>
	let context: Http2DiagnosticContext = DiagnosticContext("stream-control", "rfc9113_priority_dependency")
	http2_protocol_diagnostic(InvalidPriorityDependency(0, 1, 1), context)
end
