schema ThreeBytePrefixReservedGroupHeader
	format binary

	prefix: ReservedBits(9, 341)
	high: UInt8
	low: UInt7
end

pub fn main() -> Result<{high: Int, low: Int}, String>
	let bytes: ByteChunk = byte_chunk_from_hex("abd5aa")?
	let view: ByteView = byte_view(bytes, byte_offset(0)?, byte_count(3)?)?
	byte_decode_three_byte_prefix_reserved_group_header(view)
end
