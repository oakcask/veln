use stdio

type LowWidthPrefixHeader
	LowWidthPrefixHeader {target_high: Int, target_low: Int}
end

schema LowWidthPrefixReservedTwoByteHeader
	format binary

	prefix: ReservedBits(1, 1)
	high: UInt7
	low: UInt8

	map to LowWidthPrefixHeader
		target_high = high
		target_low = low
end

fn encoded_value(chunk: ByteChunk) -> Result<Int, String>
	let view: ByteView = byte_view(chunk, byte_offset(0)?, byte_count(2)?)?
	byte_read_u16_be(view)
end

fn error_id(error: EncodeError) -> String
	match error
		EncodeError(id, _, _) => id
	end
end

fn error_path(error: EncodeError) -> String
	match error
		EncodeError(_, field_path, _) => field_path
	end
end

fn error_reason(error: EncodeError) -> String
	match error
		EncodeError(_, _, reason) => reason
	end
end

fn emit_error(error: EncodeError) -> () effects [stdio]
	stdio::println(error_id(error))
	stdio::println(error_path(error))
	stdio::println(error_reason(error))
end

fn emit_encoded_chunk(chunk: ByteChunk) -> Result<(), String> effects [stdio]
	stdio::println(int_to_string(encoded_value(chunk)?))
	Ok(())
end

fn emit_unexpected_encode_failure() -> Result<(), String> effects [stdio]
	stdio::println("unexpected encode failure")
	Ok(())
end

fn emit_encoded(encoded: Result<ByteChunk, EncodeError>) -> Result<(), String> effects [stdio]
	match encoded
		Ok(chunk) => emit_encoded_chunk(chunk)
		Err(_) => emit_unexpected_encode_failure()
	end
end

fn emit_encode_error(encoded: Result<ByteChunk, EncodeError>) -> () effects [stdio]
	match encoded
		Ok(_) => stdio::println("unexpected encode success")
		Err(error) => emit_error(error)
	end
end

pub fn main() -> Result<(), String> effects [stdio]
	let bytes: ByteChunk = byte_chunk_from_hex("d5ab")?
	let view: ByteView = byte_view(bytes, byte_offset(0)?, byte_count(2)?)?
	let decoded: {target_high: Int, target_low: Int} = byte_decode_low_width_prefix_reserved_two_byte_header(view)?
	stdio::println(int_to_string(decoded.target_high))
	stdio::println(int_to_string(decoded.target_low))

	let encoded: Result<ByteChunk, EncodeError> = byte_encode_low_width_prefix_reserved_two_byte_header({target_high: 85, target_low: 171})
	let ignored: () = emit_encoded(encoded)?

	let rejected_high: Result<ByteChunk, EncodeError> = byte_encode_low_width_prefix_reserved_two_byte_header({target_high: 128, target_low: 171})
	emit_encode_error(rejected_high)

	let rejected_low: Result<ByteChunk, EncodeError> = byte_encode_low_width_prefix_reserved_two_byte_header({target_high: 85, target_low: 256})
	emit_encode_error(rejected_low)
	Ok(())
end
