use stdio

schema PackedWidthOneHeader
	format binary

	prefix: UInt8
	control_reserved: ReservedBits(1, 1)
	control: UInt7
	suffix: UInt8
end

schema PackedWidthTwoHeader
	format binary

	prefix: UInt8
	control_reserved: ReservedBits(2, 2)
	control: UInt6
	suffix: UInt8
end

schema PackedWidthThreeHeader
	format binary

	prefix: UInt8
	control_reserved: ReservedBits(3, 5)
	control: UInt5
	suffix: UInt8
end

schema PackedWidthFourHeader
	format binary

	prefix: UInt8
	control_reserved: ReservedBits(4, 9)
	control: UInt4
	suffix: UInt8
end

schema PackedWidthFiveHeader
	format binary

	prefix: UInt8
	control_reserved: ReservedBits(5, 17)
	control: UInt3
	suffix: UInt8
end

schema PackedWidthSixHeader
	format binary

	prefix: UInt8
	control_reserved: ReservedBits(6, 21)
	control: UInt2
	suffix: UInt8
end

schema PackedWidthSevenHeader
	format binary

	prefix: UInt8
	control_reserved: ReservedBits(7, 85)
	control: UInt1
	suffix: UInt8
end

schema PackedWidthNineHeader
	format binary

	prefix: UInt8
	control_reserved: ReservedBits(9, 341)
	control: UInt7
	suffix: UInt8
end

schema PackedWidthTenHeader
	format binary

	prefix: UInt8
	control_reserved: ReservedBits(10, 677)
	control: UInt6
	suffix: UInt8
end

schema PackedWidthElevenHeader
	format binary

	prefix: UInt8
	control_reserved: ReservedBits(11, 1365)
	control: UInt5
	suffix: UInt8
end

schema PackedWidthTwelveHeader
	format binary

	prefix: UInt8
	control_reserved: ReservedBits(12, 2650)
	control: UInt4
	suffix: UInt8
end

schema PackedWidthThirteenHeader
	format binary

	prefix: UInt8
	control_reserved: ReservedBits(13, 5457)
	control: UInt3
	suffix: UInt8
end

schema PackedWidthFourteenHeader
	format binary

	prefix: UInt8
	control_reserved: ReservedBits(14, 10901)
	control: UInt2
	suffix: UInt8
end

schema PackedWidthFifteenHeader
	format binary

	prefix: UInt8
	control_reserved: ReservedBits(15, 21845)
	control: UInt1
	suffix: UInt8
end

fn emit_output_chunk(name: String, index: Int, chunk: ByteChunk, expected_hex: String) -> () effects [stdio]
	stdio::print("output_chunk ")
	stdio::print(name)
	stdio::print(" index ")
	stdio::print(int_to_string(index))
	stdio::print(" hex \"")
	stdio::print(expected_hex)
	stdio::print("\" count ")
	stdio::println(int_to_string(byte_count_to_int(byte_chunk_count(chunk))))
end

fn emit_output_chunk_list_header(name: String, count: Int) -> () effects [stdio]
	stdio::print("output_chunk_list ")
	stdio::print(name)
	stdio::print(" count ")
	stdio::println(int_to_string(count))
end

fn emit_encoded_chunk(name: String, bytes: ByteChunk, expected_hex: String) -> () effects [stdio]
	emit_output_chunk_list_header(name, 1)
	emit_output_chunk(name, 0, bytes, expected_hex)
end

fn emit_encoded(name: String, encoded: Result<ByteChunk, EncodeError>, expected_hex: String) -> () effects [stdio]
	match encoded
		Ok(bytes) => emit_encoded_chunk(name, bytes, expected_hex)
		Err(_) => stdio::println("unexpected encode failure")
	end
end

pub fn main() -> () effects [stdio]
	let one = byte_encode_packed_width_one_header({prefix: 18, control: 42, suffix: 52})
	emit_encoded("packed-width-1", one, "12aa34")

	let two = byte_encode_packed_width_two_header({prefix: 18, control: 17, suffix: 52})
	emit_encoded("packed-width-2", two, "129134")

	let three = byte_encode_packed_width_three_header({prefix: 18, control: 18, suffix: 52})
	emit_encoded("packed-width-3", three, "12b234")

	let four = byte_encode_packed_width_four_header({prefix: 18, control: 7, suffix: 52})
	emit_encoded("packed-width-4", four, "129734")

	let five = byte_encode_packed_width_five_header({prefix: 18, control: 3, suffix: 52})
	emit_encoded("packed-width-5", five, "128b34")

	let six = byte_encode_packed_width_six_header({prefix: 18, control: 2, suffix: 52})
	emit_encoded("packed-width-6", six, "125634")

	let seven = byte_encode_packed_width_seven_header({prefix: 18, control: 1, suffix: 52})
	emit_encoded("packed-width-7", seven, "12ab34")

	let nine = byte_encode_packed_width_nine_header({prefix: 18, control: 42, suffix: 52})
	emit_encoded("packed-width-9", nine, "12aaaa34")

	let ten = byte_encode_packed_width_ten_header({prefix: 18, control: 17, suffix: 52})
	emit_encoded("packed-width-10", ten, "12a95134")

	let eleven = byte_encode_packed_width_eleven_header({prefix: 18, control: 18, suffix: 52})
	emit_encoded("packed-width-11", eleven, "12aab234")

	let twelve = byte_encode_packed_width_twelve_header({prefix: 18, control: 7, suffix: 52})
	emit_encoded("packed-width-12", twelve, "12a5a734")

	let thirteen = byte_encode_packed_width_thirteen_header({prefix: 18, control: 3, suffix: 52})
	emit_encoded("packed-width-13", thirteen, "12aa8b34")

	let fourteen = byte_encode_packed_width_fourteen_header({prefix: 18, control: 2, suffix: 52})
	emit_encoded("packed-width-14", fourteen, "12aa5634")

	let fifteen = byte_encode_packed_width_fifteen_header({prefix: 18, control: 1, suffix: 52})
	emit_encoded("packed-width-15", fifteen, "12aaab34")
end
