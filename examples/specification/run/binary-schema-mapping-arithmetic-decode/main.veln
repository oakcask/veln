# Binary schema mapping can compute Int fields with decoded-field arithmetic.
use stdio

type Packet
	Packet {body_length: Int, padded_length: Int, scaled_length: Int}
end

schema PacketWire
	format binary

	length: UInt8
	padding: UInt8
	checksum: UInt8

	map to Packet
		body_length = length - 9
		padded_length = padding + 1
		scaled_length = (length - padding) * 2
end

pub fn main() -> Result<(), String> effects [stdio]
	let bytes: ByteChunk = byte_chunk_from_hex("0c0205")?
	let offset: ByteOffset = byte_offset(0)?
	let count: ByteCount = byte_count(3)?
	let view: ByteView = byte_view(bytes, offset, count)?
	let packet: {body_length: Int, padded_length: Int, scaled_length: Int} = byte_decode_packet_wire(view)?
	stdio::println(int_to_string(packet.body_length))
	stdio::println(int_to_string(packet.padded_length))
	stdio::println(int_to_string(packet.scaled_length))
	Ok(())
end
