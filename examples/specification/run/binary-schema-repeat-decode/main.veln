# Binary schema Repeat fields decode counted lowercase primitive lists.
use stdio

schema CountedValues
	format binary

	count: UInt8
	items: Repeat(count, uint16be)
end

fn list_count(items: List<Int>) -> Int
	match items
		Nil => 0
		Cons(_, tail) => 1 + list_count(tail)
	end
end

fn list_sum(items: List<Int>) -> Int
	match items
		Nil => 0
		Cons(head, tail) => head + list_sum(tail)
	end
end

fn emit_sample(sample: {count: Int, items: List<Int>}) -> () effects [stdio]
	stdio::print(int_to_string(sample.count))
	stdio::print(" ")
	stdio::print(int_to_string(list_count(sample.items)))
	stdio::print(" ")
	stdio::println(int_to_string(list_sum(sample.items)))
end

pub fn main() -> Result<(), String> effects [stdio]
	let bytes: ByteChunk = byte_chunk_from_hex("030001000200ff")?
	let offset: ByteOffset = byte_offset(0)?
	let count: ByteCount = byte_count(7)?
	let view: ByteView = byte_view(bytes, offset, count)?
	let sample: {count: Int, items: List<Int>} = byte_decode_counted_values(view)?
	emit_sample(sample)
	Ok(())
end
