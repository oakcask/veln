# Binary schema UInt56be and UInt56le primitives decode ordinary Int fields.
use stdio

type UInt56Widths
	UInt56Widths {big_number: Int, little_number: Int}
end

schema UInt56WidthsWire
	format binary

	big_value: UInt56be
	little_value: UInt56le

	map to UInt56Widths
		big_number = big_value
		little_number = little_value
end

fn emit_widths(widths: {big_number: Int, little_number: Int}) -> () effects [stdio]
	stdio::print(int_to_string(widths.big_number))
	stdio::print(" ")
	stdio::println(int_to_string(widths.little_number))
end

pub fn main() -> Result<(), String> effects [stdio]
	let bytes: ByteChunk = byte_chunk_from_hex("0102030405060707060504030201")?
	let offset: ByteOffset = byte_offset(0)?
	let count: ByteCount = byte_count(14)?
	let view: ByteView = byte_view(bytes, offset, count)?
	let decoded: {big_number: Int, little_number: Int} = byte_decode_uint56_widths_wire(view)?
	emit_widths(decoded)
	Ok(())
end
