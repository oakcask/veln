use fixture_effects
use fake_effects

# Deadline-aware accept after listener close stays a runtime transport failure.
fn fixture_body() -> Option<NetStream> effects [net, time]
	let listener: NetListener = net::listen("127.0.0.1:0")
	net::close_listener(listener)
	let deadline: Deadline = time::deadline_after_ms(5)
	net::accept_until(listener, deadline)
end

pub fn main() -> Option<NetStream> effects [concurrency, fs, net, time]
	let state = fixture_effects::create_fixture()
	handle handle fixture_body() with fake_effects::network(state) with fake_effects::clock(state)
end
