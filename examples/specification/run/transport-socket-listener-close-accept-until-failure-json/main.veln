use net from "std"
use fixture_effects
use fake_effects

# Deadline-aware accept after listener close stays a runtime transport failure.
fn fixture_body() -> Result<net::Stream, net::NetError> effects [net::IO, time]
	let listener: net::Listener = net::listen(net::Address(net::Tcp4, "127.0.0.1", 0))?
	let _ = net::close_listener(listener)?
	let deadline: Deadline = time::deadline_after_ms(5)
	net::accept_with(listener, Some(deadline), None)
end

pub fn main() -> Result<net::Stream, net::NetError> effects [concurrency, fs, net, time]
	let state = fixture_effects::create_fixture()
	handle handle handle fixture_body() with net::system() with fake_effects::network(state) with fake_effects::clock(state)
end
