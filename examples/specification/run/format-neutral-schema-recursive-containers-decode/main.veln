# Format-neutral schema decode helpers accept recursive container shapes.
use stdio

schema RecursiveContainerPacket
	maybe_items: List<Option<Int>>
	maybe_names: Option<List<Option<String>>>
	maybe_scores: Dict<String, Option<Int>>
	metadata: {maybe_items: List<Option<Int>>, maybe_names: Option<List<Option<String>>>, maybe_scores: Dict<String, Option<Int>>}
end

fn option_int_sum(items: List<Option<Int>>) -> Int
	match items
		Nil => 0
		Cons(head, tail) => match head
			Some(value) => value + option_int_sum(tail)
			None => option_int_sum(tail)
		end
	end
end

fn first_present_name(names: List<Option<String>>) -> String
	match names
		Nil => "missing"
		Cons(head, tail) => match head
			Some(name) => name
			None => first_present_name(tail)
		end
	end
end

fn optional_first_name(names: Option<List<Option<String>>>) -> String
	match names
		Some(values) => first_present_name(values)
		None => "missing-option"
	end
end

fn optional_score(scores: Dict<String, Option<Int>>, key: String) -> Int
	match dict_get(scores, key)
		Some(score) => match score
			Some(value) => value
			None => -1
		end
		None => -2
	end
end

pub fn main() -> Result<(), String> effects [stdio]
	let decoded = byte_decode_recursive_container_packet({maybe_items: list_cons(Some(2), list_cons(None, list_cons(Some(5), list_nil()))), maybe_names: Some(list_cons(None, list_cons(Some("alpha"), list_nil()))), maybe_scores: {"math": Some(11), "language": None}, metadata: {maybe_items: list_cons(Some(3), list_cons(Some(9), list_nil())), maybe_names: Some(list_cons(Some("nested-alpha"), list_nil())), maybe_scores: {"math": Some(17)}}})?
	stdio::println(int_to_string(option_int_sum(decoded.maybe_items)))
	stdio::println(optional_first_name(decoded.maybe_names))
	stdio::println(int_to_string(optional_score(decoded.maybe_scores, "math")))
	stdio::println(int_to_string(optional_score(decoded.maybe_scores, "language")))
	stdio::println(int_to_string(option_int_sum(decoded.metadata.maybe_items)))
	stdio::println(optional_first_name(decoded.metadata.maybe_names))
	stdio::println(int_to_string(optional_score(decoded.metadata.maybe_scores, "math")))
	Ok(())
end
