use hpack_fixture

fn fallback_payload(message: String) -> RuntimeDiagnostic
	RuntimeDiagnostic(
		"hpack.fixture.unsupported_header_block",
		message,
		RuntimeHpackFixtureDiagnostic(0, 0, -1, "fixture header block", "hpack_fixture", byte_chunk([]))
	)
end

fn project_decode_result(result: Result<HpackDecodeTransition, HpackFixtureFailure>) -> Result<(), RuntimeDiagnostic>
	match result
		Ok(_) => Err(fallback_payload("expected HPACK dynamic index lookup failure"))
		Err(error) => project_failure(error)
	end
end

fn fixture_bytes(text: String) -> Result<ByteChunk, RuntimeDiagnostic>
	match byte_chunk_from_hex(text)
		Ok(bytes) => Ok(bytes)
		Err(error) => Err(fallback_payload(error))
	end
end

pub fn main() -> Result<(), RuntimeDiagnostic>
	let bad_block: ByteChunk = fixture_bytes("be")?
	project_decode_result(decode_header_block(bad_block, initial_state(), 27))
end
