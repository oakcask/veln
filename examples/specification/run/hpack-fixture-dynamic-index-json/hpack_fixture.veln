use http2::hpack::diagnostic from "std"
pub type HpackDynamicEntry
	NoDynamicEntry
	DynamicEntry(name: String, value: String, older: HpackDynamicEntry)
end

pub type HpackFixtureState
	HpackFixtureState(table_size: Int, decode_count: Int, dynamic_entry: HpackDynamicEntry)
end

pub type HpackHeader
	HpackHeader(name: String, value: String)
end

pub type HpackHeaderList
	HpackHeaderList(first: HpackHeader, second: HpackHeader, wire_size: Int)
end

pub type HpackDecodeTransition
	HpackDecodeTransition(headers: HpackHeaderList, state: HpackFixtureState)
end

pub type HpackFixtureFailure
	UnsupportedHeaderBlock(offset: Int, observed_size: Int, observed_first_byte: Int, expected_fixture: String, codec_module: String, preview: ByteChunk)
	DynamicIndexOutOfRange(offset: Int, observed_size: Int, observed_first_byte: Int, requested_dynamic_index: Int, dynamic_table_entry_count: Int, expected_fixture: String, codec_module: String, preview: ByteChunk)
end

pub fn initial_state() -> HpackFixtureState
	HpackFixtureState(4096, 0, NoDynamicEntry)
end

fn byte_at(block: ByteChunk, index: Int) -> Result<Int, String>
	let view: ByteView = byte_view(block, byte_offset(index)?, byte_count(1)?)?
	byte_read_u8_be(view)
end

fn byte_at_or_missing(block: ByteChunk, index: Int) -> Int
	match byte_at(block, index)
		Ok(value) => value
		Err(_) => -1
	end
end

fn next_state(state: HpackFixtureState) -> HpackFixtureState
	match state
		HpackFixtureState(table_size, decode_count, dynamic_entry) => HpackFixtureState(table_size, decode_count + 1, dynamic_entry)
	end
end

fn dynamic_entry_size(name: String, value: String) -> Int
	string_byte_count(name) + string_byte_count(value) + 32
end

fn string_byte_count(value: String) -> Int
	match byte_chunk_from_visible_ascii_string(value)
		Ok(bytes) => byte_count_to_int(byte_chunk_count(bytes))
		Err(_) => 0
	end
end

fn evict_for_table_size(table_size: Int, dynamic_entry: HpackDynamicEntry) -> HpackDynamicEntry
	match dynamic_entry
		NoDynamicEntry => NoDynamicEntry
		DynamicEntry(name, value, older) => match dynamic_entry_size(name, value) <= table_size
			true => DynamicEntry(name, value, NoDynamicEntry)
			false => NoDynamicEntry
		end
	end
end

fn state_with_dynamic_entry(state: HpackFixtureState, name: String, value: String) -> HpackFixtureState
	match state
		HpackFixtureState(table_size, decode_count, dynamic_entry) => HpackFixtureState(table_size, decode_count + 1, evict_for_table_size(table_size, DynamicEntry(name, value, dynamic_entry)))
	end
end

fn state_with_table_size(state: HpackFixtureState, table_size: Int) -> HpackFixtureState
	match state
		HpackFixtureState(_, decode_count, dynamic_entry) => HpackFixtureState(table_size, decode_count + 1, evict_for_table_size(table_size, dynamic_entry))
	end
end

fn dynamic_entry_at(dynamic_entry: HpackDynamicEntry, table_index: Int) -> Option<HpackHeader>
	match dynamic_entry
		NoDynamicEntry => None
		DynamicEntry(name, value, older) => match table_index == 0
			true => Some(HpackHeader(name, value))
			false => dynamic_entry_at(older, table_index - 1)
		end
	end
end

fn dynamic_entry_count(dynamic_entry: HpackDynamicEntry) -> Int
	match dynamic_entry
		NoDynamicEntry => 0
		DynamicEntry(_, _, older) => 1 + dynamic_entry_count(older)
	end
end

fn dynamic_indexed_header(name: String, value: String) -> HpackHeaderList
	HpackHeaderList(HpackHeader(name, value), HpackHeader(":fixture", "dynamic-indexed"), 9)
end

fn literal_with_indexing_header(name: String, value: String) -> HpackHeaderList
	HpackHeaderList(HpackHeader(name, value), HpackHeader(":fixture", "literal-with-indexing"), 9)
end

fn decoded_literal_with_indexing(state: HpackFixtureState) -> Result<HpackDecodeTransition, HpackFixtureFailure>
	Ok(HpackDecodeTransition(literal_with_indexing_header(":path", "/target"), state_with_dynamic_entry(state, ":path", "/target")))
end

fn decoded_table_size_update(state: HpackFixtureState, table_size: Int) -> Result<HpackDecodeTransition, HpackFixtureFailure>
	Ok(HpackDecodeTransition(HpackHeaderList(HpackHeader(":fixture", "table-size-update"), HpackHeader(":status", "ok"), 0), state_with_table_size(state, table_size)))
end

fn decoded_dynamic_indexed_header_at(table_index: Int, state: HpackFixtureState, block: ByteChunk, offset: Int) -> Result<HpackDecodeTransition, HpackFixtureFailure>
	match state
		HpackFixtureState(_, _, dynamic_entry) => match dynamic_entry_at(dynamic_entry, table_index)
			Some(HpackHeader(name, value)) => Ok(HpackDecodeTransition(dynamic_indexed_header(name, value), next_state(state)))
			None => dynamic_index_out_of_range(block, offset, table_index, dynamic_entry_count(dynamic_entry))
		end
	end
end

fn unsupported(block: ByteChunk, offset: Int) -> Result<HpackDecodeTransition, HpackFixtureFailure>
	Err(UnsupportedHeaderBlock(offset, byte_count_to_int(byte_chunk_count(block)), byte_at_or_missing(block, 0), "fixture header block", "hpack_fixture", block))
end

fn dynamic_index_out_of_range(block: ByteChunk, offset: Int, requested_dynamic_index: Int, dynamic_table_entry_count: Int) -> Result<HpackDecodeTransition, HpackFixtureFailure>
	Err(DynamicIndexOutOfRange(offset, byte_count_to_int(byte_chunk_count(block)), byte_at_or_missing(block, 0), requested_dynamic_index, dynamic_table_entry_count, "fixture dynamic indexed header", "hpack_fixture", block))
end

pub fn decode_header_block(block: ByteChunk, state: HpackFixtureState, offset: Int) -> Result<HpackDecodeTransition, HpackFixtureFailure>
	let observed_size: Int = byte_count_to_int(byte_chunk_count(block))
	let first_byte: Int = byte_at_or_missing(block, 0)
	match first_byte == 68 and observed_size == 9
		true => decoded_literal_with_indexing(state)
		false => match first_byte == 62 and observed_size == 1
			true => decoded_table_size_update(state, 30)
			false => match first_byte >= 190 and observed_size == 1
				true => decoded_dynamic_indexed_header_at(first_byte - 190, state, block, offset)
				false => unsupported(block, offset)
			end
		end
	end
end

pub fn transition_state(transition: HpackDecodeTransition) -> HpackFixtureState
	match transition
		HpackDecodeTransition(_, state) => state
	end
end

pub fn transition_headers(transition: HpackDecodeTransition) -> HpackHeaderList
	match transition
		HpackDecodeTransition(headers, _) => headers
	end
end

pub fn header_list_first_name(headers: HpackHeaderList) -> String
	match headers
		HpackHeaderList(HpackHeader(name, _), _, _) => name
	end
end

pub fn header_list_first_value(headers: HpackHeaderList) -> String
	match headers
		HpackHeaderList(HpackHeader(_, value), _, _) => value
	end
end

pub fn state_decode_count(state: HpackFixtureState) -> Int
	match state
		HpackFixtureState(_, decode_count, _) => decode_count
	end
end

pub fn failure_offset(failure: HpackFixtureFailure) -> Int
	match failure
		UnsupportedHeaderBlock(offset, _, _, _, _, _) => offset
		DynamicIndexOutOfRange(offset, _, _, _, _, _, _, _) => offset
	end
end

pub fn failure_observed_size(failure: HpackFixtureFailure) -> Int
	match failure
		UnsupportedHeaderBlock(_, observed_size, _, _, _, _) => observed_size
		DynamicIndexOutOfRange(_, observed_size, _, _, _, _, _, _) => observed_size
	end
end

pub fn failure_observed_first_byte(failure: HpackFixtureFailure) -> Int
	match failure
		UnsupportedHeaderBlock(_, _, observed_first_byte, _, _, _) => observed_first_byte
		DynamicIndexOutOfRange(_, _, observed_first_byte, _, _, _, _, _) => observed_first_byte
	end
end

pub fn failure_requested_dynamic_index(failure: HpackFixtureFailure) -> Int
	match failure
		DynamicIndexOutOfRange(_, _, _, requested_dynamic_index, _, _, _, _) => requested_dynamic_index
		_ => 0
	end
end

pub fn failure_dynamic_table_entry_count(failure: HpackFixtureFailure) -> Int
	match failure
		DynamicIndexOutOfRange(_, _, _, _, dynamic_table_entry_count, _, _, _) => dynamic_table_entry_count
		_ => 0
	end
end

pub fn failure_expected_fixture(failure: HpackFixtureFailure) -> String
	match failure
		UnsupportedHeaderBlock(_, _, _, expected_fixture, _, _) => expected_fixture
		DynamicIndexOutOfRange(_, _, _, _, _, expected_fixture, _, _) => expected_fixture
	end
end

pub fn failure_codec_module(failure: HpackFixtureFailure) -> String
	match failure
		UnsupportedHeaderBlock(_, _, _, _, codec_module, _) => codec_module
		DynamicIndexOutOfRange(_, _, _, _, _, _, codec_module, _) => codec_module
	end
end

pub fn failure_preview(failure: HpackFixtureFailure) -> ByteChunk
	match failure
		UnsupportedHeaderBlock(_, _, _, _, _, preview) => preview
		DynamicIndexOutOfRange(_, _, _, _, _, _, _, preview) => preview
	end
end

fn hpack_failure_fallback_payload(error: String) -> RuntimeDiagnostic
	RuntimeDiagnostic(
		"hpack.fixture.unsupported_header_block",
		error,
		RuntimeHpackFixtureDiagnostic(0, 0, -1, "fixture header block", "hpack_fixture", byte_chunk([]))
	)
end

fn failure_preview_view(failure: HpackFixtureFailure) -> Result<ByteView, RuntimeDiagnostic>
	let preview_chunk: ByteChunk = failure_preview(failure)
	match byte_offset(0)
		Ok(offset) => match byte_view(preview_chunk, offset, byte_chunk_count(preview_chunk))
			Ok(view) => Ok(view)
			Err(error) => Err(hpack_failure_fallback_payload(error))
		end
		Err(error) => Err(hpack_failure_fallback_payload(error))
	end
end

pub fn project_failure(failure: HpackFixtureFailure) -> Result<(), RuntimeDiagnostic>
	let preview: ByteView = failure_preview_view(failure)?
	match failure
		UnsupportedHeaderBlock(_, _, _, _, _, _) => http2::hpack::diagnostic::unsupported_header_block(failure_offset(failure), failure_observed_size(failure), failure_observed_first_byte(failure), failure_expected_fixture(failure), failure_codec_module(failure), preview)
		DynamicIndexOutOfRange(_, _, _, _, _, _, _, _) => http2::hpack::diagnostic::dynamic_index_out_of_range(failure_offset(failure), failure_observed_size(failure), failure_observed_first_byte(failure), failure_requested_dynamic_index(failure), failure_dynamic_table_entry_count(failure), failure_expected_fixture(failure), failure_codec_module(failure), preview)
	end
end
