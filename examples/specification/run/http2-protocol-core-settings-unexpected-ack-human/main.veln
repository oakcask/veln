use http2::diagnostic from "std"
# HTTP/2 SETTINGS ACK state failures project to human runtime diagnostics.

type Http2ProtocolFailure
	UnexpectedSettingsAck(Int, ByteView)
end

type Http2DiagnosticContext
	DiagnosticContext(String, String)
end

fn context_active_state(context: Http2DiagnosticContext) -> String
	match context
		DiagnosticContext(active_state, _) => active_state
	end
end

fn context_rule_provenance(context: Http2DiagnosticContext) -> String
	match context
		DiagnosticContext(_, rule_provenance) => rule_provenance
	end
end

fn invalid_payload(error: String) -> RuntimeDiagnostic
	RuntimeDiagnostic(
		"http2.protocol.unexpected_settings_ack",
		error,
		RuntimeHttp2ProtocolUnexpectedSettingsAckDiagnostic(0, "connection-control", "rfc9113_settings_ack_requires_outstanding_local_settings", byte_chunk([]))
	)
end

fn http2_protocol_diagnostic(failure: Http2ProtocolFailure, context: Http2DiagnosticContext) -> Result<(), RuntimeDiagnostic>
	match failure
		UnexpectedSettingsAck(offset, preview) => Err(RuntimeDiagnostic("http2.protocol.unexpected_settings_ack", "HTTP/2 unexpected SETTINGS ACK at byte offset 0", RuntimeHttp2ProtocolUnexpectedSettingsAckDiagnostic(offset, context_active_state(context), context_rule_provenance(context), byte_view_to_chunk(preview))))
	end
end

fn input_bytes() -> Result<ByteChunk, RuntimeDiagnostic>
	match byte_chunk_from_hex("000000040100000000")
		Ok(bytes) => Ok(bytes)
		Err(error) => Err(invalid_payload(error))
	end
end

fn input_view(bytes: ByteChunk) -> Result<ByteView, RuntimeDiagnostic>
	match byte_offset(0)
		Ok(offset) => match byte_count(9)
			Ok(count) => match byte_view(bytes, offset, count)
				Ok(view) => Ok(view)
				Err(error) => Err(invalid_payload(error))
			end
			Err(error) => Err(invalid_payload(error))
		end
		Err(error) => Err(invalid_payload(error))
	end
end

pub fn main() -> Result<(), RuntimeDiagnostic>
	let context: Http2DiagnosticContext = DiagnosticContext("connection-control", "rfc9113_settings_ack_requires_outstanding_local_settings")
	let bytes: ByteChunk = input_bytes()?
	let preview: ByteView = input_view(bytes)?
	http2_protocol_diagnostic(UnexpectedSettingsAck(0, preview), context)
end
