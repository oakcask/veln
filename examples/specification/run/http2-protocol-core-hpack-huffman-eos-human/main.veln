# HTTP/2 HPACK Huffman EOS projects to human runtime diagnostics.

fn fallback_payload(error: String) -> RuntimeDiagnostic
	RuntimeDiagnostic("hpack.fixture.huffman_eos_symbol", error, RuntimeHpackFixtureDiagnostic(9, 0, -1, "fixture HPACK Huffman data symbol instead of EOS", "hpack_static", byte_chunk([])))
end

fn preview_view() -> Result<ByteView, RuntimeDiagnostic>
	match byte_chunk_from_hex("0484ffffffff")
		Ok(bytes) => match byte_offset(0)
			Ok(offset) => match byte_view(bytes, offset, byte_chunk_count(bytes))
				Ok(view) => Ok(view)
				Err(error) => Err(fallback_payload(error))
			end
			Err(error) => Err(fallback_payload(error))
		end
		Err(error) => Err(fallback_payload(error))
	end
end

pub fn main() -> Result<(), RuntimeDiagnostic>
	let preview: ByteView = preview_view()?
	hpack_fixture_huffman_eos_symbol(9, 6, 4, "fixture HPACK Huffman data symbol instead of EOS", "hpack_static", preview)
end
