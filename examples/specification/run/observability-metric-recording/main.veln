use metric from "std"
use observe from "std"

# This case checks the public metric module export and JVM propagation of the
# two metric payload variants through the production recording handler.
# Companion tests own the complete helper and no-op contracts.
fn run(recording: Recording) -> () effects [observe::Observe, stdio, concurrency]
	let attributes = list_cons(observe::Attribute("route", observe::StringValue("checkout")), list_nil())
	let result = begin
		metric::counter_increment(Some(observe::TraceContext("trace-1", "span-2")), "request.duration", 3, attributes)
		metric::histogram_sample(Some(observe::TraceContext("trace-1", "span-2")), "request.duration", 17, attributes)
		83
	end
	print_result(result, observe::recorded(recording), observe::recorded(recording))
end

pub fn main() -> () effects [stdio, time, concurrency]
	let recording = observe::new_recording("metrics")
	handle run(recording) with observe::recording(recording)
end

fn print_result(result: Int, first: List<RecordingEntry>, second: List<RecordingEntry>) -> () effects [stdio]
	match first
		Cons(observe::Emitted(observe::CounterIncrement(observe::CounterIncrementRecord(name, increment, Cons(observe::Attribute("route", observe::StringValue(route)), Nil), Some(observe::TraceContext(trace_id, span_id)), counter_source))), Cons(observe::Emitted(observe::HistogramSample(observe::HistogramSampleRecord(histogram_name, sample, Cons(observe::Attribute("route", observe::StringValue(histogram_route)), Nil), Some(observe::TraceContext(histogram_trace, histogram_span)), histogram_source))), Nil)) => begin
			stdio::println(int_to_string(result))
			stdio::println(name)
			stdio::println(int_to_string(increment))
			stdio::println(route)
			stdio::println(trace_id)
			stdio::println(span_id)
			stdio::println(counter_source.file)
			stdio::println(int_to_string(counter_source.start_line))
			stdio::println(histogram_name)
			stdio::println(int_to_string(sample))
			stdio::println(histogram_route)
			stdio::println(histogram_trace)
			stdio::println(histogram_span)
			stdio::println(histogram_source.file)
			stdio::println(int_to_string(histogram_source.start_line))
			match second
				Cons(observe::Emitted(observe::CounterIncrement(_)), Cons(observe::Emitted(observe::HistogramSample(_)), Nil)) => stdio::println("snapshot-preserved")
				_ => stdio::println("snapshot-changed")
			end
		end
		_ => stdio::println("unexpected-metrics")
	end
end
