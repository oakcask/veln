# Binary schema field-local validation preserves the decoded value shape when it passes.
use stdio

schema SchemaValidationSample
	format binary

	length: UInt24be
	padding_length: UInt8 where padding_length <= length
end

fn emit_sample(sample: {length: Int, padding_length: Int}) -> () effects [stdio]
	stdio::print(int_to_string(sample.length))
	stdio::print(" ")
	stdio::println(int_to_string(sample.padding_length))
end

pub fn main() -> Result<(), String> effects [stdio]
	let bytes: ByteChunk = byte_chunk_from_hex("00000504")?
	let offset: ByteOffset = byte_offset(0)?
	let count: ByteCount = byte_count(4)?
	let view: ByteView = byte_view(bytes, offset, count)?
	let sample: {length: Int, padding_length: Int} = byte_decode_schema_validation_sample(view)?
	emit_sample(sample)
	Ok(())
end
