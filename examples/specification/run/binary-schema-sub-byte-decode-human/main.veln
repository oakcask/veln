# Standalone sub-byte fields decode in human mode with the same mapped values.
use stdio

type BitFieldRecord
	BitFieldRecord {one: Int, three: Int, seven: Int}
end

schema SubByteWire
	format binary

	one_bit: UInt1
	three_bits: UInt3
	seven_bits: UInt7

	map to BitFieldRecord
		one = one_bit
		three = three_bits
		seven = seven_bits
end

pub fn main() -> Result<(), String> effects [stdio]
	let bytes: ByteChunk = byte_chunk_from_hex("fffe81")?
	let view: ByteView = byte_view(bytes, byte_offset(0)?, byte_count(3)?)?
	let decoded: {one: Int, three: Int, seven: Int} = byte_decode_sub_byte_wire(view)?
	stdio::println(int_to_string(decoded.one))
	stdio::println(int_to_string(decoded.three))
	stdio::println(int_to_string(decoded.seven))
	Ok(())
end
