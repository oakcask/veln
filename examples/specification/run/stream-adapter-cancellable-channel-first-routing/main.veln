# Cancellable stream routing maps receiver-list selection outcomes to actions.
use stdio

type ResponseAction
	SendBytes {stream_id: Int, bytes: ByteChunk}
	EndStream {stream_id: Int}
	RetryAfterDeadline {stream_id: Int}
	CleanupAfterCancel {stream_id: Int}
	Decline {stream_id: Int}
end

type CancellableRouteOutcome
	Routed {index: Int, value: StreamInput}
	TimedOut
	Cancelled
end

fn handle_stream_input(stream_id: Int, input: StreamInput, state: { chunks : Int, ended : Bool }) -> { actions : List<ResponseAction>, next_state : { chunks : Int, ended : Bool } }
	match input
		Chunk(bytes) => { actions: list_cons(SendBytes(stream_id, bytes), list_nil()), next_state: { chunks: state.chunks + 1, ended: state.ended } }
		End => { actions: list_cons(EndStream(stream_id), list_nil()), next_state: { chunks: state.chunks, ended: true } }
	end
end

fn stream_id_for_index(index: Int) -> Int
	match index
		0 => 11
		1 => 13
		_ => 17
	end
end

fn with_outcome(outcome: String, handled: { actions : List<ResponseAction>, next_state : { chunks : Int, ended : Bool } }) -> { outcome : String, actions : List<ResponseAction>, next_state : { chunks : Int, ended : Bool } }
	{ outcome: outcome, actions: handled.actions, next_state: handled.next_state }
end

fn route_outcome(selected: Result<Option<{ index : Int, value : StreamInput }>, SelectError>) -> CancellableRouteOutcome
	match selected
		Ok(Some(route)) => Routed(route.index, route.value)
		Ok(None) => TimedOut
		Err(_) => Cancelled
	end
end

fn handle_route_outcome(outcome: CancellableRouteOutcome, state: { chunks : Int, ended : Bool }) -> { outcome : String, actions : List<ResponseAction>, next_state : { chunks : Int, ended : Bool } }
	match outcome
		Routed(index, value) => with_outcome("routed", handle_stream_input(stream_id_for_index(index), value, state))
		TimedOut => { outcome: "timed-out", actions: list_cons(Decline(0), list_nil()), next_state: state }
		Cancelled => { outcome: "cancelled", actions: list_cons(CleanupAfterCancel(17), list_nil()), next_state: state }
	end
end

fn route_with_cancellable_channel_first(receivers: List<Receiver<StreamInput>>, state: { chunks : Int, ended : Bool }, timeout_ms: Int, token: CancelToken) -> { outcome : String, actions : List<ResponseAction>, next_state : { chunks : Int, ended : Bool } } effects [time, concurrency]
	handle_route_outcome(route_outcome(channel::select_many_timeout_cancellable(receivers, timeout_ms, token)), state)
end

fn action_score(actions: List<ResponseAction>) -> Int
	match actions
		Nil => 0
		Cons(action, tail) => match action
			SendBytes(stream_id, bytes) => stream_id * 100 + byte_count_to_int(byte_chunk_count(bytes)) + action_score(tail)
			EndStream(stream_id) => stream_id * 10 + action_score(tail)
			RetryAfterDeadline(stream_id) => 1000 + stream_id + action_score(tail)
			CleanupAfterCancel(stream_id) => 2000 + stream_id + action_score(tail)
			Decline(stream_id) => stream_id + action_score(tail)
		end
	end
end

fn bool_text(value: Bool) -> String
	if value
		"true"
	else
		"false"
	end
end

pub fn main() -> Result<(), String> effects [time, concurrency, stdio]
	let payload = byte_chunk_from_hex("0a0b")?

	let ready_first = channel::bounded<StreamInput>(1)
	let ready_second = channel::bounded<StreamInput>(1)
	let ready_third = channel::bounded<StreamInput>(1)
	let ready_fourth = channel::bounded<StreamInput>(1)
	let ready_fifth = channel::bounded<StreamInput>(1)
	let _ = channel::send(ready_fourth.tx, Chunk(payload))
	let ready_receivers = list_cons(ready_first.rx, list_cons(ready_second.rx, list_cons(ready_third.rx, list_cons(ready_fourth.rx, list_cons(ready_fifth.rx, list_nil())))))
	let ready_token = time::cancel_token()
	let ready = route_with_cancellable_channel_first(ready_receivers, { chunks: 0, ended: false }, 25, ready_token)
	stdio::println("receiver-list cancellable outcome")
	stdio::print(ready.outcome)
	stdio::print(" score ")
	stdio::print(int_to_string(action_score(ready.actions)))
	stdio::print(" chunks ")
	stdio::println(int_to_string(ready.next_state.chunks))

	let timeout_first = channel::bounded<StreamInput>(1)
	let timeout_second = channel::bounded<StreamInput>(1)
	let timeout_third = channel::bounded<StreamInput>(1)
	let timeout_fourth = channel::bounded<StreamInput>(1)
	let timeout_fifth = channel::bounded<StreamInput>(1)
	let timeout_receivers = list_cons(timeout_first.rx, list_cons(timeout_second.rx, list_cons(timeout_third.rx, list_cons(timeout_fourth.rx, list_cons(timeout_fifth.rx, list_nil())))))
	let timeout_token = time::cancel_token()
	let timed_out = route_with_cancellable_channel_first(timeout_receivers, ready.next_state, 0, timeout_token)
	stdio::print(timed_out.outcome)
	stdio::print(" score ")
	stdio::print(int_to_string(action_score(timed_out.actions)))
	stdio::print(" chunks ")
	stdio::println(int_to_string(timed_out.next_state.chunks))

	let cancel_first = channel::bounded<StreamInput>(1)
	let cancel_second = channel::bounded<StreamInput>(1)
	let cancel_third = channel::bounded<StreamInput>(1)
	let cancel_fourth = channel::bounded<StreamInput>(1)
	let cancel_fifth = channel::bounded<StreamInput>(1)
	let cancel_receivers = list_cons(cancel_first.rx, list_cons(cancel_second.rx, list_cons(cancel_third.rx, list_cons(cancel_fourth.rx, list_cons(cancel_fifth.rx, list_nil())))))
	let cancel_token = time::cancel_token()
	time::cancel(cancel_token)
	let cancelled = route_with_cancellable_channel_first(cancel_receivers, timed_out.next_state, 25, cancel_token)
	stdio::print(cancelled.outcome)
	stdio::print(" score ")
	stdio::print(int_to_string(action_score(cancelled.actions)))
	stdio::print(" ended ")
	stdio::println(bool_text(cancelled.next_state.ended))
	Ok(())
end
