# Cancellable stream routing composes receiver-list selection with wait outcomes.
use stdio

type ResponseAction
	SendBytes {stream_id: Int, bytes: ByteChunk}
	EndStream {stream_id: Int}
	RetryAfterDeadline {stream_id: Int}
	CleanupAfterCancel {stream_id: Int}
	Decline {stream_id: Int}
end

fn handle_stream_input(stream_id: Int, input: StreamInput, state: { chunks : Int, ended : Bool }) -> { actions : List<ResponseAction>, next_state : { chunks : Int, ended : Bool } }
	match input
		Chunk(bytes) => { actions: list_cons(SendBytes(stream_id, bytes), list_nil()), next_state: { chunks: state.chunks + 1, ended: state.ended } }
		End => { actions: list_cons(EndStream(stream_id), list_nil()), next_state: { chunks: state.chunks, ended: true } }
	end
end

fn stream_id_for_index(index: Int) -> Int
	match index
		0 => 11
		1 => 13
		_ => 17
	end
end

fn handle_selected(selected: Option<{ index : Int, value : StreamInput }>, state: { chunks : Int, ended : Bool }) -> { actions : List<ResponseAction>, next_state : { chunks : Int, ended : Bool } }
	match selected
		Some(route) => handle_stream_input(stream_id_for_index(route.index), route.value, state)
		None => { actions: list_cons(Decline(0), list_nil()), next_state: state }
	end
end

fn route_with_cancellable_channel_first(receivers: List<Receiver<StreamInput>>, state: { chunks : Int, ended : Bool }, deadline: Deadline, token: CancelToken) -> { outcome : String, actions : List<ResponseAction>, next_state : { chunks : Int, ended : Bool } } effects [time, concurrency]
	let handled = handle_selected(channel::select_many_timeout(receivers, 25), state)
	match time::wait_until_cancellable_outcome(deadline, token)
		WaitCompleted => { outcome: "completed", actions: handled.actions, next_state: handled.next_state }
		WaitDeadlineExpired => { outcome: "deadline-expired", actions: list_cons(RetryAfterDeadline(11), handled.actions), next_state: handled.next_state }
		WaitCancelled => { outcome: "cancelled", actions: list_cons(CleanupAfterCancel(17), handled.actions), next_state: handled.next_state }
	end
end

fn action_score(actions: List<ResponseAction>) -> Int
	match actions
		Nil => 0
		Cons(action, tail) => match action
			SendBytes(stream_id, bytes) => stream_id * 100 + byte_count_to_int(byte_chunk_count(bytes)) + action_score(tail)
			EndStream(stream_id) => stream_id * 10 + action_score(tail)
			RetryAfterDeadline(stream_id) => 1000 + stream_id + action_score(tail)
			CleanupAfterCancel(stream_id) => 2000 + stream_id + action_score(tail)
			Decline(stream_id) => stream_id + action_score(tail)
		end
	end
end

fn bool_text(value: Bool) -> String
	match value
		true => "true"
		false => "false"
	end
end

pub fn main() -> Result<(), String> effects [time, concurrency, stdio]
	let payload: ByteChunk = byte_chunk_from_hex("0a0b")?

	let ready_first = channel::bounded<StreamInput>(1)
	let ready_second = channel::bounded<StreamInput>(1)
	let ready_third = channel::bounded<StreamInput>(1)
	let _ = channel::send(ready_second.tx, Chunk(payload))
	let ready_receivers: List<Receiver<StreamInput>> = list_cons(ready_first.rx, list_cons(ready_second.rx, list_cons(ready_third.rx, list_nil())))
	let ready_deadline: Deadline = time::deadline_after_ms(0)
	let ready_token: CancelToken = time::cancel_token()
	let ready = route_with_cancellable_channel_first(ready_receivers, { chunks: 0, ended: false }, ready_deadline, ready_token)
	stdio::print(ready.outcome)
	stdio::print(" score ")
	stdio::print(int_to_string(action_score(ready.actions)))
	stdio::print(" chunks ")
	stdio::println(int_to_string(ready.next_state.chunks))

	let deadline_first = channel::bounded<StreamInput>(1)
	let deadline_second = channel::bounded<StreamInput>(1)
	let deadline_third = channel::bounded<StreamInput>(1)
	let _ = channel::send(deadline_first.tx, Chunk(payload))
	let deadline_receivers: List<Receiver<StreamInput>> = list_cons(deadline_first.rx, list_cons(deadline_second.rx, list_cons(deadline_third.rx, list_nil())))
	let deadline_expired_deadline: Deadline = time::deadline_after_ms(0)
	let deadline_expired_token: CancelToken = time::cancel_token()
	let deadline_expired = route_with_cancellable_channel_first(deadline_receivers, ready.next_state, deadline_expired_deadline, deadline_expired_token)
	stdio::print(deadline_expired.outcome)
	stdio::print(" score ")
	stdio::print(int_to_string(action_score(deadline_expired.actions)))
	stdio::print(" chunks ")
	stdio::println(int_to_string(deadline_expired.next_state.chunks))

	let cancel_first = channel::bounded<StreamInput>(1)
	let cancel_second = channel::bounded<StreamInput>(1)
	let cancel_third = channel::bounded<StreamInput>(1)
	let _ = channel::send(cancel_third.tx, End)
	let cancel_receivers: List<Receiver<StreamInput>> = list_cons(cancel_first.rx, list_cons(cancel_second.rx, list_cons(cancel_third.rx, list_nil())))
	let cancel_deadline: Deadline = time::deadline_after_ms(0)
	let cancel_token: CancelToken = time::cancel_token()
	time::cancel(cancel_token)
	let cancelled = route_with_cancellable_channel_first(cancel_receivers, deadline_expired.next_state, cancel_deadline, cancel_token)
	stdio::print(cancelled.outcome)
	stdio::print(" score ")
	stdio::print(int_to_string(action_score(cancelled.actions)))
	stdio::print(" ended ")
	stdio::println(bool_text(cancelled.next_state.ended))
	Ok(())
end
