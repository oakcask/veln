type Packet
	Packet { length: Int, kind: Int }
end

schema PacketWire
	format binary

	wire_length: UInt16be
	wire_kind: UInt8

	map to Packet
		length = wire_length
		kind = wire_kind
end

pub codec PacketCodec for PacketWire encode
	encode with encode_packet
end

fn encode_packet(packet: { length : Int, kind : Int }, state: { next_chunk : ByteChunk, remaining_chunk : ByteChunk, empty_chunk : ByteChunk, encoded_offset : ByteCount }) -> EncodeStep<{ next_chunk : ByteChunk, remaining_chunk : ByteChunk, empty_chunk : ByteChunk, encoded_offset : ByteCount }>
	match packet.kind <= packet.length
		true => match byte_count_to_int(state.encoded_offset) == 0
			true => Partial(list_cons(state.next_chunk, list_nil()), byte_chunk_count(state.next_chunk), { next_chunk: state.remaining_chunk, remaining_chunk: state.empty_chunk, empty_chunk: state.empty_chunk, encoded_offset: byte_chunk_count(state.next_chunk) })
			false => Encoded(list_cons(state.next_chunk, list_nil()))
		end
		false => Invalid(EncodeError("codec.out_of_range", "Packet.kind", "kind exceeds length"))
	end
end
