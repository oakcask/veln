use locations

pub fn main() -> () effects [stdio]
	let direct = locations::direct()
	let nested = locations::wrapper()
	let explicit = locations::forward()
	let pipeline = "input" |> locations::piped()
	stdio::println(direct.module)
	stdio::println(direct.file)
	stdio::println(int_to_string(direct.start_line))
	stdio::println(nested.package)
	stdio::println(nested.module)
	stdio::println(nested.file)
	stdio::println(int_to_string(nested.start_line))
	stdio::println(int_to_string(nested.start_column))
	stdio::println(int_to_string(nested.start_offset))
	stdio::println(int_to_string(nested.end_line))
	stdio::println(int_to_string(nested.end_column))
	stdio::println(int_to_string(nested.end_offset))
	stdio::println(explicit.package)
	stdio::println(explicit.module)
	stdio::println(explicit.file)
	stdio::println(int_to_string(explicit.start_line))
	stdio::println(int_to_string(explicit.start_column))
	stdio::println(int_to_string(explicit.start_offset))
	stdio::println(int_to_string(explicit.end_line))
	stdio::println(int_to_string(explicit.end_column))
	stdio::println(int_to_string(explicit.end_offset))
	stdio::println(int_to_string(pipeline.start_line))
	stdio::println(int_to_string(pipeline.start_column))
	stdio::println(int_to_string(pipeline.start_offset))
	stdio::println(int_to_string(pipeline.end_line))
	stdio::println(int_to_string(pipeline.end_column))
	stdio::println(int_to_string(pipeline.end_offset))
end
