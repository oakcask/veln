# Binary schema UInt16be, UInt24be, UInt31be, and UInt32be primitives decode and encode ordinary Int fields.
use stdio

schema BigEndianWidthsWire
	format binary

	short_value: UInt16be
	length_value: UInt24be
	stream_value: UInt31be
	wide_value: UInt32be
end

fn emit_output_chunk(name: String, index: Int, chunk: ByteChunk, expected_hex: String) -> () effects [stdio]
	stdio::print("output_chunk ")
	stdio::print(name)
	stdio::print(" index ")
	stdio::print(int_to_string(index))
	stdio::print(" hex \"")
	stdio::print(expected_hex)
	stdio::print("\" count ")
	stdio::println(int_to_string(byte_count_to_int(byte_chunk_count(chunk))))
end

fn emit_output_chunk_list_header(name: String, count: Int) -> () effects [stdio]
	stdio::print("output_chunk_list ")
	stdio::print(name)
	stdio::print(" count ")
	stdio::println(int_to_string(count))
end

fn emit_encoded(bytes: ByteChunk) -> () effects [stdio]
	emit_output_chunk_list_header("big-endian-widths", 1)
	emit_output_chunk("big-endian-widths", 0, bytes, "12341234567fffffffdeadbeef")
end

fn emit_decoded(bytes: ByteChunk) -> Result<(), String> effects [stdio]
	let view: ByteView = byte_view(bytes, byte_offset(0)?, byte_count(13)?)?
	let decoded: {short_value: Int, length_value: Int, stream_value: Int, wide_value: Int} = byte_decode_big_endian_widths_wire(view)?
	stdio::print("decoded ")
	stdio::print(int_to_string(decoded.short_value))
	stdio::print(" ")
	stdio::print(int_to_string(decoded.length_value))
	stdio::print(" ")
	stdio::print(int_to_string(decoded.stream_value))
	stdio::print(" ")
	stdio::println(int_to_string(decoded.wide_value))
	Ok(())
end

fn emit_encoded_bytes(bytes: ByteChunk) -> Result<(), String> effects [stdio]
	emit_encoded(bytes)
	emit_decoded(bytes)
end

fn emit_encoded_result(encoded: Result<ByteChunk, EncodeError>) -> Result<(), String> effects [stdio]
	match encoded
		Ok(bytes) => emit_encoded_bytes(bytes)
		Err(_) => Ok(stdio::println("unexpected encode failure"))
	end
end

pub fn main() -> Result<(), String> effects [stdio]
	let encoded: Result<ByteChunk, EncodeError> = byte_encode_big_endian_widths_wire({short_value: 4660, length_value: 1193046, stream_value: 2147483647, wide_value: 3735928559})
	let ignored: () = emit_encoded_result(encoded)?
	Ok(())
end
