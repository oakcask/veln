# Lower-case binary schema primitives decode exact-width unsigned fields to Int.
use stdio

schema LowercasePrimitivePacket
	format binary

	length: uint24be
	flags: uint16le
	kind: uint8
end

fn raw_bits(value: Int) -> Int
	value
end

fn emit_packet(packet: {length: Int, flags: Int, kind: Int}) -> () effects [stdio]
	stdio::print(int_to_string(packet.length))
	stdio::print(" ")
	stdio::print(int_to_string(raw_bits(packet.flags)))
	stdio::print(" ")
	stdio::println(int_to_string(packet.kind))
end

pub fn main() -> Result<(), String> effects [stdio]
	let bytes: ByteChunk = byte_chunk_from_hex("010203341207")?
	let offset: ByteOffset = byte_offset(0)?
	let count: ByteCount = byte_count(6)?
	let view: ByteView = byte_view(bytes, offset, count)?
	let packet: {length: Int, flags: Int, kind: Int} = byte_decode_lowercase_primitive_packet(view)?
	emit_packet(packet)
	Ok(())
end
