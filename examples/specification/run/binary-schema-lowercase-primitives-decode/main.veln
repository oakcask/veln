# Lower-case binary schema primitives normalize to the same helpers as the
# upper-case compatibility spellings.
use stdio

schema LowercasePrimitivePacket
	format binary

	length: uint24be
	flags: flag16le
	kind: uint8
end

fn flag_bits(flags: Flag16le) -> Int
	match flags
		Flag16le(bits) => bits
	end
end

fn emit_packet(packet: {length: Int, flags: Flag16le, kind: Int}) -> () effects [stdio]
	stdio::print(int_to_string(packet.length))
	stdio::print(" ")
	stdio::print(int_to_string(flag_bits(packet.flags)))
	stdio::print(" ")
	stdio::println(int_to_string(packet.kind))
end

pub fn main() -> Result<(), String> effects [stdio]
	let bytes: ByteChunk = byte_chunk_from_hex("010203341207")?
	let offset: ByteOffset = byte_offset(0)?
	let count: ByteCount = byte_count(6)?
	let view: ByteView = byte_view(bytes, offset, count)?
	let packet: {length: Int, flags: Flag16le, kind: Int} = byte_decode_lowercase_primitive_packet(view)?
	emit_packet(packet)
	Ok(())
end
