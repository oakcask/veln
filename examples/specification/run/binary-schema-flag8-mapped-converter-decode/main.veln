# Binary schema mapping can convert a Flag8 field with a pure same-module function.
use stdio

type FlagPacket
	FlagPacket {bits: Int}
end

fn flag_bits(flags: Flag8) -> Int
	match flags
		Flag8(bits) => bits
	end
end

schema FlagPacketWire
	format binary

	flags: Flag8

	map to FlagPacket
		bits = flag_bits(flags)
end

pub fn main() -> Result<(), String> effects [stdio]
	let bytes: ByteChunk = byte_chunk_from_hex("28")?
	let view: ByteView = byte_view(bytes, byte_offset(0)?, byte_count(1)?)?
	let packet: {bits: Int} = byte_decode_flag_packet_wire(view)?
	stdio::println(int_to_string(packet.bits))
	Ok(())
end
