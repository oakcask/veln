use net from "std"
use fixture_effects
use fake_effects

# Deadline-aware socket accept returns a usable stream before the deadline.
fn emit_accept_result(result: Result<net::Stream, net::NetError>) -> Result<(), net::NetError> effects [net::IO, stdio]
	match result
		Ok(stream) => emit_accepted_stream(stream)
		Err(net::NetError(_, _, _, net::TimedOut, _)) => begin
			stdio::println("deadline")
			Ok(())
		end
		Err(net::NetError(_, _, _, net::Closed, _)) => begin
			stdio::println("deadline")
			Ok(())
		end
		Err(error) => Err(error)
	end
end

fn emit_accepted_stream(stream: net::Stream) -> Result<(), net::NetError> effects [net::IO, stdio]
	match net::read(stream)?
		net::ReadChunk(incoming) => begin
			stdio::print("accepted ")
			stdio::println(int_to_string(byte_count_to_int(byte_chunk_count(incoming))))
			Ok(())
		end
		net::ReadEnd => begin
			stdio::println("accepted 0")
			Ok(())
		end
	end
end

fn fixture_body() -> Result<(), net::NetError> effects [net::IO, time, stdio]
	let listener = net::listen(net::Address(net::Tcp4, "127.0.0.1", 0))?
	let deadline = time::deadline_after_ms(100)
	let _ = emit_accept_result(net::accept_with(listener, Some(deadline), None))?
	Ok(())
end

pub fn main() -> Result<(), net::NetError> effects [concurrency, fs, net, stdio, time]
	let state = fixture_effects::create_fixture()
	handle handle handle fixture_body() with net::system() with fake_effects::network(state) with fake_effects::clock(state)
end
