# Imported recursive dispatch failures keep outer and nested field paths.
use wire

type ClosedPayload
	ClosedLeaf(Int)
	ClosedBranch({length: Int, kind: Int, payload: ClosedPayload})
end

type ClosedNode
	ClosedNode {length: Int, kind: Int, payload: ClosedPayload}
end

schema ImportedRecursiveClosedPacket
	format binary

	length: UInt8
	kind: UInt8
	payload: Dispatch(kind, length, 0 => UInt8, 1 => wire::RecursiveClosedPayload)

	map to ClosedNode when kind == 0
		length = length
		kind = kind
		payload = ClosedPayload::ClosedLeaf(payload)

	map to ClosedNode when kind == 1
		length = length
		kind = kind
		payload = ClosedPayload::ClosedBranch(payload)
end

pub fn main() -> Result<(), String>
	let bytes: ByteChunk = byte_chunk_from_hex("02010101")?
	let view: ByteView = byte_view(bytes, byte_offset(0)?, byte_count(4)?)?
	let ignored: {length: Int, kind: Int, payload: ClosedPayload} = byte_decode_imported_recursive_closed_packet(view)?
	Ok(())
end
