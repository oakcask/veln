use stdio

schema SixByteReservedSuffixHeader
	format binary

	control: UInt7
	control_padding: ReservedBits(41, 1466015503701)
end


fn step_kind(step: DecodeStep<{control: Int}>) -> String
	match step
		Decoded(_, _) => "decoded"
		NeedMore(_) => "need_more"
		Invalid(_) => "invalid"
	end
end

fn decoded_control(step: DecodeStep<{control: Int}>) -> Int
	match step
		Decoded(packet, _) => packet.control
		NeedMore(_) => -1
		Invalid(_) => -1
	end
end

fn consumed_count(step: DecodeStep<{control: Int}>) -> Int
	match step
		Decoded(_, consumed) => byte_count_to_int(consumed)
		NeedMore(_) => 0
		Invalid(_) => 0
	end
end

fn encode_kind(step: EncodeStep<()>) -> String
	match step
		Encoded(_) => "encoded"
		Partial(_, _, _) => "partial"
		Invalid(_) => "invalid"
	end
end

fn encode_result_step(encoded: Result<ByteChunk, EncodeError>) -> EncodeStep<()>
	match encoded
		Ok(chunk) => Encoded(list_cons(chunk, list_nil()))
		Err(error) => Invalid(error)
	end
end

pub fn main() -> Result<(), String> effects [stdio]
	let bytes = byte_chunk_from_hex("ab5555555555")?
	let view = byte_view(bytes, byte_offset(0)?, byte_count(6)?)?
	let decoded = decode SixByteReservedSuffixHeader from view at byte_offset(3)?
	stdio::println(step_kind(decoded))
	stdio::println(int_to_string(decoded_control(decoded)))
	stdio::println(int_to_string(consumed_count(decoded)))

	let encoded = encode_result_step(encode SixByteReservedSuffixHeader from {control: 85})
	stdio::println(encode_kind(encoded))
	Ok(())
end
