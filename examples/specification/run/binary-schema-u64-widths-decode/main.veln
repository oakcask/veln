# Binary schema UInt64be and UInt64le primitives decode ordinary Int fields.
use stdio

schema UInt64Widths
	format binary

	big_value: UInt64be
	little_value: UInt64le
end

fn emit_sample(sample: {big_value: Int, little_value: Int}) -> () effects [stdio]
	stdio::print(int_to_string(sample.big_value))
	stdio::print(" ")
	stdio::println(int_to_string(sample.little_value))
end

pub fn main() -> Result<(), String> effects [stdio]
	let bytes = byte_chunk_from_hex("01020304050607080807060504030201")?
	let offset = byte_offset(0)?
	let count = byte_count(16)?
	let view = byte_view(bytes, offset, count)?
	let sample = byte_decode_uint64_widths(view)?
	emit_sample(sample)
	Ok(())
end
