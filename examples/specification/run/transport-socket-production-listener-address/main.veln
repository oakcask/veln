# Production loopback listeners expose bound local endpoint text before accept.
use stdio

pub fn main() -> Result<(), String> effects [net, stdio]
	let listener: NetListener = net::listen("127.0.0.1:0")
	let local: String = net::listener_local_addr(listener)
	let stream: NetStream = net::accept(listener)
	let stream_local: String = net::stream_local_addr(stream)
	let stream_peer: String = net::stream_peer_addr(stream)
	let incoming: ByteChunk = net::read_chunk(stream)
	stdio::print("listener ")
	stdio::print(local)
	stdio::print(" stream-local ")
	stdio::print(stream_local)
	stdio::print(" stream-peer ")
	stdio::print(stream_peer)
	stdio::print(" bytes ")
	stdio::println(int_to_string(byte_count_to_int(byte_chunk_count(incoming))))
	net::close_stream(stream)
	net::close_listener(listener)
	Ok(())
end
