use http2::hpack::diagnostic from "std"
# HPACK fixture helpers return human Huffman non-visible RuntimeDiagnostic payloads.
fn invalid_payload(error: String) -> RuntimeDiagnostic
	RuntimeDiagnostic(
		"hpack.fixture.huffman_non_visible_value",
		error,
		RuntimeHttp2HpackDiagnostic(RuntimeHpackFixtureDiagnostic(9, 0, -1, "fixture HPACK Huffman checked header value", "hpack_fixture", byte_chunk([])))
	)
end

fn preview_view() -> Result<ByteView, RuntimeDiagnostic>
	match byte_chunk_from_hex("0484ffc7fe3f")
		Ok(block) => match byte_offset(0)
			Ok(offset) => match byte_view(block, offset, byte_chunk_count(block))
				Ok(view) => Ok(view)
				Err(error) => Err(invalid_payload(error))
			end
			Err(error) => Err(invalid_payload(error))
		end
		Err(error) => Err(invalid_payload(error))
	end
end

pub fn main() -> Result<(), RuntimeDiagnostic>
	let preview: ByteView = preview_view()?
	http2::hpack::diagnostic::huffman_non_visible_value(9, 6, 4, "fixture HPACK Huffman checked header value", "hpack_fixture", preview)
end
