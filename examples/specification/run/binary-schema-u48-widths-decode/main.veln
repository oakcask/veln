# Binary schema UInt48be and UInt48le primitives decode ordinary Int fields.
use stdio

type UInt48Widths
	UInt48Widths {big_number: Int, little_number: Int}
end

schema UInt48WidthsWire
	format binary

	big_value: UInt48be
	little_value: UInt48le

	map to UInt48Widths
		big_number = big_value
		little_number = little_value
end

fn emit_widths(widths: {big_number: Int, little_number: Int}) -> () effects [stdio]
	stdio::print(int_to_string(widths.big_number))
	stdio::print(" ")
	stdio::println(int_to_string(widths.little_number))
end

pub fn main() -> Result<(), String> effects [stdio]
	let bytes: ByteChunk = byte_chunk_from_hex("010203040506060504030201")?
	let offset: ByteOffset = byte_offset(0)?
	let count: ByteCount = byte_count(12)?
	let view: ByteView = byte_view(bytes, offset, count)?
	let decoded: {big_number: Int, little_number: Int} = byte_decode_uint48_widths_wire(view)?
	emit_widths(decoded)
	Ok(())
end
