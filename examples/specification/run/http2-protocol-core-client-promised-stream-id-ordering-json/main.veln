# A lower promised stream id projects structured client receive context.

fn invalid_payload(error: String) -> RuntimeDiagnostic
	RuntimeDiagnostic(
		"http2.protocol.peer_stream_id_not_increasing",
		error,
		RuntimeHttp2Diagnostic(RuntimeHttp2ProtocolPeerStreamIdNotIncreasingDiagnostic(16, 2, 4, "client", "idle-stream", "rfc9113_peer_stream_ids_increase", byte_chunk([])))
	)
end

fn frame_header() -> Result<ByteChunk, RuntimeDiagnostic>
	match byte_chunk_from_hex("000007050400000001")
		Ok(bytes) => Ok(bytes)
		Err(error) => Err(invalid_payload(error))
	end
end

pub fn main() -> Result<(), RuntimeDiagnostic>
	let preview: ByteChunk = frame_header()?
	Err(RuntimeDiagnostic(
		"http2.protocol.peer_stream_id_not_increasing",
		"HTTP/2 peer-created stream id 2 is not greater than previous id 4 at byte offset 16",
		RuntimeHttp2Diagnostic(RuntimeHttp2ProtocolPeerStreamIdNotIncreasingDiagnostic(16, 2, 4, "client", "idle-stream", "rfc9113_peer_stream_ids_increase", preview))
	))
end
