use http2::core from "std"
use stdio

fn require_connection(value: Int) -> Result<CoreConnectionWindowCredit, String>
	match http2::core::connection_window_credit(value)
		Ok(credit) => Ok(credit)
		Err(failure) => Err(http2::core::flow_control_failure_domain(failure))
	end
end

fn require_stream_entry(result: Result<CoreStreamEntry, FlowControlDomainFailure>) -> Result<CoreStreamEntry, String>
	match result
		Ok(entry) => Ok(entry)
		Err(failure) => Err(http2::core::flow_control_failure_domain(failure))
	end
end

fn require_state(decision: CoreDataReceiveFlowControlDecision) -> Result<CoreConnectionState, String>
	http2::core::data_receive_flow_control_state(decision)
end

fn require_failure(decision: CoreDataReceiveFlowControlDecision) -> Result<CoreDataReceiveFlowControlFailure, String>
	http2::core::data_receive_flow_control_failure(decision)
end

fn print_state(label: String, state: CoreConnectionState, stream_id: Int) -> Result<(), String> effects [stdio]
	let stream = match http2::core::stream_collection_find(http2::core::connection_state_streams(state), stream_id)
		Some(found) => found
		None => Err("missing expected stream")?
	end
	stdio::print(label)
	stdio::print(" connection ")
	stdio::print(int_to_string(http2::core::connection_window_credit_value(http2::core::connection_state_receive_credit(state))))
	stdio::print(" stream ")
	stdio::print(int_to_string(http2::core::stream_window_credit_value(http2::core::stream_entry_receive_credit(stream))))
	stdio::print(" send ")
	stdio::println(int_to_string(http2::core::stream_window_credit_value(http2::core::stream_entry_send_credit(stream))))
	Ok(())
end

fn print_failure(label: String, failure: CoreDataReceiveFlowControlFailure) -> () effects [stdio]
	stdio::print(label)
	stdio::print(" failure ")
	stdio::print(http2::core::data_receive_flow_control_failure_id(failure))
	stdio::print(" offset ")
	stdio::print(int_to_string(http2::core::data_receive_flow_control_failure_offset(failure)))
	stdio::print(" stream ")
	stdio::print(int_to_string(http2::core::data_receive_flow_control_failure_stream_id(failure)))
	stdio::print(" length ")
	stdio::print(int_to_string(http2::core::data_receive_flow_control_failure_data_length(failure)))
	stdio::print(" domain ")
	stdio::print(http2::core::data_receive_flow_control_failure_domain(failure))
	stdio::print(" observed ")
	stdio::print(int_to_string(http2::core::data_receive_flow_control_failure_observed_value(failure)))
	stdio::print(" connection ")
	stdio::print(int_to_string(http2::core::data_receive_flow_control_failure_connection_credit(failure)))
	stdio::print(" stream-credit ")
	stdio::print(int_to_string(http2::core::data_receive_flow_control_failure_stream_credit(failure)))
	stdio::print(" preview ")
	stdio::println(int_to_string(byte_count_to_int(byte_chunk_count(http2::core::data_receive_flow_control_failure_preview(failure)))))
end

fn print_error_line(label: String, error: String) -> () effects [stdio]
	stdio::print(label)
	stdio::print(" ")
	stdio::println(error)
end

fn print_failure_accessor_error(label: String, decision: CoreDataReceiveFlowControlDecision) -> Result<(), String> effects [stdio]
	match http2::core::data_receive_flow_control_failure(decision)
		Ok(_) => Err("expected accepted DATA receive decision to hide failure")
		Err(error) => Ok(print_error_line(label, error))
	end
end

fn print_state_accessor_error(label: String, decision: CoreDataReceiveFlowControlDecision) -> Result<(), String> effects [stdio]
	match http2::core::data_receive_flow_control_state(decision)
		Ok(_) => Err("expected rejected DATA receive decision to hide state")
		Err(error) => Ok(print_error_line(label, error))
	end
end

pub fn main() -> Result<(), String> effects [stdio]
	let base = http2::core::connection_state_with_receive_credit(http2::core::server_connection_state(0)?, require_connection(10)?)
	let entry = require_stream_entry(http2::core::stream_entry(5, http2::core::stream_open_lifecycle(), 7, 99, 0, 0))?
	let state = http2::core::connection_state_with_streams(base, http2::core::stream_collection_add_or_replace(http2::core::connection_state_streams(base), entry))
	let accepted = http2::core::apply_data_receive_flow_control(state, 31, 5, 4, byte_chunk_from_hex("000004000000000005")?)
	stdio::print("accepted ")
	stdio::println(http2::core::data_receive_flow_control_status(accepted))
	let _ = print_state("updated", require_state(accepted)?, 5)?
	let _ = print_state("input", state, 5)?
	let connection_failure = require_failure(http2::core::apply_data_receive_flow_control(state, 41, 5, 11, byte_chunk_from_hex("00000b000000000005")?))?
	let low_stream = require_stream_entry(http2::core::stream_entry(5, http2::core::stream_open_lifecycle(), 0 - 2147483645, 99, 0, 0))?
	let low_stream_state = http2::core::connection_state_with_streams(http2::core::connection_state_with_receive_credit(state, require_connection(20)?), http2::core::stream_collection_add_or_replace(http2::core::connection_state_streams(state), low_stream))
	let stream_failure = require_failure(http2::core::apply_data_receive_flow_control(low_stream_state, 43, 5, 3, byte_chunk_from_hex("000003000000000005")?))?
	let missing_failure = require_failure(http2::core::apply_data_receive_flow_control(state, 47, 7, 1, byte_chunk_from_hex("000001000000000007")?))?
	print_failure("connection", connection_failure)
	let _ = print_state("connection-input", state, 5)?
	print_failure("stream", stream_failure)
	let _ = print_state("stream-input", low_stream_state, 5)?
	print_failure("missing", missing_failure)
	let _ = print_state("missing-input", state, 5)?
	let _ = print_failure_accessor_error("accepted-accessor", accepted)?
	let _ = print_state_accessor_error("rejected-accessor", http2::core::apply_data_receive_flow_control(state, 49, 5, 11, byte_chunk_from_hex("00000b000000000005")?))?
	Ok(())
end
