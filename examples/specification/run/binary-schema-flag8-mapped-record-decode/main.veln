# Binary schema mapping can carry a Flag8 field into a target record.
use stdio

type FlagPacket
	FlagPacket {target_flags: Flag8}
end

schema FlagPacketWire
	format binary

	flags: Flag8

	map to FlagPacket
		target_flags = flags
end

fn flag_bits(flags: Flag8) -> Int
	match flags
		Flag8(bits) => bits
	end
end

pub fn main() -> Result<(), String> effects [stdio]
	let bytes: ByteChunk = byte_chunk_from_hex("28")?
	let view: ByteView = byte_view(bytes, byte_offset(0)?, byte_count(1)?)?
	let packet: {target_flags: Flag8} = byte_decode_flag_packet_wire(view)?
	stdio::println(int_to_string(flag_bits(packet.target_flags)))
	Ok(())
end
