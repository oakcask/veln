use net from "std"
use fixture_effects
use fake_effects
# Production multi-chunk routing keeps forced reads as runtime failures.
use stdio

type ResponseAction
	SendBytes(bytes: ByteChunk)
	EndStream
	Ignore
end

fn handle_stream_input(input: StreamInput, state: { chunks : Int, ended : Bool }) -> { actions : List<ResponseAction>, next_state : { chunks : Int, ended : Bool } }
	match input
		Chunk(bytes) => { actions: list_cons(SendBytes(bytes), list_nil()), next_state: { chunks: state.chunks + 1, ended: state.ended } }
		End => { actions: list_cons(EndStream, list_nil()), next_state: { chunks: state.chunks, ended: true } }
	end
end

fn append_actions(left: List<ResponseAction>, right: List<ResponseAction>) -> List<ResponseAction>
	match left
		Nil => right
		Cons(action, tail) => list_cons(action, append_actions(tail, right))
	end
end

fn action_count(actions: List<ResponseAction>) -> Int
	match actions
		Nil => 0
		Cons(_, tail) => 1 + action_count(tail)
	end
end

fn write_count(actions: List<ResponseAction>) -> Int
	match actions
		Nil => 0
		Cons(action, tail) => match action
			SendBytes(_) => 1 + write_count(tail)
			EndStream => write_count(tail)
			Ignore => write_count(tail)
		end
	end
end

fn end_count(actions: List<ResponseAction>) -> Int
	match actions
		Nil => 0
		Cons(action, tail) => match action
			SendBytes(_) => end_count(tail)
			EndStream => 1 + end_count(tail)
			Ignore => end_count(tail)
		end
	end
end

fn ordered_send_chunks(actions: List<ResponseAction>) -> List<ByteChunk>
	match actions
		Nil => list_nil()
		Cons(action, tail) => match action
			SendBytes(bytes) => list_cons(bytes, ordered_send_chunks(tail))
			EndStream => ordered_send_chunks(tail)
			Ignore => ordered_send_chunks(tail)
		end
	end
end

fn read_stream_input(stream: net::Stream) -> StreamInput effects [net::IO]
	match read_chunk_optional(stream)
		Some(bytes) => Chunk(bytes)
		None => End
	end
end

fn route_input(route: { tx : Sender<StreamInput>, rx : Receiver<StreamInput> }, input: StreamInput) -> StreamInput effects [concurrency]
	let _ = channel::send(route.tx, input)
	match channel::recv(route.rx)
		Some(value) => value
		None => End
	end
end

fn append_collected_actions(left: { actions : List<ResponseAction>, next_state : { chunks : Int, ended : Bool } }, right: { actions : List<ResponseAction>, next_state : { chunks : Int, ended : Bool } }) -> { actions : List<ResponseAction>, next_state : { chunks : Int, ended : Bool } }
	{ actions: append_actions(left.actions, right.actions), next_state: right.next_state }
end

fn collect_stream_actions_until_end(stream: net::Stream, route: { tx : Sender<StreamInput>, rx : Receiver<StreamInput> }, state: { chunks : Int, ended : Bool }) -> { actions : List<ResponseAction>, next_state : { chunks : Int, ended : Bool } } effects [net::IO, concurrency]
	let input = route_input(route, read_stream_input(stream))
	let handled = handle_stream_input(input, state)
	match input
		Chunk(_) => append_collected_actions(handled, collect_stream_actions_until_end(stream, route, handled.next_state))
		End => handled
	end
end

fn collect_stream_actions(stream: net::Stream) -> { actions : List<ResponseAction>, next_state : { chunks : Int, ended : Bool } } effects [net::IO, concurrency]
	let route = channel::bounded<StreamInput>(1)
	collect_stream_actions_until_end(stream, route, { chunks: 0, ended: false })
end

fn accepted_lifecycle(stream: net::Stream) -> Result<{ actions : List<ResponseAction>, next_state : { chunks : Int, ended : Bool } }, String> effects [net::IO, concurrency]
	let routed = collect_stream_actions(stream)
	write_chunk_values(stream, ordered_send_chunks(routed.actions))
	close_stream_value(stream)
	Ok(routed)
end

fn accept_next(listener: net::Listener) -> Result<net::Stream, String> effects [net::IO]
	match accept_optional(listener)
		Some(stream) => Ok(stream)
		None => Err("missing production stream")
	end
end

fn listener_ended(listener: net::Listener) -> Bool effects [net::IO]
	match accept_optional(listener)
		Some(_) => false
		None => true
	end
end

fn bool_text(value: Bool) -> String
	if value
		"true"
	else
		"false"
	end
end

fn fixture_body() -> Result<(), String> effects [net::IO, concurrency, stdio]
	let listener: net::Listener = open_listener("127.0.0.1:0")?
	let stream: net::Stream = accept_stream(listener)?
	read_until_failure(stream)
end

fn read_until_failure(stream: net::Stream) -> Result<(), String> effects [net::IO]
	match net::read(stream)
		Ok(net::ReadChunk(_)) => read_until_failure(stream)
		Ok(net::ReadEnd) => Ok(())
		Err(error) => Err(fixture_network_error(error))
	end
end

pub fn main() -> Result<(), String> effects [time, concurrency, fs, net, stdio]
	let state = fixture_effects::create_fixture()
	handle handle handle fixture_body() with net::system() with fake_effects::network(state) with fake_effects::clock(state)
end

fn fixture_network_error(error: net::NetError) -> String
	match error
		net::NetError(_, _, _, _, message) => match string_split_once(message, "\n")
			Some(parts) => parts.left
			None => message
		end
	end
end

fn fixture_address(text: String) -> Result<net::Address, String>
	match net::split_host_port(text)
		Ok(parts) => Ok(net::Address(net::Tcp4, parts.host, parts.port))
		Err(error) => Err(fixture_network_error(error))
	end
end

fn read_chunk_optional(stream: net::Stream) -> Option<ByteChunk> effects [net::IO]
	match net::read(stream)
		Ok(net::ReadChunk(bytes)) => Some(bytes)
		_ => None
	end
end

fn accept_optional(listener: net::Listener) -> Option<net::Stream> effects [net::IO]
	match net::accept(listener)
		Ok(stream) => Some(stream)
		Err(_) => None
	end
end

fn write_chunk_values(stream: net::Stream, chunks: List<ByteChunk>) -> () effects [net::IO]
	match chunks
		Nil => ()
		Cons(bytes, tail) => begin
			let _ = net::write_all(stream, bytes, None, None)
			write_chunk_values(stream, tail)
		end
	end
end

fn close_stream_value(stream: net::Stream) -> () effects [net::IO]
	let _ = net::close_stream(stream)
	()
end

fn open_listener(text: String) -> Result<net::Listener, String> effects [net::IO]
	match fixture_address(text)
		Ok(address) => match net::listen(address)
			Ok(listener) => Ok(listener)
			Err(error) => Err(fixture_network_error(error))
		end
		Err(message) => Err(message)
	end
end

fn open_stream(text: String) -> Result<net::Stream, String> effects [net::IO]
	match fixture_address(text)
		Ok(address) => match net::connect(address)
			Ok(stream) => Ok(stream)
			Err(error) => Err(fixture_network_error(error))
		end
		Err(message) => Err(message)
	end
end

fn accept_stream(listener: net::Listener) -> Result<net::Stream, String> effects [net::IO]
	match net::accept(listener)
		Ok(stream) => Ok(stream)
		Err(error) => Err(fixture_network_error(error))
	end
end
