use net from "std"
use fixture_effects
use fake_effects
use stdio

type FixtureReadOutcome
	FixtureReadChunk(bytes: ByteChunk)
	FixtureReadEnd
	FixtureReadDeadlineExpired
	FixtureReadCancelled
end

type FixtureAcceptOutcome
	FixtureAcceptStream(stream: net::Stream)
	FixtureAcceptEnd
	FixtureAcceptDeadlineExpired
	FixtureAcceptCancelled
end

fn fixture_read_with(stream: net::Stream, deadline: Deadline, token: CancelToken) -> FixtureReadOutcome effects [net::IO]
	match net::read_with(stream, Some(deadline), Some(token))
		Ok(net::ReadChunk(bytes)) => FixtureReadChunk(bytes)
		Ok(net::ReadEnd) => FixtureReadEnd
		Err(net::NetError(_, _, _, net::TimedOut, _)) => FixtureReadDeadlineExpired
		Err(net::NetError(_, _, _, net::Cancelled, _)) => FixtureReadCancelled
		Err(_) => FixtureReadEnd
	end
end

fn fixture_accept_with(listener: net::Listener, deadline: Deadline, token: CancelToken) -> FixtureAcceptOutcome effects [net::IO]
	match net::accept_with(listener, Some(deadline), Some(token))
		Ok(stream) => FixtureAcceptStream(stream)
		Err(net::NetError(_, _, _, net::TimedOut, _)) => FixtureAcceptDeadlineExpired
		Err(net::NetError(_, _, _, net::Cancelled, _)) => FixtureAcceptCancelled
		Err(_) => FixtureAcceptEnd
	end
end
# Production adapter cleanup owns cancellation while draining listener streams.

type ResponseAction
	SendBytes(bytes: ByteChunk)
	EndStream
	RetryAfterDeadline
	CleanupAfterCancel
end

fn handle_stream_input(input: StreamInput, state: { chunks : Int, ended : Bool, trailer : ByteChunk }) -> { actions : List<ResponseAction>, next_state : { chunks : Int, ended : Bool, trailer : ByteChunk } }
	match input
		Chunk(bytes) => { actions: list_cons(SendBytes(bytes), list_cons(SendBytes(state.trailer), list_nil())), next_state: { chunks: state.chunks + 1, ended: state.ended, trailer: state.trailer } }
		End => { actions: list_cons(EndStream, list_nil()), next_state: { chunks: state.chunks, ended: true, trailer: state.trailer } }
	end
end

fn append_actions(left: List<ResponseAction>, right: List<ResponseAction>) -> List<ResponseAction>
	match left
		Nil => right
		Cons(action, tail) => list_cons(action, append_actions(tail, right))
	end
end

fn write_count(actions: List<ResponseAction>) -> Int
	match actions
		Nil => 0
		Cons(action, tail) => match action
			SendBytes(_) => 1 + write_count(tail)
			EndStream => write_count(tail)
			RetryAfterDeadline => write_count(tail)
			CleanupAfterCancel => write_count(tail)
		end
	end
end

fn end_count(actions: List<ResponseAction>) -> Int
	match actions
		Nil => 0
		Cons(action, tail) => match action
			SendBytes(_) => end_count(tail)
			EndStream => 1 + end_count(tail)
			RetryAfterDeadline => end_count(tail)
			CleanupAfterCancel => end_count(tail)
		end
	end
end

fn retry_count(actions: List<ResponseAction>) -> Int
	match actions
		Nil => 0
		Cons(action, tail) => match action
			SendBytes(_) => retry_count(tail)
			EndStream => retry_count(tail)
			RetryAfterDeadline => 1 + retry_count(tail)
			CleanupAfterCancel => retry_count(tail)
		end
	end
end

fn cleanup_count(actions: List<ResponseAction>) -> Int
	match actions
		Nil => 0
		Cons(action, tail) => match action
			SendBytes(_) => cleanup_count(tail)
			EndStream => cleanup_count(tail)
			RetryAfterDeadline => cleanup_count(tail)
			CleanupAfterCancel => 1 + cleanup_count(tail)
		end
	end
end

fn bool_text(value: Bool) -> String
	if value
		"true"
	else
		"false"
	end
end

fn bool_count(value: Bool) -> Int
	if value
		1
	else
		0
	end
end

fn route_input(route: { tx : Sender<StreamInput>, rx : Receiver<StreamInput> }, input: StreamInput) -> StreamInput effects [concurrency]
	let _ = channel::send(route.tx, input)
	match channel::recv(route.rx)
		Some(value) => value
		None => End
	end
end

fn run_handler_task(context: { input : StreamInput, state : { chunks : Int, ended : Bool, trailer : ByteChunk } }) -> { actions : List<ResponseAction>, next_state : { chunks : Int, ended : Bool, trailer : ByteChunk } } effects [concurrency]
	handle_stream_input(context.input, context.state)
end

fn route_and_handle(route: { tx : Sender<StreamInput>, rx : Receiver<StreamInput> }, input: StreamInput, state: { chunks : Int, ended : Bool, trailer : ByteChunk }) -> { actions : List<ResponseAction>, next_state : { chunks : Int, ended : Bool, trailer : ByteChunk } } effects [concurrency]
	let routed = route_input(route, input)
	let context = { input: routed, state: state }
	let worker = task::spawn_with<{actions:List<ResponseAction>, next_state:{chunks:Int, ended:Bool, trailer:ByteChunk}}, {input:StreamInput, state:{chunks:Int, ended:Bool, trailer:ByteChunk}}>(run_handler_task, context)
	match task::join(worker)
		Ok(value) => value
		Err(_) => { actions: list_cons(CleanupAfterCancel, list_nil()), next_state: state }
	end
end

fn read_response(route: { tx : Sender<StreamInput>, rx : Receiver<StreamInput> }, outcome: FixtureReadOutcome, state: { chunks : Int, ended : Bool, trailer : ByteChunk }) -> { actions : List<ResponseAction>, next_state : { chunks : Int, ended : Bool, trailer : ByteChunk } } effects [concurrency]
	match outcome
		FixtureReadChunk(bytes) => route_and_handle(route, Chunk(bytes), state)
		FixtureReadEnd => route_and_handle(route, End, state)
		FixtureReadDeadlineExpired => { actions: list_cons(RetryAfterDeadline, list_nil()), next_state: state }
		FixtureReadCancelled => { actions: list_cons(CleanupAfterCancel, list_nil()), next_state: state }
	end
end

fn read_result_text(outcome: FixtureReadOutcome) -> String
	match outcome
		FixtureReadChunk(_) => "chunk"
		FixtureReadEnd => "end"
		FixtureReadDeadlineExpired => "deadline-expired"
		FixtureReadCancelled => "cancelled"
	end
end

fn append_collected_actions(left: { actions : List<ResponseAction>, next_state : { chunks : Int, ended : Bool, trailer : ByteChunk } }, right: { actions : List<ResponseAction>, next_state : { chunks : Int, ended : Bool, trailer : ByteChunk } }) -> { actions : List<ResponseAction>, next_state : { chunks : Int, ended : Bool, trailer : ByteChunk } }
	{ actions: append_actions(left.actions, right.actions), next_state: right.next_state }
end

fn collect_stream_actions_until_end(stream: net::Stream, route: { tx : Sender<StreamInput>, rx : Receiver<StreamInput> }, state: { chunks : Int, ended : Bool, trailer : ByteChunk }, deadline: Deadline, token: CancelToken) -> { actions : List<ResponseAction>, next_state : { chunks : Int, ended : Bool, trailer : ByteChunk } } effects [net::IO, time, concurrency]
	let outcome = fixture_read_with(stream, deadline, token)
	let handled = read_response(route, outcome, state)
	match outcome
		FixtureReadChunk(_) => append_collected_actions(handled, collect_stream_actions_until_end(stream, route, handled.next_state, deadline, token))
		FixtureReadEnd => handled
		FixtureReadDeadlineExpired => handled
		FixtureReadCancelled => handled
	end
end

fn collect_stream_actions(stream: net::Stream, deadline: Deadline, token: CancelToken, trailer: ByteChunk) -> { actions : List<ResponseAction>, next_state : { chunks : Int, ended : Bool, trailer : ByteChunk } } effects [net::IO, time, concurrency]
	let route = channel::bounded<StreamInput>(1)
	collect_stream_actions_until_end(stream, route, { chunks: 0, ended: false, trailer: trailer }, deadline, token)
end

fn ordered_send_chunks(actions: List<ResponseAction>) -> List<ByteChunk>
	match actions
		Nil => list_nil()
		Cons(action, tail) => match action
			SendBytes(bytes) => list_cons(bytes, ordered_send_chunks(tail))
			EndStream => ordered_send_chunks(tail)
			RetryAfterDeadline => ordered_send_chunks(tail)
			CleanupAfterCancel => ordered_send_chunks(tail)
		end
	end
end

fn apply_ordered_send_chunks(stream: net::Stream, chunks: List<ByteChunk>) -> () effects [net::IO]
	match chunks
		Nil => ()
		Cons(_, _) => write_chunk_values(stream, chunks)
	end
end

fn close_after_apply(stream: net::Stream, actions: List<ResponseAction>) -> () effects [net::IO]
	apply_ordered_send_chunks(stream, ordered_send_chunks(actions))
	close_stream_value(stream)
end

fn accepted_lifecycle(stream: net::Stream, deadline: Deadline, token: CancelToken, trailer: ByteChunk) -> Result<{ actions : List<ResponseAction>, next_state : { chunks : Int, ended : Bool, trailer : ByteChunk } }, String> effects [net::IO, time, concurrency]
	let routed = collect_stream_actions(stream, deadline, token, trailer)
	close_after_apply(stream, routed.actions)
	Ok(routed)
end

fn collect_one_then_cancel(stream: net::Stream, deadline: Deadline, owner: CancelOwner, token: CancelToken, trailer: ByteChunk) -> { read : String, actions : List<ResponseAction>, next_state : { chunks : Int, ended : Bool, trailer : ByteChunk } } effects [net::IO, time, concurrency]
	let route = channel::bounded<StreamInput>(1)
	let first_outcome = fixture_read_with(stream, deadline, token)
	let first = read_response(route, first_outcome, { chunks: 0, ended: false, trailer: trailer })
	time::cancel_owned(owner)
	let cancelled_outcome = fixture_read_with(stream, deadline, token)
	let cancelled = read_response(route, cancelled_outcome, first.next_state)
	let combined = append_collected_actions(first, cancelled)
	{ read: read_result_text(cancelled_outcome), actions: combined.actions, next_state: combined.next_state }
end

fn accepted_cancel_after_first_read(stream: net::Stream, deadline: Deadline, owner: CancelOwner, token: CancelToken, trailer: ByteChunk) -> Result<{ read : String, actions : List<ResponseAction>, next_state : { chunks : Int, ended : Bool, trailer : ByteChunk } }, String> effects [net::IO, time, concurrency]
	let routed = collect_one_then_cancel(stream, deadline, owner, token, trailer)
	close_after_apply(stream, routed.actions)
	Ok(routed)
end

fn add_stream_summary(summary: { streams : Int, chunks : Int, ended : Int, writes : Int, end_actions : Int, retries : Int, cleanup : Int, clean_end : Bool, accept_cancelled : Int, accept_deadline : Int }, routed: { actions : List<ResponseAction>, next_state : { chunks : Int, ended : Bool, trailer : ByteChunk } }) -> { streams : Int, chunks : Int, ended : Int, writes : Int, end_actions : Int, retries : Int, cleanup : Int, clean_end : Bool, accept_cancelled : Int, accept_deadline : Int }
	{ streams: summary.streams + 1, chunks: summary.chunks + routed.next_state.chunks, ended: summary.ended + bool_count(routed.next_state.ended), writes: summary.writes + write_count(routed.actions), end_actions: summary.end_actions + end_count(routed.actions), retries: summary.retries + retry_count(routed.actions), cleanup: summary.cleanup + cleanup_count(routed.actions), clean_end: false, accept_cancelled: summary.accept_cancelled, accept_deadline: summary.accept_deadline }
end

fn finish_clean(summary: { streams : Int, chunks : Int, ended : Int, writes : Int, end_actions : Int, retries : Int, cleanup : Int, clean_end : Bool, accept_cancelled : Int, accept_deadline : Int }) -> { streams : Int, chunks : Int, ended : Int, writes : Int, end_actions : Int, retries : Int, cleanup : Int, clean_end : Bool, accept_cancelled : Int, accept_deadline : Int }
	{ streams: summary.streams, chunks: summary.chunks, ended: summary.ended, writes: summary.writes, end_actions: summary.end_actions, retries: summary.retries, cleanup: summary.cleanup, clean_end: true, accept_cancelled: summary.accept_cancelled, accept_deadline: summary.accept_deadline }
end

fn finish_accept_cancelled(summary: { streams : Int, chunks : Int, ended : Int, writes : Int, end_actions : Int, retries : Int, cleanup : Int, clean_end : Bool, accept_cancelled : Int, accept_deadline : Int }) -> { streams : Int, chunks : Int, ended : Int, writes : Int, end_actions : Int, retries : Int, cleanup : Int, clean_end : Bool, accept_cancelled : Int, accept_deadline : Int }
	{ streams: summary.streams, chunks: summary.chunks, ended: summary.ended, writes: summary.writes, end_actions: summary.end_actions, retries: summary.retries, cleanup: summary.cleanup, clean_end: false, accept_cancelled: summary.accept_cancelled + 1, accept_deadline: summary.accept_deadline }
end

fn finish_accept_deadline(summary: { streams : Int, chunks : Int, ended : Int, writes : Int, end_actions : Int, retries : Int, cleanup : Int, clean_end : Bool, accept_cancelled : Int, accept_deadline : Int }) -> { streams : Int, chunks : Int, ended : Int, writes : Int, end_actions : Int, retries : Int, cleanup : Int, clean_end : Bool, accept_cancelled : Int, accept_deadline : Int }
	{ streams: summary.streams, chunks: summary.chunks, ended: summary.ended, writes: summary.writes, end_actions: summary.end_actions, retries: summary.retries, cleanup: summary.cleanup, clean_end: false, accept_cancelled: summary.accept_cancelled, accept_deadline: summary.accept_deadline + 1 }
end

fn drain_listener(listener: net::Listener, summary: { streams : Int, chunks : Int, ended : Int, writes : Int, end_actions : Int, retries : Int, cleanup : Int, clean_end : Bool, accept_cancelled : Int, accept_deadline : Int }, deadline: Deadline, token: CancelToken, trailer: ByteChunk) -> Result<{ streams : Int, chunks : Int, ended : Int, writes : Int, end_actions : Int, retries : Int, cleanup : Int, clean_end : Bool, accept_cancelled : Int, accept_deadline : Int }, String> effects [net::IO, time, concurrency]
	match fixture_accept_with(listener, deadline, token)
		FixtureAcceptStream(stream) => drain_listener(listener, add_stream_summary(summary, accepted_lifecycle(stream, deadline, token, trailer)?), deadline, token, trailer)
		FixtureAcceptEnd => Ok(finish_clean(summary))
		FixtureAcceptDeadlineExpired => Ok(finish_accept_deadline(summary))
		FixtureAcceptCancelled => Ok(finish_accept_cancelled(summary))
	end
end

fn empty_summary() -> { streams : Int, chunks : Int, ended : Int, writes : Int, end_actions : Int, retries : Int, cleanup : Int, clean_end : Bool, accept_cancelled : Int, accept_deadline : Int }
	{ streams: 0, chunks: 0, ended: 0, writes: 0, end_actions: 0, retries: 0, cleanup: 0, clean_end: false, accept_cancelled: 0, accept_deadline: 0 }
end

fn adapter_cleanup(listener: net::Listener, owner: CancelOwner, summary: { streams : Int, chunks : Int, ended : Int, writes : Int, end_actions : Int, retries : Int, cleanup : Int, clean_end : Bool, accept_cancelled : Int, accept_deadline : Int }) -> { streams : Int, chunks : Int, ended : Int, writes : Int, end_actions : Int, retries : Int, cleanup : Int, clean_end : Bool, accept_cancelled : Int, accept_deadline : Int } effects [net::IO, time]
	time::cancel_owned(owner)
	close_listener_value(listener)
	summary
end

fn request_adapter_cancel(owner: CancelOwner) -> () effects [time]
	time::cancel_owned(owner)
end

fn maybe_cancel_before_accept(owner: CancelOwner, cancel_first: Bool) -> () effects [time]
	if cancel_first
		request_adapter_cancel(owner)
	else
		()
	end
end

fn adapter_lifecycle(address: String, cancel_first: Bool, trailer: ByteChunk) -> Result<{ streams : Int, chunks : Int, ended : Int, writes : Int, end_actions : Int, retries : Int, cleanup : Int, clean_end : Bool, accept_cancelled : Int, accept_deadline : Int }, String> effects [net::IO, time, concurrency]
	let listener = open_listener(address)?
	let owner = time::cancel_owner()
	let token = time::cancel_token_from(owner)
	let deadline = time::deadline_after_ms(100)
	maybe_cancel_before_accept(owner, cancel_first)
	Ok(adapter_cleanup(listener, owner, drain_listener(listener, empty_summary(), deadline, token, trailer)?))
end

fn empty_midstream(read: String, trailer: ByteChunk) -> { read : String, actions : List<ResponseAction>, next_state : { chunks : Int, ended : Bool, trailer : ByteChunk } }
	{ read: read, actions: list_nil(), next_state: { chunks: 0, ended: false, trailer: trailer } }
end

fn close_midstream_listener(listener: net::Listener, owner: CancelOwner, routed: { read : String, actions : List<ResponseAction>, next_state : { chunks : Int, ended : Bool, trailer : ByteChunk } }) -> { read : String, actions : List<ResponseAction>, next_state : { chunks : Int, ended : Bool, trailer : ByteChunk } } effects [net::IO, time]
	time::cancel_owned(owner)
	close_listener_value(listener)
	routed
end

fn adapter_cancel_after_first_read(address: String, trailer: ByteChunk) -> Result<{ read : String, actions : List<ResponseAction>, next_state : { chunks : Int, ended : Bool, trailer : ByteChunk } }, String> effects [net::IO, time, concurrency]
	let listener = open_listener(address)?
	let owner = time::cancel_owner()
	let token = time::cancel_token_from(owner)
	let deadline = time::deadline_after_ms(100)
	match fixture_accept_with(listener, deadline, token)
		FixtureAcceptStream(stream) => Ok(close_midstream_listener(listener, owner, accepted_cancel_after_first_read(stream, deadline, owner, token, trailer)?))
		FixtureAcceptEnd => Ok(close_midstream_listener(listener, owner, empty_midstream("accept-end", trailer)))
		FixtureAcceptDeadlineExpired => Ok(close_midstream_listener(listener, owner, empty_midstream("accept-deadline", trailer)))
		FixtureAcceptCancelled => Ok(close_midstream_listener(listener, owner, empty_midstream("accept-cancelled", trailer)))
	end
end

fn print_summary(label: String, summary: { streams : Int, chunks : Int, ended : Int, writes : Int, end_actions : Int, retries : Int, cleanup : Int, clean_end : Bool, accept_cancelled : Int, accept_deadline : Int }) -> () effects [stdio]
	stdio::print(label)
	stdio::print("-streams ")
	stdio::print(int_to_string(summary.streams))
	stdio::print(" ")
	stdio::print(label)
	stdio::print("-chunks ")
	stdio::print(int_to_string(summary.chunks))
	stdio::print(" ")
	stdio::print(label)
	stdio::print("-ended ")
	stdio::print(int_to_string(summary.ended))
	stdio::print(" ")
	stdio::print(label)
	stdio::print("-writes ")
	stdio::print(int_to_string(summary.writes))
	stdio::print(" ")
	stdio::print(label)
	stdio::print("-end-actions ")
	stdio::print(int_to_string(summary.end_actions))
	stdio::print(" ")
	stdio::print(label)
	stdio::print("-retries ")
	stdio::print(int_to_string(summary.retries))
	stdio::print(" ")
	stdio::print(label)
	stdio::print("-cleanup ")
	stdio::print(int_to_string(summary.cleanup))
	stdio::print(" ")
	stdio::print(label)
	stdio::print("-clean-end ")
	stdio::print(bool_text(summary.clean_end))
	stdio::print(" ")
	stdio::print(label)
	stdio::print("-accept-cancelled ")
	stdio::print(int_to_string(summary.accept_cancelled))
	stdio::print(" ")
	stdio::print(label)
	stdio::print("-accept-deadline ")
	stdio::print(int_to_string(summary.accept_deadline))
end

fn print_midstream_summary(label: String, summary: { read : String, actions : List<ResponseAction>, next_state : { chunks : Int, ended : Bool, trailer : ByteChunk } }) -> () effects [stdio]
	stdio::print(label)
	stdio::print("-read ")
	stdio::print(summary.read)
	stdio::print(" ")
	stdio::print(label)
	stdio::print("-chunks ")
	stdio::print(int_to_string(summary.next_state.chunks))
	stdio::print(" ")
	stdio::print(label)
	stdio::print("-writes ")
	stdio::print(int_to_string(write_count(summary.actions)))
	stdio::print(" ")
	stdio::print(label)
	stdio::print("-cleanup ")
	stdio::print(int_to_string(cleanup_count(summary.actions)))
end

fn fixture_body() -> Result<(), String> effects [net::IO, time, concurrency, stdio]
	let success_trailer = byte_chunk_from_hex("a0")?
	let cancel_trailer = byte_chunk_from_hex("ff")?
	let midcancel_trailer = byte_chunk_from_hex("55")?
	let success = adapter_lifecycle("127.0.0.1:0", false, success_trailer)?
	let cancelled = adapter_lifecycle("127.0.0.1:0", true, cancel_trailer)?
	let midcancel = adapter_cancel_after_first_read("127.0.0.1:0", midcancel_trailer)?
	print_summary("success", success)
	stdio::print(" ")
	print_summary("cancel", cancelled)
	stdio::print(" ")
	print_midstream_summary("midcancel", midcancel)
	stdio::println("")
	Ok(())
end

pub fn main() -> Result<(), String> effects [concurrency, fs, net, stdio, time]
	let state = fixture_effects::create_fixture()
	handle handle handle fixture_body() with net::system() with fake_effects::network(state) with fake_effects::clock(state)
end

fn fixture_network_error(error: net::NetError) -> String
	match error
		net::NetError(_, _, _, _, message) => match string_split_once(message, "\n")
			Some(parts) => parts.left
			None => message
		end
	end
end

fn fixture_address(text: String) -> Result<net::Address, String>
	match net::split_host_port(text)
		Ok(parts) => Ok(net::Address(net::Tcp4, parts.host, parts.port))
		Err(error) => Err(fixture_network_error(error))
	end
end

fn close_listener_value(listener: net::Listener) -> () effects [net::IO]
	let _ = net::close_listener(listener)
	()
end

fn write_chunk_values(stream: net::Stream, chunks: List<ByteChunk>) -> () effects [net::IO]
	match chunks
		Nil => ()
		Cons(bytes, tail) => begin
			let _ = net::write_all(stream, bytes, None, None)
			write_chunk_values(stream, tail)
		end
	end
end

fn close_stream_value(stream: net::Stream) -> () effects [net::IO]
	let _ = net::close_stream(stream)
	()
end

fn open_listener(text: String) -> Result<net::Listener, String> effects [net::IO]
	match fixture_address(text)
		Ok(address) => match net::listen(address)
			Ok(listener) => Ok(listener)
			Err(error) => Err(fixture_network_error(error))
		end
		Err(message) => Err(message)
	end
end

fn open_stream(text: String) -> Result<net::Stream, String> effects [net::IO]
	match fixture_address(text)
		Ok(address) => match net::connect(address)
			Ok(stream) => Ok(stream)
			Err(error) => Err(fixture_network_error(error))
		end
		Err(message) => Err(message)
	end
end

fn accept_stream(listener: net::Listener) -> Result<net::Stream, String> effects [net::IO]
	match net::accept(listener)
		Ok(stream) => Ok(stream)
		Err(error) => Err(fixture_network_error(error))
	end
end
