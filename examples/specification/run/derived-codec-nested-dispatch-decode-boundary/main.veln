# Derived codec decode calls can use same-module nested dispatch helpers.
use stdio

schema SettingsPayload
	format binary

	code: UInt8
	value: UInt16be
end

schema ClosedNestedPacket
	format binary

	kind: UInt8
	payload: Dispatch(kind, 1 => SettingsPayload)
end

codec ClosedNestedCodec for ClosedNestedPacket decode
	derive decode
end

fn step_kind(step: DecodeStep<{kind: Int, payload: {code: Int, value: Int}}>) -> String
	match step
		Decoded(_, _) => "decoded"
		NeedMore(_) => "need_more"
		Invalid(_) => "invalid"
	end
end

fn payload_code(step: DecodeStep<{kind: Int, payload: {code: Int, value: Int}}>) -> Int
	match step
		Decoded(packet, _) => packet.payload.code
		NeedMore(_) => -1
		Invalid(_) => -1
	end
end

fn payload_value(step: DecodeStep<{kind: Int, payload: {code: Int, value: Int}}>) -> Int
	match step
		Decoded(packet, _) => packet.payload.value
		NeedMore(_) => -1
		Invalid(_) => -1
	end
end

fn consumed_count(step: DecodeStep<{kind: Int, payload: {code: Int, value: Int}}>) -> Int
	match step
		Decoded(_, consumed) => byte_count_to_int(consumed)
		NeedMore(_) => 0
		Invalid(_) => 0
	end
end

pub fn main() -> Result<(), String> effects [stdio]
	let bytes: ByteChunk = byte_chunk_from_hex("010700ff")?
	let view: ByteView = byte_view(bytes, byte_offset(0)?, byte_count(4)?)?
	let step: DecodeStep<{kind: Int, payload: {code: Int, value: Int}}> = ClosedNestedCodec(view, byte_offset(19)?)
	stdio::println(step_kind(step))
	stdio::println(int_to_string(payload_code(step)))
	stdio::println(int_to_string(payload_value(step)))
	stdio::println(int_to_string(consumed_count(step)))
	Ok(())
end
