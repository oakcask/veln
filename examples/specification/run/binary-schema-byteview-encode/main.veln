# Binary schema ByteView fields encode bytes selected by an explicit length.
use stdio

schema PacketWire
	format binary

	length: UInt8
	payload: ByteView(length)
end

fn emit_output_chunk(name: String, index: Int, chunk: ByteChunk, expected_hex: String) -> () effects [stdio]
	stdio::print("output_chunk ")
	stdio::print(name)
	stdio::print(" index ")
	stdio::print(int_to_string(index))
	stdio::print(" hex \"")
	stdio::print(expected_hex)
	stdio::print("\" count ")
	stdio::println(int_to_string(byte_count_to_int(byte_chunk_count(chunk))))
end

fn emit_output_chunk_list_header(name: String, count: Int) -> () effects [stdio]
	stdio::print("output_chunk_list ")
	stdio::print(name)
	stdio::print(" count ")
	stdio::println(int_to_string(count))
end

fn emit_encoded(bytes: ByteChunk) -> () effects [stdio]
	emit_output_chunk_list_header("byteview-packet", 1)
	emit_output_chunk("byteview-packet", 0, bytes, "03aabbcc")
end

pub fn main() -> Result<(), String> effects [stdio]
	let payload_bytes: ByteChunk = byte_chunk_from_hex("aabbcc")?
	let payload: ByteView = byte_view(payload_bytes, byte_offset(0)?, byte_count(3)?)?
	let encoded: Result<ByteChunk, EncodeError> = byte_encode_packet_wire({length: 3, payload: payload})
	let emitted: () = match encoded
		Ok(bytes) => emit_encoded(bytes)
		Err(_) => stdio::println("unexpected encode failure")
	end
	Ok(())
end
