use stdio

type Http2Flags
	Http2Flags(Flag8)
end

type FlagPacket
	FlagPacket {flags: Http2Flags}
end

schema FlagPacketWire
	format binary

	wire_flags: Flag8

	map to FlagPacket
		flags = Http2Flags(wire_flags)
end

fn emit_output_chunk(name: String, index: Int, chunk: ByteChunk, expected_hex: String) -> () effects [stdio]
	stdio::print("output_chunk ")
	stdio::print(name)
	stdio::print(" index ")
	stdio::print(int_to_string(index))
	stdio::print(" hex \"")
	stdio::print(expected_hex)
	stdio::print("\" count ")
	stdio::println(int_to_string(byte_count_to_int(byte_chunk_count(chunk))))
end

fn emit_encoded(bytes: ByteChunk) -> () effects [stdio]
	stdio::println("output_chunk_list constructor-flag-packet count 1")
	emit_output_chunk("constructor-flag-packet", 0, bytes, "28")
end

pub fn main() -> () effects [stdio]
	let encoded: Result<ByteChunk, EncodeError> = byte_encode_flag_packet_wire({flags: Http2Flags(Flag8(40))})
	match encoded
		Ok(bytes) => emit_encoded(bytes)
		Err(_) => stdio::println("unexpected encode failure")
	end
end
