# Binary schema ByteView payload multiple validation reports a focused human diagnostic.
schema PacketWire
	format binary

	length: UInt8
	payload: ByteView(length) where payload_count multiple of 4
end

pub fn main() -> Result<(), String>
	let bytes: ByteChunk = byte_chunk_from_hex("05aabbccddee")?
	let view: ByteView = byte_view(bytes, byte_offset(0)?, byte_count(6)?)?
	let ignored: {length: Int, payload: ByteView} = byte_decode_packet_wire(view)?
	Ok(())
end
