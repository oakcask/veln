use fixture_effects
use fake_effects

# Absolute monotonic deadlines at the current tick are already expired.
fn emit_read_result(result: Option<ByteChunk>) -> () effects [stdio]
	match result
		Some(_) => stdio::println("read")
		None => stdio::println("deadline")
	end
end

fn fixture_body() -> Result<(), String> effects [net, time, stdio]
	let listener = net::listen("127.0.0.1:0")
	let stream = net::accept(listener)
	let target_ms = time::monotonic_ms()
	let deadline = time::deadline_at_ms(target_ms)
	emit_read_result(net::read_chunk_until(stream, deadline))
	Ok(())
end

pub fn main() -> Result<(), String> effects [concurrency, fs, net, stdio, time]
	let state = fixture_effects::create_fixture()
	handle handle fixture_body() with fake_effects::network(state) with fake_effects::clock(state)
end
