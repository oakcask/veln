# Binary schema mapping can pass a structural record expression to an imported pure converter.
use stdio
use helpers

type Header
	Header {summary: Int, kind: Int}
end

schema HeaderWire
	format binary

	wire_length: UInt16be
	wire_kind: UInt8 where wire_kind <= wire_length

	map to Header
		summary = helpers::summary_value({kind: wire_kind, length: wire_length})
		kind = wire_kind
end

fn emit_header(header: {summary: Int, kind: Int}) -> () effects [stdio]
	stdio::print(int_to_string(header.summary))
	stdio::print(" ")
	stdio::println(int_to_string(header.kind))
end

pub fn main() -> Result<(), String> effects [stdio]
	let bytes: ByteChunk = byte_chunk_from_hex("123405")?
	let offset: ByteOffset = byte_offset(0)?
	let count: ByteCount = byte_count(3)?
	let view: ByteView = byte_view(bytes, offset, count)?
	let header: {summary: Int, kind: Int} = byte_decode_header_wire(view)?
	emit_header(header)
	Ok(())
end
