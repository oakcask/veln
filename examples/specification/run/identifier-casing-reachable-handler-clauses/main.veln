effect Ask
  value() -> Int
end

type item
  value(Int)
end

type other
  other_value(Int)
end

fn body() -> Int effects [Ask]
  perform Ask::value()
end

handler ask() for Ask
  value() => value(1)
end

handler unreachable() for Ask
  value() => other_value(1)
end

fn main() -> Int
  handle body() with ask()
end
