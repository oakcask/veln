# Direct unsupported-feature decode failures render focused human diagnostics.

schema ManualPacketWire
	format binary

	extension: ByteView(1)
	payload: ByteView(0)
end

fn offset(value: Int) -> ByteOffset
	byte_offset(value)?
end

pub fn main() -> Result<(), DecodeError>
	Err(DecodeErrorWithReason("codec.unsupported_feature", offset(27), "ManualPacketWire.extension", "feature=dynamic_table_size_update; reason=dynamic table size updates are disabled for this profile"))
end
