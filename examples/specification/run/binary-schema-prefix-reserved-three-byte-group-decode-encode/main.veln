use stdio

schema ThreeBytePrefixReservedGroupHeader
	format binary

	prefix: ReservedBits(9, 341)
	high: UInt8
	low: UInt7
end

fn encoded_value(chunk: ByteChunk) -> Result<Int, String>
	let view: ByteView = byte_view(chunk, byte_offset(0)?, byte_count(3)?)?
	byte_read_u24_be(view)
end

fn error_id(error: EncodeError) -> String
	match error
		EncodeError(id, _, _) => id
	end
end

fn error_path(error: EncodeError) -> String
	match error
		EncodeError(_, field_path, _) => field_path
	end
end

fn error_reason(error: EncodeError) -> String
	match error
		EncodeError(_, _, reason) => reason
	end
end

fn emit_error(error: EncodeError) -> () effects [stdio]
	stdio::println(error_id(error))
	stdio::println(error_path(error))
	stdio::println(error_reason(error))
end

fn emit_encoded_chunk(chunk: ByteChunk) -> Result<(), String> effects [stdio]
	stdio::println(int_to_string(encoded_value(chunk)?))
	Ok(())
end

fn emit_unexpected_encode_failure() -> Result<(), String> effects [stdio]
	stdio::println("unexpected encode failure")
	Ok(())
end

fn emit_encoded(encoded: Result<ByteChunk, EncodeError>) -> Result<(), String> effects [stdio]
	match encoded
		Ok(chunk) => emit_encoded_chunk(chunk)
		Err(_) => emit_unexpected_encode_failure()
	end
end

fn emit_encode_error(encoded: Result<ByteChunk, EncodeError>) -> () effects [stdio]
	match encoded
		Ok(_) => stdio::println("unexpected encode success")
		Err(error) => emit_error(error)
	end
end

pub fn main() -> Result<(), String> effects [stdio]
	let bytes: ByteChunk = byte_chunk_from_hex("aad5aa")?
	let view: ByteView = byte_view(bytes, byte_offset(0)?, byte_count(3)?)?
	let decoded: {high: Int, low: Int} = byte_decode_three_byte_prefix_reserved_group_header(view)?
	stdio::println(int_to_string(decoded.high))
	stdio::println(int_to_string(decoded.low))

	let encoded: Result<ByteChunk, EncodeError> = byte_encode_three_byte_prefix_reserved_group_header({high: 171, low: 42})
	let ignored: () = emit_encoded(encoded)?

	let rejected_high: Result<ByteChunk, EncodeError> = byte_encode_three_byte_prefix_reserved_group_header({high: 256, low: 42})
	emit_encode_error(rejected_high)

	let rejected_low: Result<ByteChunk, EncodeError> = byte_encode_three_byte_prefix_reserved_group_header({high: 171, low: 128})
	emit_encode_error(rejected_low)
	Ok(())
end
