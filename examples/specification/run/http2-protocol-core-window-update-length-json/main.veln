use http2::frame from "std"
use http2::diagnostic from "std"
# HTTP/2 WINDOW_UPDATE payload length failures project structured runtime details.

type Http2ProtocolFailure
	InvalidPayloadLength {offset: Int, frame_kind: Int, stream_id: Int, observed_length: Int, expected_length: Int, preview: ByteView}
end

type Http2DiagnosticContext
	DiagnosticContext(String, String)
end

fn context_active_state(context: Http2DiagnosticContext) -> String
	match context
		DiagnosticContext(active_state, _) => active_state
	end
end

fn context_rule_provenance(context: Http2DiagnosticContext) -> String
	match context
		DiagnosticContext(_, rule_provenance) => rule_provenance
	end
end

fn invalid_payload(error: String) -> RuntimeDiagnostic
	RuntimeDiagnostic(
		"http2.protocol.invalid_payload_length",
		error,
		RuntimeHttp2Diagnostic(RuntimeHttp2ProtocolInvalidPayloadLengthDiagnostic(9, 8, 0, 3, 4, "connection-flow-control", "rfc9113_window_update_payload_length", byte_chunk([])))
	)
end

fn payload_length_payload(offset: Int, frame_kind: Int, stream_id: Int, observed_length: Int, expected_length: Int, context: Http2DiagnosticContext, preview: ByteView) -> RuntimeDiagnostic
	RuntimeDiagnostic(
		"http2.protocol.invalid_payload_length",
		"HTTP/2 invalid payload length at byte offset 9",
		RuntimeHttp2Diagnostic(RuntimeHttp2ProtocolInvalidPayloadLengthDiagnostic(offset, frame_kind, stream_id, observed_length, expected_length, context_active_state(context), context_rule_provenance(context), byte_view_to_chunk(preview)))
	)
end

fn http2_protocol_diagnostic(failure: Http2ProtocolFailure, context: Http2DiagnosticContext) -> Result<(), RuntimeDiagnostic>
	match failure
		InvalidPayloadLength(offset, frame_kind, stream_id, observed_length, expected_length, preview) => Err(payload_length_payload(offset, frame_kind, stream_id, observed_length, expected_length, context, preview))
	end
end

fn input_bytes() -> Result<ByteChunk, RuntimeDiagnostic>
	match byte_chunk_from_hex("000003080000000000010203")
		Ok(bytes) => Ok(bytes)
		Err(error) => Err(invalid_payload(error))
	end
end

fn input_view(bytes: ByteChunk) -> Result<ByteView, RuntimeDiagnostic>
	match byte_offset(0)
		Ok(offset) => match byte_view(bytes, offset, byte_chunk_count(bytes))
			Ok(view) => Ok(view)
			Err(error) => Err(invalid_payload(error))
		end
		Err(error) => Err(invalid_payload(error))
	end
end

fn decode_frame(view: ByteView) -> Result<{length: Int, kind: Int, flags: Int, stream_id: Int, payload: ByteView}, RuntimeDiagnostic>
	match http2::frame::decode(view)
		Ok(frame) => Ok(frame)
		Err(error) => Err(invalid_payload(error))
	end
end

pub fn main() -> Result<(), RuntimeDiagnostic>
	let context: Http2DiagnosticContext = DiagnosticContext("connection-flow-control", "rfc9113_window_update_payload_length")
	let bytes: ByteChunk = input_bytes()?
	let view: ByteView = input_view(bytes)?
	let frame: {length: Int, kind: Int, flags: Int, stream_id: Int, payload: ByteView} = decode_frame(view)?
	http2_protocol_diagnostic(InvalidPayloadLength(9, frame.kind, frame.stream_id, frame.length, 4, frame.payload), context)
end
