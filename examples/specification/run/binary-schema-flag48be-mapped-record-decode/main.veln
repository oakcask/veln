# Binary schema mapping can carry a Flag48be field into a target record.
use stdio

type FlagPacket
	FlagPacket {target_flags: Flag48be}
end

schema FlagPacketWire
	format binary

	flags: Flag48be

	map to FlagPacket
		target_flags = flags
end

fn flag_bits(flags: Flag48be) -> Int
	match flags
		Flag48be(bits) => bits
	end
end

pub fn main() -> Result<(), String> effects [stdio]
	let bytes: ByteChunk = byte_chunk_from_hex("123456789abc")?
	let view: ByteView = byte_view(bytes, byte_offset(0)?, byte_count(6)?)?
	let packet: {target_flags: Flag48be} = byte_decode_flag_packet_wire(view)?
	stdio::println(int_to_string(flag_bits(packet.target_flags)))
	Ok(())
end
