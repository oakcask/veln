use net from "std"
use fixture_effects
use fake_effects
# Production loopback adapter cancels and reclaims pending stream tasks after failure.
use stdio

type ResponseAction
	SendBytes(bytes: ByteChunk)
end

type HandlerOutput
	Handled(actions: List<ResponseAction>, accepted: Int)
end

type PendingWork
	Pending(stream: net::Stream, task: Task<Result<HandlerOutput, String>>, accepted: Int, tail: PendingWork)
	Drained
end

fn handle_stream(context: { input : StreamInput, accepted : Int }) -> Result<HandlerOutput, String>
	match context.accepted
		2 => Err("handler rejected second stream")
		_ => match context.input
			Chunk(bytes) => Ok(Handled(list_cons(SendBytes(bytes), list_nil()), context.accepted))
			End => Err("missing stream chunk")
		end
	end
end

fn run_handler_task(context: { input : StreamInput, accepted : Int, gate : Receiver<()> }) -> Result<HandlerOutput, String> effects [concurrency]
	match context.accepted
		1 => handle_stream({ input: context.input, accepted: context.accepted })
		2 => handle_stream({ input: context.input, accepted: context.accepted })
		_ => match channel::recv(context.gate)
			Some(_) => handle_stream({ input: context.input, accepted: context.accepted })
			None => Err("handler task cancelled")
		end
	end
end

fn read_stream_input(stream: net::Stream) -> StreamInput effects [net::IO]
	match read_chunk_optional(stream)
		Some(bytes) => Chunk(bytes)
		None => End
	end
end

fn spawn_stream_handler(stream: net::Stream, accepted: Int) -> Task<Result<HandlerOutput, String>> effects [net::IO, concurrency]
	let gate = channel::bounded<()>(0)
	let context = { input: read_stream_input(stream), accepted: accepted, gate: gate.rx }
	task::spawn_with<Result<HandlerOutput, String>, {input:StreamInput, accepted:Int, gate:Receiver<()>}>(run_handler_task, context)
end

fn accept_pending(listener: net::Listener, accepted: Int) -> PendingWork effects [net::IO, concurrency]
	match accept_optional(listener)
		Some(stream) => Pending(stream, spawn_stream_handler(stream, accepted), accepted, accept_pending(listener, accepted + 1))
		None => Drained
	end
end

fn ordered_send_chunks(actions: List<ResponseAction>) -> List<ByteChunk>
	match actions
		Nil => list_nil()
		Cons(action, tail) => match action
			SendBytes(bytes) => list_cons(bytes, ordered_send_chunks(tail))
		end
	end
end

fn add_summary(head: { drained : Int, successes : Int, failures : Int, cancelled : Int, reclaimed : Int, closed : Int }, tail: { drained : Int, successes : Int, failures : Int, cancelled : Int, reclaimed : Int, closed : Int }) -> { drained : Int, successes : Int, failures : Int, cancelled : Int, reclaimed : Int, closed : Int }
	{ drained: head.drained + tail.drained, successes: head.successes + tail.successes, failures: head.failures + tail.failures, cancelled: head.cancelled + tail.cancelled, reclaimed: head.reclaimed + tail.reclaimed, closed: head.closed + tail.closed }
end

fn cancel_reclaim_close(pending: PendingWork) -> { drained : Int, successes : Int, failures : Int, cancelled : Int, reclaimed : Int, closed : Int } effects [net::IO, concurrency]
	match pending
		Pending(stream, worker, _, tail) => cancel_reclaim_one(stream, worker, tail)
		Drained => { drained: 0, successes: 0, failures: 0, cancelled: 0, reclaimed: 0, closed: 0 }
	end
end

fn cancel_reclaim_one(stream: net::Stream, worker: Task<Result<HandlerOutput, String>>, tail: PendingWork) -> { drained : Int, successes : Int, failures : Int, cancelled : Int, reclaimed : Int, closed : Int } effects [net::IO, concurrency]
	task::cancel(worker)
	let _ = task::join(worker)
	close_stream_value(stream)
	add_summary({ drained: 1, successes: 0, failures: 0, cancelled: 1, reclaimed: 1, closed: 1 }, cancel_reclaim_close(tail))
end

fn apply_success(stream: net::Stream, output: HandlerOutput, tail: PendingWork) -> { drained : Int, successes : Int, failures : Int, cancelled : Int, reclaimed : Int, closed : Int } effects [net::IO, concurrency]
	match output
		Handled(actions, _) => write_close_continue(stream, actions, tail)
	end
end

fn write_close_continue(stream: net::Stream, actions: List<ResponseAction>, tail: PendingWork) -> { drained : Int, successes : Int, failures : Int, cancelled : Int, reclaimed : Int, closed : Int } effects [net::IO, concurrency]
	write_chunk_values(stream, ordered_send_chunks(actions))
	close_stream_value(stream)
	add_summary({ drained: 1, successes: 1, failures: 0, cancelled: 0, reclaimed: 0, closed: 1 }, drain_until_failure(tail))
end

fn fail_close_cancel_tail(stream: net::Stream, tail: PendingWork) -> { drained : Int, successes : Int, failures : Int, cancelled : Int, reclaimed : Int, closed : Int } effects [net::IO, concurrency]
	close_stream_value(stream)
	add_summary({ drained: 1, successes: 0, failures: 1, cancelled: 0, reclaimed: 0, closed: 1 }, cancel_reclaim_close(tail))
end

fn drain_until_failure(pending: PendingWork) -> { drained : Int, successes : Int, failures : Int, cancelled : Int, reclaimed : Int, closed : Int } effects [net::IO, concurrency]
	match pending
		Pending(stream, worker, _, tail) => match task::join(worker)
			Ok(Ok(output)) => apply_success(stream, output, tail)
			Ok(Err(_)) => fail_close_cancel_tail(stream, tail)
			Err(_) => fail_close_cancel_tail(stream, tail)
		end
		Drained => { drained: 0, successes: 0, failures: 0, cancelled: 0, reclaimed: 0, closed: 0 }
	end
end

fn fixture_body() -> Result<(), String> effects [net::IO, concurrency, stdio]
	let listener = open_listener("127.0.0.1:0")?
	let pending = accept_pending(listener, 1)
	close_listener_value(listener)
	let summary = drain_until_failure(pending)
	stdio::print("drained ")
	stdio::print(int_to_string(summary.drained))
	stdio::print(" successes ")
	stdio::print(int_to_string(summary.successes))
	stdio::print(" failures ")
	stdio::print(int_to_string(summary.failures))
	stdio::print(" cancelled ")
	stdio::print(int_to_string(summary.cancelled))
	stdio::print(" reclaimed ")
	stdio::print(int_to_string(summary.reclaimed))
	stdio::print(" closed ")
	stdio::println(int_to_string(summary.closed))
	Ok(())
end

pub fn main() -> Result<(), String> effects [time, concurrency, fs, net, stdio]
	let state = fixture_effects::create_fixture()
	handle handle handle fixture_body() with net::system() with fake_effects::network(state) with fake_effects::clock(state)
end

fn fixture_network_error(error: net::NetError) -> String
	match error
		net::NetError(_, _, _, _, message) => match string_split_once(message, "\n")
			Some(parts) => parts.left
			None => message
		end
	end
end

fn fixture_address(text: String) -> Result<net::Address, String>
	match net::split_host_port(text)
		Ok(parts) => Ok(net::Address(net::Tcp4, parts.host, parts.port))
		Err(error) => Err(fixture_network_error(error))
	end
end

fn read_chunk_optional(stream: net::Stream) -> Option<ByteChunk> effects [net::IO]
	match net::read(stream)
		Ok(net::ReadChunk(bytes)) => Some(bytes)
		_ => None
	end
end

fn close_listener_value(listener: net::Listener) -> () effects [net::IO]
	let _ = net::close_listener(listener)
	()
end

fn accept_optional(listener: net::Listener) -> Option<net::Stream> effects [net::IO]
	match net::accept(listener)
		Ok(stream) => Some(stream)
		Err(_) => None
	end
end

fn write_chunk_values(stream: net::Stream, chunks: List<ByteChunk>) -> () effects [net::IO]
	match chunks
		Nil => ()
		Cons(bytes, tail) => begin
			let _ = net::write_all(stream, bytes, None, None)
			write_chunk_values(stream, tail)
		end
	end
end

fn close_stream_value(stream: net::Stream) -> () effects [net::IO]
	let _ = net::close_stream(stream)
	()
end

fn open_listener(text: String) -> Result<net::Listener, String> effects [net::IO]
	match fixture_address(text)
		Ok(address) => match net::listen(address)
			Ok(listener) => Ok(listener)
			Err(error) => Err(fixture_network_error(error))
		end
		Err(message) => Err(message)
	end
end

fn open_stream(text: String) -> Result<net::Stream, String> effects [net::IO]
	match fixture_address(text)
		Ok(address) => match net::connect(address)
			Ok(stream) => Ok(stream)
			Err(error) => Err(fixture_network_error(error))
		end
		Err(message) => Err(message)
	end
end

fn accept_stream(listener: net::Listener) -> Result<net::Stream, String> effects [net::IO]
	match net::accept(listener)
		Ok(stream) => Ok(stream)
		Err(error) => Err(fixture_network_error(error))
	end
end
