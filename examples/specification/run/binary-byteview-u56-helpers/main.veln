# ByteView u56 helpers read and write source-visible Int values.
use stdio

fn int_result_text(result: Result<Int, String>) -> String
	match result
		Ok(value) => int_to_string(value)
		Err(error) => error
	end
end

fn chunk_result_text(result: Result<ByteChunk, String>) -> String
	match result
		Ok(chunk) => int_to_string(byte_count_to_int(byte_chunk_count(chunk)))
		Err(error) => error
	end
end

fn emit_output_chunk(name: String, index: Int, chunk: ByteChunk, expected_hex: String) -> () effects [stdio]
	stdio::print("output_chunk ")
	stdio::print(name)
	stdio::print(" index ")
	stdio::print(int_to_string(index))
	stdio::print(" hex \"")
	stdio::print(expected_hex)
	stdio::print("\" count ")
	stdio::println(int_to_string(byte_count_to_int(byte_chunk_count(chunk))))
end

fn emit_output_chunk_list_header(name: String, count: Int) -> () effects [stdio]
	stdio::print("output_chunk_list ")
	stdio::print(name)
	stdio::print(" count ")
	stdio::println(int_to_string(count))
end

fn emit_written(name: String, chunk: ByteChunk, expected_hex: String) -> () effects [stdio]
	emit_output_chunk_list_header(name, 1)
	emit_output_chunk(name, 0, chunk, expected_hex)
end

pub fn main() -> Result<(), String> effects [stdio]
	let chunk: ByteChunk = byte_chunk_from_hex("0102030405060707060504030201")?
	let max_chunk: ByteChunk = byte_chunk_from_hex("ffffffffffffff")?
	let zero_offset: ByteOffset = byte_offset(0)?
	let seven: ByteCount = byte_count(7)?
	let big_view: ByteView = byte_view(chunk, zero_offset, seven)?
	let little_view: ByteView = byte_view(chunk, byte_offset(7)?, seven)?
	let max_view: ByteView = byte_view(max_chunk, zero_offset, seven)?
	let big_value: Int = byte_read_u56_be(big_view)?
	let little_value: Int = byte_read_u56_le(little_view)?
	let max_value: Int = byte_read_u56_be(max_view)?
	stdio::print("u56-read ")
	stdio::print(int_to_string(big_value))
	stdio::print(" ")
	stdio::println(int_to_string(little_value))
	stdio::print("u56-max ")
	stdio::println(int_to_string(max_value))
	emit_written("u56-big", byte_write_u56_be(big_value)?, "01020304050607")
	emit_written("u56-little", byte_write_u56_le(little_value)?, "07060504030201")
	emit_written("u56-max-big", byte_write_u56_be(72057594037927935)?, "ffffffffffffff")
	emit_written("u56-max-little", byte_write_u56_le(72057594037927935)?, "ffffffffffffff")
	stdio::println(chunk_result_text(byte_write_u56_be(72057594037927936)))
	stdio::println(chunk_result_text(byte_write_u56_le(-1)))
	stdio::println(int_result_text(byte_read_u56_be(byte_view(chunk, zero_offset, byte_count(6)?)?)))
	stdio::println(int_result_text(byte_read_u56_le(byte_view(chunk, zero_offset, byte_count(6)?)?)))
	Ok(())
end
