use net from "std"
use fixture_effects
use fake_effects
use stdio

type FixtureReadOutcome
	FixtureReadChunk(bytes: ByteChunk)
	FixtureReadEnd
	FixtureReadDeadlineExpired
	FixtureReadCancelled
end

type FixtureAcceptOutcome
	FixtureAcceptStream(stream: net::Stream)
	FixtureAcceptEnd
	FixtureAcceptDeadlineExpired
	FixtureAcceptCancelled
end

fn fixture_read_with(stream: net::Stream, deadline: Deadline, token: CancelToken) -> FixtureReadOutcome effects [net::IO]
	match net::read_with(stream, Some(deadline), Some(token))
		Ok(net::ReadChunk(bytes)) => FixtureReadChunk(bytes)
		Ok(net::ReadEnd) => FixtureReadEnd
		Err(net::NetError(_, _, _, net::TimedOut, _)) => FixtureReadDeadlineExpired
		Err(net::NetError(_, _, _, net::Cancelled, _)) => FixtureReadCancelled
		Err(_) => FixtureReadEnd
	end
end

fn fixture_accept_with(listener: net::Listener, deadline: Deadline, token: CancelToken) -> FixtureAcceptOutcome effects [net::IO]
	match net::accept_with(listener, Some(deadline), Some(token))
		Ok(stream) => FixtureAcceptStream(stream)
		Err(net::NetError(_, _, _, net::TimedOut, _)) => FixtureAcceptDeadlineExpired
		Err(net::NetError(_, _, _, net::Cancelled, _)) => FixtureAcceptCancelled
		Err(_) => FixtureAcceptEnd
	end
end
# Production loopback cancellable deadline lifecycle owns transport handles in the adapter.

type ResponseAction
	SendBytes(bytes: ByteChunk)
	EndStream
	RetryAfterDeadline
	CleanupAfterCancel
end

fn handle_stream_input(input: StreamInput, state: { chunks : Int, ended : Bool }) -> { actions : List<ResponseAction>, next_state : { chunks : Int, ended : Bool } }
	match input
		Chunk(bytes) => { actions: list_cons(SendBytes(bytes), list_nil()), next_state: { chunks: state.chunks + 1, ended: state.ended } }
		End => { actions: list_cons(EndStream, list_nil()), next_state: { chunks: state.chunks, ended: true } }
	end
end

fn append_actions(left: List<ResponseAction>, right: List<ResponseAction>) -> List<ResponseAction>
	match left
		Nil => right
		Cons(action, tail) => list_cons(action, append_actions(tail, right))
	end
end

fn write_count(actions: List<ResponseAction>) -> Int
	match actions
		Nil => 0
		Cons(action, tail) => match action
			SendBytes(_) => 1 + write_count(tail)
			EndStream => write_count(tail)
			RetryAfterDeadline => write_count(tail)
			CleanupAfterCancel => write_count(tail)
		end
	end
end

fn end_count(actions: List<ResponseAction>) -> Int
	match actions
		Nil => 0
		Cons(action, tail) => match action
			SendBytes(_) => end_count(tail)
			EndStream => 1 + end_count(tail)
			RetryAfterDeadline => end_count(tail)
			CleanupAfterCancel => end_count(tail)
		end
	end
end

fn retry_count(actions: List<ResponseAction>) -> Int
	match actions
		Nil => 0
		Cons(action, tail) => match action
			SendBytes(_) => retry_count(tail)
			EndStream => retry_count(tail)
			RetryAfterDeadline => 1 + retry_count(tail)
			CleanupAfterCancel => retry_count(tail)
		end
	end
end

fn cleanup_count(actions: List<ResponseAction>) -> Int
	match actions
		Nil => 0
		Cons(action, tail) => match action
			SendBytes(_) => cleanup_count(tail)
			EndStream => cleanup_count(tail)
			RetryAfterDeadline => cleanup_count(tail)
			CleanupAfterCancel => 1 + cleanup_count(tail)
		end
	end
end

fn bool_text(value: Bool) -> String
	if value
		"true"
	else
		"false"
	end
end

fn bool_count(value: Bool) -> Int
	if value
		1
	else
		0
	end
end

fn route_input(route: { tx : Sender<StreamInput>, rx : Receiver<StreamInput> }, input: StreamInput) -> StreamInput effects [concurrency]
	let _ = channel::send(route.tx, input)
	match channel::recv(route.rx)
		Some(value) => value
		None => End
	end
end

fn read_response(route: { tx : Sender<StreamInput>, rx : Receiver<StreamInput> }, outcome: FixtureReadOutcome, state: { chunks : Int, ended : Bool }) -> { actions : List<ResponseAction>, next_state : { chunks : Int, ended : Bool } } effects [concurrency]
	match outcome
		FixtureReadChunk(bytes) => handle_stream_input(route_input(route, Chunk(bytes)), state)
		FixtureReadEnd => handle_stream_input(route_input(route, End), state)
		FixtureReadDeadlineExpired => { actions: list_cons(RetryAfterDeadline, list_nil()), next_state: state }
		FixtureReadCancelled => { actions: list_cons(CleanupAfterCancel, list_nil()), next_state: state }
	end
end

fn append_collected_actions(left: { actions : List<ResponseAction>, next_state : { chunks : Int, ended : Bool } }, right: { actions : List<ResponseAction>, next_state : { chunks : Int, ended : Bool } }) -> { actions : List<ResponseAction>, next_state : { chunks : Int, ended : Bool } }
	{ actions: append_actions(left.actions, right.actions), next_state: right.next_state }
end

fn collect_stream_actions_until_end(stream: net::Stream, route: { tx : Sender<StreamInput>, rx : Receiver<StreamInput> }, state: { chunks : Int, ended : Bool }, deadline: Deadline, token: CancelToken) -> { actions : List<ResponseAction>, next_state : { chunks : Int, ended : Bool } } effects [net::IO, time, concurrency]
	let outcome = fixture_read_with(stream, deadline, token)
	let handled = read_response(route, outcome, state)
	match outcome
		FixtureReadChunk(_) => append_collected_actions(handled, collect_stream_actions_until_end(stream, route, handled.next_state, deadline, token))
		FixtureReadEnd => handled
		FixtureReadDeadlineExpired => handled
		FixtureReadCancelled => handled
	end
end

fn collect_stream_actions(stream: net::Stream, deadline: Deadline, token: CancelToken) -> { actions : List<ResponseAction>, next_state : { chunks : Int, ended : Bool } } effects [net::IO, time, concurrency]
	let route = channel::bounded<StreamInput>(1)
	collect_stream_actions_until_end(stream, route, { chunks: 0, ended: false }, deadline, token)
end

fn apply_response_actions(stream: net::Stream, actions: List<ResponseAction>) -> () effects [net::IO]
	match actions
		Nil => ()
		Cons(action, tail) => match action
			SendBytes(bytes) => write_then_apply(stream, bytes, tail)
			EndStream => apply_response_actions(stream, tail)
			RetryAfterDeadline => apply_response_actions(stream, tail)
			CleanupAfterCancel => apply_response_actions(stream, tail)
		end
	end
end

fn write_then_apply(stream: net::Stream, bytes: ByteChunk, tail: List<ResponseAction>) -> () effects [net::IO]
	write_chunk_value(stream, bytes)
	apply_response_actions(stream, tail)
end

fn close_after_apply(stream: net::Stream, actions: List<ResponseAction>) -> () effects [net::IO]
	apply_response_actions(stream, actions)
	close_stream_value(stream)
end

fn accepted_lifecycle(stream: net::Stream, deadline: Deadline, token: CancelToken) -> Result<{ actions : List<ResponseAction>, next_state : { chunks : Int, ended : Bool } }, String> effects [net::IO, time, concurrency]
	let routed = collect_stream_actions(stream, deadline, token)
	close_after_apply(stream, routed.actions)
	Ok(routed)
end

fn add_stream_summary(summary: { streams : Int, chunks : Int, ended : Int, writes : Int, end_actions : Int, retries : Int, cleanup : Int, clean_end : Bool }, routed: { actions : List<ResponseAction>, next_state : { chunks : Int, ended : Bool } }) -> { streams : Int, chunks : Int, ended : Int, writes : Int, end_actions : Int, retries : Int, cleanup : Int, clean_end : Bool }
	{ streams: summary.streams + 1, chunks: summary.chunks + routed.next_state.chunks, ended: summary.ended + bool_count(routed.next_state.ended), writes: summary.writes + write_count(routed.actions), end_actions: summary.end_actions + end_count(routed.actions), retries: summary.retries + retry_count(routed.actions), cleanup: summary.cleanup + cleanup_count(routed.actions), clean_end: false }
end

fn finish_summary(summary: { streams : Int, chunks : Int, ended : Int, writes : Int, end_actions : Int, retries : Int, cleanup : Int, clean_end : Bool }) -> { streams : Int, chunks : Int, ended : Int, writes : Int, end_actions : Int, retries : Int, cleanup : Int, clean_end : Bool }
	{ streams: summary.streams, chunks: summary.chunks, ended: summary.ended, writes: summary.writes, end_actions: summary.end_actions, retries: summary.retries, cleanup: summary.cleanup, clean_end: true }
end

fn drain_listener(listener: net::Listener, summary: { streams : Int, chunks : Int, ended : Int, writes : Int, end_actions : Int, retries : Int, cleanup : Int, clean_end : Bool }, deadline: Deadline, token: CancelToken) -> Result<{ streams : Int, chunks : Int, ended : Int, writes : Int, end_actions : Int, retries : Int, cleanup : Int, clean_end : Bool }, String> effects [net::IO, time, concurrency]
	match fixture_accept_with(listener, deadline, token)
		FixtureAcceptStream(stream) => drain_listener(listener, add_stream_summary(summary, accepted_lifecycle(stream, deadline, token)?), deadline, token)
		FixtureAcceptEnd => close_listener_then_finish(listener, summary)
		FixtureAcceptDeadlineExpired => Ok(summary)
		FixtureAcceptCancelled => Ok(summary)
	end
end

fn close_listener_then_finish(listener: net::Listener, summary: { streams : Int, chunks : Int, ended : Int, writes : Int, end_actions : Int, retries : Int, cleanup : Int, clean_end : Bool }) -> Result<{ streams : Int, chunks : Int, ended : Int, writes : Int, end_actions : Int, retries : Int, cleanup : Int, clean_end : Bool }, String> effects [net::IO]
	close_listener_value(listener)
	Ok(finish_summary(summary))
end

fn empty_summary() -> { streams : Int, chunks : Int, ended : Int, writes : Int, end_actions : Int, retries : Int, cleanup : Int, clean_end : Bool }
	{ streams: 0, chunks: 0, ended: 0, writes: 0, end_actions: 0, retries: 0, cleanup: 0, clean_end: false }
end

fn fixture_body() -> Result<(), String> effects [net::IO, time, concurrency, stdio]
	let listener = open_listener("127.0.0.1:0")?
	let deadline = time::deadline_after_ms(100)
	let token = time::cancel_token()
	let summary = drain_listener(listener, empty_summary(), deadline, token)?
	stdio::print("streams ")
	stdio::print(int_to_string(summary.streams))
	stdio::print(" chunks ")
	stdio::print(int_to_string(summary.chunks))
	stdio::print(" ended ")
	stdio::print(int_to_string(summary.ended))
	stdio::print(" writes ")
	stdio::print(int_to_string(summary.writes))
	stdio::print(" end-actions ")
	stdio::print(int_to_string(summary.end_actions))
	stdio::print(" retries ")
	stdio::print(int_to_string(summary.retries))
	stdio::print(" cleanup ")
	stdio::print(int_to_string(summary.cleanup))
	stdio::print(" clean-end ")
	stdio::println(bool_text(summary.clean_end))
	Ok(())
end

pub fn main() -> Result<(), String> effects [concurrency, fs, net, stdio, time]
	let state = fixture_effects::create_fixture()
	handle handle handle fixture_body() with net::system() with fake_effects::network(state) with fake_effects::clock(state)
end

fn fixture_network_error(error: net::NetError) -> String
	match error
		net::NetError(_, _, _, _, message) => match string_split_once(message, "\n")
			Some(parts) => parts.left
			None => message
		end
	end
end

fn fixture_address(text: String) -> Result<net::Address, String>
	match net::split_host_port(text)
		Ok(parts) => Ok(net::Address(net::Tcp4, parts.host, parts.port))
		Err(error) => Err(fixture_network_error(error))
	end
end

fn close_listener_value(listener: net::Listener) -> () effects [net::IO]
	let _ = net::close_listener(listener)
	()
end

fn close_stream_value(stream: net::Stream) -> () effects [net::IO]
	let _ = net::close_stream(stream)
	()
end

fn write_chunk_value(stream: net::Stream, bytes: ByteChunk) -> () effects [net::IO]
	let _ = net::write(stream, bytes)
	()
end

fn open_listener(text: String) -> Result<net::Listener, String> effects [net::IO]
	match fixture_address(text)
		Ok(address) => match net::listen(address)
			Ok(listener) => Ok(listener)
			Err(error) => Err(fixture_network_error(error))
		end
		Err(message) => Err(message)
	end
end

fn open_stream(text: String) -> Result<net::Stream, String> effects [net::IO]
	match fixture_address(text)
		Ok(address) => match net::connect(address)
			Ok(stream) => Ok(stream)
			Err(error) => Err(fixture_network_error(error))
		end
		Err(message) => Err(message)
	end
end

fn accept_stream(listener: net::Listener) -> Result<net::Stream, String> effects [net::IO]
	match net::accept(listener)
		Ok(stream) => Ok(stream)
		Err(error) => Err(fixture_network_error(error))
	end
end
