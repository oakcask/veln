# Production loopback cancellable deadline lifecycle owns transport handles in the adapter.
use stdio

type ResponseAction
	SendBytes(bytes: ByteChunk)
	EndStream
	RetryAfterDeadline
	CleanupAfterCancel
end

fn handle_stream_input(input: StreamInput, state: { chunks : Int, ended : Bool }) -> { actions : List<ResponseAction>, next_state : { chunks : Int, ended : Bool } }
	match input
		Chunk(bytes) => { actions: list_cons(SendBytes(bytes), list_nil()), next_state: { chunks: state.chunks + 1, ended: state.ended } }
		End => { actions: list_cons(EndStream, list_nil()), next_state: { chunks: state.chunks, ended: true } }
	end
end

fn append_actions(left: List<ResponseAction>, right: List<ResponseAction>) -> List<ResponseAction>
	match left
		Nil => right
		Cons(action, tail) => list_cons(action, append_actions(tail, right))
	end
end

fn write_count(actions: List<ResponseAction>) -> Int
	match actions
		Nil => 0
		Cons(action, tail) => match action
			SendBytes(_) => 1 + write_count(tail)
			EndStream => write_count(tail)
			RetryAfterDeadline => write_count(tail)
			CleanupAfterCancel => write_count(tail)
		end
	end
end

fn end_count(actions: List<ResponseAction>) -> Int
	match actions
		Nil => 0
		Cons(action, tail) => match action
			SendBytes(_) => end_count(tail)
			EndStream => 1 + end_count(tail)
			RetryAfterDeadline => end_count(tail)
			CleanupAfterCancel => end_count(tail)
		end
	end
end

fn retry_count(actions: List<ResponseAction>) -> Int
	match actions
		Nil => 0
		Cons(action, tail) => match action
			SendBytes(_) => retry_count(tail)
			EndStream => retry_count(tail)
			RetryAfterDeadline => 1 + retry_count(tail)
			CleanupAfterCancel => retry_count(tail)
		end
	end
end

fn cleanup_count(actions: List<ResponseAction>) -> Int
	match actions
		Nil => 0
		Cons(action, tail) => match action
			SendBytes(_) => cleanup_count(tail)
			EndStream => cleanup_count(tail)
			RetryAfterDeadline => cleanup_count(tail)
			CleanupAfterCancel => 1 + cleanup_count(tail)
		end
	end
end

fn bool_text(value: Bool) -> String
	if value
		"true"
	else
		"false"
	end
end

fn bool_count(value: Bool) -> Int
	if value
		1
	else
		0
	end
end

fn route_input(route: { tx : Sender<StreamInput>, rx : Receiver<StreamInput> }, input: StreamInput) -> StreamInput effects [concurrency]
	let _ = channel::send(route.tx, input)
	match channel::recv(route.rx)
		Some(value) => value
		None => End
	end
end

fn read_response(route: { tx : Sender<StreamInput>, rx : Receiver<StreamInput> }, outcome: StreamReadOutcome, state: { chunks : Int, ended : Bool }) -> { actions : List<ResponseAction>, next_state : { chunks : Int, ended : Bool } } effects [concurrency]
	match outcome
		ReadChunk(bytes) => handle_stream_input(route_input(route, Chunk(bytes)), state)
		ReadEnd => handle_stream_input(route_input(route, End), state)
		ReadDeadlineExpired => { actions: list_cons(RetryAfterDeadline, list_nil()), next_state: state }
		ReadCancelled => { actions: list_cons(CleanupAfterCancel, list_nil()), next_state: state }
	end
end

fn append_collected_actions(left: { actions : List<ResponseAction>, next_state : { chunks : Int, ended : Bool } }, right: { actions : List<ResponseAction>, next_state : { chunks : Int, ended : Bool } }) -> { actions : List<ResponseAction>, next_state : { chunks : Int, ended : Bool } }
	{ actions: append_actions(left.actions, right.actions), next_state: right.next_state }
end

fn collect_stream_actions_until_end(stream: NetStream, route: { tx : Sender<StreamInput>, rx : Receiver<StreamInput> }, state: { chunks : Int, ended : Bool }, deadline: Deadline, token: CancelToken) -> { actions : List<ResponseAction>, next_state : { chunks : Int, ended : Bool } } effects [net, time, concurrency]
	let outcome = net::read_chunk_until_cancellable(stream, deadline, token)
	let handled = read_response(route, outcome, state)
	match outcome
		ReadChunk(_) => append_collected_actions(handled, collect_stream_actions_until_end(stream, route, handled.next_state, deadline, token))
		ReadEnd => handled
		ReadDeadlineExpired => handled
		ReadCancelled => handled
	end
end

fn collect_stream_actions(stream: NetStream, deadline: Deadline, token: CancelToken) -> { actions : List<ResponseAction>, next_state : { chunks : Int, ended : Bool } } effects [net, time, concurrency]
	let route = channel::bounded<StreamInput>(1)
	collect_stream_actions_until_end(stream, route, { chunks: 0, ended: false }, deadline, token)
end

fn apply_response_actions(stream: NetStream, actions: List<ResponseAction>) -> () effects [net]
	match actions
		Nil => ()
		Cons(action, tail) => match action
			SendBytes(bytes) => write_then_apply(stream, bytes, tail)
			EndStream => apply_response_actions(stream, tail)
			RetryAfterDeadline => apply_response_actions(stream, tail)
			CleanupAfterCancel => apply_response_actions(stream, tail)
		end
	end
end

fn write_then_apply(stream: NetStream, bytes: ByteChunk, tail: List<ResponseAction>) -> () effects [net]
	net::write_chunk(stream, bytes)
	apply_response_actions(stream, tail)
end

fn close_after_apply(stream: NetStream, actions: List<ResponseAction>) -> () effects [net]
	apply_response_actions(stream, actions)
	net::close_stream(stream)
end

fn accepted_lifecycle(stream: NetStream, deadline: Deadline, token: CancelToken) -> Result<{ actions : List<ResponseAction>, next_state : { chunks : Int, ended : Bool } }, String> effects [net, time, concurrency]
	let routed = collect_stream_actions(stream, deadline, token)
	close_after_apply(stream, routed.actions)
	Ok(routed)
end

fn add_stream_summary(summary: { streams : Int, chunks : Int, ended : Int, writes : Int, end_actions : Int, retries : Int, cleanup : Int, clean_end : Bool }, routed: { actions : List<ResponseAction>, next_state : { chunks : Int, ended : Bool } }) -> { streams : Int, chunks : Int, ended : Int, writes : Int, end_actions : Int, retries : Int, cleanup : Int, clean_end : Bool }
	{ streams: summary.streams + 1, chunks: summary.chunks + routed.next_state.chunks, ended: summary.ended + bool_count(routed.next_state.ended), writes: summary.writes + write_count(routed.actions), end_actions: summary.end_actions + end_count(routed.actions), retries: summary.retries + retry_count(routed.actions), cleanup: summary.cleanup + cleanup_count(routed.actions), clean_end: false }
end

fn finish_summary(summary: { streams : Int, chunks : Int, ended : Int, writes : Int, end_actions : Int, retries : Int, cleanup : Int, clean_end : Bool }) -> { streams : Int, chunks : Int, ended : Int, writes : Int, end_actions : Int, retries : Int, cleanup : Int, clean_end : Bool }
	{ streams: summary.streams, chunks: summary.chunks, ended: summary.ended, writes: summary.writes, end_actions: summary.end_actions, retries: summary.retries, cleanup: summary.cleanup, clean_end: true }
end

fn drain_listener(listener: NetListener, summary: { streams : Int, chunks : Int, ended : Int, writes : Int, end_actions : Int, retries : Int, cleanup : Int, clean_end : Bool }, deadline: Deadline, token: CancelToken) -> Result<{ streams : Int, chunks : Int, ended : Int, writes : Int, end_actions : Int, retries : Int, cleanup : Int, clean_end : Bool }, String> effects [net, time, concurrency]
	match net::accept_until_cancellable(listener, deadline, token)
		AcceptStream(stream) => drain_listener(listener, add_stream_summary(summary, accepted_lifecycle(stream, deadline, token)?), deadline, token)
		AcceptEnd => close_listener_then_finish(listener, summary)
		AcceptDeadlineExpired => Ok(summary)
		AcceptCancelled => Ok(summary)
	end
end

fn close_listener_then_finish(listener: NetListener, summary: { streams : Int, chunks : Int, ended : Int, writes : Int, end_actions : Int, retries : Int, cleanup : Int, clean_end : Bool }) -> Result<{ streams : Int, chunks : Int, ended : Int, writes : Int, end_actions : Int, retries : Int, cleanup : Int, clean_end : Bool }, String> effects [net]
	net::close_listener(listener)
	Ok(finish_summary(summary))
end

fn empty_summary() -> { streams : Int, chunks : Int, ended : Int, writes : Int, end_actions : Int, retries : Int, cleanup : Int, clean_end : Bool }
	{ streams: 0, chunks: 0, ended: 0, writes: 0, end_actions: 0, retries: 0, cleanup: 0, clean_end: false }
end

pub fn main() -> Result<(), String> effects [net, time, concurrency, stdio]
	let listener = net::listen("127.0.0.1:0")
	let deadline = time::deadline_after_ms(100)
	let token = time::cancel_token()
	let summary = drain_listener(listener, empty_summary(), deadline, token)?
	stdio::print("streams ")
	stdio::print(int_to_string(summary.streams))
	stdio::print(" chunks ")
	stdio::print(int_to_string(summary.chunks))
	stdio::print(" ended ")
	stdio::print(int_to_string(summary.ended))
	stdio::print(" writes ")
	stdio::print(int_to_string(summary.writes))
	stdio::print(" end-actions ")
	stdio::print(int_to_string(summary.end_actions))
	stdio::print(" retries ")
	stdio::print(int_to_string(summary.retries))
	stdio::print(" cleanup ")
	stdio::print(int_to_string(summary.cleanup))
	stdio::print(" clean-end ")
	stdio::println(bool_text(summary.clean_end))
	Ok(())
end
