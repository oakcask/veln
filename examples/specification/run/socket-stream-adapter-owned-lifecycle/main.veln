# Adapter-owned socket lifecycle keeps handlers on ordinary stream values.
use stdio

type ResponseAction
	SendBytes(bytes: ByteChunk)
	EndStream
	Ignore
end

fn handle_stream_input(input: StreamInput, state: { chunks : Int, ended : Bool }) -> { actions : List<ResponseAction>, next_state : { chunks : Int, ended : Bool } }
	match input
		Chunk(bytes) => { actions: list_cons(SendBytes(bytes), list_nil()), next_state: { chunks: state.chunks + 1, ended: state.ended } }
		End => { actions: list_cons(EndStream, list_nil()), next_state: { chunks: state.chunks, ended: true } }
	end
end

fn append_actions(left: List<ResponseAction>, right: List<ResponseAction>) -> List<ResponseAction>
	match left
		Nil => right
		Cons(action, tail) => list_cons(action, append_actions(tail, right))
	end
end

fn action_count(actions: List<ResponseAction>) -> Int
	match actions
		Nil => 0
		Cons(_, tail) => 1 + action_count(tail)
	end
end

fn write_count(actions: List<ResponseAction>) -> Int
	match actions
		Nil => 0
		Cons(action, tail) => match action
			SendBytes(_) => 1 + write_count(tail)
			EndStream => write_count(tail)
			Ignore => write_count(tail)
		end
	end
end

fn end_count(actions: List<ResponseAction>) -> Int
	match actions
		Nil => 0
		Cons(action, tail) => match action
			SendBytes(_) => end_count(tail)
			EndStream => 1 + end_count(tail)
			Ignore => end_count(tail)
		end
	end
end

fn read_stream_input(stream: NetStream) -> StreamInput effects [net]
	match net::read_chunk_or_end(stream)
		Some(bytes) => Chunk(bytes)
		None => End
	end
end

fn route_input(route: { tx : Sender<StreamInput>, rx : Receiver<StreamInput> }, input: StreamInput) -> StreamInput effects [concurrency]
	let _ = channel::send(route.tx, input)
	match channel::recv(route.rx)
		Some(value) => value
		None => End
	end
end

fn collect_stream_actions(stream: NetStream, state: { chunks : Int, ended : Bool }) -> { actions : List<ResponseAction>, next_state : { chunks : Int, ended : Bool } } effects [net, concurrency]
	let route = channel::bounded<StreamInput>(1)
	let first = handle_stream_input(route_input(route, read_stream_input(stream)), state)
	let second = handle_stream_input(route_input(route, read_stream_input(stream)), first.next_state)
	let ended = handle_stream_input(route_input(route, read_stream_input(stream)), second.next_state)
	{ actions: append_actions(first.actions, append_actions(second.actions, ended.actions)), next_state: ended.next_state }
end

fn apply_response_actions(stream: NetStream, actions: List<ResponseAction>) -> () effects [net]
	match actions
		Nil => ()
		Cons(action, tail) => match action
			SendBytes(bytes) => write_then_apply(stream, bytes, tail)
			EndStream => apply_response_actions(stream, tail)
			Ignore => apply_response_actions(stream, tail)
		end
	end
end

fn write_then_apply(stream: NetStream, bytes: ByteChunk, tail: List<ResponseAction>) -> () effects [net]
	net::write_chunk(stream, bytes)
	apply_response_actions(stream, tail)
end

fn accepted_lifecycle(stream: NetStream) -> Result<{ actions : List<ResponseAction>, next_state : { chunks : Int, ended : Bool } }, String> effects [net, concurrency]
	let routed = collect_stream_actions(stream, { chunks: 0, ended: false })
	apply_response_actions(stream, routed.actions)
	Ok(routed)
end

fn lifecycle_result(address: String) -> Result<{ actions : List<ResponseAction>, next_state : { chunks : Int, ended : Bool } }, String> effects [net, concurrency]
	let listener: NetListener = net::listen(address)
	match net::accept_or_end(listener)
		Some(stream) => accepted_lifecycle(stream)
		None => Ok({ actions: list_cons(Ignore, list_nil()), next_state: { chunks: 0, ended: true } })
	end
end

fn bool_text(value: Bool) -> String
	match value
		true => "true"
		false => "false"
	end
end

pub fn main() -> Result<(), String> effects [net, concurrency, stdio]
	let routed: { actions : List<ResponseAction>, next_state : { chunks : Int, ended : Bool } } = lifecycle_result("127.0.0.1:0")?
	stdio::print("actions ")
	stdio::print(int_to_string(action_count(routed.actions)))
	stdio::print(" chunks ")
	stdio::print(int_to_string(routed.next_state.chunks))
	stdio::print(" ended ")
	stdio::print(bool_text(routed.next_state.ended))
	stdio::print(" writes ")
	stdio::print(int_to_string(write_count(routed.actions)))
	stdio::print(" end-actions ")
	stdio::println(int_to_string(end_count(routed.actions)))
	Ok(())
end
