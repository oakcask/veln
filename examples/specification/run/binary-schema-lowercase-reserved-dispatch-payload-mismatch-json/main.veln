# Subbyte lowercase reserved dispatch payloads report failed payload bits.

schema ClosedThreeBitReservedDispatch
	format binary

	kind: uint8
	payload: Dispatch(kind, 1 => uint3 reserves 0)
end

pub fn main() -> Result<(), String>
	let bytes: ByteChunk = byte_chunk_from_hex("01e0")?
	let view: ByteView = byte_view(bytes, byte_offset(0)?, byte_count(2)?)?
	let packet: {kind: Int, payload: ()} = byte_decode_closed_three_bit_reserved_dispatch(view)?
	Ok(())
end
