# HTTP/2 SETTINGS ACK payload length failures project to human diagnostics.

type Http2ProtocolFailure
	InvalidPayloadLength(Int, Int, Int, Int, Int, String, String, ByteView)
end

fn project(failure: Http2ProtocolFailure) -> Result<(), String>
	match failure
		InvalidPayloadLength(offset, frame_kind, stream_id, observed_length, expected_length, active_state, rule_provenance, preview) => http2_protocol_invalid_payload_length(offset, frame_kind, stream_id, observed_length, expected_length, active_state, rule_provenance, preview)
	end
end

pub fn main() -> Result<(), String>
	let bytes: ByteChunk = byte_chunk_from_hex("000102030405")?
	let preview: ByteView = byte_view(bytes, byte_offset(0)?, byte_count(6)?)?
	project(InvalidPayloadLength(0, 4, 0, 6, 0, "connection-control", "rfc9113_settings_ack_payload_length", preview))
end
