# Format-neutral schema encode helpers accept Result<scalar, scalar> fields.
use stdio

schema ResultScalarPacket
	code: Result<Int, String>
	ready: Result<Bool, String>
	ratio: Result<Float, String>
	label: Result<String, Int>
end

fn code_text(result: Result<{code: Result<Int, String>, ready: Result<Bool, String>, ratio: Result<Float, String>, label: Result<String, Int>}, String>) -> String
	match result
		Ok(packet) => match packet.code
			Ok(code) => int_to_string(code)
			Err(message) => message
		end
		Err(message) => message
	end
end

fn ready_text(result: Result<{code: Result<Int, String>, ready: Result<Bool, String>, ratio: Result<Float, String>, label: Result<String, Int>}, String>) -> String
	match result
		Ok(packet) => match packet.ready
			Ok(ready) => if ready
				"ready"
			else
				"blocked"
			end
			Err(message) => message
		end
		Err(message) => message
	end
end

fn ratio_text(result: Result<{code: Result<Int, String>, ready: Result<Bool, String>, ratio: Result<Float, String>, label: Result<String, Int>}, String>) -> String
	match result
		Ok(packet) => match packet.ratio
			Ok(ratio) => if ratio > 1.0
				"ratio-high"
			else
				"ratio-low"
			end
			Err(message) => message
		end
		Err(message) => message
	end
end

fn label_text(result: Result<{code: Result<Int, String>, ready: Result<Bool, String>, ratio: Result<Float, String>, label: Result<String, Int>}, String>) -> String
	match result
		Ok(packet) => match packet.label
			Ok(label) => label
			Err(code) => int_to_string(code)
		end
		Err(message) => message
	end
end

pub fn main() -> () effects [stdio]
	let packet: {code: Result<Int, String>, ready: Result<Bool, String>, ratio: Result<Float, String>, label: Result<String, Int>} = {code: Ok(7), ready: Ok(true), ratio: Ok(1.5), label: Ok("result")}
	let error_packet: {code: Result<Int, String>, ready: Result<Bool, String>, ratio: Result<Float, String>, label: Result<String, Int>} = {code: Err("bad-code"), ready: Err("bad-ready"), ratio: Err("bad-ratio"), label: Err(404)}
	let encoded = byte_encode_result_scalar_packet(packet)
	let explicit = encode ResultScalarPacket from error_packet
	stdio::println(code_text(encoded))
	stdio::println(ready_text(encoded))
	stdio::println(ratio_text(encoded))
	stdio::println(label_text(encoded))
	stdio::println(code_text(explicit))
	stdio::println(ready_text(explicit))
	stdio::println(ratio_text(explicit))
	stdio::println(label_text(explicit))
end
