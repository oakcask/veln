# RuntimeDiagnostic values can project HPACK dynamic-index payloads.
fn invalid_payload(error: String) -> RuntimeDiagnostic
	RuntimeDiagnostic(
		"hpack.fixture.dynamic_index_out_of_range",
		error,
		RuntimeHpackFixtureDynamicIndexDiagnostic(27, 0, -1, 0, 0, "fixture dynamic indexed header", "hpack_fixture", byte_chunk([]))
	)
end

fn preview_block() -> Result<ByteChunk, RuntimeDiagnostic>
	match byte_chunk_from_hex("be")
		Ok(block) => Ok(block)
		Err(error) => Err(invalid_payload(error))
	end
end

pub fn main() -> Result<(), RuntimeDiagnostic>
	let block: ByteChunk = preview_block()?
	Err(RuntimeDiagnostic(
		"hpack.fixture.dynamic_index_out_of_range",
		"HPACK dynamic index out of range at byte offset 27",
		RuntimeHpackFixtureDynamicIndexDiagnostic(27, 1, 190, 0, 0, "fixture dynamic indexed header", "hpack_fixture", block)
	))
end
