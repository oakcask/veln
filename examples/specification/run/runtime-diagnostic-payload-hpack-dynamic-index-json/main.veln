use http2::hpack::diagnostic from "std"
# HPACK fixture helpers return dynamic-index RuntimeDiagnostic payloads.
fn invalid_payload(error: String) -> RuntimeDiagnostic
	let protocol_detail: HpackDiagnosticDetail = RuntimeHpackFixtureDynamicIndexDiagnostic(27, 0, -1, 0, 0, "fixture dynamic indexed header", "hpack_fixture", byte_chunk([]))
	let detail: RuntimeDiagnosticDetail = RuntimeHttp2HpackDiagnostic(protocol_detail)
	RuntimeDiagnostic(
		"hpack.fixture.dynamic_index_out_of_range",
		error,
		detail
	)
end

fn preview_view() -> Result<ByteView, RuntimeDiagnostic>
	match byte_chunk_from_hex("be")
		Ok(block) => match byte_offset(0)
			Ok(offset) => match byte_view(block, offset, byte_chunk_count(block))
				Ok(view) => Ok(view)
				Err(error) => Err(invalid_payload(error))
			end
			Err(error) => Err(invalid_payload(error))
		end
		Err(error) => Err(invalid_payload(error))
	end
end

pub fn main() -> Result<(), RuntimeDiagnostic>
	let preview: ByteView = preview_view()?
	http2::hpack::diagnostic::dynamic_index_out_of_range(27, 1, 190, 0, 0, "fixture dynamic indexed header", "hpack_fixture", preview)
end
