# Hand-written codec encode boundaries preserve partial output and resume state.
use stdio

type Packet
	Packet { length: Int, kind: Int }
end

schema PacketWire
	format binary

	wire_length: UInt16be
	wire_kind: UInt8

	map to Packet
		length = wire_length
		kind = wire_kind
end

codec PacketCodec for PacketWire encode
	encode with encode_packet
end

fn encode_packet(packet: { length : Int, kind : Int }, state: { next_chunk : ByteChunk, remaining_chunk : ByteChunk, empty_chunk : ByteChunk, encoded_offset : ByteCount }) -> EncodeStep<{ next_chunk : ByteChunk, remaining_chunk : ByteChunk, empty_chunk : ByteChunk, encoded_offset : ByteCount }>
	match packet.kind <= packet.length
		true => match byte_count_to_int(state.encoded_offset) == 0
			true => Partial(list_cons(state.next_chunk, list_nil()), byte_chunk_count(state.next_chunk), { next_chunk: state.remaining_chunk, remaining_chunk: state.empty_chunk, empty_chunk: state.empty_chunk, encoded_offset: byte_chunk_count(state.next_chunk) })
			false => Encoded(list_cons(state.next_chunk, list_nil()))
		end
		false => Invalid(EncodeError("codec.out_of_range", "Packet.kind", "kind exceeds length"))
	end
end

fn chunk_count(chunks: List<ByteChunk>) -> Int
	match chunks
		Nil => 0
		Cons(_, tail) => 1 + chunk_count(tail)
	end
end

fn chunk_byte_count(chunks: List<ByteChunk>) -> Int
	match chunks
		Nil => 0
		Cons(chunk, tail) => byte_count_to_int(byte_chunk_count(chunk)) + chunk_byte_count(tail)
	end
end

fn step_kind(step: EncodeStep<{ next_chunk : ByteChunk, remaining_chunk : ByteChunk, empty_chunk : ByteChunk, encoded_offset : ByteCount }>) -> String
	match step
		Encoded(_) => "encoded"
		Partial(_, _, _) => "partial"
		Invalid(_) => "invalid"
	end
end

fn emitted_chunks(step: EncodeStep<{ next_chunk : ByteChunk, remaining_chunk : ByteChunk, empty_chunk : ByteChunk, encoded_offset : ByteCount }>) -> Int
	match step
		Encoded(chunks) => chunk_count(chunks)
		Partial(chunks, _, _) => chunk_count(chunks)
		Invalid(_) => 0
	end
end

fn emitted_bytes(step: EncodeStep<{ next_chunk : ByteChunk, remaining_chunk : ByteChunk, empty_chunk : ByteChunk, encoded_offset : ByteCount }>) -> Int
	match step
		Encoded(chunks) => chunk_byte_count(chunks)
		Partial(_, produced, _) => byte_count_to_int(produced)
		Invalid(_) => 0
	end
end

fn pending_bytes(step: EncodeStep<{ next_chunk : ByteChunk, remaining_chunk : ByteChunk, empty_chunk : ByteChunk, encoded_offset : ByteCount }>) -> Int
	match step
		Encoded(_) => 0
		Partial(_, _, state) => byte_count_to_int(byte_chunk_count(state.next_chunk))
		Invalid(_) => 0
	end
end

fn resumed_offset(step: EncodeStep<{ next_chunk : ByteChunk, remaining_chunk : ByteChunk, empty_chunk : ByteChunk, encoded_offset : ByteCount }>) -> Int
	match step
		Encoded(_) => 0
		Partial(_, _, state) => byte_count_to_int(state.encoded_offset)
		Invalid(_) => 0
	end
end

fn partial_state(step: EncodeStep<{ next_chunk : ByteChunk, remaining_chunk : ByteChunk, empty_chunk : ByteChunk, encoded_offset : ByteCount }>) -> Result<{ next_chunk : ByteChunk, remaining_chunk : ByteChunk, empty_chunk : ByteChunk, encoded_offset : ByteCount }, String>
	match step
		Encoded(_) => Err("expected partial encode")
		Partial(_, _, state) => Ok(state)
		Invalid(_) => Err("expected partial encode")
	end
end

fn error_id(step: EncodeStep<{ next_chunk : ByteChunk, remaining_chunk : ByteChunk, empty_chunk : ByteChunk, encoded_offset : ByteCount }>) -> String
	match step
		Encoded(_) => "none"
		Partial(_, _, _) => "none"
		Invalid(EncodeError(id, _, _)) => id
	end
end

fn error_path(step: EncodeStep<{ next_chunk : ByteChunk, remaining_chunk : ByteChunk, empty_chunk : ByteChunk, encoded_offset : ByteCount }>) -> String
	match step
		Encoded(_) => "none"
		Partial(_, _, _) => "none"
		Invalid(EncodeError(_, path, _)) => path
	end
end

fn error_reason(step: EncodeStep<{ next_chunk : ByteChunk, remaining_chunk : ByteChunk, empty_chunk : ByteChunk, encoded_offset : ByteCount }>) -> String
	match step
		Encoded(_) => "none"
		Partial(_, _, _) => "none"
		Invalid(EncodeError(_, _, reason)) => reason
	end
end

pub fn main() -> Result<(), String> effects [stdio]
	let first: ByteChunk = byte_chunk_from_hex("0007")?
	let second: ByteChunk = byte_chunk_from_hex("03")?
	let full: ByteChunk = byte_chunk_from_hex("000703")?
	let empty: ByteChunk = byte_chunk_from_hex("")?
	let complete_state: { next_chunk : ByteChunk, remaining_chunk : ByteChunk, empty_chunk : ByteChunk, encoded_offset : ByteCount } = { next_chunk: full, remaining_chunk: empty, empty_chunk: empty, encoded_offset: byte_count(3)? }
	let encoded: EncodeStep<{ next_chunk : ByteChunk, remaining_chunk : ByteChunk, empty_chunk : ByteChunk, encoded_offset : ByteCount }> = PacketCodec({ length: 7, kind: 3 }, complete_state)
	stdio::println(step_kind(encoded))
	stdio::println(int_to_string(emitted_chunks(encoded)))
	stdio::println(int_to_string(emitted_bytes(encoded)))
	let initial_state: { next_chunk : ByteChunk, remaining_chunk : ByteChunk, empty_chunk : ByteChunk, encoded_offset : ByteCount } = { next_chunk: first, remaining_chunk: second, empty_chunk: empty, encoded_offset: byte_count(0)? }
	let partial: EncodeStep<{ next_chunk : ByteChunk, remaining_chunk : ByteChunk, empty_chunk : ByteChunk, encoded_offset : ByteCount }> = PacketCodec({ length: 7, kind: 3 }, initial_state)
	stdio::println(step_kind(partial))
	stdio::println(int_to_string(emitted_chunks(partial)))
	stdio::println(int_to_string(emitted_bytes(partial)))
	stdio::println(int_to_string(pending_bytes(partial)))
	stdio::println(int_to_string(resumed_offset(partial)))
	let resume_state: { next_chunk : ByteChunk, remaining_chunk : ByteChunk, empty_chunk : ByteChunk, encoded_offset : ByteCount } = partial_state(partial)?
	let resumed: EncodeStep<{ next_chunk : ByteChunk, remaining_chunk : ByteChunk, empty_chunk : ByteChunk, encoded_offset : ByteCount }> = PacketCodec({ length: 7, kind: 3 }, resume_state)
	stdio::println(step_kind(resumed))
	stdio::println(int_to_string(emitted_chunks(resumed)))
	stdio::println(int_to_string(emitted_bytes(resumed)))
	let invalid: EncodeStep<{ next_chunk : ByteChunk, remaining_chunk : ByteChunk, empty_chunk : ByteChunk, encoded_offset : ByteCount }> = PacketCodec({ length: 1, kind: 7 }, complete_state)
	stdio::println(step_kind(invalid))
	stdio::println(error_id(invalid))
	stdio::println(error_path(invalid))
	stdio::println(error_reason(invalid))
	Ok(())
end
