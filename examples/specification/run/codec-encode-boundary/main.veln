# Hand-written codec encode boundaries call the named encoder function and preserve partial output.
use stdio

type Packet
	Packet {length: Int, kind: Int}
end

schema PacketWire
	format binary

	wire_length: UInt16be
	wire_kind: UInt8

	map to Packet
		length = wire_length
		kind = wire_kind
end

codec PacketCodec for PacketWire encode
	encode with encode_packet
end

fn encode_packet(packet: {length: Int, kind: Int}, chunks: List<ByteChunk>, produced: ByteCount, state: { remaining : ByteChunk, next_budget : ByteCount }) -> EncodeStep<{ remaining : ByteChunk, next_budget : ByteCount }>
	match packet.kind <= packet.length
		true => match byte_count_to_int(byte_chunk_count(state.remaining)) == 0
			true => Encoded(chunks)
			false => Partial(chunks, produced, state)
		end
		false => Invalid(EncodeError("codec.out_of_range", "Packet.kind", "kind exceeds length"))
	end
end

fn chunk_count(chunks: List<ByteChunk>) -> Int
	match chunks
		Nil => 0
		Cons(_, tail) => 1 + chunk_count(tail)
	end
end

fn chunk_byte_count(chunks: List<ByteChunk>) -> Int
	match chunks
		Nil => 0
		Cons(chunk, tail) => byte_count_to_int(byte_chunk_count(chunk)) + chunk_byte_count(tail)
	end
end

fn step_kind(step: EncodeStep<{ remaining : ByteChunk, next_budget : ByteCount }>) -> String
	match step
		Encoded(_) => "encoded"
		Partial(_, _, _) => "partial"
		Invalid(_) => "invalid"
	end
end

fn emitted_chunks(step: EncodeStep<{ remaining : ByteChunk, next_budget : ByteCount }>) -> Int
	match step
		Encoded(chunks) => chunk_count(chunks)
		Partial(chunks, _, _) => chunk_count(chunks)
		Invalid(_) => 0
	end
end

fn emitted_bytes(step: EncodeStep<{ remaining : ByteChunk, next_budget : ByteCount }>) -> Int
	match step
		Encoded(chunks) => chunk_byte_count(chunks)
		Partial(_, produced, _) => byte_count_to_int(produced)
		Invalid(_) => 0
	end
end

fn pending_bytes(step: EncodeStep<{ remaining : ByteChunk, next_budget : ByteCount }>) -> Int
	match step
		Encoded(_) => 0
		Partial(_, _, state) => byte_count_to_int(byte_chunk_count(state.remaining))
		Invalid(_) => 0
	end
end

fn pending_budget(step: EncodeStep<{ remaining : ByteChunk, next_budget : ByteCount }>) -> Int
	match step
		Encoded(_) => 0
		Partial(_, _, state) => byte_count_to_int(state.next_budget)
		Invalid(_) => 0
	end
end

fn partial_state(step: EncodeStep<{ remaining : ByteChunk, next_budget : ByteCount }>) -> Result<{ remaining : ByteChunk, next_budget : ByteCount }, String>
	match step
		Encoded(_) => Err("expected partial encode")
		Partial(_, _, state) => Ok(state)
		Invalid(_) => Err("expected partial encode")
	end
end

fn error_id(step: EncodeStep<{ remaining : ByteChunk, next_budget : ByteCount }>) -> String
	match step
		Encoded(_) => "none"
		Partial(_, _, _) => "none"
		Invalid(EncodeError(id, _, _)) => id
	end
end

fn error_path(step: EncodeStep<{ remaining : ByteChunk, next_budget : ByteCount }>) -> String
	match step
		Encoded(_) => "none"
		Partial(_, _, _) => "none"
		Invalid(EncodeError(_, path, _)) => path
	end
end

fn error_reason(step: EncodeStep<{ remaining : ByteChunk, next_budget : ByteCount }>) -> String
	match step
		Encoded(_) => "none"
		Partial(_, _, _) => "none"
		Invalid(EncodeError(_, _, reason)) => reason
	end
end

pub fn main() -> Result<(), String> effects [stdio]
	let first: ByteChunk = byte_chunk_from_hex("0007")?
	let second: ByteChunk = byte_chunk_from_hex("03")?
	let empty: ByteChunk = byte_chunk_from_hex("")?
	let chunks: List<ByteChunk> = list_cons(first, list_cons(second, list_nil()))
	let no_remaining: { remaining : ByteChunk, next_budget : ByteCount } = { remaining: empty, next_budget: byte_count(0)? }
	let encoded: EncodeStep<{ remaining : ByteChunk, next_budget : ByteCount }> = PacketCodec({length: 7, kind: 3}, chunks, byte_count(3)?, no_remaining)
	stdio::println(step_kind(encoded))
	stdio::println(int_to_string(emitted_chunks(encoded)))
	stdio::println(int_to_string(emitted_bytes(encoded)))

	let partial_state_value: { remaining : ByteChunk, next_budget : ByteCount } = { remaining: second, next_budget: byte_count(1)? }
	let partial: EncodeStep<{ remaining : ByteChunk, next_budget : ByteCount }> = PacketCodec({length: 7, kind: 3}, list_cons(first, list_nil()), byte_count(2)?, partial_state_value)
	stdio::println(step_kind(partial))
	stdio::println(int_to_string(emitted_chunks(partial)))
	stdio::println(int_to_string(emitted_bytes(partial)))
	stdio::println(int_to_string(pending_bytes(partial)))
	stdio::println(int_to_string(pending_budget(partial)))

	let resume_state: { remaining : ByteChunk, next_budget : ByteCount } = partial_state(partial)?
	let resumed: EncodeStep<{ remaining : ByteChunk, next_budget : ByteCount }> = PacketCodec({length: 7, kind: 3}, list_cons(resume_state.remaining, list_nil()), resume_state.next_budget, no_remaining)
	stdio::println(step_kind(resumed))
	stdio::println(int_to_string(emitted_chunks(resumed)))
	stdio::println(int_to_string(emitted_bytes(resumed)))

	let invalid: EncodeStep<{ remaining : ByteChunk, next_budget : ByteCount }> = PacketCodec({length: 1, kind: 7}, list_nil(), byte_count(0)?, no_remaining)
	stdio::println(step_kind(invalid))
	stdio::println(error_id(invalid))
	stdio::println(error_path(invalid))
	stdio::println(error_reason(invalid))
	Ok(())
end
