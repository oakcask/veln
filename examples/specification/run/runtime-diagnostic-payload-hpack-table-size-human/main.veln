use http2::hpack::diagnostic from "std"
# HPACK fixture helpers return human table-size update RuntimeDiagnostic payloads.
fn invalid_payload(error: String) -> RuntimeDiagnostic
	RuntimeDiagnostic(
		"hpack.fixture.table_size_update_not_at_start",
		error,
		RuntimeHpackFixtureTableSizeUpdateDiagnostic(10, 0, -1, 0, 1, 1, "hpack-fixture", "fixture HPACK table-size update at header block start", "hpack_fixture", byte_chunk([]))
	)
end

fn preview_view() -> Result<ByteView, RuntimeDiagnostic>
	match byte_chunk_from_hex("823e")
		Ok(block) => match byte_offset(0)
			Ok(offset) => match byte_view(block, offset, byte_chunk_count(block))
				Ok(view) => Ok(view)
				Err(error) => Err(invalid_payload(error))
			end
			Err(error) => Err(invalid_payload(error))
		end
		Err(error) => Err(invalid_payload(error))
	end
end

pub fn main() -> Result<(), RuntimeDiagnostic>
	let preview: ByteView = preview_view()?
	http2::hpack::diagnostic::table_size_update_not_at_start(10, 2, 62, 30, 1, 1, "hpack-fixture", "fixture HPACK table-size update at header block start", "hpack_fixture", preview)
end
