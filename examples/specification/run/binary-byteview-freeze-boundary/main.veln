# ByteView values preserve bounded bytes and logical offsets across freeze boundaries.
use stdio

fn offset_text(view: ByteView, expected: Int) -> String
	match byte_expect_fixed_u8_be(view, expected, "FreezeBoundary", "payload")
		Ok(_) => "matched"
		Err(message) => message
	end
end

fn print_view(label: String, view: ByteView, expected: Int) -> Result<(), String> effects [stdio]
	stdio::print(label)
	stdio::print(" count ")
	stdio::print(int_to_string(byte_count_to_int(byte_view_count(view))))
	stdio::print(" u16 ")
	stdio::print(int_to_string(byte_read_u16_be(view)?))
	stdio::print(" offset ")
	stdio::println(offset_text(view, expected))
	Ok(())
end

fn task_view() -> Result<ByteView, String>
	let bytes: ByteChunk = byte_chunk_from_hex("00010203040506")?
	byte_view(bytes, byte_offset(4)?, byte_count(2)?)
end

pub fn main() -> Result<(), String> effects [stdio, concurrency]
	let bytes: ByteChunk = byte_chunk_from_hex("00010203040506")?
	let view: ByteView = byte_view(bytes, byte_offset(3)?, byte_count(2)?)?
	let retained: ByteChunk = byte_drop(bytes, byte_count(5)?)?
	let pair = channel::bounded<ByteView>(1)
	let _ = channel::send(pair.tx, view)
	let received: ByteView = match channel::recv(pair.rx)
		Some(value) => value
		None => view
	end
	let _ = print_view("channel", received, 255)?
	stdio::print("retained-count ")
	stdio::println(int_to_string(byte_count_to_int(byte_chunk_count(retained))))

	let task = task::spawn<Result<ByteView, String>>(task_view)
	let task_result: Result<ByteView, String> = match task::join(task)
		Ok(value) => value
		Err(_) => Err("task join failed")
	end
	let returned: ByteView = task_result?
	print_view("task", returned, 255)
end
