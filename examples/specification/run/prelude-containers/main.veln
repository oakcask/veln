// Prelude container helpers preserve concrete Vec, Dict, Option, and Result behavior.
fn odd(value: Int) -> Bool effects []
  value != 2
end

fn double(value: Int) -> Int effects []
  value * 2
end

fn positive(value: Int) -> Option(Int) effects []
  match value > 0
    true => Some(value)
    false => None
  end
end

fn add_one(value: Int) -> Result(Int, String) effects []
  Ok(value + 1)
end

fn fallible_double(value: Int) -> Result(Int, String) effects []
  match value == 2
    true => Err("stop")
    false => Ok(value * 2)
  end
end

fn label_error(error: String) -> String effects []
  error
end

pub fn main() -> () effects [stdio]
  let values: Vec(Int) = vec_concat(vec_push([1], 2), [3])
  let kept: Vec(Int) = vec_filter(values, odd)
  let dictionary: Dict(String, Int) = dict_remove(dict_insert({"a": 1}, "b", 2), "a")
  match string_split_once("odd:2", ":")
    Some(parts) => stdio::println(parts.left)
    None => stdio::println("missing")
  end
  let second: String = match option_and_then(option_map(Some(3), double), positive)
    Some(value) => int_to_string(value)
    None => "none"
  end
  let third: String = match result_and_then(result_map(Ok(3), double), add_one)
    Ok(value) => int_to_string(value + vec_len(kept))
    Err(error) => error
  end
  let fourth: String = match result_map_err(string_parse_int("bad"), label_error)
    Ok(value) => int_to_string(value)
    Err(error) => error
  end
  let fifth: String = match dict_contains(dictionary, "b")
    true => "b"
    false => "missing"
  end
  let sixth: String = int_to_string(option_unwrap_or(None, 7))
  let seventh: String = match vec_try_map([1, 2, 3], fallible_double)
    Ok(items) => int_to_string(vec_len(items))
    Err(error) => error
  end
  stdio::println(second)
  stdio::println(third)
  stdio::println(fourth)
  stdio::println(fifth)
  stdio::println(sixth)
  stdio::println(seventh)
end
