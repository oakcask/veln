# Binary schema Flag16le fields decode as source-visible bitset values.
use stdio

schema FlagPacket
	format binary

	flags: Flag16le
end

fn flag_bits(flags: Flag16le) -> Int
	match flags
		Flag16le(bits) => bits
	end
end

pub fn main() -> Result<(), String> effects [stdio]
	let bytes: ByteChunk = byte_chunk_from_hex("3412")?
	let offset: ByteOffset = byte_offset(0)?
	let count: ByteCount = byte_count(2)?
	let view: ByteView = byte_view(bytes, offset, count)?
	let packet: {flags: Flag16le} = byte_decode_flag_packet(view)?
	stdio::println(int_to_string(flag_bits(packet.flags)))
	Ok(())
end
