use http2::core from "std"
use http2::diagnostic from "std"
# HTTP/2 invalid connection preface failures project structured runtime details.

fn invalid_preface_error_payload(error: String) -> RuntimeDiagnostic
	RuntimeDiagnostic(
		"http2.protocol.invalid_preface",
		error,
		RuntimeHttp2Diagnostic(RuntimeHttp2ProtocolInvalidPrefaceDiagnostic(0, 0, 0, 0, 24, "connection-preface", "rfc9113_client_connection_preface", byte_chunk([])))
	)
end

fn preview_view(bytes: ByteChunk) -> Result<ByteView, RuntimeDiagnostic>
	match byte_offset(0)
		Ok(offset) => match byte_view(bytes, offset, byte_chunk_count(bytes))
			Ok(view) => Ok(view)
			Err(error) => Err(invalid_preface_error_payload(error))
		end
		Err(error) => Err(invalid_preface_error_payload(error))
	end
end

fn preface_bytes() -> Result<ByteChunk, RuntimeDiagnostic>
	match byte_chunk_from_hex("505249202b")
		Ok(bytes) => Ok(bytes)
		Err(error) => Err(invalid_preface_error_payload(error))
	end
end

fn http2_protocol_diagnostic(failure: ConnectionPrefaceFailure) -> Result<(), RuntimeDiagnostic>
	let preview: ByteChunk = http2::core::connection_preface_failure_preview(failure)
	http2::diagnostic::protocol_invalid_preface(
		http2::core::connection_preface_failure_offset(failure),
		http2::core::connection_preface_failure_expected_octet(failure),
		http2::core::connection_preface_failure_actual_octet(failure),
		http2::core::connection_preface_failure_matched_count(failure),
		preview_view(preview)?
	)
end

pub fn main() -> Result<(), RuntimeDiagnostic>
	let bytes: ByteChunk = preface_bytes()?
	match http2::core::accept_connection_preface(http2::core::empty_connection_preface(0), bytes)
		Ok(_) => Err(invalid_preface_error_payload("invalid connection preface unexpectedly succeeded"))
		Err(failure) => http2_protocol_diagnostic(failure)
	end
end
