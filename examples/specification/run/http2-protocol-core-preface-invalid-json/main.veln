# HTTP/2 invalid connection preface failures project structured runtime details.

type Http2ProtocolFailure
	InvalidPreface(Int, Int, Int, Int)
end

fn project(failure: Http2ProtocolFailure) -> Result<(), String>
	match failure
		InvalidPreface(offset, expected_byte, actual_byte, matched_count) => http2_protocol_invalid_preface(offset, expected_byte, actual_byte, matched_count)
	end
end

pub fn main() -> Result<(), String>
	project(InvalidPreface(4, 42, 43, 4))
end
