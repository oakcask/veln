use http2::core from "std"
use stdio

fn byte_at(chunk: ByteChunk, index: Int) -> Result<Int, String>
	byte_read_u8_be(byte_view(chunk, byte_offset(index)?, byte_count(1)?)?)
end

fn chunks_equal_at(left: ByteChunk, right: ByteChunk, index: Int, count: Int) -> Result<Bool, String>
	if index == count
		Ok(true)
	else if byte_at(left, index)? == byte_at(right, index)?
		chunks_equal_at(left, right, index + 1, count)
	else
		Ok(false)
	end
end

fn chunks_equal(left: ByteChunk, right: ByteChunk) -> Result<Bool, String>
	let count = byte_count_to_int(byte_chunk_count(left))
	if count == byte_count_to_int(byte_chunk_count(right))
		chunks_equal_at(left, right, 0, count)
	else
		Ok(false)
	end
end

fn checked_hex(chunk: ByteChunk, expected_hex: String) -> Result<String, String>
	if chunks_equal(chunk, byte_chunk_from_hex(expected_hex)?)?
		Ok(expected_hex)
	else
		Ok("mismatch")
	end
end

fn preview() -> Result<ByteView, String>
	byte_view(byte_chunk_from_hex("000000040100000000")?, byte_offset(0)?, byte_count(9)?)
end

fn print_state(label: String, state: SettingsAckState) -> () effects [stdio]
	let outstanding = http2::core::settings_ack_outstanding(state)
	stdio::print(label)
	stdio::print(" outstanding ")
	stdio::print(http2::core::outstanding_settings_label(outstanding))
	stdio::print(" identifier ")
	stdio::print(int_to_string(http2::core::outstanding_settings_identifier(outstanding)))
	stdio::print(" item_count ")
	stdio::print(int_to_string(http2::core::outstanding_settings_count(outstanding)))
	stdio::print(" batch_count ")
	stdio::print(int_to_string(http2::core::outstanding_settings_batch_count(outstanding)))
	stdio::print(" peer_ack ")
	stdio::println(http2::core::pending_settings_ack_label(http2::core::settings_ack_pending_peer_ack(state)))
end

fn print_send(label: String, decision: PeerSettingsAckSendDecision) -> Result<(), String> effects [stdio]
	stdio::print(label)
	stdio::print(" send ")
	stdio::print(http2::core::pending_settings_ack_send_status(decision))
	stdio::print(" pending ")
	stdio::println(http2::core::pending_settings_ack_label(http2::core::settings_ack_pending_peer_ack(http2::core::pending_settings_ack_send_state(decision))))
	match http2::core::pending_settings_ack_send_status(decision)
		"accepted" => print_chunk(label, http2::core::pending_settings_ack_send_bytes(decision), "000000040100000000")
		_ => Ok(print_empty(label))
	end
end

fn print_chunk(label: String, chunk: ByteChunk, expected_hex: String) -> Result<(), String> effects [stdio]
	stdio::print("output_chunk_list ")
	stdio::print(label)
	stdio::println(" count 1")
	stdio::print("output_chunk ")
	stdio::print(label)
	stdio::print(" index 0 hex \"")
	stdio::print(checked_hex(chunk, expected_hex)?)
	stdio::print("\" count ")
	stdio::println(int_to_string(byte_count_to_int(byte_chunk_count(chunk))))
	Ok(())
end

fn print_empty(label: String) -> () effects [stdio]
	stdio::print("output_chunk_list ")
	stdio::print(label)
	stdio::println(" count 0")
end

fn print_failure(label: String, result: Result<SettingsAckState, SettingsAckFailure>) -> Result<(), String> effects [stdio]
	match result
		Ok(_) => Err("unexpected SETTINGS ACK accepted")
		Err(failure) => print_failure_detail(label, failure)
	end
end

fn print_failure_detail(label: String, failure: SettingsAckFailure) -> Result<(), String> effects [stdio]
	stdio::print(label)
	stdio::print(" failure ")
	stdio::print(http2::core::settings_ack_failure_id(failure))
	stdio::print(" offset ")
	stdio::print(int_to_string(http2::core::settings_ack_failure_offset(failure)))
	stdio::print(" active_state ")
	stdio::print(http2::core::settings_ack_failure_active_state(failure))
	stdio::print(" rule ")
	stdio::println(http2::core::settings_ack_failure_rule_provenance(failure))
	Ok(())
end

fn require_ack_state(result: Result<SettingsAckState, SettingsAckFailure>) -> Result<SettingsAckState, String>
	match result
		Ok(state) => Ok(state)
		Err(failure) => Err(http2::core::settings_ack_failure_id(failure))
	end
end

pub fn main() -> Result<(), String> effects [stdio]
	let empty = http2::core::empty_settings_ack_state()
	print_state("empty", empty)

	let first = http2::core::record_local_settings_batch(empty, 5, 1)
	let second = http2::core::record_local_settings_batch(first, 4, 2)
	print_state("fifo-before", second)
	let acked_first = require_ack_state(http2::core::accept_settings_ack(second, 17, preview()?))?
	print_state("fifo-after-one", acked_first)
	let acked_second = require_ack_state(http2::core::accept_settings_ack(acked_first, 26, preview()?))?
	print_state("fifo-after-two", acked_second)

	let _ = print_failure("unexpected", http2::core::accept_settings_ack(empty, 41, preview()?))?

	let pending = http2::core::settings_ack_after_peer_frame(first, 4, 0, 6)
	print_state("independent-before", pending)
	let local_ack = require_ack_state(http2::core::accept_settings_ack(pending, 50, preview()?))?
	print_state("independent-after-local", local_ack)
	let sent = http2::core::send_pending_settings_ack(local_ack)
	let _ = print_send("peer-ack-send", sent)?
	print_state("independent-after-send", http2::core::pending_settings_ack_send_state(sent))

	let no_pending = http2::core::send_pending_settings_ack(empty)
	let _ = print_send("peer-ack-none", no_pending)?
	let coalesced = http2::core::settings_ack_after_peer_frame(http2::core::settings_ack_after_peer_frame(empty, 4, 0, 6), 4, 0, 12)
	print_state("coalesced", coalesced)
	Ok(())
end
