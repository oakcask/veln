use stdio

type Packet
	Packet {body_length: Int, padded_length: Int, trimmed_length: Int}
end

schema PacketWire
	format binary

	body: UInt8
	padding: UInt8
	tail: UInt8

	map to Packet
		body_length = body + 9
		padded_length = 1 + padding
		trimmed_length = tail - 4
end

fn emit_output_chunk(name: String, index: Int, chunk: ByteChunk, expected_hex: String) -> () effects [stdio]
	stdio::print("output_chunk ")
	stdio::print(name)
	stdio::print(" index ")
	stdio::print(int_to_string(index))
	stdio::print(" hex \"")
	stdio::print(expected_hex)
	stdio::print("\" count ")
	stdio::println(int_to_string(byte_count_to_int(byte_chunk_count(chunk))))
end

fn emit_encoded(bytes: ByteChunk) -> () effects [stdio]
	stdio::println("output_chunk_list arithmetic-mapped-packet count 1")
	emit_output_chunk("arithmetic-mapped-packet", 0, bytes, "030207")
end

pub fn main() -> () effects [stdio]
	let encoded: Result<ByteChunk, EncodeError> = byte_encode_packet_wire({body_length: 12, padded_length: 3, trimmed_length: 3})
	match encoded
		Ok(bytes) => emit_encoded(bytes)
		Err(_) => stdio::println("unexpected encode failure")
	end
end
