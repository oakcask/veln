# Binary schema ByteView division lengths decode bounded payload bytes.
use stdio

schema PacketWire
	format binary

	total_length: UInt8
	chunk_count: UInt8
	payload: ByteView(total_length / chunk_count)
end

fn emit_packet(packet: {total_length: Int, chunk_count: Int, payload: ByteView}) -> Result<(), String> effects [stdio]
	stdio::print(int_to_string(packet.total_length))
	stdio::print(" ")
	stdio::print(int_to_string(packet.chunk_count))
	stdio::print(" ")
	stdio::print(int_to_string(byte_count_to_int(byte_chunk_count(byte_view_to_chunk(packet.payload)))))
	stdio::print(" ")
	stdio::println(int_to_string(byte_read_u16_be(packet.payload)?))
	Ok(())
end

pub fn main() -> Result<(), String> effects [stdio]
	let bytes = byte_chunk_from_hex("0802aabbccdd")?
	let view = byte_view(bytes, byte_offset(0)?, byte_count(6)?)?
	let packet = byte_decode_packet_wire(view)?
	emit_packet(packet)
	Ok(())
end
