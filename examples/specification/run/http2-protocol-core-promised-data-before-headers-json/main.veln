# HTTP/2 promised stream DATA-before-HEADERS failures project structured runtime details.

fn invalid_payload(error: String) -> RuntimeDiagnostic
	RuntimeDiagnostic(
		"http2.protocol.invalid_frame_kind",
		error,
		RuntimeHttp2Diagnostic(RuntimeHttp2ProtocolInvalidFrameKindDiagnostic(0, 0, 2, 1, "reserved-by-peer-stream", "reserved_by_peer_requires_response_headers", byte_chunk([])))
	)
end

fn promised_data_header_preview() -> Result<ByteView, RuntimeDiagnostic>
	match byte_chunk_from_hex("000001000000000002aa")
		Ok(bytes) => match byte_offset(0)
			Ok(offset) => match byte_count(9)
				Ok(count) => match byte_view(bytes, offset, count)
					Ok(preview) => Ok(preview)
					Err(error) => Err(invalid_payload(error))
				end
				Err(error) => Err(invalid_payload(error))
			end
			Err(error) => Err(invalid_payload(error))
		end
		Err(error) => Err(invalid_payload(error))
	end
end

pub fn main() -> Result<(), RuntimeDiagnostic>
	let preview: ByteView = promised_data_header_preview()?
	Err(RuntimeDiagnostic(
		"http2.protocol.invalid_frame_kind",
		"HTTP/2 invalid frame kind at byte offset 0",
		RuntimeHttp2Diagnostic(RuntimeHttp2ProtocolInvalidFrameKindDiagnostic(0, 0, 2, 1, "reserved-by-peer-stream", "reserved_by_peer_requires_response_headers", byte_view_to_chunk(preview)))
	))
end
