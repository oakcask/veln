use stdio

type Header
	Header {code: Int, value: Int}
end

schema HeaderWire
	format binary

	wire_code: UInt8
	wire_value: UInt16be

	map to Header
		code = {code: wire_code}.code
		value = wire_value
end

fn emit_output_chunk(name: String, index: Int, chunk: ByteChunk, expected_hex: String) -> () effects [stdio]
	stdio::print("output_chunk ")
	stdio::print(name)
	stdio::print(" index ")
	stdio::print(int_to_string(index))
	stdio::print(" hex \"")
	stdio::print(expected_hex)
	stdio::print("\" count ")
	stdio::println(int_to_string(byte_count_to_int(byte_chunk_count(chunk))))
end

fn emit_encoded(bytes: ByteChunk) -> () effects [stdio]
	stdio::println("output_chunk_list mapped-field-selection count 1")
	emit_output_chunk("mapped-field-selection", 0, bytes, "071234")
end

pub fn main() -> () effects [stdio]
	let encoded: Result<ByteChunk, EncodeError> = byte_encode_header_wire({code: 7, value: 4660})
	match encoded
		Ok(bytes) => emit_encoded(bytes)
		Err(_) => stdio::println("unexpected encode failure")
	end
end
