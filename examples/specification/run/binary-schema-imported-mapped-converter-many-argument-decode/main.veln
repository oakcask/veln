# Binary schema mapping can call an imported public pure converter with many structural arguments.
use stdio
use helpers

type Header
	Header {summary: Int, length: Int}
end

schema HeaderWire
	format binary

	wire_length: UInt16be
	wire_kind: UInt8 where wire_kind <= wire_length

	map to Header
		length = wire_length
		summary = helpers::summarize({value: wire_kind}.value, wire_length + 1, wire_kind * 2, wire_length - wire_kind, wire_kind + 3, wire_length / 2)
end

fn emit_header(header: {summary: Int, length: Int}) -> () effects [stdio]
	stdio::print(int_to_string(header.summary))
	stdio::print(" ")
	stdio::println(int_to_string(header.length))
end

pub fn main() -> Result<(), String> effects [stdio]
	let bytes: ByteChunk = byte_chunk_from_hex("123405")?
	let offset: ByteOffset = byte_offset(0)?
	let count: ByteCount = byte_count(3)?
	let view: ByteView = byte_view(bytes, offset, count)?
	let header: {summary: Int, length: Int} = byte_decode_header_wire(view)?
	emit_header(header)
	Ok(())
end
