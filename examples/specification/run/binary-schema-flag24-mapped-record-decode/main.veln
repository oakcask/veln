# Binary schema mapping can carry Flag24 fields into a target record.
use stdio

type FlagPacket
	FlagPacket {target_be: Flag24be, target_le: Flag24le}
end

schema FlagPacketWire
	format binary

	flags_be: Flag24be
	flags_le: Flag24le

	map to FlagPacket
		target_be = flags_be
		target_le = flags_le
end

fn flag24be_bits_value(flags: Flag24be) -> Int
	match flags
		Flag24be(bits) => bits
	end
end

fn flag24le_bits_value(flags: Flag24le) -> Int
	match flags
		Flag24le(bits) => bits
	end
end

pub fn main() -> Result<(), String> effects [stdio]
	let bytes: ByteChunk = byte_chunk_from_hex("123456563412")?
	let view: ByteView = byte_view(bytes, byte_offset(0)?, byte_count(6)?)?
	let packet: {target_be: Flag24be, target_le: Flag24le} = byte_decode_flag_packet_wire(view)?
	stdio::println(int_to_string(flag24be_bits_value(packet.target_be)))
	stdio::println(int_to_string(flag24le_bits_value(packet.target_le)))
	Ok(())
end
