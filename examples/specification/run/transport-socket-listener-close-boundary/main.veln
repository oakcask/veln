use net from "std"
use fixture_effects
use fake_effects
# Listener close records before accepted stream ownership continues.
use stdio

fn read_count(outcome: net::ReadOutcome) -> Int
	match outcome
		net::ReadChunk(bytes) => byte_count_to_int(byte_chunk_count(bytes))
		net::ReadEnd => 0
	end
end

fn fixture_body() -> Result<net::Stream, net::NetError> effects [net::IO, stdio]
	let listener: net::Listener = net::listen(net::Address(net::Tcp4, "127.0.0.1", 0))?
	let stream: net::Stream = net::accept(listener)?
	let _ = net::close_listener(listener)?
	let incoming = net::read(stream)?
	let _ = net::close_stream(stream)?
	stdio::println(int_to_string(read_count(incoming)))
	net::accept(listener)
end

pub fn main() -> Result<net::Stream, net::NetError> effects [concurrency, fs, net, stdio, time]
	let state = fixture_effects::create_fixture()
	handle handle handle fixture_body() with net::system() with fake_effects::network(state) with fake_effects::clock(state)
end
