# Binary schema packed three-byte reserved bits decode without exposing reserved fields.
use stdio

schema PackedThreeBytePrefixHeader
	format binary

	prefix: UInt8
	control_reserved: ReservedBits(17, 87381)
	control: UInt7
	suffix: UInt8
end

schema PackedThreeByteSuffixHeader
	format binary

	prefix: UInt8
	control: UInt1
	control_padding: ReservedBits(23, 2796202)
	suffix: UInt8
end

fn emit_header(name: String, header: {prefix: Int, control: Int, suffix: Int}) -> () effects [stdio]
	stdio::print(name)
	stdio::print(" ")
	stdio::print(int_to_string(header.prefix))
	stdio::print(" ")
	stdio::print(int_to_string(header.control))
	stdio::print(" ")
	stdio::println(int_to_string(header.suffix))
end

pub fn main() -> Result<(), String> effects [stdio]
	let prefix_bytes = byte_chunk_from_hex("12aaaaaa34")?
	let prefix_offset = byte_offset(0)?
	let prefix_count = byte_count(5)?
	let prefix_view = byte_view(prefix_bytes, prefix_offset, prefix_count)?
	let prefix_header = byte_decode_packed_three_byte_prefix_header(prefix_view)?
	emit_header("prefix", prefix_header)

	let suffix_bytes = byte_chunk_from_hex("12aaaaaa34")?
	let suffix_offset = byte_offset(0)?
	let suffix_count = byte_count(5)?
	let suffix_view = byte_view(suffix_bytes, suffix_offset, suffix_count)?
	let suffix_header = byte_decode_packed_three_byte_suffix_header(suffix_view)?
	emit_header("suffix", suffix_header)
	Ok(())
end
