# Explicit schema operations include product-sized ByteView helpers.
use stdio

schema PacketWire
	format binary

	row_count: UInt8
	column_count: UInt8
	payload: ByteView(row_count * column_count)
end


fn decode_step_kind(step: DecodeStep<{row_count: Int, column_count: Int, payload: ByteView}>) -> String
	match step
		Decoded(_, _) => "decoded"
		NeedMore(_) => "need_more"
		Invalid(_) => "invalid"
	end
end

fn decoded_row_count(step: DecodeStep<{row_count: Int, column_count: Int, payload: ByteView}>) -> Int
	match step
		Decoded(packet, _) => packet.row_count
		NeedMore(_) => -1
		Invalid(_) => -1
	end
end

fn decoded_column_count(step: DecodeStep<{row_count: Int, column_count: Int, payload: ByteView}>) -> Int
	match step
		Decoded(packet, _) => packet.column_count
		NeedMore(_) => -1
		Invalid(_) => -1
	end
end

fn decoded_payload_count(step: DecodeStep<{row_count: Int, column_count: Int, payload: ByteView}>) -> Int
	match step
		Decoded(packet, _) => byte_count_to_int(byte_view_count(packet.payload))
		NeedMore(_) => -1
		Invalid(_) => -1
	end
end

fn decoded_payload_prefix(step: DecodeStep<{row_count: Int, column_count: Int, payload: ByteView}>) -> Int
	match step
		Decoded(packet, _) => byte_read_u16_be(packet.payload)?
		NeedMore(_) => -1
		Invalid(_) => -1
	end
end

fn consumed_count(step: DecodeStep<{row_count: Int, column_count: Int, payload: ByteView}>) -> Int
	match step
		Decoded(_, consumed) => byte_count_to_int(consumed)
		NeedMore(_) => 0
		Invalid(_) => 0
	end
end

fn readiness_kind(step: DecodeStep<{row_count: Int, column_count: Int, payload: ByteView}>) -> String
	match step
		Decoded(_, _) => "none"
		NeedMore(NeedBytes(_)) => "need_bytes"
		NeedMore(NeedEnd) => "need_end"
		Invalid(_) => "none"
	end
end

fn readiness_count(step: DecodeStep<{row_count: Int, column_count: Int, payload: ByteView}>) -> Int
	match step
		Decoded(_, _) => 0
		NeedMore(NeedBytes(count)) => byte_count_to_int(count)
		NeedMore(NeedEnd) => 0
		Invalid(_) => 0
	end
end

fn encode_step_kind(step: EncodeStep<()>) -> String
	match step
		Encoded(_) => "encoded"
		Partial(_, _, _) => "partial"
		Invalid(_) => "invalid"
	end
end

fn encode_error_id(step: EncodeStep<()>) -> String
	match step
		Encoded(_) => "none"
		Partial(_, _, _) => "none"
		Invalid(EncodeError(id, _, _)) => id
	end
end

fn encode_error_path(step: EncodeStep<()>) -> String
	match step
		Encoded(_) => "none"
		Partial(_, _, _) => "none"
		Invalid(EncodeError(_, path, _)) => path
	end
end

fn encode_error_reason(step: EncodeStep<()>) -> String
	match step
		Encoded(_) => "none"
		Partial(_, _, _) => "none"
		Invalid(EncodeError(_, _, reason)) => reason
	end
end

fn emit_output_chunk(name: String, index: Int, chunk: ByteChunk, expected_hex: String) -> () effects [stdio]
	stdio::print("output_chunk ")
	stdio::print(name)
	stdio::print(" index ")
	stdio::print(int_to_string(index))
	stdio::print(" hex \"")
	stdio::print(expected_hex)
	stdio::print("\" count ")
	stdio::println(int_to_string(byte_count_to_int(byte_chunk_count(chunk))))
end

fn emit_one_chunk(chunk: ByteChunk, expected_hex: String) -> () effects [stdio]
	stdio::println("output_chunk_list byteview-product count 1")
	emit_output_chunk("byteview-product", 0, chunk, expected_hex)
end

fn emit_encoded(step: EncodeStep<()>, expected_hex: String) -> () effects [stdio]
	match step
		Encoded(Cons(chunk, Nil)) => emit_one_chunk(chunk, expected_hex)
		Encoded(_) => stdio::println("unexpected encoded chunk count")
		Partial(_, _, _) => stdio::println("unexpected partial encode")
		Invalid(_) => stdio::println("unexpected encode failure")
	end
end

fn encode_result_step(encoded: Result<ByteChunk, EncodeError>) -> EncodeStep<()>
	match encoded
		Ok(chunk) => Encoded(list_cons(chunk, list_nil()))
		Err(error) => Invalid(error)
	end
end

pub fn main() -> Result<(), String> effects [stdio]
	let complete_bytes: ByteChunk = byte_chunk_from_hex("0203aabbccddeeff")?
	let complete_view: ByteView = byte_view(complete_bytes, byte_offset(0)?, byte_count(8)?)?
	let complete: DecodeStep<{row_count: Int, column_count: Int, payload: ByteView}> = decode PacketWire from complete_view at byte_offset(11)?
	stdio::println(decode_step_kind(complete))
	stdio::println(int_to_string(decoded_row_count(complete)))
	stdio::println(int_to_string(decoded_column_count(complete)))
	stdio::println(int_to_string(decoded_payload_count(complete)))
	stdio::println(int_to_string(decoded_payload_prefix(complete)))
	stdio::println(int_to_string(consumed_count(complete)))

	let short_bytes: ByteChunk = byte_chunk_from_hex("02")?
	let short_view: ByteView = byte_view(short_bytes, byte_offset(0)?, byte_count(1)?)?
	let waiting: DecodeStep<{row_count: Int, column_count: Int, payload: ByteView}> = decode PacketWire from short_view at byte_offset(19)?
	stdio::println(decode_step_kind(waiting))
	stdio::println(readiness_kind(waiting))
	stdio::println(int_to_string(readiness_count(waiting)))
	stdio::println(int_to_string(consumed_count(waiting)))

	let payload_bytes: ByteChunk = byte_chunk_from_hex("aabbccddeeff")?
	let payload: ByteView = byte_view(payload_bytes, byte_offset(0)?, byte_count(6)?)?
	let encoded: EncodeStep<()> = encode_result_step(encode PacketWire from {row_count: 2, column_count: 3, payload: payload})
	stdio::println(encode_step_kind(encoded))
	emit_encoded(encoded, "0203aabbccddeeff")

	let short_payload_bytes: ByteChunk = byte_chunk_from_hex("aabbccdd")?
	let short_payload: ByteView = byte_view(short_payload_bytes, byte_offset(0)?, byte_count(4)?)?
	let invalid_encode: EncodeStep<()> = encode_result_step(encode PacketWire from {row_count: 2, column_count: 3, payload: short_payload})
	stdio::println(encode_step_kind(invalid_encode))
	stdio::println(encode_error_id(invalid_encode))
	stdio::println(encode_error_path(invalid_encode))
	stdio::println(encode_error_reason(invalid_encode))
	Ok(())
end
