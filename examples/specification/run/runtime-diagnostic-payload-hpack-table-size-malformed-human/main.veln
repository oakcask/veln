use http2::hpack::diagnostic from "std"
# HPACK fixture helpers return human table-size malformed RuntimeDiagnostic payloads.
fn invalid_payload(error: String) -> RuntimeDiagnostic
	RuntimeDiagnostic(
		"hpack.fixture.table_size_update_malformed",
		error,
		RuntimeHttp2HpackDiagnostic(RuntimeHpackFixtureDiagnostic(77, 0, -1, "fixture HPACK malformed table-size update integer", "hpack_fixture", byte_chunk([])))
	)
end

fn preview_view() -> Result<ByteView, RuntimeDiagnostic>
	match byte_chunk_from_hex("3f80")
		Ok(block) => match byte_offset(0)
			Ok(offset) => match byte_view(block, offset, byte_chunk_count(block))
				Ok(view) => Ok(view)
				Err(error) => Err(invalid_payload(error))
			end
			Err(error) => Err(invalid_payload(error))
		end
		Err(error) => Err(invalid_payload(error))
	end
end

pub fn main() -> Result<(), RuntimeDiagnostic>
	let preview: ByteView = preview_view()?
	http2::hpack::diagnostic::table_size_update_malformed(77, 2, 63, "fixture HPACK malformed table-size update integer", "hpack_fixture", preview)
end
