use http2::hpack::diagnostic from "std"
# HTTP/2 HPACK malformed raw string value projects structured runtime details.

fn fallback_payload(error: String) -> RuntimeDiagnostic
	RuntimeDiagnostic("hpack.fixture.malformed_raw_string_value", error, RuntimeHpackFixtureDiagnostic(9, 0, -1, "fixture HPACK raw string value", "hpack_fixture", byte_chunk([])))
end

fn preview_view() -> Result<ByteView, RuntimeDiagnostic>
	match byte_chunk_from_hex("0803321f30")
		Ok(bytes) => match byte_offset(0)
			Ok(offset) => match byte_view(bytes, offset, byte_chunk_count(bytes))
				Ok(view) => Ok(view)
				Err(error) => Err(fallback_payload(error))
			end
			Err(error) => Err(fallback_payload(error))
		end
		Err(error) => Err(fallback_payload(error))
	end
end

pub fn main() -> Result<(), RuntimeDiagnostic>
	let preview: ByteView = preview_view()?
	http2::hpack::diagnostic::malformed_raw_string_value(9, 5, 8, "fixture HPACK raw string value", "hpack_fixture", preview)
end
