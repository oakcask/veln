use stdio

type Header
	Header {length: Int, kind: Int}
end

schema HeaderWire
	format binary

	wire_length: UInt16be
	wire_kind: UInt8

	map to Header
		length = wire_length
		kind = wire_kind
end

fn emit_output_chunk(name: String, index: Int, chunk: ByteChunk, expected_hex: String) -> () effects [stdio]
	stdio::print("output_chunk ")
	stdio::print(name)
	stdio::print(" index ")
	stdio::print(int_to_string(index))
	stdio::print(" hex \"")
	stdio::print(expected_hex)
	stdio::print("\" count ")
	stdio::println(int_to_string(byte_count_to_int(byte_chunk_count(chunk))))
end

fn emit_encoded(bytes: ByteChunk) -> () effects [stdio]
	stdio::println("output_chunk_list mapped-header count 1")
	emit_output_chunk("mapped-header", 0, bytes, "123407")
end

pub fn main() -> () effects [stdio]
	let encoded: Result<ByteChunk, EncodeError> = byte_encode_header_wire({length: 4660, kind: 7})
	match encoded
		Ok(bytes) => emit_encoded(bytes)
		Err(_) => stdio::println("unexpected encode failure")
	end
end
