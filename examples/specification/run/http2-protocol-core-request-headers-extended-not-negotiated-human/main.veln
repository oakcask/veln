use http2::diagnostic from "std"
# Extended CONNECT negotiation failures project focused request-header diagnostics.

type Http2ProtocolFailure
	InvalidRequestHeaderList {message: String, offset: Int, frame_kind: Int, stream_id: Int, failed_header_fact: String, header_name: String, decoded_header_names: String, preview: ByteChunk}
end

type Http2DiagnosticContext
	DiagnosticContext(String, String)
end

fn http2_protocol_diagnostic(failure: Http2ProtocolFailure, context: Http2DiagnosticContext) -> Result<(), RuntimeDiagnostic>
	match failure
		InvalidRequestHeaderList(message, offset, frame_kind, stream_id, failed_header_fact, header_name, decoded_header_names, preview) => match context
			DiagnosticContext(active_state, rule_provenance) => Err(RuntimeDiagnostic("http2.protocol.invalid_request_header_list", message, RuntimeHttp2Diagnostic(RuntimeHttp2ProtocolInvalidRequestHeaderListDiagnostic(offset, frame_kind, stream_id, failed_header_fact, header_name, decoded_header_names, active_state, rule_provenance, preview))))
		end
	end
end

pub fn main() -> Result<(), RuntimeDiagnostic>
	http2_protocol_diagnostic(InvalidRequestHeaderList("HTTP/2 extended CONNECT was not negotiated at byte offset 12", 12, 9, 1, "extended_connect_not_negotiated", ":protocol", ":method,:protocol,:scheme,:path,:authority", byte_chunk([])), DiagnosticContext("local-connect-protocol-disabled", "rfc8441_extended_connect_negotiation"))
end
