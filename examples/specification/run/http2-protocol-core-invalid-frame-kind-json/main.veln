use http2::diagnostic from "std"
# HTTP/2 connection-state frame kind failures project structured runtime details.

schema Http2FrameHeaderWire
	format binary

	length: UInt24be
	kind: UInt8
	flags: UInt8
	stream_reserved: ReservedBits(1, 0)
	stream_id: UInt31be
end

fn decode_http2_frame_header(view: ByteView, base_offset: ByteOffset) -> Result<{length: Int, kind: Int, flags: Int, stream_id: Int}, String>
	match decode Http2FrameHeaderWire from view at base_offset
		Decoded(header, _) => Ok(header)
		NeedMore(_) => Err("unexpected incomplete HTTP/2 frame header")
		Invalid(_) => Err("unexpected invalid HTTP/2 frame header")
	end
end

type Http2ProtocolFailure
	InvalidFrameKind {offset: Int, actual_kind: Int, stream_id: Int, expected_kind: Int, preview: ByteView}
end

type Http2DiagnosticContext
	DiagnosticContext(String, String)
end

type Http2Step
	FrameOk(Int)
	Waiting
	Failed(Http2ProtocolFailure)
end

fn receive(bytes: ByteChunk) -> Result<Http2Step, String>
	let available: Int = byte_count_to_int(byte_chunk_count(bytes))
	if available < 9
		Ok(Waiting)
	else
		decode_header(bytes)
	end
end

fn decode_header(bytes: ByteChunk) -> Result<Http2Step, String>
	let zero: ByteOffset = byte_offset(0)?
	let header_count: ByteCount = byte_count(9)?
	let view: ByteView = byte_view(bytes, zero, header_count)?
	let header: {length: Int, kind: Int, flags: Int, stream_id: Int} = decode_http2_frame_header(view, zero)?
	validate_connection_frame_kind(0, header.kind, header.stream_id, view)
end

fn validate_connection_frame_kind(offset: Int, kind: Int, stream_id: Int, preview: ByteView) -> Result<Http2Step, String>
	match stream_id
		0 => match kind == 4
			true => Ok(FrameOk(kind))
			false => Ok(Failed(InvalidFrameKind(offset, kind, stream_id, 4, preview)))
		end
		_ => Ok(FrameOk(kind))
	end
end

fn context_active_state(context: Http2DiagnosticContext) -> String
	match context
		DiagnosticContext(active_state, _) => active_state
	end
end

fn context_rule_provenance(context: Http2DiagnosticContext) -> String
	match context
		DiagnosticContext(_, rule_provenance) => rule_provenance
	end
end

fn invalid_payload(error: String) -> RuntimeDiagnostic
	RuntimeDiagnostic(
		"http2.protocol.invalid_frame_kind",
		error,
		RuntimeHttp2Diagnostic(RuntimeHttp2ProtocolInvalidFrameKindDiagnostic(0, 0, 0, 4, "connection-control", "connection_frames_require_settings", byte_chunk([])))
	)
end

fn invalid_frame_kind_payload(offset: Int, actual_kind: Int, stream_id: Int, expected_kind: Int, context: Http2DiagnosticContext, preview: ByteView) -> RuntimeDiagnostic
	RuntimeDiagnostic(
		"http2.protocol.invalid_frame_kind",
		"HTTP/2 invalid frame kind at byte offset 0",
		RuntimeHttp2Diagnostic(RuntimeHttp2ProtocolInvalidFrameKindDiagnostic(offset, actual_kind, stream_id, expected_kind, context_active_state(context), context_rule_provenance(context), byte_view_to_chunk(preview)))
	)
end

fn http2_protocol_diagnostic(failure: Http2ProtocolFailure, context: Http2DiagnosticContext) -> Result<(), RuntimeDiagnostic>
	match failure
		InvalidFrameKind(offset, actual_kind, stream_id, expected_kind, preview) => Err(invalid_frame_kind_payload(offset, actual_kind, stream_id, expected_kind, context, preview))
	end
end

fn input_bytes() -> Result<ByteChunk, RuntimeDiagnostic>
	match byte_chunk_from_hex("000000000000000000")
		Ok(bytes) => Ok(bytes)
		Err(error) => Err(invalid_payload(error))
	end
end

fn receive_step(bytes: ByteChunk) -> Result<Http2Step, RuntimeDiagnostic>
	match receive(bytes)
		Ok(step) => Ok(step)
		Err(error) => Err(invalid_payload(error))
	end
end

pub fn main() -> Result<(), RuntimeDiagnostic>
	let bytes: ByteChunk = input_bytes()?
	let step: Http2Step = receive_step(bytes)?
	let context: Http2DiagnosticContext = DiagnosticContext("connection-control", "connection_frames_require_settings")
	match step
		Failed(failure) => http2_protocol_diagnostic(failure, context)
		FrameOk(_) => Ok(())
		Waiting => Ok(())
	end
end
