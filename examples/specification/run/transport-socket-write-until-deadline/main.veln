use fixture_effects
use fake_effects

# Deadline-aware socket write reports deadline expiry as a value.
fn write_outcome_text(outcome: StreamWriteOutcome) -> String
	match outcome
		WriteCompleted => "written"
		WriteDeadlineExpired => "deadline"
		WriteCancelled => "cancelled"
	end
end

fn fixture_body() -> Result<(), String> effects [net, time, stdio]
	let listener = net::listen("127.0.0.1:0")
	let stream = net::accept(listener)
	let outgoing = byte_chunk_from_hex("0a0b")?
	let deadline = time::deadline_after_ms(100)
	stdio::println(write_outcome_text(net::write_chunk_until(stream, outgoing, deadline)))
	Ok(())
end

pub fn main() -> Result<(), String> effects [concurrency, fs, net, stdio, time]
	let state = fixture_effects::create_fixture()
	handle handle fixture_body() with fake_effects::network(state) with fake_effects::clock(state)
end
