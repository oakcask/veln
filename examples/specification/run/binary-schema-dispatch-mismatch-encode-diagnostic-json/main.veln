schema ExtensionDispatchWritePacket
	format binary

	length: UInt8
	kind: UInt8
	payload: ExtensionDispatch(kind, length, 1 => UInt16be, 2 => UInt32be)
end

fn fixture_error(message: String) -> EncodeError
	EncodeError("schema.dispatch_mismatch", "ExtensionDispatchWritePacket.payload", message)
end

fn raw_payload_view() -> Result<ByteView, EncodeError>
	match byte_chunk_from_hex("aabb")
		Err(message) => Err(fixture_error(message))
		Ok(raw) => match byte_offset(0)
			Err(message) => Err(fixture_error(message))
			Ok(offset) => match byte_count(2)
				Err(message) => Err(fixture_error(message))
				Ok(count) => match byte_view(raw, offset, count)
					Err(message) => Err(fixture_error(message))
					Ok(view) => Ok(view)
				end
			end
		end
	end
end

pub fn main() -> Result<ByteChunk, EncodeError>
	let view: ByteView = raw_payload_view()?
	byte_encode_extension_dispatch_write_packet({length: 2, kind: 1, payload: Unknown(7, view)})
end
