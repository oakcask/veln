# HTTP/2 SETTINGS ACK state failures project structured runtime details.

type Http2ProtocolFailure
	UnexpectedSettingsAck(Int, String, String)
end

fn project(failure: Http2ProtocolFailure) -> Result<(), String>
	match failure
		UnexpectedSettingsAck(offset, active_state, rule_provenance) => http2_protocol_unexpected_settings_ack(offset, active_state, rule_provenance)
	end
end

pub fn main() -> Result<(), String>
	project(UnexpectedSettingsAck(0, "connection-control", "rfc9113_settings_ack_requires_outstanding_local_settings"))
end
