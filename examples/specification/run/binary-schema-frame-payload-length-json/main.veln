use http2::frame from "std"
# Binary schema frame decode rejects a payload range beyond closed input.
pub fn main() -> Result<(), String>
	let bytes: ByteChunk = byte_chunk_from_hex("000005010400000001aabb")?
	let offset: ByteOffset = byte_offset(0)?
	let count: ByteCount = byte_count(11)?
	let view: ByteView = byte_view(bytes, offset, count)?
	let ignored: {length: Int, kind: Int, flags: Int, stream_id: Int, payload: ByteView} = http2::frame::decode(view)?
	Ok(())
end
