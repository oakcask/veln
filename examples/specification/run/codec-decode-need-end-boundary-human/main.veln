# Hand-written codec NeedEnd readiness projects focused human diagnostics.

schema ManualNeedEndWire
	format binary

	marker: UInt8
end

codec ManualNeedEndCodec for ManualNeedEndWire decode
	decode with decode_waiting_for_end
end

fn decode_waiting_for_end(input: ByteView, base: ByteOffset) -> DecodeStep<{marker: Int}>
	NeedMore(NeedEnd)
end

pub fn main() -> DecodeStep<{marker: Int}>
	let bytes: ByteChunk = byte_chunk_from_hex("")?
	let view: ByteView = byte_view(bytes, byte_offset(0)?, byte_count(0)?)?
	ManualNeedEndCodec(view, byte_offset(17)?)
end
