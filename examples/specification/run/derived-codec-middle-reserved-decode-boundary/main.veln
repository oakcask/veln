# Derived codec decode boundaries support middle reserved binary layouts.
use stdio

schema MiddleReservedHeader
	format binary

	high: UInt3
	gap: ReservedBits(2, 1)
	low: UInt3
end

codec MiddleReservedCodec for MiddleReservedHeader decode
	derive decode
end

fn step_kind(step: DecodeStep<{high: Int, low: Int}>) -> String
	match step
		Decoded(_, _) => "decoded"
		NeedMore(_) => "need_more"
		Invalid(_) => "invalid"
	end
end

fn decoded_high(step: DecodeStep<{high: Int, low: Int}>) -> Int
	match step
		Decoded(header, _) => header.high
		NeedMore(_) => -1
		Invalid(_) => -1
	end
end

fn decoded_low(step: DecodeStep<{high: Int, low: Int}>) -> Int
	match step
		Decoded(header, _) => header.low
		NeedMore(_) => -1
		Invalid(_) => -1
	end
end

fn consumed_count(step: DecodeStep<{high: Int, low: Int}>) -> Int
	match step
		Decoded(_, consumed) => byte_count_to_int(consumed)
		NeedMore(_) => 0
		Invalid(_) => 0
	end
end

fn readiness_kind(step: DecodeStep<{high: Int, low: Int}>) -> String
	match step
		Decoded(_, _) => "none"
		NeedMore(NeedBytes(_)) => "need_bytes"
		NeedMore(NeedEnd) => "need_end"
		Invalid(_) => "none"
	end
end

fn readiness_count(step: DecodeStep<{high: Int, low: Int}>) -> Int
	match step
		Decoded(_, _) => 0
		NeedMore(NeedBytes(count)) => byte_count_to_int(count)
		NeedMore(NeedEnd) => 0
		Invalid(_) => 0
	end
end

fn error_id(step: DecodeStep<{high: Int, low: Int}>) -> String
	match step
		Decoded(_, _) => "none"
		NeedMore(_) => "none"
		Invalid(DecodeError(id, _, _)) => id
		Invalid(DecodeErrorWithReason(id, _, _, _)) => id
	end
end

fn error_offset(step: DecodeStep<{high: Int, low: Int}>) -> Int
	match step
		Decoded(_, _) => -1
		NeedMore(_) => -1
		Invalid(DecodeError(_, offset, _)) => byte_offset_to_int(offset)
		Invalid(DecodeErrorWithReason(_, offset, _, _)) => byte_offset_to_int(offset)
	end
end

fn error_path(step: DecodeStep<{high: Int, low: Int}>) -> String
	match step
		Decoded(_, _) => "none"
		NeedMore(_) => "none"
		Invalid(DecodeError(_, _, path)) => path
		Invalid(DecodeErrorWithReason(_, _, path, _)) => path
	end
end

pub fn main() -> Result<(), String> effects [stdio]
	let complete_bytes: ByteChunk = byte_chunk_from_hex("ae")?
	let complete_view: ByteView = byte_view(complete_bytes, byte_offset(0)?, byte_count(1)?)?
	let complete: DecodeStep<{high: Int, low: Int}> = MiddleReservedCodec(complete_view, byte_offset(32)?)
	stdio::println(step_kind(complete))
	stdio::println(int_to_string(decoded_high(complete)))
	stdio::println(int_to_string(decoded_low(complete)))
	stdio::println(int_to_string(consumed_count(complete)))

	let short_bytes: ByteChunk = byte_chunk_from_hex("")?
	let short_view: ByteView = byte_view(short_bytes, byte_offset(0)?, byte_count(0)?)?
	let waiting: DecodeStep<{high: Int, low: Int}> = MiddleReservedCodec(short_view, byte_offset(64)?)
	stdio::println(step_kind(waiting))
	stdio::println(readiness_kind(waiting))
	stdio::println(int_to_string(readiness_count(waiting)))
	stdio::println(int_to_string(consumed_count(waiting)))

	let invalid_bytes: ByteChunk = byte_chunk_from_hex("be")?
	let invalid_view: ByteView = byte_view(invalid_bytes, byte_offset(0)?, byte_count(1)?)?
	let invalid: DecodeStep<{high: Int, low: Int}> = MiddleReservedCodec(invalid_view, byte_offset(96)?)
	stdio::println(step_kind(invalid))
	stdio::println(int_to_string(consumed_count(invalid)))
	stdio::println(error_id(invalid))
	stdio::println(int_to_string(error_offset(invalid)))
	stdio::println(error_path(invalid))
	Ok(())
end
