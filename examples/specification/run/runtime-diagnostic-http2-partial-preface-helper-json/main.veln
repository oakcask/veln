use http2::diagnostic from "std"
# HTTP/2 partial preface helper returns a RuntimeDiagnostic payload.
fn fallback_payload(error: String) -> RuntimeDiagnostic
	RuntimeDiagnostic(
		"http2.protocol.partial_preface",
		error,
		RuntimeHttp2ProtocolPartialPrefaceDiagnostic(0, 0, 24, "connection-preface", "rfc9113_client_connection_preface", byte_chunk([]))
	)
end

fn preview_view() -> Result<ByteView, RuntimeDiagnostic>
	match byte_chunk_from_hex("505249202a20485454502f32")
		Ok(bytes) => match byte_offset(0)
			Ok(offset) => match byte_view(bytes, offset, byte_chunk_count(bytes))
				Ok(view) => Ok(view)
				Err(error) => Err(fallback_payload(error))
			end
			Err(error) => Err(fallback_payload(error))
		end
		Err(error) => Err(fallback_payload(error))
	end
end

pub fn main() -> Result<(), RuntimeDiagnostic>
	let preview: ByteView = preview_view()?
	http2::diagnostic::protocol_partial_preface(0, 12, preview)
end
