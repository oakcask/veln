# Binary schema UInt31le decode reports out-of-range integers in human mode.
schema LittleEndianStreamIdentifierSample
	format binary

	stream_id: UInt31le
end

pub fn main() -> Result<(), String>
	let bytes: ByteChunk = byte_chunk_from_hex("00000080")?
	let offset: ByteOffset = byte_offset(0)?
	let count: ByteCount = byte_count(4)?
	let view: ByteView = byte_view(bytes, offset, count)?
	let ignored: {stream_id: Int} = byte_decode_little_endian_stream_identifier_sample(view)?
	Ok(())
end
