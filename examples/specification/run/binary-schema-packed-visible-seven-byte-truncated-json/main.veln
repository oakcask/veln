schema PackedVisibleSevenByteHeader
	format binary

	high: UInt7
	upper: UInt7
	middle: UInt7
	lower: UInt7
	tail: UInt7
	flag: UInt7
	code: UInt7
	route: UInt7
end

pub fn main() -> Result<(), String>
	let bytes: ByteChunk = byte_chunk_from_hex("abcdef1234")?
	let view: ByteView = byte_view(bytes, byte_offset(0)?, byte_count(5)?)?
	let ignored: {high: Int, upper: Int, middle: Int, lower: Int, tail: Int, flag: Int, code: Int, route: Int} = byte_decode_packed_visible_seven_byte_header(view)?
	Ok(())
end
