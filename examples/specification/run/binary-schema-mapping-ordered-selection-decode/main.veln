# Binary schema selected mappings can use ordered Int selector comparisons.
use stdio

type Packet
	Packet {branch: Int, kind: Int, value: Int}
end

schema PacketWire
	format binary

	kind: UInt8
	value: UInt8

	map to Packet when kind < 2
		branch = kind
		kind = kind
		value = value

	map to Packet when kind >= 2
		branch = kind
		kind = kind
		value = value
end

pub fn main() -> Result<(), String> effects [stdio]
	let first_bytes: ByteChunk = byte_chunk_from_hex("0107")?
	let first_view: ByteView = byte_view(first_bytes, byte_offset(0)?, byte_count(2)?)?
	let first: {branch: Int, kind: Int, value: Int} = byte_decode_packet_wire(first_view)?
	stdio::println(int_to_string(first.branch))
	stdio::println(int_to_string(first.value))

	let second_bytes: ByteChunk = byte_chunk_from_hex("0209")?
	let second_view: ByteView = byte_view(second_bytes, byte_offset(0)?, byte_count(2)?)?
	let second: {branch: Int, kind: Int, value: Int} = byte_decode_packet_wire(second_view)?
	stdio::println(int_to_string(second.branch))
	stdio::println(int_to_string(second.value))

	Ok(())
end
