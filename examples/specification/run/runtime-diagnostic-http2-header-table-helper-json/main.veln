# HTTP/2 header-table helper returns a RuntimeDiagnostic payload.
fn invalid_payload(error: String) -> RuntimeDiagnostic
	RuntimeDiagnostic(
		"http2.peer_limit.header_table_size_exceeded",
		error,
		RuntimeHttp2PeerLimitHeaderTableSizeDiagnostic(35, 289, 160, 9, 1, "local_configuration", "hpack_dynamic_table_size_update", byte_chunk([]))
	)
end

fn preview_bytes() -> Result<ByteChunk, RuntimeDiagnostic>
	match byte_chunk_from_hex("3f8101")
		Ok(bytes) => Ok(bytes)
		Err(error) => Err(invalid_payload(error))
	end
end

fn preview_view(bytes: ByteChunk) -> Result<ByteView, RuntimeDiagnostic>
	match byte_offset(0)
		Ok(offset) => match byte_count(3)
			Ok(count) => match byte_view(bytes, offset, count)
				Ok(view) => Ok(view)
				Err(error) => Err(invalid_payload(error))
			end
			Err(error) => Err(invalid_payload(error))
		end
		Err(error) => Err(invalid_payload(error))
	end
end

pub fn main() -> Result<(), RuntimeDiagnostic>
	let update: ByteChunk = preview_bytes()?
	let preview: ByteView = preview_view(update)?
	http2_peer_limit_header_table_size_exceeded(35, 289, 160, 9, 1, "local_configuration", "hpack_dynamic_table_size_update", preview)
end
