# Binary schema UInt40le truncation reports schema field byte details.
schema UInt40Widths
	format binary

	big_value: UInt40be
	little_value: UInt40le
end

pub fn main() -> Result<(), String>
	let bytes: ByteChunk = byte_chunk_from_hex("010203040505040302")?
	let offset: ByteOffset = byte_offset(0)?
	let count: ByteCount = byte_count(9)?
	let view: ByteView = byte_view(bytes, offset, count)?
	let ignored: {big_value: Int, little_value: Int} = byte_decode_uint40_widths(view)?
	Ok(())
end
