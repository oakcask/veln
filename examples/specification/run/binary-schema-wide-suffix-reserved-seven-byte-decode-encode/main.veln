use stdio

schema SevenByteWideSuffixHeader
	format binary

	value: UInt7
	guard: ReservedBits(49, 375299968947541)
end


fn decode_step_kind(step: DecodeStep<{value: Int}>) -> String
	match step
		Decoded(_, _) => "decoded"
		NeedMore(_) => "need_more"
		Invalid(_) => "invalid"
	end
end

fn decoded_value(step: DecodeStep<{value: Int}>) -> Int
	match step
		Decoded(header, _) => header.value
		NeedMore(_) => -1
		Invalid(_) => -1
	end
end

fn consumed_count(step: DecodeStep<{value: Int}>) -> Int
	match step
		Decoded(_, consumed) => byte_count_to_int(consumed)
		NeedMore(_) => 0
		Invalid(_) => 0
	end
end

fn readiness_kind(step: DecodeStep<{value: Int}>) -> String
	match step
		Decoded(_, _) => "none"
		NeedMore(NeedBytes(_)) => "need_bytes"
		NeedMore(NeedEnd) => "need_end"
		Invalid(_) => "none"
	end
end

fn readiness_count(step: DecodeStep<{value: Int}>) -> Int
	match step
		Decoded(_, _) => 0
		NeedMore(NeedBytes(count)) => byte_count_to_int(count)
		NeedMore(NeedEnd) => 0
		Invalid(_) => 0
	end
end

fn decode_error_id(step: DecodeStep<{value: Int}>) -> String
	match step
		Decoded(_, _) => "none"
		NeedMore(_) => "none"
		Invalid(DecodeError(id, _, _)) => id
		Invalid(DecodeErrorWithReason(id, _, _, _)) => id
	end
end

fn decode_error_offset(step: DecodeStep<{value: Int}>) -> Int
	match step
		Decoded(_, _) => -1
		NeedMore(_) => -1
		Invalid(DecodeError(_, offset, _)) => byte_offset_to_int(offset)
		Invalid(DecodeErrorWithReason(_, offset, _, _)) => byte_offset_to_int(offset)
	end
end

fn decode_error_path(step: DecodeStep<{value: Int}>) -> String
	match step
		Decoded(_, _) => "none"
		NeedMore(_) => "none"
		Invalid(DecodeError(_, _, path)) => path
		Invalid(DecodeErrorWithReason(_, _, path, _)) => path
	end
end

fn encode_step_kind(step: EncodeStep<()>) -> String
	match step
		Encoded(_) => "encoded"
		Partial(_, _, _) => "partial"
		Invalid(_) => "invalid"
	end
end

fn encode_error_id(step: EncodeStep<()>) -> String
	match step
		Encoded(_) => "none"
		Partial(_, _, _) => "none"
		Invalid(EncodeError(id, _, _)) => id
	end
end

fn encode_error_path(step: EncodeStep<()>) -> String
	match step
		Encoded(_) => "none"
		Partial(_, _, _) => "none"
		Invalid(EncodeError(_, path, _)) => path
	end
end

fn encode_error_reason(step: EncodeStep<()>) -> String
	match step
		Encoded(_) => "none"
		Partial(_, _, _) => "none"
		Invalid(EncodeError(_, _, reason)) => reason
	end
end

fn emit_output_chunk(name: String, index: Int, chunk: ByteChunk, expected_hex: String) -> () effects [stdio]
	stdio::print("output_chunk ")
	stdio::print(name)
	stdio::print(" index ")
	stdio::print(int_to_string(index))
	stdio::print(" hex \"")
	stdio::print(expected_hex)
	stdio::print("\" count ")
	stdio::println(int_to_string(byte_count_to_int(byte_chunk_count(chunk))))
end

fn emit_encoded_chunk(name: String, chunk: ByteChunk, expected_hex: String) -> () effects [stdio]
	stdio::print("output_chunk_list ")
	stdio::print(name)
	stdio::println(" count 1")
	emit_output_chunk(name, 0, chunk, expected_hex)
end

fn emit_unexpected_chunk_count(chunks: List<ByteChunk>) -> () effects [stdio]
	stdio::println("unexpected chunk count")
end

fn emit_direct_encoded(encoded: Result<ByteChunk, EncodeError>, expected_hex: String) -> () effects [stdio]
	match encoded
		Ok(chunk) => emit_encoded_chunk("wide-suffix-seven", chunk, expected_hex)
		Err(_) => stdio::println("unexpected direct encode failure")
	end
end

fn emit_derived_encoded(name: String, step: EncodeStep<()>, expected_hex: String) -> () effects [stdio]
	match step
		Encoded(Cons(chunk, Nil)) => emit_encoded_chunk(name, chunk, expected_hex)
		Encoded(chunks) => emit_unexpected_chunk_count(chunks)
		Partial(_, _, _) => stdio::println("unexpected partial encode")
		Invalid(_) => stdio::println("unexpected encode failure")
	end
end

fn encode_result_step(encoded: Result<ByteChunk, EncodeError>) -> EncodeStep<()>
	match encoded
		Ok(chunk) => Encoded(list_cons(chunk, list_nil()))
		Err(error) => Invalid(error)
	end
end

pub fn main() -> Result<(), String> effects [stdio]
	let bytes = byte_chunk_from_hex("ab555555555555")?
	let view = byte_view(bytes, byte_offset(0)?, byte_count(7)?)?
	let decoded = byte_decode_seven_byte_wide_suffix_header(view)?
	stdio::println(int_to_string(decoded.value))

	let direct_encoded = byte_encode_seven_byte_wide_suffix_header({value: 85})
	emit_direct_encoded(direct_encoded, "ab555555555555")

	let derived_decoded = decode SevenByteWideSuffixHeader from view at byte_offset(0)?
	stdio::println(decode_step_kind(derived_decoded))
	stdio::println(int_to_string(decoded_value(derived_decoded)))
	stdio::println(int_to_string(consumed_count(derived_decoded)))

	let short_view = byte_view(bytes, byte_offset(0)?, byte_count(6)?)?
	let waiting = decode SevenByteWideSuffixHeader from short_view at byte_offset(10)?
	stdio::println(decode_step_kind(waiting))
	stdio::println(readiness_kind(waiting))
	stdio::println(int_to_string(readiness_count(waiting)))
	stdio::println(int_to_string(consumed_count(waiting)))

	let invalid_bytes = byte_chunk_from_hex("ab555555555554")?
	let invalid_view = byte_view(invalid_bytes, byte_offset(0)?, byte_count(7)?)?
	let invalid_decoded = decode SevenByteWideSuffixHeader from invalid_view at byte_offset(20)?
	stdio::println(decode_step_kind(invalid_decoded))
	stdio::println(int_to_string(consumed_count(invalid_decoded)))
	stdio::println(decode_error_id(invalid_decoded))
	stdio::println(int_to_string(decode_error_offset(invalid_decoded)))
	stdio::println(decode_error_path(invalid_decoded))

	let derived_encoded = encode_result_step(encode SevenByteWideSuffixHeader from {value: 85})
	stdio::println(encode_step_kind(derived_encoded))
	emit_derived_encoded("wide-suffix-seven-derived", derived_encoded, "ab555555555555")

	let rejected = encode_result_step(encode SevenByteWideSuffixHeader from {value: 128})
	stdio::println(encode_step_kind(rejected))
	stdio::println(encode_error_id(rejected))
	stdio::println(encode_error_path(rejected))
	stdio::println(encode_error_reason(rejected))
	Ok(())
end
