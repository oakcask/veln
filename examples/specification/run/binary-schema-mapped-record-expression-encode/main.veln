use stdio

type Header
	Header {summary: {value: Int}, kind: Int}
end

schema HeaderWire
	format binary

	length: UInt16be
	kind: UInt8

	map to Header
		summary = {value: length}
		kind = kind
end

fn emit_output_chunk(name: String, index: Int, chunk: ByteChunk, expected_hex: String) -> () effects [stdio]
	stdio::print("output_chunk ")
	stdio::print(name)
	stdio::print(" index ")
	stdio::print(int_to_string(index))
	stdio::print(" hex \"")
	stdio::print(expected_hex)
	stdio::print("\" count ")
	stdio::println(int_to_string(byte_count_to_int(byte_chunk_count(chunk))))
end

fn emit_encoded(bytes: ByteChunk) -> () effects [stdio]
	stdio::println("output_chunk_list mapped-record-expression count 1")
	emit_output_chunk("mapped-record-expression", 0, bytes, "123405")
end

pub fn main() -> () effects [stdio]
	let encoded: Result<ByteChunk, EncodeError> = byte_encode_header_wire({summary: {value: 4660}, kind: 5})
	match encoded
		Ok(bytes) => emit_encoded(bytes)
		Err(_) => stdio::println("unexpected encode failure")
	end
end
