use stdio

schema Flag24bePacket
	format binary

	flags: Flag24be
end

schema Flag24lePacket
	format binary

	flags: Flag24le
end

fn error_id(error: EncodeError) -> String
	match error
		EncodeError(id, _, _) => id
	end
end

fn error_path(error: EncodeError) -> String
	match error
		EncodeError(_, field_path, _) => field_path
	end
end

fn error_reason(error: EncodeError) -> String
	match error
		EncodeError(_, _, reason) => reason
	end
end

fn emit_error(error: EncodeError) -> () effects [stdio]
	stdio::println(error_id(error))
	stdio::println(error_path(error))
	stdio::println(error_reason(error))
end

pub fn main() -> () effects [stdio]
	let encoded_be: Result<ByteChunk, EncodeError> = byte_encode_flag24be_packet({flags: Flag24be(16777216)})
	match encoded_be
		Ok(_) => stdio::println("unexpected flag24be encode success")
		Err(error) => emit_error(error)
	end
	let encoded_le: Result<ByteChunk, EncodeError> = byte_encode_flag24le_packet({flags: Flag24le(16777216)})
	match encoded_le
		Ok(_) => stdio::println("unexpected flag24le encode success")
		Err(error) => emit_error(error)
	end
end
