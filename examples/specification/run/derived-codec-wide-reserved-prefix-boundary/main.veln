use stdio

schema SevenBytePrefixReservedGroupHeader
	format binary

	prefix: ReservedBits(49, 375299968947541)
	high: UInt3
	low: UInt4
end

schema EightBytePrefixReservedGroupHeader
	format binary

	prefix: ReservedBits(57, 96076792050570581)
	high: UInt3
	low: UInt4
end



fn step_kind(step: DecodeStep<{high: Int, low: Int}>) -> String
	match step
		Decoded(_, _) => "decoded"
		NeedMore(_) => "need_more"
		Invalid(_) => "invalid"
	end
end

fn decoded_high(step: DecodeStep<{high: Int, low: Int}>) -> Int
	match step
		Decoded(header, _) => header.high
		NeedMore(_) => -1
		Invalid(_) => -1
	end
end

fn decoded_low(step: DecodeStep<{high: Int, low: Int}>) -> Int
	match step
		Decoded(header, _) => header.low
		NeedMore(_) => -1
		Invalid(_) => -1
	end
end

fn consumed_count(step: DecodeStep<{high: Int, low: Int}>) -> Int
	match step
		Decoded(_, consumed) => byte_count_to_int(consumed)
		NeedMore(_) => 0
		Invalid(_) => 0
	end
end

fn error_id(step: DecodeStep<{high: Int, low: Int}>) -> String
	match step
		Decoded(_, _) => "none"
		NeedMore(_) => "none"
		Invalid(DecodeError(id, _, _)) => id
		Invalid(DecodeErrorWithReason(id, _, _, _)) => id
	end
end

fn error_offset(step: DecodeStep<{high: Int, low: Int}>) -> Int
	match step
		Decoded(_, _) => -1
		NeedMore(_) => -1
		Invalid(DecodeError(_, offset, _)) => byte_offset_to_int(offset)
		Invalid(DecodeErrorWithReason(_, offset, _, _)) => byte_offset_to_int(offset)
	end
end

fn error_path(step: DecodeStep<{high: Int, low: Int}>) -> String
	match step
		Decoded(_, _) => "none"
		NeedMore(_) => "none"
		Invalid(DecodeError(_, _, path)) => path
		Invalid(DecodeErrorWithReason(_, _, path, _)) => path
	end
end

fn encode_kind(step: EncodeStep<()>) -> String
	match step
		Encoded(_) => "encoded"
		Partial(_, _, _) => "partial"
		Invalid(_) => "invalid"
	end
end

fn emit_output_chunk(name: String, index: Int, chunk: ByteChunk, expected_hex: String) -> () effects [stdio]
	stdio::print("output_chunk ")
	stdio::print(name)
	stdio::print(" index ")
	stdio::print(int_to_string(index))
	stdio::print(" hex \"")
	stdio::print(expected_hex)
	stdio::print("\" count ")
	stdio::println(int_to_string(byte_count_to_int(byte_chunk_count(chunk))))
end

fn emit_one_chunk(name: String, chunk: ByteChunk, expected_hex: String) -> () effects [stdio]
	stdio::print("output_chunk_list ")
	stdio::print(name)
	stdio::println(" count 1")
	emit_output_chunk(name, 0, chunk, expected_hex)
end

fn encode_result_step(encoded: Result<ByteChunk, EncodeError>) -> EncodeStep<()>
	match encoded
		Ok(chunk) => Encoded(list_cons(chunk, list_nil()))
		Err(error) => Invalid(error)
	end
end

pub fn main() -> Result<(), String> effects [stdio]
	let seven_bytes: ByteChunk = byte_chunk_from_hex("aaaaaaaaaaaada")?
	let seven_view: ByteView = byte_view(seven_bytes, byte_offset(0)?, byte_count(7)?)?
	let seven_decoded: DecodeStep<{high: Int, low: Int}> = decode SevenBytePrefixReservedGroupHeader from seven_view at byte_offset(4)?
	stdio::println("seven")
	stdio::println(step_kind(seven_decoded))
	stdio::println(int_to_string(decoded_high(seven_decoded)))
	stdio::println(int_to_string(decoded_low(seven_decoded)))
	stdio::println(int_to_string(consumed_count(seven_decoded)))

	let invalid_bytes: ByteChunk = byte_chunk_from_hex("aaaaaaaaaaab5a")?
	let invalid_view: ByteView = byte_view(invalid_bytes, byte_offset(0)?, byte_count(7)?)?
	let invalid: DecodeStep<{high: Int, low: Int}> = decode SevenBytePrefixReservedGroupHeader from invalid_view at byte_offset(20)?
	stdio::println(step_kind(invalid))
	stdio::println(int_to_string(consumed_count(invalid)))
	stdio::println(error_id(invalid))
	stdio::println(int_to_string(error_offset(invalid)))
	stdio::println(error_path(invalid))

	let eight_bytes: ByteChunk = byte_chunk_from_hex("aaaaaaaaaaaaaada")?
	let eight_view: ByteView = byte_view(eight_bytes, byte_offset(0)?, byte_count(8)?)?
	let eight_decoded: DecodeStep<{high: Int, low: Int}> = decode EightBytePrefixReservedGroupHeader from eight_view at byte_offset(30)?
	stdio::println("eight")
	stdio::println(step_kind(eight_decoded))
	stdio::println(int_to_string(decoded_high(eight_decoded)))
	stdio::println(int_to_string(decoded_low(eight_decoded)))
	stdio::println(int_to_string(consumed_count(eight_decoded)))

	let encoded: EncodeStep<()> = encode_result_step(encode EightBytePrefixReservedGroupHeader from {high: 5, low: 10})
	stdio::println(encode_kind(encoded))
	let output: () = match encoded
		Encoded(Cons(chunk, Nil)) => emit_one_chunk("wide-prefix", chunk, "aaaaaaaaaaaaaada")
		Encoded(_) => stdio::println("unexpected encoded chunk count")
		Partial(_, _, _) => stdio::println("unexpected partial encode")
		Invalid(_) => stdio::println("unexpected encode failure")
	end

	Ok(())
end
