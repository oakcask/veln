# Duplicate :protocol failures project focused request-header diagnostics.

pub fn main() -> Result<(), RuntimeDiagnostic>
	Err(RuntimeDiagnostic("http2.protocol.invalid_request_header_list", "HTTP/2 extended CONNECT contains duplicate :protocol at byte offset 12", RuntimeHttp2ProtocolInvalidRequestHeaderListDiagnostic(12, 1, 1, "duplicate_protocol_pseudo_header", ":protocol", ":method,:protocol,:protocol,:scheme,:path,:authority", "request-headers", "rfc8441_extended_connect_pseudo_headers", byte_chunk([]))))
end
