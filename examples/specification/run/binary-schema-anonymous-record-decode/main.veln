# Binary schema anonymous record fields decode nested visible records.
use stdio

schema AnonymousRecordPacket
	format binary

	prefix: UInt8
	header: {kind: UInt8, code: UInt16be, tail: UInt16le}
	suffix: UInt8
end

pub fn main() -> Result<(), String> effects [stdio]
	let bytes: ByteChunk = byte_chunk_from_hex("0a0102030405ff")?
	let view: ByteView = byte_view(bytes, byte_offset(0)?, byte_count(7)?)?
	let packet: {prefix: Int, header: {kind: Int, code: Int, tail: Int}, suffix: Int} = byte_decode_anonymous_record_packet(view)?
	stdio::print(int_to_string(packet.prefix))
	stdio::print(" ")
	stdio::print(int_to_string(packet.header.kind))
	stdio::print(" ")
	stdio::print(int_to_string(packet.header.code))
	stdio::print(" ")
	stdio::print(int_to_string(packet.header.tail))
	stdio::print(" ")
	stdio::println(int_to_string(packet.suffix))
	Ok(())
end
