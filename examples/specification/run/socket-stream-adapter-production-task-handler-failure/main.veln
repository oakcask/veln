# Production loopback adapter handles per-stream task handler failure as a source outcome.
use stdio

type ResponseAction
	SendBytes(bytes: ByteChunk)
	EndStream
	HandlerFailed(reason: String)
	Ignore
end

fn handle_stream_event(context: { input: StreamInput, state: { chunks : Int, ended : Bool }, route: { stream : String, lane : String }, trace: { trace_id : String, sequence : Int } }) -> Result<{ action : ResponseAction, next_state : { chunks : Int, ended : Bool }, event_kind : String, byte_count : Int, route : { stream : String, lane : String }, trace : { trace_id : String, sequence : Int } }, String>
	match context.input
		Chunk(_) => Err("handler rejected stream chunk")
		End => Ok({ action: EndStream, next_state: { chunks: context.state.chunks, ended: true }, event_kind: "end", byte_count: 0, route: context.route, trace: context.trace })
	end
end

fn run_adapter_handler_task(context: { input: StreamInput, state: { chunks : Int, ended : Bool }, route: { stream : String, lane : String }, trace: { trace_id : String, sequence : Int } }) -> Result<{ action : ResponseAction, next_state : { chunks : Int, ended : Bool }, event_kind : String, byte_count : Int, route : { stream : String, lane : String }, trace : { trace_id : String, sequence : Int } }, String> effects [concurrency]
	handle_stream_event(context)
end

fn route_input(route: { tx : Sender<StreamInput>, rx : Receiver<StreamInput> }, input: StreamInput) -> StreamInput effects [concurrency]
	let _ = channel::send(route.tx, input)
	match channel::recv(route.rx)
		Some(value) => value
		None => End
	end
end

fn read_stream_input(stream: NetStream) -> StreamInput effects [net]
	match net::read_chunk_or_end(stream)
		Some(bytes) => Chunk(bytes)
		None => End
	end
end

fn failed_result(reason: String, state: { chunks : Int, ended : Bool }, route: { stream : String, lane : String }, trace: { trace_id : String, sequence : Int }) -> { action : ResponseAction, next_state : { chunks : Int, ended : Bool }, event_kind : String, byte_count : Int, route : { stream : String, lane : String }, trace : { trace_id : String, sequence : Int } }
	{ action: HandlerFailed(reason), next_state: state, event_kind: "handler-failed", byte_count: 0, route: route, trace: trace }
end

fn handle_routed_input(input: StreamInput, state: { chunks : Int, ended : Bool }, route: { stream : String, lane : String }, trace: { trace_id : String, sequence : Int }) -> { action : ResponseAction, next_state : { chunks : Int, ended : Bool }, event_kind : String, byte_count : Int, route : { stream : String, lane : String }, trace : { trace_id : String, sequence : Int } } effects [concurrency]
	let context = { input: input, state: state, route: route, trace: trace }
	let worker = task::spawn_with<Result<{ action : ResponseAction, next_state : { chunks : Int, ended : Bool }, event_kind : String, byte_count : Int, route : { stream : String, lane : String }, trace : { trace_id : String, sequence : Int } }, String>, { input: StreamInput, state: { chunks : Int, ended : Bool }, route: { stream : String, lane : String }, trace: { trace_id : String, sequence : Int } }>(run_adapter_handler_task, context)
	match task::join(worker)
		Ok(Ok(value)) => value
		Ok(Err(reason)) => failed_result(reason, state, route, trace)
		Err(_) => failed_result("task join failed", state, route, trace)
	end
end

fn write_count(actions: List<ResponseAction>) -> Int
	match actions
		Nil => 0
		Cons(action, tail) => match action
			SendBytes(_) => 1 + write_count(tail)
			EndStream => write_count(tail)
			HandlerFailed(_) => write_count(tail)
			Ignore => write_count(tail)
		end
	end
end

fn failure_count(actions: List<ResponseAction>) -> Int
	match actions
		Nil => 0
		Cons(action, tail) => match action
			SendBytes(_) => failure_count(tail)
			EndStream => failure_count(tail)
			HandlerFailed(_) => 1 + failure_count(tail)
			Ignore => failure_count(tail)
		end
	end
end

fn ordered_send_chunks(actions: List<ResponseAction>) -> List<ByteChunk>
	match actions
		Nil => list_nil()
		Cons(action, tail) => match action
			SendBytes(bytes) => list_cons(bytes, ordered_send_chunks(tail))
			EndStream => ordered_send_chunks(tail)
			HandlerFailed(_) => ordered_send_chunks(tail)
			Ignore => ordered_send_chunks(tail)
		end
	end
end

fn collect_first_result(stream: NetStream, channel_route: { tx : Sender<StreamInput>, rx : Receiver<StreamInput> }, adapter_route: { stream : String, lane : String }, state: { chunks : Int, ended : Bool }) -> { actions : List<ResponseAction>, next_state : { chunks : Int, ended : Bool }, routed_events : Int, total_bytes : Int, first_sequence : Int, last_sequence : Int, trace_id : String, route_stream : String, route_lane : String, failure_reason : String } effects [net, concurrency]
	let input = route_input(channel_route, read_stream_input(stream))
	let result = handle_routed_input(input, state, adapter_route, { trace_id: "trace-failure", sequence: state.chunks + 1 })
	match result.action
		SendBytes(bytes) => { actions: list_cons(result.action, list_nil()), next_state: result.next_state, routed_events: 1, total_bytes: byte_count_to_int(byte_chunk_count(bytes)), first_sequence: result.trace.sequence, last_sequence: result.trace.sequence, trace_id: result.trace.trace_id, route_stream: result.route.stream, route_lane: result.route.lane, failure_reason: "none" }
		EndStream => { actions: list_cons(result.action, list_nil()), next_state: result.next_state, routed_events: 1, total_bytes: 0, first_sequence: result.trace.sequence, last_sequence: result.trace.sequence, trace_id: result.trace.trace_id, route_stream: result.route.stream, route_lane: result.route.lane, failure_reason: "none" }
		HandlerFailed(reason) => { actions: list_cons(result.action, list_nil()), next_state: result.next_state, routed_events: 1, total_bytes: 0, first_sequence: result.trace.sequence, last_sequence: result.trace.sequence, trace_id: result.trace.trace_id, route_stream: result.route.stream, route_lane: result.route.lane, failure_reason: reason }
		Ignore => { actions: list_cons(result.action, list_nil()), next_state: result.next_state, routed_events: 1, total_bytes: 0, first_sequence: result.trace.sequence, last_sequence: result.trace.sequence, trace_id: result.trace.trace_id, route_stream: result.route.stream, route_lane: result.route.lane, failure_reason: "none" }
	end
end

fn collect_stream_failure(stream: NetStream, adapter_route: { stream : String, lane : String }) -> { actions : List<ResponseAction>, next_state : { chunks : Int, ended : Bool }, routed_events : Int, total_bytes : Int, first_sequence : Int, last_sequence : Int, trace_id : String, route_stream : String, route_lane : String, failure_reason : String } effects [net, concurrency]
	let channel_route = channel::bounded<StreamInput>(1)
	collect_first_result(stream, channel_route, adapter_route, { chunks: 0, ended: false })
end

fn accepted_lifecycle(stream: NetStream, adapter_route: { stream : String, lane : String }) -> Result<{ actions : List<ResponseAction>, next_state : { chunks : Int, ended : Bool }, routed_events : Int, total_bytes : Int, first_sequence : Int, last_sequence : Int, trace_id : String, route_stream : String, route_lane : String, failure_reason : String }, String> effects [net, concurrency]
	let summary = collect_stream_failure(stream, adapter_route)
	let _ = match failure_count(summary.actions)
		0 => net::write_chunks(stream, ordered_send_chunks(summary.actions))
		_ => ()
	end
	net::close_stream(stream)
	Ok(summary)
end

fn accept_next(listener: NetListener) -> Result<NetStream, String> effects [net]
	match net::accept_or_end(listener)
		Some(stream) => Ok(stream)
		None => Err("missing production stream")
	end
end

fn listener_ended(listener: NetListener) -> Bool effects [net]
	match net::accept_or_end(listener)
		Some(_) => false
		None => true
	end
end

fn bool_text(value: Bool) -> String
	if value
		"true"
	else
		"false"
	end
end

pub fn main() -> Result<(), String> effects [net, concurrency, stdio]
	let listener = net::listen("127.0.0.1:0")
	let stream = accept_next(listener)?
	let summary = accepted_lifecycle(stream, { stream: "production-stream", lane: "ingress" })?
	let clean_end = listener_ended(listener)
	stdio::print("events ")
	stdio::print(int_to_string(summary.routed_events))
	stdio::print(" chunks ")
	stdio::print(int_to_string(summary.next_state.chunks))
	stdio::print(" bytes ")
	stdio::print(int_to_string(summary.total_bytes))
	stdio::print(" first-seq ")
	stdio::print(int_to_string(summary.first_sequence))
	stdio::print(" last-seq ")
	stdio::print(int_to_string(summary.last_sequence))
	stdio::print(" trace ")
	stdio::print(summary.trace_id)
	stdio::print(" route ")
	stdio::print(summary.route_stream)
	stdio::print("/")
	stdio::print(summary.route_lane)
	stdio::print(" writes ")
	stdio::print(int_to_string(write_count(summary.actions)))
	stdio::print(" failures ")
	stdio::print(int_to_string(failure_count(summary.actions)))
	stdio::print(" reason ")
	stdio::print(summary.failure_reason)
	stdio::print(" clean-end ")
	stdio::println(bool_text(clean_end))
	Ok(())
end
