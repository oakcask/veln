# Binary schema selected mappings can type-check mixed dispatch payload cases independently.
use stdio

type Settings
	Settings {code: Int, value: Int}
end

type PacketPayload
	InlineValue(Int)
	SettingsValue({code: Int, value: Int})
end

type Packet
	Packet {kind: Int, body: PacketPayload}
end

schema SettingsPayload
	format binary

	code: UInt8
	value: UInt16be

	map to Settings
		code = code
		value = value
end

schema PacketWire
	format binary

	kind: UInt8
	payload: Dispatch(kind, 1 => UInt8, 2 => SettingsPayload)

	map to Packet when kind == 1
		kind = kind
		body = InlineValue(payload)

	map to Packet when kind == 2
		kind = kind
		body = SettingsValue(payload)
end

fn emit(label: String, packet: {kind: Int, body: PacketPayload}) -> () effects [stdio]
	stdio::print(label)
	stdio::print(" ")
	stdio::print(int_to_string(packet.kind))
	stdio::print(" ")
	match packet.body
		InlineValue(value) => stdio::println(int_to_string(value))
		SettingsValue(settings) => stdio::println(int_to_string(settings.value))
	end
end

fn decode_packet(hex: String, count: Int) -> Result<{kind: Int, body: PacketPayload}, String>
	let bytes: ByteChunk = byte_chunk_from_hex(hex)?
	let view: ByteView = byte_view(bytes, byte_offset(0)?, byte_count(count)?)?
	byte_decode_packet_wire(view)
end

pub fn main() -> Result<(), String> effects [stdio]
	emit("inline", decode_packet("0107", 2)?)
	emit("settings", decode_packet("020900ff", 4)?)
	Ok(())
end
