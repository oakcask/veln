# Visible sub-byte fields whose widths complete two bytes share that big-endian unit.
use stdio

schema PackedVisibleTwoByteHeader
	format binary

	high: UInt4
	middle: UInt5
	low: UInt3
	tail: UInt4
end

codec PackedVisibleTwoByteDecodeCodec for PackedVisibleTwoByteHeader decode
	derive decode
end

codec PackedVisibleTwoByteEncodeCodec for PackedVisibleTwoByteHeader encode
	derive encode
end

fn step_kind(step: DecodeStep<{high: Int, middle: Int, low: Int, tail: Int}>) -> String
	match step
		Decoded(_, _) => "decoded"
		NeedMore(_) => "need_more"
		Invalid(_) => "invalid"
	end
end

fn decoded_high(step: DecodeStep<{high: Int, middle: Int, low: Int, tail: Int}>) -> Int
	match step
		Decoded(value, _) => value.high
		NeedMore(_) => -1
		Invalid(_) => -1
	end
end

fn decoded_middle(step: DecodeStep<{high: Int, middle: Int, low: Int, tail: Int}>) -> Int
	match step
		Decoded(value, _) => value.middle
		NeedMore(_) => -1
		Invalid(_) => -1
	end
end

fn decoded_low(step: DecodeStep<{high: Int, middle: Int, low: Int, tail: Int}>) -> Int
	match step
		Decoded(value, _) => value.low
		NeedMore(_) => -1
		Invalid(_) => -1
	end
end

fn decoded_tail(step: DecodeStep<{high: Int, middle: Int, low: Int, tail: Int}>) -> Int
	match step
		Decoded(value, _) => value.tail
		NeedMore(_) => -1
		Invalid(_) => -1
	end
end

fn consumed_count(step: DecodeStep<{high: Int, middle: Int, low: Int, tail: Int}>) -> Int
	match step
		Decoded(_, consumed) => byte_count_to_int(consumed)
		NeedMore(_) => 0
		Invalid(_) => 0
	end
end

fn encode_step_kind(step: EncodeStep<()>) -> String
	match step
		Encoded(_) => "encoded"
		Partial(_, _, _) => "partial"
		Invalid(_) => "invalid"
	end
end

fn emit_output_chunk(name: String, index: Int, chunk: ByteChunk, expected_hex: String) -> () effects [stdio]
	stdio::print("output_chunk ")
	stdio::print(name)
	stdio::print(" index ")
	stdio::print(int_to_string(index))
	stdio::print(" hex \"")
	stdio::print(expected_hex)
	stdio::print("\" count ")
	stdio::println(int_to_string(byte_count_to_int(byte_chunk_count(chunk))))
end

fn emit_encoded_chunk(name: String, chunk: ByteChunk, expected_hex: String) -> () effects [stdio]
	stdio::print("output_chunk_list ")
	stdio::print(name)
	stdio::println(" count 1")
	emit_output_chunk(name, 0, chunk, expected_hex)
end

fn emit_direct_encoded(encoded: Result<ByteChunk, EncodeError>) -> () effects [stdio]
	match encoded
		Ok(chunk) => emit_encoded_chunk("packed-visible-two-byte-direct", chunk, "abcd")
		Err(_) => stdio::println("unexpected direct encode failure")
	end
end

fn emit_derived_encoded(step: EncodeStep<()>) -> () effects [stdio]
	match step
		Encoded(Cons(chunk, Nil)) => emit_encoded_chunk("packed-visible-two-byte-derived", chunk, "abcd")
		Encoded(_) => stdio::println("unexpected derived chunk count")
		Partial(_, _, _) => stdio::println("unexpected partial encode")
		Invalid(_) => stdio::println("unexpected derived encode failure")
	end
end

pub fn main() -> Result<(), String> effects [stdio]
	let bytes: ByteChunk = byte_chunk_from_hex("abcd")?
	let view: ByteView = byte_view(bytes, byte_offset(0)?, byte_count(2)?)?
	let decoded: {high: Int, middle: Int, low: Int, tail: Int} = byte_decode_packed_visible_two_byte_header(view)?
	stdio::println(int_to_string(decoded.high))
	stdio::println(int_to_string(decoded.middle))
	stdio::println(int_to_string(decoded.low))
	stdio::println(int_to_string(decoded.tail))

	let stepped: DecodeStep<{high: Int, middle: Int, low: Int, tail: Int}> = byte_decode_step_packed_visible_two_byte_header(view, byte_offset(24)?)
	stdio::println(step_kind(stepped))
	stdio::println(int_to_string(decoded_high(stepped)))
	stdio::println(int_to_string(decoded_middle(stepped)))
	stdio::println(int_to_string(decoded_low(stepped)))
	stdio::println(int_to_string(decoded_tail(stepped)))
	stdio::println(int_to_string(consumed_count(stepped)))

	let codec_step: DecodeStep<{high: Int, middle: Int, low: Int, tail: Int}> = PackedVisibleTwoByteDecodeCodec(view, byte_offset(24)?)
	stdio::println(step_kind(codec_step))
	stdio::println(int_to_string(decoded_high(codec_step)))
	stdio::println(int_to_string(decoded_middle(codec_step)))
	stdio::println(int_to_string(decoded_low(codec_step)))
	stdio::println(int_to_string(decoded_tail(codec_step)))
	stdio::println(int_to_string(consumed_count(codec_step)))

	let direct_encoded: Result<ByteChunk, EncodeError> = byte_encode_packed_visible_two_byte_header({high: 10, middle: 23, low: 4, tail: 13})
	emit_direct_encoded(direct_encoded)

	let derived_encoded: EncodeStep<()> = PackedVisibleTwoByteEncodeCodec({high: 10, middle: 23, low: 4, tail: 13})
	stdio::println(encode_step_kind(derived_encoded))
	emit_derived_encoded(derived_encoded)
	Ok(())
end
