use local_values as config
use alpha_wrapper
use beta_wrapper

type State
	Idle
	Active(count: Int)
end

let snapshot: { state: State, text: String, flag: Bool } = { state: Active(forward), text: "ready", flag: true }
let forward: Int = -3
let nothing: () = ()
let idle: State = Idle

fn print_state(state: State) -> () effects [stdio]
	match state
		Idle => stdio::println("idle")
		Active(count) => stdio::println(int_to_string(count))
	end
end

pub fn main() -> () effects [stdio]
	nothing
	stdio::println(snapshot.text)
	print_state(snapshot.state)
	print_state(idle)
	if snapshot.flag
		stdio::println("true")
	else
		stdio::println("false")
	end
	stdio::println(int_to_string(config::selected))
	stdio::println(int_to_string(alpha_wrapper::selected()))
	stdio::println(int_to_string(beta_wrapper::selected()))
	stdio::println(int_to_string(beta_wrapper::selected()))
	stdio::println(int_to_string(alpha_wrapper::selected()))
end
