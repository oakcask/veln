# Binary schema Flag8 fields decode as source-visible bitset values.
use stdio

schema FlagPacket
	format binary

	flags: Flag8
end

fn flag_bits(flags: Flag8) -> Int
	match flags
		Flag8(bits) => bits
	end
end

pub fn main() -> Result<(), String> effects [stdio]
	let bytes: ByteChunk = byte_chunk_from_hex("28")?
	let offset: ByteOffset = byte_offset(0)?
	let count: ByteCount = byte_count(1)?
	let view: ByteView = byte_view(bytes, offset, count)?
	let packet: {flags: Flag8} = byte_decode_flag_packet(view)?
	stdio::println(int_to_string(flag_bits(packet.flags)))
	Ok(())
end
