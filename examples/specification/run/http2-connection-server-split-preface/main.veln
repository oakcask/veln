use fixture_effects
use fake_effects
use http2::connection from "std"
use http2::core from "std"
use net from "std"
use transport::net from "std"
use stdio

fn open_listener() -> Result<net::Listener, String> effects [net::IO]
	match net::listen(net::Address(net::Tcp4, "127.0.0.1", 0))
		Ok(listener) => Ok(listener)
		Err(_) => Err("missing listener")
	end
end

fn accept_next(listener: net::Listener) -> Result<net::Stream, String> effects [net::IO]
	match net::accept(listener)
		Ok(stream) => Ok(stream)
		Err(_) => Err("missing stream")
	end
end

fn run_server(stream: net::Stream, state: CoreConnectionState) -> Result<CoreConnectionState, Http2ConnectionFailure> effects [net::IO]
	handle http2::connection::drive_server(state) with transport::net::net_stream(stream)
end

fn print_result(label: String, result: Result<CoreConnectionState, Http2ConnectionFailure>) -> Result<(), String> effects [stdio]
	match result
		Ok(state) => print_success(label, state)
		Err(failure) => print_failure(label, failure)
	end
end

fn print_success(label: String, state: CoreConnectionState) -> Result<(), String> effects [stdio]
	stdio::print(label)
	stdio::print(" offset ")
	stdio::println(int_to_string(http2::core::connection_state_next_offset(state)))
	Ok(())
end

fn print_failure(label: String, failure: Http2ConnectionFailure) -> Result<(), String> effects [stdio]
	stdio::print(label)
	stdio::print(" failure ")
	stdio::println(http2::connection::connection_failure_id(failure))
	Ok(())
end

fn run_one(listener: net::Listener, label: String) -> Result<(), String> effects [net::IO, stdio]
	let stream = accept_next(listener)?
	let state = http2::core::server_connection_state(0)?
	let _ = print_result(label, run_server(stream, state))?
	let _ = net::close_stream(stream)
	Ok(())
end

fn fixture_body() -> Result<(), String> effects [net::IO, stdio]
	let listener = open_listener()?
	let _ = run_one(listener, "split")?
	let _ = run_one(listener, "complete")?
	Ok(())
end

pub fn main() -> Result<(), String> effects [concurrency, fs, net, time, stdio]
	let state = fixture_effects::create_fixture()
	handle handle handle fixture_body() with net::system() with fake_effects::network(state) with fake_effects::clock(state)
end
