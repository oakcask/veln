# Nested dispatch payload decode accepts ByteView(length) helper schemas.
use stdio

schema SizedPayload
	format binary

	length: UInt8
	data: ByteView(length)
end

schema ClosedByteViewPayloadPacket
	format binary

	kind: UInt8
	payload: Dispatch(kind, 1 => SizedPayload)
end

schema ExtensionByteViewPayloadPacket
	format binary

	length: UInt8
	kind: UInt8
	payload: ExtensionDispatch(kind, length, 1 => SizedPayload)
end

fn emit_payload(prefix: String, payload: {length: Int, data: ByteView}) -> Result<(), String> effects [stdio]
	stdio::print(prefix)
	stdio::print(" ")
	stdio::print(int_to_string(payload.length))
	stdio::print(" ")
	stdio::println(byte_chunk_to_visible_ascii_string(byte_view_to_chunk(payload.data))?)
	Ok(())
end

fn emit_extension_payload(payload: SchemaDispatchPayload<{length: Int, data: ByteView}>) -> Result<(), String> effects [stdio]
	match payload
		Known(value) => emit_payload("extension", value)
		Unknown(tag, raw) => emit_unknown(tag, raw)
	end
end

fn emit_unknown(tag: Int, raw: ByteView) -> Result<(), String> effects [stdio]
	stdio::print("unknown ")
	stdio::print(int_to_string(tag))
	stdio::print(" ")
	stdio::println(int_to_string(byte_count_to_int(byte_chunk_count(byte_view_to_chunk(raw)))))
	Ok(())
end

pub fn main() -> Result<(), String> effects [stdio]
	let closed_bytes: ByteChunk = byte_chunk_from_hex("0103616263")?
	let closed_view: ByteView = byte_view(closed_bytes, byte_offset(0)?, byte_count(5)?)?
	let closed: {kind: Int, payload: {length: Int, data: ByteView}} = byte_decode_closed_byte_view_payload_packet(closed_view)?
	emit_payload("closed", closed.payload)

	let extension_bytes: ByteChunk = byte_chunk_from_hex("040103616263")?
	let extension_view: ByteView = byte_view(extension_bytes, byte_offset(0)?, byte_count(6)?)?
	let extension: {length: Int, kind: Int, payload: SchemaDispatchPayload<{length: Int, data: ByteView}>} = byte_decode_extension_byte_view_payload_packet(extension_view)?
	emit_extension_payload(extension.payload)

	let unknown_bytes: ByteChunk = byte_chunk_from_hex("0309010203")?
	let unknown_view: ByteView = byte_view(unknown_bytes, byte_offset(0)?, byte_count(5)?)?
	let unknown: {length: Int, kind: Int, payload: SchemaDispatchPayload<{length: Int, data: ByteView}>} = byte_decode_extension_byte_view_payload_packet(unknown_view)?
	emit_extension_payload(unknown.payload)
	Ok(())
end
