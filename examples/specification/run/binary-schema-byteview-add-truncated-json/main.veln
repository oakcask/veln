# Binary schema ByteView addition rejects payloads beyond available bytes.
schema PacketWire
	format binary

	header_length: UInt8
	body_length: UInt8
	payload: ByteView(header_length + body_length)
end

pub fn main() -> Result<(), String>
	let bytes: ByteChunk = byte_chunk_from_hex("0203aabb")?
	let view: ByteView = byte_view(bytes, byte_offset(0)?, byte_count(4)?)?
	let ignored: {header_length: Int, body_length: Int, payload: ByteView} = byte_decode_packet_wire(view)?
	Ok(())
end
