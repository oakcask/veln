schema PackedVisibleByteHeader
	format binary

	high: UInt3
	middle: UInt2
	low: UInt3
end

pub fn main() -> Result<(), String>
	let bytes: ByteChunk = byte_chunk_from_hex("")?
	let view: ByteView = byte_view(bytes, byte_offset(0)?, byte_count(0)?)?
	let ignored: {high: Int, middle: Int, low: Int} = byte_decode_packed_visible_byte_header(view)?
	Ok(())
end
