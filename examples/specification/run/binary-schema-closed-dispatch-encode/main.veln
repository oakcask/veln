use stdio

schema ClosedDispatchWritePacket
	format binary

	kind: UInt8
	payload: Dispatch(kind, 1 => UInt8, 2 => UInt16be, 3 => UInt24be, 4 => UInt32be, 5 => UInt24le, 6 => UInt32le)
end

fn emit_output_chunk(name: String, index: Int, chunk: ByteChunk, expected_hex: String) -> () effects [stdio]
	stdio::print("output_chunk ")
	stdio::print(name)
	stdio::print(" index ")
	stdio::print(int_to_string(index))
	stdio::print(" hex \"")
	stdio::print(expected_hex)
	stdio::print("\" count ")
	stdio::println(int_to_string(byte_count_to_int(byte_chunk_count(chunk))))
end

fn emit_output_chunk_list_header(name: String, count: Int) -> () effects [stdio]
	stdio::print("output_chunk_list ")
	stdio::print(name)
	stdio::print(" count ")
	stdio::println(int_to_string(count))
end

fn emit_encoded_chunk(name: String, bytes: ByteChunk, expected_hex: String) -> () effects [stdio]
	emit_output_chunk_list_header(name, 1)
	emit_output_chunk(name, 0, bytes, expected_hex)
end

fn emit_encoded(name: String, encoded: Result<ByteChunk, EncodeError>, expected_hex: String) -> () effects [stdio]
	match encoded
		Ok(bytes) => emit_encoded_chunk(name, bytes, expected_hex)
		Err(_) => stdio::println("unexpected encode failure")
	end
end

pub fn main() -> () effects [stdio]
	let one: Result<ByteChunk, EncodeError> = byte_encode_closed_dispatch_write_packet({kind: 1, payload: 7})
	emit_encoded("dispatch-u8", one, "0107")

	let two: Result<ByteChunk, EncodeError> = byte_encode_closed_dispatch_write_packet({kind: 2, payload: 4660})
	emit_encoded("dispatch-u16", two, "021234")

	let three: Result<ByteChunk, EncodeError> = byte_encode_closed_dispatch_write_packet({kind: 3, payload: 11259375})
	emit_encoded("dispatch-u24", three, "03abcdef")

	let four: Result<ByteChunk, EncodeError> = byte_encode_closed_dispatch_write_packet({kind: 4, payload: 3735928559})
	emit_encoded("dispatch-u32", four, "04deadbeef")

	let five: Result<ByteChunk, EncodeError> = byte_encode_closed_dispatch_write_packet({kind: 5, payload: 1193046})
	emit_encoded("dispatch-u24le", five, "05563412")

	let six: Result<ByteChunk, EncodeError> = byte_encode_closed_dispatch_write_packet({kind: 6, payload: 3735928559})
	emit_encoded("dispatch-u32le", six, "06efbeadde")
end
