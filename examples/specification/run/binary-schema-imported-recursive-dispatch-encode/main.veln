use stdio
use wire

type ClosedPayload
	ClosedLeaf(Int)
	ClosedBranch({length: Int, kind: Int, payload: ClosedPayload})
end

type ClosedNode
	ClosedNode {length: Int, kind: Int, payload: ClosedPayload}
end

schema ImportedRecursiveClosedPacket
	format binary

	length: UInt8
	kind: UInt8
	payload: Dispatch(kind, length, 0 => UInt8, 1 => wire::RecursiveClosedPayload)

	map to ClosedNode when kind == 0
		length = length
		kind = kind
		payload = ClosedPayload::ClosedLeaf(payload)

	map to ClosedNode when kind == 1
		length = length
		kind = kind
		payload = ClosedPayload::ClosedBranch(payload)
end

type ExtensionPayload
	ExtensionLeaf(Int)
	ExtensionBranch({length: Int, kind: Int, payload: SchemaDispatchPayload<ExtensionPayload>})
end

type ExtensionNode
	ExtensionNode {length: Int, kind: Int, payload: SchemaDispatchPayload<ExtensionPayload>}
end

schema ImportedRecursiveExtensionPacket
	format binary

	length: UInt8
	kind: UInt8
	payload: ExtensionDispatch(kind, length, 0 => UInt8, 1 => wire::RecursiveExtensionPayload)

	map to ExtensionNode when kind == 0
		length = length
		kind = kind
		payload = Known(ExtensionPayload::ExtensionLeaf(payload))

	map to ExtensionNode when kind == 1
		length = length
		kind = kind
		payload = Known(ExtensionPayload::ExtensionBranch(payload))
end

fn emit_output_chunk(name: String, index: Int, chunk: ByteChunk, expected_hex: String) -> () effects [stdio]
	stdio::print("output_chunk ")
	stdio::print(name)
	stdio::print(" index ")
	stdio::print(int_to_string(index))
	stdio::print(" hex \"")
	stdio::print(expected_hex)
	stdio::print("\" count ")
	stdio::println(int_to_string(byte_count_to_int(byte_chunk_count(chunk))))
end

fn emit_output_chunk_list_header(name: String, count: Int) -> () effects [stdio]
	stdio::print("output_chunk_list ")
	stdio::print(name)
	stdio::print(" count ")
	stdio::println(int_to_string(count))
end

fn emit_encoded_chunk(name: String, bytes: ByteChunk, expected_hex: String) -> () effects [stdio]
	emit_output_chunk_list_header(name, 1)
	emit_output_chunk(name, 0, bytes, expected_hex)
end

fn emit_encoded(name: String, encoded: Result<ByteChunk, EncodeError>, expected_hex: String) -> () effects [stdio]
	match encoded
		Ok(bytes) => emit_encoded_chunk(name, bytes, expected_hex)
		Err(_) => stdio::println("unexpected encode failure")
	end
end

pub fn main() -> Result<(), String> effects [stdio]
	let closed: Result<ByteChunk, EncodeError> = byte_encode_imported_recursive_closed_packet({length: 3, kind: 1, payload: ClosedPayload::ClosedBranch({length: 1, kind: 0, payload: ClosedPayload::ClosedLeaf(42)})})
	emit_encoded("imported-recursive-closed-dispatch", closed, "030101002a")

	let extension: Result<ByteChunk, EncodeError> = byte_encode_imported_recursive_extension_packet({length: 3, kind: 1, payload: Known(ExtensionPayload::ExtensionBranch({length: 1, kind: 0, payload: Known(ExtensionPayload::ExtensionLeaf(42))}))})
	emit_encoded("imported-recursive-extension-dispatch", extension, "030101002a")

	let raw: ByteChunk = byte_chunk_from_hex("aabb")?
	let view: ByteView = byte_view(raw, byte_offset(0)?, byte_count(2)?)?
	let unknown: Result<ByteChunk, EncodeError> = byte_encode_imported_recursive_extension_packet({length: 2, kind: 7, payload: Unknown(7, view)})
	emit_encoded("imported-recursive-extension-unknown", unknown, "0207aabb")
	Ok(())
end
