# Flag16le helper functions inspect raw bits, inspect decoded flags, and construct flags for encode.
use stdio

schema FlagPacket
	format binary

	flags: Flag16le
end

fn high_bit() -> Int
	15
end

fn low_bit() -> Int
	0
end

fn middle_bit() -> Int
	7
end

fn emit_output_chunk(name: String, index: Int, chunk: ByteChunk, expected_hex: String) -> () effects [stdio]
	stdio::print("output_chunk ")
	stdio::print(name)
	stdio::print(" index ")
	stdio::print(int_to_string(index))
	stdio::print(" hex \"")
	stdio::print(expected_hex)
	stdio::print("\" count ")
	stdio::println(int_to_string(byte_count_to_int(byte_chunk_count(chunk))))
end

fn emit_output_chunk_list_header(name: String, count: Int) -> () effects [stdio]
	stdio::print("output_chunk_list ")
	stdio::print(name)
	stdio::print(" count ")
	stdio::println(int_to_string(count))
end

fn emit_encoded(bytes: ByteChunk) -> () effects [stdio]
	emit_output_chunk_list_header("flag16le-packet", 1)
	emit_output_chunk("flag16le-packet", 0, bytes, "0180")
end

fn emit_encoded_result(bytes: ByteChunk) -> Result<(), String> effects [stdio]
	emit_encoded(bytes)
	Ok(())
end

fn bool_to_int(value: Bool) -> Int
	match value
		true => 1
		false => 0
	end
end

pub fn main() -> Result<(), String> effects [stdio]
	let bytes: ByteChunk = byte_chunk_from_hex("0180")?
	let view: ByteView = byte_view(bytes, byte_offset(0)?, byte_count(2)?)?
	let packet: {flags: Flag16le} = byte_decode_flag_packet(view)?
	let high_set: Bool = flag16le_is_set(packet.flags, high_bit())?
	let low_set: Bool = flag16le_is_set(packet.flags, low_bit())?
	let middle_set: Bool = flag16le_is_set(packet.flags, middle_bit())?
	stdio::println(int_to_string(flag16le_bits(packet.flags)))
	stdio::println(int_to_string(bool_to_int(high_set)))
	stdio::println(int_to_string(bool_to_int(low_set)))
	stdio::println(int_to_string(bool_to_int(middle_set)))
	let empty: Flag16le = flag16le_from_bits(0)?
	let high: Flag16le = flag16le_set(empty, high_bit())?
	let encoded_flags: Flag16le = flag16le_set(high, low_bit())?
	let encoded: Result<ByteChunk, EncodeError> = byte_encode_flag_packet({flags: encoded_flags})
	match encoded
		Ok(encoded_bytes) => emit_encoded_result(encoded_bytes)
		Err(_) => Err("unexpected encode failure")
	end
end
