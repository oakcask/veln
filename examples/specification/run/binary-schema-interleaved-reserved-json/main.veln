schema InterleavedReservedHeader
	format binary

	lead: UInt1
	guard: ReservedBits(2, 1)
	mode: UInt2
	tail: UInt3
end

pub fn main() -> Result<{lead: Int, mode: Int, tail: Int}, String>
	let bytes: ByteChunk = byte_chunk_from_hex("ec")?
	let view: ByteView = byte_view(bytes, byte_offset(0)?, byte_count(1)?)?
	byte_decode_interleaved_reserved_header(view)
end
