# Derived binary schema encode accepts ByteView subtraction lengths.
use stdio

schema PacketWire
	format binary

	length: UInt8
	padding_length: UInt8
	payload: ByteView(length - padding_length)
end


fn emit_output_chunk(name: String, index: Int, chunk: ByteChunk, expected_hex: String) -> () effects [stdio]
	stdio::print("output_chunk ")
	stdio::print(name)
	stdio::print(" index ")
	stdio::print(int_to_string(index))
	stdio::print(" hex \"")
	stdio::print(expected_hex)
	stdio::print("\" count ")
	stdio::println(int_to_string(byte_count_to_int(byte_chunk_count(chunk))))
end

fn emit_encoded_chunk(name: String, chunk: ByteChunk, expected_hex: String) -> () effects [stdio]
	stdio::print("output_chunk_list ")
	stdio::print(name)
	stdio::println(" count 1")
	emit_output_chunk(name, 0, chunk, expected_hex)
end

fn emit_step(step: EncodeStep<()>) -> () effects [stdio]
	match step
		Encoded(Cons(chunk, Nil)) => emit_encoded_chunk("byteview-subtract-packet", chunk, "0502aabbcc")
		Encoded(_) => stdio::println("unexpected chunk count")
		Partial(_, _, _) => stdio::println("unexpected partial encode")
		Invalid(_) => stdio::println("unexpected encode failure")
	end
end

fn encode_result_step(encoded: Result<ByteChunk, EncodeError>) -> EncodeStep<()>
	match encoded
		Ok(chunk) => Encoded(list_cons(chunk, list_nil()))
		Err(error) => Invalid(error)
	end
end

pub fn main() -> Result<(), String> effects [stdio]
	let payload_bytes: ByteChunk = byte_chunk_from_hex("aabbcc")?
	let payload: ByteView = byte_view(payload_bytes, byte_offset(0)?, byte_count(3)?)?
	let encoded: EncodeStep<()> = encode_result_step(encode PacketWire from {length: 5, padding_length: 2, payload: payload})
	emit_step(encoded)
	Ok(())
end
