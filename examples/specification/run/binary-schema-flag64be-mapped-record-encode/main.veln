use stdio

type FlagPacket
	FlagPacket {target_flags: Flag64be}
end

schema FlagPacketWire
	format binary

	flags: Flag64be

	map to FlagPacket
		target_flags = flags
end

fn emit_output_chunk(name: String, index: Int, chunk: ByteChunk, expected_hex: String) -> () effects [stdio]
	stdio::print("output_chunk ")
	stdio::print(name)
	stdio::print(" index ")
	stdio::print(int_to_string(index))
	stdio::print(" hex \"")
	stdio::print(expected_hex)
	stdio::print("\" count ")
	stdio::println(int_to_string(byte_count_to_int(byte_chunk_count(chunk))))
end

fn emit_encoded(bytes: ByteChunk) -> () effects [stdio]
	stdio::println("output_chunk_list mapped-flag-packet count 1")
	emit_output_chunk("mapped-flag-packet", 0, bytes, "0102030405060708")
end

pub fn main() -> () effects [stdio]
	let encoded: Result<ByteChunk, EncodeError> = byte_encode_flag_packet_wire({target_flags: Flag64be(72623859790382856)})
	match encoded
		Ok(bytes) => emit_encoded(bytes)
		Err(_) => stdio::println("unexpected encode failure")
	end
end
