use http2::diagnostic from "std"
# HTTP/2 flow-control helper returns a RuntimeDiagnostic payload.
fn invalid_payload(error: String) -> RuntimeDiagnostic
	RuntimeDiagnostic(
		"http2.peer_limit.flow_control_window_exceeded",
		error,
		RuntimeHttp2PeerLimitFlowControlWindowDiagnostic(0, 4, 3, 0, 1, "open-stream", "stream_receive_window", byte_chunk([]))
	)
end

fn preview_bytes() -> Result<ByteChunk, RuntimeDiagnostic>
	match byte_chunk_from_hex("01020304")
		Ok(bytes) => Ok(bytes)
		Err(error) => Err(invalid_payload(error))
	end
end

fn preview_view(bytes: ByteChunk) -> Result<ByteView, RuntimeDiagnostic>
	let count: ByteCount = byte_chunk_count(bytes)
	match byte_offset(0)
		Ok(offset) => match byte_view(bytes, offset, count)
			Ok(view) => Ok(view)
			Err(error) => Err(invalid_payload(error))
		end
		Err(error) => Err(invalid_payload(error))
	end
end

pub fn main() -> Result<(), RuntimeDiagnostic>
	let payload: ByteChunk = preview_bytes()?
	let preview: ByteView = preview_view(payload)?
	http2::diagnostic::peer_limit_flow_control_window_exceeded(0, 4, 3, 0, 1, "open-stream", "stream_receive_window", preview)
end
