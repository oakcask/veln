# HTTP/2 closed input while a header block is pending renders related context.
fn fallback_payload(error: String) -> RuntimeDiagnostic
	RuntimeDiagnostic(
		"http2.protocol.closed_with_pending",
		error,
		RuntimeHttp2ProtocolClosedWithPendingDiagnostic(12, 0, "headers", 1, 1, 0, 3, "rfc9113_continuation_sequence", byte_chunk([]))
	)
end

fn preview_view() -> Result<ByteView, RuntimeDiagnostic>
	match byte_chunk_from_hex("")
		Ok(bytes) => match byte_offset(0)
			Ok(offset) => match byte_view(bytes, offset, byte_chunk_count(bytes))
				Ok(view) => Ok(view)
				Err(error) => Err(fallback_payload(error))
			end
			Err(error) => Err(fallback_payload(error))
		end
		Err(error) => Err(fallback_payload(error))
	end
end

pub fn main() -> Result<(), RuntimeDiagnostic>
	let preview: ByteView = preview_view()?
	http2_protocol_closed_with_pending(12, 0, "headers", 1, 1, 0, 3, "rfc9113_continuation_sequence", preview)
end
