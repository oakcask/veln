effect Ask
	value() -> Int
end

fn provide(ctx: Int) -> Int
	ctx
end

handler ask(ctx: Int) handles Ask
	value() => provide(ctx)
end

fn nested() -> Int effects [Ask]
	let inner = handle perform Ask::value() with ask(5)
	let outer = perform Ask::value()
	inner + outer
end

pub fn main() -> () effects [stdio]
	stdio::println(int_to_string(handle nested() with ask(12)))
end
