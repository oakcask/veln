use stdio

type Payload
	Payload(Int)
end

type Envelope
	Envelope(Payload)
end

type Header
	Header {wrapped: Envelope}
end

schema HeaderWire
	format binary

	kind: UInt8

	map to Header
		wrapped = Envelope(Payload(kind))
end

fn emit_output_chunk(name: String, index: Int, chunk: ByteChunk, expected_hex: String) -> () effects [stdio]
	stdio::print("output_chunk ")
	stdio::print(name)
	stdio::print(" index ")
	stdio::print(int_to_string(index))
	stdio::print(" hex \"")
	stdio::print(expected_hex)
	stdio::print("\" count ")
	stdio::println(int_to_string(byte_count_to_int(byte_chunk_count(chunk))))
end

fn emit_encoded(bytes: ByteChunk) -> () effects [stdio]
	stdio::println("output_chunk_list nested-constructor-header count 1")
	emit_output_chunk("nested-constructor-header", 0, bytes, "05")
end

pub fn main() -> () effects [stdio]
	let encoded: Result<ByteChunk, EncodeError> = byte_encode_header_wire({wrapped: Envelope(Payload(5))})
	match encoded
		Ok(bytes) => emit_encoded(bytes)
		Err(_) => stdio::println("unexpected encode failure")
	end
end
