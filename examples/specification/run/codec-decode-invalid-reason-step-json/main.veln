# Source-visible DecodeStep Invalid entries preserve reason details in JSON.

pub fn main() -> DecodeStep<Int>
	match byte_offset(5)
		Ok(offset) => Invalid(DecodeErrorWithReason("codec.invalid_input", offset, "ManualPacketWire.kind", "kind value exceeds declared length"))
		Err(_) => NeedMore(NeedEnd)
	end
end
