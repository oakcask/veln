# Flag24 helpers inspect raw bits, inspect decoded flags, and construct flags for encode.
use stdio

schema FlagPacket
	format binary

	flags_be: Flag24be
	flags_le: Flag24le
end

fn high_bit() -> Int
	23
end

fn low_bit() -> Int
	0
end

fn middle_bit() -> Int
	11
end

fn emit_output_chunk(name: String, index: Int, chunk: ByteChunk, expected_hex: String) -> () effects [stdio]
	stdio::print("output_chunk ")
	stdio::print(name)
	stdio::print(" index ")
	stdio::print(int_to_string(index))
	stdio::print(" hex \"")
	stdio::print(expected_hex)
	stdio::print("\" count ")
	stdio::println(int_to_string(byte_count_to_int(byte_chunk_count(chunk))))
end

fn bool_to_int(value: Bool) -> Int
	match value
		true => 1
		false => 0
	end
end

fn emit_checks(prefix: String, bits: Int, high_set: Bool, low_set: Bool, middle_set: Bool) -> () effects [stdio]
	stdio::print(prefix)
	stdio::print(" ")
	stdio::println(int_to_string(bits))
	stdio::println(int_to_string(bool_to_int(high_set)))
	stdio::println(int_to_string(bool_to_int(low_set)))
	stdio::println(int_to_string(bool_to_int(middle_set)))
end

fn emit_encoded(bytes: ByteChunk) -> Result<(), String> effects [stdio]
	stdio::println("output_chunk_list flag24-packet count 1")
	emit_output_chunk("flag24-packet", 0, bytes, "800001010080")
	Ok(())
end

pub fn main() -> Result<(), String> effects [stdio]
	let bytes: ByteChunk = byte_chunk_from_hex("800001010080")?
	let view: ByteView = byte_view(bytes, byte_offset(0)?, byte_count(6)?)?
	let packet: {flags_be: Flag24be, flags_le: Flag24le} = byte_decode_flag_packet(view)?
	emit_checks("be", flag24be_bits(packet.flags_be), flag24be_is_set(packet.flags_be, high_bit())?, flag24be_is_set(packet.flags_be, low_bit())?, flag24be_is_set(packet.flags_be, middle_bit())?)
	emit_checks("le", flag24le_bits(packet.flags_le), flag24le_is_set(packet.flags_le, high_bit())?, flag24le_is_set(packet.flags_le, low_bit())?, flag24le_is_set(packet.flags_le, middle_bit())?)
	let empty_be: Flag24be = flag24be_from_bits(0)?
	let high_be: Flag24be = flag24be_set(empty_be, high_bit())?
	let encoded_be: Flag24be = flag24be_set(high_be, low_bit())?
	let empty_le: Flag24le = flag24le_from_bits(0)?
	let high_le: Flag24le = flag24le_set(empty_le, high_bit())?
	let encoded_le: Flag24le = flag24le_set(high_le, low_bit())?
	let encoded: Result<ByteChunk, EncodeError> = byte_encode_flag_packet({flags_be: encoded_be, flags_le: encoded_le})
	match encoded
		Ok(encoded_bytes) => emit_encoded(encoded_bytes)
		Err(_) => Err("unexpected encode failure")
	end
end
