# Deadline-aware socket read host failures stay runtime transport failures.
pub fn main() -> Result<(), String> effects [net, time]
	let listener: NetListener = net::listen("127.0.0.1:0")
	let stream: NetStream = net::accept(listener)
	let deadline: Deadline = time::deadline_after_ms(100)
	let chunk: Option<ByteChunk> = net::read_chunk_until(stream, deadline)
	Ok(())
end
