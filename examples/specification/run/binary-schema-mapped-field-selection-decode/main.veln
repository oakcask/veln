# Binary schema mapping can select a field from a decoded nested record.
use stdio

type Settings
	Settings {code: Int, value: Int}
end

type Packet
	Packet {kind: Int, code: Int}
end

schema SettingsPayload
	format binary

	wire_code: UInt8
	wire_value: UInt16be

	map to Settings
		code = wire_code
		value = wire_value
end

schema PacketWire
	format binary

	kind: UInt8
	payload: Dispatch(kind, 1 => SettingsPayload)

	map to Packet
		kind = kind
		code = payload.code
end

pub fn main() -> Result<(), String> effects [stdio]
	let bytes: ByteChunk = byte_chunk_from_hex("010700ff")?
	let view: ByteView = byte_view(bytes, byte_offset(0)?, byte_count(4)?)?
	let packet: {kind: Int, code: Int} = byte_decode_packet_wire(view)?
	stdio::print(int_to_string(packet.kind))
	stdio::print(" ")
	stdio::println(int_to_string(packet.code))
	Ok(())
end
