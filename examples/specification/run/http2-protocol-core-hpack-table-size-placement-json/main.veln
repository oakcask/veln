# HTTP/2 HPACK table-size update placement projects structured runtime details.

fn main() -> Result<(), String>
	let preview: ByteView = byte_view(byte_chunk_from_hex("823e")?, byte_offset(0)?, byte_count(2)?)?
	hpack_fixture_table_size_update_not_at_start(10, 2, 62, 30, 1, 1, "hpack-fixture", "fixture HPACK table-size update at header block start", "hpack_fixture", preview)
end
