# Cancellation token status is observable without waiting or cancelling.
use stdio

fn status_text(cancelled: Bool) -> String
	if cancelled
		"cancelled"
	else
		"active"
	end
end

pub fn main() -> Result<(), String> effects [time, stdio]
	let token = time::cancel_token()
	stdio::println(status_text(time::is_cancelled(token)))
	time::cancel(token)
	stdio::println(status_text(time::is_cancelled(token)))
	Ok(())
end
