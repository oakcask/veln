use stdio

schema FourBytePrefixReservedGroupHeader
	format binary

	prefix: ReservedBits(25, 22369621)
	high: UInt4
	low: UInt3
end

fn encoded_value(chunk: ByteChunk) -> Result<Int, String>
	let view: ByteView = byte_view(chunk, byte_offset(0)?, byte_count(4)?)?
	byte_read_u32_be(view)
end

fn emit_encoded_chunk(chunk: ByteChunk) -> Result<(), String> effects [stdio]
	stdio::println(int_to_string(encoded_value(chunk)?))
	Ok(())
end

fn emit_unexpected_encode_failure() -> Result<(), String> effects [stdio]
	stdio::println("unexpected encode failure")
	Ok(())
end

fn emit_encoded(encoded: Result<ByteChunk, EncodeError>) -> Result<(), String> effects [stdio]
	match encoded
		Ok(chunk) => emit_encoded_chunk(chunk)
		Err(_) => emit_unexpected_encode_failure()
	end
end

pub fn main() -> Result<(), String> effects [stdio]
	let bytes: ByteChunk = byte_chunk_from_hex("aaaaaad5")?
	let view: ByteView = byte_view(bytes, byte_offset(0)?, byte_count(4)?)?
	let decoded: {high: Int, low: Int} = byte_decode_four_byte_prefix_reserved_group_header(view)?
	stdio::println(int_to_string(decoded.high))
	stdio::println(int_to_string(decoded.low))

	let encoded: Result<ByteChunk, EncodeError> = byte_encode_four_byte_prefix_reserved_group_header({high: 10, low: 5})
	emit_encoded(encoded)
end
