fn located(value: Int) -> {value: Int, location: SourceLocation} callsite
	{value: value, location: callsite}
end

fn forward(value: Int) -> {value: Int, location: SourceLocation}
	let stored: fn(Int) -> {value: Int, location: SourceLocation} = located
	stored(value)
end

pub fn main() -> () effects [stdio]
	let observed = forward(37)
	stdio::println(observed.location.file)
	stdio::println(int_to_string(observed.value))
	stdio::println(int_to_string(observed.location.start_line))
	stdio::println(int_to_string(observed.location.start_column))
end
