use stdio

schema SplitReservedHeader
	format binary

	top: ReservedBits(1, 1)
	high: UInt2
	gap: ReservedBits(2, 2)
	low: UInt3
end

codec SplitReservedCodec for SplitReservedHeader decode encode
	derive decode
	derive encode
end

fn step_kind(step: DecodeStep<{high: Int, low: Int}>) -> String
	match step
		Decoded(_, _) => "decoded"
		NeedMore(_) => "need_more"
		Invalid(_) => "invalid"
	end
end

fn decoded_high(step: DecodeStep<{high: Int, low: Int}>) -> Int
	match step
		Decoded(header, _) => header.high
		NeedMore(_) => -1
		Invalid(_) => -1
	end
end

fn decoded_low(step: DecodeStep<{high: Int, low: Int}>) -> Int
	match step
		Decoded(header, _) => header.low
		NeedMore(_) => -1
		Invalid(_) => -1
	end
end

fn consumed_count(step: DecodeStep<{high: Int, low: Int}>) -> Int
	match step
		Decoded(_, consumed) => byte_count_to_int(consumed)
		NeedMore(_) => 0
		Invalid(_) => 0
	end
end

fn error_id(step: DecodeStep<{high: Int, low: Int}>) -> String
	match step
		Decoded(_, _) => "none"
		NeedMore(_) => "none"
		Invalid(DecodeError(id, _, _)) => id
		Invalid(DecodeErrorWithReason(id, _, _, _)) => id
	end
end

fn error_offset(step: DecodeStep<{high: Int, low: Int}>) -> Int
	match step
		Decoded(_, _) => -1
		NeedMore(_) => -1
		Invalid(DecodeError(_, offset, _)) => byte_offset_to_int(offset)
		Invalid(DecodeErrorWithReason(_, offset, _, _)) => byte_offset_to_int(offset)
	end
end

fn error_path(step: DecodeStep<{high: Int, low: Int}>) -> String
	match step
		Decoded(_, _) => "none"
		NeedMore(_) => "none"
		Invalid(DecodeError(_, _, path)) => path
		Invalid(DecodeErrorWithReason(_, _, path, _)) => path
	end
end

fn encode_kind(step: EncodeStep<()>) -> String
	match step
		Encoded(_) => "encoded"
		Partial(_, _, _) => "partial"
		Invalid(_) => "invalid"
	end
end

pub fn main() -> Result<(), String> effects [stdio]
	let bytes: ByteChunk = byte_chunk_from_hex("d5")?
	let view: ByteView = byte_view(bytes, byte_offset(0)?, byte_count(1)?)?
	let decoded: DecodeStep<{high: Int, low: Int}> = SplitReservedCodec(view, byte_offset(7)?)
	stdio::println(step_kind(decoded))
	stdio::println(int_to_string(decoded_high(decoded)))
	stdio::println(int_to_string(decoded_low(decoded)))
	stdio::println(int_to_string(consumed_count(decoded)))

	let invalid_bytes: ByteChunk = byte_chunk_from_hex("e5")?
	let invalid_view: ByteView = byte_view(invalid_bytes, byte_offset(0)?, byte_count(1)?)?
	let invalid: DecodeStep<{high: Int, low: Int}> = SplitReservedCodec(invalid_view, byte_offset(11)?)
	stdio::println(step_kind(invalid))
	stdio::println(int_to_string(consumed_count(invalid)))
	stdio::println(error_id(invalid))
	stdio::println(int_to_string(error_offset(invalid)))
	stdio::println(error_path(invalid))

	let encoded: EncodeStep<()> = SplitReservedCodec({high: 2, low: 5})
	stdio::println(encode_kind(encoded))
	Ok(())
end
