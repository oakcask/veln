# HTTP/2 SETTINGS peer-limit failures project to human runtime diagnostics.

type Http2ProtocolFailure
	SettingsValueOutOfRange {offset: Int, setting_identifier: Int, setting_name: String, observed_value: Int, accepted_min_value: Int, accepted_max_value: Int, peer_limit_provenance: String, preview: ByteView}
end

fn project(failure: Http2ProtocolFailure) -> Result<(), String>
	match failure
		SettingsValueOutOfRange(offset, setting_identifier, setting_name, observed_value, accepted_min_value, accepted_max_value, peer_limit_provenance, preview) => http2_peer_limit_settings_value_out_of_range(offset, setting_identifier, setting_name, observed_value, accepted_min_value, accepted_max_value, peer_limit_provenance, preview)
	end
end

pub fn main() -> Result<(), String>
	let item: ByteChunk = byte_chunk_from_hex("000200000002")?
	let preview: ByteView = byte_view(item, byte_offset(0)?, byte_count(6)?)?
	project(SettingsValueOutOfRange(9, 2, "SETTINGS_ENABLE_PUSH", 2, 0, 1, "peer_settings", preview))
end
