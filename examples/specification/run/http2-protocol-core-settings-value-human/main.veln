use http2::core from "std"
use http2::diagnostic from "std"
# A later invalid duplicate HTTP/2 SETTINGS item projects at its own offset.

fn invalid_payload(error: String) -> RuntimeDiagnostic
	RuntimeDiagnostic(
		"http2.peer_limit.settings_value_out_of_range",
		error,
		RuntimeHttp2Diagnostic(RuntimeHttp2PeerLimitSettingsValueDiagnostic(15, 2, "SETTINGS_ENABLE_PUSH", 2, 0, 1, "peer_settings", byte_chunk([])))
	)
end

fn project(validation: PeerSettingsValidation) -> Result<(), RuntimeDiagnostic>
	match http2::core::peer_settings_validation_status(validation)
		"rejected" => project_failure(validation)
		_ => Err(invalid_payload("invalid peer SETTINGS value was accepted"))
	end
end

fn project_failure(validation: PeerSettingsValidation) -> Result<(), RuntimeDiagnostic>
	let failure: PeerSettingsFailure = match http2::core::peer_settings_validation_failure(validation)
		Ok(value) => value
		Err(error) => Err(invalid_payload(error))?
	end
	http2::diagnostic::peer_limit_settings_value_out_of_range(http2::core::peer_settings_failure_offset(failure), http2::core::peer_settings_failure_setting_identifier(failure), http2::core::peer_settings_failure_setting_name(failure), http2::core::peer_settings_failure_observed_value(failure), http2::core::peer_settings_failure_accepted_min_value(failure), http2::core::peer_settings_failure_accepted_max_value(failure), http2::core::peer_settings_failure_peer_limit_provenance(failure), http2::core::peer_settings_failure_preview(failure))
end

pub fn main() -> Result<(), RuntimeDiagnostic>
	match byte_chunk_from_hex("000200000002")
		Ok(payload) => match http2::core::validate_peer_settings_payload(15, "server", payload)
			Ok(validation) => project(validation)
			Err(error) => Err(invalid_payload(error))
		end
		Err(error) => Err(invalid_payload(error))
	end
end
