# A later invalid duplicate HTTP/2 SETTINGS item projects at its own offset.

type Http2ProtocolFailure
	SettingsValueOutOfRange {offset: Int, setting_identifier: Int, setting_name: String, observed_value: Int, accepted_min_value: Int, accepted_max_value: Int, peer_limit_provenance: String, preview: ByteView}
end

fn settings_value_payload(offset: Int, setting_identifier: Int, setting_name: String, observed_value: Int, accepted_min_value: Int, accepted_max_value: Int, peer_limit_provenance: String, preview: ByteView) -> RuntimeDiagnostic
	RuntimeDiagnostic(
		"http2.peer_limit.settings_value_out_of_range",
		"HTTP/2 SETTINGS value outside accepted range at byte offset 15",
		RuntimeHttp2Diagnostic(RuntimeHttp2PeerLimitSettingsValueDiagnostic(offset, setting_identifier, setting_name, observed_value, accepted_min_value, accepted_max_value, peer_limit_provenance, byte_view_to_chunk(preview)))
	)
end

fn invalid_payload(error: String) -> RuntimeDiagnostic
	RuntimeDiagnostic(
		"http2.peer_limit.settings_value_out_of_range",
		error,
		RuntimeHttp2Diagnostic(RuntimeHttp2PeerLimitSettingsValueDiagnostic(15, 2, "SETTINGS_ENABLE_PUSH", 2, 0, 1, "peer_settings", byte_chunk([])))
	)
end

fn project(failure: Http2ProtocolFailure) -> Result<(), RuntimeDiagnostic>
	match failure
		SettingsValueOutOfRange(offset, setting_identifier, setting_name, observed_value, accepted_min_value, accepted_max_value, peer_limit_provenance, preview) => Err(settings_value_payload(offset, setting_identifier, setting_name, observed_value, accepted_min_value, accepted_max_value, peer_limit_provenance, preview))
	end
end

fn preview_bytes() -> Result<ByteChunk, RuntimeDiagnostic>
	match byte_chunk_from_hex("000200000002")
		Ok(bytes) => Ok(bytes)
		Err(error) => Err(invalid_payload(error))
	end
end

fn preview_view(bytes: ByteChunk) -> Result<ByteView, RuntimeDiagnostic>
	match byte_offset(0)
		Ok(offset) => match byte_count(6)
			Ok(count) => match byte_view(bytes, offset, count)
				Ok(view) => Ok(view)
				Err(error) => Err(invalid_payload(error))
			end
			Err(error) => Err(invalid_payload(error))
		end
		Err(error) => Err(invalid_payload(error))
	end
end

pub fn main() -> Result<(), RuntimeDiagnostic>
	let item: ByteChunk = preview_bytes()?
	let preview: ByteView = preview_view(item)?
	project(SettingsValueOutOfRange(15, 2, "SETTINGS_ENABLE_PUSH", 2, 0, 1, "peer_settings", preview))
end
