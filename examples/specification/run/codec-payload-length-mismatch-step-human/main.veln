# DecodeStep Invalid payload length mismatch failures render focused human diagnostics.

pub fn main() -> DecodeStep<Int>
	match byte_offset(21)
		Ok(offset) => Invalid(DecodeErrorWithReason("codec.payload_length_mismatch", offset, "ManualPacketWire.payload", "expected_payload_length=8; actual_payload_length=5; reason=payload length did not match frame header"))
		Err(_) => NeedMore(NeedEnd)
	end
end
