use http2::diagnostic from "std"
fn fallback_payload(error: String) -> RuntimeDiagnostic
	RuntimeDiagnostic("hpack.static.unsupported_index", error, RuntimeHttp2HpackDiagnostic(RuntimeHpackFixtureDiagnostic(15, 0, -1, "HPACK static indexed header", "hpack_static", byte_chunk([]))))
end

fn fixture_bytes(text: String) -> Result<ByteChunk, RuntimeDiagnostic>
	match byte_chunk_from_hex(text)
		Ok(bytes) => Ok(bytes)
		Err(error) => Err(fallback_payload(error))
	end
end

type Http2ProtocolFailure
	HpackFixtureDecodeFailed(offset: Int, observed_size: Int, observed_first_byte: Int, expected_fixture: String, codec_module: String, preview: ByteChunk)
end

fn http2_protocol_diagnostic(failure: Http2ProtocolFailure) -> Result<(), RuntimeDiagnostic>
	match failure
		HpackFixtureDecodeFailed(offset, observed_size, observed_first_byte, expected_fixture, codec_module, preview) => if expected_fixture == "HPACK static indexed header" and codec_module == "hpack_static"
			Err(RuntimeDiagnostic("hpack.static.unsupported_index", "HPACK static index is not supported", RuntimeHttp2HpackDiagnostic(RuntimeHpackFixtureDiagnostic(offset, observed_size, observed_first_byte, expected_fixture, codec_module, preview))))
		else
			Err(fallback_payload("expected source-visible HPACK static indexed header failure"))
		end
	end
end

pub fn main() -> Result<(), RuntimeDiagnostic>
	let block: ByteChunk = fixture_bytes("80")?
	http2_protocol_diagnostic(HpackFixtureDecodeFailed(15, 1, 128, "HPACK static indexed header", "hpack_static", block))
end
