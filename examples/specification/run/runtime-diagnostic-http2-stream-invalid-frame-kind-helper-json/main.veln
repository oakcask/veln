# HTTP/2 stream invalid frame-kind helper returns a RuntimeDiagnostic payload.
fn invalid_payload(error: String) -> RuntimeDiagnostic
	RuntimeDiagnostic(
		"http2.protocol.invalid_frame_kind",
		error,
		RuntimeHttp2ProtocolInvalidFrameKindDiagnostic(0, 0, 1, 1, "idle-stream", "idle_streams_require_headers", byte_chunk([]))
	)
end

fn preview_bytes() -> Result<ByteChunk, RuntimeDiagnostic>
	match byte_chunk_from_hex("000000000000000001")
		Ok(bytes) => Ok(bytes)
		Err(error) => Err(invalid_payload(error))
	end
end

fn preview_view(bytes: ByteChunk) -> Result<ByteView, RuntimeDiagnostic>
	match byte_offset(0)
		Ok(offset) => match byte_count(9)
			Ok(count) => match byte_view(bytes, offset, count)
				Ok(view) => Ok(view)
				Err(error) => Err(invalid_payload(error))
			end
			Err(error) => Err(invalid_payload(error))
		end
		Err(error) => Err(invalid_payload(error))
	end
end

pub fn main() -> Result<(), RuntimeDiagnostic>
	let header: ByteChunk = preview_bytes()?
	let preview: ByteView = preview_view(header)?
	http2_protocol_invalid_frame_kind(0, 0, 1, 1, "idle-stream", "idle_streams_require_headers", preview)
end
