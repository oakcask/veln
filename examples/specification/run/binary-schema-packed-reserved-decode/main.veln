# Binary schema packed reserved bits decode without exposing reserved fields.
use stdio

schema PackedWidthOneHeader
	format binary

	prefix: UInt8
	control_reserved: ReservedBits(1, 1)
	control: UInt7
	suffix: UInt8
end

schema PackedWidthTwoHeader
	format binary

	prefix: UInt8
	control_reserved: ReservedBits(2, 2)
	control: UInt6
	suffix: UInt8
end

schema PackedWidthThreeHeader
	format binary

	prefix: UInt8
	control_reserved: ReservedBits(3, 5)
	control: UInt5
	suffix: UInt8
end

schema PackedWidthFourHeader
	format binary

	prefix: UInt8
	control_reserved: ReservedBits(4, 9)
	control: UInt4
	suffix: UInt8
end

schema PackedWidthFiveHeader
	format binary

	prefix: UInt8
	control_reserved: ReservedBits(5, 17)
	control: UInt3
	suffix: UInt8
end

schema PackedWidthSixHeader
	format binary

	prefix: UInt8
	control_reserved: ReservedBits(6, 21)
	control: UInt2
	suffix: UInt8
end

schema PackedWidthSevenHeader
	format binary

	prefix: UInt8
	control_reserved: ReservedBits(7, 85)
	control: UInt1
	suffix: UInt8
end

schema PackedWidthNineHeader
	format binary

	prefix: UInt8
	control_reserved: ReservedBits(9, 341)
	control: UInt7
	suffix: UInt8
end

schema PackedWidthTenHeader
	format binary

	prefix: UInt8
	control_reserved: ReservedBits(10, 677)
	control: UInt6
	suffix: UInt8
end

schema PackedWidthElevenHeader
	format binary

	prefix: UInt8
	control_reserved: ReservedBits(11, 1365)
	control: UInt5
	suffix: UInt8
end

schema PackedWidthTwelveHeader
	format binary

	prefix: UInt8
	control_reserved: ReservedBits(12, 2650)
	control: UInt4
	suffix: UInt8
end

schema PackedWidthThirteenHeader
	format binary

	prefix: UInt8
	control_reserved: ReservedBits(13, 5457)
	control: UInt3
	suffix: UInt8
end

schema PackedWidthFourteenHeader
	format binary

	prefix: UInt8
	control_reserved: ReservedBits(14, 10901)
	control: UInt2
	suffix: UInt8
end

schema PackedWidthFifteenHeader
	format binary

	prefix: UInt8
	control_reserved: ReservedBits(15, 21845)
	control: UInt1
	suffix: UInt8
end

fn emit_header(name: String, header: {prefix: Int, control: Int, suffix: Int}) -> () effects [stdio]
	stdio::print(name)
	stdio::print(" ")
	stdio::print(int_to_string(header.prefix))
	stdio::print(" ")
	stdio::print(int_to_string(header.control))
	stdio::print(" ")
	stdio::println(int_to_string(header.suffix))
end

pub fn main() -> Result<(), String> effects [stdio]
	let one_bytes: ByteChunk = byte_chunk_from_hex("12aa34")?
	let one_offset: ByteOffset = byte_offset(0)?
	let one_count: ByteCount = byte_count(3)?
	let one_view: ByteView = byte_view(one_bytes, one_offset, one_count)?
	let one: {prefix: Int, control: Int, suffix: Int} = byte_decode_packed_width_one_header(one_view)?
	emit_header("width-1", one)

	let two_bytes: ByteChunk = byte_chunk_from_hex("129134")?
	let two_offset: ByteOffset = byte_offset(0)?
	let two_count: ByteCount = byte_count(3)?
	let two_view: ByteView = byte_view(two_bytes, two_offset, two_count)?
	let two: {prefix: Int, control: Int, suffix: Int} = byte_decode_packed_width_two_header(two_view)?
	emit_header("width-2", two)

