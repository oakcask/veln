use contracts

pub fn main() -> () effects [stdio]
	let observed = contracts::guarded()
	let invariant_observed = contracts::invariant_guarded()
	let ensured_observed = contracts::ensured()
	stdio::println(observed.package)
	stdio::println(observed.module)
	stdio::println(observed.file)
	stdio::println(int_to_string(observed.start_line))
	stdio::println(int_to_string(observed.start_column))
	stdio::println(int_to_string(observed.start_offset))
	stdio::println(int_to_string(observed.end_line))
	stdio::println(int_to_string(observed.end_column))
	stdio::println(int_to_string(observed.end_offset))
	stdio::println(invariant_observed.package)
	stdio::println(invariant_observed.module)
	stdio::println(invariant_observed.file)
	stdio::println(int_to_string(invariant_observed.start_line))
	stdio::println(int_to_string(invariant_observed.start_column))
	stdio::println(int_to_string(invariant_observed.start_offset))
	stdio::println(int_to_string(invariant_observed.end_line))
	stdio::println(int_to_string(invariant_observed.end_column))
	stdio::println(int_to_string(invariant_observed.end_offset))
	stdio::println(ensured_observed.package)
	stdio::println(ensured_observed.module)
	stdio::println(ensured_observed.file)
	stdio::println(int_to_string(ensured_observed.start_line))
	stdio::println(int_to_string(ensured_observed.start_column))
	stdio::println(int_to_string(ensured_observed.start_offset))
	stdio::println(int_to_string(ensured_observed.end_line))
	stdio::println(int_to_string(ensured_observed.end_column))
	stdio::println(int_to_string(ensured_observed.end_offset))
end
