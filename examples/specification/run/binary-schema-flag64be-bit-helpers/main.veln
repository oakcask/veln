# Flag64be helper functions inspect raw bits, inspect decoded flags, and construct flags for encode.
use stdio

schema FlagPacket
	format binary

	flags: Flag64be
end

fn high_bit() -> Int
	63
end

fn representable_high_bit() -> Int
	62
end

fn low_bit() -> Int
	0
end

fn middle_bit() -> Int
	31
end

fn emit_output_chunk(name: String, index: Int, chunk: ByteChunk, expected_hex: String) -> () effects [stdio]
	stdio::print("output_chunk ")
	stdio::print(name)
	stdio::print(" index ")
	stdio::print(int_to_string(index))
	stdio::print(" hex \"")
	stdio::print(expected_hex)
	stdio::print("\" count ")
	stdio::println(int_to_string(byte_count_to_int(byte_chunk_count(chunk))))
end

fn emit_output_chunk_list_header(name: String, count: Int) -> () effects [stdio]
	stdio::print("output_chunk_list ")
	stdio::print(name)
	stdio::print(" count ")
	stdio::println(int_to_string(count))
end

fn emit_encoded(bytes: ByteChunk) -> () effects [stdio]
	emit_output_chunk_list_header("flag64be-packet", 1)
	emit_output_chunk("flag64be-packet", 0, bytes, "4000000000000001")
end

fn emit_encoded_result(bytes: ByteChunk) -> Result<(), String> effects [stdio]
	emit_encoded(bytes)
	Ok(())
end

fn bool_to_int(value: Bool) -> Int
	match value
		true => 1
		false => 0
	end
end

pub fn main() -> Result<(), String> effects [stdio]
	let bytes: ByteChunk = byte_chunk_from_hex("4000000000000001")?
	let view: ByteView = byte_view(bytes, byte_offset(0)?, byte_count(8)?)?
	let packet: {flags: Flag64be} = byte_decode_flag_packet(view)?
	let high_set: Bool = flag64be_is_set(packet.flags, high_bit())?
	let representable_high_set: Bool = flag64be_is_set(packet.flags, representable_high_bit())?
	let low_set: Bool = flag64be_is_set(packet.flags, low_bit())?
	let middle_set: Bool = flag64be_is_set(packet.flags, middle_bit())?
	stdio::println(int_to_string(flag64be_bits(packet.flags)))
	stdio::println(int_to_string(bool_to_int(high_set)))
	stdio::println(int_to_string(bool_to_int(representable_high_set)))
	stdio::println(int_to_string(bool_to_int(low_set)))
	stdio::println(int_to_string(bool_to_int(middle_set)))
	let empty: Flag64be = flag64be_from_bits(0)?
	let high: Flag64be = flag64be_set(empty, representable_high_bit())?
	let encoded_flags: Flag64be = flag64be_set(high, low_bit())?
	let encoded: Result<ByteChunk, EncodeError> = byte_encode_flag_packet({flags: encoded_flags})
	match encoded
		Ok(encoded_bytes) => emit_encoded_result(encoded_bytes)
		Err(_) => Err("unexpected encode failure")
	end
end
