# Derived codec decode boundaries call generated helpers with five-argument mapping converters.
use stdio

type Header
	Header {summary: Int, length: Int}
end

fn summarize(input: {value: Int}, extra: Int, bonus: Int, final: Int, doubled: Int) -> Int
	input.value + extra + bonus + final + doubled
end

schema HeaderWire
	format binary

	wire_length: UInt16be
	wire_kind: UInt8 where wire_kind <= wire_length

	map to Header
		length = wire_length
		summary = summarize({value: wire_kind}, wire_length - 1, wire_kind + 1, wire_length + wire_kind, wire_length * 2)
end

codec HeaderCodec for HeaderWire decode
	derive decode
end

fn step_kind(step: DecodeStep<{summary: Int, length: Int}>) -> String
	match step
		Decoded(_, _) => "decoded"
		NeedMore(_) => "need_more"
		Invalid(_) => "invalid"
	end
end

fn decoded_summary(step: DecodeStep<{summary: Int, length: Int}>) -> Int
	match step
		Decoded(header, _) => header.summary
		NeedMore(_) => -1
		Invalid(_) => -1
	end
end

fn decoded_length(step: DecodeStep<{summary: Int, length: Int}>) -> Int
	match step
		Decoded(header, _) => header.length
		NeedMore(_) => -1
		Invalid(_) => -1
	end
end

fn consumed_count(step: DecodeStep<{summary: Int, length: Int}>) -> Int
	match step
		Decoded(_, consumed) => byte_count_to_int(consumed)
		NeedMore(_) => 0
		Invalid(_) => 0
	end
end

fn readiness_kind(step: DecodeStep<{summary: Int, length: Int}>) -> String
	match step
		Decoded(_, _) => "none"
		NeedMore(NeedBytes(_)) => "need_bytes"
		NeedMore(NeedEnd) => "need_end"
		Invalid(_) => "none"
	end
end

fn readiness_count(step: DecodeStep<{summary: Int, length: Int}>) -> Int
	match step
		Decoded(_, _) => 0
		NeedMore(NeedBytes(count)) => byte_count_to_int(count)
		NeedMore(NeedEnd) => 0
		Invalid(_) => 0
	end
end

fn error_id(step: DecodeStep<{summary: Int, length: Int}>) -> String
	match step
		Decoded(_, _) => "none"
		NeedMore(_) => "none"
		Invalid(DecodeError(id, _, _)) => id
		Invalid(DecodeErrorWithReason(id, _, _, _)) => id
	end
end

fn error_offset(step: DecodeStep<{summary: Int, length: Int}>) -> Int
	match step
		Decoded(_, _) => -1
		NeedMore(_) => -1
		Invalid(DecodeError(_, offset, _)) => byte_offset_to_int(offset)
		Invalid(DecodeErrorWithReason(_, offset, _, _)) => byte_offset_to_int(offset)
	end
end

fn error_path(step: DecodeStep<{summary: Int, length: Int}>) -> String
	match step
		Decoded(_, _) => "none"
		NeedMore(_) => "none"
		Invalid(DecodeError(_, _, path)) => path
		Invalid(DecodeErrorWithReason(_, _, path, _)) => path
	end
end

pub fn main() -> Result<(), String> effects [stdio]
	let full_bytes: ByteChunk = byte_chunk_from_hex("123405")?
	let full_view: ByteView = byte_view(full_bytes, byte_offset(0)?, byte_count(3)?)?
	let decoded: DecodeStep<{summary: Int, length: Int}> = HeaderCodec(full_view, byte_offset(21)?)
	stdio::println(step_kind(decoded))
	stdio::println(int_to_string(decoded_summary(decoded)))
	stdio::println(int_to_string(decoded_length(decoded)))
	stdio::println(int_to_string(consumed_count(decoded)))

	let short_bytes: ByteChunk = byte_chunk_from_hex("1234")?
	let short_view: ByteView = byte_view(short_bytes, byte_offset(0)?, byte_count(2)?)?
	let waiting: DecodeStep<{summary: Int, length: Int}> = HeaderCodec(short_view, byte_offset(31)?)
	stdio::println(step_kind(waiting))
	stdio::println(readiness_kind(waiting))
	stdio::println(int_to_string(readiness_count(waiting)))
	stdio::println(int_to_string(consumed_count(waiting)))

	let invalid_bytes: ByteChunk = byte_chunk_from_hex("000105")?
	let invalid_view: ByteView = byte_view(invalid_bytes, byte_offset(0)?, byte_count(3)?)?
	let invalid: DecodeStep<{summary: Int, length: Int}> = HeaderCodec(invalid_view, byte_offset(41)?)
	stdio::println(step_kind(invalid))
	stdio::println(int_to_string(consumed_count(invalid)))
	stdio::println(error_id(invalid))
	stdio::println(int_to_string(error_offset(invalid)))
	stdio::println(error_path(invalid))
	Ok(())
end
