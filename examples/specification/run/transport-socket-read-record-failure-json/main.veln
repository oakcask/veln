use net from "std"
use fixture_effects
use fake_effects

# Consumed production input remains committed when read event recording fails.
fn fixture_body() -> Result<(), net::NetError> effects [net::IO]
	let listener: net::Listener = net::listen(net::Address(net::Tcp4, "127.0.0.1", 0))?
	let stream: net::Stream = net::accept(listener)?
	match net::read(stream)?
		net::ReadOutcome::Chunk(chunk) => match net::write_all(stream, chunk, None, None)
			net::WriteAllOutcome::Complete(_) => Ok(())
			net::WriteAllOutcome::Failed(_, error) => Err(error)
			net::WriteAllOutcome::InvalidReply(_, error) => Err(error)
		end
		net::ReadOutcome::End => Ok(())
	end
end

pub fn main() -> Result<(), net::NetError> effects [concurrency, fs, net, time]
	let state = fixture_effects::create_fixture()
	handle fixture_body() with
		fake_effects::clock(state),
		fake_effects::network(state),
		net::system()
	end
end
