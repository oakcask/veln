# Cleanup failures replace a successful body in reverse execution order.
pub fn main() -> () effects [stdio]
	defer
		stdio::println("remaining cleanup")
		let invalid_count = 65
		let ignored = 1 << invalid_count
		()
	end
	defer
		stdio::println("failing cleanup")
		let invalid_count = 64
		let ignored = 1 << invalid_count
		()
	end
	stdio::println("body")
end
