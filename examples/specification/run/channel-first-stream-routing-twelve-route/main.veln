# Channel-first stream routing can select twelve receiver-list routes before handling.
use stdio

type ResponseAction
	SendBytes {stream_id: Int, bytes: ByteChunk}
	EndStream {stream_id: Int}
	Decline {stream_id: Int}
end

fn handle_stream_input(stream_id: Int, input: StreamInput, state: { chunks : Int, ended : Bool }) -> { actions : List<ResponseAction>, next_state : { chunks : Int, ended : Bool } }
	match input
		Chunk(bytes) => { actions: list_cons(SendBytes(stream_id, bytes), list_nil()), next_state: { chunks: state.chunks + 1, ended: state.ended } }
		End => { actions: list_cons(EndStream(stream_id), list_nil()), next_state: { chunks: state.chunks, ended: true } }
	end
end

fn append_actions(left: List<ResponseAction>, right: List<ResponseAction>) -> List<ResponseAction>
	match left
		Nil => right
		Cons(action, tail) => list_cons(action, append_actions(tail, right))
	end
end

fn action_stream_score(actions: List<ResponseAction>) -> Int
	match actions
		Nil => 0
		Cons(action, tail) => match action
			SendBytes(stream_id, _) => stream_id * 10 + action_stream_score(tail)
			EndStream(stream_id) => stream_id * 10 + action_stream_score(tail)
			Decline(stream_id) => stream_id * 10 + action_stream_score(tail)
		end
	end
end

fn payload_byte_count(actions: List<ResponseAction>) -> Int
	match actions
		Nil => 0
		Cons(action, tail) => match action
			SendBytes(_, bytes) => byte_count_to_int(byte_chunk_count(bytes)) + payload_byte_count(tail)
			EndStream(_) => payload_byte_count(tail)
			Decline(_) => payload_byte_count(tail)
		end
	end
end

fn write_count(actions: List<ResponseAction>) -> Int
	match actions
		Nil => 0
		Cons(action, tail) => match action
			SendBytes(_, _) => 1 + write_count(tail)
			EndStream(_) => write_count(tail)
			Decline(_) => write_count(tail)
		end
	end
end

fn bool_text(value: Bool) -> String
	match value
		true => "true"
		false => "false"
	end
end

fn handled_route(index: Int, input: StreamInput, state: { chunks : Int, ended : Bool }) -> { actions : List<ResponseAction>, next_state : { chunks : Int, ended : Bool } }
	match index
		0 => handle_stream_input(1, input, state)
		1 => handle_stream_input(3, input, state)
		2 => handle_stream_input(5, input, state)
		3 => handle_stream_input(7, input, state)
		4 => handle_stream_input(9, input, state)
		5 => handle_stream_input(11, input, state)
		6 => handle_stream_input(13, input, state)
		7 => handle_stream_input(15, input, state)
		8 => handle_stream_input(17, input, state)
		9 => handle_stream_input(19, input, state)
		10 => handle_stream_input(21, input, state)
		_ => handle_stream_input(23, input, state)
	end
end

fn select_ready(receivers: List<Receiver<StreamInput>>) -> { index : Int, value : StreamInput } effects [concurrency]
	match channel::select_many_priority(receivers)
		Some(selected) => selected
		None => { index: 0, value: End }
	end
end

pub fn main() -> Result<(), String> effects [concurrency, stdio]
	let second_bytes: ByteChunk = byte_chunk_from_hex("0102")?
	let fourth_bytes: ByteChunk = byte_chunk_from_hex("0a0b")?
	let sixth_bytes: ByteChunk = byte_chunk_from_hex("f0f1")?
	let seventh_bytes: ByteChunk = byte_chunk_from_hex("cafe")?
	let eighth_bytes: ByteChunk = byte_chunk_from_hex("0c0d0e")?
	let ninth_bytes: ByteChunk = byte_chunk_from_hex("10203040")?
	let tenth_bytes: ByteChunk = byte_chunk_from_hex("1122334455")?
	let eleventh_bytes: ByteChunk = byte_chunk_from_hex("667788")?
	let twelfth_bytes: ByteChunk = byte_chunk_from_hex("99aabbcc")?
	let first = channel::bounded<StreamInput>(2)
	let second = channel::bounded<StreamInput>(2)
	let third = channel::bounded<StreamInput>(2)
	let fourth = channel::bounded<StreamInput>(2)
	let fifth = channel::bounded<StreamInput>(2)
	let sixth = channel::bounded<StreamInput>(2)
	let seventh = channel::bounded<StreamInput>(2)
	let eighth = channel::bounded<StreamInput>(2)
	let ninth = channel::bounded<StreamInput>(2)
	let tenth = channel::bounded<StreamInput>(2)
	let eleventh = channel::bounded<StreamInput>(2)
	let twelfth = channel::bounded<StreamInput>(2)
	let _ = channel::send(first.tx, End)
	let _ = channel::send(second.tx, Chunk(second_bytes))
	let _ = channel::send(third.tx, End)
	let _ = channel::send(fourth.tx, Chunk(fourth_bytes))
	let _ = channel::send(fifth.tx, End)
	let _ = channel::send(sixth.tx, Chunk(sixth_bytes))
	let _ = channel::send(seventh.tx, Chunk(seventh_bytes))
	let _ = channel::send(eighth.tx, Chunk(eighth_bytes))
	let _ = channel::send(ninth.tx, Chunk(ninth_bytes))
	let _ = channel::send(tenth.tx, Chunk(tenth_bytes))
	let _ = channel::send(eleventh.tx, Chunk(eleventh_bytes))
	let _ = channel::send(twelfth.tx, Chunk(twelfth_bytes))
	channel::close(first.tx)
	channel::close(second.tx)
	channel::close(third.tx)
	channel::close(fourth.tx)
	channel::close(fifth.tx)
	channel::close(sixth.tx)
	channel::close(seventh.tx)
	channel::close(eighth.tx)
	channel::close(ninth.tx)
	channel::close(tenth.tx)
	channel::close(eleventh.tx)
	channel::close(twelfth.tx)
	let receivers: List<Receiver<StreamInput>> = list_cons(first.rx, list_cons(second.rx, list_cons(third.rx, list_cons(fourth.rx, list_cons(fifth.rx, list_cons(sixth.rx, list_cons(seventh.rx, list_cons(eighth.rx, list_cons(ninth.rx, list_cons(tenth.rx, list_cons(eleventh.rx, list_cons(twelfth.rx, list_nil()))))))))))))
	let selected_first = select_ready(receivers)
	let handled_first = handled_route(selected_first.index, selected_first.value, { chunks: 0, ended: false })
	let selected_second = select_ready(receivers)
	let handled_second = handled_route(selected_second.index, selected_second.value, { chunks: 0, ended: false })
	let selected_third = select_ready(receivers)
	let handled_third = handled_route(selected_third.index, selected_third.value, { chunks: 0, ended: false })
	let selected_fourth = select_ready(receivers)
	let handled_fourth = handled_route(selected_fourth.index, selected_fourth.value, { chunks: 0, ended: false })
	let selected_fifth = select_ready(receivers)
	let handled_fifth = handled_route(selected_fifth.index, selected_fifth.value, { chunks: 0, ended: false })
	let selected_sixth = select_ready(receivers)
	let handled_sixth = handled_route(selected_sixth.index, selected_sixth.value, { chunks: 0, ended: false })
	let selected_seventh = select_ready(receivers)
	let handled_seventh = handled_route(selected_seventh.index, selected_seventh.value, { chunks: 0, ended: false })
	let selected_eighth = select_ready(receivers)
	let handled_eighth = handled_route(selected_eighth.index, selected_eighth.value, { chunks: 0, ended: false })
	let selected_ninth = select_ready(receivers)
	let handled_ninth = handled_route(selected_ninth.index, selected_ninth.value, { chunks: 0, ended: false })
	let selected_tenth = select_ready(receivers)
	let handled_tenth = handled_route(selected_tenth.index, selected_tenth.value, { chunks: 0, ended: false })
	let selected_eleventh = select_ready(receivers)
	let handled_eleventh = handled_route(selected_eleventh.index, selected_eleventh.value, { chunks: 0, ended: false })
	let selected_twelfth = select_ready(receivers)
	let handled_twelfth = handled_route(selected_twelfth.index, selected_twelfth.value, { chunks: 0, ended: false })
	let first_actions = append_actions(handled_first.actions, handled_second.actions)
	let second_actions = append_actions(handled_third.actions, handled_fourth.actions)
	let third_actions = append_actions(handled_fifth.actions, handled_sixth.actions)
	let fourth_actions = append_actions(handled_seventh.actions, handled_eighth.actions)
	let fifth_actions = append_actions(handled_ninth.actions, handled_tenth.actions)
	let actions = append_actions(append_actions(first_actions, second_actions), append_actions(append_actions(third_actions, fourth_actions), append_actions(fifth_actions, append_actions(handled_eleventh.actions, handled_twelfth.actions))))
	stdio::print("selected ")
	stdio::print(int_to_string(selected_first.index))
	stdio::print(":")
	stdio::print(int_to_string(selected_second.index))
	stdio::print(":")
	stdio::print(int_to_string(selected_third.index))
	stdio::print(":")
	stdio::print(int_to_string(selected_fourth.index))
	stdio::print(":")
	stdio::print(int_to_string(selected_fifth.index))
	stdio::print(":")
	stdio::print(int_to_string(selected_sixth.index))
	stdio::print(":")
	stdio::print(int_to_string(selected_seventh.index))
	stdio::print(":")
	stdio::print(int_to_string(selected_eighth.index))
	stdio::print(":")
	stdio::print(int_to_string(selected_ninth.index))
	stdio::print(":")
	stdio::print(int_to_string(selected_tenth.index))
	stdio::print(":")
	stdio::print(int_to_string(selected_eleventh.index))
	stdio::print(":")
	stdio::print(int_to_string(selected_twelfth.index))
	stdio::print(" action-score ")
	stdio::print(int_to_string(action_stream_score(actions)))
	stdio::print(" payload-bytes ")
	stdio::print(int_to_string(payload_byte_count(actions)))
	stdio::print(" first-ended ")
	stdio::print(bool_text(handled_first.next_state.ended))
	stdio::print(" second-chunks ")
	stdio::print(int_to_string(handled_second.next_state.chunks))
	stdio::print(" third-ended ")
	stdio::print(bool_text(handled_third.next_state.ended))
	stdio::print(" fourth-chunks ")
	stdio::print(int_to_string(handled_fourth.next_state.chunks))
	stdio::print(" fifth-ended ")
	stdio::print(bool_text(handled_fifth.next_state.ended))
	stdio::print(" sixth-chunks ")
	stdio::print(int_to_string(handled_sixth.next_state.chunks))
	stdio::print(" seventh-chunks ")
	stdio::print(int_to_string(handled_seventh.next_state.chunks))
	stdio::print(" eighth-chunks ")
	stdio::print(int_to_string(handled_eighth.next_state.chunks))
	stdio::print(" ninth-chunks ")
	stdio::print(int_to_string(handled_ninth.next_state.chunks))
	stdio::print(" tenth-chunks ")
	stdio::print(int_to_string(handled_tenth.next_state.chunks))
	stdio::print(" eleventh-chunks ")
	stdio::print(int_to_string(handled_eleventh.next_state.chunks))
	stdio::print(" twelfth-chunks ")
	stdio::print(int_to_string(handled_twelfth.next_state.chunks))
	stdio::print(" writes ")
	stdio::println(int_to_string(write_count(actions)))
	Ok(())
end
