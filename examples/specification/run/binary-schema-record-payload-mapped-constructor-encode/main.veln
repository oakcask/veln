use stdio

type PacketPayload
	Empty
	Known({code: Int, value: Int})
end

type Packet
	Packet {payload: PacketPayload}
end

schema PacketWire
	format binary

	code: UInt8
	value: UInt16be

	map to Packet
		payload = PacketPayload::Known({code: code, value: value})
end

fn emit_output_chunk(name: String, index: Int, chunk: ByteChunk, expected_hex: String) -> () effects [stdio]
	stdio::print("output_chunk ")
	stdio::print(name)
	stdio::print(" index ")
	stdio::print(int_to_string(index))
	stdio::print(" hex \"")
	stdio::print(expected_hex)
	stdio::print("\" count ")
	stdio::println(int_to_string(byte_count_to_int(byte_chunk_count(chunk))))
end

fn emit_encoded(bytes: ByteChunk) -> () effects [stdio]
	stdio::println("output_chunk_list packet count 1")
	emit_output_chunk("packet", 0, bytes, "071234")
end

pub fn main() -> () effects [stdio]
	let encoded: Result<ByteChunk, EncodeError> = byte_encode_packet_wire({payload: PacketPayload::Known({code: 7, value: 4660})})
	match encoded
		Ok(bytes) => emit_encoded(bytes)
		Err(_) => stdio::println("unexpected encode failure")
	end
end
