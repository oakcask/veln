use net from "std"
use fixture_effects
use fake_effects

# Cancellable deadline-aware socket accept reports clean listener end as a value.
fn emit_accept_outcome(outcome: Result<net::Stream, net::NetError>) -> Result<(), net::NetError> effects [stdio]
	match outcome
		Ok(_) => begin
			stdio::println("accepted")
			Ok(())
		end
		Err(net::NetError(_, _, _, net::Closed, _)) => begin
			stdio::println("end")
			Ok(())
		end
		Err(net::NetError(_, _, _, net::TimedOut, _)) => begin
			stdio::println("deadline")
			Ok(())
		end
		Err(net::NetError(_, _, _, net::Cancelled, _)) => begin
			stdio::println("cancelled")
			Ok(())
		end
		Err(error) => Err(error)
	end
end

fn fixture_body() -> Result<(), net::NetError> effects [net::IO, time, stdio]
	let listener = net::listen(net::Address(net::Tcp4, "127.0.0.1", 0))?
	let deadline = time::deadline_after_ms(100)
	let token = time::cancel_token()
	let _ = emit_accept_outcome(net::accept_with(listener, Some(deadline), Some(token)))?
	Ok(())
end

pub fn main() -> Result<(), net::NetError> effects [concurrency, fs, net, stdio, time]
	let state = fixture_effects::create_fixture()
	handle handle handle fixture_body() with net::system() with fake_effects::network(state) with fake_effects::clock(state)
end
