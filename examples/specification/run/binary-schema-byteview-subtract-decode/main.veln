# Binary schema ByteView subtraction lengths decode bounded payload bytes.
use stdio

schema PacketWire
	format binary

	length: UInt8
	padding_length: UInt8
	payload: ByteView(length - padding_length)
end

fn emit_packet(packet: {length: Int, padding_length: Int, payload: ByteView}) -> Result<(), String> effects [stdio]
	stdio::print(int_to_string(packet.length))
	stdio::print(" ")
	stdio::print(int_to_string(packet.padding_length))
	stdio::print(" ")
	stdio::print(int_to_string(byte_count_to_int(byte_chunk_count(byte_view_to_chunk(packet.payload)))))
	stdio::print(" ")
	stdio::println(int_to_string(byte_read_u16_be(packet.payload)?))
	Ok(())
end

pub fn main() -> Result<(), String> effects [stdio]
	let bytes = byte_chunk_from_hex("0502aabbcc")?
	let view = byte_view(bytes, byte_offset(0)?, byte_count(5)?)?
	let packet = byte_decode_packet_wire(view)?
	emit_packet(packet)
	Ok(())
end
