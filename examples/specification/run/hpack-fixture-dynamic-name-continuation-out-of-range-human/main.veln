use http2::hpack::diagnostic from "std"
fn fallback_payload(error: String) -> RuntimeDiagnostic
	RuntimeDiagnostic(
		"hpack.fixture.dynamic_name_continuation_out_of_range",
		error,
		RuntimeHttp2HpackDiagnostic(RuntimeHpackFixtureDynamicNameDiagnostic(98, 0, -1, 3, 3, "fixture dynamic-name continuation range", "hpack_fixture", byte_chunk([])))
	)
end

fn preview_view() -> Result<ByteView, RuntimeDiagnostic>
	match byte_chunk_from_hex("7f02055041544348")
		Ok(bytes) => match byte_offset(0)
			Ok(offset) => match byte_view(bytes, offset, byte_chunk_count(bytes))
				Ok(view) => Ok(view)
				Err(error) => Err(fallback_payload(error))
			end
			Err(error) => Err(fallback_payload(error))
		end
		Err(error) => Err(fallback_payload(error))
	end
end

fn main() -> Result<(), RuntimeDiagnostic>
	let preview: ByteView = preview_view()?
	http2::hpack::diagnostic::dynamic_name_continuation_out_of_range(
		98,
		8,
		127,
		3,
		3,
		"fixture dynamic-name continuation range",
		"hpack_fixture",
		preview
	)
end
