# Binary schema payload length failures project focused human diagnostics.
pub fn main() -> Result<(), String>
	let bytes: ByteChunk = byte_chunk_from_hex("000005010400000001aabb")?
	let offset: ByteOffset = byte_offset(0)?
	let count: ByteCount = byte_count(11)?
	let view: ByteView = byte_view(bytes, offset, count)?
	let ignored: {length: Int, kind: Int, flags: Int, stream_id: Int, payload: ByteView} = byte_decode_http2_frame(view)?
	Ok(())
end
