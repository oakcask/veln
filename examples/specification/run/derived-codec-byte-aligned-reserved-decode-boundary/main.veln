# Explicit schema decode expressions support byte-aligned reserved fields.
use stdio

schema ByteAlignedReservedHeader
	format binary

	prefix: UInt8
	padding: ReservedBits(16, 43981)
	kind: UInt8
end


fn step_kind(step: DecodeStep<{prefix: Int, kind: Int}>) -> String
	match step
		Decoded(_, _) => "decoded"
		NeedMore(_) => "need_more"
		Invalid(_) => "invalid"
	end
end

fn decoded_prefix(step: DecodeStep<{prefix: Int, kind: Int}>) -> Int
	match step
		Decoded(header, _) => header.prefix
		NeedMore(_) => -1
		Invalid(_) => -1
	end
end

fn decoded_kind(step: DecodeStep<{prefix: Int, kind: Int}>) -> Int
	match step
		Decoded(header, _) => header.kind
		NeedMore(_) => -1
		Invalid(_) => -1
	end
end

fn consumed_count(step: DecodeStep<{prefix: Int, kind: Int}>) -> Int
	match step
		Decoded(_, consumed) => byte_count_to_int(consumed)
		NeedMore(_) => 0
		Invalid(_) => 0
	end
end

fn readiness_kind(step: DecodeStep<{prefix: Int, kind: Int}>) -> String
	match step
		Decoded(_, _) => "none"
		NeedMore(NeedBytes(_)) => "need_bytes"
		NeedMore(NeedEnd) => "need_end"
		Invalid(_) => "none"
	end
end

fn readiness_count(step: DecodeStep<{prefix: Int, kind: Int}>) -> Int
	match step
		Decoded(_, _) => 0
		NeedMore(NeedBytes(count)) => byte_count_to_int(count)
		NeedMore(NeedEnd) => 0
		Invalid(_) => 0
	end
end

fn error_id(step: DecodeStep<{prefix: Int, kind: Int}>) -> String
	match step
		Decoded(_, _) => "none"
		NeedMore(_) => "none"
		Invalid(DecodeError(id, _, _)) => id
		Invalid(DecodeErrorWithReason(id, _, _, _)) => id
	end
end

fn error_offset(step: DecodeStep<{prefix: Int, kind: Int}>) -> Int
	match step
		Decoded(_, _) => -1
		NeedMore(_) => -1
		Invalid(DecodeError(_, offset, _)) => byte_offset_to_int(offset)
		Invalid(DecodeErrorWithReason(_, offset, _, _)) => byte_offset_to_int(offset)
	end
end

fn error_path(step: DecodeStep<{prefix: Int, kind: Int}>) -> String
	match step
		Decoded(_, _) => "none"
		NeedMore(_) => "none"
		Invalid(DecodeError(_, _, path)) => path
		Invalid(DecodeErrorWithReason(_, _, path, _)) => path
	end
end

pub fn main() -> Result<(), String> effects [stdio]
	let bytes = byte_chunk_from_hex("12abcd34")?
	let view = byte_view(bytes, byte_offset(0)?, byte_count(4)?)?
	let decoded = decode ByteAlignedReservedHeader from view at byte_offset(20)?
	stdio::println(step_kind(decoded))
	stdio::println(int_to_string(decoded_prefix(decoded)))
	stdio::println(int_to_string(decoded_kind(decoded)))
	stdio::println(int_to_string(consumed_count(decoded)))

	let short_view = byte_view(bytes, byte_offset(0)?, byte_count(2)?)?
	let waiting = decode ByteAlignedReservedHeader from short_view at byte_offset(40)?
	stdio::println(step_kind(waiting))
	stdio::println(readiness_kind(waiting))
	stdio::println(int_to_string(readiness_count(waiting)))
	stdio::println(int_to_string(consumed_count(waiting)))

	let invalid_bytes = byte_chunk_from_hex("12abce34")?
	let invalid_view = byte_view(invalid_bytes, byte_offset(0)?, byte_count(4)?)?
	let invalid = decode ByteAlignedReservedHeader from invalid_view at byte_offset(80)?
	stdio::println(step_kind(invalid))
	stdio::println(int_to_string(consumed_count(invalid)))
	stdio::println(error_id(invalid))
	stdio::println(int_to_string(error_offset(invalid)))
	stdio::println(error_path(invalid))
	Ok(())
end
