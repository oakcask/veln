# Binary schema packed two-byte reserved suffix bits decode without exposing reserved fields.
use stdio

schema PackedTwoByteSuffixHeader
	format binary

	prefix: UInt8
	control: UInt3
	control_padding: ReservedBits(13, 1365)
	suffix: UInt8
end

fn emit_header(header: {prefix: Int, control: Int, suffix: Int}) -> () effects [stdio]
	stdio::print(int_to_string(header.prefix))
	stdio::print(" ")
	stdio::print(int_to_string(header.control))
	stdio::print(" ")
	stdio::println(int_to_string(header.suffix))
end

pub fn main() -> Result<(), String> effects [stdio]
	let bytes = byte_chunk_from_hex("12a55534")?
	let offset = byte_offset(0)?
	let count = byte_count(4)?
	let view = byte_view(bytes, offset, count)?
	let header = byte_decode_packed_two_byte_suffix_header(view)?
	emit_header(header)
	Ok(())
end
