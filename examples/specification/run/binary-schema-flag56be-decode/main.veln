# Binary schema Flag56be fields decode as source-visible bitset values.
use stdio

schema FlagPacket
	format binary

	flags: Flag56be
end

fn flag_bits(flags: Flag56be) -> Int
	match flags
		Flag56be(bits) => bits
	end
end

pub fn main() -> Result<(), String> effects [stdio]
	let bytes: ByteChunk = byte_chunk_from_hex("123456789abcde")?
	let offset: ByteOffset = byte_offset(0)?
	let count: ByteCount = byte_count(7)?
	let view: ByteView = byte_view(bytes, offset, count)?
	let packet: {flags: Flag56be} = byte_decode_flag_packet(view)?
	stdio::println(int_to_string(flag_bits(packet.flags)))
	Ok(())
end
