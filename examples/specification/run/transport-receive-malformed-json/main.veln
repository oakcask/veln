use net from "std"
use fixture_effects
use fake_effects

# Socket read failures are transport failures, not schema or protocol diagnostics.
fn fixture_body() -> Result<(), net::NetError> effects [net::IO, stdio]
	let listener = net::listen(net::Address(net::Tcp4, "127.0.0.1", 0))?
	let stream = net::accept(listener)?
	let _ = match net::read(stream)?
		net::ReadChunk(incoming) => stdio::println(int_to_string(byte_count_to_int(byte_chunk_count(incoming))))
		net::ReadEnd => ()
	end
	Ok(())
end

pub fn main() -> Result<(), net::NetError> effects [concurrency, fs, net, stdio, time]
	let state = fixture_effects::create_fixture()
	handle handle handle fixture_body() with net::system() with fake_effects::network(state) with fake_effects::clock(state)
end
