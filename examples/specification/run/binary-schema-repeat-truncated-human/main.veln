# Binary schema Repeat projects focused human truncation diagnostics.

schema CountedValues
	format binary

	count: UInt8
	items: Repeat(count, UInt16be)
end

pub fn main() -> Result<{count: Int, items: List<Int>}, String>
	let bytes: ByteChunk = byte_chunk_from_hex("0300")?
	let offset: ByteOffset = byte_offset(0)?
	let count: ByteCount = byte_count(2)?
	let view: ByteView = byte_view(bytes, offset, count)?
	byte_decode_counted_values(view)
end
