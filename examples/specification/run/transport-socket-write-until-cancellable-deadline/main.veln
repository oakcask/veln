use net from "std"
use fixture_effects
use fake_effects

# Cancellable deadline-aware socket write reports deadline expiry as a value.
fn write_outcome_text(outcome: net::WriteOutcome) -> String
	match outcome
		net::Written(_) => "written"
		net::WriteFailed(_, net::NetError(_, _, _, net::TimedOut, _)) => "deadline"
		net::WriteFailed(_, net::NetError(_, _, _, net::Cancelled, _)) => "cancelled"
		net::WriteFailed(_, _) => "cancelled"
	end
end

fn fixture_body() -> Result<(), String> effects [net::IO, time, stdio]
	let listener = open_listener("127.0.0.1:0")?
	let stream = accept_stream(listener)?
	let outgoing = byte_chunk_from_hex("0a0b")?
	let deadline = time::deadline_after_ms(100)
	let token = time::cancel_token()
	stdio::println(write_outcome_text(net::write_with(stream, outgoing, Some(deadline), Some(token))))
	Ok(())
end

fn fixture_network_error(error: net::NetError) -> String
	match error
		net::NetError(_, _, _, _, message) => match string_split_once(message, "\n")
			Some(parts) => parts.left
			None => message
		end
	end
end

fn open_listener(text: String) -> Result<net::Listener, String> effects [net::IO]
	match net::listen(net::Address(net::Tcp4, "127.0.0.1", 0))
		Ok(listener) => Ok(listener)
		Err(error) => Err(fixture_network_error(error))
	end
end

fn accept_stream(listener: net::Listener) -> Result<net::Stream, String> effects [net::IO]
	match net::accept(listener)
		Ok(stream) => Ok(stream)
		Err(error) => Err(fixture_network_error(error))
	end
end

pub fn main() -> Result<(), String> effects [concurrency, fs, net, stdio, time]
	let state = fixture_effects::create_fixture()
	handle handle handle fixture_body() with net::system() with fake_effects::network(state) with fake_effects::clock(state)
end
