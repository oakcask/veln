# Binary schema ByteView subtraction encode rejects computed length mismatches.
use stdio

schema PacketWire
	format binary

	length: UInt8
	padding_length: UInt8
	payload: ByteView(length - padding_length)
end

fn emit_error(error: EncodeError) -> () effects [stdio]
	stdio::println(error_id(error))
	stdio::println(error_path(error))
	stdio::println(error_reason(error))
end

fn error_id(error: EncodeError) -> String
	match error
		EncodeError(id, _, _) => id
	end
end

fn error_path(error: EncodeError) -> String
	match error
		EncodeError(_, field_path, _) => field_path
	end
end

fn error_reason(error: EncodeError) -> String
	match error
		EncodeError(_, _, reason) => reason
	end
end

pub fn main() -> Result<(), String> effects [stdio]
	let payload_bytes: ByteChunk = byte_chunk_from_hex("aabbcc")?
	let payload: ByteView = byte_view(payload_bytes, byte_offset(0)?, byte_count(3)?)?
	let encoded: Result<ByteChunk, EncodeError> = byte_encode_packet_wire({length: 5, padding_length: 1, payload: payload})
	let emitted: () = match encoded
		Ok(_) => stdio::println("unexpected encode success")
		Err(error) => emit_error(error)
	end
	Ok(())
end
