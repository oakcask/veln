use http2::diagnostic from "std"
# HTTP/2 PUSH_PROMISE promised request header-list diagnostics project JSON details.
fn invalid_payload(error: String) -> RuntimeDiagnostic
	RuntimeDiagnostic(
		"http2.protocol.invalid_request_header_list",
		error,
		RuntimeHttp2Diagnostic(RuntimeHttp2ProtocolInvalidRequestHeaderListDiagnostic(0, 5, 1, "te_header_value_not_trailers", "te", ":method,:scheme,:path,te", "request-headers", "rfc9113_te_trailers_only", byte_chunk([])))
	)
end

fn preview_bytes() -> Result<ByteChunk, RuntimeDiagnostic>
	match byte_chunk_from_hex("4c4d4e4f")
		Ok(bytes) => Ok(bytes)
		Err(error) => Err(invalid_payload(error))
	end
end

fn preview_view(bytes: ByteChunk) -> Result<ByteView, RuntimeDiagnostic>
	match byte_offset(0)
		Ok(offset) => match byte_count(4)
			Ok(count) => match byte_view(bytes, offset, count)
				Ok(view) => Ok(view)
				Err(error) => Err(invalid_payload(error))
			end
			Err(error) => Err(invalid_payload(error))
		end
		Err(error) => Err(invalid_payload(error))
	end
end

pub fn main() -> Result<(), RuntimeDiagnostic>
	let bytes: ByteChunk = preview_bytes()?
	http2::diagnostic::protocol_invalid_request_header_list(0, 5, 1, "te_header_value_not_trailers", "te", ":method,:scheme,:path,te", "request-headers", "rfc9113_te_trailers_only", preview_view(bytes)?)
end
