	let ignored_literal_path_linefeed_huffman = print_required_header("literal-path-linefeed-huffman", decode_header_block(byte_chunk_from_hex("0484fffffff3")?, initial, 116), ":path", "\n")?
	let ignored_literal_path_nul_huffman = print_required_header("literal-path-nul-huffman", decode_header_block(byte_chunk_from_hex("0482ffc7")?, initial, 117), ":path", "hpack-byte-00")?
