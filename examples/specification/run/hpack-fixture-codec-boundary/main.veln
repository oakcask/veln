	let proxy_authorization_state: HpackFixtureState = print_static_indexed_decode("proxy-authorization", "b1", proxy_authenticate_state, 54)?
	let range_state: HpackFixtureState = print_static_indexed_decode("range", "b2", proxy_authorization_state, 55)?
	let referer_state: HpackFixtureState = print_static_indexed_decode("referer", "b3", range_state, 56)?
	let refresh_state: HpackFixtureState = print_static_indexed_decode("refresh", "b4", referer_state, 57)?
	let retry_after_state: HpackFixtureState = print_static_indexed_decode("retry-after", "b5", refresh_state, 58)?
	let server_state: HpackFixtureState = print_static_indexed_decode("server", "b6", retry_after_state, 59)?
	let set_cookie_state: HpackFixtureState = print_static_indexed_decode("set-cookie", "b7", server_state, 60)?
	let strict_transport_security_state: HpackFixtureState = print_static_indexed_decode("strict-transport-security", "b8", set_cookie_state, 61)?
	let transfer_encoding_state: HpackFixtureState = print_static_indexed_decode("transfer-encoding", "b9", strict_transport_security_state, 62)?
	let user_agent_state: HpackFixtureState = print_static_indexed_decode("user-agent", "ba", transfer_encoding_state, 63)?
	let vary_state: HpackFixtureState = print_static_indexed_decode("vary", "bb", user_agent_state, 64)?
	let via_state: HpackFixtureState = print_static_indexed_decode("via", "bc", vary_state, 65)?
	let literal_state: HpackFixtureState = print_static_indexed_decode("www-authenticate", "bd", via_state, 66)?
	let literal_path_block: ByteChunk = byte_chunk_from_hex("04072f746172676574")?
	let literal_path: Result<HpackDecodeTransition, HpackFixtureFailure> = decode_header_block(literal_path_block, literal_state, 66)
	print_transition("literal-path", literal_path)
	let literal_huffman_state: HpackFixtureState = next_state_or(literal_path, literal_state)
	let literal_path_empty_huffman_block: ByteChunk = byte_chunk_from_hex("0480")?
	let literal_path_empty_huffman: Result<HpackDecodeTransition, HpackFixtureFailure> = decode_header_block(literal_path_empty_huffman_block, literal_huffman_state, 67)
	print_transition("literal-path-empty-huffman", literal_path_empty_huffman)
	let literal_authority_state: HpackFixtureState = next_state_or(literal_path_empty_huffman, literal_huffman_state)
	let literal_authority_block: ByteChunk = byte_chunk_from_hex("010b6578616d706c652e636f6d")?
	let literal_authority: Result<HpackDecodeTransition, HpackFixtureFailure> = decode_header_block(literal_authority_block, literal_authority_state, 69)
	print_transition("literal-authority", literal_authority)
	let literal_status_state: HpackFixtureState = next_state_or(literal_authority, literal_authority_state)
	let literal_status_block: ByteChunk = byte_chunk_from_hex("0803323031")?
	let literal_status: Result<HpackDecodeTransition, HpackFixtureFailure> = decode_header_block(literal_status_block, literal_status_state, 70)
	print_transition("literal-status", literal_status)
	let ignored_raw_string_encode_cases: () = print_raw_string_encode_cases()?
	let ignored_general_string_literal_cases: () = print_general_string_literal_cases(initial, literal_state)?
	let literal_never_indexed_path: Result<HpackDecodeTransition, HpackFixtureFailure> = decode_header_block(byte_chunk_from_hex("14072f746172676574")?, initial, 99)
	print_transition("literal-never-indexed-path", literal_never_indexed_path)
	print_transition("literal-never-indexed-dynamic-missing", decode_header_block(byte_chunk_from_hex("be")?, next_state_or(literal_never_indexed_path, initial), 100))
	let literal_indexed_state: HpackFixtureState = next_state_or(literal_status, literal_status_state)
	let literal_indexed_path_block: ByteChunk = byte_chunk_from_hex("44072f746172676574")?
	let literal_indexed_path: Result<HpackDecodeTransition, HpackFixtureFailure> = decode_header_block(literal_indexed_path_block, literal_indexed_state, 68)
	print_transition("literal-indexed-path", literal_indexed_path)
	let dynamic_state: HpackFixtureState = next_state_or(literal_indexed_path, literal_indexed_state)
	let dynamic_indexed_block: ByteChunk = byte_chunk_from_hex("be")?
	let dynamic_indexed_path: Result<HpackDecodeTransition, HpackFixtureFailure> = decode_header_block(dynamic_indexed_block, dynamic_state, 69)
	print_transition("dynamic-indexed-path", dynamic_indexed_path)
	let literal_indexed_dynamic_name_block: ByteChunk = byte_chunk_from_hex("7e062f616761696e")?
	let literal_indexed_dynamic_name: Result<HpackDecodeTransition, HpackFixtureFailure> = decode_header_block(literal_indexed_dynamic_name_block, dynamic_state, 73)
	print_transition("literal-indexed-dynamic-name-path-again", literal_indexed_dynamic_name)
	let literal_indexed_dynamic_name_state: HpackFixtureState = require_decoded_header(literal_indexed_dynamic_name, ":path", "/again")?
