	let dynamic_core_raw_literal_indexed = hpack_dynamic_core::decode_raw_literal_name_header_field(byte_chunk_from_hex("4007782d7472616365026f6b")?, hpack_dynamic_core::initial_dynamic_core_state(), 79)
	print_dynamic_core_transition("dynamic-core-raw-literal-indexed-x-trace", dynamic_core_raw_literal_indexed)
	let dynamic_core_raw_literal_indexed_state = dynamic_core_next_state_or(dynamic_core_raw_literal_indexed, hpack_dynamic_core::initial_dynamic_core_state())
	print_dynamic_core_accounting_state("dynamic-core-raw-literal-indexed-state", dynamic_core_raw_literal_indexed_state)
	print_dynamic_core_transition("dynamic-core-raw-literal-indexed-x-trace-reuse", hpack_dynamic_core::decode_indexed_header_field(dynamic_indexed_block, dynamic_core_raw_literal_indexed_state, 80))
	let dynamic_core_raw_literal_never_indexed = hpack_dynamic_core::decode_raw_literal_name_header_field(byte_chunk_from_hex("1007782d6e65766572026e6f")?, hpack_dynamic_core::initial_dynamic_core_state(), 81)
	print_dynamic_core_transition("dynamic-core-raw-literal-never-indexed-x-never", dynamic_core_raw_literal_never_indexed)
	print_dynamic_core_accounting_state("dynamic-core-raw-literal-never-indexed-state", dynamic_core_next_state_or(dynamic_core_raw_literal_never_indexed, hpack_dynamic_core::initial_dynamic_core_state()))
	let dynamic_core_raw_literal_huffman_without_indexing = hpack_dynamic_core::decode_raw_literal_name_header_field(byte_chunk_from_hex("0006782d687566668349509f")?, hpack_dynamic_core::initial_dynamic_core_state(), 130)
	print_dynamic_core_transition("dynamic-core-raw-literal-huffman-without-indexing-x-huff", dynamic_core_raw_literal_huffman_without_indexing)
