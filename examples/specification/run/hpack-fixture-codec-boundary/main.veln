fn build_deep_dynamic_path_state(remaining: Int, state: HpackFixtureState) -> Result<HpackFixtureState, String>
	match remaining
		0 => Ok(state)
		_ => match decode_header_block(byte_chunk_from_hex("44022f61")?, state, 109)
			Ok(transition) => match header_list_first_name(transition_headers(transition)) == ":path" and header_list_first_value(transition_headers(transition)) == "/a"
				true => build_deep_dynamic_path_state(remaining - 1, transition_state(transition))
				false => Err("unexpected HPACK fixture deep dynamic entry")
			end
			Err(_) => Err("expected HPACK fixture deep dynamic entry")
		end
	end
end

