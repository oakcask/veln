	stdio::print(label)
	stdio::print(" decoded ")
	stdio::print(hpack_dynamic_core::dynamic_core_header_list_first_name(headers))
	stdio::print(" ")
	stdio::print(hpack_dynamic_core::dynamic_core_header_list_first_value(headers))
	stdio::print(" wire_size ")
	stdio::print(int_to_string(hpack_dynamic_core::dynamic_core_header_list_wire_size(headers)))
	stdio::print(" next_decode_count ")
	stdio::println(int_to_string(hpack_dynamic_core::dynamic_core_state_decode_count(hpack_dynamic_core::dynamic_core_transition_state(transition))))
end

fn print_dynamic_core_failure(label: String, failure: HpackDynamicCoreFailure) -> () effects [stdio]
