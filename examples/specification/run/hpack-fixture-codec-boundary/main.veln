	let ignored_literal_indexed_method_bad_huffman = print_required_header("literal-indexed-method-bad-huffman", decode_header_block(byte_chunk_from_hex("42838c727f")?, initial, 107), ":method", "bad")?
	let ignored_literal_indexed_scheme_https_huffman = print_required_header("literal-indexed-scheme-https-huffman", decode_header_block(byte_chunk_from_hex("46849d29ad1f")?, initial, 87), ":scheme", "https")?
	print_transition("literal-indexed-status", decode_header_block(byte_chunk_from_hex("4803323031")?, initial, 85))
