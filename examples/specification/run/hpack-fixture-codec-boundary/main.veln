fn dynamic_core_next_state_or(result: Result<HpackDynamicCoreDecodeTransition, HpackDynamicCoreFailure>, fallback: HpackDynamicCoreState) -> HpackDynamicCoreState
	match result
		Ok(transition) => hpack_dynamic_core::dynamic_core_transition_state(transition)
		Err(_) => fallback
	end
end

fn build_deep_dynamic_core_path_state(remaining: Int, state: HpackDynamicCoreState) -> HpackDynamicCoreState
	match remaining
		0 => state
		_ => build_deep_dynamic_core_path_state(remaining - 1, hpack_dynamic_core::prepend_carried_dynamic_entry_state(state, ":path", "/a"))
	end
end

fn print_two_header_transition(label: String, result: Result<HpackDecodeTransition, HpackFixtureFailure>) -> () effects [stdio]
	match result
		Ok(transition) => print_decoded_two_header_transition(label, transition)
		Err(failure) => print_decode_failure(label, failure)
	end
end

fn next_state_or(result: Result<HpackDecodeTransition, HpackFixtureFailure>, fallback: HpackFixtureState) -> HpackFixtureState
	match result
		Ok(transition) => transition_state(transition)
		Err(_) => fallback
	end
end

fn print_static_indexed_decode(label: String, block_hex: String, state: HpackFixtureState, offset: Int) -> Result<HpackFixtureState, String> effects [stdio]
	let result = decode_header_block(byte_chunk_from_hex(block_hex)?, state, offset)
	print_transition(label, result)
	Ok(next_state_or(result, state))
end

fn require_decoded_header(result: Result<HpackDecodeTransition, HpackFixtureFailure>, expected_name: String, expected_value: String) -> Result<HpackFixtureState, String>
	match result
		Ok(transition) => if header_list_first_name(transition_headers(transition)) == expected_name and header_list_first_value(transition_headers(transition)) == expected_value
			Ok(transition_state(transition))
		else
			Err("unexpected HPACK fixture header")
		end
		Err(_) => Err("expected HPACK fixture decode")
	end
end

fn require_unsupported(result: Result<HpackDecodeTransition, HpackFixtureFailure>) -> Result<(), String>
	match result
		Ok(_) => Err("expected unsupported HPACK fixture block")
		Err(_) => Ok(())
	end
end

fn require_failure_id(result: Result<HpackDecodeTransition, HpackFixtureFailure>, expected_id: String) -> Result<(), String>
	match result
		Ok(_) => Err("expected HPACK fixture failure")
		Err(failure) => if failure_diagnostic_id(failure) == expected_id
			Ok(())
		else
			Err("unexpected HPACK fixture failure id")
		end
	end
end

fn print_required_header(label: String, result: Result<HpackDecodeTransition, HpackFixtureFailure>, expected_name: String, expected_value: String) -> Result<HpackFixtureState, String> effects [stdio]
	print_transition(label, result)
	require_decoded_header(result, expected_name, expected_value)
end

fn print_required_unsupported(label: String, result: Result<HpackDecodeTransition, HpackFixtureFailure>) -> Result<(), String> effects [stdio]
	print_transition(label, result)
	require_unsupported(result)
end

fn print_required_unsupported_with_id(label: String, result: Result<HpackDecodeTransition, HpackFixtureFailure>) -> Result<(), String> effects [stdio]
	let ignored_print = match result
		Ok(transition) => print_decoded_transition(label, transition)
		Err(failure) => print_decode_failure_with_id(label, failure)
	end
	require_unsupported(result)
end

fn print_required_failure_id(label: String, result: Result<HpackDecodeTransition, HpackFixtureFailure>, expected_id: String) -> Result<(), String> effects [stdio]
	let ignored_print = match result
		Ok(transition) => print_decoded_transition(label, transition)
		Err(failure) => print_decode_failure_with_id(label, failure)
	end
	require_failure_id(result, expected_id)
end

fn require_table_size(state: HpackFixtureState, expected_table_size: Int) -> Result<(), String>
	if state_table_size(state) == expected_table_size
		Ok(())
	else
		Err("unexpected HPACK fixture table size")
	end
end

fn require_dynamic_entry_count(state: HpackFixtureState, expected_dynamic_entries: Int) -> Result<(), String>
	if state_dynamic_table_entry_count(state) == expected_dynamic_entries
		Ok(())
	else
		Err("unexpected HPACK fixture dynamic entry count")
	end
end

fn require_multiple_table_size_updates(state: HpackFixtureState) -> Result<(), String>
	let updates_state = require_decoded_header(decode_header_block(byte_chunk_from_hex("3f81013e")?, state, 81), ":fixture", "table-size-update")?
	let ignored_updates_size = require_table_size(updates_state, 30)?
	let field_state = require_decoded_header(decode_header_block(byte_chunk_from_hex("3f81013e82")?, state, 85), ":method", "GET")?
	let ignored_field_size = require_table_size(field_state, 30)?
	let retained_state = require_decoded_header(decode_header_block(byte_chunk_from_hex("3f81013f0dbe")?, state, 88), ":path", "/target")?
	let ignored_retained_size = require_table_size(retained_state, 44)?
	let ignored_retained_entry = require_dynamic_entry_count(retained_state, 1)?
	let ignored_wire_order_eviction = require_failure_id(decode_header_block(byte_chunk_from_hex("3e3f8101be")?, state, 89), "hpack.fixture.dynamic_index_out_of_range")?
	let ignored_malformed = require_failure_id(decode_header_block(byte_chunk_from_hex("3e3f80")?, state, 90), "hpack.fixture.table_size_update_malformed")?
	let ignored_after_field = require_failure_id(decode_header_block(byte_chunk_from_hex("3e823f01")?, state, 91), "hpack.fixture.table_size_update_not_at_start")?
	let ignored_third_update = require_failure_id(decode_header_block(byte_chunk_from_hex("3e3f013f02")?, state, 91), "hpack.fixture.table_size_update_not_at_start")?
	let ignored_original_size = require_table_size(state, 4096)?
	require_dynamic_entry_count(state, 1)
end

fn require_encode_state(state: HpackFixtureState, expected_table_size: Int, expected_dynamic_entries: Int) -> Result<(), String>
	if state_table_size(state) == expected_table_size and state_dynamic_table_entry_count(state) == expected_dynamic_entries
		Ok(())
	else
		Err("unexpected HPACK fixture encode state")
	end
end

