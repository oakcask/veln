	let ignored_literal_method_put_huffman = print_required_header("literal-method-put-huffman", decode_header_block(byte_chunk_from_hex("0283d7c37f")?, initial, 83), ":method", "PUT")?
	let ignored_literal_method_bad_huffman = print_required_header("literal-method-bad-huffman", decode_header_block(byte_chunk_from_hex("02838c727f")?, initial, 106), ":method", "bad")?
