	let ignored_literal_path_bytes_huffman = print_required_header("literal-path-bytes-huffman", decode_header_block(byte_chunk_from_hex("0485ffc7ffffdd")?, initial, 120), ":path", "hpack-bytes-00-ff")?
	let ignored_literal_path_two_nul_huffman = print_required_header("literal-path-two-nul-huffman", decode_header_block(byte_chunk_from_hex("0484ffc7fe3f")?, initial, 118), ":path", "hpack-bytes-00-00")?
	print_transition("literal-indexed-authority", decode_header_block(byte_chunk_from_hex("41086162632e74657374")?, initial, 86))
