use hpack_fixture
use hpack_dynamic_core
use stdio

fn display_header_value(value: String) -> String
	match value
		"\n" => "<lf>"
		"hpack-byte-00" => "<nul>"
		_ => value
	end
end

fn print_decoded_transition(label: String, transition: HpackDecodeTransition) -> () effects [stdio]
	let headers: HpackHeaderList = transition_headers(transition)
	stdio::print(label)
	stdio::print(" decoded ")
	stdio::print(header_list_first_name(headers))
	stdio::print(" ")
	stdio::print(display_header_value(header_list_first_value(headers)))
	stdio::print(" wire_size ")
	stdio::print(int_to_string(header_list_wire_size(headers)))
	stdio::print(" next_decode_count ")
	stdio::println(int_to_string(state_decode_count(transition_state(transition))))
end

fn print_decoded_two_header_transition(label: String, transition: HpackDecodeTransition) -> () effects [stdio]
	let headers: HpackHeaderList = transition_headers(transition)
	stdio::print(label)
	stdio::print(" decoded ")
	stdio::print(header_list_first_name(headers))
	stdio::print(" ")
	stdio::print(display_header_value(header_list_first_value(headers)))
	stdio::print(" then ")
	stdio::print(header_list_second_name(headers))
	stdio::print(" ")
	stdio::print(display_header_value(header_list_second_value(headers)))
	stdio::print(" wire_size ")
	stdio::print(int_to_string(header_list_wire_size(headers)))
	stdio::print(" next_decode_count ")
	stdio::println(int_to_string(state_decode_count(transition_state(transition))))
end

fn print_decode_failure(label: String, failure: HpackFixtureFailure) -> () effects [stdio]
	stdio::print(label)
	stdio::print(" failed offset ")
	stdio::print(int_to_string(failure_offset(failure)))
	stdio::print(" observed_size ")
	stdio::print(int_to_string(failure_observed_size(failure)))
	stdio::print(" observed_first_byte ")
	stdio::print(int_to_string(failure_observed_first_byte(failure)))
	stdio::print(" expected ")
	stdio::println(failure_expected_fixture(failure))
end

fn print_decode_failure_with_id(label: String, failure: HpackFixtureFailure) -> () effects [stdio]
	stdio::print(label)
	stdio::print(" failed id ")
	stdio::print(failure_diagnostic_id(failure))
	stdio::print(" offset ")
	stdio::print(int_to_string(failure_offset(failure)))
	stdio::print(" observed_size ")
	stdio::print(int_to_string(failure_observed_size(failure)))
	stdio::print(" observed_first_byte ")
	stdio::print(int_to_string(failure_observed_first_byte(failure)))
	stdio::print(" expected ")
	stdio::println(failure_expected_fixture(failure))
end

fn encoded_byte_at(block: ByteChunk, index: Int) -> Result<Int, String>
	let view: ByteView = byte_view(block, byte_offset(index)?, byte_count(1)?)?
	byte_read_u8_be(view)
end

fn encoded_byte_at_or_missing(block: ByteChunk, index: Int) -> Int
	match encoded_byte_at(block, index)
		Ok(value) => value
		Err(_) => -1
	end
end

fn encoded_bytes_equal_at(left: ByteChunk, right: ByteChunk, index: Int, count: Int) -> Bool
	match index == count
		true => true
		false => match encoded_byte_at_or_missing(left, index) == encoded_byte_at_or_missing(right, index)
			true => encoded_bytes_equal_at(left, right, index + 1, count)
			false => false
		end
	end
end

fn encoded_bytes_equal(left: ByteChunk, right: ByteChunk) -> Bool
	let left_count: Int = byte_count_to_int(byte_chunk_count(left))
	let right_count: Int = byte_count_to_int(byte_chunk_count(right))
	match left_count == right_count
		true => encoded_bytes_equal_at(left, right, 0, left_count)
		false => false
	end
end

fn repeat_expected_byte(count: Int) -> Result<ByteChunk, String>
	match count
		0 => Ok(byte_chunk([]))
		_ => Ok(byte_append(byte_chunk_from_hex("61")?, repeat_expected_byte(count - 1)?))
	end
end

fn print_encoded_success(label: String, encoded: ByteChunk) -> Result<(), String> effects [stdio]
	stdio::print(label)
	stdio::print(" encoded count ")
	stdio::print(int_to_string(byte_count_to_int(byte_chunk_count(encoded))))
	stdio::print(" first_byte ")
	stdio::println(int_to_string(encoded_byte_at_or_missing(encoded, 0)))
	Ok(())
end

fn print_encoded_literal(label: String, result: Result<ByteChunk, HpackFixtureFailure>, expected: ByteChunk) -> Result<(), String> effects [stdio]
	match result
		Ok(encoded) => match encoded_bytes_equal(encoded, expected)
			true => print_encoded_success(label, encoded)
			false => Err("unexpected HPACK fixture string encoding")
		end
		Err(_) => Err("expected HPACK fixture string encoding")
	end
end

fn print_encode_failure_value(label: String, failure: HpackFixtureFailure) -> Result<(), String> effects [stdio]
	print_decode_failure(label, failure)
	Ok(())
end

fn print_encode_failure(label: String, result: Result<ByteChunk, HpackFixtureFailure>) -> Result<(), String> effects [stdio]
	match result
		Ok(_) => Err("expected HPACK fixture string encoding failure")
		Err(failure) => print_encode_failure_value(label, failure)
	end
end

fn print_encode_transition(label: String, result: Result<HpackEncodeTransition, HpackFixtureFailure>, expected_hex: String) -> Result<HpackFixtureState, String> effects [stdio]
	match result
		Ok(transition) => match encoded_bytes_equal(encode_transition_bytes(transition), byte_chunk_from_hex(expected_hex)?)
			true => print_encode_transition_success(label, transition)
			false => Err("unexpected HPACK fixture header-list encoding")
		end
		Err(_) => Err("expected HPACK fixture header-list encoding")
	end
end

fn print_encode_transition_success(label: String, transition: HpackEncodeTransition) -> Result<HpackFixtureState, String> effects [stdio]
	let encoded: ByteChunk = encode_transition_bytes(transition)
	let state: HpackFixtureState = encode_transition_state(transition)
	stdio::print(label)
	stdio::print(" encoded count ")
	stdio::print(int_to_string(byte_count_to_int(byte_chunk_count(encoded))))
	stdio::print(" first_byte ")
	stdio::print(int_to_string(encoded_byte_at_or_missing(encoded, 0)))
	stdio::print(" next_encode_count ")
	stdio::print(int_to_string(state_encode_count(state)))
	stdio::print(" table_size ")
	stdio::println(int_to_string(state_table_size(state)))
	Ok(state)
end

fn print_encode_transition_failure(label: String, result: Result<HpackEncodeTransition, HpackFixtureFailure>) -> Result<(), String> effects [stdio]
	match result
		Ok(_) => Err("expected HPACK fixture encode transition failure")
		Err(failure) => print_encode_failure_value(label, failure)
	end
end

fn require_header_list_encoding(result: Result<ByteChunk, HpackFixtureFailure>) -> Result<ByteChunk, String>
	match result
		Ok(encoded) => Ok(encoded)
		Err(_) => Err("expected HPACK fixture header-list encoding")
	end
end

fn print_state(label: String, state: HpackFixtureState) -> () effects [stdio]
	stdio::print(label)
	stdio::print(" state table_size ")
	stdio::print(int_to_string(state_table_size(state)))
	stdio::print(" decode_count ")
	stdio::println(int_to_string(state_decode_count(state)))
end

