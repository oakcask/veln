use hpack_fixture
use stdio

fn print_decoded_transition(label: String, transition: HpackDecodeTransition) -> () effects [stdio]
	let headers: HpackHeaderList = transition_headers(transition)
	stdio::print(label)
	stdio::print(" decoded ")
	stdio::print(header_list_first_name(headers))
	stdio::print(" ")
	stdio::print(header_list_first_value(headers))
	stdio::print(" wire_size ")
	stdio::print(int_to_string(header_list_wire_size(headers)))
	stdio::print(" next_decode_count ")
	stdio::println(int_to_string(state_decode_count(transition_state(transition))))
end

fn print_decode_failure(label: String, failure: HpackFixtureFailure) -> () effects [stdio]
	stdio::print(label)
	stdio::print(" failed offset ")
	stdio::print(int_to_string(failure_offset(failure)))
	stdio::print(" observed_size ")
	stdio::print(int_to_string(failure_observed_size(failure)))
	stdio::print(" observed_first_byte ")
	stdio::print(int_to_string(failure_observed_first_byte(failure)))
	stdio::print(" expected ")
	stdio::println(failure_expected_fixture(failure))
end

fn print_transition(label: String, result: Result<HpackDecodeTransition, HpackFixtureFailure>) -> () effects [stdio]
	match result
		Ok(transition) => print_decoded_transition(label, transition)
		Err(failure) => print_decode_failure(label, failure)
	end
end

fn next_state_or(result: Result<HpackDecodeTransition, HpackFixtureFailure>, fallback: HpackFixtureState) -> HpackFixtureState
	match result
		Ok(transition) => transition_state(transition)
		Err(_) => fallback
	end
end

pub fn main() -> Result<(), String> effects [stdio]
	let initial: HpackFixtureState = initial_state()
	let first_block: ByteChunk = byte_chunk_from_hex("102030")?
	let first: Result<HpackDecodeTransition, HpackFixtureFailure> = decode_header_block(first_block, initial, 9)
	print_transition("first", first)
	let second_state: HpackFixtureState = next_state_or(first, initial)
	let second_block: ByteChunk = byte_chunk_from_hex("0102030405060708")?
	let second: Result<HpackDecodeTransition, HpackFixtureFailure> = decode_header_block(second_block, second_state, 18)
	print_transition("second", second)
	let third_state: HpackFixtureState = next_state_or(second, second_state)
	let method_post_block: ByteChunk = byte_chunk_from_hex("83")?
	let method_post: Result<HpackDecodeTransition, HpackFixtureFailure> = decode_header_block(method_post_block, third_state, 26)
	print_transition("method-post", method_post)
	let accept_charset_state: HpackFixtureState = next_state_or(method_post, third_state)
	let accept_charset_block: ByteChunk = byte_chunk_from_hex("8f")?
	let accept_charset: Result<HpackDecodeTransition, HpackFixtureFailure> = decode_header_block(accept_charset_block, accept_charset_state, 27)
	print_transition("accept-charset", accept_charset)
	let accept_encoding_state: HpackFixtureState = next_state_or(accept_charset, accept_charset_state)
	let accept_encoding_block: ByteChunk = byte_chunk_from_hex("90")?
	let accept_encoding: Result<HpackDecodeTransition, HpackFixtureFailure> = decode_header_block(accept_encoding_block, accept_encoding_state, 28)
	print_transition("accept-encoding", accept_encoding)
	let accept_language_state: HpackFixtureState = next_state_or(accept_encoding, accept_encoding_state)
	let accept_language_block: ByteChunk = byte_chunk_from_hex("91")?
	let accept_language: Result<HpackDecodeTransition, HpackFixtureFailure> = decode_header_block(accept_language_block, accept_language_state, 29)
	print_transition("accept-language", accept_language)
	let content_disposition_state: HpackFixtureState = next_state_or(accept_language, accept_language_state)
	let content_disposition_block: ByteChunk = byte_chunk_from_hex("99")?
	let content_disposition: Result<HpackDecodeTransition, HpackFixtureFailure> = decode_header_block(content_disposition_block, content_disposition_state, 30)
	print_transition("content-disposition", content_disposition)
	let content_encoding_state: HpackFixtureState = next_state_or(content_disposition, content_disposition_state)
	let content_encoding_block: ByteChunk = byte_chunk_from_hex("9a")?
	let content_encoding: Result<HpackDecodeTransition, HpackFixtureFailure> = decode_header_block(content_encoding_block, content_encoding_state, 31)
	print_transition("content-encoding", content_encoding)
	let content_language_state: HpackFixtureState = next_state_or(content_encoding, content_encoding_state)
	let content_language_block: ByteChunk = byte_chunk_from_hex("9b")?
	let content_language: Result<HpackDecodeTransition, HpackFixtureFailure> = decode_header_block(content_language_block, content_language_state, 32)
	print_transition("content-language", content_language)
	let content_length_state: HpackFixtureState = next_state_or(content_language, content_language_state)
	let content_length_block: ByteChunk = byte_chunk_from_hex("9c")?
	let content_length: Result<HpackDecodeTransition, HpackFixtureFailure> = decode_header_block(content_length_block, content_length_state, 33)
	print_transition("content-length", content_length)
	let content_location_state: HpackFixtureState = next_state_or(content_length, content_length_state)
	let content_location_block: ByteChunk = byte_chunk_from_hex("9d")?
	let content_location: Result<HpackDecodeTransition, HpackFixtureFailure> = decode_header_block(content_location_block, content_location_state, 34)
	print_transition("content-location", content_location)
	let content_range_state: HpackFixtureState = next_state_or(content_location, content_location_state)
	let content_range_block: ByteChunk = byte_chunk_from_hex("9e")?
	let content_range: Result<HpackDecodeTransition, HpackFixtureFailure> = decode_header_block(content_range_block, content_range_state, 35)
	print_transition("content-range", content_range)
	let content_type_state: HpackFixtureState = next_state_or(content_range, content_range_state)
	let content_type_block: ByteChunk = byte_chunk_from_hex("9f")?
	let content_type: Result<HpackDecodeTransition, HpackFixtureFailure> = decode_header_block(content_type_block, content_type_state, 36)
	print_transition("content-type", content_type)
	let cookie_state: HpackFixtureState = next_state_or(content_type, content_type_state)
	let cookie_block: ByteChunk = byte_chunk_from_hex("a0")?
	let cookie: Result<HpackDecodeTransition, HpackFixtureFailure> = decode_header_block(cookie_block, cookie_state, 37)
	print_transition("cookie", cookie)
	let date_state: HpackFixtureState = next_state_or(cookie, cookie_state)
	let date_block: ByteChunk = byte_chunk_from_hex("a1")?
	let date: Result<HpackDecodeTransition, HpackFixtureFailure> = decode_header_block(date_block, date_state, 38)
	print_transition("date", date)
	let etag_state: HpackFixtureState = next_state_or(date, date_state)
	let etag_block: ByteChunk = byte_chunk_from_hex("a2")?
	let etag: Result<HpackDecodeTransition, HpackFixtureFailure> = decode_header_block(etag_block, etag_state, 39)
	print_transition("etag", etag)
	let expect_state: HpackFixtureState = next_state_or(etag, etag_state)
	let expect_block: ByteChunk = byte_chunk_from_hex("a3")?
	let expect_header: Result<HpackDecodeTransition, HpackFixtureFailure> = decode_header_block(expect_block, expect_state, 40)
	print_transition("expect", expect_header)
	let from_state: HpackFixtureState = next_state_or(expect_header, expect_state)
	let from_block: ByteChunk = byte_chunk_from_hex("a4")?
	let from_header: Result<HpackDecodeTransition, HpackFixtureFailure> = decode_header_block(from_block, from_state, 41)
	print_transition("from", from_header)
	let host_state: HpackFixtureState = next_state_or(from_header, from_state)
	let host_block: ByteChunk = byte_chunk_from_hex("a5")?
	let host: Result<HpackDecodeTransition, HpackFixtureFailure> = decode_header_block(host_block, host_state, 42)
	print_transition("host", host)
	let if_match_state: HpackFixtureState = next_state_or(host, host_state)
	let if_match_block: ByteChunk = byte_chunk_from_hex("a6")?
	let if_match: Result<HpackDecodeTransition, HpackFixtureFailure> = decode_header_block(if_match_block, if_match_state, 43)
	print_transition("if-match", if_match)
	let if_modified_since_state: HpackFixtureState = next_state_or(if_match, if_match_state)
	let if_modified_since_block: ByteChunk = byte_chunk_from_hex("a7")?
	let if_modified_since: Result<HpackDecodeTransition, HpackFixtureFailure> = decode_header_block(if_modified_since_block, if_modified_since_state, 44)
	print_transition("if-modified-since", if_modified_since)
	let if_none_match_state: HpackFixtureState = next_state_or(if_modified_since, if_modified_since_state)
	let if_none_match_block: ByteChunk = byte_chunk_from_hex("a8")?
	let if_none_match: Result<HpackDecodeTransition, HpackFixtureFailure> = decode_header_block(if_none_match_block, if_none_match_state, 45)
	print_transition("if-none-match", if_none_match)
	let if_range_state: HpackFixtureState = next_state_or(if_none_match, if_none_match_state)
	let if_range_block: ByteChunk = byte_chunk_from_hex("a9")?
	let if_range: Result<HpackDecodeTransition, HpackFixtureFailure> = decode_header_block(if_range_block, if_range_state, 46)
	print_transition("if-range", if_range)
	let if_unmodified_since_state: HpackFixtureState = next_state_or(if_range, if_range_state)
	let if_unmodified_since_block: ByteChunk = byte_chunk_from_hex("aa")?
	let if_unmodified_since: Result<HpackDecodeTransition, HpackFixtureFailure> = decode_header_block(if_unmodified_since_block, if_unmodified_since_state, 47)
	print_transition("if-unmodified-since", if_unmodified_since)
	let literal_state: HpackFixtureState = next_state_or(if_unmodified_since, if_unmodified_since_state)
	let literal_path_block: ByteChunk = byte_chunk_from_hex("04072f746172676574")?
	print_transition("literal-path", decode_header_block(literal_path_block, literal_state, 48))
	let malformed_literal_block: ByteChunk = byte_chunk_from_hex("0400")?
	print_transition("malformed-literal", decode_header_block(malformed_literal_block, literal_state, 49))
	let bad_block: ByteChunk = byte_chunk_from_hex("ff")?
	print_transition("bad", decode_header_block(bad_block, second_state, 27))
	Ok(())
end
