pub fn main() -> Result<(), String> effects [stdio]
	let initial = initial_state()
	let literal_state = print_initial_static_indexed_cases(initial)?
	let literal_path_block = byte_chunk_from_hex("04072f746172676574")?
	let literal_path = decode_header_block(literal_path_block, literal_state, 66)
	print_transition("literal-path", literal_path)
	let literal_huffman_state = next_state_or(literal_path, literal_state)
	let literal_path_empty_huffman_block = byte_chunk_from_hex("0480")?
	let literal_path_empty_huffman = decode_header_block(literal_path_empty_huffman_block, literal_huffman_state, 67)
	print_transition("literal-path-empty-huffman", literal_path_empty_huffman)
	let literal_authority_state = next_state_or(literal_path_empty_huffman, literal_huffman_state)
	let literal_authority_block = byte_chunk_from_hex("010b6578616d706c652e636f6d")?
	let literal_authority = decode_header_block(literal_authority_block, literal_authority_state, 69)
	print_transition("literal-authority", literal_authority)
	let literal_status_state = next_state_or(literal_authority, literal_authority_state)
	let literal_status_block = byte_chunk_from_hex("0803323031")?
	let literal_status = decode_header_block(literal_status_block, literal_status_state, 70)
	print_transition("literal-status", literal_status)
	let ignored_raw_string_encode_cases = print_raw_string_encode_cases()?
	let ignored_header_list_encode_cases = print_header_list_encode_cases()?
	let ignored_general_string_literal_cases = print_general_string_literal_cases(initial, literal_state)?
	let literal_never_indexed_path = decode_header_block(byte_chunk_from_hex("14072f746172676574")?, initial, 99)
	print_transition("literal-never-indexed-path", literal_never_indexed_path)
	print_transition("literal-never-indexed-dynamic-missing", decode_header_block(byte_chunk_from_hex("be")?, next_state_or(literal_never_indexed_path, initial), 100))
	let literal_indexed_state = next_state_or(literal_status, literal_status_state)
	let literal_indexed_path_block = byte_chunk_from_hex("44072f746172676574")?
	let literal_indexed_path = decode_header_block(literal_indexed_path_block, literal_indexed_state, 68)
	print_transition("literal-indexed-path", literal_indexed_path)
	let dynamic_state = next_state_or(literal_indexed_path, literal_indexed_state)
	let dynamic_indexed_block = byte_chunk_from_hex("be")?
	let evicted_indexed_block = byte_chunk_from_hex("bf")?
	let third_indexed_block = byte_chunk_from_hex("c0")?
	let dynamic_indexed_path = decode_header_block(dynamic_indexed_block, dynamic_state, 69)
	print_transition("dynamic-indexed-path", dynamic_indexed_path)
	let dynamic_core_state = hpack_dynamic_core::carried_single_dynamic_entry_state(4096, 1, ":path", "/target")
	print_dynamic_core_transition("dynamic-core-indexed-path", hpack_dynamic_core::decode_indexed_header_field(dynamic_indexed_block, dynamic_core_state, 69))
	print_dynamic_core_transition("dynamic-core-indexed-missing", hpack_dynamic_core::decode_indexed_header_field(dynamic_indexed_block, hpack_dynamic_core::initial_dynamic_core_state(), 70))
	let dynamic_core_two_entry_state = hpack_dynamic_core::prepend_carried_dynamic_entry_state(dynamic_core_state, ":method", "PUT")
	let dynamic_core_newest_method = hpack_dynamic_core::decode_indexed_header_field(dynamic_indexed_block, dynamic_core_two_entry_state, 71)
	print_dynamic_core_transition("dynamic-core-indexed-newest-method", dynamic_core_newest_method)
	let dynamic_core_after_newest = dynamic_core_next_state_or(dynamic_core_newest_method, dynamic_core_two_entry_state)
	let dynamic_core_second_path = hpack_dynamic_core::decode_indexed_header_field(evicted_indexed_block, dynamic_core_after_newest, 72)
	print_dynamic_core_transition("dynamic-core-indexed-second-path", dynamic_core_second_path)
	let dynamic_core_after_second = dynamic_core_next_state_or(dynamic_core_second_path, dynamic_core_after_newest)
	let dynamic_core_third_missing = hpack_dynamic_core::decode_indexed_header_field(third_indexed_block, dynamic_core_after_second, 73)
	print_dynamic_core_transition("dynamic-core-indexed-third-missing", dynamic_core_third_missing)
	print_dynamic_core_state("dynamic-core-after-third-missing", dynamic_core_next_state_or(dynamic_core_third_missing, dynamic_core_after_second))
	let dynamic_core_wide_block = byte_chunk_from_hex("ff00")?
	let dynamic_core_deep_state = build_deep_dynamic_core_path_state(66, hpack_dynamic_core::initial_dynamic_core_state())
	print_dynamic_core_transition("dynamic-core-indexed-wide-path", hpack_dynamic_core::decode_indexed_header_field(dynamic_core_wide_block, dynamic_core_deep_state, 74))
