		Ok(transition) => print_decoded_transition(label, transition)
		Err(failure) => print_decode_failure(label, failure)
	end
end

fn print_dynamic_core_transition(label: String, result: Result<HpackDynamicCoreDecodeTransition, HpackDynamicCoreFailure>) -> () effects [stdio]
	match result
		Ok(transition) => print_dynamic_core_decoded_transition(label, transition)
		Err(failure) => print_dynamic_core_failure(label, failure)
	end
end

fn print_dynamic_core_decoded_transition(label: String, transition: HpackDynamicCoreDecodeTransition) -> () effects [stdio]
