fn dynamic_core_next_state_or(result: Result<HpackDynamicCoreDecodeTransition, HpackDynamicCoreFailure>, fallback: HpackDynamicCoreState) -> HpackDynamicCoreState
	match result
		Ok(transition) => hpack_dynamic_core::dynamic_core_transition_state(transition)
		Err(_) => fallback
	end
end

fn build_deep_dynamic_core_path_state(remaining: Int, state: HpackDynamicCoreState) -> HpackDynamicCoreState
	match remaining
		0 => state
		_ => build_deep_dynamic_core_path_state(remaining - 1, hpack_dynamic_core::prepend_carried_dynamic_entry_state(state, ":path", "/a"))
	end
end

fn print_two_header_transition(label: String, result: Result<HpackDecodeTransition, HpackFixtureFailure>) -> () effects [stdio]
	match result
		Ok(transition) => print_decoded_two_header_transition(label, transition)
		Err(failure) => print_decode_failure(label, failure)
	end
end

fn next_state_or(result: Result<HpackDecodeTransition, HpackFixtureFailure>, fallback: HpackFixtureState) -> HpackFixtureState
	match result
		Ok(transition) => transition_state(transition)
		Err(_) => fallback
	end
end

fn print_static_indexed_decode(label: String, block_hex: String, state: HpackFixtureState, offset: Int) -> Result<HpackFixtureState, String> effects [stdio]
	let result: Result<HpackDecodeTransition, HpackFixtureFailure> = decode_header_block(byte_chunk_from_hex(block_hex)?, state, offset)
	print_transition(label, result)
	Ok(next_state_or(result, state))
end

fn require_decoded_header(result: Result<HpackDecodeTransition, HpackFixtureFailure>, expected_name: String, expected_value: String) -> Result<HpackFixtureState, String>
	match result
		Ok(transition) => match header_list_first_name(transition_headers(transition)) == expected_name and header_list_first_value(transition_headers(transition)) == expected_value
			true => Ok(transition_state(transition))
			false => Err("unexpected HPACK fixture header")
		end
		Err(_) => Err("expected HPACK fixture decode")
	end
end

fn require_unsupported(result: Result<HpackDecodeTransition, HpackFixtureFailure>) -> Result<(), String>
	match result
		Ok(_) => Err("expected unsupported HPACK fixture block")
		Err(_) => Ok(())
	end
end

fn require_failure_id(result: Result<HpackDecodeTransition, HpackFixtureFailure>, expected_id: String) -> Result<(), String>
	match result
		Ok(_) => Err("expected HPACK fixture failure")
		Err(failure) => match failure_diagnostic_id(failure) == expected_id
			true => Ok(())
			false => Err("unexpected HPACK fixture failure id")
		end
	end
end

fn print_required_header(label: String, result: Result<HpackDecodeTransition, HpackFixtureFailure>, expected_name: String, expected_value: String) -> Result<HpackFixtureState, String> effects [stdio]
	print_transition(label, result)
	require_decoded_header(result, expected_name, expected_value)
end

fn print_required_unsupported(label: String, result: Result<HpackDecodeTransition, HpackFixtureFailure>) -> Result<(), String> effects [stdio]
	print_transition(label, result)
	require_unsupported(result)
end

fn print_required_unsupported_with_id(label: String, result: Result<HpackDecodeTransition, HpackFixtureFailure>) -> Result<(), String> effects [stdio]
	let ignored_print: () = match result
		Ok(transition) => print_decoded_transition(label, transition)
		Err(failure) => print_decode_failure_with_id(label, failure)
	end
	require_unsupported(result)
end

fn print_required_failure_id(label: String, result: Result<HpackDecodeTransition, HpackFixtureFailure>, expected_id: String) -> Result<(), String> effects [stdio]
	let ignored_print: () = match result
		Ok(transition) => print_decoded_transition(label, transition)
		Err(failure) => print_decode_failure_with_id(label, failure)
	end
	require_failure_id(result, expected_id)
end

fn require_table_size(state: HpackFixtureState, expected_table_size: Int) -> Result<(), String>
	match state_table_size(state) == expected_table_size
		true => Ok(())
		false => Err("unexpected HPACK fixture table size")
	end
end

