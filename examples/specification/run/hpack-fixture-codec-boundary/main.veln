fn print_dynamic_name_literal_cases(dynamic_state: HpackFixtureState, dynamic_indexed_block: ByteChunk) -> Result<(), String> effects [stdio]
	let literal_without_indexing_dynamic_name_block = byte_chunk_from_hex("0f2f032f6e6f")?
	let literal_without_indexing_dynamic_name = decode_header_block(literal_without_indexing_dynamic_name_block, dynamic_state, 100)
	print_transition("literal-without-indexing-dynamic-name-path-no", literal_without_indexing_dynamic_name)
	let literal_without_indexing_dynamic_name_state = require_decoded_header(literal_without_indexing_dynamic_name, ":path", "/no")?
	let ignored_without_indexing_retained_path = print_required_header("dynamic-name-without-indexing-retains-path", decode_header_block(dynamic_indexed_block, literal_without_indexing_dynamic_name_state, 101), ":path", "/target")?
	let literal_never_indexed_dynamic_name_block = byte_chunk_from_hex("1f2f072f736563726574")?
	let literal_never_indexed_dynamic_name = decode_header_block(literal_never_indexed_dynamic_name_block, dynamic_state, 102)
	print_transition("literal-never-indexed-dynamic-name-path-secret", literal_never_indexed_dynamic_name)
	let literal_never_indexed_dynamic_name_state = require_decoded_header(literal_never_indexed_dynamic_name, ":path", "/secret")?
	let ignored_never_indexed_retained_path = print_required_header("dynamic-name-never-indexed-retains-path", decode_header_block(dynamic_indexed_block, literal_never_indexed_dynamic_name_state, 103), ":path", "/target")?
	let ignored_dynamic_name_out_of_range = print_required_unsupported_with_id("literal-without-indexing-dynamic-name-out-of-range", decode_header_block(byte_chunk_from_hex("0f30032f626164")?, dynamic_state, 104))?
	let ignored_never_indexed_dynamic_name_malformed = print_required_unsupported_with_id("malformed-literal-never-indexed-dynamic-name", decode_header_block(byte_chunk_from_hex("1f80")?, dynamic_state, 105))?
	Ok(())
end

fn build_deep_dynamic_path_state(remaining: Int, state: HpackFixtureState) -> Result<HpackFixtureState, String>
	match remaining
		0 => Ok(state)
		_ => match decode_header_block(byte_chunk_from_hex("44022f61")?, state, 109)
			Ok(transition) => if header_list_first_name(transition_headers(transition)) == ":path" and header_list_first_value(transition_headers(transition)) == "/a"
				build_deep_dynamic_path_state(remaining - 1, transition_state(transition))
			else
				Err("unexpected HPACK fixture deep dynamic entry")
			end
			Err(_) => Err("expected HPACK fixture deep dynamic entry")
		end
	end
end

fn print_dynamic_name_wide_continuation_cases() -> Result<(), String> effects [stdio]
	let deep_dynamic_state = build_deep_dynamic_path_state(66, initial_state())?
	print_transition("dynamic-name-wide-index-retained-older-path", decode_header_block(byte_chunk_from_hex("ff")?, deep_dynamic_state, 109))
	print_transition("dynamic-indexed-wide-continuation-retained-older-path", decode_header_block(byte_chunk_from_hex("ff00")?, deep_dynamic_state, 117))
	let literal_indexed_deep_name = decode_header_block(byte_chunk_from_hex("7f40052f64656570")?, deep_dynamic_state, 110)
	print_transition("literal-indexed-dynamic-name-wide-path-deep", literal_indexed_deep_name)
	let literal_indexed_deep_name_state = require_decoded_header(literal_indexed_deep_name, ":path", "/deep")?
	print_transition("dynamic-name-wide-newest-path-deep", decode_header_block(byte_chunk_from_hex("be")?, literal_indexed_deep_name_state, 111))
	let literal_without_indexing_deep_name = decode_header_block(byte_chunk_from_hex("0f70052f736b6970")?, deep_dynamic_state, 112)
	print_transition("literal-without-indexing-dynamic-name-wide-path-skip", literal_without_indexing_deep_name)
	let literal_without_indexing_deep_name_state = require_decoded_header(literal_without_indexing_deep_name, ":path", "/skip")?
	print_transition("dynamic-name-wide-without-indexing-retains-older-path", decode_header_block(byte_chunk_from_hex("ff")?, literal_without_indexing_deep_name_state, 113))
	let literal_never_indexed_deep_name = decode_header_block(byte_chunk_from_hex("1f70072f736563726574")?, deep_dynamic_state, 114)
	print_transition("literal-never-indexed-dynamic-name-wide-path-secret", literal_never_indexed_deep_name)
	let literal_never_indexed_deep_name_state = require_decoded_header(literal_never_indexed_deep_name, ":path", "/secret")?
	print_transition("dynamic-name-wide-never-indexed-retains-older-path", decode_header_block(byte_chunk_from_hex("ff")?, literal_never_indexed_deep_name_state, 115))
	let ignored_dynamic_name_wide_out_of_range = print_required_unsupported_with_id("literal-indexed-dynamic-name-wide-out-of-range", decode_header_block(byte_chunk_from_hex("7f41052f64656570")?, deep_dynamic_state, 116))?
	let ignored_dynamic_indexed_wide_out_of_range = print_required_unsupported_with_id("dynamic-indexed-wide-continuation-out-of-range", decode_header_block(byte_chunk_from_hex("ff00")?, initial_state(), 118))?
	Ok(())
end

fn print_initial_static_indexed_cases(initial: HpackFixtureState) -> Result<HpackFixtureState, String> effects [stdio]
