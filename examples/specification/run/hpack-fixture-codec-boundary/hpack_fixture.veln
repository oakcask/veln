	let name_index: Int = first_byte - 64
	match supported_no_huffman_literal_static_name(name_index) and observed_size >= 2
		true => match decode_hpack_string_length(block, observed_size, offset)
			Ok(length) => match observed_size == string_length_prefix_size(length) + string_length_encoded_count(length)
				true => match decode_hpack_string_literal_value(block, length, offset)
