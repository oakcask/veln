pub type HpackDynamicEntry
	NoDynamicEntry
	DynamicEntry(name: String, value: String)
	DynamicEntryPair(new_name: String, new_value: String, older_name: String, older_value: String)
end

pub type HpackFixtureState
	HpackFixtureState(table_size: Int, decode_count: Int, dynamic_entry: HpackDynamicEntry)
end

pub type HpackHeader
	HpackHeader(name: String, value: String)
end

pub type HpackHeaderList
	HpackHeaderList(first: HpackHeader, second: HpackHeader, wire_size: Int)
end

pub type HpackDecodeTransition
	HpackDecodeTransition(headers: HpackHeaderList, state: HpackFixtureState)
end

pub type HpackFixtureFailure
	UnsupportedHeaderBlock(offset: Int, observed_size: Int, observed_first_byte: Int, expected_fixture: String, codec_module: String, preview: ByteChunk)
end

type HpackHuffmanValue
	HpackHuffmanEmpty
	HpackHuffmanW
	HpackHuffmanWw
	HpackHuffmanWww
	HpackHuffmanWwwDot
	HpackHuffmanWwwDotE
	HpackHuffmanWwwDotEx
	HpackHuffmanWwwDotExa
	HpackHuffmanWwwDotExam
	HpackHuffmanWwwDotExamp
	HpackHuffmanWwwDotExampl
	HpackHuffmanWwwDotExample
	HpackHuffmanWwwDotExampleDot
	HpackHuffmanWwwDotExampleDotC
	HpackHuffmanWwwDotExampleDotCo
	HpackHuffmanWwwDotExampleDotCom
	HpackHuffmanSlash
	HpackHuffmanSlashT
	HpackHuffmanSlashTa
	HpackHuffmanSlashTar
	HpackHuffmanSlashTarg
	HpackHuffmanSlashTarge
	HpackHuffmanSlashTarget
	HpackHuffmanH
	HpackHuffmanHt
	HpackHuffmanHtt
	HpackHuffmanHttp
	HpackHuffmanHttps
	HpackHuffmanP
	HpackHuffmanPu
	HpackHuffmanPut
end

pub fn initial_state() -> HpackFixtureState
	HpackFixtureState(4096, 0, NoDynamicEntry)
end

fn byte_at(block: ByteChunk, index: Int) -> Result<Int, String>
	let view: ByteView = byte_view(block, byte_offset(index)?, byte_count(1)?)?
	byte_read_u8_be(view)
end

fn byte_at_or_missing(block: ByteChunk, index: Int) -> Int
	match byte_at(block, index)
		Ok(value) => value
		Err(_) => -1
	end
end

fn next_state(state: HpackFixtureState) -> HpackFixtureState
	match state
		HpackFixtureState(table_size, decode_count, dynamic_entry) => HpackFixtureState(table_size, decode_count + 1, dynamic_entry)
	end
end

fn dynamic_entry_size(name: String, value: String) -> Int
	match name == ":path" and value == "/target"
		true => 44
		false => 42
	end
end

fn bounded_dynamic_entry(table_size: Int, name: String, value: String, dynamic_entry: HpackDynamicEntry) -> HpackDynamicEntry
	let entry_size: Int = dynamic_entry_size(name, value)
	match entry_size > table_size
		true => NoDynamicEntry
		false => match dynamic_entry
			NoDynamicEntry => DynamicEntry(name, value)
			DynamicEntry(older_name, older_value) => match entry_size + dynamic_entry_size(older_name, older_value) <= table_size
				true => DynamicEntryPair(name, value, older_name, older_value)
				false => DynamicEntry(name, value)
			end
			DynamicEntryPair(previous_name, previous_value, _, _) => match entry_size + dynamic_entry_size(previous_name, previous_value) <= table_size
				true => DynamicEntryPair(name, value, previous_name, previous_value)
				false => DynamicEntry(name, value)
			end
		end
	end
end

fn evict_for_table_size(table_size: Int, dynamic_entry: HpackDynamicEntry) -> HpackDynamicEntry
	match dynamic_entry
		NoDynamicEntry => NoDynamicEntry
		DynamicEntry(name, value) => match dynamic_entry_size(name, value) <= table_size
			true => DynamicEntry(name, value)
			false => NoDynamicEntry
		end
		DynamicEntryPair(new_name, new_value, older_name, older_value) => match dynamic_entry_size(new_name, new_value) <= table_size
			false => NoDynamicEntry
			true => match dynamic_entry_size(new_name, new_value) + dynamic_entry_size(older_name, older_value) <= table_size
				true => DynamicEntryPair(new_name, new_value, older_name, older_value)
				false => DynamicEntry(new_name, new_value)
			end
		end
	end
end

fn state_with_dynamic_entry(state: HpackFixtureState, name: String, value: String) -> HpackFixtureState
	match state
		HpackFixtureState(table_size, decode_count, dynamic_entry) => HpackFixtureState(table_size, decode_count + 1, bounded_dynamic_entry(table_size, name, value, dynamic_entry))
	end
end

fn state_with_table_size(state: HpackFixtureState, table_size: Int) -> HpackFixtureState
	match state
		HpackFixtureState(_, decode_count, dynamic_entry) => HpackFixtureState(table_size, decode_count + 1, evict_for_table_size(table_size, dynamic_entry))
	end
end

fn fixture_headers(label: String, wire_size: Int) -> HpackHeaderList
	HpackHeaderList(HpackHeader(":fixture", label), HpackHeader(":status", "ok"), wire_size)
end

fn static_indexed_method_post_headers() -> HpackHeaderList
	HpackHeaderList(HpackHeader(":method", "POST"), HpackHeader(":fixture", "static-indexed"), 9)
end

fn static_indexed_header(name: String, value: String) -> HpackHeaderList
	HpackHeaderList(HpackHeader(name, value), HpackHeader(":fixture", "static-indexed"), 9)
end

fn static_indexed_authority_headers() -> HpackHeaderList
	HpackHeaderList(HpackHeader(":authority", ""), HpackHeader(":fixture", "static-indexed"), 1)
end

fn literal_without_indexing_path_target_headers() -> HpackHeaderList
	HpackHeaderList(HpackHeader(":path", "/target"), HpackHeader(":fixture", "literal-without-indexing"), 9)
end

fn literal_without_indexing_authority_example_headers() -> HpackHeaderList
	HpackHeaderList(HpackHeader(":authority", "example.com"), HpackHeader(":fixture", "literal-without-indexing"), 13)
end

fn literal_with_indexing_path_target_headers() -> HpackHeaderList
	HpackHeaderList(HpackHeader(":path", "/target"), HpackHeader(":fixture", "literal-with-indexing"), 9)
end

fn literal_with_indexing_method_put_headers() -> HpackHeaderList
	HpackHeaderList(HpackHeader(":method", "PUT"), HpackHeader(":fixture", "literal-with-indexing"), 5)
end

fn dynamic_indexed_header(name: String, value: String) -> HpackHeaderList
	HpackHeaderList(HpackHeader(name, value), HpackHeader(":fixture", "dynamic-indexed"), 9)
end

fn decoded(label: String, wire_size: Int, state: HpackFixtureState) -> Result<HpackDecodeTransition, HpackFixtureFailure>
	Ok(HpackDecodeTransition(fixture_headers(label, wire_size), next_state(state)))
end

fn decoded_static_indexed_method_post(state: HpackFixtureState) -> Result<HpackDecodeTransition, HpackFixtureFailure>
	Ok(HpackDecodeTransition(static_indexed_method_post_headers(), next_state(state)))
end

fn decoded_static_indexed_header(name: String, value: String, state: HpackFixtureState) -> Result<HpackDecodeTransition, HpackFixtureFailure>
	Ok(HpackDecodeTransition(static_indexed_header(name, value), next_state(state)))
end

fn decoded_static_indexed_authority(state: HpackFixtureState) -> Result<HpackDecodeTransition, HpackFixtureFailure>
	Ok(HpackDecodeTransition(static_indexed_authority_headers(), next_state(state)))
end

fn decoded_literal_without_indexing_path_target(state: HpackFixtureState) -> Result<HpackDecodeTransition, HpackFixtureFailure>
	Ok(HpackDecodeTransition(literal_without_indexing_path_target_headers(), next_state(state)))
end

fn decoded_literal_without_indexing_authority_example(state: HpackFixtureState) -> Result<HpackDecodeTransition, HpackFixtureFailure>
	Ok(HpackDecodeTransition(literal_without_indexing_authority_example_headers(), next_state(state)))
end

fn literal_without_indexing_headers(name: String, value: String, wire_size: Int) -> HpackHeaderList
	HpackHeaderList(HpackHeader(name, value), HpackHeader(":fixture", "literal-without-indexing"), wire_size)
end

fn decoded_literal_without_indexing(name: String, value: String, wire_size: Int, state: HpackFixtureState) -> Result<HpackDecodeTransition, HpackFixtureFailure>
	Ok(HpackDecodeTransition(literal_without_indexing_headers(name, value, wire_size), next_state(state)))
end

fn decoded_literal_with_indexing_path_target(state: HpackFixtureState) -> Result<HpackDecodeTransition, HpackFixtureFailure>
	Ok(HpackDecodeTransition(literal_with_indexing_path_target_headers(), state_with_dynamic_entry(state, ":path", "/target")))
end

fn decoded_literal_with_indexing_method_put(state: HpackFixtureState) -> Result<HpackDecodeTransition, HpackFixtureFailure>
	Ok(HpackDecodeTransition(literal_with_indexing_method_put_headers(), state_with_dynamic_entry(state, ":method", "PUT")))
end

fn decoded_dynamic_indexed_newest_header(state: HpackFixtureState, block: ByteChunk, offset: Int) -> Result<HpackDecodeTransition, HpackFixtureFailure>
	match state
		HpackFixtureState(_, _, NoDynamicEntry) => unsupported(block, offset)
		HpackFixtureState(_, _, DynamicEntry(name, value)) => Ok(HpackDecodeTransition(dynamic_indexed_header(name, value), next_state(state)))
		HpackFixtureState(_, _, DynamicEntryPair(name, value, _, _)) => Ok(HpackDecodeTransition(dynamic_indexed_header(name, value), next_state(state)))
	end
end

fn decoded_dynamic_indexed_older_header(state: HpackFixtureState, block: ByteChunk, offset: Int) -> Result<HpackDecodeTransition, HpackFixtureFailure>
	match state
		HpackFixtureState(_, _, NoDynamicEntry) => unsupported(block, offset)
		HpackFixtureState(_, _, DynamicEntry(_, _)) => unsupported(block, offset)
		HpackFixtureState(_, _, DynamicEntryPair(_, _, name, value)) => Ok(HpackDecodeTransition(dynamic_indexed_header(name, value), next_state(state)))
	end
end

fn decoded_table_size_update(state: HpackFixtureState, table_size: Int) -> Result<HpackDecodeTransition, HpackFixtureFailure>
	Ok(HpackDecodeTransition(fixture_headers("table-size-update", 0), state_with_table_size(state, table_size)))
end

fn low_seven_bits(byte: Int) -> Int
	byte - (byte / 128) * 128
end

fn decode_table_size_integer_tail_byte(current: Int, block: ByteChunk, observed_size: Int, index: Int, multiplier: Int, value: Int, state: HpackFixtureState, offset: Int) -> Result<HpackDecodeTransition, HpackFixtureFailure>
	let next_value: Int = value + low_seven_bits(current) * multiplier
	match current < 128
		true => match index + 1 == observed_size
			true => decoded_table_size_update(state, next_value)
			false => unsupported(block, offset)
		end
		false => decode_table_size_integer_tail(block, observed_size, index + 1, multiplier * 128, next_value, state, offset)
	end
end

fn decode_table_size_integer_tail(block: ByteChunk, observed_size: Int, index: Int, multiplier: Int, value: Int, state: HpackFixtureState, offset: Int) -> Result<HpackDecodeTransition, HpackFixtureFailure>
	match index < observed_size
		false => unsupported(block, offset)
		true => decode_table_size_integer_tail_byte(byte_at_or_missing(block, index), block, observed_size, index, multiplier, value, state, offset)
	end
end

fn decode_saturated_table_size_update(block: ByteChunk, observed_size: Int, state: HpackFixtureState, offset: Int) -> Result<HpackDecodeTransition, HpackFixtureFailure>
	decode_table_size_integer_tail(block, observed_size, 1, 1, 31, state, offset)
end

fn unsupported(block: ByteChunk, offset: Int) -> Result<HpackDecodeTransition, HpackFixtureFailure>
	Err(UnsupportedHeaderBlock(offset, byte_count_to_int(byte_chunk_count(block)), byte_at_or_missing(block, 0), "fixture header block", "hpack_fixture", block))
end

fn unsupported_value(block: ByteChunk, offset: Int) -> Result<String, HpackFixtureFailure>
	Err(UnsupportedHeaderBlock(offset, byte_count_to_int(byte_chunk_count(block)), byte_at_or_missing(block, 0), "fixture header block", "hpack_fixture", block))
end

fn pow2(value: Int) -> Int
	match value
		0 => 1
		1 => 2
		2 => 4
		3 => 8
		4 => 16
		5 => 32
		6 => 64
		7 => 128
		_ => 256
	end
end

fn byte_bit(byte: Int, bit_index: Int) -> Int
	let divisor: Int = pow2(7 - bit_index)
	byte / divisor - (byte / (divisor * 2)) * 2
end

fn hpack_static_huffman_symbol(code: Int, length: Int) -> Option<Int>
	match length
		5 => match code
			3 => Some(97)
			4 => Some(99)
			5 => Some(101)
			7 => Some(111)
			8 => Some(115)
			9 => Some(116)
			_ => None
		end
		6 => match code
			23 => Some(46)
			24 => Some(47)
			38 => Some(103)
			39 => Some(104)
			40 => Some(108)
			41 => Some(109)
			43 => Some(112)
			44 => Some(114)
			_ => None
		end
		7 => match code
			107 => Some(80)
			111 => Some(84)
			112 => Some(85)
			120 => Some(119)
			121 => Some(120)
			_ => None
		end
		_ => None
	end
end

fn hpack_huffman_push_symbol(value: HpackHuffmanValue, symbol: Int) -> Option<HpackHuffmanValue>
	match value
		HpackHuffmanEmpty => match symbol
			47 => Some(HpackHuffmanSlash)
			80 => Some(HpackHuffmanP)
			104 => Some(HpackHuffmanH)
			119 => Some(HpackHuffmanW)
			_ => None
		end
		HpackHuffmanW => match symbol
			119 => Some(HpackHuffmanWw)
			_ => None
		end
		HpackHuffmanWw => match symbol
			119 => Some(HpackHuffmanWww)
			_ => None
		end
		HpackHuffmanWww => match symbol
			46 => Some(HpackHuffmanWwwDot)
			_ => None
		end
		HpackHuffmanWwwDot => match symbol
			101 => Some(HpackHuffmanWwwDotE)
			_ => None
		end
		HpackHuffmanWwwDotE => match symbol
			120 => Some(HpackHuffmanWwwDotEx)
			_ => None
		end
		HpackHuffmanWwwDotEx => match symbol
			97 => Some(HpackHuffmanWwwDotExa)
			_ => None
		end
		HpackHuffmanWwwDotExa => match symbol
			109 => Some(HpackHuffmanWwwDotExam)
			_ => None
		end
		HpackHuffmanWwwDotExam => match symbol
			112 => Some(HpackHuffmanWwwDotExamp)
			_ => None
		end
		HpackHuffmanWwwDotExamp => match symbol
			108 => Some(HpackHuffmanWwwDotExampl)
			_ => None
		end
		HpackHuffmanWwwDotExampl => match symbol
			101 => Some(HpackHuffmanWwwDotExample)
			_ => None
		end
		HpackHuffmanWwwDotExample => match symbol
			46 => Some(HpackHuffmanWwwDotExampleDot)
			_ => None
		end
		HpackHuffmanWwwDotExampleDot => match symbol
			99 => Some(HpackHuffmanWwwDotExampleDotC)
			_ => None
		end
		HpackHuffmanWwwDotExampleDotC => match symbol
			111 => Some(HpackHuffmanWwwDotExampleDotCo)
			_ => None
		end
		HpackHuffmanWwwDotExampleDotCo => match symbol
			109 => Some(HpackHuffmanWwwDotExampleDotCom)
			_ => None
		end
		HpackHuffmanSlash => match symbol
			116 => Some(HpackHuffmanSlashT)
			_ => None
		end
		HpackHuffmanSlashT => match symbol
			97 => Some(HpackHuffmanSlashTa)
			_ => None
		end
		HpackHuffmanSlashTa => match symbol
			114 => Some(HpackHuffmanSlashTar)
			_ => None
		end
		HpackHuffmanSlashTar => match symbol
			103 => Some(HpackHuffmanSlashTarg)
			_ => None
		end
		HpackHuffmanSlashTarg => match symbol
			101 => Some(HpackHuffmanSlashTarge)
			_ => None
		end
		HpackHuffmanSlashTarge => match symbol
			116 => Some(HpackHuffmanSlashTarget)
			_ => None
		end
		HpackHuffmanH => match symbol
			116 => Some(HpackHuffmanHt)
			_ => None
		end
		HpackHuffmanHt => match symbol
			116 => Some(HpackHuffmanHtt)
			_ => None
		end
		HpackHuffmanHtt => match symbol
			112 => Some(HpackHuffmanHttp)
			_ => None
		end
		HpackHuffmanHttp => match symbol
			115 => Some(HpackHuffmanHttps)
			_ => None
		end
		HpackHuffmanP => match symbol
			85 => Some(HpackHuffmanPu)
			_ => None
		end
		HpackHuffmanPu => match symbol
			84 => Some(HpackHuffmanPut)
			_ => None
		end
		_ => None
	end
end

fn hpack_huffman_value_string(value: HpackHuffmanValue) -> Option<String>
	match value
		HpackHuffmanEmpty => Some("")
		HpackHuffmanWwwDotExampleDotCom => Some("www.example.com")
		HpackHuffmanSlashTarget => Some("/target")
		HpackHuffmanHttps => Some("https")
		HpackHuffmanPut => Some("PUT")
		_ => None
	end
end

fn hpack_huffman_value_from_string(value: String) -> HpackHuffmanValue
	match value == ""
		true => HpackHuffmanEmpty
		false => match value == "www.example.com"
			true => HpackHuffmanWwwDotExampleDotCom
			false => match value == "/target"
				true => HpackHuffmanSlashTarget
				false => match value == "https"
					true => HpackHuffmanHttps
					false => HpackHuffmanPut
				end
			end
		end
	end
end

fn hpack_huffman_decoded_wire_size(value: HpackHuffmanValue, observed_size: Int) -> Int
	match value
		HpackHuffmanEmpty => observed_size
		HpackHuffmanWwwDotExampleDotCom => 13
		HpackHuffmanSlashTarget => 7
		HpackHuffmanHttps => 5
		HpackHuffmanPut => 3
		_ => observed_size
	end
end

fn hpack_huffman_padding_valid(code: Int, length: Int) -> Bool
	length == 0 or (length <= 7 and code == pow2(length) - 1)
end

fn decode_hpack_huffman_done(value: HpackHuffmanValue, code: Int, length: Int, block: ByteChunk, offset: Int) -> Result<String, HpackFixtureFailure>
	match hpack_huffman_padding_valid(code, length)
		false => unsupported_value(block, offset)
		true => match hpack_huffman_value_string(value)
			Some(decoded) => Ok(decoded)
			None => unsupported_value(block, offset)
		end
	end
end

fn decode_hpack_huffman_bit(block: ByteChunk, bit_index: Int, total_bits: Int, value: HpackHuffmanValue, code: Int, length: Int, offset: Int) -> Result<String, HpackFixtureFailure>
	let source_byte: Int = byte_at_or_missing(block, 2 + bit_index / 8)
	let bit: Int = byte_bit(source_byte, bit_index - (bit_index / 8) * 8)
	let next_code: Int = code * 2 + bit
	let next_length: Int = length + 1
	match hpack_static_huffman_symbol(next_code, next_length)
		Some(symbol) => match hpack_huffman_push_symbol(value, symbol)
			Some(next_value) => decode_hpack_huffman_bits(block, bit_index + 1, total_bits, next_value, 0, 0, offset)
			None => unsupported_value(block, offset)
		end
		None => match next_length > 7
			true => unsupported_value(block, offset)
			false => decode_hpack_huffman_bits(block, bit_index + 1, total_bits, value, next_code, next_length, offset)
		end
	end
end

fn decode_hpack_huffman_bits(block: ByteChunk, bit_index: Int, total_bits: Int, value: HpackHuffmanValue, code: Int, length: Int, offset: Int) -> Result<String, HpackFixtureFailure>
	match bit_index == total_bits
		true => decode_hpack_huffman_done(value, code, length, block, offset)
		false => decode_hpack_huffman_bit(block, bit_index, total_bits, value, code, length, offset)
	end
end

fn decode_hpack_huffman_literal_value(block: ByteChunk, encoded_count: Int, offset: Int) -> Result<String, HpackFixtureFailure>
	match encoded_count <= 12
		true => decode_hpack_huffman_bits(block, 0, encoded_count * 8, HpackHuffmanEmpty, 0, 0, offset)
		false => unsupported_value(block, offset)
	end
end

fn literal_static_name(index: Int) -> String
	match index == 1
		true => ":authority"
		false => match index == 2
			true => ":method"
			false => match index == 4
				true => ":path"
				false => ":scheme"
			end
		end
	end
end

fn is_literal_without_indexing_path_target(block: ByteChunk, observed_size: Int, first_byte: Int) -> Bool
	match first_byte == 4 and observed_size == 9
		true => byte_at_or_missing(block, 1) == 7 and byte_at_or_missing(block, 2) == 47 and byte_at_or_missing(block, 3) == 116 and byte_at_or_missing(block, 4) == 97 and byte_at_or_missing(block, 5) == 114 and byte_at_or_missing(block, 6) == 103 and byte_at_or_missing(block, 7) == 101 and byte_at_or_missing(block, 8) == 116
		false => false
	end
end

fn is_literal_without_indexing_authority_example(block: ByteChunk, observed_size: Int, first_byte: Int) -> Bool
	match first_byte == 1 and observed_size == 13
		true => byte_at_or_missing(block, 1) == 11 and byte_at_or_missing(block, 2) == 101 and byte_at_or_missing(block, 3) == 120 and byte_at_or_missing(block, 4) == 97 and byte_at_or_missing(block, 5) == 109 and byte_at_or_missing(block, 6) == 112 and byte_at_or_missing(block, 7) == 108 and byte_at_or_missing(block, 8) == 101 and byte_at_or_missing(block, 9) == 46 and byte_at_or_missing(block, 10) == 99 and byte_at_or_missing(block, 11) == 111 and byte_at_or_missing(block, 12) == 109
		false => false
	end
end

fn is_literal_with_indexing_path_target(block: ByteChunk, observed_size: Int, first_byte: Int) -> Bool
	match first_byte == 68 and observed_size == 9
		true => byte_at_or_missing(block, 1) == 7 and byte_at_or_missing(block, 2) == 47 and byte_at_or_missing(block, 3) == 116 and byte_at_or_missing(block, 4) == 97 and byte_at_or_missing(block, 5) == 114 and byte_at_or_missing(block, 6) == 103 and byte_at_or_missing(block, 7) == 101 and byte_at_or_missing(block, 8) == 116
		false => false
	end
end

fn is_literal_with_indexing_method_put(block: ByteChunk, observed_size: Int, first_byte: Int) -> Bool
	match first_byte == 66 and observed_size == 5
		true => byte_at_or_missing(block, 1) == 3 and byte_at_or_missing(block, 2) == 80 and byte_at_or_missing(block, 3) == 85 and byte_at_or_missing(block, 4) == 84
		false => false
	end
end

fn decode_static_indexed_header_block(first_byte: Int, observed_size: Int, state: HpackFixtureState, block: ByteChunk, offset: Int) -> Result<HpackDecodeTransition, HpackFixtureFailure>
	match observed_size == 1
		false => unsupported(block, offset)
		true => match first_byte
			129 => decoded_static_indexed_authority(state)
			131 => decoded_static_indexed_method_post(state)
			143 => decoded_static_indexed_header("accept-charset", "", state)
			144 => decoded_static_indexed_header("accept-encoding", "gzip, deflate", state)
			145 => decoded_static_indexed_header("accept-language", "", state)
			153 => decoded_static_indexed_header("content-disposition", "", state)
			154 => decoded_static_indexed_header("content-encoding", "", state)
			155 => decoded_static_indexed_header("content-language", "", state)
			156 => decoded_static_indexed_header("content-length", "", state)
			157 => decoded_static_indexed_header("content-location", "", state)
			158 => decoded_static_indexed_header("content-range", "", state)
			159 => decoded_static_indexed_header("content-type", "", state)
			160 => decoded_static_indexed_header("cookie", "", state)
			161 => decoded_static_indexed_header("date", "", state)
			162 => decoded_static_indexed_header("etag", "", state)
			163 => decoded_static_indexed_header("expect", "", state)
			164 => decoded_static_indexed_header("from", "", state)
			165 => decoded_static_indexed_header("host", "", state)
			166 => decoded_static_indexed_header("if-match", "", state)
			167 => decoded_static_indexed_header("if-modified-since", "", state)
			168 => decoded_static_indexed_header("if-none-match", "", state)
			169 => decoded_static_indexed_header("if-range", "", state)
			170 => decoded_static_indexed_header("if-unmodified-since", "", state)
			171 => decoded_static_indexed_header("last-modified", "", state)
			172 => decoded_static_indexed_header("link", "", state)
			173 => decoded_static_indexed_header("location", "", state)
			174 => decoded_static_indexed_header("max-forwards", "", state)
			175 => decoded_static_indexed_header("proxy-authenticate", "", state)
			176 => decoded_static_indexed_header("proxy-authorization", "", state)
			177 => decoded_static_indexed_header("range", "", state)
			178 => decoded_static_indexed_header("referer", "", state)
			179 => decoded_static_indexed_header("refresh", "", state)
			180 => decoded_static_indexed_header("retry-after", "", state)
			181 => decoded_static_indexed_header("server", "", state)
			182 => decoded_static_indexed_header("set-cookie", "", state)
			183 => decoded_static_indexed_header("strict-transport-security", "", state)
			184 => decoded_static_indexed_header("transfer-encoding", "", state)
			185 => decoded_static_indexed_header("user-agent", "", state)
			186 => decoded_static_indexed_header("vary", "", state)
			187 => decoded_static_indexed_header("via", "", state)
			188 => decoded_static_indexed_header("www-authenticate", "", state)
			_ => unsupported(block, offset)
		end
	end
end

pub fn decode_header_block(block: ByteChunk, state: HpackFixtureState, offset: Int) -> Result<HpackDecodeTransition, HpackFixtureFailure>
	let observed_size: Int = byte_count_to_int(byte_chunk_count(block))
	let first_byte: Int = byte_at_or_missing(block, 0)
	match first_byte
		62 => match observed_size == 1
			true => decoded_table_size_update(state, 30)
			false => unsupported(block, offset)
		end
		63 => match observed_size == 1
			true => decoded_table_size_update(state, 31)
			false => decode_saturated_table_size_update(block, observed_size, state, offset)
		end
		4 => match is_literal_without_indexing_path_target(block, observed_size, first_byte)
			true => decoded_literal_without_indexing_path_target(state)
			false => match observed_size >= 2 and byte_at_or_missing(block, 1) >= 128 and observed_size == byte_at_or_missing(block, 1) - 128 + 2
				true => match decode_hpack_huffman_literal_value(block, byte_at_or_missing(block, 1) - 128, offset)
					Ok(value) => decoded_literal_without_indexing(literal_static_name(first_byte), value, hpack_huffman_decoded_wire_size(hpack_huffman_value_from_string(value), observed_size), state)
					Err(failure) => Err(failure)
				end
				false => unsupported(block, offset)
			end
		end
		17 => match observed_size == 8
			true => decoded("header-list-accepted", 8, state)
			false => match observed_size == 10
				true => decoded("header-list-too-large", 10, state)
				false => unsupported(block, offset)
			end
		end
		1 => match is_literal_without_indexing_authority_example(block, observed_size, first_byte)
			true => decoded_literal_without_indexing_authority_example(state)
			false => match observed_size >= 2 and byte_at_or_missing(block, 1) >= 128 and observed_size == byte_at_or_missing(block, 1) - 128 + 2
				true => match decode_hpack_huffman_literal_value(block, byte_at_or_missing(block, 1) - 128, offset)
					Ok(value) => decoded_literal_without_indexing(literal_static_name(first_byte), value, hpack_huffman_decoded_wire_size(hpack_huffman_value_from_string(value), observed_size), state)
					Err(failure) => Err(failure)
				end
				false => unsupported(block, offset)
			end
		end
		6 => match observed_size >= 2 and byte_at_or_missing(block, 1) >= 128 and observed_size == byte_at_or_missing(block, 1) - 128 + 2
			true => match decode_hpack_huffman_literal_value(block, byte_at_or_missing(block, 1) - 128, offset)
				Ok(value) => decoded_literal_without_indexing(literal_static_name(first_byte), value, hpack_huffman_decoded_wire_size(hpack_huffman_value_from_string(value), observed_size), state)
				Err(failure) => Err(failure)
			end
			false => unsupported(block, offset)
		end
		66 => match is_literal_with_indexing_method_put(block, observed_size, first_byte)
			true => decoded_literal_with_indexing_method_put(state)
			false => unsupported(block, offset)
		end
		68 => match is_literal_with_indexing_path_target(block, observed_size, first_byte)
			true => decoded_literal_with_indexing_path_target(state)
			false => unsupported(block, offset)
		end
		190 => match observed_size == 1
			true => decoded_dynamic_indexed_newest_header(state, block, offset)
			false => unsupported(block, offset)
		end
		191 => match observed_size == 1
			true => decoded_dynamic_indexed_older_header(state, block, offset)
			false => unsupported(block, offset)
		end
		16 => match observed_size == 3
			true => decoded("single-headers", 8, state)
			false => unsupported(block, offset)
		end
		170 => match observed_size == 9
			true => decoded("continuation", 9, state)
			false => decode_static_indexed_header_block(first_byte, observed_size, state, block, offset)
		end
		_ => decode_static_indexed_header_block(first_byte, observed_size, state, block, offset)
	end
end

pub fn transition_headers(transition: HpackDecodeTransition) -> HpackHeaderList
	match transition
		HpackDecodeTransition(headers, _) => headers
	end
end

pub fn transition_state(transition: HpackDecodeTransition) -> HpackFixtureState
	match transition
		HpackDecodeTransition(_, state) => state
	end
end

pub fn header_list_wire_size(headers: HpackHeaderList) -> Int
	match headers
		HpackHeaderList(_, _, wire_size) => wire_size
	end
end

pub fn header_list_first_name(headers: HpackHeaderList) -> String
	match headers
		HpackHeaderList(HpackHeader(name, _), _, _) => name
	end
end

pub fn header_list_first_value(headers: HpackHeaderList) -> String
	match headers
		HpackHeaderList(HpackHeader(_, value), _, _) => value
	end
end

pub fn state_decode_count(state: HpackFixtureState) -> Int
	match state
		HpackFixtureState(_, decode_count, _) => decode_count
	end
end

pub fn state_table_size(state: HpackFixtureState) -> Int
	match state
		HpackFixtureState(table_size, _, _) => table_size
	end
end

pub fn failure_offset(failure: HpackFixtureFailure) -> Int
	match failure
		UnsupportedHeaderBlock(offset, _, _, _, _, _) => offset
	end
end

pub fn failure_observed_size(failure: HpackFixtureFailure) -> Int
	match failure
		UnsupportedHeaderBlock(_, observed_size, _, _, _, _) => observed_size
	end
end

pub fn failure_observed_first_byte(failure: HpackFixtureFailure) -> Int
	match failure
		UnsupportedHeaderBlock(_, _, observed_first_byte, _, _, _) => observed_first_byte
	end
end

pub fn failure_expected_fixture(failure: HpackFixtureFailure) -> String
	match failure
		UnsupportedHeaderBlock(_, _, _, expected_fixture, _, _) => expected_fixture
	end
end

pub fn failure_codec_module(failure: HpackFixtureFailure) -> String
	match failure
		UnsupportedHeaderBlock(_, _, _, _, codec_module, _) => codec_module
	end
end

pub fn failure_preview(failure: HpackFixtureFailure) -> ByteChunk
	match failure
		UnsupportedHeaderBlock(_, _, _, _, _, preview) => preview
	end
end

pub fn project_failure(failure: HpackFixtureFailure) -> Result<(), String>
	let preview_chunk: ByteChunk = failure_preview(failure)
	let preview: ByteView = byte_view(preview_chunk, byte_offset(0)?, byte_chunk_count(preview_chunk))?
	hpack_fixture_unsupported_header_block(failure_offset(failure), failure_observed_size(failure), failure_observed_first_byte(failure), failure_expected_fixture(failure), failure_codec_module(failure), preview)
end
