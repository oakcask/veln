pub type HpackDynamicEntry
	NoDynamicEntry
	DynamicEntry(name: String, value: String, older: HpackDynamicEntry)
end

pub type HpackFixtureState
	HpackFixtureState(table_size: Int, decode_count: Int, dynamic_entry: HpackDynamicEntry)
end

pub type HpackHeader
	HpackHeader(name: String, value: String)
end

pub type HpackHeaderList
	HpackHeaderList(first: HpackHeader, second: HpackHeader, wire_size: Int)
end

pub type HpackDecodeTransition
	HpackDecodeTransition(headers: HpackHeaderList, state: HpackFixtureState)
end

pub type HpackFixtureFailure
	UnsupportedHeaderBlock(offset: Int, observed_size: Int, observed_first_byte: Int, expected_fixture: String, codec_module: String, preview: ByteChunk)
end

type HpackStringLiteral
	HpackStringLiteral(value: String, wire_size: Int)
end

type HpackStringLength
	HpackStringLength(huffman_marked: Bool, encoded_count: Int, prefix_size: Int)
end

type HpackIntegerPrefix
	HpackIntegerPrefix(value: Int, prefix_size: Int)
end

pub fn initial_state() -> HpackFixtureState
	HpackFixtureState(4096, 0, NoDynamicEntry)
end

fn byte_at(block: ByteChunk, index: Int) -> Result<Int, String>
	let view: ByteView = byte_view(block, byte_offset(index)?, byte_count(1)?)?
	byte_read_u8_be(view)
end

fn byte_at_or_missing(block: ByteChunk, index: Int) -> Int
	match byte_at(block, index)
		Ok(value) => value
		Err(_) => -1
	end
end

fn next_state(state: HpackFixtureState) -> HpackFixtureState
	match state
		HpackFixtureState(table_size, decode_count, dynamic_entry) => HpackFixtureState(table_size, decode_count + 1, dynamic_entry)
	end
end

fn dynamic_entry_size(name: String, value: String) -> Int
	string_byte_count(name) + string_byte_count(value) + 32
end

fn string_byte_count(value: String) -> Int
	match byte_chunk_from_visible_ascii_string(value)
		Ok(bytes) => byte_count_to_int(byte_chunk_count(bytes))
		Err(_) => 0
	end
end

fn bounded_dynamic_entry(table_size: Int, name: String, value: String, dynamic_entry: HpackDynamicEntry) -> HpackDynamicEntry
	let entry_size: Int = dynamic_entry_size(name, value)
	match entry_size > table_size
		true => NoDynamicEntry
		false => evict_for_table_size(table_size, DynamicEntry(name, value, dynamic_entry))
	end
end

fn evict_for_table_size(table_size: Int, dynamic_entry: HpackDynamicEntry) -> HpackDynamicEntry
	evict_for_remaining_table_size(table_size, dynamic_entry)
end

fn evict_for_remaining_table_size(remaining_table_size: Int, dynamic_entry: HpackDynamicEntry) -> HpackDynamicEntry
	match dynamic_entry
		NoDynamicEntry => NoDynamicEntry
		DynamicEntry(name, value, older) => match dynamic_entry_size(name, value) <= remaining_table_size
			true => DynamicEntry(name, value, evict_for_remaining_table_size(remaining_table_size - dynamic_entry_size(name, value), older))
			false => NoDynamicEntry
		end
	end
end

fn state_with_dynamic_entry(state: HpackFixtureState, name: String, value: String) -> HpackFixtureState
	match state
		HpackFixtureState(table_size, decode_count, dynamic_entry) => HpackFixtureState(table_size, decode_count + 1, bounded_dynamic_entry(table_size, name, value, dynamic_entry))
	end
end

fn state_with_table_size(state: HpackFixtureState, table_size: Int) -> HpackFixtureState
	match state
		HpackFixtureState(_, decode_count, dynamic_entry) => HpackFixtureState(table_size, decode_count + 1, evict_for_table_size(table_size, dynamic_entry))
	end
end

fn fixture_headers(label: String, wire_size: Int) -> HpackHeaderList
	HpackHeaderList(HpackHeader(":fixture", label), HpackHeader(":status", "ok"), wire_size)
end

fn static_indexed_method_get_headers() -> HpackHeaderList
	HpackHeaderList(HpackHeader(":method", "GET"), HpackHeader(":fixture", "static-indexed"), 8)
end

fn static_indexed_method_post_headers() -> HpackHeaderList
	HpackHeaderList(HpackHeader(":method", "POST"), HpackHeader(":fixture", "static-indexed"), 9)
end

fn static_indexed_path_root_headers() -> HpackHeaderList
	HpackHeaderList(HpackHeader(":path", "/"), HpackHeader(":fixture", "static-indexed"), 6)
end

fn static_indexed_two_headers(first: HpackHeader, second: HpackHeader, wire_size: Int) -> HpackHeaderList
	HpackHeaderList(first, second, wire_size)
end

fn static_indexed_header(name: String, value: String) -> HpackHeaderList
	HpackHeaderList(HpackHeader(name, value), HpackHeader(":fixture", "static-indexed"), 9)
end

fn static_indexed_authority_headers() -> HpackHeaderList
	HpackHeaderList(HpackHeader(":authority", ""), HpackHeader(":fixture", "static-indexed"), 1)
end

fn dynamic_indexed_header(name: String, value: String) -> HpackHeaderList
	HpackHeaderList(HpackHeader(name, value), HpackHeader(":fixture", "dynamic-indexed"), 9)
end

fn decoded(label: String, wire_size: Int, state: HpackFixtureState) -> Result<HpackDecodeTransition, HpackFixtureFailure>
	Ok(HpackDecodeTransition(fixture_headers(label, wire_size), next_state(state)))
end

fn decoded_static_indexed_method_post(state: HpackFixtureState) -> Result<HpackDecodeTransition, HpackFixtureFailure>
	Ok(HpackDecodeTransition(static_indexed_method_post_headers(), next_state(state)))
end

fn decoded_static_indexed_method_get(state: HpackFixtureState) -> Result<HpackDecodeTransition, HpackFixtureFailure>
	Ok(HpackDecodeTransition(static_indexed_method_get_headers(), next_state(state)))
end

fn decoded_static_indexed_path_root(state: HpackFixtureState) -> Result<HpackDecodeTransition, HpackFixtureFailure>
	Ok(HpackDecodeTransition(static_indexed_path_root_headers(), next_state(state)))
end

fn decoded_static_indexed_header(name: String, value: String, state: HpackFixtureState) -> Result<HpackDecodeTransition, HpackFixtureFailure>
	Ok(HpackDecodeTransition(static_indexed_header(name, value), next_state(state)))
end

fn decoded_static_indexed_two_headers(first: HpackHeader, second: HpackHeader, state: HpackFixtureState) -> Result<HpackDecodeTransition, HpackFixtureFailure>
	Ok(HpackDecodeTransition(static_indexed_two_headers(first, second, 2), next_state(state)))
end

fn decoded_static_indexed_authority(state: HpackFixtureState) -> Result<HpackDecodeTransition, HpackFixtureFailure>
	Ok(HpackDecodeTransition(static_indexed_authority_headers(), next_state(state)))
end

fn literal_without_indexing_headers(name: String, value: String, wire_size: Int) -> HpackHeaderList
	HpackHeaderList(HpackHeader(name, value), HpackHeader(":fixture", "literal-without-indexing"), wire_size)
end

fn literal_with_indexing_headers(name: String, value: String, wire_size: Int) -> HpackHeaderList
	HpackHeaderList(HpackHeader(name, value), HpackHeader(":fixture", "literal-with-indexing"), wire_size)
end

fn literal_never_indexed_headers(name: String, value: String, wire_size: Int) -> HpackHeaderList
	HpackHeaderList(HpackHeader(name, value), HpackHeader(":fixture", "literal-never-indexed"), wire_size)
end

fn decoded_literal_without_indexing(name: String, value: String, wire_size: Int, state: HpackFixtureState) -> Result<HpackDecodeTransition, HpackFixtureFailure>
	Ok(HpackDecodeTransition(literal_without_indexing_headers(name, value, wire_size), next_state(state)))
end

fn decoded_literal_with_indexing(name: String, value: String, wire_size: Int, state: HpackFixtureState) -> Result<HpackDecodeTransition, HpackFixtureFailure>
	Ok(HpackDecodeTransition(literal_with_indexing_headers(name, value, wire_size), state_with_dynamic_entry(state, name, value)))
end

fn decoded_literal_never_indexed(name: String, value: String, wire_size: Int, state: HpackFixtureState) -> Result<HpackDecodeTransition, HpackFixtureFailure>
	Ok(HpackDecodeTransition(literal_never_indexed_headers(name, value, wire_size), next_state(state)))
end

fn dynamic_entry_at(dynamic_entry: HpackDynamicEntry, table_index: Int) -> Option<HpackHeader>
	match dynamic_entry
		NoDynamicEntry => None
		DynamicEntry(name, value, older) => match table_index == 0
			true => Some(HpackHeader(name, value))
			false => dynamic_entry_at(older, table_index - 1)
		end
	end
end

fn decoded_dynamic_indexed_header_at(table_index: Int, state: HpackFixtureState, block: ByteChunk, offset: Int) -> Result<HpackDecodeTransition, HpackFixtureFailure>
	match state
		HpackFixtureState(_, _, dynamic_entry) => match dynamic_entry_at(dynamic_entry, table_index)
			Some(HpackHeader(name, value)) => Ok(HpackDecodeTransition(dynamic_indexed_header(name, value), next_state(state)))
			None => unsupported(block, offset)
		end
	end
end

fn dynamic_header_name_at(table_index: Int, state: HpackFixtureState) -> Option<String>
	match state
		HpackFixtureState(_, _, dynamic_entry) => match dynamic_entry_at(dynamic_entry, table_index)
			Some(HpackHeader(name, _)) => Some(name)
			None => None
		end
	end
end

fn decoded_table_size_update(state: HpackFixtureState, table_size: Int) -> Result<HpackDecodeTransition, HpackFixtureFailure>
	Ok(HpackDecodeTransition(fixture_headers("table-size-update", 0), state_with_table_size(state, table_size)))
end

fn low_seven_bits(byte: Int) -> Int
	byte - (byte / 128) * 128
end

fn decode_table_size_integer_tail_byte(current: Int, block: ByteChunk, observed_size: Int, index: Int, multiplier: Int, value: Int, state: HpackFixtureState, offset: Int) -> Result<HpackDecodeTransition, HpackFixtureFailure>
	let next_value: Int = value + low_seven_bits(current) * multiplier
	match current < 128
		true => match index + 1 == observed_size
			true => decoded_table_size_update(state, next_value)
			false => unsupported(block, offset)
		end
		false => decode_table_size_integer_tail(block, observed_size, index + 1, multiplier * 128, next_value, state, offset)
	end
end

fn decode_table_size_integer_tail(block: ByteChunk, observed_size: Int, index: Int, multiplier: Int, value: Int, state: HpackFixtureState, offset: Int) -> Result<HpackDecodeTransition, HpackFixtureFailure>
	match index < observed_size
		false => unsupported(block, offset)
		true => decode_table_size_integer_tail_byte(byte_at_or_missing(block, index), block, observed_size, index, multiplier, value, state, offset)
	end
end

fn decode_saturated_table_size_update(block: ByteChunk, observed_size: Int, state: HpackFixtureState, offset: Int) -> Result<HpackDecodeTransition, HpackFixtureFailure>
	decode_table_size_integer_tail(block, observed_size, 1, 1, 31, state, offset)
end

fn integer_prefix_value(prefix: HpackIntegerPrefix) -> Int
	match prefix
		HpackIntegerPrefix(value, _) => value
	end
end

fn integer_prefix_size(prefix: HpackIntegerPrefix) -> Int
	match prefix
		HpackIntegerPrefix(_, prefix_size) => prefix_size
	end
end

fn decode_dynamic_name_index_tail_byte(current: Int, block: ByteChunk, observed_size: Int, index: Int, multiplier: Int, value: Int, offset: Int) -> Result<HpackIntegerPrefix, HpackFixtureFailure>
	let next_value: Int = value + low_seven_bits(current) * multiplier
	match current < 128
		true => Ok(HpackIntegerPrefix(next_value, index + 1))
		false => decode_dynamic_name_index_tail(block, observed_size, index + 1, multiplier * 128, next_value, offset)
	end
end

fn decode_dynamic_name_index_tail(block: ByteChunk, observed_size: Int, index: Int, multiplier: Int, value: Int, offset: Int) -> Result<HpackIntegerPrefix, HpackFixtureFailure>
	match index < observed_size
		false => unsupported_integer_prefix(block, offset)
		true => decode_dynamic_name_index_tail_byte(byte_at_or_missing(block, index), block, observed_size, index, multiplier, value, offset)
	end
end

fn decode_dynamic_name_index(first_byte: Int, observed_size: Int, block: ByteChunk, offset: Int) -> Result<HpackIntegerPrefix, HpackFixtureFailure>
	match first_byte == 126
		true => Ok(HpackIntegerPrefix(62, 1))
		false => match first_byte == 127
			true => decode_dynamic_name_index_tail(block, observed_size, 1, 1, 63, offset)
			false => unsupported_integer_prefix(block, offset)
		end
	end
end

fn decode_four_bit_dynamic_name_index(first_byte: Int, prefix_base: Int, observed_size: Int, block: ByteChunk, offset: Int) -> Result<HpackIntegerPrefix, HpackFixtureFailure>
	match first_byte == prefix_base + 15
		true => decode_dynamic_name_index_tail(block, observed_size, 1, 1, 15, offset)
		false => unsupported_integer_prefix(block, offset)
	end
end

fn unsupported(block: ByteChunk, offset: Int) -> Result<HpackDecodeTransition, HpackFixtureFailure>
	Err(UnsupportedHeaderBlock(offset, byte_count_to_int(byte_chunk_count(block)), byte_at_or_missing(block, 0), "fixture header block", "hpack_fixture", block))
end

fn unsupported_string_literal(block: ByteChunk, offset: Int) -> Result<HpackStringLiteral, HpackFixtureFailure>
	Err(UnsupportedHeaderBlock(offset, byte_count_to_int(byte_chunk_count(block)), byte_at_or_missing(block, 0), "fixture header block", "hpack_fixture", block))
end

fn unsupported_string_length(block: ByteChunk, offset: Int) -> Result<HpackStringLength, HpackFixtureFailure>
	Err(UnsupportedHeaderBlock(offset, byte_count_to_int(byte_chunk_count(block)), byte_at_or_missing(block, 0), "fixture header block", "hpack_fixture", block))
end

fn unsupported_integer_prefix(block: ByteChunk, offset: Int) -> Result<HpackIntegerPrefix, HpackFixtureFailure>
	Err(UnsupportedHeaderBlock(offset, byte_count_to_int(byte_chunk_count(block)), byte_at_or_missing(block, 0), "fixture header block", "hpack_fixture", block))
end

fn unsupported_byte_chunk(block: ByteChunk, offset: Int) -> Result<ByteChunk, HpackFixtureFailure>
	Err(UnsupportedHeaderBlock(offset, byte_count_to_int(byte_chunk_count(block)), byte_at_or_missing(block, 0), "fixture header block", "hpack_fixture", block))
end

fn unsupported_raw_string_encoding(value: String, offset: Int) -> Result<ByteChunk, HpackFixtureFailure>
	let preview: ByteChunk = hpack_raw_string_unsupported_preview(value)
	Err(UnsupportedHeaderBlock(offset, byte_count_to_int(byte_chunk_count(preview)), byte_at_or_missing(preview, 0), "fixture raw string encoding", "hpack_fixture", preview))
end

fn hpack_raw_string_unsupported_preview(value: String) -> ByteChunk
	match value == "bad"
		true => match byte_chunk_from_hex("626164")
			Ok(preview) => preview
			Err(_) => byte_chunk([])
		end
		false => match value == "\n"
			true => match byte_chunk_from_hex("0a")
				Ok(preview) => preview
				Err(_) => byte_chunk([])
			end
			false => byte_chunk([])
		end
	end
end

pub fn hpack_fixture_long_raw_string_value() -> String
	"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
end

fn hpack_fixture_raw_string_value_bytes(value: String, offset: Int) -> Result<ByteChunk, HpackFixtureFailure>
	match byte_chunk_from_visible_ascii_string(value)
		Ok(bytes) => Ok(bytes)
		Err(_) => unsupported_raw_string_encoding(value, offset)
	end
end

fn hpack_fixture_raw_string_length_prefix(count: Int, value: String, offset: Int) -> Result<ByteChunk, HpackFixtureFailure>
	match count < 127
		true => hpack_fixture_raw_string_length_prefix_byte(count, value, offset)
		false => match hpack_fixture_raw_string_length_prefix_byte(127, value, offset)
			Ok(prefix) => match hpack_fixture_raw_string_length_tail(count - 127, value, offset)
				Ok(tail) => Ok(byte_append(prefix, tail))
				Err(failure) => Err(failure)
			end
			Err(failure) => Err(failure)
		end
	end
end

fn hpack_fixture_raw_string_length_tail(remaining: Int, value: String, offset: Int) -> Result<ByteChunk, HpackFixtureFailure>
	match remaining < 128
		true => hpack_fixture_raw_string_length_prefix_byte(remaining, value, offset)
		false => match hpack_fixture_raw_string_length_prefix_byte((remaining - (remaining / 128) * 128) + 128, value, offset)
			Ok(current) => match hpack_fixture_raw_string_length_tail(remaining / 128, value, offset)
				Ok(next) => Ok(byte_append(current, next))
				Err(failure) => Err(failure)
			end
			Err(failure) => Err(failure)
		end
	end
end

fn hpack_fixture_raw_string_length_prefix_byte(value_byte: Int, value: String, offset: Int) -> Result<ByteChunk, HpackFixtureFailure>
	match byte_write_u8_be(value_byte)
		Ok(prefix) => Ok(prefix)
		Err(_) => unsupported_raw_string_encoding(value, offset)
	end
end

pub fn encode_hpack_raw_string_literal(value: String, offset: Int) -> Result<ByteChunk, HpackFixtureFailure>
	match hpack_fixture_raw_string_value_bytes(value, offset)
		Ok(bytes) => match hpack_fixture_raw_string_length_prefix(byte_count_to_int(byte_chunk_count(bytes)), value, offset)
			Ok(prefix) => Ok(byte_append(prefix, bytes))
			Err(failure) => Err(failure)
		end
		Err(failure) => Err(failure)
	end
end

fn string_literal_value(literal: HpackStringLiteral) -> String
	match literal
		HpackStringLiteral(value, _) => value
	end
end

fn string_literal_wire_size(literal: HpackStringLiteral) -> Int
	match literal
		HpackStringLiteral(_, wire_size) => wire_size
	end
end

fn pow2(value: Int) -> Int
	match value
		0 => 1
		1 => 2
		2 => 4
		3 => 8
		4 => 16
		5 => 32
		6 => 64
		7 => 128
		_ => 256
	end
end

fn byte_bit(byte: Int, bit_index: Int) -> Int
	let divisor: Int = pow2(7 - bit_index)
	byte / divisor - (byte / (divisor * 2)) * 2
end

