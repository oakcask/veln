			182 => decoded_static_indexed_header("server", "", state)
			183 => decoded_static_indexed_header("set-cookie", "", state)
			184 => decoded_static_indexed_header("strict-transport-security", "", state)
			185 => decoded_static_indexed_header("transfer-encoding", "", state)
			186 => decoded_static_indexed_header("user-agent", "", state)
			187 => decoded_static_indexed_header("vary", "", state)
			188 => decoded_static_indexed_header("via", "", state)
			189 => decoded_static_indexed_header("www-authenticate", "", state)
			_ => unsupported(block, offset)
			end
		end
	end
end

pub fn decode_header_block(block: ByteChunk, state: HpackFixtureState, offset: Int) -> Result<HpackDecodeTransition, HpackFixtureFailure>
	let observed_size: Int = byte_count_to_int(byte_chunk_count(block))
	let first_byte: Int = byte_at_or_missing(block, 0)
	match first_byte
		62 => match observed_size == 1
			true => decoded_table_size_update(state, 30)
			false => unsupported(block, offset)
		end
		63 => match observed_size == 1
			true => decoded_table_size_update(state, 31)
			false => decode_saturated_table_size_update(block, observed_size, state, offset)
		end
		4 => decode_literal_without_indexing_header_block(first_byte, observed_size, state, block, offset)
		15 => decode_literal_without_indexing_dynamic_name_header_block(first_byte, observed_size, state, block, offset)
		17 => match observed_size == 8 and byte_at_or_missing(block, 1) == 2
			true => decoded("header-list-accepted", 8, state)
			false => decode_literal_never_indexed_header_block(first_byte, observed_size, state, block, offset)
		end
		1 => decode_literal_without_indexing_header_block(first_byte, observed_size, state, block, offset)
		6 => decode_literal_without_indexing_header_block(first_byte, observed_size, state, block, offset)
		2 => decode_literal_without_indexing_header_block(first_byte, observed_size, state, block, offset)
		8 => decode_literal_without_indexing_header_block(first_byte, observed_size, state, block, offset)
		18 => decode_literal_never_indexed_header_block(first_byte, observed_size, state, block, offset)
		20 => decode_literal_never_indexed_header_block(first_byte, observed_size, state, block, offset)
		22 => decode_literal_never_indexed_header_block(first_byte, observed_size, state, block, offset)
		24 => decode_literal_never_indexed_header_block(first_byte, observed_size, state, block, offset)
		31 => decode_literal_never_indexed_dynamic_name_header_block(first_byte, observed_size, state, block, offset)
		65 => decode_literal_with_indexing_header_block(first_byte, observed_size, state, block, offset)
		66 => decode_literal_with_indexing_header_block(first_byte, observed_size, state, block, offset)
		68 => decode_literal_with_indexing_header_block(first_byte, observed_size, state, block, offset)
		70 => decode_literal_with_indexing_header_block(first_byte, observed_size, state, block, offset)
		72 => decode_literal_with_indexing_header_block(first_byte, observed_size, state, block, offset)
		126 => decode_literal_with_dynamic_name_indexing_header_block(first_byte, observed_size, state, block, offset)
		127 => decode_literal_with_dynamic_name_indexing_header_block(first_byte, observed_size, state, block, offset)
		16 => match observed_size == 3
			true => decoded("single-headers", 8, state)
			false => unsupported(block, offset)
		end
		170 => match observed_size == 9
			true => decoded("continuation", 9, state)
			false => decode_static_indexed_header_block(first_byte, observed_size, state, block, offset)
		end
		_ => match first_byte >= 190
			true => match observed_size == 1
				true => decoded_dynamic_indexed_header_at(first_byte - 190, state, block, offset)
				false => unsupported(block, offset)
			end
			false => decode_static_indexed_header_block(first_byte, observed_size, state, block, offset)
		end
	end
end

pub fn transition_headers(transition: HpackDecodeTransition) -> HpackHeaderList
	match transition
		HpackDecodeTransition(headers, _) => headers
	end
end

pub fn transition_state(transition: HpackDecodeTransition) -> HpackFixtureState
	match transition
		HpackDecodeTransition(_, state) => state
	end
end

pub fn header_list_wire_size(headers: HpackHeaderList) -> Int
	match headers
		HpackHeaderList(_, _, wire_size) => wire_size
	end
end

pub fn header_list_first_name(headers: HpackHeaderList) -> String
	match headers
		HpackHeaderList(HpackHeader(name, _), _, _) => name
	end
end

pub fn header_list_first_value(headers: HpackHeaderList) -> String
	match headers
		HpackHeaderList(HpackHeader(_, value), _, _) => value
	end
end

pub fn header_list_second_name(headers: HpackHeaderList) -> String
	match headers
		HpackHeaderList(_, HpackHeader(name, _), _) => name
	end
end

pub fn header_list_second_value(headers: HpackHeaderList) -> String
	match headers
		HpackHeaderList(_, HpackHeader(_, value), _) => value
	end
end

pub fn state_decode_count(state: HpackFixtureState) -> Int
	match state
		HpackFixtureState(_, decode_count, _) => decode_count
	end
end

pub fn state_table_size(state: HpackFixtureState) -> Int
	match state
		HpackFixtureState(table_size, _, _) => table_size
	end
end

pub fn failure_offset(failure: HpackFixtureFailure) -> Int
	match failure
		UnsupportedHeaderBlock(offset, _, _, _, _, _) => offset
	end
end

pub fn failure_observed_size(failure: HpackFixtureFailure) -> Int
	match failure
		UnsupportedHeaderBlock(_, observed_size, _, _, _, _) => observed_size
	end
end

pub fn failure_observed_first_byte(failure: HpackFixtureFailure) -> Int
	match failure
		UnsupportedHeaderBlock(_, _, observed_first_byte, _, _, _) => observed_first_byte
	end
end

pub fn failure_expected_fixture(failure: HpackFixtureFailure) -> String
	match failure
		UnsupportedHeaderBlock(_, _, _, expected_fixture, _, _) => expected_fixture
	end
end

pub fn failure_codec_module(failure: HpackFixtureFailure) -> String
	match failure
		UnsupportedHeaderBlock(_, _, _, _, codec_module, _) => codec_module
	end
end

pub fn failure_preview(failure: HpackFixtureFailure) -> ByteChunk
	match failure
		UnsupportedHeaderBlock(_, _, _, _, _, preview) => preview
	end
end

pub fn project_failure(failure: HpackFixtureFailure) -> Result<(), String>
	let preview_chunk: ByteChunk = failure_preview(failure)
	let preview: ByteView = byte_view(preview_chunk, byte_offset(0)?, byte_chunk_count(preview_chunk))?
	hpack_fixture_unsupported_header_block(failure_offset(failure), failure_observed_size(failure), failure_observed_first_byte(failure), failure_expected_fixture(failure), failure_codec_module(failure), preview)
end
