# Binary schema anonymous record fields decode sibling nested anonymous records.
use stdio

schema SiblingNestedAnonymousRecordPacket
	format binary

	prefix: UInt8
	header: {kind: UInt8, left: {code: UInt16be, tail: UInt16le}, right: {channel: UInt8, value: UInt24be}, marker: UInt8}
	suffix: UInt8
end

fn explicit_right_value(step: DecodeStep<{prefix: Int, header: {kind: Int, left: {code: Int, tail: Int}, right: {channel: Int, value: Int}, marker: Int}, suffix: Int}>) -> Int
	match step
		Decoded(packet, _) => packet.header.right.value
		NeedMore(_) => -1
		Invalid(_) => -1
	end
end

fn explicit_consumed(step: DecodeStep<{prefix: Int, header: {kind: Int, left: {code: Int, tail: Int}, right: {channel: Int, value: Int}, marker: Int}, suffix: Int}>) -> Int
	match step
		Decoded(_, consumed) => byte_count_to_int(consumed)
		NeedMore(_) => 0
		Invalid(_) => 0
	end
end

pub fn main() -> Result<(), String> effects [stdio]
	let bytes: ByteChunk = byte_chunk_from_hex("0a0102030405060708090bff")?
	let view: ByteView = byte_view(bytes, byte_offset(0)?, byte_count(12)?)?
	let packet: {prefix: Int, header: {kind: Int, left: {code: Int, tail: Int}, right: {channel: Int, value: Int}, marker: Int}, suffix: Int} = byte_decode_sibling_nested_anonymous_record_packet(view)?
	stdio::print("helper ")
	stdio::print(int_to_string(packet.prefix))
	stdio::print(" ")
	stdio::print(int_to_string(packet.header.kind))
	stdio::print(" ")
	stdio::print(int_to_string(packet.header.left.code))
	stdio::print(" ")
	stdio::print(int_to_string(packet.header.left.tail))
	stdio::print(" ")
	stdio::print(int_to_string(packet.header.right.channel))
	stdio::print(" ")
	stdio::print(int_to_string(packet.header.right.value))
	stdio::print(" ")
	stdio::print(int_to_string(packet.header.marker))
	stdio::print(" ")
	stdio::println(int_to_string(packet.suffix))

	let step: DecodeStep<{prefix: Int, header: {kind: Int, left: {code: Int, tail: Int}, right: {channel: Int, value: Int}, marker: Int}, suffix: Int}> = decode SiblingNestedAnonymousRecordPacket from view at byte_offset(17)?
	stdio::print("explicit ")
	stdio::print(int_to_string(explicit_right_value(step)))
	stdio::print(" ")
	stdio::println(int_to_string(explicit_consumed(step)))
	Ok(())
end
