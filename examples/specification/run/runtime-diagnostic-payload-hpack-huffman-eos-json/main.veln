# RuntimeDiagnostic values can project HPACK Huffman EOS payloads.
fn invalid_payload(error: String) -> RuntimeDiagnostic
	RuntimeDiagnostic(
		"hpack.fixture.huffman_eos_symbol",
		error,
		RuntimeHpackFixtureDiagnostic(9, 0, -1, "fixture HPACK Huffman data symbol instead of EOS", "hpack_fixture", byte_chunk([]))
	)
end

fn preview_block() -> Result<ByteChunk, RuntimeDiagnostic>
	match byte_chunk_from_hex("0484ffffffff")
		Ok(block) => Ok(block)
		Err(error) => Err(invalid_payload(error))
	end
end

pub fn main() -> Result<(), RuntimeDiagnostic>
	let block: ByteChunk = preview_block()?
	Err(RuntimeDiagnostic(
		"hpack.fixture.huffman_eos_symbol",
		"HPACK Huffman EOS used as decoded symbol at byte offset 9",
		RuntimeHpackFixtureDiagnostic(9, 6, 4, "fixture HPACK Huffman data symbol instead of EOS", "hpack_fixture", block)
	))
end
