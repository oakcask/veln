# Binary schema closed dispatch decodes the selected payload case.
use stdio

schema ClosedDispatchPacket
	format binary

	kind: UInt8
	payload: Dispatch(kind, 1 => uint16be, 2 => uint32be, 3 => uint24le, 4 => uint32le, 5 => uint16le)
end

fn emit_packet(packet: {kind: Int, payload: Int}) -> () effects [stdio]
	stdio::print(int_to_string(packet.kind))
	stdio::print(" ")
	stdio::println(int_to_string(packet.payload))
end

pub fn main() -> Result<(), String> effects [stdio]
	let bytes: ByteChunk = byte_chunk_from_hex("03563412")?
	let offset: ByteOffset = byte_offset(0)?
	let count: ByteCount = byte_count(4)?
	let view: ByteView = byte_view(bytes, offset, count)?
	let packet: {kind: Int, payload: Int} = byte_decode_closed_dispatch_packet(view)?
	emit_packet(packet)

	let wide_bytes: ByteChunk = byte_chunk_from_hex("04efbeadde")?
	let wide_count: ByteCount = byte_count(5)?
	let wide_view: ByteView = byte_view(wide_bytes, offset, wide_count)?
	let wide_packet: {kind: Int, payload: Int} = byte_decode_closed_dispatch_packet(wide_view)?
	emit_packet(wide_packet)

	let flag_bytes: ByteChunk = byte_chunk_from_hex("050201")?
	let flag_count: ByteCount = byte_count(3)?
	let flag_view: ByteView = byte_view(flag_bytes, offset, flag_count)?
	let flag_packet: {kind: Int, payload: Int} = byte_decode_closed_dispatch_packet(flag_view)?
	emit_packet(flag_packet)
	Ok(())
end
