use fixture_effects
use fake_effects
use http2::connection from "std"
use http2::core from "std"
use net from "std"
use stdio

fn handler(event: Http2ApplicationEvent) -> Result<List<Http2ApplicationAction>, String>
	let _ = http2::core::application_event_stream_id(event)
	Err("callback rejected request")
end

fn print_result(result: Result<(), Http2ServiceFailure>) -> Result<(), String> effects [stdio]
	match result
		Ok(_) => print_ok()
		Err(failure) => print_failure(failure)
	end
end

fn print_ok() -> Result<(), String> effects [stdio]
	stdio::println("ok")
	Ok(())
end

fn print_failure(failure: Http2ServiceFailure) -> Result<(), String> effects [stdio]
	stdio::print(http2::connection::service_failure_kind(failure))
	stdio::print(" ")
	stdio::print(http2::connection::service_failure_id(failure))
	stdio::print(" accepted ")
	stdio::print(int_to_string(http2::connection::service_failure_accepted(failure)))
	stdio::print(" reason ")
	stdio::println(http2::connection::service_failure_reason(failure))
	Ok(())
end

fn fixture_body(resources: { listener : net::Listener }) -> Result<(), String> effects [net::IO, concurrency, stdio]
	print_result(http2::connection::serve_tcp(resources.listener, handler))
end

fn fixture_with_resources() -> Result<(), String> effects [net::IO, concurrency, stdio]
	match fixture_effects::resources()
		Ok(resources) => fixture_body(resources)
		Err(_) => Err("missing resources")
	end
end

pub fn main() -> Result<(), String> effects [concurrency, fs, net, time, stdio]
	let state = fixture_effects::create_fixture()
	handle handle fixture_with_resources() with net::system() with fake_effects::network(state)
end
