# Binary schema mapping arithmetic can use same-module Int converter operands.
use stdio

type Packet
	Packet {sum: Int, difference: Int, product: Int, quotient: Int}
end

fn add_one(value: Int) -> Int
	value + 1
end

fn record_value(input: {value: Int}) -> Int
	input.value
end

schema PacketWire
	format binary

	length: UInt8
	padding: UInt8
	factor: UInt8
	divisor: UInt8

	map to Packet
		sum = add_one(length) + padding
		difference = add_one(length) - 3
		product = record_value({value: padding}) * factor
		quotient = add_one(length) / divisor
end

pub fn main() -> Result<(), String> effects [stdio]
	let bytes: ByteChunk = byte_chunk_from_hex("0c020302")?
	let offset: ByteOffset = byte_offset(0)?
	let count: ByteCount = byte_count(4)?
	let view: ByteView = byte_view(bytes, offset, count)?
	let packet: {sum: Int, difference: Int, product: Int, quotient: Int} = byte_decode_packet_wire(view)?
	stdio::println(int_to_string(packet.sum))
	stdio::println(int_to_string(packet.difference))
	stdio::println(int_to_string(packet.product))
	stdio::println(int_to_string(packet.quotient))
	Ok(())
end
