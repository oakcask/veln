# Channel-first stream routing can select thirty receiver-list routes before handling.
use stdio

type ResponseAction
	SendBytes {stream_id: Int, bytes: ByteChunk}
	EndStream {stream_id: Int}
	Decline {stream_id: Int}
end

fn handle_stream_input(stream_id: Int, input: StreamInput, state: { chunks : Int, ended : Bool }) -> { actions : List<ResponseAction>, next_state : { chunks : Int, ended : Bool } }
	match input
		Chunk(bytes) => { actions: list_cons(SendBytes(stream_id, bytes), list_nil()), next_state: { chunks: state.chunks + 1, ended: state.ended } }
		End => { actions: list_cons(EndStream(stream_id), list_nil()), next_state: { chunks: state.chunks, ended: true } }
	end
end

fn append_actions(left: List<ResponseAction>, right: List<ResponseAction>) -> List<ResponseAction>
	match left
		Nil => right
		Cons(action, tail) => list_cons(action, append_actions(tail, right))
	end
end

fn action_stream_score(actions: List<ResponseAction>) -> Int
	match actions
		Nil => 0
		Cons(action, tail) => match action
			SendBytes(stream_id, _) => stream_id * 10 + action_stream_score(tail)
			EndStream(stream_id) => stream_id * 10 + action_stream_score(tail)
			Decline(stream_id) => stream_id * 10 + action_stream_score(tail)
		end
	end
end

fn payload_byte_count(actions: List<ResponseAction>) -> Int
	match actions
		Nil => 0
		Cons(action, tail) => match action
			SendBytes(_, bytes) => byte_count_to_int(byte_chunk_count(bytes)) + payload_byte_count(tail)
			EndStream(_) => payload_byte_count(tail)
			Decline(_) => payload_byte_count(tail)
		end
	end
end

fn write_count(actions: List<ResponseAction>) -> Int
	match actions
		Nil => 0
		Cons(action, tail) => match action
			SendBytes(_, _) => 1 + write_count(tail)
			EndStream(_) => write_count(tail)
			Decline(_) => write_count(tail)
		end
	end
end

fn bool_text(value: Bool) -> String
	match value
		true => "true"
		false => "false"
	end
end

fn handled_route(index: Int, input: StreamInput, state: { chunks : Int, ended : Bool }) -> { actions : List<ResponseAction>, next_state : { chunks : Int, ended : Bool } }
	match index
		0 => handle_stream_input(1, input, state)
		1 => handle_stream_input(3, input, state)
		2 => handle_stream_input(5, input, state)
		3 => handle_stream_input(7, input, state)
		4 => handle_stream_input(9, input, state)
		5 => handle_stream_input(11, input, state)
		6 => handle_stream_input(13, input, state)
		7 => handle_stream_input(15, input, state)
		8 => handle_stream_input(17, input, state)
		9 => handle_stream_input(19, input, state)
		10 => handle_stream_input(21, input, state)
		11 => handle_stream_input(23, input, state)
		12 => handle_stream_input(25, input, state)
		13 => handle_stream_input(27, input, state)
		14 => handle_stream_input(29, input, state)
		15 => handle_stream_input(31, input, state)
		16 => handle_stream_input(33, input, state)
		17 => handle_stream_input(35, input, state)
		18 => handle_stream_input(37, input, state)
		19 => handle_stream_input(39, input, state)
		20 => handle_stream_input(41, input, state)
		21 => handle_stream_input(43, input, state)
		22 => handle_stream_input(45, input, state)
		23 => handle_stream_input(47, input, state)
		24 => handle_stream_input(49, input, state)
		25 => handle_stream_input(51, input, state)
		26 => handle_stream_input(53, input, state)
		27 => handle_stream_input(55, input, state)
		28 => handle_stream_input(57, input, state)
		_ => handle_stream_input(59, input, state)
	end
end

fn select_ready(receivers: List<Receiver<StreamInput>>) -> { index : Int, value : StreamInput } effects [concurrency]
	match channel::select_many_priority(receivers)
		Some(selected) => selected
		None => { index: 0, value: End }
	end
end

