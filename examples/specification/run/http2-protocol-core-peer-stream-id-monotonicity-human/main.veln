# A lower idle peer-created stream id projects focused human context.

fn invalid_payload(error: String) -> RuntimeDiagnostic
	RuntimeDiagnostic(
		"http2.protocol.peer_stream_id_not_increasing",
		error,
		RuntimeHttp2ProtocolPeerStreamIdNotIncreasingDiagnostic(9, 3, 5, "server", "idle-stream", "rfc9113_peer_stream_ids_increase", byte_chunk([]))
	)
end

fn frame_header() -> Result<ByteChunk, RuntimeDiagnostic>
	match byte_chunk_from_hex("000000010400000003")
		Ok(bytes) => Ok(bytes)
		Err(error) => Err(invalid_payload(error))
	end
end

pub fn main() -> Result<(), RuntimeDiagnostic>
	let preview: ByteChunk = frame_header()?
	Err(RuntimeDiagnostic(
		"http2.protocol.peer_stream_id_not_increasing",
		"HTTP/2 peer-created stream id 3 is not greater than previous id 5 at byte offset 9",
		RuntimeHttp2ProtocolPeerStreamIdNotIncreasingDiagnostic(9, 3, 5, "server", "idle-stream", "rfc9113_peer_stream_ids_increase", preview)
	))
end
