# HTTP/2 peer-limit failures project to human runtime diagnostics.

type Http2ProtocolFailure
	FrameSizeExceeded({offset: Int, observed_length: Int, allowed_length: Int, frame_kind: Int, stream_id: Int})
end

type Http2DiagnosticContext
	DiagnosticContext(String)
end

fn context_receive_limit_provenance(context: Http2DiagnosticContext) -> String
	match context
		DiagnosticContext(receive_limit_provenance) => receive_limit_provenance
	end
end

fn http2_protocol_diagnostic(failure: Http2ProtocolFailure, context: Http2DiagnosticContext) -> Result<(), String>
	match failure
		FrameSizeExceeded(payload) => http2_peer_limit_frame_size_exceeded(payload.offset, payload.observed_length, payload.allowed_length, payload.frame_kind, payload.stream_id, context_receive_limit_provenance(context))
	end
end

pub fn main() -> Result<(), String>
	let context: Http2DiagnosticContext = DiagnosticContext("local_configuration")
	http2_protocol_diagnostic(FrameSizeExceeded({offset: 0, observed_length: 1025, allowed_length: 1024, frame_kind: 0, stream_id: 3}), context)
end
