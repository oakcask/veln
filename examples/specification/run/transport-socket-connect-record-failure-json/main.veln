use net from "std"
use fixture_effects
use fake_effects

# A connected stream keeps its endpoint and identity facts when event recording fails.
fn fixture_body() -> Result<(), net::NetError> effects [net::IO]
	let stream: net::Stream = net::connect(net::Address(net::Tcp4, "127.0.0.1", 443))?
	let _ = net::close_stream(stream)?
	Ok(())
end

pub fn main() -> Result<(), net::NetError> effects [concurrency, fs, net, time]
	let state = fixture_effects::create_fixture()
	handle handle handle fixture_body() with net::system() with fake_effects::network(state) with fake_effects::clock(state)
end
