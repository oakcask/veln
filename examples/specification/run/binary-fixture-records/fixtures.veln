use stdio

fn valid_preface() -> Result<{ name : String, bytes : ByteChunk, expected_hex : String, expected_consumed : Option<ByteCount> }, String>
	let bytes: ByteChunk = byte_chunk([byte(0)?, byte(1)?, byte(255)?])
	let consumed: ByteCount = byte_count(3)?
	Ok({ name: "valid-preface", bytes: bytes, expected_hex: "0001ff", expected_consumed: Some(consumed) })
end

fn valid_window_update() -> Result<{ name : String, bytes : ByteChunk, expected_hex : String, expected_consumed : Option<ByteCount> }, String>
	let bytes: ByteChunk = byte_chunk_from_hex("00040000000f000001")?
	Ok({ name: "valid-window-update", bytes: bytes, expected_hex: "00040000000f000001", expected_consumed: None })
end

fn bad_separator() -> { name : String, source : String, expected_error : String }
	{ name: "bad-separator", source: "00_01", expected_error: "fixture.hex.invalid_character: expected ASCII hex digit at byte offset 1 high nibble" }
end

fn emit_consumed(consumed: Option<ByteCount>) -> () effects [stdio]
	match consumed
		Some(count) => stdio::print(int_to_string(byte_count_to_int(count)))
		None => stdio::print("none")
	end
end

fn emit_valid_fixture(fixture: { name : String, bytes : ByteChunk, expected_hex : String, expected_consumed : Option<ByteCount> }) -> () effects [stdio]
	stdio::print("fixture ")
	stdio::print(fixture.name)
	stdio::print(" hex ")
	stdio::print(fixture.expected_hex)
	stdio::print(" count ")
	stdio::print(int_to_string(byte_count_to_int(byte_chunk_count(fixture.bytes))))
	stdio::print(" consumed ")
	emit_consumed(fixture.expected_consumed)
	stdio::println("")
end

fn emit_invalid_fixture(fixture: { name : String, source : String, expected_error : String }) -> () effects [stdio]
	let actual: String = match byte_chunk_from_hex(fixture.source)
		Ok(_) => "unexpected_ok"
		Err(error) => error
	end
	let checked: String = if actual == fixture.expected_error
		actual
	else
		"unexpected_error"
	end
	stdio::print("fixture ")
	stdio::print(fixture.name)
	stdio::print(" error ")
	stdio::println(checked)
end

fn emit_output_chunk(list_name: String, index: Int, chunk: ByteChunk, expected_hex: String) -> () effects [stdio]
	stdio::print("output_chunk ")
	stdio::print(list_name)
	stdio::print(" index ")
	stdio::print(int_to_string(index))
	stdio::print(" hex \"")
	stdio::print(expected_hex)
	stdio::print("\" count ")
	stdio::println(int_to_string(byte_count_to_int(byte_chunk_count(chunk))))
end

fn emit_output_chunk_list_header(name: String, count: Int) -> () effects [stdio]
	stdio::print("output_chunk_list ")
	stdio::print(name)
	stdio::print(" count ")
	stdio::println(int_to_string(count))
end

fn emit_output_chunk_lists() -> Result<(), String> effects [stdio]
	let first: ByteChunk = byte_chunk_from_hex("0001ff")?
	let second: ByteChunk = byte_chunk_from_hex("00040000000f000001")?
	emit_output_chunk_list_header("protocol-output", 2)
	emit_output_chunk("protocol-output", 0, first, "0001ff")
	emit_output_chunk("protocol-output", 1, second, "00040000000f000001")
	let empty: ByteChunk = byte_chunk([])
	emit_output_chunk_list_header("empty-chunk", 1)
	emit_output_chunk("empty-chunk", 0, empty, "")
	emit_output_chunk_list_header("no-output", 0)
	Ok(())
end

pub fn emit_binary_fixtures() -> Result<(), String> effects [stdio]
	emit_valid_fixture(valid_preface()?)
	emit_valid_fixture(valid_window_update()?)
	emit_invalid_fixture(bad_separator())
	let ignored: () = emit_output_chunk_lists()?
	Ok(())
end
