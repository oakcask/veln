# Cancellation cleanup closes the adapter-owned stream without failing.
use stdio

type ResponseAction
	SendBytes(bytes: ByteChunk)
	EndStream
	RetryAfterDeadline
	CleanupAfterCancel
end

fn handle_stream_input(input: StreamInput, state: { chunks : Int, ended : Bool }) -> { actions : List<ResponseAction>, next_state : { chunks : Int, ended : Bool } }
	match input
		Chunk(bytes) => { actions: list_cons(SendBytes(bytes), list_nil()), next_state: { chunks: state.chunks + 1, ended: state.ended } }
		End => { actions: list_cons(EndStream, list_nil()), next_state: { chunks: state.chunks, ended: true } }
	end
end

fn prepend_wait_action(outcome: CancellableWaitOutcome, handled: { actions : List<ResponseAction>, next_state : { chunks : Int, ended : Bool } }) -> { outcome : String, actions : List<ResponseAction>, next_state : { chunks : Int, ended : Bool } }
	match outcome
		WaitCompleted => { outcome: "completed", actions: handled.actions, next_state: handled.next_state }
		WaitDeadlineExpired => { outcome: "deadline-expired", actions: list_cons(RetryAfterDeadline, handled.actions), next_state: handled.next_state }
		WaitCancelled => { outcome: "cancelled", actions: list_cons(CleanupAfterCancel, handled.actions), next_state: handled.next_state }
	end
end

fn action_count(actions: List<ResponseAction>) -> Int
	match actions
		Nil => 0
		Cons(_, tail) => 1 + action_count(tail)
	end
end

fn write_count(actions: List<ResponseAction>) -> Int
	match actions
		Nil => 0
		Cons(action, tail) => match action
			SendBytes(_) => 1 + write_count(tail)
			EndStream => write_count(tail)
			RetryAfterDeadline => write_count(tail)
			CleanupAfterCancel => write_count(tail)
		end
	end
end

fn cleanup_count(actions: List<ResponseAction>) -> Int
	match actions
		Nil => 0
		Cons(action, tail) => match action
			SendBytes(_) => cleanup_count(tail)
			EndStream => cleanup_count(tail)
			RetryAfterDeadline => cleanup_count(tail)
			CleanupAfterCancel => 1 + cleanup_count(tail)
		end
	end
end

fn route_input(route: { tx : Sender<StreamInput>, rx : Receiver<StreamInput> }, input: StreamInput) -> StreamInput effects [concurrency]
	let _ = channel::send(route.tx, input)
	match channel::recv(route.rx)
		Some(value) => value
		None => End
	end
end

fn collect_cancellable_actions(stream: NetStream, state: { chunks : Int, ended : Bool }, deadline: Deadline, token: CancelToken) -> { outcome : String, actions : List<ResponseAction>, next_state : { chunks : Int, ended : Bool } } effects [net, time, concurrency]
	let route = channel::bounded<StreamInput>(1)
	let input = route_input(route, Chunk(net::read_chunk(stream)))
	let handled = handle_stream_input(input, state)
	prepend_wait_action(time::wait_until_cancellable_outcome(deadline, token), handled)
end

fn apply_response_actions(stream: NetStream, actions: List<ResponseAction>) -> () effects [net]
	match actions
		Nil => ()
		Cons(action, tail) => match action
			SendBytes(bytes) => write_then_apply(stream, bytes, tail)
			EndStream => apply_response_actions(stream, tail)
			RetryAfterDeadline => apply_response_actions(stream, tail)
			CleanupAfterCancel => apply_response_actions(stream, tail)
		end
	end
end

fn write_then_apply(stream: NetStream, bytes: ByteChunk, tail: List<ResponseAction>) -> () effects [net]
	net::write_chunk(stream, bytes)
	apply_response_actions(stream, tail)
end

fn close_after_apply(stream: NetStream, actions: List<ResponseAction>) -> () effects [net]
	apply_response_actions(stream, actions)
	net::close_stream(stream)
end

fn accepted_cancellable_lifecycle(stream: NetStream, deadline: Deadline, token: CancelToken) -> Result<{ outcome : String, actions : List<ResponseAction>, next_state : { chunks : Int, ended : Bool } }, String> effects [net, time, concurrency]
	let routed = collect_cancellable_actions(stream, { chunks: 0, ended: false }, deadline, token)
	close_after_apply(stream, routed.actions)
	Ok(routed)
end

fn lifecycle_result(address: String) -> Result<{ outcome : String, actions : List<ResponseAction>, next_state : { chunks : Int, ended : Bool } }, String> effects [net, time, concurrency]
	let listener: NetListener = net::listen(address)
	let stream: NetStream = net::accept(listener)
	let deadline: Deadline = time::deadline_after_ms(100)
	let token: CancelToken = time::cancel_token()
	accepted_cancellable_lifecycle(stream, deadline, token)
end

fn bool_text(value: Bool) -> String
	if value
		"true"
	else
		"false"
	end
end

pub fn main() -> Result<(), String> effects [net, time, concurrency, stdio]
	let routed: { outcome : String, actions : List<ResponseAction>, next_state : { chunks : Int, ended : Bool } } = lifecycle_result("127.0.0.1:0")?
	stdio::print(routed.outcome)
	stdio::print(" actions ")
	stdio::print(int_to_string(action_count(routed.actions)))
	stdio::print(" chunks ")
	stdio::print(int_to_string(routed.next_state.chunks))
	stdio::print(" ended ")
	stdio::print(bool_text(routed.next_state.ended))
	stdio::print(" writes ")
	stdio::print(int_to_string(write_count(routed.actions)))
	stdio::print(" cleanup ")
	stdio::println(int_to_string(cleanup_count(routed.actions)))
	Ok(())
end
