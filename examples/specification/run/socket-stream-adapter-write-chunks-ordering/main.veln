use net from "std"
use fixture_effects
use fake_effects
# Adapter-owned ordering combines ordinary handler actions before chunk-list writes.
use stdio

type ResponseAction
	SendBytes(bytes: ByteChunk)
	HandlerMarker(name: String)
	EndStream
end

fn body_handler(input: StreamInput, state: { body_chunks : Int, trailer_chunks : Int, ended : Bool }) -> { actions : List<ResponseAction>, next_state : { body_chunks : Int, trailer_chunks : Int, ended : Bool } }
	match input
		Chunk(bytes) => { actions: list_cons(SendBytes(bytes), list_nil()), next_state: { body_chunks: state.body_chunks + 1, trailer_chunks: state.trailer_chunks, ended: state.ended } }
		End => { actions: list_cons(EndStream, list_nil()), next_state: { body_chunks: state.body_chunks, trailer_chunks: state.trailer_chunks, ended: true } }
	end
end

fn trailer_handler(input: StreamInput, trailer: ByteChunk, state: { body_chunks : Int, trailer_chunks : Int, ended : Bool }) -> { actions : List<ResponseAction>, next_state : { body_chunks : Int, trailer_chunks : Int, ended : Bool } }
	match input
		Chunk(_) => { actions: list_cons(HandlerMarker("trailer"), list_cons(SendBytes(trailer), list_nil())), next_state: { body_chunks: state.body_chunks, trailer_chunks: state.trailer_chunks + 1, ended: state.ended } }
		End => { actions: list_cons(HandlerMarker("clean-end"), list_cons(EndStream, list_nil())), next_state: { body_chunks: state.body_chunks, trailer_chunks: state.trailer_chunks, ended: true } }
	end
end

fn append_actions(left: List<ResponseAction>, right: List<ResponseAction>) -> List<ResponseAction>
	match left
		Nil => right
		Cons(action, tail) => list_cons(action, append_actions(tail, right))
	end
end

fn action_count(actions: List<ResponseAction>) -> Int
	match actions
		Nil => 0
		Cons(_, tail) => 1 + action_count(tail)
	end
end

fn write_count(actions: List<ResponseAction>) -> Int
	match actions
		Nil => 0
		Cons(action, tail) => match action
			SendBytes(_) => 1 + write_count(tail)
			HandlerMarker(_) => write_count(tail)
			EndStream => write_count(tail)
		end
	end
end

fn marker_count(actions: List<ResponseAction>) -> Int
	match actions
		Nil => 0
		Cons(action, tail) => match action
			SendBytes(_) => marker_count(tail)
			HandlerMarker(_) => 1 + marker_count(tail)
			EndStream => marker_count(tail)
		end
	end
end

fn ordered_send_chunks(actions: List<ResponseAction>) -> List<ByteChunk>
	match actions
		Nil => list_nil()
		Cons(action, tail) => match action
			SendBytes(bytes) => list_cons(bytes, ordered_send_chunks(tail))
			HandlerMarker(_) => ordered_send_chunks(tail)
			EndStream => ordered_send_chunks(tail)
		end
	end
end

fn read_stream_input(stream: net::Stream) -> StreamInput effects [net::IO]
	match read_chunk_optional(stream)
		Some(bytes) => Chunk(bytes)
		None => End
	end
end

fn route_input(route: { tx : Sender<StreamInput>, rx : Receiver<StreamInput> }, input: StreamInput) -> StreamInput effects [concurrency]
	let _ = channel::send(route.tx, input)
	match channel::recv(route.rx)
		Some(value) => value
		None => End
	end
end

fn combine_handler_actions(input: StreamInput, trailer: ByteChunk, state: { body_chunks : Int, trailer_chunks : Int, ended : Bool }) -> { actions : List<ResponseAction>, next_state : { body_chunks : Int, trailer_chunks : Int, ended : Bool } }
	let body = body_handler(input, state)
	let trailer_result = trailer_handler(input, trailer, body.next_state)
	{ actions: append_actions(body.actions, trailer_result.actions), next_state: trailer_result.next_state }
end

fn ordered_stream_response(stream: net::Stream, trailer: ByteChunk, state: { body_chunks : Int, trailer_chunks : Int, ended : Bool }) -> Result<{ actions : List<ResponseAction>, next_state : { body_chunks : Int, trailer_chunks : Int, ended : Bool } }, String> effects [net::IO, concurrency]
	let route = channel::bounded<StreamInput>(1)
	let input = route_input(route, read_stream_input(stream))
	let combined = combine_handler_actions(input, trailer, state)
	write_chunk_values(stream, ordered_send_chunks(combined.actions))
	close_stream_value(stream)
	Ok(combined)
end

fn accept_next(listener: net::Listener) -> Result<net::Stream, String> effects [net::IO]
	match accept_optional(listener)
		Some(stream) => Ok(stream)
		None => Err("missing production stream")
	end
end

fn listener_ended(listener: net::Listener) -> Bool effects [net::IO]
	match accept_optional(listener)
		Some(_) => false
		None => true
	end
end

fn bool_text(value: Bool) -> String
	if value
		"true"
	else
		"false"
	end
end

fn print_result(label: String, result: { actions : List<ResponseAction>, next_state : { body_chunks : Int, trailer_chunks : Int, ended : Bool } }) -> () effects [stdio]
	stdio::print(label)
	stdio::print("-actions ")
	stdio::print(int_to_string(action_count(result.actions)))
	stdio::print(" ")
	stdio::print(label)
	stdio::print("-writes ")
	stdio::print(int_to_string(write_count(result.actions)))
	stdio::print(" ")
	stdio::print(label)
	stdio::print("-markers ")
	stdio::print(int_to_string(marker_count(result.actions)))
	stdio::print(" ")
	stdio::print(label)
	stdio::print("-body ")
	stdio::print(int_to_string(result.next_state.body_chunks))
	stdio::print(" ")
	stdio::print(label)
	stdio::print("-trailers ")
	stdio::print(int_to_string(result.next_state.trailer_chunks))
	stdio::print(" ")
	stdio::print(label)
	stdio::print("-ended ")
	stdio::print(bool_text(result.next_state.ended))
end

fn fixture_body() -> Result<(), String> effects [net::IO, concurrency, stdio]
	let listener = open_listener("127.0.0.1:0")?
	let first_trailer = byte_chunk_from_hex("a001")?
	let second_trailer = byte_chunk_from_hex("a002")?
	let first_stream = accept_next(listener)?
	let first = ordered_stream_response(first_stream, first_trailer, { body_chunks: 0, trailer_chunks: 0, ended: false })?
	let second_stream = accept_next(listener)?
	let second = ordered_stream_response(second_stream, second_trailer, { body_chunks: 0, trailer_chunks: 0, ended: false })?
	let clean_end = listener_ended(listener)
	print_result("first", first)
	stdio::print(" ")
	print_result("second", second)
	stdio::print(" clean-end ")
	stdio::println(bool_text(clean_end))
	Ok(())
end

pub fn main() -> Result<(), String> effects [time, concurrency, fs, net, stdio]
	let state = fixture_effects::create_fixture()
	handle handle handle fixture_body() with net::system() with fake_effects::network(state) with fake_effects::clock(state)
end

fn fixture_network_error(error: net::NetError) -> String
	match error
		net::NetError(_, _, _, _, message) => match string_split_once(message, "\n")
			Some(parts) => parts.left
			None => message
		end
	end
end

fn fixture_address(text: String) -> Result<net::Address, String>
	match net::split_host_port(text)
		Ok(parts) => Ok(net::Address(net::Tcp4, parts.host, parts.port))
		Err(error) => Err(fixture_network_error(error))
	end
end

fn read_chunk_optional(stream: net::Stream) -> Option<ByteChunk> effects [net::IO]
	match net::read(stream)
		Ok(net::ReadChunk(bytes)) => Some(bytes)
		_ => None
	end
end

fn accept_optional(listener: net::Listener) -> Option<net::Stream> effects [net::IO]
	match net::accept(listener)
		Ok(stream) => Some(stream)
		Err(_) => None
	end
end

fn write_chunk_values(stream: net::Stream, chunks: List<ByteChunk>) -> () effects [net::IO]
	match chunks
		Nil => ()
		Cons(bytes, tail) => begin
			let _ = net::write_all(stream, bytes, None, None)
			write_chunk_values(stream, tail)
		end
	end
end

fn close_stream_value(stream: net::Stream) -> () effects [net::IO]
	let _ = net::close_stream(stream)
	()
end

fn open_listener(text: String) -> Result<net::Listener, String> effects [net::IO]
	match fixture_address(text)
		Ok(address) => match net::listen(address)
			Ok(listener) => Ok(listener)
			Err(error) => Err(fixture_network_error(error))
		end
		Err(message) => Err(message)
	end
end

fn open_stream(text: String) -> Result<net::Stream, String> effects [net::IO]
	match fixture_address(text)
		Ok(address) => match net::connect(address)
			Ok(stream) => Ok(stream)
			Err(error) => Err(fixture_network_error(error))
		end
		Err(message) => Err(message)
	end
end

fn accept_stream(listener: net::Listener) -> Result<net::Stream, String> effects [net::IO]
	match net::accept(listener)
		Ok(stream) => Ok(stream)
		Err(error) => Err(fixture_network_error(error))
	end
end
