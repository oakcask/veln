# HTTP/2 protocol-state failures project structured runtime details.

type Http2ProtocolFailure
	ClosedWithPending(Int, Int, ByteView)
end

type Http2DiagnosticContext
	DiagnosticContext(String)
end

fn context_active_continuation(context: Http2DiagnosticContext) -> String
	match context
		DiagnosticContext(active_continuation) => active_continuation
	end
end

fn http2_protocol_diagnostic(failure: Http2ProtocolFailure, context: Http2DiagnosticContext) -> Result<(), String>
	match failure
		ClosedWithPending(offset, pending_count, preview) => http2_protocol_closed_with_pending(offset, pending_count, context_active_continuation(context), preview)
	end
end

pub fn main() -> Result<(), String>
	let bytes: ByteChunk = byte_chunk_from_hex("01020304")?
	let preview: ByteView = byte_view(bytes, byte_offset(0)?, byte_count(4)?)?
	let context: Http2DiagnosticContext = DiagnosticContext("none")
	http2_protocol_diagnostic(ClosedWithPending(0, 4, preview), context)
end
