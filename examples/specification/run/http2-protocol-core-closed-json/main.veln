use http2::diagnostic from "std"
# HTTP/2 protocol-state failures project structured runtime details.

type Http2ProtocolFailure
	ClosedWithPending(Int, Int, ByteView)
end

type Http2DiagnosticContext
	DiagnosticContext(String)
end

fn context_active_continuation(context: Http2DiagnosticContext) -> String
	match context
		DiagnosticContext(active_continuation) => active_continuation
	end
end

fn invalid_closed_payload(error: String) -> RuntimeDiagnostic
	RuntimeDiagnostic(
		"http2.protocol.closed_with_pending",
		error,
		RuntimeHttp2ProtocolClosedWithPendingDiagnostic(0, 0, "none", 0, 0, 0, 0, "none", byte_chunk([]))
	)
end

fn closed_payload(offset: Int, pending_count: Int, context: Http2DiagnosticContext, preview: ByteView) -> RuntimeDiagnostic
	RuntimeDiagnostic(
		"http2.protocol.closed_with_pending",
		"HTTP/2 input ended with 4 pending byte(s) at byte offset 0",
		RuntimeHttp2ProtocolClosedWithPendingDiagnostic(offset, pending_count, context_active_continuation(context), 0, 0, 0, 0, "none", byte_view_to_chunk(preview))
	)
end

fn http2_protocol_diagnostic(failure: Http2ProtocolFailure, context: Http2DiagnosticContext) -> Result<(), RuntimeDiagnostic>
	match failure
		ClosedWithPending(offset, pending_count, preview) => Err(closed_payload(offset, pending_count, context, preview))
	end
end

fn preview_bytes() -> Result<ByteChunk, RuntimeDiagnostic>
	match byte_chunk_from_hex("01020304")
		Ok(bytes) => Ok(bytes)
		Err(error) => Err(invalid_closed_payload(error))
	end
end

fn preview_view(bytes: ByteChunk) -> Result<ByteView, RuntimeDiagnostic>
	match byte_offset(0)
		Ok(offset) => match byte_view(bytes, offset, byte_chunk_count(bytes))
			Ok(view) => Ok(view)
			Err(error) => Err(invalid_closed_payload(error))
		end
		Err(error) => Err(invalid_closed_payload(error))
	end
end

pub fn main() -> Result<(), RuntimeDiagnostic>
	let bytes: ByteChunk = preview_bytes()?
	let preview: ByteView = preview_view(bytes)?
	let context: Http2DiagnosticContext = DiagnosticContext("none")
	http2_protocol_diagnostic(ClosedWithPending(0, 4, preview), context)
end
