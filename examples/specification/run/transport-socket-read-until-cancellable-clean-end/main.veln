use fixture_effects
use fake_effects

# Cancellable deadline-aware socket read reports clean stream end as a value.
fn emit_read_outcome(outcome: StreamReadOutcome) -> () effects [stdio]
	match outcome
		ReadChunk(_) => stdio::println("chunk")
		ReadEnd => stdio::println("end")
		ReadDeadlineExpired => stdio::println("deadline")
		ReadCancelled => stdio::println("cancelled")
	end
end

fn fixture_body() -> Result<(), String> effects [net, time, stdio]
	let listener = net::listen("127.0.0.1:0")
	let stream = net::accept(listener)
	let deadline = time::deadline_after_ms(100)
	let token = time::cancel_token()
	emit_read_outcome(net::read_chunk_until_cancellable(stream, deadline, token))
	Ok(())
end

pub fn main() -> Result<(), String> effects [concurrency, fs, net, stdio, time]
	let state = fixture_effects::create_fixture()
	handle handle fixture_body() with fake_effects::network(state) with fake_effects::clock(state)
end
