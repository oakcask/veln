# HTTP/2 partial connection preface failures project structured runtime details.

type Http2ProtocolFailure
	ClosedWithPartialPreface(Int, Int)
end

type Http2DiagnosticContext
	DiagnosticContext(ByteView)
end

fn context_pending_view(context: Http2DiagnosticContext) -> ByteView
	match context
		DiagnosticContext(preview) => preview
	end
end

fn http2_protocol_diagnostic(failure: Http2ProtocolFailure, context: Http2DiagnosticContext) -> Result<(), String>
	match failure
		ClosedWithPartialPreface(offset, pending_count) => http2_protocol_partial_preface(offset, pending_count, context_pending_view(context))
	end
end

pub fn main() -> Result<(), String>
	let bytes: ByteChunk = byte_chunk_from_hex("505249202a20485454502f32")?
	let preview: ByteView = byte_view(bytes, byte_offset(0)?, byte_count(12)?)?
	let context: Http2DiagnosticContext = DiagnosticContext(preview)
	http2_protocol_diagnostic(ClosedWithPartialPreface(0, 12), context)
end
