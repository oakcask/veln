# HTTP/2 invalid DATA padding projects structured runtime details.

type Http2ProtocolFailure
	InvalidDataPadding(Int, Int, Int, Int, String, String, ByteView)
end

fn project(failure: Http2ProtocolFailure) -> Result<(), String>
	match failure
		InvalidDataPadding(offset, stream_id, pad_length, remaining_payload_length, active_state, rule_provenance, preview) => http2_protocol_invalid_data_padding(offset, stream_id, pad_length, remaining_payload_length, active_state, rule_provenance, preview)
	end
end

pub fn main() -> Result<(), String>
	let payload: ByteChunk = byte_chunk_from_hex("02")?
	let preview: ByteView = byte_view(payload, byte_offset(0)?, byte_count(1)?)?
	project(InvalidDataPadding(9, 1, 2, 0, "open-stream", "rfc9113_data_padding", preview))
end
