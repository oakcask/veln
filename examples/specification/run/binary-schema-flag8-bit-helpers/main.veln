# Flag8 helper functions inspect decoded flags and construct flags for encode.
use stdio

schema FlagPacket
	format binary

	flags: Flag8
end

fn padded_bit() -> Int
	3
end

fn priority_bit() -> Int
	5
end

fn ack_bit() -> Int
	0
end

fn emit_output_chunk(name: String, index: Int, chunk: ByteChunk, expected_hex: String) -> () effects [stdio]
	stdio::print("output_chunk ")
	stdio::print(name)
	stdio::print(" index ")
	stdio::print(int_to_string(index))
	stdio::print(" hex \"")
	stdio::print(expected_hex)
	stdio::print("\" count ")
	stdio::println(int_to_string(byte_count_to_int(byte_chunk_count(chunk))))
end

fn emit_output_chunk_list_header(name: String, count: Int) -> () effects [stdio]
	stdio::print("output_chunk_list ")
	stdio::print(name)
	stdio::print(" count ")
	stdio::println(int_to_string(count))
end

fn emit_encoded(bytes: ByteChunk) -> () effects [stdio]
	emit_output_chunk_list_header("flag-packet", 1)
	emit_output_chunk("flag-packet", 0, bytes, "28")
end

fn emit_encoded_result(bytes: ByteChunk) -> Result<(), String> effects [stdio]
	emit_encoded(bytes)
	Ok(())
end

fn bool_to_int(value: Bool) -> Int
	match value
		true => 1
		false => 0
	end
end

pub fn main() -> Result<(), String> effects [stdio]
	let bytes: ByteChunk = byte_chunk_from_hex("28")?
	let view: ByteView = byte_view(bytes, byte_offset(0)?, byte_count(1)?)?
	let packet: {flags: Flag8} = byte_decode_flag_packet(view)?
	let padded_set: Bool = flag8_is_set(packet.flags, padded_bit())?
	let priority_set: Bool = flag8_is_set(packet.flags, priority_bit())?
	let ack_set: Bool = flag8_is_set(packet.flags, ack_bit())?
	stdio::println(int_to_string(bool_to_int(padded_set)))
	stdio::println(int_to_string(bool_to_int(priority_set)))
	stdio::println(int_to_string(bool_to_int(ack_set)))
	let padded: Flag8 = flag8_set(Flag8(0), padded_bit())?
	let encoded_flags: Flag8 = flag8_set(padded, priority_bit())?
	let encoded: Result<ByteChunk, EncodeError> = byte_encode_flag_packet({flags: encoded_flags})
	match encoded
		Ok(encoded_bytes) => emit_encoded_result(encoded_bytes)
		Err(_) => Err("unexpected encode failure")
	end
end
