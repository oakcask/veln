# Socket adapter routing can spawn a handler with twenty-eight ordinary values.
use stdio

type StreamEvent
	Request {stream_id: Int, payload: ByteChunk}
	PeerClosed {stream_id: Int}
end

type ResponseAction
	SendBytes {stream_id: Int, bytes: ByteChunk}
	EndStream {stream_id: Int}
	Decline {stream_id: Int}
end

fn handle_stream_event(event: StreamEvent, state: { request_count : Int, marker : ByteChunk }) -> { actions : List<ResponseAction>, next_state : { request_count : Int, marker : ByteChunk } }
	match event
		Request(stream_id, payload) => { actions: list_cons(SendBytes(stream_id, state.marker), list_cons(SendBytes(stream_id, payload), list_cons(EndStream(stream_id), list_nil()))), next_state: { request_count: state.request_count + 1, marker: payload } }
		PeerClosed(stream_id) => { actions: list_cons(Decline(stream_id), list_nil()), next_state: state }
	end
end

fn action_count(actions: List<ResponseAction>) -> Int
	match actions
		Nil => 0
		Cons(_, tail) => 1 + action_count(tail)
	end
end

fn write_count(actions: List<ResponseAction>) -> Int
	match actions
		Nil => 0
		Cons(action, tail) => match action
			SendBytes(_, _) => 1 + write_count(tail)
			EndStream(_) => write_count(tail)
			Decline(_) => write_count(tail)
		end
	end
end

fn append_actions(left: List<ResponseAction>, right: List<ResponseAction>) -> List<ResponseAction>
	match left
		Nil => right
		Cons(action, tail) => list_cons(action, append_actions(tail, right))
	end
end

fn first_action_bytes(actions: List<ResponseAction>) -> Int
	match actions
		Nil => 0
		Cons(action, _) => match action
			SendBytes(_, bytes) => byte_count_to_int(byte_chunk_count(bytes))
			EndStream(_) => 0
			Decline(_) => 0
		end
	end
end

fn route_socket_events(stream: NetStream, stream_id: Int, state: { request_count : Int, marker : ByteChunk }) -> { actions : List<ResponseAction>, next_state : { request_count : Int, marker : ByteChunk } } effects [net, concurrency]
	let first_incoming: ByteChunk = net::read_chunk(stream)
	let second_incoming: ByteChunk = net::read_chunk(stream)
	let route = channel::bounded<StreamEvent>(1)
	let _ = channel::send(route.tx, Request(stream_id, first_incoming))
	let first_event: StreamEvent = match channel::recv(route.rx)
		Some(value) => value
		None => PeerClosed(stream_id)
	end
	let first_result = handle_stream_event(first_event, state)
	let _ = channel::send(route.tx, Request(stream_id, second_incoming))
	let second_event: StreamEvent = match channel::recv(route.rx)
		Some(value) => value
		None => PeerClosed(stream_id)
	end
	let second_result = handle_stream_event(second_event, first_result.next_state)
	{ actions: append_actions(first_result.actions, second_result.actions), next_state: second_result.next_state }
end

fn handle_stream_event_with_context(event: StreamEvent, state: { request_count : Int, marker : ByteChunk }, context: { adapter_id : Int, adapter_marker : ByteChunk }, routing: { stream_offset : Int, route_marker : ByteChunk }, metadata: { metadata_offset : Int, metadata_marker : ByteChunk }, audit: { audit_offset : Int, audit_marker : ByteChunk }, trace: { trace_offset : Int, trace_marker : ByteChunk }, shard: { shard_offset : Int, shard_marker : ByteChunk }, region: { region_offset : Int, region_marker : ByteChunk }, zone: { zone_offset : Int, zone_marker : ByteChunk }, site: { site_offset : Int, site_marker : ByteChunk }, rack: { rack_offset : Int, rack_marker : ByteChunk }, aisle: { aisle_offset : Int, aisle_marker : ByteChunk }, shelf: { shelf_offset : Int, shelf_marker : ByteChunk }, bin: { bin_offset : Int, bin_marker : ByteChunk }, slot: { slot_offset : Int, slot_marker : ByteChunk }, lane: { lane_offset : Int, lane_marker : ByteChunk }, row: { row_offset : Int, row_marker : ByteChunk }, section: { section_offset : Int, section_marker : ByteChunk }, floor: { floor_offset : Int, floor_marker : ByteChunk }, level: { level_offset : Int, level_marker : ByteChunk }, tier: { tier_offset : Int, tier_marker : ByteChunk }, phase: { phase_offset : Int, phase_marker : ByteChunk }, wave: { wave_offset : Int, wave_marker : ByteChunk }, batch: { batch_offset : Int, batch_marker : ByteChunk }, cycle: { cycle_offset : Int, cycle_marker : ByteChunk }, round: { round_offset : Int, round_marker : ByteChunk }, attempt: { attempt_offset : Int, attempt_marker : ByteChunk }) -> { actions : List<ResponseAction>, next_state : { request_count : Int, marker : ByteChunk } }
	match event
		Request(stream_id, payload) => { actions: list_cons(SendBytes(stream_id, attempt.attempt_marker), list_cons(SendBytes(stream_id, payload), list_cons(EndStream(stream_id), list_nil()))), next_state: { request_count: state.request_count + context.adapter_id + routing.stream_offset + metadata.metadata_offset + audit.audit_offset + trace.trace_offset + shard.shard_offset + region.region_offset + zone.zone_offset + site.site_offset + rack.rack_offset + aisle.aisle_offset + shelf.shelf_offset + bin.bin_offset + slot.slot_offset + lane.lane_offset + row.row_offset + section.section_offset + floor.floor_offset + level.level_offset + tier.tier_offset + phase.phase_offset + wave.wave_offset + batch.batch_offset + cycle.cycle_offset + round.round_offset + attempt.attempt_offset, marker: payload } }
		PeerClosed(stream_id) => { actions: list_cons(Decline(stream_id), list_nil()), next_state: state }
	end
end

fn spawned_stream_handler(event: StreamEvent, state: { request_count : Int, marker : ByteChunk }, context: { adapter_id : Int, adapter_marker : ByteChunk }, routing: { stream_offset : Int, route_marker : ByteChunk }, metadata: { metadata_offset : Int, metadata_marker : ByteChunk }, audit: { audit_offset : Int, audit_marker : ByteChunk }, trace: { trace_offset : Int, trace_marker : ByteChunk }, shard: { shard_offset : Int, shard_marker : ByteChunk }, region: { region_offset : Int, region_marker : ByteChunk }, zone: { zone_offset : Int, zone_marker : ByteChunk }, site: { site_offset : Int, site_marker : ByteChunk }, rack: { rack_offset : Int, rack_marker : ByteChunk }, aisle: { aisle_offset : Int, aisle_marker : ByteChunk }, shelf: { shelf_offset : Int, shelf_marker : ByteChunk }, bin: { bin_offset : Int, bin_marker : ByteChunk }, slot: { slot_offset : Int, slot_marker : ByteChunk }, lane: { lane_offset : Int, lane_marker : ByteChunk }, row: { row_offset : Int, row_marker : ByteChunk }, section: { section_offset : Int, section_marker : ByteChunk }, floor: { floor_offset : Int, floor_marker : ByteChunk }, level: { level_offset : Int, level_marker : ByteChunk }, tier: { tier_offset : Int, tier_marker : ByteChunk }, phase: { phase_offset : Int, phase_marker : ByteChunk }, wave: { wave_offset : Int, wave_marker : ByteChunk }, batch: { batch_offset : Int, batch_marker : ByteChunk }, cycle: { cycle_offset : Int, cycle_marker : ByteChunk }, round: { round_offset : Int, round_marker : ByteChunk }, attempt: { attempt_offset : Int, attempt_marker : ByteChunk }) -> Result<{ actions : List<ResponseAction>, next_state : { request_count : Int, marker : ByteChunk } }, String> effects [concurrency]
	Ok(handle_stream_event_with_context(event, state, context, routing, metadata, audit, trace, shard, region, zone, site, rack, aisle, shelf, bin, slot, lane, row, section, floor, level, tier, phase, wave, batch, cycle, round, attempt))
end

fn run_stream_task() -> Result<{ actions : List<ResponseAction>, next_state : { request_count : Int, marker : ByteChunk } }, String> effects [concurrency]
	let payload: ByteChunk = byte_chunk_from_hex("050607")?
	let marker: ByteChunk = byte_chunk_from_hex("cc")?
	let adapter_marker: ByteChunk = byte_chunk_from_hex("ddee")?
	let route_marker: ByteChunk = byte_chunk_from_hex("ff")?
	let metadata_marker: ByteChunk = byte_chunk_from_hex("1122")?
	let audit_marker: ByteChunk = byte_chunk_from_hex("334455")?
	let trace_marker: ByteChunk = byte_chunk_from_hex("77")?
	let shard_marker: ByteChunk = byte_chunk_from_hex("8899")?
	let region_marker: ByteChunk = byte_chunk_from_hex("a1b2")?
	let zone_marker: ByteChunk = byte_chunk_from_hex("c3d4e5")?
	let site_marker: ByteChunk = byte_chunk_from_hex("e6f70809")?
	let rack_marker: ByteChunk = byte_chunk_from_hex("0a0b0c0d0e")?
	let aisle_marker: ByteChunk = byte_chunk_from_hex("0f1011121314")?
	let shelf_marker: ByteChunk = byte_chunk_from_hex("15161718191a1b")?
	let bin_marker: ByteChunk = byte_chunk_from_hex("1c1d1e1f20212223")?
	let slot_marker: ByteChunk = byte_chunk_from_hex("2425262728292a2b2c")?
	let lane_marker: ByteChunk = byte_chunk_from_hex("2d2e2f30313233343536")?
	let row_marker: ByteChunk = byte_chunk_from_hex("3738393a3b3c3d3e3f4041")?
	let section_marker: ByteChunk = byte_chunk_from_hex("42434445464748494a4b4c4d")?
	let floor_marker: ByteChunk = byte_chunk_from_hex("4e4f505152535455565758595a")?
	let level_marker: ByteChunk = byte_chunk_from_hex("5b5c5d5e5f606162636465666768")?
	let tier_marker: ByteChunk = byte_chunk_from_hex("696a6b6c6d6e6f7071727374757677")?
	let phase_marker: ByteChunk = byte_chunk_from_hex("78797a7b7c7d7e7f8081828384858687")?
	let wave_marker: ByteChunk = byte_chunk_from_hex("88898a8b8c8d8e8f909192939495969798")?
	let batch_marker: ByteChunk = byte_chunk_from_hex("999a9b9c9d9e9fa0a1a2a3a4a5a6a7a8a9aa")?
	let cycle_marker: ByteChunk = byte_chunk_from_hex("abacadaeafb0b1b2b3b4b5b6b7b8b9babbbcbd")?
	let round_marker: ByteChunk = byte_chunk_from_hex("bebfc0c1c2c3c4c5c6c7c8c9cacbcccdcecff0f1")?
	let attempt_marker: ByteChunk = byte_chunk_from_hex("f2f3f4f5f6f7f8f9fafbfcfdfeff00010203040506")?
	let context = { adapter_id: 3, adapter_marker: adapter_marker }
	let routing = { stream_offset: 4, route_marker: route_marker }
	let metadata = { metadata_offset: 5, metadata_marker: metadata_marker }
	let audit = { audit_offset: 6, audit_marker: audit_marker }
	let trace = { trace_offset: 7, trace_marker: trace_marker }
	let shard = { shard_offset: 8, shard_marker: shard_marker }
	let region = { region_offset: 9, region_marker: region_marker }
	let zone = { zone_offset: 10, zone_marker: zone_marker }
	let site = { site_offset: 11, site_marker: site_marker }
	let rack = { rack_offset: 12, rack_marker: rack_marker }
	let aisle = { aisle_offset: 13, aisle_marker: aisle_marker }
	let shelf = { shelf_offset: 14, shelf_marker: shelf_marker }
	let bin = { bin_offset: 15, bin_marker: bin_marker }
	let slot = { slot_offset: 16, slot_marker: slot_marker }
	let lane = { lane_offset: 17, lane_marker: lane_marker }
	let row = { row_offset: 18, row_marker: row_marker }
	let section = { section_offset: 19, section_marker: section_marker }
	let floor = { floor_offset: 20, floor_marker: floor_marker }
	let level = { level_offset: 21, level_marker: level_marker }
	let tier = { tier_offset: 22, tier_marker: tier_marker }
	let phase = { phase_offset: 23, phase_marker: phase_marker }
	let wave = { wave_offset: 24, wave_marker: wave_marker }
	let batch = { batch_offset: 25, batch_marker: batch_marker }
	let cycle = { cycle_offset: 26, cycle_marker: cycle_marker }
	let round = { round_offset: 27, round_marker: round_marker }
	let attempt = { attempt_offset: 28, attempt_marker: attempt_marker }
	let worker = task::spawn_with28<Result<{ actions : List<ResponseAction>, next_state : { request_count : Int, marker : ByteChunk } }, String>>(spawned_stream_handler, Request(11, payload), { request_count: 40, marker: marker }, context, routing, metadata, audit, trace, shard, region, zone, site, rack, aisle, shelf, bin, slot, lane, row, section, floor, level, tier, phase, wave, batch, cycle, round, attempt)
	match task::join(worker)
		Ok(value) => value
		Err(_) => Err("stream task failed")
	end
end

fn apply_response_actions(stream: NetStream, actions: List<ResponseAction>) -> () effects [net]
	match actions
		Nil => ()
		Cons(action, tail) => match action
			SendBytes(_, bytes) => write_then_apply(stream, bytes, tail)
			EndStream(_) => apply_response_actions(stream, tail)
			Decline(_) => apply_response_actions(stream, tail)
		end
	end
end

fn write_then_apply(stream: NetStream, bytes: ByteChunk, tail: List<ResponseAction>) -> () effects [net]
	net::write_chunk(stream, bytes)
	apply_response_actions(stream, tail)
end

pub fn main() -> Result<(), String> effects [net, concurrency, stdio]
	let listener: NetListener = net::listen("127.0.0.1:0")
	let stream: NetStream = net::accept(listener)
	let marker: ByteChunk = byte_chunk_from_hex("aabb")?
	let initial = { request_count: 0, marker: marker }
	let routed = route_socket_events(stream, 7, initial)
	apply_response_actions(stream, routed.actions)
	let task_routed: { actions : List<ResponseAction>, next_state : { request_count : Int, marker : ByteChunk } } = run_stream_task()?
	stdio::print("actions ")
	stdio::print(int_to_string(action_count(routed.actions)))
	stdio::print(" state ")
	stdio::print(int_to_string(routed.next_state.request_count))
	stdio::print(" writes ")
	stdio::print(int_to_string(write_count(routed.actions)))
	stdio::print(" first-bytes ")
	stdio::print(int_to_string(first_action_bytes(routed.actions)))
	stdio::print(" task-actions ")
	stdio::print(int_to_string(action_count(task_routed.actions)))
	stdio::print(" task-state ")
	stdio::print(int_to_string(task_routed.next_state.request_count))
	stdio::print(" task-first-bytes ")
	stdio::println(int_to_string(first_action_bytes(task_routed.actions)))
	Ok(())
end
