# Ordinary encode function Invalid steps populate value_diagnostic JSON.

schema ManualPacketWire
	format binary

	length: UInt8
	kind: UInt8
end


fn encode_packet(packet: {length: Int, kind: Int}) -> EncodeStep<()>
	if packet.kind <= packet.length
		Encoded(list_nil())
	else
		Invalid(EncodeError("codec.encode_value_unrepresentable", "ManualPacketWire.kind", "kind must be less than or equal to length"))
	end
end

fn encode_result_step(encoded: Result<ByteChunk, EncodeError>) -> EncodeStep<()>
	match encoded
		Ok(chunk) => Encoded(list_cons(chunk, list_nil()))
		Err(error) => Invalid(error)
	end
end

pub fn main() -> EncodeStep<()>
	encode_packet({length: 1, kind: 7})
end
