# Adapter-owned stream half-close leaves clean read end on the read path.
use stdio

fn read_state(stream: NetStream) -> String effects [net]
	match net::read_chunk_or_end(stream)
		Some(_) => "chunk"
		None => "end"
	end
end

pub fn main() -> Result<(), String> effects [net, stdio]
	let listener = net::listen("127.0.0.1:0")
	let stream = net::accept(listener)
	let incoming = read_state(stream)
	let outgoing = byte_chunk_from_hex("0a0b")?
	net::write_chunk(stream, outgoing)
	net::shutdown_write(stream)
	let after_shutdown = read_state(stream)
	net::close_stream(stream)
	stdio::print(incoming)
	stdio::print(" ")
	stdio::println(after_shutdown)
	Ok(())
end
