use net from "std"
use fixture_effects
use fake_effects
# Production loopback listener accepts two independent streams and then ends.
use stdio

fn accept_next(listener: net::Listener) -> Result<net::Stream, net::NetError> effects [net::IO]
	net::accept(listener)
end

fn read_bytes(outcome: net::ReadOutcome) -> ByteChunk
	match outcome
		net::ReadChunk(bytes) => bytes
		net::ReadEnd => byte_chunk([])
	end
end

fn round_trip_stream(stream: net::Stream) -> Result<Int, net::NetError> effects [net::IO]
	let incoming = read_bytes(net::read(stream)?)
	let _ = net::write_all(stream, incoming, None, None)?
	let _ = net::close_stream(stream)?
	Ok(byte_count_to_int(byte_chunk_count(incoming)))
end

fn listener_ended(listener: net::Listener) -> Bool effects [net::IO]
	match net::accept(listener)
		Ok(_) => false
		Err(_) => true
	end
end

fn bool_text(value: Bool) -> String
	if value
		"true"
	else
		"false"
	end
end

fn fixture_body() -> Result<(), net::NetError> effects [net::IO, stdio]
	let listener = net::listen(net::Address(net::Tcp4, "127.0.0.1", 0))?
	let first = accept_next(listener)?
	let first_count = round_trip_stream(first)?
	let second = accept_next(listener)?
	let second_count = round_trip_stream(second)?
	let clean_end = listener_ended(listener)
	stdio::print("first ")
	stdio::print(int_to_string(first_count))
	stdio::print(" second ")
	stdio::print(int_to_string(second_count))
	stdio::print(" clean-end ")
	stdio::println(bool_text(clean_end))
	Ok(())
end

pub fn main() -> Result<(), net::NetError> effects [concurrency, fs, net, stdio, time]
	let state = fixture_effects::create_fixture()
	handle handle handle fixture_body() with net::system() with fake_effects::network(state) with fake_effects::clock(state)
end
