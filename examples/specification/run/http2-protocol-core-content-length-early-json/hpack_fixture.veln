pub type HpackHeader
	HpackHeader(String, String)
end

pub type HpackHeaderList
	HpackHeaderList(HpackHeader, HpackHeader, String)
end

pub type HpackFixtureState
	HpackFixtureState(Int, Int)
end

pub type HpackDecodeTransition
	HpackDecodeTransition(HpackHeaderList, HpackFixtureState)
end

pub fn initial_state() -> HpackFixtureState
	HpackFixtureState(4096, 0)
end

pub fn decode_header_block(block: ByteChunk, state: HpackFixtureState, offset: Int) -> Result<HpackDecodeTransition, String>
	Ok(HpackDecodeTransition(HpackHeaderList(HpackHeader(":method", "GET"), HpackHeader(":request", "scheme,path,content-length:5"), "content-length:5"), state))
end

pub fn transition_headers(transition: HpackDecodeTransition) -> HpackHeaderList
	match transition
		HpackDecodeTransition(headers, _) => headers
	end
end

pub fn header_list_accepted_content_length(headers: HpackHeaderList) -> Int
	match headers
		HpackHeaderList(HpackHeader(":method", _), HpackHeader(":request", "scheme,path,content-length:5"), _) => 5
		_ => -1
	end
end
