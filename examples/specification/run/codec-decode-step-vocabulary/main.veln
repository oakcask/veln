# DecodeStep exposes ordinary source-visible incremental decode outcomes.
use stdio

fn complete_decoder(view: ByteView) -> DecodeStep<Int>
	let chunk = byte_view_to_chunk(view)
	Decoded(byte_count_to_int(byte_chunk_count(chunk)), byte_chunk_count(chunk))
end

fn waiting_decoder(expected: ByteCount) -> DecodeStep<Int>
	NeedMore(NeedBytes(expected))
end

fn invalid_decoder(offset: ByteOffset) -> DecodeStep<Int>
	Invalid(DecodeError("codec.invalid_input", offset, "DemoPacket.kind"))
end

fn step_kind(step: DecodeStep<Int>) -> String
	match step
		Decoded(_, _) => "decoded"
		NeedMore(_) => "need_more"
		Invalid(_) => "invalid"
	end
end

fn decoded_value(step: DecodeStep<Int>) -> Int
	match step
		Decoded(value, _) => value
		NeedMore(_) => -1
		Invalid(_) => -1
	end
end

fn decoded_consumed(step: DecodeStep<Int>) -> Int
	match step
		Decoded(_, consumed) => byte_count_to_int(consumed)
		NeedMore(_) => 0
		Invalid(_) => 0
	end
end

fn readiness_kind(step: DecodeStep<Int>) -> String
	match step
		Decoded(_, _) => "none"
		NeedMore(NeedBytes(_)) => "need_bytes"
		NeedMore(NeedEnd) => "need_end"
		Invalid(_) => "none"
	end
end

fn readiness_count(step: DecodeStep<Int>) -> Int
	match step
		Decoded(_, _) => 0
		NeedMore(NeedBytes(count)) => byte_count_to_int(count)
		NeedMore(NeedEnd) => 0
		Invalid(_) => 0
	end
end

fn error_id(step: DecodeStep<Int>) -> String
	match step
		Decoded(_, _) => "none"
		NeedMore(_) => "none"
		Invalid(DecodeError(id, _, _)) => id
		Invalid(DecodeErrorWithReason(id, _, _, _)) => id
	end
end

fn error_offset(step: DecodeStep<Int>) -> Int
	match step
		Decoded(_, _) => 0
		NeedMore(_) => 0
		Invalid(DecodeError(_, offset, _)) => byte_offset_to_int(offset)
		Invalid(DecodeErrorWithReason(_, offset, _, _)) => byte_offset_to_int(offset)
	end
end

fn error_path(step: DecodeStep<Int>) -> String
	match step
		Decoded(_, _) => "none"
		NeedMore(_) => "none"
		Invalid(DecodeError(_, _, path)) => path
		Invalid(DecodeErrorWithReason(_, _, path, _)) => path
	end
end

pub fn main() -> Result<(), String> effects [stdio]
	let bytes = byte_chunk_from_hex("010203")?
	let offset = byte_offset(0)?
	let count = byte_count(3)?
	let view = byte_view(bytes, offset, count)?
	let decoded = complete_decoder(view)
	let needed = byte_count(8)?
	let waiting = waiting_decoder(needed)
	let invalid_offset = byte_offset(5)?
	let invalid = invalid_decoder(invalid_offset)
	stdio::println(step_kind(decoded))
	stdio::println(int_to_string(decoded_value(decoded)))
	stdio::println(int_to_string(decoded_consumed(decoded)))
	stdio::println(step_kind(waiting))
	stdio::println(readiness_kind(waiting))
	stdio::println(int_to_string(readiness_count(waiting)))
	stdio::println(step_kind(invalid))
	stdio::println(error_id(invalid))
	stdio::println(int_to_string(error_offset(invalid)))
	stdio::println(error_path(invalid))
	Ok(())
end
