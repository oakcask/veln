# Run entries receive command-line arguments as source-typed parameters.
pub fn main(label: String, count: Int, ratio: Float, enabled: Bool) -> () effects [stdio]
	let adjusted = ratio + 0.5
	let status = if enabled
		"enabled"
	else
		"disabled"
	end
	stdio::println(label)
	stdio::println(int_to_string(count + 1))
	stdio::println(status)
	if adjusted > 2.0
		stdio::println("large")
	else
		stdio::println("small")
	end
end
