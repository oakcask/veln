# Binary schema extension dispatch preserves an unknown nested payload.
use stdio

schema SettingsPayload
	format binary

	code: UInt8
	value: UInt16be
end

schema ExtensionNestedPacket
	format binary

	length: UInt8
	kind: UInt8
	payload: ExtensionDispatch(kind, length, 1 => SettingsPayload)
end

fn emit_payload(payload: SchemaDispatchPayload<{code: Int, value: Int}>) -> Result<(), String> effects [stdio]
	match payload
		Known(value) => emit_known(value)
		Unknown(tag, raw) => emit_unknown(tag, raw)
	end
end

fn emit_known(value: {code: Int, value: Int}) -> Result<(), String> effects [stdio]
	stdio::print(int_to_string(value.code))
	stdio::print(" ")
	stdio::println(int_to_string(value.value))
	Ok(())
end

fn emit_unknown(tag: Int, raw: ByteView) -> Result<(), String> effects [stdio]
	let chunk: ByteChunk = byte_view_to_chunk(raw)
	stdio::print("unknown ")
	stdio::print(int_to_string(tag))
	stdio::print(" ")
	stdio::print(int_to_string(byte_count_to_int(byte_chunk_count(chunk))))
	stdio::print(" ")
	stdio::println(int_to_string(byte_read_u8_be(raw)?))
	Ok(())
end

pub fn main() -> Result<(), String> effects [stdio]
	let bytes: ByteChunk = byte_chunk_from_hex("0307aabbcc")?
	let offset: ByteOffset = byte_offset(0)?
	let count: ByteCount = byte_count(5)?
	let view: ByteView = byte_view(bytes, offset, count)?
	let packet: {length: Int, kind: Int, payload: SchemaDispatchPayload<{code: Int, value: Int}>} = byte_decode_extension_nested_packet(view)?
	stdio::print(int_to_string(packet.length))
	stdio::print(" ")
	stdio::print(int_to_string(packet.kind))
	stdio::print(" ")
	emit_payload(packet.payload)
	Ok(())
end
