use http2::hpack from "std"
use stdio

fn byte_at(chunk: ByteChunk, index: Int) -> Result<Int, String>
	byte_read_u8_be(byte_view(chunk, byte_offset(index)?, byte_count(1)?)?)
end

fn required_entry(table: DynamicTable, index: Int) -> Result<DynamicEntry, String>
	match http2::hpack::dynamic_table_entry(table, index)
		Some(entry) => Ok(entry)
		None => Err("dynamic entry is unavailable")
	end
end

fn rejected_capacity_message(table: DynamicTable) -> Result<String, String>
	match http2::hpack::dynamic_table_with_capacity(table, -1)
		Ok(_) => Err("negative dynamic table capacity was accepted")
		Err(failure) => Ok(failure)
	end
end

fn print_table(label: String, table: DynamicTable) -> () effects [stdio]
	stdio::print(label)
	stdio::print(" ")
	stdio::print(int_to_string(http2::hpack::dynamic_table_capacity(table)))
	stdio::print(" ")
	stdio::print(int_to_string(http2::hpack::dynamic_table_size(table)))
	stdio::print(" ")
	stdio::println(int_to_string(http2::hpack::dynamic_table_entry_count(table)))
end

pub fn main() -> Result<(), String> effects [stdio]
	let empty: DynamicTable = http2::hpack::empty_dynamic_table(72)?
	print_table("initial", empty)

	let older: DynamicTable = http2::hpack::insert_dynamic_table_entry(empty, "a", byte_chunk_from_hex("31")?)?
	let inserted: DynamicTable = http2::hpack::insert_dynamic_table_entry(older, "bb", byte_chunk_from_hex("00ff")?)?
	print_table("inserted", inserted)

	let newest: DynamicEntry = required_entry(inserted, 1)?
	let newest_value: ByteChunk = http2::hpack::dynamic_entry_value(newest)
	stdio::print("newest ")
	stdio::print(http2::hpack::dynamic_entry_name(newest))
	stdio::print(" ")
	stdio::print(int_to_string(byte_at(newest_value, 0)?))
	stdio::print(" ")
	stdio::println(int_to_string(byte_at(newest_value, 1)?))

	let oldest: DynamicEntry = required_entry(inserted, 2)?
	stdio::print("oldest ")
	stdio::print(http2::hpack::dynamic_entry_name(oldest))
	stdio::print(" ")
	stdio::println(int_to_string(byte_at(http2::hpack::dynamic_entry_value(oldest), 0)?))

	let shrunk: DynamicTable = http2::hpack::dynamic_table_with_capacity(inserted, 36)?
	print_table("shrunk", shrunk)
	print_table("original", inserted)

	let grown: DynamicTable = http2::hpack::dynamic_table_with_capacity(shrunk, 96)?
	print_table("grown", grown)

	stdio::print("negative ")
	stdio::println(rejected_capacity_message(inserted)?)
	print_table("preserved", inserted)
	Ok(())
end
