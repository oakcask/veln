use fixture_effects
use fake_effects

fn emit_json(value: WallTime) -> () effects [stdio]
	stdio::println(wall_join(["{\"unix_seconds\":", int_to_string(value.unix_seconds), ",\"nanosecond\":", int_to_string(value.nanosecond), "}"]))
end

fn wall_join(parts: Vec<String>) -> String
	vec_fold(parts, "", wall_concatenate)
end

fn wall_concatenate(left: String, right: String) -> String
	string::concat(left, right)
end

fn wall_and_deadline() -> String effects [time]
	let before = time::wall_time()
	let deadline: Deadline = time::deadline_after_ms(5)
	let after = time::wall_time()
	time::wait_until(deadline)
	if before.unix_seconds == 1234 and before.nanosecond == 567 and before == after
		"deadline-monotonic wall=1234:567"
	else
		"unexpected"
	end
end

pub fn main() -> () effects [concurrency, time, stdio]
	let epoch_state = fixture_effects::create_clock_state(0, 0, 7)
	let epoch = handle time::wall_time() with fake_effects::clock(epoch_state)
	emit_json(epoch)

	let pre_epoch_state = fixture_effects::create_clock_state(0, -1, 7)
	let pre_epoch = handle time::wall_time() with fake_effects::clock(pre_epoch_state)
	emit_json(pre_epoch)

	let first_state = fixture_effects::create_clock_state(2, 0, 7)
	let second_state = fixture_effects::create_clock_state(1, 0, 7)
	let first = handle time::wall_time() with fake_effects::clock(first_state)
	let second = handle time::wall_time() with fake_effects::clock(second_state)
	stdio::println(if second.unix_seconds < first.unix_seconds "backwards" else "unexpected" end)

	let deadline_state = fixture_effects::create_deadline_clock_state(1234, 567, 700, 5)
	stdio::println(handle wall_and_deadline() with fake_effects::clock(deadline_state))
end
