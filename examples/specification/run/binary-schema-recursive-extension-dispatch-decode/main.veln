# Recursive extension-dispatch payloads keep known recursion and unknown payloads.
use stdio

type NodePayload
	Leaf(Int)
	Branch({length: Int, kind: Int, payload: SchemaDispatchPayload<NodePayload>})
end

type Node
	Node {length: Int, kind: Int, payload: SchemaDispatchPayload<NodePayload>}
end

schema RecursiveExtensionNode
	format binary

	length: UInt8
	kind: UInt8
	payload: ExtensionDispatch(kind, length, 0 => UInt8, 1 => RecursiveExtensionNode)

	map to Node when kind == 0
		length = length
		kind = kind
		payload = Known(NodePayload::Leaf(payload))

	map to Node when kind == 1
		length = length
		kind = kind
		payload = Known(NodePayload::Branch(payload))
end

fn emit_known(payload: SchemaDispatchPayload<NodePayload>) -> Result<(), String> effects [stdio]
	match payload
		Known(value) => emit_known_node(value)
		Unknown(_, _) => emit_unexpected_unknown()
	end
end

fn emit_known_node(value: NodePayload) -> Result<(), String> effects [stdio]
	match value
		Leaf(number) => emit_leaf(number)
		Branch(child) => emit_known(child.payload)
	end
end

fn emit_leaf(number: Int) -> Result<(), String> effects [stdio]
	stdio::println(int_to_string(number))
	Ok(())
end

fn emit_unexpected_unknown() -> Result<(), String> effects [stdio]
	stdio::println("unexpected unknown")
	Ok(())
end

fn emit_unknown(payload: SchemaDispatchPayload<NodePayload>) -> Result<(), String> effects [stdio]
	match payload
		Known(_) => emit_unexpected_known()
		Unknown(tag, view) => emit_unknown_payload(tag, view)
	end
end

fn emit_unexpected_known() -> Result<(), String> effects [stdio]
	stdio::println("unexpected known")
	Ok(())
end

fn emit_unknown_payload(tag: Int, view: ByteView) -> Result<(), String> effects [stdio]
	stdio::print(int_to_string(tag))
	stdio::print(" ")
	stdio::println(int_to_string(byte_count_to_int(byte_view_count(view))))
	Ok(())
end

pub fn main() -> Result<(), String> effects [stdio]
	let known_bytes: ByteChunk = byte_chunk_from_hex("030101002a")?
	let known_view: ByteView = byte_view(known_bytes, byte_offset(0)?, byte_count(5)?)?
	let known: {length: Int, kind: Int, payload: SchemaDispatchPayload<NodePayload>} = byte_decode_recursive_extension_node(known_view)?
	stdio::print(int_to_string(known.kind))
	stdio::print(" ")
	let ignored_known: () = emit_known(known.payload)?

	let unknown_bytes: ByteChunk = byte_chunk_from_hex("0207aabb")?
	let unknown_view: ByteView = byte_view(unknown_bytes, byte_offset(0)?, byte_count(4)?)?
	let unknown: {length: Int, kind: Int, payload: SchemaDispatchPayload<NodePayload>} = byte_decode_recursive_extension_node(unknown_view)?
	let ignored_unknown: () = emit_unknown(unknown.payload)?
	Ok(())
end
