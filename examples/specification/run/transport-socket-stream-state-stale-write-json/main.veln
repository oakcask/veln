use fixture_effects
use fake_effects
# Closed stream state is observable before stale writes fail.
use stdio

fn bool_text(value: Bool) -> String
	if value
		"true"
	else
		"false"
	end
end

fn fixture_body() -> Result<(), String> effects [net, stdio]
	let listener: NetListener = net::listen("127.0.0.1:0")
	let stream: NetStream = net::accept(listener)
	net::close_stream(stream)
	stdio::println(bool_text(net::stream_is_closed(stream)))
	let outgoing: ByteChunk = byte_chunk_from_hex("0a")?
	net::write_chunk(stream, outgoing)
	Ok(())
end

pub fn main() -> Result<(), String> effects [concurrency, fs, net, stdio]
	let state = fixture_effects::create_fixture()
	handle handle fixture_body() with fake_effects::network(state) with fake_effects::clock(state)
end
