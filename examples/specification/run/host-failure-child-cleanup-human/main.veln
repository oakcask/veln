# This command case checks the JVM entry boundary: an uncaught host failure stays
# primary while invocation cancellation drains and exposes admitted child cleanup.
fn fail_cleanup(count: Int) -> ()
	let ignored = 1 << count
	()
end

fn wait_first(context: { entered : Sender<()>, gate : Receiver<()> }) -> () effects [concurrency, stdio]
	defer
		stdio::println("first cleanup")
		fail_cleanup(64)
	end
	let _ = channel::send(context.entered, ())
	let _ = channel::recv(context.gate)
	()
end

fn wait_second(context: { entered : Sender<()>, gate : Receiver<()> }) -> () effects [concurrency, stdio]
	defer
		stdio::println("second cleanup")
		fail_cleanup(65)
	end
	let _ = channel::send(context.entered, ())
	let _ = channel::recv(context.gate)
	()
end

fn overflow(remaining: Int) -> Int
	if remaining <= 0
		0
	else
		1 + overflow(remaining - 1)
	end
end

pub fn main() -> () effects [concurrency, stdio]
	let entered = channel::bounded<()>(2)
	let gate = channel::bounded<()>(0)
	let _ = task::spawn_with(wait_first, { entered: entered.tx, gate: gate.rx })
	let _ = task::spawn_with(wait_second, { entered: entered.tx, gate: gate.rx })
	let _ = channel::recv(entered.rx)
	let _ = channel::recv(entered.rx)
	let _ = overflow(1000000)
	()
end
