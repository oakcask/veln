# Binary schema frame-header primitives decode mapped Int fields.
use stdio

fn emit_header(header: {length: Int, kind: Int, flags: Int, stream_id: Int}) -> () effects [stdio]
	stdio::print(int_to_string(header.length))
	stdio::print(" ")
	stdio::print(int_to_string(header.kind))
	stdio::print(" ")
	stdio::print(int_to_string(header.flags))
	stdio::print(" ")
	stdio::println(int_to_string(header.stream_id))
end

pub fn main() -> Result<(), String> effects [stdio]
	let bytes: ByteChunk = byte_chunk_from_hex("000005010400000001")?
	let offset: ByteOffset = byte_offset(0)?
	let count: ByteCount = byte_count(9)?
	let view: ByteView = byte_view(bytes, offset, count)?
	let header: {length: Int, kind: Int, flags: Int, stream_id: Int} = byte_decode_http2_frame_header(view)?
	emit_header(header)
	Ok(())
end
