# Explicit binary schema frame-header operations decode mapped Int fields.
use stdio

schema Http2FrameHeaderWire
	format binary

	length: UInt24be
	kind: UInt8
	flags: UInt8
	stream_reserved: ReservedBits(1, 0)
	stream_id: UInt31be
end

fn decoded_header(step: DecodeStep<{length: Int, kind: Int, flags: Int, stream_id: Int}>) -> Result<{length: Int, kind: Int, flags: Int, stream_id: Int}, String>
	match step
		Decoded(header, _) => Ok(header)
		NeedMore(_) => Err("unexpected incomplete frame header")
		Invalid(_) => Err("unexpected invalid frame header")
	end
end

fn consumed_count(step: DecodeStep<{length: Int, kind: Int, flags: Int, stream_id: Int}>) -> Int
	match step
		Decoded(_, consumed) => byte_count_to_int(consumed)
		NeedMore(_) => 0
		Invalid(_) => 0
	end
end

fn emit_header(header: {length: Int, kind: Int, flags: Int, stream_id: Int}) -> () effects [stdio]
	stdio::print(int_to_string(header.length))
	stdio::print(" ")
	stdio::print(int_to_string(header.kind))
	stdio::print(" ")
	stdio::print(int_to_string(header.flags))
	stdio::print(" ")
	stdio::println(int_to_string(header.stream_id))
end

pub fn main() -> Result<(), String> effects [stdio]
	let bytes = byte_chunk_from_hex("000005010400000001")?
	let offset = byte_offset(0)?
	let count = byte_count(9)?
	let view = byte_view(bytes, offset, count)?
	let step = decode Http2FrameHeaderWire from view at offset
	let header = decoded_header(step)?
	emit_header(header)
	stdio::println(int_to_string(consumed_count(step)))
	Ok(())
end
