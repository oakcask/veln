# Recursive closed-dispatch failures keep the outer payload and nested field path.
type Node
	Node {kind: Int, value: Int, child: Option<Node>}
end

schema RecursiveNode
	format binary

	length: UInt8
	kind: UInt8
	payload: Dispatch(kind, length, 0 => UInt8, 1 => RecursiveNode)

	map to Node when kind == 0
		kind = kind
		value = payload
		child = None

	map to Node when kind == 1
		kind = kind
		value = payload.value
		child = Some(Node(payload.kind, payload.value, payload.child))
end

pub fn main() -> Result<(), String>
	let bytes: ByteChunk = byte_chunk_from_hex("02010101")?
	let view: ByteView = byte_view(bytes, byte_offset(0)?, byte_count(4)?)?
	let ignored: {kind: Int, value: Int, child: Option<Node>} = byte_decode_recursive_node(view)?
	Ok(())
end
