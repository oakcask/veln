use stdio

schema PackedSuffixHeader
	format binary

	prefix: UInt8
	control: UInt3
	control_padding: ReservedBits(5, 0)
	suffix: UInt8
end

pub fn main() -> Result<(), String> effects [stdio]
	let bytes: ByteChunk = byte_chunk_from_hex("12a134")?
	let offset: ByteOffset = byte_offset(0)?
	let count: ByteCount = byte_count(3)?
	let view: ByteView = byte_view(bytes, offset, count)?
	let ignored: {prefix: Int, control: Int, suffix: Int} = byte_decode_packed_suffix_header(view)?
	stdio::println(int_to_string(ignored.control))
	Ok(())
end
