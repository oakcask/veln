use stdio

schema ExtensionDispatchWritePacket
	format binary

	length: UInt8
	kind: UInt8
	payload: ExtensionDispatch(kind, length, 1 => UInt16be, 2 => UInt32be)
end

fn error_id(error: EncodeError) -> String
	match error
		EncodeError(id, _, _) => id
	end
end

fn error_path(error: EncodeError) -> String
	match error
		EncodeError(_, field_path, _) => field_path
	end
end

fn error_reason(error: EncodeError) -> String
	match error
		EncodeError(_, _, reason) => reason
	end
end

fn emit_error(error: EncodeError) -> () effects [stdio]
	stdio::println(error_id(error))
	stdio::println(error_path(error))
	stdio::println(error_reason(error))
end

fn emit_error_result(error: EncodeError) -> Result<(), String> effects [stdio]
	emit_error(error)
	Ok(())
end

pub fn main() -> Result<(), String> effects [stdio]
	let raw: ByteChunk = byte_chunk_from_hex("aabb")?
	let view: ByteView = byte_view(raw, byte_offset(0)?, byte_count(2)?)?
	let encoded: Result<ByteChunk, EncodeError> = byte_encode_extension_dispatch_write_packet({length: 2, kind: 1, payload: Unknown(7, view)})
	match encoded
		Ok(_) => Err("unexpected encode success")
		Err(error) => emit_error_result(error)
	end
end
