# HTTP/2 continuation ordering failures project structured runtime details.

type Http2ProtocolFailure
	ContinuationExpected({offset: Int, actual_kind: Int, actual_stream: Int, expected_stream: Int, started_kind: Int, started_offset: Int, preview: ByteView})
end

type Http2DiagnosticContext
	DiagnosticContext(String)
end

fn context_active_continuation(context: Http2DiagnosticContext) -> String
	match context
		DiagnosticContext(active_continuation) => active_continuation
	end
end

fn http2_protocol_diagnostic(failure: Http2ProtocolFailure, context: Http2DiagnosticContext) -> Result<(), String>
	match failure
		ContinuationExpected(payload) => http2_protocol_continuation_expected(payload.offset, payload.actual_kind, payload.actual_stream, payload.expected_stream, payload.started_kind, payload.started_offset, context_active_continuation(context), payload.preview)
	end
end

pub fn main() -> Result<(), String>
	let bytes: ByteChunk = byte_chunk_from_hex("000000000000000001")?
	let preview: ByteView = byte_view(bytes, byte_offset(0)?, byte_count(9)?)?
	let context: Http2DiagnosticContext = DiagnosticContext("headers")
	http2_protocol_diagnostic(ContinuationExpected({offset: 9, actual_kind: 0, actual_stream: 1, expected_stream: 1, started_kind: 1, started_offset: 0, preview: preview}), context)
end
