# Binary schema mapping can carry a Flag40le field into a target record.
use stdio

type FlagPacket
	FlagPacket {target_flags: Flag40le}
end

schema FlagPacketWire
	format binary

	flags: Flag40le

	map to FlagPacket
		target_flags = flags
end

fn flag_bits(flags: Flag40le) -> Int
	match flags
		Flag40le(bits) => bits
	end
end

pub fn main() -> Result<(), String> effects [stdio]
	let bytes: ByteChunk = byte_chunk_from_hex("9a78563412")?
	let view: ByteView = byte_view(bytes, byte_offset(0)?, byte_count(5)?)?
	let packet: {target_flags: Flag40le} = byte_decode_flag_packet_wire(view)?
	stdio::println(int_to_string(flag_bits(packet.target_flags)))
	Ok(())
end
