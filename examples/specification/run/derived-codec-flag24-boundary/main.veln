# Derived codec calls preserve generated Flag24 helper behavior.
use stdio

schema Flag24ControlPacket
	format binary

	flags_be: Flag24be
	flags_le: Flag24le
end

codec Flag24ControlCodec for Flag24ControlPacket decode encode
	derive decode
	derive encode
end

fn flag24be_bits_value(flags: Flag24be) -> Int
	match flags
		Flag24be(bits) => bits
	end
end

fn flag24le_bits_value(flags: Flag24le) -> Int
	match flags
		Flag24le(bits) => bits
	end
end

fn decode_step_kind(step: DecodeStep<{flags_be: Flag24be, flags_le: Flag24le}>) -> String
	match step
		Decoded(_, _) => "decoded"
		NeedMore(_) => "need_more"
		Invalid(_) => "invalid"
	end
end

fn flags_be_bits(step: DecodeStep<{flags_be: Flag24be, flags_le: Flag24le}>) -> Int
	match step
		Decoded(value, _) => flag24be_bits_value(value.flags_be)
		NeedMore(_) => -1
		Invalid(_) => -1
	end
end

fn flags_le_bits(step: DecodeStep<{flags_be: Flag24be, flags_le: Flag24le}>) -> Int
	match step
		Decoded(value, _) => flag24le_bits_value(value.flags_le)
		NeedMore(_) => -1
		Invalid(_) => -1
	end
end

fn consumed_count(step: DecodeStep<{flags_be: Flag24be, flags_le: Flag24le}>) -> Int
	match step
		Decoded(_, consumed) => byte_count_to_int(consumed)
		NeedMore(_) => 0
		Invalid(_) => 0
	end
end

fn readiness_kind(step: DecodeStep<{flags_be: Flag24be, flags_le: Flag24le}>) -> String
	match step
		Decoded(_, _) => "none"
		NeedMore(NeedBytes(_)) => "need_bytes"
		NeedMore(NeedEnd) => "need_end"
		Invalid(_) => "none"
	end
end

fn readiness_count(step: DecodeStep<{flags_be: Flag24be, flags_le: Flag24le}>) -> Int
	match step
		Decoded(_, _) => 0
		NeedMore(NeedBytes(count)) => byte_count_to_int(count)
		NeedMore(NeedEnd) => 0
		Invalid(_) => 0
	end
end

fn encode_step_kind(step: EncodeStep<{flags_be: Flag24be, flags_le: Flag24le, encoded_offset: ByteCount}>) -> String
	match step
		Encoded(_) => "encoded"
		Partial(_, _, _) => "partial"
		Invalid(_) => "invalid"
	end
end

fn direct_encode_step_kind(step: EncodeStep<()>) -> String
	match step
		Encoded(_) => "encoded"
		Partial(_, _, _) => "partial"
		Invalid(_) => "invalid"
	end
end

fn emitted_bytes(step: EncodeStep<{flags_be: Flag24be, flags_le: Flag24le, encoded_offset: ByteCount}>) -> Int
	match step
		Encoded(Cons(chunk, Nil)) => byte_count_to_int(byte_chunk_count(chunk))
		Encoded(_) => 0
		Partial(_, produced, _) => byte_count_to_int(produced)
		Invalid(_) => 0
	end
end

fn encoded_offset(step: EncodeStep<{flags_be: Flag24be, flags_le: Flag24le, encoded_offset: ByteCount}>) -> Int
	match step
		Encoded(_) => 0
		Partial(_, _, state) => byte_count_to_int(state.encoded_offset)
		Invalid(_) => 0
	end
end

fn error_id(step: EncodeStep<{flags_be: Flag24be, flags_le: Flag24le, encoded_offset: ByteCount}>) -> String
	match step
		Encoded(_) => "none"
		Partial(_, _, _) => "none"
		Invalid(EncodeError(id, _, _)) => id
	end
end

fn error_path(step: EncodeStep<{flags_be: Flag24be, flags_le: Flag24le, encoded_offset: ByteCount}>) -> String
	match step
		Encoded(_) => "none"
		Partial(_, _, _) => "none"
		Invalid(EncodeError(_, path, _)) => path
	end
end

fn error_reason(step: EncodeStep<{flags_be: Flag24be, flags_le: Flag24le, encoded_offset: ByteCount}>) -> String
	match step
		Encoded(_) => "none"
		Partial(_, _, _) => "none"
		Invalid(EncodeError(_, _, reason)) => reason
	end
end

fn partial_state(step: EncodeStep<{flags_be: Flag24be, flags_le: Flag24le, encoded_offset: ByteCount}>) -> Result<{flags_be: Flag24be, flags_le: Flag24le, encoded_offset: ByteCount}, String>
	match step
		Encoded(_) => Err("expected partial encode")
		Partial(_, _, state) => Ok(state)
		Invalid(_) => Err("expected partial encode")
	end
end

fn emit_output_chunk(name: String, index: Int, chunk: ByteChunk, expected_hex: String) -> () effects [stdio]
	stdio::print("output_chunk ")
	stdio::print(name)
	stdio::print(" index ")
	stdio::print(int_to_string(index))
	stdio::print(" hex \"")
	stdio::print(expected_hex)
	stdio::print("\" count ")
	stdio::println(int_to_string(byte_count_to_int(byte_chunk_count(chunk))))
end

fn emit_one_chunk(name: String, chunk: ByteChunk, expected_hex: String) -> () effects [stdio]
	stdio::print("output_chunk_list ")
	stdio::print(name)
	stdio::println(" count 1")
	emit_output_chunk(name, 0, chunk, expected_hex)
end

fn emit_step_chunk(name: String, step: EncodeStep<{flags_be: Flag24be, flags_le: Flag24le, encoded_offset: ByteCount}>, expected_hex: String) -> () effects [stdio]
	match step
		Encoded(Cons(chunk, Nil)) => emit_one_chunk(name, chunk, expected_hex)
		Partial(Cons(chunk, Nil), _, _) => emit_one_chunk(name, chunk, expected_hex)
		Encoded(_) => stdio::println("unexpected encoded chunk count")
		Partial(_, _, _) => stdio::println("unexpected partial chunk count")
		Invalid(_) => stdio::println("unexpected encode failure")
	end
end

fn emit_direct_step_chunk(name: String, step: EncodeStep<()>, expected_hex: String) -> () effects [stdio]
	match step
		Encoded(Cons(chunk, Nil)) => emit_one_chunk(name, chunk, expected_hex)
		Encoded(_) => stdio::println("unexpected encoded chunk count")
		Partial(_, _, _) => stdio::println("unexpected partial encode")
		Invalid(_) => stdio::println("unexpected encode failure")
	end
end

pub fn main() -> Result<(), String> effects [stdio]
	let bytes: ByteChunk = byte_chunk_from_hex("123456563412")?
	let full_view: ByteView = byte_view(bytes, byte_offset(0)?, byte_count(6)?)?
	let decoded: DecodeStep<{flags_be: Flag24be, flags_le: Flag24le}> = Flag24ControlCodec(full_view, byte_offset(12)?)
	stdio::println(decode_step_kind(decoded))
	stdio::println(int_to_string(flags_be_bits(decoded)))
	stdio::println(int_to_string(flags_le_bits(decoded)))
	stdio::println(int_to_string(consumed_count(decoded)))

	let short_view: ByteView = byte_view(bytes, byte_offset(0)?, byte_count(4)?)?
	let waiting: DecodeStep<{flags_be: Flag24be, flags_le: Flag24le}> = Flag24ControlCodec(short_view, byte_offset(12)?)
	stdio::println(decode_step_kind(waiting))
	stdio::println(readiness_kind(waiting))
	stdio::println(int_to_string(readiness_count(waiting)))
	stdio::println(int_to_string(consumed_count(waiting)))

	let value: {flags_be: Flag24be, flags_le: Flag24le} = {flags_be: Flag24be(1193046), flags_le: Flag24le(1193046)}
	let encoded: EncodeStep<()> = Flag24ControlCodec(value)
	stdio::println(direct_encode_step_kind(encoded))
	emit_direct_step_chunk("flag24-derived-encoded", encoded, "123456563412")

	let partial: EncodeStep<{flags_be: Flag24be, flags_le: Flag24le, encoded_offset: ByteCount}> = Flag24ControlCodec(value, byte_count(2)?)
	stdio::println(encode_step_kind(partial))
	stdio::println(int_to_string(emitted_bytes(partial)))
	stdio::println(int_to_string(encoded_offset(partial)))
	emit_step_chunk("flag24-derived-partial", partial, "1234")

	let resume: {flags_be: Flag24be, flags_le: Flag24le, encoded_offset: ByteCount} = partial_state(partial)?
	let resumed: EncodeStep<{flags_be: Flag24be, flags_le: Flag24le, encoded_offset: ByteCount}> = Flag24ControlCodec(resume, byte_count(4)?)
	stdio::println(encode_step_kind(resumed))
	stdio::println(int_to_string(emitted_bytes(resumed)))
	emit_step_chunk("flag24-derived-resume", resumed, "56563412")

	let invalid: EncodeStep<{flags_be: Flag24be, flags_le: Flag24le, encoded_offset: ByteCount}> = Flag24ControlCodec({flags_be: Flag24be(16777216), flags_le: Flag24le(1193046)}, byte_count(6)?)
	stdio::println(encode_step_kind(invalid))
	stdio::println(error_id(invalid))
	stdio::println(error_path(invalid))
	stdio::println(error_reason(invalid))
	Ok(())
end
