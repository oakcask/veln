# Binary schema mapping can carry a Flag56le field into a target record.
use stdio

type FlagPacket
	FlagPacket {target_flags: Flag56le}
end

schema FlagPacketWire
	format binary

	flags: Flag56le

	map to FlagPacket
		target_flags = flags
end

fn flag_bits(flags: Flag56le) -> Int
	match flags
		Flag56le(bits) => bits
	end
end

pub fn main() -> Result<(), String> effects [stdio]
	let bytes: ByteChunk = byte_chunk_from_hex("debc9a78563412")?
	let view: ByteView = byte_view(bytes, byte_offset(0)?, byte_count(7)?)?
	let packet: {target_flags: Flag56le} = byte_decode_flag_packet_wire(view)?
	stdio::println(int_to_string(flag_bits(packet.target_flags)))
	Ok(())
end
