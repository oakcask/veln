# HTTP/2 stream id domain failures project to human diagnostics.

schema Http2FrameHeaderWire
	format binary

	length: UInt24be
	kind: UInt8
	flags: UInt8
	stream_reserved: ReservedBits(1, 0)
	stream_id: UInt31be
end

type Http2ProtocolFailure
	InvalidStreamId(Int, Int, Int, String, String, ByteView)
end

type Http2DiagnosticContext
	DiagnosticContext(String, String)
end

type Http2Step
	FrameOk(Int)
	Waiting
	Failed(Http2ProtocolFailure)
end

fn receive(bytes: ByteChunk) -> Result<Http2Step, String>
	let available: Int = byte_count_to_int(byte_chunk_count(bytes))
	match available < 9
		true => Ok(Waiting)
		false => decode_header(bytes)
	end
end

fn decode_header(bytes: ByteChunk) -> Result<Http2Step, String>
	let zero: ByteOffset = byte_offset(0)?
	let header_count: ByteCount = byte_count(9)?
	let view: ByteView = byte_view(bytes, zero, header_count)?
	let header: {length: Int, kind: Int, flags: Int, stream_id: Int} = byte_decode_http2_frame_header_wire(view)?
	validate_stream_id_domain(0, header.kind, header.stream_id, view)
end

fn validate_stream_id_domain(offset: Int, kind: Int, stream_id: Int, preview: ByteView) -> Result<Http2Step, String>
	match kind == 1
		true => match stream_id == 0
			true => Ok(Failed(InvalidStreamId(offset, kind, stream_id, "nonzero client-initiated stream id", "server", preview)))
			false => Ok(FrameOk(kind))
		end
		false => Ok(FrameOk(kind))
	end
end

fn context_active_state(context: Http2DiagnosticContext) -> String
	match context
		DiagnosticContext(active_state, _) => active_state
	end
end

fn context_rule_provenance(context: Http2DiagnosticContext) -> String
	match context
		DiagnosticContext(_, rule_provenance) => rule_provenance
	end
end

fn http2_protocol_diagnostic(failure: Http2ProtocolFailure, context: Http2DiagnosticContext) -> Result<(), String>
	match failure
		InvalidStreamId(offset, frame_kind, stream_id, required_domain, endpoint_role, preview) => http2_protocol_invalid_stream_id(offset, frame_kind, stream_id, required_domain, endpoint_role, context_active_state(context), context_rule_provenance(context), preview)
	end
end

pub fn main() -> Result<(), String>
	let step: Http2Step = receive(byte_chunk_from_hex("000000010400000000")?)?
	let context: Http2DiagnosticContext = DiagnosticContext("stream-id-domain", "server_receives_client_initiated_streams")
	match step
		Failed(failure) => http2_protocol_diagnostic(failure, context)
		FrameOk(_) => Ok(())
		Waiting => Ok(())
	end
end
