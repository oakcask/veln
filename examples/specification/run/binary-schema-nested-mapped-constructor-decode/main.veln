# Binary schema mapping can nest ADT constructor expressions during decode.
use stdio

type Payload
	Payload(Int)
end

type Envelope
	Envelope(Payload)
end

type Header
	Header {wrapped: Envelope}
end

schema HeaderWire
	format binary

	kind: UInt8

	map to Header
		wrapped = Envelope(Payload(kind))
end

fn emit_payload(envelope: Envelope) -> () effects [stdio]
	match envelope
		Envelope(payload) => emit_payload_value(payload)
	end
end

fn emit_payload_value(payload: Payload) -> () effects [stdio]
	match payload
		Payload(value) => stdio::println(int_to_string(value))
	end
end

pub fn main() -> Result<(), String> effects [stdio]
	let bytes: ByteChunk = byte_chunk_from_hex("05")?
	let offset: ByteOffset = byte_offset(0)?
	let count: ByteCount = byte_count(1)?
	let view: ByteView = byte_view(bytes, offset, count)?
	let header: {wrapped: Envelope} = byte_decode_header_wire(view)?
	emit_payload(header.wrapped)
	Ok(())
end
