# HTTP/2 header-list peer-limit failures project to human runtime diagnostics.

type Http2ProtocolFailure
	HeaderListSizeExceeded(Int, Int, Int, Int, Int, String, String)
end

fn project(failure: Http2ProtocolFailure) -> Result<(), String>
	match failure
		HeaderListSizeExceeded(offset, observed_size, allowed_size, frame_kind, stream_id, receive_limit_provenance, rule_provenance) => http2_peer_limit_header_list_size_exceeded(offset, observed_size, allowed_size, frame_kind, stream_id, receive_limit_provenance, rule_provenance)
	end
end

pub fn main() -> Result<(), String>
	project(HeaderListSizeExceeded(12, 10, 9, 9, 1, "local_configuration", "header_list_receive_limit"))
end
