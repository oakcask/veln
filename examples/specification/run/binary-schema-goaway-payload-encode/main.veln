use stdio

schema Http2GoawayPayloadWire
	format binary

	last_stream_reserved: ReservedBits(1, 0)
	last_stream_id: UInt31be
	error_code: UInt32be
end

fn emit_output_chunk(name: String, index: Int, chunk: ByteChunk, expected_hex: String) -> () effects [stdio]
	stdio::print("output_chunk ")
	stdio::print(name)
	stdio::print(" index ")
	stdio::print(int_to_string(index))
	stdio::print(" hex \"")
	stdio::print(expected_hex)
	stdio::print("\" count ")
	stdio::println(int_to_string(byte_count_to_int(byte_chunk_count(chunk))))
end

fn emit_output_chunk_list_header(name: String, count: Int) -> () effects [stdio]
	stdio::print("output_chunk_list ")
	stdio::print(name)
	stdio::print(" count ")
	stdio::println(int_to_string(count))
end

fn error_id(error: EncodeError) -> String
	match error
		EncodeError(id, _, _) => id
	end
end

fn error_path(error: EncodeError) -> String
	match error
		EncodeError(_, field_path, _) => field_path
	end
end

fn error_reason(error: EncodeError) -> String
	match error
		EncodeError(_, _, reason) => reason
	end
end

fn emit_error(label: String, error: EncodeError) -> () effects [stdio]
	stdio::print(label)
	stdio::print(" ")
	stdio::print(error_id(error))
	stdio::print(" ")
	stdio::print(error_path(error))
	stdio::print(" ")
	stdio::println(error_reason(error))
end

fn emit_encoded_chunk(bytes: ByteChunk) -> () effects [stdio]
	emit_output_chunk_list_header("goaway-payload", 1)
	emit_output_chunk("goaway-payload", 0, bytes, "000000050000000b")
end

fn emit_encoded(encoded: Result<ByteChunk, EncodeError>) -> () effects [stdio]
	match encoded
		Ok(bytes) => emit_encoded_chunk(bytes)
		Err(_) => stdio::println("unexpected encode failure")
	end
end

fn emit_encode_error(label: String, encoded: Result<ByteChunk, EncodeError>) -> () effects [stdio]
	match encoded
		Ok(_) => stdio::println("unexpected encode success")
		Err(error) => emit_error(label, error)
	end
end

pub fn main() -> () effects [stdio]
	let encoded: Result<ByteChunk, EncodeError> = byte_encode_http2_goaway_payload_wire({last_stream_id: 5, error_code: 11})
	emit_encoded(encoded)

	let bad_last_stream_id: Result<ByteChunk, EncodeError> = byte_encode_http2_goaway_payload_wire({last_stream_id: 2147483648, error_code: 11})
	emit_encode_error("last-stream-id", bad_last_stream_id)

	let bad_error_code: Result<ByteChunk, EncodeError> = byte_encode_http2_goaway_payload_wire({last_stream_id: 5, error_code: 4294967296})
	emit_encode_error("error-code", bad_error_code)
end
