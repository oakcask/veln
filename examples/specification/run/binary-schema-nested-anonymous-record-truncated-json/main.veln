# Binary schema nested anonymous record truncation reports all record segments.

schema NestedAnonymousRecordPacket
	format binary

	prefix: UInt8
	header: {kind: UInt8, detail: {code: UInt16be, tail: UInt16le}, marker: UInt8}
	suffix: UInt8
end

pub fn main() -> Result<(), String>
	let bytes: ByteChunk = byte_chunk_from_hex("0a01020304")?
	let view: ByteView = byte_view(bytes, byte_offset(0)?, byte_count(5)?)?
	let _: {prefix: Int, header: {kind: Int, detail: {code: Int, tail: Int}, marker: Int}, suffix: Int} = byte_decode_nested_anonymous_record_packet(view)?
	Ok(())
end
