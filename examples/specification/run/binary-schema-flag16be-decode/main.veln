# Binary schema Flag16be fields decode as source-visible bitset values.
use stdio

schema FlagPacket
	format binary

	flags: Flag16be
end

fn flag_bits(flags: Flag16be) -> Int
	match flags
		Flag16be(bits) => bits
	end
end

pub fn main() -> Result<(), String> effects [stdio]
	let bytes: ByteChunk = byte_chunk_from_hex("1234")?
	let offset: ByteOffset = byte_offset(0)?
	let count: ByteCount = byte_count(2)?
	let view: ByteView = byte_view(bytes, offset, count)?
	let packet: {flags: Flag16be} = byte_decode_flag_packet(view)?
	stdio::println(int_to_string(flag_bits(packet.flags)))
	Ok(())
end
