type State
	Ready
	Closed
end

type Producer<T>
	Produced(value: T)
end

pub fn main() -> () effects [stdio]
	stdio::println("forbidden")
	()
end

fn ready(value: State::Ready) -> Int
	1
end

fn rejected(value: Producer<State>) -> Producer<State::Ready>
	let callback: fn(State) -> Int = ready
	value
end
