# HTTP/2 continuation ordering failures project to human runtime diagnostics.

type Http2ProtocolFailure
	ContinuationExpected(Int, Int, Int, Int, Int, Int, ByteView)
end

type Http2DiagnosticContext
	DiagnosticContext(String)
end

fn context_active_continuation(context: Http2DiagnosticContext) -> String
	match context
		DiagnosticContext(active_continuation) => active_continuation
	end
end

fn http2_protocol_diagnostic(failure: Http2ProtocolFailure, context: Http2DiagnosticContext) -> Result<(), String>
	match failure
		ContinuationExpected(offset, actual_kind, actual_stream, expected_stream, started_kind, started_offset, preview) => http2_protocol_continuation_expected(offset, actual_kind, actual_stream, expected_stream, started_kind, started_offset, context_active_continuation(context), preview)
	end
end

pub fn main() -> Result<(), String>
	let bytes: ByteChunk = byte_chunk_from_hex("000000000000000001")?
	let preview: ByteView = byte_view(bytes, byte_offset(0)?, byte_count(9)?)?
	let context: Http2DiagnosticContext = DiagnosticContext("headers")
	http2_protocol_diagnostic(ContinuationExpected(9, 0, 1, 1, 1, 0, preview), context)
end
