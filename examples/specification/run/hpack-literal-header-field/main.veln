use http2::hpack from "std"
use stdio

fn require_transition(input: ByteChunk, table: DynamicTable) -> Result<LiteralDecodeTransition, String>
	match http2::hpack::decode_literal_header_field(byte_view(input, byte_offset(0)?, byte_chunk_count(input))?, table)
		Ok(transition) => Ok(transition)
		Err(failure) => Err(http2::hpack::literal_decode_failure_kind(failure))
	end
end

fn first_octet(chunk: ByteChunk) -> Result<Int, String>
	byte_read_u8_be(byte_view(chunk, byte_offset(0)?, byte_count(1)?)?)
end

fn print_transition(label: String, transition: LiteralDecodeTransition) -> Result<(), String> effects [stdio]
	let header: LiteralHeaderField = http2::hpack::literal_decode_header(transition)
	stdio::print(label)
	stdio::print(" ")
	stdio::print(http2::hpack::literal_decode_representation(transition))
	stdio::print(" ")
	stdio::print(http2::hpack::literal_header_name(header))
	stdio::print(" ")
	stdio::print(int_to_string(first_octet(http2::hpack::literal_header_value(header))?))
	stdio::print(" ")
	stdio::print(int_to_string(http2::hpack::literal_decode_consumed(transition)))
	stdio::print(" ")
	stdio::println(int_to_string(http2::hpack::dynamic_table_entry_count(http2::hpack::literal_decode_table(transition))))
	Ok(())
end

fn print_failure(label: String, input: ByteChunk, table: DynamicTable) -> Result<(), String> effects [stdio]
	match http2::hpack::decode_literal_header_field(byte_view(input, byte_offset(0)?, byte_chunk_count(input))?, table)
		Ok(_) => Err("expected literal header decoding to fail")
		Err(failure) => print_failure_value(label, failure)
	end
end

fn print_failure_value(label: String, failure: LiteralDecodeFailure) -> Result<(), String> effects [stdio]
	stdio::print(label)
	stdio::print(" ")
	stdio::print(http2::hpack::literal_decode_failure_kind(failure))
	stdio::print(" ")
	stdio::print(int_to_string(http2::hpack::literal_decode_failure_index(failure)))
	stdio::print(" ")
	stdio::print(int_to_string(http2::hpack::literal_decode_failure_expected_octets(failure)))
	stdio::print(" ")
	stdio::println(int_to_string(http2::hpack::literal_decode_failure_available_octets(failure)))
	Ok(())
end

pub fn main() -> Result<(), String> effects [stdio]
	let empty: DynamicTable = http2::hpack::empty_dynamic_table(256)?
	let table: DynamicTable = http2::hpack::insert_dynamic_table_entry(empty, "older", byte_chunk_from_hex("31")?)?
	let incremental: LiteralDecodeTransition = require_transition(byte_chunk_from_hex("4001780200ff")?, table)?
	let _ = print_transition("incremental", incremental)?
	let dynamic_name: LiteralDecodeTransition = require_transition(byte_chunk_from_hex("0f2f8349509f")?, table)?
	let _ = print_transition("dynamic-name", dynamic_name)?
	let never: LiteralDecodeTransition = require_transition(byte_chunk_from_hex("1485ffc7ffffdd")?, table)?
	let _ = print_transition("never", never)?
	let _ = print_failure("unavailable", byte_chunk_from_hex("0f3000")?, table)?
	let _ = print_failure("truncated", byte_chunk_from_hex("040378")?, table)?
	let _ = print_failure("huffman", byte_chunk_from_hex("048100")?, table)?
	stdio::print("original ")
	stdio::print(int_to_string(http2::hpack::dynamic_table_size(table)))
	stdio::print(" ")
	stdio::println(int_to_string(http2::hpack::dynamic_table_entry_count(table)))
	Ok(())
end
