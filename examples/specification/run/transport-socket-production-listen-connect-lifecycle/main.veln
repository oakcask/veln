use net from "std"
use fixture_effects
use fake_effects
# Production loopback connects a source-owned client stream to a source-owned listener.
use stdio

fn read_bytes(outcome: net::ReadOutcome) -> ByteChunk
	match outcome
		net::ReadChunk(bytes) => bytes
		net::ReadEnd => byte_chunk([])
	end
end

fn bytes(text: String) -> Result<ByteChunk, net::NetError>
	match byte_chunk_from_hex(text)
		Ok(value) => Ok(value)
		Err(message) => Err(net::NetError("fixture_bytes", None, None, net::Other, message))
	end
end

fn listener_ended(listener: net::Listener) -> Bool effects [net::IO]
	match net::accept(listener)
		Ok(_) => false
		Err(_) => true
	end
end

fn bool_text(value: Bool) -> String
	if value
		"true"
	else
		"false"
	end
end

fn fixture_body() -> Result<(), net::NetError> effects [net::IO, stdio]
	let address = net::Address(net::Tcp4, "127.0.0.1", 0)
	let listener = net::listen(address)?
	let client = net::connect(address)?
	let server = net::accept(listener)?
	let outgoing = bytes("7f")?
	let _ = net::write_all(client, outgoing, None, None)?
	let server_read = read_bytes(net::read(server)?)
	let _ = net::write_all(server, server_read, None, None)?
	let client_read = read_bytes(net::read(client)?)
	let server_count = byte_count_to_int(byte_chunk_count(server_read))
	let client_count = byte_count_to_int(byte_chunk_count(client_read))
	let _ = net::close_stream(server)?
	let _ = net::close_stream(client)?
	let clean_end = listener_ended(listener)
	let _ = net::close_listener(listener)?
	stdio::print("server ")
	stdio::print(int_to_string(server_count))
	stdio::print(" client ")
	stdio::print(int_to_string(client_count))
	stdio::print(" clean-end ")
	stdio::println(bool_text(clean_end))
	Ok(())
end

pub fn main() -> Result<(), net::NetError> effects [concurrency, fs, net, stdio, time]
	let state = fixture_effects::create_fixture()
	handle handle handle fixture_body() with net::system() with fake_effects::network(state) with fake_effects::clock(state)
end
