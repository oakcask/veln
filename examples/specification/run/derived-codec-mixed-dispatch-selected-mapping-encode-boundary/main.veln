# Derived encode uses the selected mixed dispatch mapping helper boundary.
use stdio

type Settings
	Settings {code: Int, value: Int}
end

type PacketPayload
	InlineValue(Int)
	SettingsValue({code: Int, value: Int})
end

type Packet
	Packet {kind: Int, body: PacketPayload}
end

schema SettingsPayload
	format binary

	code: UInt8
	value: UInt16be

	map to Settings
		code = code
		value = value
end

schema PacketWire
	format binary

	kind: UInt8
	payload: Dispatch(kind, 1 => UInt8, 2 => SettingsPayload)

	map to Packet when kind == 1
		kind = kind
		body = InlineValue(payload)

	map to Packet when kind == 2
		kind = kind
		body = SettingsValue(payload)
end

codec PacketCodec for PacketWire encode
	derive encode
end

fn emit_output_chunk(name: String, index: Int, chunk: ByteChunk, expected_hex: String) -> () effects [stdio]
	stdio::print("output_chunk ")
	stdio::print(name)
	stdio::print(" index ")
	stdio::print(int_to_string(index))
	stdio::print(" hex \"")
	stdio::print(expected_hex)
	stdio::print("\" count ")
	stdio::println(int_to_string(byte_count_to_int(byte_chunk_count(chunk))))
end

fn emit_encoded_chunk(name: String, chunk: ByteChunk, expected_hex: String) -> () effects [stdio]
	stdio::print("output_chunk_list ")
	stdio::print(name)
	stdio::println(" count 1")
	emit_output_chunk(name, 0, chunk, expected_hex)
end

fn emit_encoded(name: String, step: EncodeStep<()>, expected_hex: String) -> () effects [stdio]
	match step
		Encoded(Cons(chunk, Nil)) => emit_encoded_chunk(name, chunk, expected_hex)
		Encoded(_) => stdio::println("unexpected chunk count")
		Partial(_, _, _) => stdio::println("unexpected partial encode")
		Invalid(_) => stdio::println("unexpected encode failure")
	end
end

fn error_id(error: EncodeError) -> String
	match error
		EncodeError(id, _, _) => id
	end
end

fn error_path(error: EncodeError) -> String
	match error
		EncodeError(_, field_path, _) => field_path
	end
end

fn error_reason(error: EncodeError) -> String
	match error
		EncodeError(_, _, reason) => reason
	end
end

fn emit_error_value(label: String, error: EncodeError) -> () effects [stdio]
	stdio::println(label)
	stdio::println(error_id(error))
	stdio::println(error_path(error))
	stdio::println(error_reason(error))
end

fn emit_invalid(label: String, step: EncodeStep<()>) -> () effects [stdio]
	match step
		Encoded(_) => stdio::println("unexpected encode success")
		Partial(_, _, _) => stdio::println("unexpected partial encode")
		Invalid(error) => emit_error_value(label, error)
	end
end

pub fn main() -> () effects [stdio]
	let inline: EncodeStep<()> = PacketCodec({kind: 1, body: InlineValue(7)})
	let settings: EncodeStep<()> = PacketCodec({kind: 2, body: SettingsValue({code: 9, value: 255})})
	emit_encoded("derived-mixed-inline", inline, "0107")
	emit_encoded("derived-mixed-settings", settings, "020900ff")

	let invalid: EncodeStep<()> = PacketCodec({kind: 2, body: SettingsValue({code: 9, value: 70000})})
	emit_invalid("derived-nested-error", invalid)
	let unknown_tag: EncodeStep<()> = PacketCodec({kind: 7, body: InlineValue(1)})
	let payload_mismatch: EncodeStep<()> = PacketCodec({kind: 2, body: InlineValue(1)})
	emit_invalid("derived-unknown-tag", unknown_tag)
	emit_invalid("derived-payload-mismatch", payload_mismatch)
end
