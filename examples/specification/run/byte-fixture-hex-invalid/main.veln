# Compact hex fixtures reject non-hex characters, prefixes, and separators.
use stdio

fn error_text(result: Result<ByteChunk, String>) -> String
	match result
		Ok(_) => "unexpected success"
		Err(error) => error
	end
end

pub fn main() -> Result<(), String> effects [stdio]
	stdio::println(error_text(byte_chunk_from_hex("0x00")))
	stdio::println(error_text(byte_chunk_from_hex("00_01")))
	stdio::println(error_text(byte_chunk_from_hex("00#comment")))
	Ok(())
end
