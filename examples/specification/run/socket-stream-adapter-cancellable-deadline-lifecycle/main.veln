# Cancellable deadline-aware socket lifecycle keeps transport ownership in the adapter.
use stdio

type ResponseAction
	SendBytes(bytes: ByteChunk)
	EndStream
	RetryAfterDeadline
	CleanupAfterCancel
end

fn handle_stream_input(input: StreamInput, state: { chunks : Int, ended : Bool }) -> { actions : List<ResponseAction>, next_state : { chunks : Int, ended : Bool } }
	match input
		Chunk(bytes) => { actions: list_cons(SendBytes(bytes), list_nil()), next_state: { chunks: state.chunks + 1, ended: state.ended } }
		End => { actions: list_cons(EndStream, list_nil()), next_state: { chunks: state.chunks, ended: true } }
	end
end

fn append_actions(left: List<ResponseAction>, right: List<ResponseAction>) -> List<ResponseAction>
	match left
		Nil => right
		Cons(action, tail) => list_cons(action, append_actions(tail, right))
	end
end

fn action_count(actions: List<ResponseAction>) -> Int
	match actions
		Nil => 0
		Cons(_, tail) => 1 + action_count(tail)
	end
end

fn write_count(actions: List<ResponseAction>) -> Int
	match actions
		Nil => 0
		Cons(action, tail) => match action
			SendBytes(_) => 1 + write_count(tail)
			EndStream => write_count(tail)
			RetryAfterDeadline => write_count(tail)
			CleanupAfterCancel => write_count(tail)
		end
	end
end

fn end_count(actions: List<ResponseAction>) -> Int
	match actions
		Nil => 0
		Cons(action, tail) => match action
			SendBytes(_) => end_count(tail)
			EndStream => 1 + end_count(tail)
			RetryAfterDeadline => end_count(tail)
			CleanupAfterCancel => end_count(tail)
		end
	end
end

fn retry_count(actions: List<ResponseAction>) -> Int
	match actions
		Nil => 0
		Cons(action, tail) => match action
			SendBytes(_) => retry_count(tail)
			EndStream => retry_count(tail)
			RetryAfterDeadline => 1 + retry_count(tail)
			CleanupAfterCancel => retry_count(tail)
		end
	end
end

fn cleanup_count(actions: List<ResponseAction>) -> Int
	match actions
		Nil => 0
		Cons(action, tail) => match action
			SendBytes(_) => cleanup_count(tail)
			EndStream => cleanup_count(tail)
			RetryAfterDeadline => cleanup_count(tail)
			CleanupAfterCancel => 1 + cleanup_count(tail)
		end
	end
end

fn route_input(route: { tx : Sender<StreamInput>, rx : Receiver<StreamInput> }, input: StreamInput) -> StreamInput effects [concurrency]
	let _ = channel::send(route.tx, input)
	match channel::recv(route.rx)
		Some(value) => value
		None => End
	end
end

fn read_response(route: { tx : Sender<StreamInput>, rx : Receiver<StreamInput> }, outcome: StreamReadOutcome, state: { chunks : Int, ended : Bool }) -> { actions : List<ResponseAction>, next_state : { chunks : Int, ended : Bool } } effects [concurrency]
	match outcome
		ReadChunk(bytes) => read_stream_input(route, Chunk(bytes), state)
		ReadEnd => read_stream_input(route, End, state)
		ReadDeadlineExpired => { actions: list_cons(RetryAfterDeadline, list_nil()), next_state: state }
		ReadCancelled => { actions: list_cons(CleanupAfterCancel, list_nil()), next_state: state }
	end
end

fn read_stream_input(route: { tx : Sender<StreamInput>, rx : Receiver<StreamInput> }, input: StreamInput, state: { chunks : Int, ended : Bool }) -> { actions : List<ResponseAction>, next_state : { chunks : Int, ended : Bool } } effects [concurrency]
	let handled = handle_stream_input(route_input(route, input), state)
	{ actions: handled.actions, next_state: handled.next_state }
end

fn accept_decision(outcome: AcceptOutcome) -> String
	match outcome
		AcceptStream(_) => "accepted"
		AcceptEnd => "accept-end"
		AcceptDeadlineExpired => "accept-deadline"
		AcceptCancelled => "accept-cancelled"
	end
end

fn collect_lifecycle_actions(stream: NetStream, state: { chunks : Int, ended : Bool }, deadline: Deadline, token: CancelToken) -> { actions : List<ResponseAction>, next_state : { chunks : Int, ended : Bool } } effects [net, time, concurrency]
	let route = channel::bounded<StreamInput>(1)
	let first = read_response(route, net::read_chunk_until_cancellable(stream, deadline, token), state)
	let clean = read_response(route, ReadEnd, first.next_state)
	let late = read_response(route, ReadDeadlineExpired, clean.next_state)
	let cancelled = read_response(route, ReadCancelled, late.next_state)
	{ actions: append_actions(first.actions, append_actions(clean.actions, append_actions(late.actions, cancelled.actions))), next_state: cancelled.next_state }
end

fn apply_response_actions(stream: NetStream, actions: List<ResponseAction>) -> () effects [net]
	match actions
		Nil => ()
		Cons(action, tail) => match action
			SendBytes(bytes) => write_then_apply(stream, bytes, tail)
			EndStream => apply_response_actions(stream, tail)
			RetryAfterDeadline => apply_response_actions(stream, tail)
			CleanupAfterCancel => apply_response_actions(stream, tail)
		end
	end
end

fn write_then_apply(stream: NetStream, bytes: ByteChunk, tail: List<ResponseAction>) -> () effects [net]
	net::write_chunk(stream, bytes)
	apply_response_actions(stream, tail)
end

fn accepted_cancellable_deadline_lifecycle(stream: NetStream, deadline: Deadline, token: CancelToken) -> Result<{ accept : String, actions : List<ResponseAction>, next_state : { chunks : Int, ended : Bool } }, String> effects [net, time, concurrency]
	let routed = collect_lifecycle_actions(stream, { chunks: 0, ended: false }, deadline, token)
	apply_response_actions(stream, routed.actions)
	Ok({ accept: "accepted", actions: routed.actions, next_state: routed.next_state })
end

fn lifecycle_result(address: String) -> Result<{ accept : String, actions : List<ResponseAction>, next_state : { chunks : Int, ended : Bool } }, String> effects [net, time, concurrency]
	let listener: NetListener = net::listen(address)
	let deadline: Deadline = time::deadline_after_ms(100)
	let token: CancelToken = time::cancel_token()
	match net::accept_until_cancellable(listener, deadline, token)
		AcceptStream(stream) => accepted_cancellable_deadline_lifecycle(stream, deadline, token)
		AcceptEnd => Ok({ accept: "accept-end", actions: list_nil(), next_state: { chunks: 0, ended: true } })
		AcceptDeadlineExpired => Ok({ accept: "accept-deadline", actions: list_nil(), next_state: { chunks: 0, ended: false } })
		AcceptCancelled => Ok({ accept: "accept-cancelled", actions: list_nil(), next_state: { chunks: 0, ended: false } })
	end
end

fn bool_text(value: Bool) -> String
	match value
		true => "true"
		false => "false"
	end
end

pub fn main() -> Result<(), String> effects [net, time, concurrency, stdio]
	let routed: { accept : String, actions : List<ResponseAction>, next_state : { chunks : Int, ended : Bool } } = lifecycle_result("127.0.0.1:0")?
	stdio::print("accept ")
	stdio::print(routed.accept)
	stdio::print(" outcomes ")
	stdio::print("chunk,end,deadline,cancelled")
	stdio::print(" actions ")
	stdio::print(int_to_string(action_count(routed.actions)))
	stdio::print(" chunks ")
	stdio::print(int_to_string(routed.next_state.chunks))
	stdio::print(" ended ")
	stdio::print(bool_text(routed.next_state.ended))
	stdio::print(" writes ")
	stdio::print(int_to_string(write_count(routed.actions)))
	stdio::print(" end-actions ")
	stdio::print(int_to_string(end_count(routed.actions)))
	stdio::print(" retries ")
	stdio::print(int_to_string(retry_count(routed.actions)))
	stdio::print(" cleanup ")
	stdio::println(int_to_string(cleanup_count(routed.actions)))
	stdio::print("accept-decisions ")
	stdio::print(accept_decision(AcceptEnd))
	stdio::print(",")
	stdio::print(accept_decision(AcceptDeadlineExpired))
	stdio::print(",")
	stdio::println(accept_decision(AcceptCancelled))
	Ok(())
end
