use fixture_effects
use fake_effects

# Transport-boundary calls expose host-fed chunks, outgoing chunks, and timeouts.
fn receive_host_chunk() -> ByteChunk effects [net]
	net::receive_chunk()
end

fn fixture_body() -> Result<(), String> effects [net, time, stdio]
	let incoming = receive_host_chunk()
	let outgoing = byte_chunk_from_hex("0a0b")?
	let deadline = time::deadline_after_ms(0)
	net::send_chunk(outgoing)
	time::timeout_ms(0)
	time::wait_until(deadline)
	stdio::println(int_to_string(byte_count_to_int(byte_chunk_count(incoming))))
	stdio::println(int_to_string(byte_count_to_int(byte_chunk_count(outgoing))))
	stdio::println("timeout")
	stdio::println("deadline")
	Ok(())
end

pub fn main() -> Result<(), String> effects [concurrency, fs, net, stdio, time]
	let state = fixture_effects::create_fixture()
	handle handle fixture_body() with fake_effects::network(state) with fake_effects::clock(state)
end
