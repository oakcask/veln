# Client connect returns a stream handle with the ordinary socket lifecycle.
use stdio

fn open_client_stream(address: String) -> NetStream effects [net]
	net::connect(address)
end

pub fn main() -> Result<(), String> effects [net, stdio]
	let stream: NetStream = open_client_stream("127.0.0.1:443")
	let local: String = net::stream_local_addr(stream)
	let peer: String = net::stream_peer_addr(stream)
	let outgoing: ByteChunk = byte_chunk_from_hex("0a0b")?
	net::write_chunk(stream, outgoing)
	let incoming: ByteChunk = net::read_chunk(stream)
	net::shutdown_write(stream)
	net::close_stream(stream)
	stdio::print("local ")
	stdio::print(local)
	stdio::print(" peer ")
	stdio::print(peer)
	stdio::print(" read-bytes ")
	stdio::print(int_to_string(byte_count_to_int(byte_chunk_count(incoming))))
	stdio::print(" write-bytes ")
	stdio::println(int_to_string(byte_count_to_int(byte_chunk_count(outgoing))))
	Ok(())
end
