# Binary schema Repeat addition counts encode primitive lists.
use stdio

schema CountedValues
	format binary

	left_count: UInt8
	right_count: UInt8
	items: Repeat(left_count + right_count, UInt16be)
end

fn emit_output_chunk(name: String, index: Int, chunk: ByteChunk, expected_hex: String) -> () effects [stdio]
	stdio::print("output_chunk ")
	stdio::print(name)
	stdio::print(" index ")
	stdio::print(int_to_string(index))
	stdio::print(" hex \"")
	stdio::print(expected_hex)
	stdio::print("\" count ")
	stdio::println(int_to_string(byte_count_to_int(byte_chunk_count(chunk))))
end

fn emit_encoded(bytes: ByteChunk) -> () effects [stdio]
	stdio::println("output_chunk_list counted-values-add count 1")
	emit_output_chunk("counted-values-add", 0, bytes, "0203000100020003000400ff")
end

pub fn main() -> () effects [stdio]
	let items = list_cons(1, list_cons(2, list_cons(3, list_cons(4, list_cons(255, list_nil())))))
	let encoded = byte_encode_counted_values({left_count: 2, right_count: 3, items: items})
	match encoded
		Ok(bytes) => emit_encoded(bytes)
		Err(_) => stdio::println("unexpected encode failure")
	end
end
