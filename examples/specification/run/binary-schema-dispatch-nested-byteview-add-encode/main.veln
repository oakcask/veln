# Nested dispatch payload encode accepts ByteView addition lengths.
use stdio

schema AdditivePayload
	format binary

	left_length: UInt8
	right_length: UInt8
	payload: ByteView(left_length + right_length)
end

schema ClosedAdditiveWritePacket
	format binary

	kind: UInt8
	payload: Dispatch(kind, 1 => AdditivePayload)
end

schema ExtensionAdditiveWritePacket
	format binary

	length: UInt8
	kind: UInt8
	payload: ExtensionDispatch(kind, length, 1 => AdditivePayload)
end

fn emit_output_chunk(name: String, index: Int, chunk: ByteChunk, expected_hex: String) -> () effects [stdio]
	stdio::print("output_chunk ")
	stdio::print(name)
	stdio::print(" index ")
	stdio::print(int_to_string(index))
	stdio::print(" hex \"")
	stdio::print(expected_hex)
	stdio::print("\" count ")
	stdio::println(int_to_string(byte_count_to_int(byte_chunk_count(chunk))))
end

fn emit_output_chunk_list_header(name: String, count: Int) -> () effects [stdio]
	stdio::print("output_chunk_list ")
	stdio::print(name)
	stdio::print(" count ")
	stdio::println(int_to_string(count))
end

fn emit_encoded_chunk(name: String, bytes: ByteChunk, expected_hex: String) -> () effects [stdio]
	emit_output_chunk_list_header(name, 1)
	emit_output_chunk(name, 0, bytes, expected_hex)
end

fn emit_encoded(name: String, encoded: Result<ByteChunk, EncodeError>, expected_hex: String) -> () effects [stdio]
	match encoded
		Ok(bytes) => emit_encoded_chunk(name, bytes, expected_hex)
		Err(_) => stdio::println("unexpected encode failure")
	end
end

pub fn main() -> Result<(), String> effects [stdio]
	let payload_bytes: ByteChunk = byte_chunk_from_hex("aabbccddee")?
	let payload_view: ByteView = byte_view(payload_bytes, byte_offset(0)?, byte_count(5)?)?
	let payload: {left_length: Int, right_length: Int, payload: ByteView} = {left_length: 2, right_length: 3, payload: payload_view}
	let closed: Result<ByteChunk, EncodeError> = byte_encode_closed_additive_write_packet({kind: 1, payload: payload})
	emit_encoded("closed-additive-nested", closed, "010203aabbccddee")

	let extension: Result<ByteChunk, EncodeError> = byte_encode_extension_additive_write_packet({length: 7, kind: 1, payload: Known(payload)})
	emit_encoded("extension-additive-nested", extension, "07010203aabbccddee")
	Ok(())
end
