# HTTP/2 SETTINGS ACK helper returns a RuntimeDiagnostic payload.
fn invalid_payload(error: String) -> RuntimeDiagnostic
	RuntimeDiagnostic(
		"http2.protocol.unexpected_settings_ack",
		error,
		RuntimeHttp2ProtocolUnexpectedSettingsAckDiagnostic(0, "connection-control", "rfc9113_settings_ack_requires_outstanding_local_settings", byte_chunk([]))
	)
end

fn preview_bytes() -> Result<ByteChunk, RuntimeDiagnostic>
	match byte_chunk_from_hex("000000040100000000")
		Ok(bytes) => Ok(bytes)
		Err(error) => Err(invalid_payload(error))
	end
end

fn preview_view(bytes: ByteChunk) -> Result<ByteView, RuntimeDiagnostic>
	let count: ByteCount = byte_chunk_count(bytes)
	match byte_offset(0)
		Ok(offset) => match byte_view(bytes, offset, count)
			Ok(view) => Ok(view)
			Err(error) => Err(invalid_payload(error))
		end
		Err(error) => Err(invalid_payload(error))
	end
end

pub fn main() -> Result<(), RuntimeDiagnostic>
	let payload: ByteChunk = preview_bytes()?
	let preview: ByteView = preview_view(payload)?
	http2_protocol_unexpected_settings_ack(0, "connection-control", "rfc9113_settings_ack_requires_outstanding_local_settings", preview)
end
