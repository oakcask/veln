use fixture_effects
use fake_effects

# Optional socket accept observes clean listener end as None.
fn emit_accept_result(result: Option<NetStream>) -> () effects [stdio]
	match result
		Some(_) => stdio::println("accepted")
		None => stdio::println("ended")
	end
end

fn fixture_body() -> Result<(), String> effects [net, stdio]
	let listener = net::listen("127.0.0.1:0")
	emit_accept_result(net::accept_or_end(listener))
	Ok(())
end

pub fn main() -> Result<(), String> effects [concurrency, fs, net, stdio]
	let state = fixture_effects::create_fixture()
	handle handle fixture_body() with fake_effects::network(state) with fake_effects::clock(state)
end
