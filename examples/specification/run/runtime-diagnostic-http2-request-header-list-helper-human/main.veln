# HTTP/2 request header-list helper projects human runtime diagnostics from the payload.
fn invalid_payload(error: String) -> RuntimeDiagnostic
	RuntimeDiagnostic(
		"http2.protocol.invalid_request_header_list",
		error,
		RuntimeHttp2ProtocolInvalidRequestHeaderListDiagnostic(12, 1, 1, "response_only_pseudo_header", ":status", ":status,:method,:scheme,:path", "request-headers", "rfc9113_request_pseudo_headers", byte_chunk([]))
	)
end

fn preview_bytes() -> Result<ByteChunk, RuntimeDiagnostic>
	match byte_chunk_from_hex("828486")
		Ok(bytes) => Ok(bytes)
		Err(error) => Err(invalid_payload(error))
	end
end

fn preview_view(bytes: ByteChunk) -> Result<ByteView, RuntimeDiagnostic>
	match byte_offset(0)
		Ok(offset) => match byte_count(3)
			Ok(count) => match byte_view(bytes, offset, count)
				Ok(view) => Ok(view)
				Err(error) => Err(invalid_payload(error))
			end
			Err(error) => Err(invalid_payload(error))
		end
		Err(error) => Err(invalid_payload(error))
	end
end

pub fn main() -> Result<(), RuntimeDiagnostic>
	let bytes: ByteChunk = preview_bytes()?
	http2_protocol_invalid_request_header_list(12, 1, 1, "response_only_pseudo_header", ":status", ":status,:method,:scheme,:path", "request-headers", "rfc9113_request_pseudo_headers", preview_view(bytes)?)
end
