# HTTP/2 request header-list helper projects human runtime diagnostics from the payload.
pub fn main() -> Result<(), RuntimeDiagnostic>
	http2_protocol_invalid_request_header_list(12, 1, 1, "response_only_pseudo_header", ":status", ":status,:method,:scheme,:path", "request-headers", "rfc9113_request_pseudo_headers")
end
