# Binary schema Flag64be fields decode as source-visible bitset values.
use stdio

schema FlagPacket
	format binary

	flags: Flag64be
end

fn flag_bits(flags: Flag64be) -> Int
	match flags
		Flag64be(bits) => bits
	end
end

pub fn main() -> Result<(), String> effects [stdio]
	let bytes: ByteChunk = byte_chunk_from_hex("0102030405060708")?
	let offset: ByteOffset = byte_offset(0)?
	let count: ByteCount = byte_count(8)?
	let view: ByteView = byte_view(bytes, offset, count)?
	let packet: {flags: Flag64be} = byte_decode_flag_packet(view)?
	stdio::println(int_to_string(flag_bits(packet.flags)))
	Ok(())
end
