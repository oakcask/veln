# Binary schema UInt56le truncation reports schema field byte details.
schema UInt56Widths
	format binary

	big_value: UInt56be
	little_value: UInt56le
end

pub fn main() -> Result<(), String>
	let bytes: ByteChunk = byte_chunk_from_hex("01020304050607070605040302")?
	let offset: ByteOffset = byte_offset(0)?
	let count: ByteCount = byte_count(13)?
	let view: ByteView = byte_view(bytes, offset, count)?
	let ignored: {big_value: Int, little_value: Int} = byte_decode_uint56_widths(view)?
	Ok(())
end
