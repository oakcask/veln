# Format-neutral schema encode helpers accept Dict<String, Option<scalar>> fields.
use stdio

schema DictOptionScalarPacket
	scores: Dict<String, Option<Int>>
end

fn encoded_score(result: Result<{scores: Dict<String, Option<Int>>}, String>, key: String) -> Int
	match result
		Ok(packet) => match dict_get(packet.scores, key)
			Some(value) => match value
				Some(score) => score
				None => -2
			end
			None => -1
		end
		Err(_) => -3
	end
end

pub fn main() -> () effects [stdio]
	let packet = {scores: {"math": Some(11), "language": None}}
	let empty_packet: {scores: Dict<String, Option<Int>>} = {scores: {}}
	let encoded = byte_encode_dict_option_scalar_packet(packet)
	let explicit: Result<{scores: Dict<String, Option<Int>>}, String> = encode DictOptionScalarPacket from empty_packet
	stdio::println(int_to_string(encoded_score(encoded, "math")))
	stdio::println(int_to_string(encoded_score(encoded, "language")))
	stdio::println(int_to_string(encoded_score(encoded, "science")))
	stdio::println(int_to_string(encoded_score(explicit, "math")))
end
