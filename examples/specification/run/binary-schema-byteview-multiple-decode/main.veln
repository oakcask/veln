# Binary schema ByteView payload multiple validation accepts matching payload counts.
use stdio

schema PacketWire
	format binary

	length: UInt8
	frame_count: UInt8
	payload: ByteView(length) where payload_count multiple of frame_count
end

fn emit_packet(packet: {length: Int, frame_count: Int, payload: ByteView}) -> Result<(), String> effects [stdio]
	stdio::print(int_to_string(packet.length))
	stdio::print(" ")
	stdio::print(int_to_string(packet.frame_count))
	stdio::print(" ")
	stdio::println(int_to_string(byte_count_to_int(byte_chunk_count(byte_view_to_chunk(packet.payload)))))
	Ok(())
end

pub fn main() -> Result<(), String> effects [stdio]
	let bytes = byte_chunk_from_hex("0603aabbccddeeff")?
	let view = byte_view(bytes, byte_offset(0)?, byte_count(8)?)?
	let packet = byte_decode_packet_wire(view)?
	emit_packet(packet)
	Ok(())
end
