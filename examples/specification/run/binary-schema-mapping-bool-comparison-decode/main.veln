# Binary schema mapping can compute Bool fields with decoded-field comparisons.
use stdio

type Packet
	Packet {is_control: Bool, lengths_match: Bool, kind_changed: Bool}
end

fn bool_text(value: Bool) -> String
	match value
		true => "true"
		false => "false"
	end
end

schema PacketWire
	format binary

	kind: UInt8
	length: UInt8
	copy_length: UInt8

	map to Packet
		is_control = kind == 1
		lengths_match = length == copy_length
		kind_changed = kind != copy_length
end

pub fn main() -> Result<(), String> effects [stdio]
	let first_bytes: ByteChunk = byte_chunk_from_hex("010707")?
	let first_view: ByteView = byte_view(first_bytes, byte_offset(0)?, byte_count(3)?)?
	let first: {is_control: Bool, lengths_match: Bool, kind_changed: Bool} = byte_decode_packet_wire(first_view)?
	stdio::println(bool_text(first.is_control))
	stdio::println(bool_text(first.lengths_match))
	stdio::println(bool_text(first.kind_changed))

	let second_bytes: ByteChunk = byte_chunk_from_hex("020203")?
	let second_view: ByteView = byte_view(second_bytes, byte_offset(0)?, byte_count(3)?)?
	let second: {is_control: Bool, lengths_match: Bool, kind_changed: Bool} = byte_decode_packet_wire(second_view)?
	stdio::println(bool_text(second.is_control))
	stdio::println(bool_text(second.lengths_match))
	stdio::println(bool_text(second.kind_changed))

	Ok(())
end
