# RuntimeDiagnostic values can project malformed HPACK Huffman padding payloads.
fn invalid_payload(error: String) -> RuntimeDiagnostic
	RuntimeDiagnostic(
		"hpack.fixture.malformed_huffman_padding",
		error,
		RuntimeHpackFixtureDiagnostic(9, 0, -1, "fixture HPACK Huffman padding", "hpack_fixture", byte_chunk([]))
	)
end

fn preview_block() -> Result<ByteChunk, RuntimeDiagnostic>
	match byte_chunk_from_hex("048100")
		Ok(block) => Ok(block)
		Err(error) => Err(invalid_payload(error))
	end
end

pub fn main() -> Result<(), RuntimeDiagnostic>
	let block: ByteChunk = preview_block()?
	Err(RuntimeDiagnostic(
		"hpack.fixture.malformed_huffman_padding",
		"HPACK fixture malformed Huffman padding at byte offset 9",
		RuntimeHpackFixtureDiagnostic(9, 3, 4, "fixture HPACK Huffman padding", "hpack_fixture", block)
	))
end
