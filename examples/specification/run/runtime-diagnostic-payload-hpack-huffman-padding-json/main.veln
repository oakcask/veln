# HPACK fixture helpers return malformed Huffman padding RuntimeDiagnostic payloads.
fn invalid_payload(error: String) -> RuntimeDiagnostic
	RuntimeDiagnostic(
		"hpack.fixture.malformed_huffman_padding",
		error,
		RuntimeHpackFixtureDiagnostic(9, 0, -1, "fixture HPACK Huffman padding", "hpack_fixture", byte_chunk([]))
	)
end

fn preview_view() -> Result<ByteView, RuntimeDiagnostic>
	match byte_chunk_from_hex("048100")
		Ok(block) => match byte_offset(0)
			Ok(offset) => match byte_view(block, offset, byte_chunk_count(block))
				Ok(view) => Ok(view)
				Err(error) => Err(invalid_payload(error))
			end
			Err(error) => Err(invalid_payload(error))
		end
		Err(error) => Err(invalid_payload(error))
	end
end

pub fn main() -> Result<(), RuntimeDiagnostic>
	let preview: ByteView = preview_view()?
	hpack_fixture_malformed_huffman_padding(9, 3, 4, "fixture HPACK Huffman padding", "hpack_fixture", preview)
end
