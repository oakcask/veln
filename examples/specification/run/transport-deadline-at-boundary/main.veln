use net from "std"
use fixture_effects
use fake_effects

# Absolute monotonic deadlines use the same deadline-aware socket path.
fn emit_read_result(result: net::ReadOutcome) -> () effects [stdio]
	match result
		net::ReadChunk(bytes) => emit_chunk(bytes)
		net::ReadEnd => stdio::println("end")
	end
end

fn emit_chunk(bytes: ByteChunk) -> () effects [stdio]
	stdio::print("read ")
	stdio::println(int_to_string(byte_count_to_int(byte_chunk_count(bytes))))
end

fn fixture_body() -> Result<(), net::NetError> effects [net::IO, time, stdio]
	let listener = net::listen(net::Address(net::Tcp4, "127.0.0.1", 0))?
	let stream = net::accept(listener)?
	let target_ms = time::monotonic_ms() + 1000
	let deadline = time::deadline_at_ms(target_ms)
	emit_read_result(net::read_with(stream, Some(deadline), None)?)
	let _ = net::close_stream(stream)?
	let _ = net::close_listener(listener)?
	Ok(())
end

pub fn main() -> Result<(), net::NetError> effects [concurrency, fs, net, stdio, time]
	let state = fixture_effects::create_fixture()
	handle handle handle fixture_body() with net::system() with fake_effects::network(state) with fake_effects::clock(state)
end
