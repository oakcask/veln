# Absolute monotonic deadlines use the same deadline-aware socket path.
fn emit_read_result(result: Option<ByteChunk>) -> () effects [stdio]
	match result
		Some(bytes) => emit_chunk(bytes)
		None => stdio::println("deadline")
	end
end

fn emit_chunk(bytes: ByteChunk) -> () effects [stdio]
	stdio::print("read ")
	stdio::println(int_to_string(byte_count_to_int(byte_chunk_count(bytes))))
end

pub fn main() -> Result<(), String> effects [net, time, stdio]
	let listener = net::listen("127.0.0.1:0")
	let stream = net::accept(listener)
	let target_ms = time::monotonic_ms() + 1000
	let deadline = time::deadline_at_ms(target_ms)
	emit_read_result(net::read_chunk_until(stream, deadline))
	Ok(())
end
