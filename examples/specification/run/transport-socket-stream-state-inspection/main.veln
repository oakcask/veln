use net from "std"
use fixture_effects
use fake_effects
# Production loopback stream state inspection preserves stream ownership.
use stdio

fn bool_text(value: Bool) -> String
	if value
		"true"
	else
		"false"
	end
end

fn bytes(text: String) -> Result<ByteChunk, net::NetError>
	match byte_chunk_from_hex(text)
		Ok(value) => Ok(value)
		Err(message) => Err(net::NetError("fixture_bytes", None, None, net::Other, message))
	end
end

fn print_state(label: String, readable: Bool, writable: Bool, closed: Bool) -> () effects [stdio]
	stdio::print(label)
	stdio::print(" read=")
	stdio::print(bool_text(readable))
	stdio::print(" write=")
	stdio::print(bool_text(writable))
	stdio::print(" closed=")
	stdio::println(bool_text(closed))
end

fn fixture_body() -> Result<(), net::NetError> effects [net::IO, stdio]
	let listener = net::listen(net::Address(net::Tcp4, "127.0.0.1", 0))?
	let stream = net::accept(listener)?
	print_state("open", true, true, false)
	let _ = net::shutdown_read(stream)?
	print_state("read-shutdown", false, true, false)
	let outgoing = bytes("0e0f")?
	let _ = net::write_all(stream, outgoing, None, None)?
	let _ = net::shutdown_write(stream)?
	print_state("write-shutdown", false, false, false)
	let _ = net::close_stream(stream)?
	print_state("closed", false, false, true)
	Ok(())
end

pub fn main() -> Result<(), net::NetError> effects [concurrency, fs, net, stdio, time]
	let state = fixture_effects::create_fixture()
	handle handle handle fixture_body() with net::system() with fake_effects::network(state) with fake_effects::clock(state)
end
