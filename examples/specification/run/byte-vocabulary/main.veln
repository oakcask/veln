# Byte chunks are immutable prelude values with pure construction and slicing helpers.
use stdio

fn chunk_count_text(chunk: ByteChunk) -> String
	int_to_string(byte_count_to_int(byte_chunk_count(chunk)))
end

pub fn main() -> Result<(), String> effects [stdio]
	let first: Byte = byte(1)?
	let second: Byte = byte(2)?
	let third: Byte = byte(255)?
	let combined: ByteChunk = byte_append(byte_chunk([first, second]), byte_chunk([third]))
	let one: ByteCount = byte_count(1)?
	let two: ByteCount = byte_count(2)?
	let taken: ByteChunk = byte_take(combined, two)?
	let dropped: ByteChunk = byte_drop(combined, one)?
	let offset: ByteOffset = byte_offset(4)?
	stdio::println(chunk_count_text(combined))
	stdio::println(chunk_count_text(taken))
	stdio::println(chunk_count_text(dropped))
	stdio::println(int_to_string(byte_to_int(second)))
	stdio::println(int_to_string(byte_offset_to_int(offset)))
	Ok(())
end
