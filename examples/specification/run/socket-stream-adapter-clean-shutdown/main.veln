use net from "std"
use fixture_effects
use fake_effects
use stdio

type FixtureReadOutcome
	FixtureReadChunk(bytes: ByteChunk)
	FixtureReadEnd
	FixtureReadDeadlineExpired
	FixtureReadCancelled
end

type FixtureAcceptOutcome
	FixtureAcceptStream(stream: net::Stream)
	FixtureAcceptEnd
	FixtureAcceptDeadlineExpired
	FixtureAcceptCancelled
end

fn fixture_read_with(stream: net::Stream, deadline: Deadline, token: CancelToken) -> FixtureReadOutcome effects [net::IO]
	match net::read_with(stream, Some(deadline), Some(token))
		Ok(net::ReadChunk(bytes)) => FixtureReadChunk(bytes)
		Ok(net::ReadEnd) => FixtureReadEnd
		Err(net::NetError(_, _, _, net::TimedOut, _)) => FixtureReadDeadlineExpired
		Err(net::NetError(_, _, _, net::Cancelled, _)) => FixtureReadCancelled
		Err(_) => FixtureReadEnd
	end
end

fn fixture_accept_with(listener: net::Listener, deadline: Deadline, token: CancelToken) -> FixtureAcceptOutcome effects [net::IO]
	match net::accept_with(listener, Some(deadline), Some(token))
		Ok(stream) => FixtureAcceptStream(stream)
		Err(net::NetError(_, _, _, net::TimedOut, _)) => FixtureAcceptDeadlineExpired
		Err(net::NetError(_, _, _, net::Cancelled, _)) => FixtureAcceptCancelled
		Err(_) => FixtureAcceptEnd
	end
end
# Clean shutdown keeps transport handles adapter-owned.

type ResponseAction
	SendBytes(bytes: ByteChunk)
	EndStream
	RetryAfterDeadline
	CleanupAfterCancel
end

fn handle_stream_input(input: StreamInput, state: { chunks : Int, ended : Bool }) -> { actions : List<ResponseAction>, next_state : { chunks : Int, ended : Bool } }
	match input
		Chunk(bytes) => { actions: list_cons(SendBytes(bytes), list_nil()), next_state: { chunks: state.chunks + 1, ended: state.ended } }
		End => { actions: list_cons(EndStream, list_nil()), next_state: { chunks: state.chunks, ended: true } }
	end
end

fn wait_response(outcome: CancellableWaitOutcome, state: { chunks : Int, ended : Bool }) -> { decision : String, actions : List<ResponseAction>, next_state : { chunks : Int, ended : Bool } }
	match outcome
		WaitCompleted => { decision: "completed", actions: list_nil(), next_state: state }
		WaitDeadlineExpired => { decision: "deadline-expired", actions: list_cons(RetryAfterDeadline, list_nil()), next_state: state }
		WaitCancelled => { decision: "cancelled", actions: list_cons(CleanupAfterCancel, list_nil()), next_state: state }
	end
end

fn append_actions(left: List<ResponseAction>, right: List<ResponseAction>) -> List<ResponseAction>
	match left
		Nil => right
		Cons(action, tail) => list_cons(action, append_actions(tail, right))
	end
end

fn action_count(actions: List<ResponseAction>) -> Int
	match actions
		Nil => 0
		Cons(_, tail) => 1 + action_count(tail)
	end
end

fn write_count(actions: List<ResponseAction>) -> Int
	match actions
		Nil => 0
		Cons(action, tail) => match action
			SendBytes(_) => 1 + write_count(tail)
			EndStream => write_count(tail)
			RetryAfterDeadline => write_count(tail)
			CleanupAfterCancel => write_count(tail)
		end
	end
end

fn retry_count(actions: List<ResponseAction>) -> Int
	match actions
		Nil => 0
		Cons(action, tail) => match action
			SendBytes(_) => retry_count(tail)
			EndStream => retry_count(tail)
			RetryAfterDeadline => 1 + retry_count(tail)
			CleanupAfterCancel => retry_count(tail)
		end
	end
end

fn cleanup_count(actions: List<ResponseAction>) -> Int
	match actions
		Nil => 0
		Cons(action, tail) => match action
			SendBytes(_) => cleanup_count(tail)
			EndStream => cleanup_count(tail)
			RetryAfterDeadline => cleanup_count(tail)
			CleanupAfterCancel => 1 + cleanup_count(tail)
		end
	end
end

fn route_input(route: { tx : Sender<StreamInput>, rx : Receiver<StreamInput> }, input: StreamInput) -> StreamInput effects [concurrency]
	let _ = channel::send(route.tx, input)
	match channel::recv(route.rx)
		Some(value) => value
		None => End
	end
end

fn read_response(route: { tx : Sender<StreamInput>, rx : Receiver<StreamInput> }, outcome: FixtureReadOutcome, state: { chunks : Int, ended : Bool }) -> { actions : List<ResponseAction>, next_state : { chunks : Int, ended : Bool } } effects [concurrency]
	match outcome
		FixtureReadChunk(bytes) => handle_stream_input(route_input(route, Chunk(bytes)), state)
		FixtureReadEnd => handle_stream_input(route_input(route, End), state)
		FixtureReadDeadlineExpired => { actions: list_cons(RetryAfterDeadline, list_nil()), next_state: state }
		FixtureReadCancelled => { actions: list_cons(CleanupAfterCancel, list_nil()), next_state: state }
	end
end

fn collect_shutdown_actions(stream: net::Stream, state: { chunks : Int, ended : Bool }, deadline: Deadline, token: CancelToken) -> { first_decision : String, second_decision : String, actions : List<ResponseAction>, next_state : { chunks : Int, ended : Bool } } effects [net::IO, time, concurrency]
	let route = channel::bounded<StreamInput>(1)
	let handled = read_response(route, fixture_read_with(stream, deadline, token), state)
	let cancelled = wait_response(time::wait_until_cancellable_outcome(deadline, token), handled.next_state)
	let expired = wait_response(time::wait_until_cancellable_outcome(deadline, token), cancelled.next_state)
	{ first_decision: cancelled.decision, second_decision: expired.decision, actions: append_actions(handled.actions, append_actions(cancelled.actions, expired.actions)), next_state: expired.next_state }
end

fn apply_response_actions(stream: net::Stream, actions: List<ResponseAction>) -> () effects [net::IO]
	match actions
		Nil => ()
		Cons(action, tail) => match action
			SendBytes(bytes) => write_then_apply(stream, bytes, tail)
			EndStream => apply_response_actions(stream, tail)
			RetryAfterDeadline => apply_response_actions(stream, tail)
			CleanupAfterCancel => apply_response_actions(stream, tail)
		end
	end
end

fn write_then_apply(stream: net::Stream, bytes: ByteChunk, tail: List<ResponseAction>) -> () effects [net::IO]
	write_chunk_value(stream, bytes)
	apply_response_actions(stream, tail)
end

fn close_owned_transport(listener: net::Listener, stream: net::Stream, actions: List<ResponseAction>) -> () effects [net::IO]
	apply_response_actions(stream, actions)
	close_stream_value(stream)
	close_listener_value(listener)
end

fn clean_shutdown_lifecycle(listener: net::Listener, stream: net::Stream, deadline: Deadline, token: CancelToken) -> Result<{ first_decision : String, second_decision : String, actions : List<ResponseAction>, next_state : { chunks : Int, ended : Bool } }, String> effects [net::IO, time, concurrency]
	let routed = collect_shutdown_actions(stream, { chunks: 0, ended: false }, deadline, token)
	close_owned_transport(listener, stream, routed.actions)
	Ok(routed)
end

fn lifecycle_result(address: String) -> Result<{ first_decision : String, second_decision : String, actions : List<ResponseAction>, next_state : { chunks : Int, ended : Bool } }, String> effects [net::IO, time, concurrency]
	let listener = open_listener(address)?
	let deadline = time::deadline_after_ms(100)
	let token = time::cancel_token()
	match fixture_accept_with(listener, deadline, token)
		FixtureAcceptStream(stream) => clean_shutdown_lifecycle(listener, stream, deadline, token)
		FixtureAcceptEnd => Ok({ first_decision: "accept-end", second_decision: "none", actions: list_nil(), next_state: { chunks: 0, ended: true } })
		FixtureAcceptDeadlineExpired => Ok({ first_decision: "accept-deadline", second_decision: "none", actions: list_nil(), next_state: { chunks: 0, ended: false } })
		FixtureAcceptCancelled => Ok({ first_decision: "accept-cancelled", second_decision: "none", actions: list_nil(), next_state: { chunks: 0, ended: false } })
	end
end

fn bool_text(value: Bool) -> String
	if value
		"true"
	else
		"false"
	end
end

fn fixture_body() -> Result<(), String> effects [net::IO, time, concurrency, stdio]
	let routed = lifecycle_result("127.0.0.1:0")?
	stdio::print("decisions ")
	stdio::print(routed.first_decision)
	stdio::print(",")
	stdio::print(routed.second_decision)
	stdio::print(" actions ")
	stdio::print(int_to_string(action_count(routed.actions)))
	stdio::print(" chunks ")
	stdio::print(int_to_string(routed.next_state.chunks))
	stdio::print(" ended ")
	stdio::print(bool_text(routed.next_state.ended))
	stdio::print(" writes ")
	stdio::print(int_to_string(write_count(routed.actions)))
	stdio::print(" retries ")
	stdio::print(int_to_string(retry_count(routed.actions)))
	stdio::print(" cleanup ")
	stdio::println(int_to_string(cleanup_count(routed.actions)))
	Ok(())
end

pub fn main() -> Result<(), String> effects [concurrency, fs, net, stdio, time]
	let state = fixture_effects::create_fixture()
	handle handle handle fixture_body() with net::system() with fake_effects::network(state) with fake_effects::clock(state)
end

fn fixture_network_error(error: net::NetError) -> String
	match error
		net::NetError(_, _, _, _, message) => match string_split_once(message, "\n")
			Some(parts) => parts.left
			None => message
		end
	end
end

fn fixture_address(text: String) -> Result<net::Address, String>
	match net::split_host_port(text)
		Ok(parts) => Ok(net::Address(net::Tcp4, parts.host, parts.port))
		Err(error) => Err(fixture_network_error(error))
	end
end

fn close_listener_value(listener: net::Listener) -> () effects [net::IO]
	let _ = net::close_listener(listener)
	()
end

fn close_stream_value(stream: net::Stream) -> () effects [net::IO]
	let _ = net::close_stream(stream)
	()
end

fn write_chunk_value(stream: net::Stream, bytes: ByteChunk) -> () effects [net::IO]
	let _ = net::write(stream, bytes)
	()
end

fn open_listener(text: String) -> Result<net::Listener, String> effects [net::IO]
	match fixture_address(text)
		Ok(address) => match net::listen(address)
			Ok(listener) => Ok(listener)
			Err(error) => Err(fixture_network_error(error))
		end
		Err(message) => Err(message)
	end
end

fn open_stream(text: String) -> Result<net::Stream, String> effects [net::IO]
	match fixture_address(text)
		Ok(address) => match net::connect(address)
			Ok(stream) => Ok(stream)
			Err(error) => Err(fixture_network_error(error))
		end
		Err(message) => Err(message)
	end
end

fn accept_stream(listener: net::Listener) -> Result<net::Stream, String> effects [net::IO]
	match net::accept(listener)
		Ok(stream) => Ok(stream)
		Err(error) => Err(fixture_network_error(error))
	end
end
