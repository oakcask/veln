use http2::diagnostic from "std"
# HTTP/2 closed-input helper returns a RuntimeDiagnostic payload.
fn fallback_payload(error: String) -> RuntimeDiagnostic
	RuntimeDiagnostic(
		"http2.protocol.closed_with_pending",
		error,
		RuntimeHttp2ProtocolClosedWithPendingDiagnostic(0, 0, "none", 0, 0, 0, 0, "none", byte_chunk([]))
	)
end

fn preview_view() -> Result<ByteView, RuntimeDiagnostic>
	match byte_chunk_from_hex("01020304")
		Ok(bytes) => match byte_offset(0)
			Ok(offset) => match byte_view(bytes, offset, byte_chunk_count(bytes))
				Ok(view) => Ok(view)
				Err(error) => Err(fallback_payload(error))
			end
			Err(error) => Err(fallback_payload(error))
		end
		Err(error) => Err(fallback_payload(error))
	end
end

pub fn main() -> Result<(), RuntimeDiagnostic>
	let preview: ByteView = preview_view()?
	http2::diagnostic::protocol_closed_with_pending(0, 4, "none", 0, 0, 0, 0, "none", preview)
end
