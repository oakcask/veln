# Binary schema mapping can carry a Flag32be field into a target record.
use stdio

type FlagPacket
	FlagPacket {target_flags: Flag32be}
end

schema FlagPacketWire
	format binary

	flags: Flag32be

	map to FlagPacket
		target_flags = flags
end

fn flag_bits(flags: Flag32be) -> Int
	match flags
		Flag32be(bits) => bits
	end
end

pub fn main() -> Result<(), String> effects [stdio]
	let bytes: ByteChunk = byte_chunk_from_hex("12345678")?
	let view: ByteView = byte_view(bytes, byte_offset(0)?, byte_count(4)?)?
	let packet: {target_flags: Flag32be} = byte_decode_flag_packet_wire(view)?
	stdio::println(int_to_string(flag_bits(packet.target_flags)))
	Ok(())
end
