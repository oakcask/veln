use net from "std"
use fixture_effects
use fake_effects
# Production loopback connect returns an owned stream with endpoint text.
use stdio

fn endpoint_text(endpoint: net::Endpoint) -> String
	match endpoint
		net::Endpoint(_, text) => text
	end
end

fn read_bytes(outcome: net::ReadOutcome) -> ByteChunk
	match outcome
		net::ReadChunk(bytes) => bytes
		net::ReadEnd => byte_chunk([])
	end
end

fn bytes(text: String) -> Result<ByteChunk, net::NetError>
	match byte_chunk_from_hex(text)
		Ok(value) => Ok(value)
		Err(message) => Err(net::NetError("fixture_bytes", None, None, net::Other, message))
	end
end

fn fixture_body() -> Result<(), net::NetError> effects [net::IO, stdio]
	let stream = net::connect(net::Address(net::Tcp4, "127.0.0.1", 0))?
	let local = endpoint_text(net::local_address(stream)?)
	let peer = endpoint_text(net::peer_address(stream)?)
	let outgoing = bytes("0a0b")?
	let _ = net::write_all(stream, outgoing, None, None)?
	let incoming = read_bytes(net::read(stream)?)
	let _ = net::close_stream(stream)?
	stdio::print("local ")
	stdio::print(local)
	stdio::print(" peer ")
	stdio::print(peer)
	stdio::print(" bytes ")
	stdio::println(int_to_string(byte_count_to_int(byte_chunk_count(incoming))))
	Ok(())
end

pub fn main() -> Result<(), net::NetError> effects [concurrency, fs, net, stdio, time]
	let state = fixture_effects::create_fixture()
	handle handle handle fixture_body() with net::system() with fake_effects::network(state) with fake_effects::clock(state)
end
