# Cancellable deadline-aware socket accept returns a stream before the deadline.
fn emit_accept_outcome(outcome: AcceptOutcome) -> () effects [net, stdio]
	match outcome
		AcceptStream(stream) => emit_accepted_stream(stream)
		AcceptEnd => stdio::println("end")
		AcceptDeadlineExpired => stdio::println("deadline")
		AcceptCancelled => stdio::println("cancelled")
	end
end

fn emit_accepted_stream(stream: NetStream) -> () effects [net, stdio]
	let incoming: ByteChunk = net::read_chunk(stream)
	stdio::print("accepted ")
	stdio::println(int_to_string(byte_count_to_int(byte_chunk_count(incoming))))
end

pub fn main() -> Result<(), String> effects [net, time, stdio]
	let listener: NetListener = net::listen("127.0.0.1:0")
	let deadline: Deadline = time::deadline_after_ms(100)
	let token: CancelToken = time::cancel_token()
	emit_accept_outcome(net::accept_until_cancellable(listener, deadline, token))
	Ok(())
end
