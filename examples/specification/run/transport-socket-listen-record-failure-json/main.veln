use fixture_effects
use fake_effects

# A bound listener keeps its identity and ownership facts when event recording fails.
fn fixture_body() -> () effects [net]
	let listener: NetListener = net::listen("127.0.0.1:39127")
	net::close_listener(listener)
end

pub fn main() -> () effects [concurrency, fs, net]
	let state = fixture_effects::create_fixture()
	handle handle fixture_body() with fake_effects::network(state) with fake_effects::clock(state)
end
