# Binary schema UInt64be and UInt64le encode reject negative ordinary Int values.
use stdio

schema UInt64BigWidth
	format binary

	value: UInt64be
end

schema UInt64LittleWidth
	format binary

	value: UInt64le
end

fn emit_error(error: EncodeError) -> () effects [stdio]
	stdio::println(error_id(error))
	stdio::println(error_path(error))
	stdio::println(error_reason(error))
end

fn error_id(error: EncodeError) -> String
	match error
		EncodeError(id, _, _) => id
	end
end

fn error_path(error: EncodeError) -> String
	match error
		EncodeError(_, field_path, _) => field_path
	end
end

fn error_reason(error: EncodeError) -> String
	match error
		EncodeError(_, _, reason) => reason
	end
end

pub fn main() -> () effects [stdio]
	let big_encoded: Result<ByteChunk, EncodeError> = byte_encode_uint64_big_width({value: -1})
	match big_encoded
		Ok(_) => stdio::println("unexpected encode success")
		Err(error) => emit_error(error)
	end

	let little_encoded: Result<ByteChunk, EncodeError> = byte_encode_uint64_little_width({value: -1})
	match little_encoded
		Ok(_) => stdio::println("unexpected UInt64le encode success")
		Err(error) => emit_error(error)
	end
end
