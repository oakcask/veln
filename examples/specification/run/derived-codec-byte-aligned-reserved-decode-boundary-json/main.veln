schema ByteAlignedReservedHeader
	format binary

	prefix: UInt8
	padding: ReservedBits(16, 43981)
	kind: UInt8
end


fn invalid_step() -> Result<DecodeStep<{prefix: Int, kind: Int}>, String>
	let bytes: ByteChunk = byte_chunk_from_hex("12abce34")?
	let view: ByteView = byte_view(bytes, byte_offset(0)?, byte_count(4)?)?
	Ok(decode ByteAlignedReservedHeader from view at byte_offset(80)?)
end

pub fn main() -> DecodeStep<{prefix: Int, kind: Int}>
	match invalid_step()
		Ok(step) => step
		Err(_) => NeedMore(NeedEnd)
	end
end
