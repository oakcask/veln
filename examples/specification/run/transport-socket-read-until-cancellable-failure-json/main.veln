use net from "std"
use fixture_effects
use fake_effects

# Cancellable deadline-aware socket read host failures stay runtime failures.
fn fixture_body() -> Result<(), net::NetError> effects [net::IO, time]
	let listener: net::Listener = net::listen(net::Address(net::Tcp4, "127.0.0.1", 0))?
	let stream: net::Stream = net::accept(listener)?
	let deadline: Deadline = time::deadline_after_ms(100)
	let token: CancelToken = time::cancel_token()
	let outcome = net::read_with(stream, Some(deadline), Some(token))?
	Ok(())
end

pub fn main() -> Result<(), net::NetError> effects [concurrency, fs, net, time]
	let state = fixture_effects::create_fixture()
	handle handle handle fixture_body() with net::system() with fake_effects::network(state) with fake_effects::clock(state)
end
