# Explicit schema operations include arithmetic-count Repeat schema helpers.
use stdio

schema AddRepeatValues
	format binary

	left_count: UInt8
	right_count: UInt8
	items: Repeat(left_count + right_count, UInt16be)
end

schema SubtractRepeatValues
	format binary

	left_count: UInt8
	right_count: UInt8
	items: Repeat(left_count - right_count, UInt16be)
end

schema ProductRepeatValues
	format binary

	row_count: UInt8
	column_count: UInt8
	items: Repeat(row_count * column_count, UInt16be)
end




fn list_count(items: List<Int>) -> Int
	match items
		Nil => 0
		Cons(_, tail) => 1 + list_count(tail)
	end
end

fn list_sum(items: List<Int>) -> Int
	match items
		Nil => 0
		Cons(head, tail) => head + list_sum(tail)
	end
end

fn add_decode_kind(step: DecodeStep<{left_count: Int, right_count: Int, items: List<Int>}>) -> String
	match step
		Decoded(_, _) => "decoded"
		NeedMore(_) => "need_more"
		Invalid(_) => "invalid"
	end
end

fn product_decode_kind(step: DecodeStep<{row_count: Int, column_count: Int, items: List<Int>}>) -> String
	match step
		Decoded(_, _) => "decoded"
		NeedMore(_) => "need_more"
		Invalid(_) => "invalid"
	end
end

fn add_decoded_item_count(step: DecodeStep<{left_count: Int, right_count: Int, items: List<Int>}>) -> Int
	match step
		Decoded(sample, _) => list_count(sample.items)
		NeedMore(_) => -1
		Invalid(_) => -1
	end
end

fn add_decoded_item_sum(step: DecodeStep<{left_count: Int, right_count: Int, items: List<Int>}>) -> Int
	match step
		Decoded(sample, _) => list_sum(sample.items)
		NeedMore(_) => -1
		Invalid(_) => -1
	end
end

fn product_decoded_item_count(step: DecodeStep<{row_count: Int, column_count: Int, items: List<Int>}>) -> Int
	match step
		Decoded(sample, _) => list_count(sample.items)
		NeedMore(_) => -1
		Invalid(_) => -1
	end
end

fn product_decoded_item_sum(step: DecodeStep<{row_count: Int, column_count: Int, items: List<Int>}>) -> Int
	match step
		Decoded(sample, _) => list_sum(sample.items)
		NeedMore(_) => -1
		Invalid(_) => -1
	end
end

fn add_consumed_count(step: DecodeStep<{left_count: Int, right_count: Int, items: List<Int>}>) -> Int
	match step
		Decoded(_, consumed) => byte_count_to_int(consumed)
		NeedMore(_) => 0
		Invalid(_) => 0
	end
end

fn product_consumed_count(step: DecodeStep<{row_count: Int, column_count: Int, items: List<Int>}>) -> Int
	match step
		Decoded(_, consumed) => byte_count_to_int(consumed)
		NeedMore(_) => 0
		Invalid(_) => 0
	end
end

fn add_readiness_kind(step: DecodeStep<{left_count: Int, right_count: Int, items: List<Int>}>) -> String
	match step
		Decoded(_, _) => "none"
		NeedMore(NeedBytes(_)) => "need_bytes"
		NeedMore(NeedEnd) => "need_end"
		Invalid(_) => "none"
	end
end

fn add_readiness_count(step: DecodeStep<{left_count: Int, right_count: Int, items: List<Int>}>) -> Int
	match step
		Decoded(_, _) => 0
		NeedMore(NeedBytes(count)) => byte_count_to_int(count)
		NeedMore(NeedEnd) => 0
		Invalid(_) => 0
	end
end

fn add_decode_error_id(step: DecodeStep<{left_count: Int, right_count: Int, items: List<Int>}>) -> String
	match step
		Decoded(_, _) => "none"
		NeedMore(_) => "none"
		Invalid(DecodeError(id, _, _)) => id
		Invalid(DecodeErrorWithReason(id, _, _, _)) => id
	end
end

fn add_decode_error_offset(step: DecodeStep<{left_count: Int, right_count: Int, items: List<Int>}>) -> Int
	match step
		Decoded(_, _) => -1
		NeedMore(_) => -1
		Invalid(DecodeError(_, offset, _)) => byte_offset_to_int(offset)
		Invalid(DecodeErrorWithReason(_, offset, _, _)) => byte_offset_to_int(offset)
	end
end

fn add_decode_error_path(step: DecodeStep<{left_count: Int, right_count: Int, items: List<Int>}>) -> String
	match step
		Decoded(_, _) => "none"
		NeedMore(_) => "none"
		Invalid(DecodeError(_, _, path)) => path
		Invalid(DecodeErrorWithReason(_, _, path, _)) => path
	end
end

fn encode_step_kind(step: EncodeStep<()>) -> String
	match step
		Encoded(_) => "encoded"
		Partial(_, _, _) => "partial"
		Invalid(_) => "invalid"
	end
end

fn encode_error_id(step: EncodeStep<()>) -> String
	match step
		Encoded(_) => "none"
		Partial(_, _, _) => "none"
		Invalid(EncodeError(id, _, _)) => id
	end
end

fn encode_error_path(step: EncodeStep<()>) -> String
	match step
		Encoded(_) => "none"
		Partial(_, _, _) => "none"
		Invalid(EncodeError(_, path, _)) => path
	end
end

fn encode_error_reason(step: EncodeStep<()>) -> String
	match step
		Encoded(_) => "none"
		Partial(_, _, _) => "none"
		Invalid(EncodeError(_, _, reason)) => reason
	end
end

fn emit_output_chunk(name: String, index: Int, chunk: ByteChunk, expected_hex: String) -> () effects [stdio]
	stdio::print("output_chunk ")
	stdio::print(name)
	stdio::print(" index ")
	stdio::print(int_to_string(index))
	stdio::print(" hex \"")
	stdio::print(expected_hex)
	stdio::print("\" count ")
	stdio::println(int_to_string(byte_count_to_int(byte_chunk_count(chunk))))
end

fn emit_chunk_list(name: String, chunk: ByteChunk, expected_hex: String) -> () effects [stdio]
	stdio::print("output_chunk_list ")
	stdio::print(name)
	stdio::println(" count 1")
	emit_output_chunk(name, 0, chunk, expected_hex)
end

fn emit_one_chunk(name: String, step: EncodeStep<()>, expected_hex: String) -> () effects [stdio]
	match step
		Encoded(Cons(chunk, Nil)) => emit_chunk_list(name, chunk, expected_hex)
		Encoded(_) => stdio::println("unexpected encoded chunk count")
		Partial(_, _, _) => stdio::println("unexpected partial encode")
		Invalid(_) => stdio::println("unexpected encode failure")
	end
end

fn five_items() -> List<Int>
	list_cons(1, list_cons(2, list_cons(3, list_cons(4, list_cons(255, list_nil())))))
end

fn six_items() -> List<Int>
	list_cons(1, list_cons(2, list_cons(3, list_cons(4, list_cons(5, list_cons(255, list_nil()))))))
end

fn encode_result_step(encoded: Result<ByteChunk, EncodeError>) -> EncodeStep<()>
	match encoded
		Ok(chunk) => Encoded(list_cons(chunk, list_nil()))
		Err(error) => Invalid(error)
	end
end

pub fn main() -> Result<(), String> effects [stdio]
	let add_bytes: ByteChunk = byte_chunk_from_hex("0203000100020003000400ff")?
	let add_view: ByteView = byte_view(add_bytes, byte_offset(0)?, byte_count(12)?)?
	let add_decoded: DecodeStep<{left_count: Int, right_count: Int, items: List<Int>}> = decode AddRepeatValues from add_view at byte_offset(11)?
	stdio::println("add")
	stdio::println(add_decode_kind(add_decoded))
	stdio::println(int_to_string(add_decoded_item_count(add_decoded)))
	stdio::println(int_to_string(add_decoded_item_sum(add_decoded)))
	stdio::println(int_to_string(add_consumed_count(add_decoded)))

	let short_bytes: ByteChunk = byte_chunk_from_hex("02")?
	let short_view: ByteView = byte_view(short_bytes, byte_offset(0)?, byte_count(1)?)?
	let add_waiting: DecodeStep<{left_count: Int, right_count: Int, items: List<Int>}> = decode AddRepeatValues from short_view at byte_offset(17)?
	stdio::println(add_decode_kind(add_waiting))
	stdio::println(add_readiness_kind(add_waiting))
	stdio::println(int_to_string(add_readiness_count(add_waiting)))
	stdio::println(int_to_string(add_consumed_count(add_waiting)))

	let subtract_invalid_bytes: ByteChunk = byte_chunk_from_hex("0102")?
	let subtract_invalid_view: ByteView = byte_view(subtract_invalid_bytes, byte_offset(0)?, byte_count(2)?)?
	let subtract_invalid: DecodeStep<{left_count: Int, right_count: Int, items: List<Int>}> = decode SubtractRepeatValues from subtract_invalid_view at byte_offset(19)?
	stdio::println("subtract")
	stdio::println(add_decode_kind(subtract_invalid))
	stdio::println(add_decode_error_id(subtract_invalid))
	stdio::println(int_to_string(add_decode_error_offset(subtract_invalid)))
	stdio::println(add_decode_error_path(subtract_invalid))
	stdio::println(int_to_string(add_consumed_count(subtract_invalid)))

	let product_bytes: ByteChunk = byte_chunk_from_hex("02030001000200030004000500ff")?
	let product_view: ByteView = byte_view(product_bytes, byte_offset(0)?, byte_count(14)?)?
	let product_decoded: DecodeStep<{row_count: Int, column_count: Int, items: List<Int>}> = decode ProductRepeatValues from product_view at byte_offset(23)?
	stdio::println("product")
	stdio::println(product_decode_kind(product_decoded))
	stdio::println(int_to_string(product_decoded_item_count(product_decoded)))
	stdio::println(int_to_string(product_decoded_item_sum(product_decoded)))
	stdio::println(int_to_string(product_consumed_count(product_decoded)))

	let add_encoded: EncodeStep<()> = encode_result_step(encode AddRepeatValues from {left_count: 2, right_count: 3, items: five_items()})
	stdio::println(encode_step_kind(add_encoded))
	emit_one_chunk("repeat-add", add_encoded, "0203000100020003000400ff")

	let subtract_encoded: EncodeStep<()> = encode_result_step(encode SubtractRepeatValues from {left_count: 5, right_count: 2, items: list_cons(1, list_cons(2, list_cons(255, list_nil())))})
	stdio::println(encode_step_kind(subtract_encoded))
	emit_one_chunk("repeat-subtract", subtract_encoded, "05020001000200ff")

	let product_encoded: EncodeStep<()> = encode_result_step(encode ProductRepeatValues from {row_count: 2, column_count: 3, items: six_items()})
	stdio::println(encode_step_kind(product_encoded))
	emit_one_chunk("repeat-product", product_encoded, "02030001000200030004000500ff")

	let invalid_encode: EncodeStep<()> = encode_result_step(encode ProductRepeatValues from {row_count: 2, column_count: 3, items: five_items()})
	stdio::println(encode_step_kind(invalid_encode))
	stdio::println(encode_error_id(invalid_encode))
	stdio::println(encode_error_path(invalid_encode))
	stdio::println(encode_error_reason(invalid_encode))
	Ok(())
end
