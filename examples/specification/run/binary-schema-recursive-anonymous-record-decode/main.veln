# Binary schema anonymous record fields decode recursive anonymous records.
use stdio

schema RecursiveAnonymousRecordPacket
	format binary

	prefix: UInt8
	header: {kind: UInt8, detail: {code: UInt16be, trailer: {tail: UInt16le}}, marker: UInt8}
	suffix: UInt8
end

fn explicit_tail(step: DecodeStep<{prefix: Int, header: {kind: Int, detail: {code: Int, trailer: {tail: Int}}, marker: Int}, suffix: Int}>) -> Int
	match step
		Decoded(packet, _) => packet.header.detail.trailer.tail
		NeedMore(_) => -1
		Invalid(_) => -1
	end
end

fn explicit_consumed(step: DecodeStep<{prefix: Int, header: {kind: Int, detail: {code: Int, trailer: {tail: Int}}, marker: Int}, suffix: Int}>) -> Int
	match step
		Decoded(_, consumed) => byte_count_to_int(consumed)
		NeedMore(_) => 0
		Invalid(_) => 0
	end
end

pub fn main() -> Result<(), String> effects [stdio]
	let bytes = byte_chunk_from_hex("0a010203040506ff")?
	let view = byte_view(bytes, byte_offset(0)?, byte_count(8)?)?
	let packet = byte_decode_recursive_anonymous_record_packet(view)?
	stdio::print("helper ")
	stdio::print(int_to_string(packet.prefix))
	stdio::print(" ")
	stdio::print(int_to_string(packet.header.kind))
	stdio::print(" ")
	stdio::print(int_to_string(packet.header.detail.code))
	stdio::print(" ")
	stdio::print(int_to_string(packet.header.detail.trailer.tail))
	stdio::print(" ")
	stdio::print(int_to_string(packet.header.marker))
	stdio::print(" ")
	stdio::println(int_to_string(packet.suffix))

	let step = decode RecursiveAnonymousRecordPacket from view at byte_offset(17)?
	stdio::print("explicit ")
	stdio::print(int_to_string(explicit_tail(step)))
	stdio::print(" ")
	stdio::println(int_to_string(explicit_consumed(step)))
	Ok(())
end
