use stdio

schema FiveByteReservedSuffixHeader
	format binary

	control: UInt7
	control_padding: ReservedBits(33, 5726623061)
end

fn encoded_value(chunk: ByteChunk) -> Result<Int, String>
	let view: ByteView = byte_view(chunk, byte_offset(0)?, byte_count(5)?)?
	byte_read_u40_be(view)
end

fn error_id(error: EncodeError) -> String
	match error
		EncodeError(id, _, _) => id
	end
end

fn error_path(error: EncodeError) -> String
	match error
		EncodeError(_, field_path, _) => field_path
	end
end

fn error_reason(error: EncodeError) -> String
	match error
		EncodeError(_, _, reason) => reason
	end
end

fn emit_error(error: EncodeError) -> () effects [stdio]
	stdio::println(error_id(error))
	stdio::println(error_path(error))
	stdio::println(error_reason(error))
end

fn emit_encoded(encoded: Result<ByteChunk, EncodeError>) -> Result<(), String> effects [stdio]
	match encoded
		Ok(chunk) => Ok(stdio::println(int_to_string(encoded_value(chunk)?)))
		Err(_) => Ok(stdio::println("unexpected encode failure"))
	end
end

fn emit_encode_error(encoded: Result<ByteChunk, EncodeError>) -> () effects [stdio]
	match encoded
		Ok(_) => stdio::println("unexpected encode success")
		Err(error) => emit_error(error)
	end
end

pub fn main() -> Result<(), String> effects [stdio]
	let bytes: ByteChunk = byte_chunk_from_hex("ab55555555")?
	let view: ByteView = byte_view(bytes, byte_offset(0)?, byte_count(5)?)?
	let decoded: {control: Int} = byte_decode_five_byte_reserved_suffix_header(view)?
	stdio::println(int_to_string(decoded.control))

	let encoded: Result<ByteChunk, EncodeError> = byte_encode_five_byte_reserved_suffix_header({control: 85})
	let ignored: () = emit_encoded(encoded)?

	let rejected: Result<ByteChunk, EncodeError> = byte_encode_five_byte_reserved_suffix_header({control: 128})
	emit_encode_error(rejected)
	Ok(())
end
