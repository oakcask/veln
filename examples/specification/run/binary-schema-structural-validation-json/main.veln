# Binary schema schema-level validation reports a failed predicate in JSON.
schema SchemaLevelValidationSample
	format binary

	length: UInt8
	padding_length: UInt8
	checksum: UInt8

	validate length == padding_length + checksum
end

pub fn main() -> Result<(), String>
	let bytes: ByteChunk = byte_chunk_from_hex("050204")?
	let view: ByteView = byte_view(bytes, byte_offset(0)?, byte_count(3)?)?
	let ignored: {length: Int, padding_length: Int, checksum: Int} = byte_decode_schema_level_validation_sample(view)?
	Ok(())
end
