# Binary schema mapping can carry a Flag16be field into a target record.
use stdio

type FlagPacket
	FlagPacket {target_flags: Flag16be}
end

schema FlagPacketWire
	format binary

	flags: Flag16be

	map to FlagPacket
		target_flags = flags
end

fn flag_bits(flags: Flag16be) -> Int
	match flags
		Flag16be(bits) => bits
	end
end

pub fn main() -> Result<(), String> effects [stdio]
	let bytes: ByteChunk = byte_chunk_from_hex("1234")?
	let view: ByteView = byte_view(bytes, byte_offset(0)?, byte_count(2)?)?
	let packet: {target_flags: Flag16be} = byte_decode_flag_packet_wire(view)?
	stdio::println(int_to_string(flag_bits(packet.target_flags)))
	Ok(())
end
