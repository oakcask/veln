use http2::core from "std"
use http2::diagnostic from "std"
# Client-side SETTINGS_ENABLE_PUSH rejection projects to a human diagnostic.

fn invalid_payload(error: String) -> RuntimeDiagnostic
	RuntimeDiagnostic(
		"http2.protocol.settings_not_allowed_for_endpoint",
		error,
		RuntimeHttp2Diagnostic(RuntimeHttp2ProtocolSettingsNotAllowedForEndpointDiagnostic(15, 2, "SETTINGS_ENABLE_PUSH", "client", 4, "peer-settings", "rfc9113_client_must_not_receive_settings_enable_push", byte_chunk([])))
	)
end

fn project(validation: PeerSettingsValidation) -> Result<(), RuntimeDiagnostic>
	match http2::core::peer_settings_validation_status(validation)
		"rejected" => project_failure(validation)
		_ => Err(invalid_payload("client peer SETTINGS_ENABLE_PUSH was accepted"))
	end
end

fn project_failure(validation: PeerSettingsValidation) -> Result<(), RuntimeDiagnostic>
	let failure: PeerSettingsFailure = match http2::core::peer_settings_validation_failure(validation)
		Ok(value) => value
		Err(error) => Err(invalid_payload(error))?
	end
	http2::diagnostic::protocol_settings_not_allowed_for_endpoint(http2::core::peer_settings_failure_offset(failure), http2::core::peer_settings_failure_setting_identifier(failure), http2::core::peer_settings_failure_setting_name(failure), http2::core::peer_settings_failure_endpoint_role(failure), http2::core::peer_settings_failure_frame_kind(failure), http2::core::peer_settings_failure_active_state(failure), http2::core::peer_settings_failure_rule_provenance(failure), http2::core::peer_settings_failure_preview(failure))
end

pub fn main() -> Result<(), RuntimeDiagnostic>
	match byte_chunk_from_hex("000200000001")
		Ok(payload) => match http2::core::validate_peer_settings_payload(15, "client", payload)
			Ok(validation) => project(validation)
			Err(error) => Err(invalid_payload(error))
		end
		Err(error) => Err(invalid_payload(error))
	end
end
