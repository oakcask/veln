# Informational response END_STREAM rejection keeps state and rule context in related notes.

fn invalid_payload(error: String) -> RuntimeDiagnostic
	RuntimeDiagnostic(
		"http2.protocol.invalid_response_header_list",
		error,
		RuntimeHttp2ProtocolInvalidResponseHeaderListDiagnostic(12, 1, 1, "informational_response_end_stream", ":status", ":status", "response-headers", "rfc9113_informational_response", byte_chunk([]))
	)
end

fn preview_bytes() -> Result<ByteChunk, RuntimeDiagnostic>
	match byte_chunk_from_hex("0803313033")
		Ok(bytes) => Ok(bytes)
		Err(error) => Err(invalid_payload(error))
	end
end

pub fn main() -> Result<(), RuntimeDiagnostic>
	let preview: ByteChunk = preview_bytes()?
	Err(RuntimeDiagnostic(
		"http2.protocol.invalid_response_header_list",
		"HTTP/2 informational response ended the stream at byte offset 12",
		RuntimeHttp2ProtocolInvalidResponseHeaderListDiagnostic(12, 1, 1, "informational_response_end_stream", ":status", ":status", "response-headers", "rfc9113_informational_response", preview)
	))
end
