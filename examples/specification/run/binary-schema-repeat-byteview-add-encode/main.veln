# Binary schema Repeat fields encode additive ByteView payload lengths.
use stdio

schema CountedViews
	format binary

	count: UInt8
	left_length: UInt8
	right_length: UInt8
	items: Repeat(count, ByteView(left_length + right_length))
end

fn emit_output_chunk(name: String, index: Int, chunk: ByteChunk, expected_hex: String) -> () effects [stdio]
	stdio::print("output_chunk ")
	stdio::print(name)
	stdio::print(" index ")
	stdio::print(int_to_string(index))
	stdio::print(" hex \"")
	stdio::print(expected_hex)
	stdio::print("\" count ")
	stdio::println(int_to_string(byte_count_to_int(byte_chunk_count(chunk))))
end

fn emit_output_chunk_list_header(name: String, count: Int) -> () effects [stdio]
	stdio::print("output_chunk_list ")
	stdio::print(name)
	stdio::print(" count ")
	stdio::println(int_to_string(count))
end

fn emit_encoded(bytes: ByteChunk) -> () effects [stdio]
	emit_output_chunk_list_header("counted-add-views", 1)
	emit_output_chunk("counted-add-views", 0, bytes, "020103aabbccddeeff0011")
end

pub fn main() -> Result<(), String> effects [stdio]
	let first_bytes = byte_chunk_from_hex("aabbccdd")?
	let second_bytes = byte_chunk_from_hex("eeff0011")?
	let first = byte_view(first_bytes, byte_offset(0)?, byte_count(4)?)?
	let second = byte_view(second_bytes, byte_offset(0)?, byte_count(4)?)?
	let items = list_cons(first, list_cons(second, list_nil()))
	let encoded = byte_encode_counted_views({count: 2, left_length: 1, right_length: 3, items: items})
	let emitted = match encoded
		Ok(bytes) => emit_encoded(bytes)
		Err(_) => stdio::println("unexpected encode failure")
	end
	Ok(())
end
