use fixture_effects
use fake_effects
use http2_service_effects
use http2::connection from "std"
use http2::core from "std"
use stdio

fn handler(event: Http2ApplicationEvent) -> Result<List<Http2ApplicationAction>, String>
	let _ = http2::core::application_event_stream_id(event)
	Err("callback should not run")
end

fn print_result(result: Result<(), Http2ServiceFailure>) -> Result<(), String> effects [stdio]
	match result
		Ok(_) => print_ok()
		Err(failure) => print_failure(failure)
	end
end

fn print_ok() -> Result<(), String> effects [stdio]
	stdio::println("ok")
	Ok(())
end

fn print_failure(failure: Http2ServiceFailure) -> Result<(), String> effects [stdio]
	stdio::print(http2::connection::service_failure_kind(failure))
	stdio::print(" ")
	stdio::print(http2::connection::service_failure_id(failure))
	stdio::print(" accepted ")
	stdio::print(int_to_string(http2::connection::service_failure_accepted(failure)))
	stdio::print(" stream ")
	stdio::println(int_to_string(http2::connection::service_failure_stream_id(failure)))
	Ok(())
end

fn fixture_body(resources: { listener : NetListener, stream : NetStream }) -> Result<(), String> effects [concurrency, stdio]
	let state = http2_service_effects::create_http2_service_state()
	let request = byte_chunk_from_hex("505249202a20485454502f322e300d0a0d0a534d0d0a0d0a000006040000000000000500008000000003010500000000")?
	print_result(handle http2::connection::serve_tcp(resources.listener, handler) with http2_service_effects::scripted(resources.listener, resources.stream, "ordinary", 1, request, state))
end

pub fn main() -> Result<(), String> effects [concurrency, fs, net, stdio]
	let state = fixture_effects::create_fixture()
	let resources = handle fixture_effects::resources() with fake_effects::network(state)
	fixture_body(resources)
end
