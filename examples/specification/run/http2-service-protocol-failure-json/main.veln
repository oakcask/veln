use fixture_effects
use fake_effects
use http2::connection from "std"
use http2::core from "std"
use http2::hpack from "std"
use stdio

fn ascii_header(name: String, value: String) -> Result<HeaderField, String>
	Ok(http2::hpack::header_field(name, byte_chunk_from_visible_ascii_string(value)?))
end

fn response_headers() -> Result<HeaderList, String>
	Ok(http2::hpack::prepend_header_field(ascii_header(":status", "204")?, http2::hpack::empty_header_list()))
end

fn handler(event: Http2ApplicationEvent) -> Result<List<Http2ApplicationAction>, String>
	Ok(list_cons(Http2ApplicationAction::Http2SendResponseHeaders(http2::core::application_event_stream_id(event), response_headers()?, true), list_nil()))
end

fn print_result(result: Result<(), Http2ServiceFailure>) -> Result<(), String> effects [stdio]
	match result
		Ok(_) => print_ok()
		Err(failure) => print_failure(failure)
	end
end

fn print_ok() -> Result<(), String> effects [stdio]
	stdio::println("ok")
	Ok(())
end

fn print_failure(failure: Http2ServiceFailure) -> Result<(), String> effects [stdio]
	stdio::print(http2::connection::service_failure_kind(failure))
	stdio::print(" ")
	stdio::print(http2::connection::service_failure_id(failure))
	stdio::print(" accepted ")
	stdio::print(int_to_string(http2::connection::service_failure_accepted(failure)))
	stdio::print(" stream ")
	stdio::println(int_to_string(http2::connection::service_failure_stream_id(failure)))
	Ok(())
end

fn fixture_body() -> Result<(), String> effects [net, concurrency, stdio]
	let listener = net::listen("127.0.0.1:0")
	print_result(http2::connection::serve_tcp(listener, handler))
end

pub fn main() -> Result<(), String> effects [concurrency, fs, net, stdio]
	let state = fixture_effects::create_fixture()
	handle handle fixture_body() with fake_effects::network(state) with fake_effects::clock(state)
end
