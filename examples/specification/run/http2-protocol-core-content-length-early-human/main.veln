use hpack_fixture

type OutboundStreamCredit
	OutboundOpenStreamContentLength(Int, Int, Int, Int)
end

type OutboundSendCredit
	OutboundSendCredit(Int, OutboundStreamCredit)
end

type OutboundDataDecision
	OutboundDataAccepted(Int, Bool, OutboundSendCredit)
	OutboundDataRejected(Int, Int, Bool, Http2ProtocolFailure)
end

type Http2ProtocolFailure
	ContentLengthMismatch {offset: Int, frame_kind: Int, stream_id: Int, expected_length: Int, observed_length: Int, active_state: String, rule_provenance: String, preview: ByteView}
end

fn invalid_payload(error: String) -> RuntimeDiagnostic
	RuntimeDiagnostic(
		"http2.protocol.content_length_mismatch",
		error,
		RuntimeHttp2Diagnostic(RuntimeHttp2ProtocolContentLengthMismatchDiagnostic(9, 0, 1, 5, 3, "open-stream", "rfc9113_content_length_body", byte_chunk([])))
	)
end

fn byte_chunk_view(bytes: ByteChunk) -> Result<ByteView, RuntimeDiagnostic>
	match byte_offset(0)
		Ok(offset) => match byte_view(bytes, offset, byte_chunk_count(bytes))
			Ok(view) => Ok(view)
			Err(error) => Err(invalid_payload(error))
		end
		Err(error) => Err(invalid_payload(error))
	end
end

fn accepted_request_send_credit() -> OutboundSendCredit
	let headers: HpackHeaderList = hpack_fixture::outbound_request_content_length_headers()
	OutboundSendCredit(20, OutboundOpenStreamContentLength(1, 20, hpack_fixture::header_list_accepted_content_length(headers), 0))
end

fn send_data(stream_id: Int, payload: ByteChunk, end_stream: Bool, send_credit: OutboundSendCredit) -> Result<OutboundDataDecision, RuntimeDiagnostic>
	let application_length: Int = byte_count_to_int(byte_chunk_count(payload))
	match send_credit
		OutboundSendCredit(connection_window, OutboundOpenStreamContentLength(open_stream_id, stream_window, expected_length, observed_length)) => match stream_id == open_stream_id
			true => validate_outbound_content_length(stream_id, payload, application_length, end_stream, connection_window, stream_window, expected_length, observed_length)
			false => Ok(OutboundDataRejected(stream_id, application_length, end_stream, ContentLengthMismatch(9, 0, stream_id, expected_length, observed_length + application_length, "open-stream", "outbound_stream_window", byte_chunk_view(payload)?)))
		end
	end
end

fn validate_outbound_content_length(stream_id: Int, payload: ByteChunk, application_length: Int, end_stream: Bool, connection_window: Int, stream_window: Int, expected_length: Int, observed_length: Int) -> Result<OutboundDataDecision, RuntimeDiagnostic>
	let next_observed_length: Int = observed_length + application_length
	match next_observed_length > expected_length
		true => Ok(OutboundDataRejected(stream_id, application_length, end_stream, ContentLengthMismatch(9, 0, stream_id, expected_length, next_observed_length, "open-stream", "rfc9113_content_length_body", byte_chunk_view(payload)?)))
		false => match end_stream and next_observed_length < expected_length
			true => Ok(OutboundDataRejected(stream_id, application_length, end_stream, ContentLengthMismatch(9, 0, stream_id, expected_length, next_observed_length, "open-stream", "rfc9113_content_length_body", byte_chunk_view(payload)?)))
			false => Ok(OutboundDataAccepted(application_length, end_stream, OutboundSendCredit(connection_window - application_length, OutboundOpenStreamContentLength(stream_id, stream_window - application_length, expected_length, next_observed_length))))
		end
	end
end

fn content_length_payload(offset: Int, frame_kind: Int, stream_id: Int, expected_length: Int, observed_length: Int, active_state: String, rule_provenance: String, preview: ByteView) -> RuntimeDiagnostic
	RuntimeDiagnostic(
		"http2.protocol.content_length_mismatch",
		"HTTP/2 content-length body length mismatch at byte offset 9",
		RuntimeHttp2Diagnostic(RuntimeHttp2ProtocolContentLengthMismatchDiagnostic(offset, frame_kind, stream_id, expected_length, observed_length, active_state, rule_provenance, byte_view_to_chunk(preview)))
	)
end

fn project(failure: Http2ProtocolFailure) -> Result<(), RuntimeDiagnostic>
	match failure
		ContentLengthMismatch(offset, frame_kind, stream_id, expected_length, observed_length, active_state, rule_provenance, preview) => Err(content_length_payload(offset, frame_kind, stream_id, expected_length, observed_length, active_state, rule_provenance, preview))
	end
end

fn data_bytes() -> Result<ByteChunk, RuntimeDiagnostic>
	match byte_chunk_from_hex("aabbcc")
		Ok(bytes) => Ok(bytes)
		Err(error) => Err(invalid_payload(error))
	end
end

pub fn main() -> Result<(), RuntimeDiagnostic>
	let decision: OutboundDataDecision = send_data(1, data_bytes()?, true, accepted_request_send_credit())?
	match decision
		OutboundDataAccepted(_, _, _) => Ok(())
		OutboundDataRejected(_, _, _, failure) => project(failure)
	end
end
