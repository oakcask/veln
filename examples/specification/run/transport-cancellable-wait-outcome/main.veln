# Adapter-owned waits translate cancellation outcomes into ordinary decisions.
use stdio

type TransportDecision
	Ready
	RetryAfterDeadline
	CleanupAfterCancel
end

fn wait_for_transport_slot(deadline: Deadline, token: CancelToken) -> TransportDecision effects [time]
	match time::wait_until_cancellable_outcome(deadline, token)
		WaitCompleted => Ready
		WaitDeadlineExpired => RetryAfterDeadline
		WaitCancelled => CleanupAfterCancel
	end
end

fn decision_text(decision: TransportDecision) -> String
	match decision
		Ready => "ready"
		RetryAfterDeadline => "retry"
		CleanupAfterCancel => "cleanup"
	end
end

pub fn main() -> Result<(), String> effects [time, stdio]
	let ready_deadline = time::deadline_after_ms(0)
	let ready_token = time::cancel_token()
	stdio::println(decision_text(wait_for_transport_slot(ready_deadline, ready_token)))

	let cancel_deadline = time::deadline_after_ms(0)
	let cancel_token = time::cancel_token()
	time::cancel(cancel_token)
	stdio::println(decision_text(wait_for_transport_slot(cancel_deadline, cancel_token)))
	Ok(())
end
