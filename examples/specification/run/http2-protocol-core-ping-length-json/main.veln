# HTTP/2 PING payload length failures project structured runtime details.

type Http2ProtocolFailure
	InvalidPayloadLength {offset: Int, frame_kind: Int, stream_id: Int, observed_length: Int, expected_length: Int, preview: ByteView}
end

type Http2DiagnosticContext
	DiagnosticContext(String, String)
end

fn context_active_state(context: Http2DiagnosticContext) -> String
	match context
		DiagnosticContext(active_state, _) => active_state
	end
end

fn context_rule_provenance(context: Http2DiagnosticContext) -> String
	match context
		DiagnosticContext(_, rule_provenance) => rule_provenance
	end
end

fn http2_protocol_diagnostic(failure: Http2ProtocolFailure, context: Http2DiagnosticContext) -> Result<(), String>
	match failure
		InvalidPayloadLength(offset, frame_kind, stream_id, observed_length, expected_length, preview) => http2_protocol_invalid_payload_length(offset, frame_kind, stream_id, observed_length, expected_length, context_active_state(context), context_rule_provenance(context), preview)
	end
end

pub fn main() -> Result<(), String>
	let context: Http2DiagnosticContext = DiagnosticContext("connection-control", "rfc9113_ping_payload_length")
	let bytes: ByteChunk = byte_chunk_from_hex("01020304050607")?
	let preview: ByteView = byte_view(bytes, byte_offset(0)?, byte_count(7)?)?
	http2_protocol_diagnostic(InvalidPayloadLength(0, 6, 0, 7, 8, preview), context)
end
