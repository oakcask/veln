# Binary schema Flag16be decode expressions preserve bitset values and consumed counts.
use stdio

schema FlagStepPacket
	format binary

	flags: Flag16be
	kind: UInt8
end

fn flag_bits(flags: Flag16be) -> Int
	match flags
		Flag16be(bits) => bits
	end
end

fn step_kind(step: DecodeStep<{flags: Flag16be, kind: Int}>) -> String
	match step
		Decoded(_, _) => "decoded"
		NeedMore(_) => "need_more"
		Invalid(_) => "invalid"
	end
end

fn decoded_flags(step: DecodeStep<{flags: Flag16be, kind: Int}>) -> Int
	match step
		Decoded(packet, _) => flag_bits(packet.flags)
		NeedMore(_) => -1
		Invalid(_) => -1
	end
end

fn decoded_kind(step: DecodeStep<{flags: Flag16be, kind: Int}>) -> Int
	match step
		Decoded(packet, _) => packet.kind
		NeedMore(_) => -1
		Invalid(_) => -1
	end
end

fn consumed_count(step: DecodeStep<{flags: Flag16be, kind: Int}>) -> Int
	match step
		Decoded(_, consumed) => byte_count_to_int(consumed)
		NeedMore(_) => 0
		Invalid(_) => 0
	end
end

pub fn main() -> Result<(), String> effects [stdio]
	let bytes: ByteChunk = byte_chunk_from_hex("123407")?
	let view: ByteView = byte_view(bytes, byte_offset(0)?, byte_count(3)?)?
	let base: ByteOffset = byte_offset(16)?
	let step: DecodeStep<{flags: Flag16be, kind: Int}> = decode FlagStepPacket from view at base
	stdio::println(step_kind(step))
	stdio::println(int_to_string(decoded_flags(step)))
	stdio::println(int_to_string(decoded_kind(step)))
	stdio::println(int_to_string(consumed_count(step)))
	Ok(())
end
