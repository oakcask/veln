# Runtime refinement failures retain their structured byte diagnostic.

pub type State
	pub Connected
	pub Closed
end

schema Child
	state: State::Connected
end

schema ConnectedPacket
	child: Child
end

pub fn main() -> Result<{child: {state: State::Connected}}, DecodeError>
	match byte_offset(19)
		Ok(offset) => validate ConnectedPacket from {child: {state: Closed}} at offset
		Err(_) => main()
	end
end
