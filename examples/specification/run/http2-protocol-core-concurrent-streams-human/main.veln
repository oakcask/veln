# HTTP/2 concurrent stream limit failures project to human runtime diagnostics.

type Http2ProtocolFailure
	ConcurrentStreamsExceeded {offset: Int, stream_id: Int, attempted_count: Int, allowed_count: Int, endpoint_role: String, active_state: String, receive_limit_provenance: String, rule_provenance: String}
end

fn project(failure: Http2ProtocolFailure) -> Result<(), String>
	match failure
		ConcurrentStreamsExceeded(offset, stream_id, attempted_count, allowed_count, endpoint_role, active_state, receive_limit_provenance, rule_provenance) => http2_peer_limit_concurrent_streams_exceeded(offset, stream_id, attempted_count, allowed_count, endpoint_role, active_state, receive_limit_provenance, rule_provenance)
	end
end

pub fn main() -> Result<(), String>
	project(ConcurrentStreamsExceeded(9, 3, 2, 1, "server", "open-stream", "local_configuration", "peer_created_stream_receive_limit"))
end
