# HTTP/2 request te header values project to human runtime diagnostics.

type Http2ProtocolFailure
	InvalidRequestHeaderList({offset: Int, frame_kind: Int, stream_id: Int, failed_header_fact: String, header_name: String, decoded_header_names: String})
end

type Http2DiagnosticContext
	DiagnosticContext(String, String)
end

fn context_active_state(context: Http2DiagnosticContext) -> String
	match context
		DiagnosticContext(active_state, _) => active_state
	end
end

fn context_rule_provenance(context: Http2DiagnosticContext) -> String
	match context
		DiagnosticContext(_, rule_provenance) => rule_provenance
	end
end

fn http2_protocol_diagnostic(failure: Http2ProtocolFailure, context: Http2DiagnosticContext) -> Result<(), String>
	match failure
		InvalidRequestHeaderList(payload) => http2_protocol_invalid_request_header_list(payload.offset, payload.frame_kind, payload.stream_id, payload.failed_header_fact, payload.header_name, payload.decoded_header_names, context_active_state(context), context_rule_provenance(context))
	end
end

pub fn main() -> Result<(), String>
	let context: Http2DiagnosticContext = DiagnosticContext("request-headers", "rfc9113_te_trailers_only")
	http2_protocol_diagnostic(InvalidRequestHeaderList({offset: 12, frame_kind: 1, stream_id: 1, failed_header_fact: "te_header_value_not_trailers", header_name: "te", decoded_header_names: ":method,:scheme,:path,te"}), context)
end
