fn decoded_nested_optional_dict_score(result: Result<{metadata: {scores: Option<Dict<String, Int>>, labels: Option<Dict<String, String>>, states: Option<Dict<String, Bool>>, weights: Option<Dict<String, Float>>}}, String>) -> Int
	match result
		Ok(packet) => match packet.metadata.scores
			Some(scores) => match dict_get(scores, "math")
				Some(score) => score
				None => -1
			end
			None => -10
		end
		Err(_) => -2
	end
end

fn decoded_nested_optional_dict_label(result: Result<{metadata: {scores: Option<Dict<String, Int>>, labels: Option<Dict<String, String>>, states: Option<Dict<String, Bool>>, weights: Option<Dict<String, Float>>}}, String>) -> String
	match result
		Ok(packet) => match packet.metadata.labels
			Some(labels) => match dict_get(labels, "owner")
				Some(label) => label
				None => "missing-key"
			end
			None => "missing-option"
		end
		Err(message) => message
	end
end

fn decoded_nested_optional_dict_state(result: Result<{metadata: {scores: Option<Dict<String, Int>>, labels: Option<Dict<String, String>>, states: Option<Dict<String, Bool>>, weights: Option<Dict<String, Float>>}}, String>) -> String
	match result
		Ok(packet) => match packet.metadata.states
			Some(states) => match dict_get(states, "enabled")
				Some(enabled) => if enabled
					"nested-option-enabled"
				else
					"nested-option-disabled"
				end
				None => "missing-key"
			end
			None => "missing-option"
		end
		Err(message) => message
	end
