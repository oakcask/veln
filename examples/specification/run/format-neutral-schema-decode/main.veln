# Format-neutral schema decode helpers accept schema-local visible records.
use stdio

schema PlainPacket
	code: Int
	label: String
	items: List<Int>
	flags: List<Bool>
	ratios: List<Float>
	names: List<String>
	scores: Dict<String, Int>
	labels: Dict<String, String>
	states: Dict<String, Bool>
	weights: Dict<String, Float>
	metadata: {ready: Bool, score: Float}
	optional_code: Option<Int>
	optional_metadata: Option<{ready: Bool, score: Float}>
end

schema NestedOptionPacket
	metadata: {label: Option<String>, retries: Option<Int>, active: Option<Bool>, ratio: Option<Float>}
end

schema NestedListPacket
	metadata: {items: List<Int>, flags: List<Bool>, ratios: List<Float>, names: List<String>}
end

schema NestedDictPacket
	metadata: {scores: Dict<String, Int>, labels: Dict<String, String>, states: Dict<String, Bool>, weights: Dict<String, Float>}
end

schema OptionDictPacket
	scores: Option<Dict<String, Int>>
	labels: Option<Dict<String, String>>
	states: Option<Dict<String, Bool>>
	weights: Option<Dict<String, Float>>
end

schema NestedOptionDictPacket
	metadata: {scores: Option<Dict<String, Int>>, labels: Option<Dict<String, String>>, states: Option<Dict<String, Bool>>, weights: Option<Dict<String, Float>>}
end

fn list_sum(items: List<Int>) -> Int
	match items
		Nil => 0
		Cons(head, tail) => head + list_sum(tail)
	end
end

fn decoded_code(result: Result<{code: Int, label: String, items: List<Int>, flags: List<Bool>, ratios: List<Float>, names: List<String>, scores: Dict<String, Int>, labels: Dict<String, String>, states: Dict<String, Bool>, weights: Dict<String, Float>, metadata: {ready: Bool, score: Float}, optional_code: Option<Int>, optional_metadata: Option<{ready: Bool, score: Float}>}, String>) -> Int
	match result
		Ok(packet) => packet.code
		Err(_) => -1
	end
end

fn decoded_label(result: Result<{code: Int, label: String, items: List<Int>, flags: List<Bool>, ratios: List<Float>, names: List<String>, scores: Dict<String, Int>, labels: Dict<String, String>, states: Dict<String, Bool>, weights: Dict<String, Float>, metadata: {ready: Bool, score: Float}, optional_code: Option<Int>, optional_metadata: Option<{ready: Bool, score: Float}>}, String>) -> String
	match result
		Ok(packet) => packet.label
		Err(message) => message
	end
end

fn decoded_item_sum(result: Result<{code: Int, label: String, items: List<Int>, flags: List<Bool>, ratios: List<Float>, names: List<String>, scores: Dict<String, Int>, labels: Dict<String, String>, states: Dict<String, Bool>, weights: Dict<String, Float>, metadata: {ready: Bool, score: Float}, optional_code: Option<Int>, optional_metadata: Option<{ready: Bool, score: Float}>}, String>) -> Int
	match result
		Ok(packet) => list_sum(packet.items)
		Err(_) => -1
	end
end

fn decoded_first_name(result: Result<{code: Int, label: String, items: List<Int>, flags: List<Bool>, ratios: List<Float>, names: List<String>, scores: Dict<String, Int>, labels: Dict<String, String>, states: Dict<String, Bool>, weights: Dict<String, Float>, metadata: {ready: Bool, score: Float}, optional_code: Option<Int>, optional_metadata: Option<{ready: Bool, score: Float}>}, String>) -> String
	match result
		Ok(packet) => match packet.names
			Nil => "missing"
			Cons(head, _) => head
		end
		Err(message) => message
	end
end

fn bool_list_score(flags: List<Bool>) -> Int
	match flags
		Nil => 0
		Cons(head, tail) => if head
			1 + bool_list_score(tail)
		else
			bool_list_score(tail)
		end
	end
end

fn decoded_flag_count(result: Result<{code: Int, label: String, items: List<Int>, flags: List<Bool>, ratios: List<Float>, names: List<String>, scores: Dict<String, Int>, labels: Dict<String, String>, states: Dict<String, Bool>, weights: Dict<String, Float>, metadata: {ready: Bool, score: Float}, optional_code: Option<Int>, optional_metadata: Option<{ready: Bool, score: Float}>}, String>) -> Int
	match result
		Ok(packet) => bool_list_score(packet.flags)
		Err(_) => -1
	end
end

fn decoded_ratio_status(result: Result<{code: Int, label: String, items: List<Int>, flags: List<Bool>, ratios: List<Float>, names: List<String>, scores: Dict<String, Int>, labels: Dict<String, String>, states: Dict<String, Bool>, weights: Dict<String, Float>, metadata: {ready: Bool, score: Float}, optional_code: Option<Int>, optional_metadata: Option<{ready: Bool, score: Float}>}, String>) -> String
	match result
		Ok(packet) => match packet.ratios
			Nil => "missing"
			Cons(head, _) => if head > 1.0
				"ratio-high"
			else
				"ratio-low"
			end
		end
		Err(message) => message
	end
end

fn decoded_score(result: Result<{code: Int, label: String, items: List<Int>, flags: List<Bool>, ratios: List<Float>, names: List<String>, scores: Dict<String, Int>, labels: Dict<String, String>, states: Dict<String, Bool>, weights: Dict<String, Float>, metadata: {ready: Bool, score: Float}, optional_code: Option<Int>, optional_metadata: Option<{ready: Bool, score: Float}>}, String>) -> Int
	match result
		Ok(packet) => match dict_get(packet.scores, "math")
			Some(score) => score
			None => -1
		end
		Err(_) => -2
	end
end

fn decoded_tag(result: Result<{code: Int, label: String, items: List<Int>, flags: List<Bool>, ratios: List<Float>, names: List<String>, scores: Dict<String, Int>, labels: Dict<String, String>, states: Dict<String, Bool>, weights: Dict<String, Float>, metadata: {ready: Bool, score: Float}, optional_code: Option<Int>, optional_metadata: Option<{ready: Bool, score: Float}>}, String>) -> String
	match result
		Ok(packet) => match dict_get(packet.labels, "owner")
			Some(tag) => tag
			None => "missing"
		end
		Err(message) => message
	end
end

fn decoded_state(result: Result<{code: Int, label: String, items: List<Int>, flags: List<Bool>, ratios: List<Float>, names: List<String>, scores: Dict<String, Int>, labels: Dict<String, String>, states: Dict<String, Bool>, weights: Dict<String, Float>, metadata: {ready: Bool, score: Float}, optional_code: Option<Int>, optional_metadata: Option<{ready: Bool, score: Float}>}, String>) -> String
	match result
		Ok(packet) => match dict_get(packet.states, "enabled")
			Some(enabled) => if enabled
				"enabled"
			else
				"disabled"
			end
			None => "missing"
		end
		Err(message) => message
	end
end

fn decoded_weight(result: Result<{code: Int, label: String, items: List<Int>, flags: List<Bool>, ratios: List<Float>, names: List<String>, scores: Dict<String, Int>, labels: Dict<String, String>, states: Dict<String, Bool>, weights: Dict<String, Float>, metadata: {ready: Bool, score: Float}, optional_code: Option<Int>, optional_metadata: Option<{ready: Bool, score: Float}>}, String>) -> String
	match result
		Ok(packet) => match dict_get(packet.weights, "ratio")
			Some(weight) => if weight > 1.0
				"weight-high"
			else
				"weight-low"
			end
			None => "missing"
		end
		Err(message) => message
	end
end

fn decoded_optional_code(result: Result<{code: Int, label: String, items: List<Int>, flags: List<Bool>, ratios: List<Float>, names: List<String>, scores: Dict<String, Int>, labels: Dict<String, String>, states: Dict<String, Bool>, weights: Dict<String, Float>, metadata: {ready: Bool, score: Float}, optional_code: Option<Int>, optional_metadata: Option<{ready: Bool, score: Float}>}, String>) -> Int
	match result
		Ok(packet) => match packet.optional_code
			Some(value) => value
			None => -1
		end
		Err(_) => -2
	end
end

fn decoded_optional_metadata(result: Result<{code: Int, label: String, items: List<Int>, flags: List<Bool>, ratios: List<Float>, names: List<String>, scores: Dict<String, Int>, labels: Dict<String, String>, states: Dict<String, Bool>, weights: Dict<String, Float>, metadata: {ready: Bool, score: Float}, optional_code: Option<Int>, optional_metadata: Option<{ready: Bool, score: Float}>}, String>) -> String
	match result
		Ok(packet) => match packet.optional_metadata
			Some(metadata) => if metadata.ready
				"ready"
			else
				"blocked"
			end
			None => "missing"
		end
		Err(message) => message
	end
end

fn decoded_nested_option_label(result: Result<{metadata: {label: Option<String>, retries: Option<Int>, active: Option<Bool>, ratio: Option<Float>}}, String>) -> String
	match result
		Ok(packet) => match packet.metadata.label
			Some(label) => label
			None => "missing"
		end
		Err(message) => message
	end
end

fn decoded_nested_option_retries(result: Result<{metadata: {label: Option<String>, retries: Option<Int>, active: Option<Bool>, ratio: Option<Float>}}, String>) -> Int
	match result
		Ok(packet) => match packet.metadata.retries
			Some(retries) => retries
			None => -1
		end
		Err(_) => -2
	end
end

fn decoded_nested_option_active(result: Result<{metadata: {label: Option<String>, retries: Option<Int>, active: Option<Bool>, ratio: Option<Float>}}, String>) -> String
	match result
		Ok(packet) => match packet.metadata.active
			Some(active) => if active
				"active"
			else
				"inactive"
			end
			None => "missing"
		end
		Err(message) => message
	end
end

fn decoded_nested_option_ratio(result: Result<{metadata: {label: Option<String>, retries: Option<Int>, active: Option<Bool>, ratio: Option<Float>}}, String>) -> String
	match result
		Ok(packet) => match packet.metadata.ratio
			Some(ratio) => if ratio > 1.0
				"ratio-high"
			else
				"ratio-low"
			end
			None => "missing"
		end
		Err(message) => message
	end
end

fn decoded_nested_list_item_sum(result: Result<{metadata: {items: List<Int>, flags: List<Bool>, ratios: List<Float>, names: List<String>}}, String>) -> Int
	match result
		Ok(packet) => list_sum(packet.metadata.items)
		Err(_) => -1
	end
end

fn decoded_nested_list_flag_count(result: Result<{metadata: {items: List<Int>, flags: List<Bool>, ratios: List<Float>, names: List<String>}}, String>) -> Int
	match result
		Ok(packet) => bool_list_score(packet.metadata.flags)
		Err(_) => -1
	end
end

fn decoded_nested_list_ratio_status(result: Result<{metadata: {items: List<Int>, flags: List<Bool>, ratios: List<Float>, names: List<String>}}, String>) -> String
	match result
		Ok(packet) => match packet.metadata.ratios
			Nil => "missing"
			Cons(head, _) => if head > 1.0
				"nested-ratio-high"
			else
				"nested-ratio-low"
			end
		end
		Err(message) => message
	end
end

fn decoded_nested_list_first_name(result: Result<{metadata: {items: List<Int>, flags: List<Bool>, ratios: List<Float>, names: List<String>}}, String>) -> String
	match result
		Ok(packet) => match packet.metadata.names
			Nil => "missing"
			Cons(head, _) => head
		end
		Err(message) => message
	end
end

fn decoded_nested_score(result: Result<{metadata: {scores: Dict<String, Int>, labels: Dict<String, String>, states: Dict<String, Bool>, weights: Dict<String, Float>}}, String>) -> Int
	match result
		Ok(packet) => match dict_get(packet.metadata.scores, "math")
			Some(score) => score
			None => -1
		end
		Err(_) => -2
	end
end

fn decoded_nested_tag(result: Result<{metadata: {scores: Dict<String, Int>, labels: Dict<String, String>, states: Dict<String, Bool>, weights: Dict<String, Float>}}, String>) -> String
	match result
		Ok(packet) => match dict_get(packet.metadata.labels, "owner")
			Some(tag) => tag
			None => "missing"
		end
		Err(message) => message
	end
end

