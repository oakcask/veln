	match result
		Ok(packet) => match dict_get(packet.metadata.states, "enabled")
			Some(enabled) => if enabled
				"nested-enabled"
			else
				"nested-disabled"
			end
			None => "missing"
		end
		Err(message) => message
	end
end

fn decoded_nested_weight(result: Result<{metadata: {scores: Dict<String, Int>, labels: Dict<String, String>, states: Dict<String, Bool>, weights: Dict<String, Float>}}, String>) -> String
	match result
		Ok(packet) => match dict_get(packet.metadata.weights, "ratio")
			Some(weight) => if weight > 1.0
				"nested-weight-high"
			else
				"nested-weight-low"
			end
			None => "missing"
		end
		Err(message) => message
	end
end

fn decoded_optional_dict_score(result: Result<{scores: Option<Dict<String, Int>>, labels: Option<Dict<String, String>>, states: Option<Dict<String, Bool>>, weights: Option<Dict<String, Float>>}, String>) -> Int
	match result
		Ok(packet) => match packet.scores
			Some(scores) => match dict_get(scores, "math")
				Some(score) => score
				None => -1
			end
			None => -10
		end
		Err(_) => -2
	end
end

fn decoded_optional_dict_label(result: Result<{scores: Option<Dict<String, Int>>, labels: Option<Dict<String, String>>, states: Option<Dict<String, Bool>>, weights: Option<Dict<String, Float>>}, String>) -> String
	match result
		Ok(packet) => match packet.labels
			Some(labels) => match dict_get(labels, "owner")
				Some(label) => label
				None => "missing-key"
			end
			None => "missing-option"
		end
		Err(message) => message
	end
end

fn decoded_optional_dict_state(result: Result<{scores: Option<Dict<String, Int>>, labels: Option<Dict<String, String>>, states: Option<Dict<String, Bool>>, weights: Option<Dict<String, Float>>}, String>) -> String
	match result
		Ok(packet) => match packet.states
			Some(states) => match dict_get(states, "enabled")
				Some(enabled) => if enabled
					"option-enabled"
				else
					"option-disabled"
				end
				None => "missing-key"
			end
			None => "missing-option"
		end
		Err(message) => message
	end
end

fn decoded_optional_dict_weight(result: Result<{scores: Option<Dict<String, Int>>, labels: Option<Dict<String, String>>, states: Option<Dict<String, Bool>>, weights: Option<Dict<String, Float>>}, String>) -> String
	match result
		Ok(packet) => match packet.weights
			Some(weights) => match dict_get(weights, "ratio")
				Some(weight) => if weight > 1.0
					"option-weight-high"
				else
