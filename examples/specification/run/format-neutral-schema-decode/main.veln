# Format-neutral schema decode helpers accept schema-local visible records.
use stdio

schema PlainPacket
	code: Int
	label: String
	metadata: {ready: Bool, score: Float}
	optional_code: Option<Int>
	optional_metadata: Option<{ready: Bool, score: Float}>
end

fn decoded_code(result: Result<{code: Int, label: String, metadata: {ready: Bool, score: Float}, optional_code: Option<Int>, optional_metadata: Option<{ready: Bool, score: Float}>}, String>) -> Int
	match result
		Ok(packet) => packet.code
		Err(_) => -1
	end
end

fn decoded_label(result: Result<{code: Int, label: String, metadata: {ready: Bool, score: Float}, optional_code: Option<Int>, optional_metadata: Option<{ready: Bool, score: Float}>}, String>) -> String
	match result
		Ok(packet) => packet.label
		Err(message) => message
	end
end

fn decoded_optional_code(result: Result<{code: Int, label: String, metadata: {ready: Bool, score: Float}, optional_code: Option<Int>, optional_metadata: Option<{ready: Bool, score: Float}>}, String>) -> Int
	match result
		Ok(packet) => match packet.optional_code
			Some(value) => value
			None => -1
		end
		Err(_) => -2
	end
end

fn decoded_optional_metadata(result: Result<{code: Int, label: String, metadata: {ready: Bool, score: Float}, optional_code: Option<Int>, optional_metadata: Option<{ready: Bool, score: Float}>}, String>) -> String
	match result
		Ok(packet) => match packet.optional_metadata
			Some(metadata) => match metadata.ready
				true => "ready"
				false => "blocked"
			end
			None => "missing"
		end
		Err(message) => message
	end
end

pub fn main() -> Result<(), String> effects [stdio]
	let decoded: Result<{code: Int, label: String, metadata: {ready: Bool, score: Float}, optional_code: Option<Int>, optional_metadata: Option<{ready: Bool, score: Float}>}, String> = byte_decode_plain_packet({code: 7, label: "ready", metadata: {ready: true, score: 1.5}, optional_code: Some(9), optional_metadata: Some({ready: true, score: 2.5})})
	stdio::println(int_to_string(decoded_code(decoded)))
	stdio::println(decoded_label(decoded))
	stdio::println(int_to_string(decoded_optional_code(decoded)))
	stdio::println(decoded_optional_metadata(decoded))
	Ok(())
end
