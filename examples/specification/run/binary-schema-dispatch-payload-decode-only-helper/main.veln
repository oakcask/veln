# Direction-specific nested dispatch payload decode accepts decode-only helpers.
use stdio

type MappedPayload
	MappedPayload {code: Int}
end

schema UnsupportedMappedPayload
	format binary

	code: UInt8

	map to MappedPayload
		code = code * 2
end

schema ClosedPacket
	format binary

	kind: UInt8
	payload: Dispatch(kind, 1 => UnsupportedMappedPayload)
end

codec ClosedPacketCodec for ClosedPacket decode
	derive decode
end

fn mapped_code(payload: {code: Int}) -> Int
	payload.code
end

fn step_kind(step: DecodeStep<{kind: Int, payload: {code: Int}}>) -> String
	match step
		Decoded(_, _) => "decoded"
		NeedMore(_) => "need_more"
		Invalid(_) => "invalid"
	end
end

fn step_payload_code(step: DecodeStep<{kind: Int, payload: {code: Int}}>) -> Int
	match step
		Decoded(packet, _) => mapped_code(packet.payload)
		NeedMore(_) => -1
		Invalid(_) => -1
	end
end

fn step_consumed(step: DecodeStep<{kind: Int, payload: {code: Int}}>) -> Int
	match step
		Decoded(_, consumed) => byte_count_to_int(consumed)
		NeedMore(_) => 0
		Invalid(_) => 0
	end
end

pub fn main() -> Result<(), String> effects [stdio]
	let bytes: ByteChunk = byte_chunk_from_hex("0107")?
	let view: ByteView = byte_view(bytes, byte_offset(0)?, byte_count(2)?)?

	let direct: {kind: Int, payload: {code: Int}} = byte_decode_closed_packet(view)?
	stdio::print("direct ")
	stdio::print(int_to_string(direct.kind))
	stdio::print(" ")
	stdio::println(int_to_string(mapped_code(direct.payload)))

	let step: DecodeStep<{kind: Int, payload: {code: Int}}> = byte_decode_step_closed_packet(view, byte_offset(3)?)
	stdio::print("step ")
	stdio::print(step_kind(step))
	stdio::print(" ")
	stdio::print(int_to_string(step_payload_code(step)))
	stdio::print(" ")
	stdio::println(int_to_string(step_consumed(step)))

	let derived: DecodeStep<{kind: Int, payload: {code: Int}}> = ClosedPacketCodec(view, byte_offset(5)?)
	stdio::print("derived ")
	stdio::print(step_kind(derived))
	stdio::print(" ")
	stdio::print(int_to_string(step_payload_code(derived)))
	stdio::print(" ")
	stdio::println(int_to_string(step_consumed(derived)))
	Ok(())
end
