# Direct length mismatch decode failures render focused human diagnostics.

schema ManualPacketWire
	format binary

	length: UInt16be
	payload: ByteView(length)
end

fn offset(value: Int) -> ByteOffset
	byte_offset(value)?
end

pub fn main() -> Result<(), DecodeError>
	Err(DecodeErrorWithReason("codec.length_mismatch", offset(9), "ManualPacketWire.payload", "expected_length=4; actual_length=3; reason=payload length did not match header length"))
end
