# A pure HTTP/2 core consumes frame headers from explicit input events and emits encoded headers.
use hpack_fixture
use stdio

schema Http2FrameHeaderWire
	format binary

	length: UInt24be
	kind: UInt8
	flags: UInt8
	stream_reserved: ReservedBits(1, 0)
	stream_id: UInt31be
end

schema Http2RstStreamPayloadWire
	format binary

	error_code: UInt32be
end

schema Http2WindowUpdatePayloadWire
	format binary

	increment_reserved: ReservedBits(1, 0)
	increment: UInt31be
end

schema Http2GoawayPayloadWire
	format binary

	last_stream_reserved: ReservedBits(1, 0)
	last_stream_id: UInt31be
	error_code: UInt32be
end

schema Http2PriorityDependencyPayloadWire
	format binary

	dependency_reserved: ReservedBits(1, 0)
	dependency_stream_id: UInt31be
end

schema Http2PriorityWeightPayloadWire
	format binary

	weight: UInt8
end

type PendingContinuation
	NoContinuation
	Continuation(Int, Int, Int, Int, ByteChunk)
end

type ContinuationDecision
	Decision(PendingContinuation, ByteChunk, Bool)
end

type ReceiveLimitProvenance
	ProtocolDefault
	LocalConfiguration
	LocalSettingsItem(Int)
end

type ReceiveLimitEntry
	ReceiveLimit(Int, ReceiveLimitProvenance)
end

type PeerAdvertisedMaxFrameSize
	NoPeerMaxFrameSize
	PeerMaxFrameSize(Int, Int)
end

type PeerAdvertisedInitialWindowSize
	NoPeerInitialWindowSize
	PeerInitialWindowSize(Int, Int)
end

type PeerAdvertisedEnablePush
	NoPeerEnablePush
	PeerEnablePush(Int, Int)
end

type PeerAdvertisedMaxConcurrentStreams
	NoPeerMaxConcurrentStreams
	PeerMaxConcurrentStreams(Int, Int)
end

type PeerAdvertisedHeaderTableSize
	NoPeerHeaderTableSize
	PeerHeaderTableSize(Int, Int)
end

type PeerAdvertisedMaxHeaderListSize
	NoPeerMaxHeaderListSize
	PeerMaxHeaderListSize(Int, Int)
end

type PeerSettingsState
	PeerSettings(PeerAdvertisedMaxFrameSize, PeerAdvertisedInitialWindowSize, PeerAdvertisedEnablePush, PeerAdvertisedMaxConcurrentStreams, PeerAdvertisedHeaderTableSize, PeerAdvertisedMaxHeaderListSize)
end

type OutstandingLocalSettings
	NoOutstandingLocalSettings
	OutstandingLocalSettings(Int, Int)
end

type Http2ConnectionState
	ConnectionState(Http2DecodeState, OutstandingLocalSettings)
end

type ConnectionShutdownState
	OpenConnection
	GracefulShutdown(Int, Int)
end

type StreamPriorityState
	NoStreamPriority
	StreamPriority(Int, Bool, Int)
end

type OpenStreamReceiveWindow
	NoOpenStreamReceiveWindow
	OpenStreamReceiveWindow(Int, Int, StreamPriorityState)
	HalfClosedLocalStreamReceiveWindow(Int, Int, StreamPriorityState)
	ClosedByPeerStreamReceiveWindow(Int, Int)
	ResetStreamReceiveWindow(Int, Int)
end

type ReceiveFlowControl
	ReceiveFlowControl(Int, OpenStreamReceiveWindow)
end

type OutboundReceiveCreditStream
	NoOutboundReceiveCreditStream
	OutboundReceiveCreditOpenStream(Int, Int)
	OutboundReceiveCreditClosedStream(Int)
	OutboundReceiveCreditResetStream(Int, Int)
end

type OutboundReceiveCredit
	OutboundReceiveCredit(Int, OutboundReceiveCreditStream)
end

type PrefaceState
	ExpectPreface
	AfterPreface
end

type Http2DecodeState
	State(ByteChunk, Int, PrefaceState, PendingContinuation, HpackFixtureState, ReceiveLimitEntry, PeerSettingsState, ConnectionShutdownState, ReceiveFlowControl)
end

type Http2Input
	InputChunk(ByteChunk)
	InputEnd
end

type Http2Frame
	KnownFrame(Int, Int, Int, ByteView)
	PriorityFrame(Int, Int, Int, Bool, Int)
	UnknownFrame(Int, Int, Int, ByteView)
end

type Http2ProtocolFailure
	ClosedWithPending(Int, Int)
	ClosedWithPartialPreface(Int, Int)
	InvalidPreface(Int, Int, Int, Int)
	ContinuationExpected(Int, Int, Int, Int, Int, Int)
	InvalidFrameKind(Int, Int, Int, Int, String, String)
	InvalidStreamId(Int, Int, Int, String, String, String, String)
	InvalidPayloadLength(Int, Int, Int, Int, Int, String, String, ByteView)
	InvalidDataPadding(Int, Int, Int, Int, String, String, ByteView)
	UnexpectedSettingsAck(Int, String, String)
	InvalidPriorityDependency(Int, Int, Int, String, String, ByteView)
	StreamAfterGoaway(Int, Int, Int, String, String, String)
	FrameSizeExceeded(Int, Int, ReceiveLimitEntry, Int, Int)
	FlowControlWindowExceeded(Int, Int, Int, Int, Int, String, String)
	ConcurrentStreamsExceeded(Int, Int, Int, Int, String, String, String)
	HeaderListSizeExceeded(Int, Int, ReceiveLimitEntry, Int, Int, String)
	SettingsValueOutOfRange(Int, Int, String, Int, Int, Int, String)
	HpackFixtureDecodeFailed(Int, Int, Int, String, String)
end

type Http2DiagnosticContext
	DiagnosticContext(Http2DecodeState)
end

type ProtocolPayloadDecision
	ProtocolPayloadOk
	ProtocolPayloadFailed(Http2ProtocolFailure)
end

type PaddingDecision
	PaddingOk
	PaddingFailed(Http2ProtocolFailure)
end

type ProtocolStreamIdDecision
	ProtocolStreamIdOk
	ProtocolStreamIdFailed(Http2ProtocolFailure)
end

type SettingsRangeDecision
	SettingsValueOk
	SettingsValueFailed(Http2ProtocolFailure)
end

type PriorityDependencyDecision
	PriorityDependencyOk
	PriorityDependencyFailed(Http2ProtocolFailure)
end

type ReceiveFlowControlDecision
	ReceiveFlowControlOk(ReceiveFlowControl)
	ReceiveFlowControlFailed(Http2ProtocolFailure)
end

type HeaderListSizeDecision
	HeaderListSizeOk
	HeaderListSizeFailed(Http2ProtocolFailure)
end

type HeaderListDecodeDecision
	HeaderListDecodeOk(Int, HpackFixtureState)
	HeaderListDecodeFailed(Http2ProtocolFailure)
end

type OutboundDataDecision
	OutboundDataAccepted(Int, Int, Bool, OutboundReceiveCredit, ByteChunk)
	OutboundDataRejected(Int, Int, Bool, Http2ProtocolFailure)
	OutboundDataEncodeFailed(Int, Int, Bool, EncodeError)
end

type OutboundWindowUpdateIncrementDecision
	OutboundWindowUpdateIncrementOk
	OutboundWindowUpdateIncrementFailed(Http2ProtocolFailure)
end

type OutboundWindowUpdateDecision
	OutboundWindowUpdateAccepted(Int, Int, OutboundReceiveCredit, ByteChunk)
	OutboundWindowUpdateRejected(Http2ProtocolFailure)
	OutboundWindowUpdateEncodeFailed(EncodeError)
end

type OutboundRstStreamDecision
	OutboundRstStreamAccepted(Int, Int, OutboundReceiveCredit, ByteChunk)
	OutboundRstStreamRejected(Int, Int, Http2ProtocolFailure)
	OutboundRstStreamEncodeFailed(Int, Int, EncodeError)
end

type OutboundPriorityDecision
	OutboundPriorityAccepted(Int, Int, Bool, Int, OutboundReceiveCredit, ByteChunk)
	OutboundPriorityRejected(Int, Int, Bool, Int, Http2ProtocolFailure)
	OutboundPriorityEncodeFailed(Int, Int, Bool, Int, EncodeError)
end

type OutboundHeadersDecision
	OutboundHeadersAccepted(Int, Int, Bool, OutboundReceiveCredit, ByteChunk)
	OutboundHeadersRejected(Int, Int, Bool, Http2ProtocolFailure)
	OutboundHeadersEncodeFailed(Int, Int, Bool, EncodeError)
end

type OutboundGoawayDecision
	OutboundGoawayAccepted(Int, Int, Http2DecodeState, ByteChunk)
	OutboundGoawayEncodeFailed(Int, Int, EncodeError)
end

type OutboundPingAckDecision
	OutboundPingAckAccepted(ByteChunk)
	OutboundPingAckNoResponse
	OutboundPingAckEncodeFailed(EncodeError)
end

type OutboundSettingsDecision
	OutboundSettingsAccepted(Int, Int, Http2ConnectionState, ByteChunk)
	OutboundSettingsRejected(Http2ProtocolFailure)
	OutboundSettingsEncodeFailed(EncodeError)
end

type Http2Step
	FrameDecoded(Http2DecodeState, Int, Int, Int, Int, Int, ByteChunk, Http2Frame)
	Waiting(Http2DecodeState)
	Failed(Http2DecodeState, Http2ProtocolFailure)
end

type Http2ConnectionStep
	ConnectionFrameDecoded(Http2ConnectionState, Http2Step)
	ConnectionWaiting(Http2ConnectionState)
	ConnectionFailed(Http2ConnectionState, Http2ProtocolFailure)
end

fn empty_state() -> Http2DecodeState
	State(byte_chunk([]), 0, ExpectPreface, NoContinuation, hpack_fixture::initial_state(), protocol_default_frame_size_limit(), empty_peer_settings(), OpenConnection, default_receive_flow_control())
end

fn frame_state() -> Http2DecodeState
	State(byte_chunk([]), 0, AfterPreface, NoContinuation, hpack_fixture::initial_state(), protocol_default_frame_size_limit(), empty_peer_settings(), OpenConnection, default_receive_flow_control())
end

fn local_config_state(max_frame_size: Int) -> Http2DecodeState
	State(byte_chunk([]), 0, AfterPreface, NoContinuation, hpack_fixture::initial_state(), ReceiveLimit(max_frame_size, LocalConfiguration), empty_peer_settings(), OpenConnection, default_receive_flow_control())
end

fn local_settings_state(max_frame_size: Int, item_offset: Int) -> Http2DecodeState
	State(byte_chunk([]), 0, AfterPreface, NoContinuation, hpack_fixture::initial_state(), ReceiveLimit(max_frame_size, LocalSettingsItem(item_offset)), empty_peer_settings(), OpenConnection, default_receive_flow_control())
end

fn receive_window_state(connection_window: Int, stream_id: Int, stream_window: Int) -> Http2DecodeState
	State(byte_chunk([]), 0, AfterPreface, NoContinuation, hpack_fixture::initial_state(), protocol_default_frame_size_limit(), empty_peer_settings(), OpenConnection, ReceiveFlowControl(connection_window, OpenStreamReceiveWindow(stream_id, stream_window, NoStreamPriority)))
end

fn encode_frame_header(header: {length: Int, kind: Int, flags: Int, stream_id: Int}) -> Result<ByteChunk, EncodeError>
	byte_encode_http2_frame_header_wire(header)
end

fn encode_rst_stream_payload(payload: {error_code: Int}) -> Result<ByteChunk, EncodeError>
	byte_encode_http2_rst_stream_payload_wire(payload)
end

fn encode_window_update_payload(payload: {increment: Int}) -> Result<ByteChunk, EncodeError>
	byte_encode_http2_window_update_payload_wire(payload)
end

fn encode_goaway_payload(payload: {last_stream_id: Int, error_code: Int}) -> Result<ByteChunk, EncodeError>
	byte_encode_http2_goaway_payload_wire(payload)
end

fn encode_priority_dependency_payload(payload: {dependency_stream_id: Int}) -> Result<ByteChunk, EncodeError>
	byte_encode_http2_priority_dependency_payload_wire(payload)
end

fn encode_priority_weight_payload(payload: {weight: Int}) -> Result<ByteChunk, EncodeError>
	byte_encode_http2_priority_weight_payload_wire(payload)
end

fn receive(input: Http2Input, state: Http2DecodeState) -> Result<Http2Step, String>
	match input
		InputChunk(bytes) => receive_chunk(bytes, state)
		InputEnd => receive_end(state)
	end
end

fn receive_chunk(bytes: ByteChunk, state: Http2DecodeState) -> Result<Http2Step, String>
	match state
		State(pending, next_offset, preface_state, continuation, hpack_state, receive_limit, peer_settings, shutdown_state, receive_flow_control) => receive_available(byte_append(pending, bytes), next_offset, preface_state, continuation, hpack_state, receive_limit, peer_settings, shutdown_state, receive_flow_control)
	end
end

fn receive_end(state: Http2DecodeState) -> Result<Http2Step, String>
	match state
		State(pending, next_offset, preface_state, continuation, hpack_state, receive_limit, peer_settings, shutdown_state, receive_flow_control) => end_pending(pending, next_offset, preface_state, continuation, hpack_state, receive_limit, peer_settings, shutdown_state, receive_flow_control)
	end
end

fn end_pending(pending: ByteChunk, next_offset: Int, preface_state: PrefaceState, continuation: PendingContinuation, hpack_state: HpackFixtureState, receive_limit: ReceiveLimitEntry, peer_settings: PeerSettingsState, shutdown_state: ConnectionShutdownState, receive_flow_control: ReceiveFlowControl) -> Result<Http2Step, String>
	let available: Int = byte_count_to_int(byte_chunk_count(pending))
	match available == 0
		true => match continuation
			NoContinuation => Ok(Waiting(State(pending, next_offset, preface_state, continuation, hpack_state, receive_limit, peer_settings, shutdown_state, receive_flow_control)))
			Continuation(_, _, _, _, _) => Ok(Failed(State(pending, next_offset, preface_state, continuation, hpack_state, receive_limit, peer_settings, shutdown_state, receive_flow_control), ClosedWithPending(next_offset, available)))
		end
		false => match preface_state
			ExpectPreface => Ok(Failed(State(pending, next_offset, preface_state, continuation, hpack_state, receive_limit, peer_settings, shutdown_state, receive_flow_control), ClosedWithPartialPreface(next_offset, available)))
			AfterPreface => Ok(Failed(State(pending, next_offset, preface_state, continuation, hpack_state, receive_limit, peer_settings, shutdown_state, receive_flow_control), ClosedWithPending(next_offset, available)))
		end
	end
end

fn receive_available(pending: ByteChunk, next_offset: Int, preface_state: PrefaceState, continuation: PendingContinuation, hpack_state: HpackFixtureState, receive_limit: ReceiveLimitEntry, peer_settings: PeerSettingsState, shutdown_state: ConnectionShutdownState, receive_flow_control: ReceiveFlowControl) -> Result<Http2Step, String>
	match preface_state
		ExpectPreface => validate_preface(pending, next_offset, continuation, hpack_state, receive_limit, peer_settings, shutdown_state, receive_flow_control)
		AfterPreface => decode_available(pending, next_offset, continuation, hpack_state, receive_limit, peer_settings, shutdown_state, receive_flow_control)
	end
end

fn client_connection_preface_count() -> Int
	24
end

fn validate_preface(pending: ByteChunk, next_offset: Int, continuation: PendingContinuation, hpack_state: HpackFixtureState, receive_limit: ReceiveLimitEntry, peer_settings: PeerSettingsState, shutdown_state: ConnectionShutdownState, receive_flow_control: ReceiveFlowControl) -> Result<Http2Step, String>
	let available: Int = byte_count_to_int(byte_chunk_count(pending))
	let matched: Int = matched_preface_count(pending, available, 0)?
	match matched < available
		true => match matched < client_connection_preface_count()
			true => Ok(Failed(State(pending, next_offset, ExpectPreface, continuation, hpack_state, receive_limit, peer_settings, shutdown_state, receive_flow_control), InvalidPreface(next_offset + matched, expected_preface_byte(matched), read_byte(pending, matched)?, matched)))
			false => consume_preface(pending, next_offset, continuation, hpack_state, receive_limit, peer_settings, shutdown_state, receive_flow_control)
		end
		false => match available < client_connection_preface_count()
			true => Ok(Waiting(State(pending, next_offset, ExpectPreface, continuation, hpack_state, receive_limit, peer_settings, shutdown_state, receive_flow_control)))
			false => consume_preface(pending, next_offset, continuation, hpack_state, receive_limit, peer_settings, shutdown_state, receive_flow_control)
		end
	end
end

fn consume_preface(pending: ByteChunk, next_offset: Int, continuation: PendingContinuation, hpack_state: HpackFixtureState, receive_limit: ReceiveLimitEntry, peer_settings: PeerSettingsState, shutdown_state: ConnectionShutdownState, receive_flow_control: ReceiveFlowControl) -> Result<Http2Step, String>
	let preface_count: ByteCount = byte_count(client_connection_preface_count())?
	let suffix: ByteChunk = byte_drop(pending, preface_count)?
	decode_available(suffix, next_offset + client_connection_preface_count(), continuation, hpack_state, receive_limit, peer_settings, shutdown_state, receive_flow_control)
end

fn matched_preface_count(pending: ByteChunk, available: Int, index: Int) -> Result<Int, String>
	match index < available
		false => Ok(index)
		true => match index < client_connection_preface_count()
			false => Ok(index)
			true => match read_byte(pending, index)? == expected_preface_byte(index)
				true => matched_preface_count(pending, available, index + 1)
				false => Ok(index)
			end
		end
	end
end

fn read_byte(pending: ByteChunk, index: Int) -> Result<Int, String>
	byte_read_u8_be(byte_view(pending, byte_offset(index)?, byte_count(1)?)?)
end

fn expected_preface_byte(index: Int) -> Int
	match index == 0
		true => 80
		false => match index == 1
			true => 82
			false => match index == 2
				true => 73
				false => match index == 3
					true => 32
					false => match index == 4
						true => 42
						false => match index == 5
							true => 32
							false => match index == 6
								true => 72
								false => match index == 7
									true => 84
									false => match index == 8
										true => 84
										false => match index == 9
											true => 80
											false => match index == 10
												true => 47
												false => match index == 11
													true => 50
													false => match index == 12
														true => 46
														false => match index == 13
															true => 48
															false => match index == 14
																true => 13
																false => match index == 15
																	true => 10
																	false => match index == 16
																		true => 13
																		false => match index == 17
																			true => 10
																			false => match index == 18
																				true => 83
																				false => match index == 19
																					true => 77
																					false => match index == 20
																						true => 13
																						false => match index == 21
																							true => 10
																							false => match index == 22
																								true => 13
																								false => match index == 23
																									true => 10
																									false => 0
																								end
																							end
																						end
																					end
																				end
																			end
																		end
																	end
																end
															end
														end
													end
												end
											end
										end
									end
								end
							end
						end
					end
				end
			end
		end
	end
end

fn decode_available(pending: ByteChunk, next_offset: Int, continuation: PendingContinuation, hpack_state: HpackFixtureState, receive_limit: ReceiveLimitEntry, peer_settings: PeerSettingsState, shutdown_state: ConnectionShutdownState, receive_flow_control: ReceiveFlowControl) -> Result<Http2Step, String>
	let available: Int = byte_count_to_int(byte_chunk_count(pending))
	match available < 9
		true => Ok(Waiting(State(pending, next_offset, AfterPreface, continuation, hpack_state, receive_limit, peer_settings, shutdown_state, receive_flow_control)))
		false => decode_header(pending, next_offset, continuation, hpack_state, receive_limit, peer_settings, shutdown_state, receive_flow_control)
	end
end

fn decode_header(pending: ByteChunk, next_offset: Int, continuation: PendingContinuation, hpack_state: HpackFixtureState, receive_limit: ReceiveLimitEntry, peer_settings: PeerSettingsState, shutdown_state: ConnectionShutdownState, receive_flow_control: ReceiveFlowControl) -> Result<Http2Step, String>
	let available: Int = byte_count_to_int(byte_chunk_count(pending))
	let zero: ByteOffset = byte_offset(0)?
	let header_count: ByteCount = byte_count(9)?
	let view: ByteView = byte_view(pending, zero, header_count)?
	let header: {length: Int, kind: Int, flags: Int, stream_id: Int} = byte_decode_http2_frame_header_wire(view)?
	let max_frame_size: Int = receive_limit_value(receive_limit)
	match header.length > max_frame_size
		true => Ok(Failed(State(pending, next_offset, AfterPreface, continuation, hpack_state, receive_limit, peer_settings, shutdown_state, receive_flow_control), FrameSizeExceeded(next_offset, header.length, receive_limit, header.kind, header.stream_id)))
		false => decode_sized_frame(pending, next_offset, continuation, hpack_state, receive_limit, peer_settings, shutdown_state, receive_flow_control, available, header.length, header.kind, header.flags, header.stream_id)
	end
end

fn protocol_default_frame_size_limit() -> ReceiveLimitEntry
	ReceiveLimit(16384, ProtocolDefault)
end

fn empty_peer_settings() -> PeerSettingsState
	PeerSettings(NoPeerMaxFrameSize, NoPeerInitialWindowSize, NoPeerEnablePush, NoPeerMaxConcurrentStreams, NoPeerHeaderTableSize, NoPeerMaxHeaderListSize)
end

fn default_receive_flow_control() -> ReceiveFlowControl
	ReceiveFlowControl(65535, NoOpenStreamReceiveWindow)
end

fn concurrent_stream_receive_limit() -> Int
	1
end

fn concurrent_stream_receive_limit_provenance() -> String
	"local_configuration"
end

fn receive_limit_value(receive_limit: ReceiveLimitEntry) -> Int
	match receive_limit
		ReceiveLimit(value, _) => value
	end
end

fn receive_limit_provenance_label(receive_limit: ReceiveLimitEntry) -> String
	match receive_limit
		ReceiveLimit(_, ProtocolDefault) => "protocol_default"
		ReceiveLimit(_, LocalConfiguration) => "local_configuration"
		ReceiveLimit(_, LocalSettingsItem(_)) => "local_settings_item"
	end
end

fn header_list_receive_limit() -> ReceiveLimitEntry
	ReceiveLimit(13, LocalConfiguration)
end

fn decode_sized_frame(pending: ByteChunk, next_offset: Int, continuation: PendingContinuation, hpack_state: HpackFixtureState, receive_limit: ReceiveLimitEntry, peer_settings: PeerSettingsState, shutdown_state: ConnectionShutdownState, receive_flow_control: ReceiveFlowControl, available: Int, length: Int, kind: Int, flags: Int, stream_id: Int) -> Result<Http2Step, String>
	let frame_count_int: Int = 9 + length
	match available < frame_count_int
		true => Ok(Waiting(State(pending, next_offset, AfterPreface, continuation, hpack_state, receive_limit, peer_settings, shutdown_state, receive_flow_control)))
		false => decode_complete_frame(pending, next_offset, continuation, hpack_state, receive_limit, peer_settings, shutdown_state, receive_flow_control, length, kind, flags, stream_id, frame_count_int)
	end
end

fn decode_complete_frame(pending: ByteChunk, next_offset: Int, continuation: PendingContinuation, hpack_state: HpackFixtureState, receive_limit: ReceiveLimitEntry, peer_settings: PeerSettingsState, shutdown_state: ConnectionShutdownState, receive_flow_control: ReceiveFlowControl, length: Int, kind: Int, flags: Int, stream_id: Int, frame_count_int: Int) -> Result<Http2Step, String>
	let frame_count: ByteCount = byte_count(frame_count_int)?
	let suffix: ByteChunk = byte_drop(pending, frame_count)?
	let payload: ByteChunk = frame_payload_chunk(pending, length)?
	let consumed_state: Http2DecodeState = State(suffix, next_offset + frame_count_int, AfterPreface, continuation, hpack_state, receive_limit, peer_settings, shutdown_state, receive_flow_control)
	let stream_id_decision: ProtocolStreamIdDecision = validate_stream_id_domain(next_offset, kind, stream_id)
	match stream_id_decision
		ProtocolStreamIdOk => decode_complete_frame_after_stream_id(pending, suffix, payload, next_offset, frame_count_int, continuation, hpack_state, receive_limit, peer_settings, shutdown_state, receive_flow_control, length, kind, flags, stream_id, consumed_state)
		ProtocolStreamIdFailed(error) => Ok(Failed(consumed_state, error))
	end
end

fn decode_complete_frame_after_stream_id(pending: ByteChunk, suffix: ByteChunk, payload: ByteChunk, next_offset: Int, frame_count_int: Int, continuation: PendingContinuation, hpack_state: HpackFixtureState, receive_limit: ReceiveLimitEntry, peer_settings: PeerSettingsState, shutdown_state: ConnectionShutdownState, receive_flow_control: ReceiveFlowControl, length: Int, kind: Int, flags: Int, stream_id: Int, consumed_state: Http2DecodeState) -> Result<Http2Step, String>
	let settings_decision: SettingsRangeDecision = validate_settings_value(pending, next_offset, length, kind, flags)?
	let priority_decision: PriorityDependencyDecision = validate_priority_dependency(next_offset, payload, length, kind, stream_id)?
	let payload_decision: ProtocolPayloadDecision = validate_protocol_payload(next_offset, payload, length, kind, flags, stream_id)?
	match settings_decision
		SettingsValueOk => match payload_decision
			ProtocolPayloadOk => match priority_decision
				PriorityDependencyOk => match validate_continuation(continuation, next_offset, payload, kind, flags, stream_id, receive_flow_control)
					Ok(Decision(next_continuation, completed_header_block, completed_end_stream)) => complete_after_data_padding(pending, suffix, next_offset, frame_count_int, next_continuation, hpack_state, receive_limit, peer_settings, shutdown_state, receive_flow_control, length, kind, flags, stream_id, completed_header_block, completed_end_stream, consumed_state, payload)
					Err(error) => Ok(Failed(consumed_state, error))
				end
				PriorityDependencyFailed(error) => Ok(Failed(consumed_state, error))
			end
			ProtocolPayloadFailed(error) => Ok(Failed(consumed_state, error))
		end
		SettingsValueFailed(error) => Ok(Failed(consumed_state, error))
	end
end

fn complete_after_data_padding(pending: ByteChunk, suffix: ByteChunk, next_offset: Int, frame_count_int: Int, next_continuation: PendingContinuation, hpack_state: HpackFixtureState, receive_limit: ReceiveLimitEntry, peer_settings: PeerSettingsState, shutdown_state: ConnectionShutdownState, receive_flow_control: ReceiveFlowControl, length: Int, kind: Int, flags: Int, stream_id: Int, completed_header_block: ByteChunk, completed_end_stream: Bool, consumed_state: Http2DecodeState, payload: ByteChunk) -> Result<Http2Step, String>
	let padding_decision: PaddingDecision = validate_data_padding(next_offset, payload, length, kind, flags, stream_id, receive_flow_control)?
	match padding_decision
		PaddingOk => complete_receive_flow_control_update(pending, suffix, next_offset, frame_count_int, next_continuation, hpack_state, receive_limit, peer_settings, shutdown_state, receive_flow_control, length, kind, flags, stream_id, completed_header_block, completed_end_stream, consumed_state)
		PaddingFailed(error) => Ok(Failed(consumed_state, error))
	end
end

fn validate_priority_dependency(offset: Int, payload: ByteChunk, length: Int, kind: Int, stream_id: Int) -> Result<PriorityDependencyDecision, String>
	match kind == 2
		true => match length == 5
			true => validate_priority_dependency_payload(offset, payload, stream_id)
			false => Ok(PriorityDependencyOk)
		end
		false => Ok(PriorityDependencyOk)
	end
end

fn validate_priority_dependency_payload(offset: Int, payload: ByteChunk, stream_id: Int) -> Result<PriorityDependencyDecision, String>
	let payload_view: ByteView = byte_view(payload, byte_offset(0)?, byte_count(5)?)?
	let dependency_stream_id: Int = priority_dependency_stream_id(payload_view)?
	match dependency_stream_id == stream_id
		true => Ok(PriorityDependencyFailed(InvalidPriorityDependency(offset, stream_id, dependency_stream_id, "stream-control", "rfc9113_priority_dependency", payload_view)))
		false => Ok(PriorityDependencyOk)
	end
end

fn frame_payload_chunk(frame: ByteChunk, length: Int) -> Result<ByteChunk, String>
	let payload_offset: ByteOffset = byte_offset(9)?
	let payload_count: ByteCount = byte_count(length)?
	Ok(byte_view_to_chunk(byte_view(frame, payload_offset, payload_count)?))
end

fn validate_stream_id_domain(offset: Int, kind: Int, stream_id: Int) -> ProtocolStreamIdDecision
	match kind == 4
		true => require_connection_stream_id(offset, kind, stream_id)
		false => match kind == 6
			true => require_connection_stream_id(offset, kind, stream_id)
			false => match kind == 7
				true => require_connection_stream_id(offset, kind, stream_id)
				false => match kind == 0
					true => require_client_stream_id(offset, kind, stream_id)
					false => match kind == 1
						true => require_client_stream_id(offset, kind, stream_id)
						false => match kind == 3
							true => require_client_stream_id(offset, kind, stream_id)
							false => match kind == 9
								true => require_client_stream_id(offset, kind, stream_id)
								false => match kind == 8
									true => validate_window_update_stream_id(offset, kind, stream_id)
									false => match kind == 2
										true => require_client_stream_id(offset, kind, stream_id)
										false => match kind == 5
											true => require_client_stream_id(offset, kind, stream_id)
											false => ProtocolStreamIdOk
										end
									end
								end
							end
						end
					end
				end
			end
		end
	end
end

fn validate_window_update_stream_id(offset: Int, kind: Int, stream_id: Int) -> ProtocolStreamIdDecision
	match stream_id == 0
		true => ProtocolStreamIdOk
		false => require_client_stream_id(offset, kind, stream_id)
	end
end

fn require_connection_stream_id(offset: Int, kind: Int, stream_id: Int) -> ProtocolStreamIdDecision
	match stream_id == 0
		true => ProtocolStreamIdOk
		false => ProtocolStreamIdFailed(InvalidStreamId(offset, kind, stream_id, "connection stream id zero", "server", "stream-id-domain", "connection_frames_require_stream_zero"))
	end
end

fn require_client_stream_id(offset: Int, kind: Int, stream_id: Int) -> ProtocolStreamIdDecision
	match stream_id == 0
		true => ProtocolStreamIdFailed(InvalidStreamId(offset, kind, stream_id, "nonzero client-initiated stream id", "server", "stream-id-domain", "server_receives_client_initiated_streams"))
		false => match stream_id_is_client_initiated(stream_id)
			true => ProtocolStreamIdOk
			false => ProtocolStreamIdFailed(InvalidStreamId(offset, kind, stream_id, "nonzero client-initiated stream id", "server", "stream-id-domain", "server_receives_client_initiated_streams"))
		end
	end
end

fn stream_id_is_client_initiated(stream_id: Int) -> Bool
	(stream_id / 2) * 2 != stream_id
end

fn complete_receive_flow_control_update(pending: ByteChunk, suffix: ByteChunk, next_offset: Int, frame_count_int: Int, next_continuation: PendingContinuation, hpack_state: HpackFixtureState, receive_limit: ReceiveLimitEntry, peer_settings: PeerSettingsState, shutdown_state: ConnectionShutdownState, receive_flow_control: ReceiveFlowControl, length: Int, kind: Int, flags: Int, stream_id: Int, completed_header_block: ByteChunk, completed_end_stream: Bool, consumed_state: Http2DecodeState) -> Result<Http2Step, String>
	match decode_completed_header_list(next_offset, kind, flags, completed_header_block, hpack_state)
		HeaderListDecodeOk(decoded_header_list_size, next_hpack_state) => match validate_header_list_size(next_offset, kind, flags, stream_id, decoded_header_list_size)
			HeaderListSizeOk => complete_after_header_list_size(pending, next_continuation, next_hpack_state, length, kind, flags, stream_id, completed_header_block, completed_end_stream, consumed_state)
			HeaderListSizeFailed(error) => Ok(Failed(consumed_state, error))
		end
		HeaderListDecodeFailed(error) => Ok(Failed(consumed_state, error))
	end
end

fn complete_after_header_list_size(pending: ByteChunk, next_continuation: PendingContinuation, next_hpack_state: HpackFixtureState, length: Int, kind: Int, flags: Int, stream_id: Int, completed_header_block: ByteChunk, completed_end_stream: Bool, consumed_state: Http2DecodeState) -> Result<Http2Step, String>
	let frame_offset: Int = state_next_offset(consumed_state) - (9 + length)
	let flow_control_decision: ReceiveFlowControlDecision = update_receive_flow_control(pending, frame_offset, length, kind, flags, stream_id, completed_end_stream, state_shutdown_state_value(consumed_state), state_receive_flow_control(consumed_state))?
	match flow_control_decision
		ReceiveFlowControlOk(next_receive_flow_control) => Ok(FrameDecoded(State(state_pending_chunk(consumed_state), state_next_offset(consumed_state), AfterPreface, next_continuation, next_hpack_state, state_receive_limit(consumed_state), update_peer_settings(pending, frame_offset, length, kind, flags, state_peer_settings(consumed_state))?, update_shutdown_state(pending, length, kind, state_shutdown_state_value(consumed_state))?, update_initial_window_receive_credit(pending, frame_offset, length, kind, flags, state_peer_settings(consumed_state), next_receive_flow_control)?), frame_offset, length, kind, flags, stream_id, completed_header_block, frame_value(pending, length, kind, flags, stream_id)?))
		ReceiveFlowControlFailed(error) => Ok(Failed(consumed_state, error))
	end
end

fn decode_completed_header_list(offset: Int, kind: Int, flags: Int, completed_header_block: ByteChunk, hpack_state: HpackFixtureState) -> HeaderListDecodeDecision
	match header_list_boundary_reached(kind, flags)
		true => match hpack_fixture::decode_header_block(completed_header_block, hpack_state, offset)
			Ok(transition) => HeaderListDecodeOk(hpack_fixture::header_list_wire_size(hpack_fixture::transition_headers(transition)), hpack_fixture::transition_state(transition))
			Err(failure) => HeaderListDecodeFailed(HpackFixtureDecodeFailed(hpack_fixture::hpack_failure_offset(failure), hpack_fixture::hpack_failure_observed_size(failure), hpack_fixture::hpack_failure_observed_first_byte(failure), hpack_fixture::hpack_failure_expected_fixture(failure), hpack_fixture::hpack_failure_codec_module(failure)))
		end
		false => HeaderListDecodeOk(byte_count_to_int(byte_chunk_count(completed_header_block)), hpack_state)
	end
end

fn validate_header_list_size(offset: Int, kind: Int, flags: Int, stream_id: Int, decoded_header_list_size: Int) -> HeaderListSizeDecision
	match header_list_boundary_reached(kind, flags)
		true => validate_completed_header_list_size(offset, kind, stream_id, decoded_header_list_size, header_list_receive_limit())
		false => HeaderListSizeOk
	end
end

fn header_list_boundary_reached(kind: Int, flags: Int) -> Bool
	match kind == 1
		true => end_headers_set(flags)
		false => match kind == 9
			true => end_headers_set(flags)
			false => false
		end
	end
end

fn validate_completed_header_list_size(offset: Int, kind: Int, stream_id: Int, observed_size: Int, receive_limit: ReceiveLimitEntry) -> HeaderListSizeDecision
	let allowed_size: Int = receive_limit_value(receive_limit)
	match observed_size > allowed_size
		true => HeaderListSizeFailed(HeaderListSizeExceeded(offset, observed_size, receive_limit, kind, stream_id, "header_list_receive_limit"))
		false => HeaderListSizeOk
	end
end

fn frame_value(pending: ByteChunk, length: Int, kind: Int, flags: Int, stream_id: Int) -> Result<Http2Frame, String>
	let payload_chunk: ByteChunk = frame_payload_chunk(pending, length)?
	let payload: ByteView = data_content_view(payload_chunk, length, kind, flags)?
	match kind == 2
		true => Ok(PriorityFrame(flags, stream_id, priority_dependency_stream_id(payload)?, priority_exclusive(payload)?, priority_weight(payload)?))
		false => match is_known_frame_kind(kind)
			true => Ok(KnownFrame(kind, flags, stream_id, payload))
			false => Ok(UnknownFrame(kind, flags, stream_id, payload))
		end
	end
end

fn priority_dependency_stream_id(payload: ByteView) -> Result<Int, String>
	let payload_chunk: ByteChunk = byte_view_to_chunk(payload)
	let first_byte: Int = byte_read_u8_be(byte_view(payload_chunk, byte_offset(0)?, byte_count(1)?)?)?
	let second_byte: Int = byte_read_u8_be(byte_view(payload_chunk, byte_offset(1)?, byte_count(1)?)?)?
	let third_byte: Int = byte_read_u8_be(byte_view(payload_chunk, byte_offset(2)?, byte_count(1)?)?)?
	let fourth_byte: Int = byte_read_u8_be(byte_view(payload_chunk, byte_offset(3)?, byte_count(1)?)?)?
	Ok((first_byte - (first_byte / 128) * 128) * 16777216 + second_byte * 65536 + third_byte * 256 + fourth_byte)
end

fn priority_exclusive(payload: ByteView) -> Result<Bool, String>
	let first_byte: Int = byte_read_u8_be(byte_view(byte_view_to_chunk(payload), byte_offset(0)?, byte_count(1)?)?)?
	Ok(first_byte >= 128)
end

fn priority_weight(payload: ByteView) -> Result<Int, String>
	let encoded_weight: Int = byte_read_u8_be(byte_view(byte_view_to_chunk(payload), byte_offset(4)?, byte_count(1)?)?)?
	Ok(encoded_weight + 1)
end

fn is_known_frame_kind(kind: Int) -> Bool
	match kind == 0
		true => true
		false => match kind == 1
			true => true
			false => match kind == 3
				true => true
				false => match kind == 4
					true => true
					false => match kind == 6
						true => true
						false => match kind == 7
							true => true
							false => match kind == 8
								true => true
								false => match kind == 9
									true => true
									false => match kind == 2
										true => true
										false => match kind == 5
											true => true
											false => false
										end
									end
								end
							end
						end
					end
				end
			end
		end
	end
end

fn is_unknown_frame_kind(kind: Int) -> Bool
	match is_known_frame_kind(kind)
		true => false
		false => true
	end
end

fn validate_protocol_payload(offset: Int, payload: ByteChunk, length: Int, kind: Int, flags: Int, stream_id: Int) -> Result<ProtocolPayloadDecision, String>
	match kind == 6
		true => validate_fixed_payload_length(offset, payload, length, kind, stream_id, 8, "connection-control", "rfc9113_ping_payload_length")
		false => match kind == 7
			true => validate_fixed_payload_length(offset, payload, length, kind, stream_id, 8, "connection-control", "rfc9113_goaway_payload_length")
			false => match kind == 8
				true => validate_fixed_payload_length(offset, payload, length, kind, stream_id, 4, "flow-control", "rfc9113_window_update_payload_length")
				false => match kind == 4
					true => validate_settings_ack_payload_length(offset, payload, length, flags, stream_id)
					false => match kind == 3
						true => validate_fixed_payload_length(offset, payload, length, kind, stream_id, 4, "stream-control", "rfc9113_rst_stream_payload_length")
						false => match kind == 2
							true => validate_fixed_payload_length(offset, payload, length, kind, stream_id, 5, "stream-control", "rfc9113_priority_payload_length")
							false => Ok(ProtocolPayloadOk)
						end
					end
				end
			end
		end
	end
end

fn validate_data_padding(offset: Int, payload: ByteChunk, length: Int, kind: Int, flags: Int, stream_id: Int, receive_flow_control: ReceiveFlowControl) -> Result<PaddingDecision, String>
	match kind == 0
		false => Ok(PaddingOk)
		true => match data_padded_set(flags)
			false => Ok(PaddingOk)
			true => validate_padded_data_payload(offset, payload, length, stream_id, receive_flow_control)
		end
	end
end

fn validate_padded_data_payload(offset: Int, payload: ByteChunk, length: Int, stream_id: Int, receive_flow_control: ReceiveFlowControl) -> Result<PaddingDecision, String>
	let active_state: String = data_padding_active_state(stream_id, receive_flow_control)
	match length == 0
		true => Ok(PaddingFailed(InvalidDataPadding(offset, stream_id, 0, -1, active_state, "rfc9113_data_padding", byte_view(payload, byte_offset(0)?, byte_count(length)?)?)))
		false => match data_pad_length(payload)? > length - 1
			true => Ok(PaddingFailed(InvalidDataPadding(offset + 9, stream_id, data_pad_length(payload)?, length - 1, active_state, "rfc9113_data_padding", byte_view(payload, byte_offset(0)?, byte_count(length)?)?)))
			false => Ok(PaddingOk)
		end
	end
end

fn data_padding_active_state(stream_id: Int, receive_flow_control: ReceiveFlowControl) -> String
	match receive_flow_control
		ReceiveFlowControl(_, HalfClosedLocalStreamReceiveWindow(open_stream_id, _, _)) => match stream_id == open_stream_id
			true => "half-closed-local-stream"
			false => "open-stream"
		end
		ReceiveFlowControl(_, _) => "open-stream"
	end
end

fn data_content_view(payload: ByteChunk, length: Int, kind: Int, flags: Int) -> Result<ByteView, String>
	match kind == 0
		false => byte_view(payload, byte_offset(0)?, byte_count(length)?)
		true => match data_padded_set(flags)
			false => byte_view(payload, byte_offset(0)?, byte_count(length)?)
			true => padded_data_content_view(payload, length)
		end
	end
end

fn padded_data_content_view(payload: ByteChunk, length: Int) -> Result<ByteView, String>
	let pad_length: Int = data_pad_length(payload)?
	byte_view(payload, byte_offset(1)?, byte_count(length - 1 - pad_length)?)
end

fn data_pad_length(payload: ByteChunk) -> Result<Int, String>
	byte_read_u8_be(byte_view(payload, byte_offset(0)?, byte_count(1)?)?)
end

fn settings_ack_set(flags: Int) -> Bool
	(flags / 2) * 2 != flags
end

fn ping_ack_set(flags: Int) -> Bool
	(flags / 2) * 2 != flags
end

fn validate_settings_ack_payload_length(offset: Int, payload: ByteChunk, length: Int, flags: Int, stream_id: Int) -> Result<ProtocolPayloadDecision, String>
	match settings_ack_set(flags)
		true => validate_fixed_payload_length(offset, payload, length, 4, stream_id, 0, "connection-control", "rfc9113_settings_ack_payload_length")
		false => Ok(ProtocolPayloadOk)
	end
end

fn validate_fixed_payload_length(offset: Int, payload: ByteChunk, length: Int, kind: Int, stream_id: Int, expected_length: Int, active_state: String, rule_provenance: String) -> Result<ProtocolPayloadDecision, String>
	match length == expected_length
		true => Ok(ProtocolPayloadOk)
		false => Ok(ProtocolPayloadFailed(InvalidPayloadLength(offset, kind, stream_id, length, expected_length, active_state, rule_provenance, byte_view(payload, byte_offset(0)?, byte_count(length)?)?)))
	end
end

fn validate_settings_value(pending: ByteChunk, next_offset: Int, length: Int, kind: Int, flags: Int) -> Result<SettingsRangeDecision, String>
	match kind == 4
		true => match settings_ack_set(flags)
			true => Ok(SettingsValueOk)
			false => match settings_payload_has_complete_items(length)
				true => validate_settings_items(pending, next_offset, 9, 9 + length)
				false => Ok(SettingsValueOk)
			end
		end
		false => Ok(SettingsValueOk)
	end
end

fn settings_payload_has_complete_items(length: Int) -> Bool
	match length > 0
		true => (length / 6) * 6 == length
		false => false
	end
end

fn validate_settings_items(pending: ByteChunk, next_offset: Int, item_wire_offset: Int, payload_end_offset: Int) -> Result<SettingsRangeDecision, String>
	match item_wire_offset == payload_end_offset
		true => Ok(SettingsValueOk)
		false => match validate_single_settings_value(pending, next_offset, item_wire_offset)?
			SettingsValueOk => validate_settings_items(pending, next_offset, item_wire_offset + 6, payload_end_offset)
			SettingsValueFailed(error) => Ok(SettingsValueFailed(error))
		end
	end
end

fn validate_single_settings_value(pending: ByteChunk, next_offset: Int, item_wire_offset: Int) -> Result<SettingsRangeDecision, String>
	let item_offset: ByteOffset = byte_offset(item_wire_offset)?
	let item_count: ByteCount = byte_count(6)?
	let item: ByteView = byte_view(pending, item_offset, item_count)?
	let identifier_count: ByteCount = byte_count(2)?
	let value_offset: ByteOffset = byte_offset(2)?
	let value_count: ByteCount = byte_count(4)?
	let identifier: Int = byte_read_u16_be(byte_view(byte_view_to_chunk(item), byte_offset(0)?, identifier_count)?)?
	let value: Int = byte_read_u32_be(byte_view(byte_view_to_chunk(item), value_offset, value_count)?)?
	match identifier == 5
		true => validate_max_frame_size_setting(next_offset + item_wire_offset, value)
		false => match identifier == 4
			true => validate_initial_window_size_setting(next_offset + item_wire_offset, value)
			false => match identifier == 2
				true => validate_enable_push_setting(next_offset + item_wire_offset, value)
				false => Ok(SettingsValueOk)
			end
		end
	end
end

fn validate_max_frame_size_setting(item_offset: Int, value: Int) -> Result<SettingsRangeDecision, String>
	match value < 16384
		true => Ok(SettingsValueFailed(SettingsValueOutOfRange(item_offset, 5, "SETTINGS_MAX_FRAME_SIZE", value, 16384, 16777215, "peer_settings")))
		false => match value > 16777215
			true => Ok(SettingsValueFailed(SettingsValueOutOfRange(item_offset, 5, "SETTINGS_MAX_FRAME_SIZE", value, 16384, 16777215, "peer_settings")))
			false => Ok(SettingsValueOk)
		end
	end
end

fn validate_initial_window_size_setting(item_offset: Int, value: Int) -> Result<SettingsRangeDecision, String>
	match value > 2147483647
		true => Ok(SettingsValueFailed(SettingsValueOutOfRange(item_offset, 4, "SETTINGS_INITIAL_WINDOW_SIZE", value, 0, 2147483647, "peer_settings")))
		false => Ok(SettingsValueOk)
	end
end

fn validate_enable_push_setting(item_offset: Int, value: Int) -> Result<SettingsRangeDecision, String>
	match value > 1
		true => Ok(SettingsValueFailed(SettingsValueOutOfRange(item_offset, 2, "SETTINGS_ENABLE_PUSH", value, 0, 1, "peer_settings")))
		false => Ok(SettingsValueOk)
	end
end

fn update_peer_settings(pending: ByteChunk, next_offset: Int, length: Int, kind: Int, flags: Int, peer_settings: PeerSettingsState) -> Result<PeerSettingsState, String>
	match kind == 4
		true => match settings_ack_set(flags)
			true => Ok(peer_settings)
			false => update_settings_frame(pending, next_offset, length, peer_settings)
		end
		false => Ok(peer_settings)
	end
end

fn update_settings_frame(pending: ByteChunk, next_offset: Int, length: Int, peer_settings: PeerSettingsState) -> Result<PeerSettingsState, String>
	match settings_payload_has_complete_items(length)
		true => update_settings_items(pending, next_offset, 9, 9 + length, peer_settings)
		false => Ok(peer_settings)
	end
end

fn update_settings_items(pending: ByteChunk, next_offset: Int, item_wire_offset: Int, payload_end_offset: Int, peer_settings: PeerSettingsState) -> Result<PeerSettingsState, String>
	match item_wire_offset == payload_end_offset
		true => Ok(peer_settings)
		false => update_settings_items(pending, next_offset, item_wire_offset + 6, payload_end_offset, update_single_settings_item(pending, next_offset, item_wire_offset, peer_settings)?)
	end
end

fn update_single_settings_item(pending: ByteChunk, next_offset: Int, item_wire_offset: Int, peer_settings: PeerSettingsState) -> Result<PeerSettingsState, String>
	let item_offset: ByteOffset = byte_offset(item_wire_offset)?
	let item_count: ByteCount = byte_count(6)?
	let item: ByteView = byte_view(pending, item_offset, item_count)?
	let identifier_count: ByteCount = byte_count(2)?
	let value_offset: ByteOffset = byte_offset(2)?
	let value_count: ByteCount = byte_count(4)?
	let identifier: Int = byte_read_u16_be(byte_view(byte_view_to_chunk(item), byte_offset(0)?, identifier_count)?)?
	let value: Int = byte_read_u32_be(byte_view(byte_view_to_chunk(item), value_offset, value_count)?)?
	match peer_settings
		PeerSettings(max_frame_size, initial_window_size, enable_push, max_concurrent_streams, header_table_size, max_header_list_size) => match identifier == 5
			true => Ok(PeerSettings(PeerMaxFrameSize(value, next_offset + item_wire_offset), initial_window_size, enable_push, max_concurrent_streams, header_table_size, max_header_list_size))
			false => match identifier == 4
				true => Ok(PeerSettings(max_frame_size, PeerInitialWindowSize(value, next_offset + item_wire_offset), enable_push, max_concurrent_streams, header_table_size, max_header_list_size))
				false => match identifier == 2
					true => Ok(PeerSettings(max_frame_size, initial_window_size, PeerEnablePush(value, next_offset + item_wire_offset), max_concurrent_streams, header_table_size, max_header_list_size))
					false => match identifier == 3
						true => Ok(PeerSettings(max_frame_size, initial_window_size, enable_push, PeerMaxConcurrentStreams(value, next_offset + item_wire_offset), header_table_size, max_header_list_size))
						false => match identifier == 1
							true => Ok(PeerSettings(max_frame_size, initial_window_size, enable_push, max_concurrent_streams, PeerHeaderTableSize(value, next_offset + item_wire_offset), max_header_list_size))
							false => match identifier == 6
								true => Ok(PeerSettings(max_frame_size, initial_window_size, enable_push, max_concurrent_streams, header_table_size, PeerMaxHeaderListSize(value, next_offset + item_wire_offset)))
								false => Ok(peer_settings)
							end
						end
					end
				end
			end
		end
	end
end

fn update_initial_window_receive_credit(pending: ByteChunk, next_offset: Int, length: Int, kind: Int, flags: Int, peer_settings: PeerSettingsState, receive_flow_control: ReceiveFlowControl) -> Result<ReceiveFlowControl, String>
	match kind == 4
		true => match settings_ack_set(flags)
			true => Ok(receive_flow_control)
			false => match settings_payload_has_complete_items(length)
				true => update_initial_window_receive_credit_items(pending, next_offset, 9, 9 + length, peer_settings, receive_flow_control)
				false => Ok(receive_flow_control)
			end
		end
		false => Ok(receive_flow_control)
	end
end

fn update_initial_window_receive_credit_items(pending: ByteChunk, next_offset: Int, item_wire_offset: Int, payload_end_offset: Int, peer_settings: PeerSettingsState, receive_flow_control: ReceiveFlowControl) -> Result<ReceiveFlowControl, String>
	match item_wire_offset == payload_end_offset
		true => Ok(receive_flow_control)
		false => update_initial_window_receive_credit_items(pending, next_offset, item_wire_offset + 6, payload_end_offset, update_single_settings_item(pending, next_offset, item_wire_offset, peer_settings)?, update_single_initial_window_receive_credit(pending, next_offset, item_wire_offset, peer_settings, receive_flow_control)?)
	end
end

fn update_single_initial_window_receive_credit(pending: ByteChunk, next_offset: Int, item_wire_offset: Int, peer_settings: PeerSettingsState, receive_flow_control: ReceiveFlowControl) -> Result<ReceiveFlowControl, String>
	let item_offset: ByteOffset = byte_offset(item_wire_offset)?
	let item_count: ByteCount = byte_count(6)?
	let item: ByteView = byte_view(pending, item_offset, item_count)?
	let identifier_count: ByteCount = byte_count(2)?
	let value_offset: ByteOffset = byte_offset(2)?
	let value_count: ByteCount = byte_count(4)?
	let identifier: Int = byte_read_u16_be(byte_view(byte_view_to_chunk(item), byte_offset(0)?, identifier_count)?)?
	let value: Int = byte_read_u32_be(byte_view(byte_view_to_chunk(item), value_offset, value_count)?)?
	match identifier == 4
		true => Ok(apply_initial_window_delta(value - active_peer_initial_window_size(peer_settings), receive_flow_control))
		false => Ok(receive_flow_control)
	end
end

fn active_peer_initial_window_size(peer_settings: PeerSettingsState) -> Int
	match peer_settings
		PeerSettings(_, NoPeerInitialWindowSize, _, _, _, _) => 65535
		PeerSettings(_, PeerInitialWindowSize(value, _), _, _, _, _) => value
	end
end

fn active_peer_max_frame_size(peer_settings: PeerSettingsState) -> Int
	match peer_settings
		PeerSettings(NoPeerMaxFrameSize, _, _, _, _, _) => 16384
		PeerSettings(PeerMaxFrameSize(value, _), _, _, _, _, _) => value
	end
end

fn outbound_receive_credit_with_open_stream(connection_window: Int, stream_id: Int, stream_window: Int) -> OutboundReceiveCredit
	OutboundReceiveCredit(connection_window, OutboundReceiveCreditOpenStream(stream_id, stream_window))
end

fn outbound_receive_credit_without_stream(connection_window: Int) -> OutboundReceiveCredit
	OutboundReceiveCredit(connection_window, NoOutboundReceiveCreditStream)
end

fn outbound_receive_credit_with_closed_stream(connection_window: Int, stream_id: Int) -> OutboundReceiveCredit
	OutboundReceiveCredit(connection_window, OutboundReceiveCreditClosedStream(stream_id))
end

fn outbound_receive_credit_with_reset_stream(connection_window: Int, stream_id: Int, error_code: Int) -> OutboundReceiveCredit
	OutboundReceiveCredit(connection_window, OutboundReceiveCreditResetStream(stream_id, error_code))
end

fn send_data(stream_id: Int, payload: ByteChunk, end_stream: Bool, peer_settings: PeerSettingsState, receive_credit: OutboundReceiveCredit) -> Result<OutboundDataDecision, String>
	let length: Int = byte_count_to_int(byte_chunk_count(payload))
	let max_frame_size: Int = active_peer_max_frame_size(peer_settings)
	match max_frame_size < 1
		true => Ok(OutboundDataRejected(stream_id, length, end_stream, FrameSizeExceeded(0, length, ReceiveLimit(max_frame_size, LocalConfiguration), 0, stream_id)))
		false => consume_outbound_data_window(stream_id, payload, length, end_stream, max_frame_size, receive_credit)
	end
end

fn send_padded_data(stream_id: Int, payload: ByteChunk, padding_length: Int, end_stream: Bool, peer_settings: PeerSettingsState, receive_credit: OutboundReceiveCredit) -> Result<OutboundDataDecision, String>
	let application_length: Int = byte_count_to_int(byte_chunk_count(payload))
	let max_frame_size: Int = active_peer_max_frame_size(peer_settings)
	match padding_length < 0
		true => Ok(OutboundDataRejected(stream_id, application_length, end_stream, InvalidDataPadding(0, stream_id, padding_length, 0, "open-stream", "outbound_data_padding", empty_byte_preview()?)))
		false => match padding_length > 255
			true => Ok(OutboundDataRejected(stream_id, application_length, end_stream, InvalidDataPadding(0, stream_id, padding_length, 255, "open-stream", "outbound_data_padding", empty_byte_preview()?)))
			false => send_nonnegative_padded_data(stream_id, payload, application_length, padding_length, end_stream, max_frame_size, receive_credit)
		end
	end
end

fn empty_byte_preview() -> Result<ByteView, String>
	byte_view(byte_chunk([]), byte_offset(0)?, byte_count(0)?)
end

fn send_nonnegative_padded_data(stream_id: Int, payload: ByteChunk, application_length: Int, padding_length: Int, end_stream: Bool, max_frame_size: Int, receive_credit: OutboundReceiveCredit) -> Result<OutboundDataDecision, String>
	match application_length > 0
		true => match max_frame_size < padding_length + 2
			true => Ok(OutboundDataRejected(stream_id, padding_length + 2, end_stream, FrameSizeExceeded(0, padding_length + 2, ReceiveLimit(max_frame_size, LocalConfiguration), 0, stream_id)))
			false => send_valid_padded_data(stream_id, payload, application_length, padding_length, end_stream, max_frame_size, receive_credit)
		end
		false => match max_frame_size < padding_length + 1
			true => Ok(OutboundDataRejected(stream_id, padding_length + 1, end_stream, FrameSizeExceeded(0, padding_length + 1, ReceiveLimit(max_frame_size, LocalConfiguration), 0, stream_id)))
			false => send_valid_padded_data(stream_id, payload, application_length, padding_length, end_stream, max_frame_size, receive_credit)
		end
	end
end

fn send_valid_padded_data(stream_id: Int, payload: ByteChunk, application_length: Int, padding_length: Int, end_stream: Bool, max_frame_size: Int, receive_credit: OutboundReceiveCredit) -> Result<OutboundDataDecision, String>
	let max_application_frame_payload: Int = max_padded_application_frame_payload(max_frame_size, padding_length)
	let encoded_length: Int = padded_data_encoded_length(application_length, padding_length, max_application_frame_payload)
	consume_outbound_padded_data_window(stream_id, payload, encoded_length, padding_length, end_stream, max_frame_size, receive_credit)
end

fn max_padded_application_frame_payload(max_frame_size: Int, padding_length: Int) -> Int
	max_frame_size - padding_length - 1
end

fn padded_data_encoded_length(application_length: Int, padding_length: Int, max_application_frame_payload: Int) -> Int
	padded_data_encoded_length_remaining(application_length, padding_length, max_application_frame_payload, 0)
end

fn padded_data_encoded_length_remaining(remaining_length: Int, padding_length: Int, max_application_frame_payload: Int, total: Int) -> Int
	match remaining_length > max_application_frame_payload
		true => padded_data_encoded_length_remaining(remaining_length - max_application_frame_payload, padding_length, max_application_frame_payload, total + max_application_frame_payload + padding_length + 1)
		false => total + remaining_length + padding_length + 1
	end
end

fn send_settings_ack() -> Result<ByteChunk, EncodeError>
	encode_frame_header({length: 0, kind: 4, flags: 1, stream_id: 0})
end

fn connection_state(decode_state: Http2DecodeState) -> Http2ConnectionState
	ConnectionState(decode_state, NoOutstandingLocalSettings)
end

fn receive_connection(input: Http2Input, connection: Http2ConnectionState) -> Result<Http2ConnectionStep, String>
	match connection
		ConnectionState(decode_state, outstanding_settings) => update_connection_after_receive(receive(input, decode_state)?, outstanding_settings)
	end
end

fn update_connection_after_receive(step: Http2Step, outstanding_settings: OutstandingLocalSettings) -> Result<Http2ConnectionStep, String>
	match step
		FrameDecoded(decode_state, offset, _, kind, flags, _, _, _) => match settings_ack_frame(kind, flags)
			true => receive_settings_ack(offset, decode_state, outstanding_settings, step)
			false => Ok(ConnectionFrameDecoded(ConnectionState(decode_state, outstanding_settings), step))
		end
		Waiting(decode_state) => Ok(ConnectionWaiting(ConnectionState(decode_state, outstanding_settings)))
		Failed(decode_state, failure) => Ok(ConnectionFailed(ConnectionState(decode_state, outstanding_settings), failure))
	end
end

fn settings_ack_frame(kind: Int, flags: Int) -> Bool
	match kind == 4
		true => settings_ack_set(flags)
		false => false
	end
end

fn receive_settings_ack(offset: Int, decode_state: Http2DecodeState, outstanding_settings: OutstandingLocalSettings, step: Http2Step) -> Result<Http2ConnectionStep, String>
	match outstanding_settings
		NoOutstandingLocalSettings => Ok(ConnectionFailed(ConnectionState(decode_state, NoOutstandingLocalSettings), UnexpectedSettingsAck(offset, "connection-control", "rfc9113_settings_ack_requires_outstanding_local_settings")))
		OutstandingLocalSettings(_, _) => Ok(ConnectionFrameDecoded(ConnectionState(decode_state, NoOutstandingLocalSettings), step))
	end
end

fn send_local_max_frame_size_setting(value: Int, connection: Http2ConnectionState) -> Result<OutboundSettingsDecision, String>
	match connection
		ConnectionState(decode_state, _) => encode_local_settings_intent(value, decode_state)
	end
end

fn send_local_max_frame_size_and_enable_push_settings(max_frame_size_value: Int, enable_push_value: Int, connection: Http2ConnectionState) -> Result<OutboundSettingsDecision, String>
	match enable_push_value < 0
		true => Ok(OutboundSettingsRejected(SettingsValueOutOfRange(6, 2, "SETTINGS_ENABLE_PUSH", enable_push_value, 0, 1, "local_settings")))
		false => match enable_push_value > 1
			true => Ok(OutboundSettingsRejected(SettingsValueOutOfRange(6, 2, "SETTINGS_ENABLE_PUSH", enable_push_value, 0, 1, "local_settings")))
			false => match connection
				ConnectionState(decode_state, _) => encode_local_settings_batch_intent(max_frame_size_value, enable_push_value, decode_state)
			end
		end
	end
end

fn encode_local_settings_batch_intent(max_frame_size_value: Int, enable_push_value: Int, decode_state: Http2DecodeState) -> Result<OutboundSettingsDecision, String>
	let max_frame_size_payload: ByteChunk = byte_append(byte_write_u16_be(5)?, byte_write_u32_be(max_frame_size_value)?)
	let enable_push_payload: ByteChunk = byte_append(byte_write_u16_be(2)?, byte_write_u32_be(enable_push_value)?)
	let payload: ByteChunk = byte_append(max_frame_size_payload, enable_push_payload)
	let encoded_header: Result<ByteChunk, EncodeError> = encode_frame_header({length: 12, kind: 4, flags: 0, stream_id: 0})
	match encoded_header
		Ok(header) => Ok(OutboundSettingsAccepted(5, max_frame_size_value, ConnectionState(decode_state, OutstandingLocalSettings(5, 2)), byte_append(header, payload)))
		Err(error) => Ok(OutboundSettingsEncodeFailed(error))
	end
end

fn encode_local_settings_intent(value: Int, decode_state: Http2DecodeState) -> Result<OutboundSettingsDecision, String>
	let payload: ByteChunk = byte_append(byte_write_u16_be(5)?, byte_write_u32_be(value)?)
	let encoded_header: Result<ByteChunk, EncodeError> = encode_frame_header({length: 6, kind: 4, flags: 0, stream_id: 0})
	match encoded_header
		Ok(header) => Ok(OutboundSettingsAccepted(5, value, ConnectionState(decode_state, OutstandingLocalSettings(5, 1)), byte_append(header, payload)))
		Err(error) => Ok(OutboundSettingsEncodeFailed(error))
	end
end

fn send_local_initial_window_size_setting(value: Int, connection: Http2ConnectionState) -> Result<OutboundSettingsDecision, String>
	match connection
		ConnectionState(decode_state, _) => encode_local_initial_window_size_intent(value, decode_state)
	end
end

fn encode_local_initial_window_size_intent(value: Int, decode_state: Http2DecodeState) -> Result<OutboundSettingsDecision, String>
	let payload: ByteChunk = byte_append(byte_write_u16_be(4)?, byte_write_u32_be(value)?)
	let encoded_header: Result<ByteChunk, EncodeError> = encode_frame_header({length: 6, kind: 4, flags: 0, stream_id: 0})
	match encoded_header
		Ok(header) => Ok(OutboundSettingsAccepted(4, value, ConnectionState(decode_state, OutstandingLocalSettings(4, 1)), byte_append(header, payload)))
		Err(error) => Ok(OutboundSettingsEncodeFailed(error))
	end
end

fn send_local_max_concurrent_streams_setting(value: Int, connection: Http2ConnectionState) -> Result<OutboundSettingsDecision, String>
	match connection
		ConnectionState(decode_state, _) => encode_local_max_concurrent_streams_intent(value, decode_state)
	end
end

fn encode_local_max_concurrent_streams_intent(value: Int, decode_state: Http2DecodeState) -> Result<OutboundSettingsDecision, String>
	let payload: ByteChunk = byte_append(byte_write_u16_be(3)?, byte_write_u32_be(value)?)
	let encoded_header: Result<ByteChunk, EncodeError> = encode_frame_header({length: 6, kind: 4, flags: 0, stream_id: 0})
	match encoded_header
		Ok(header) => Ok(OutboundSettingsAccepted(3, value, ConnectionState(decode_state, OutstandingLocalSettings(3, 1)), byte_append(header, payload)))
		Err(error) => Ok(OutboundSettingsEncodeFailed(error))
	end
end

fn send_local_enable_push_setting(value: Int, connection: Http2ConnectionState) -> Result<OutboundSettingsDecision, String>
	match value < 0
		true => Ok(OutboundSettingsRejected(SettingsValueOutOfRange(0, 2, "SETTINGS_ENABLE_PUSH", value, 0, 1, "local_settings")))
		false => match value > 1
			true => Ok(OutboundSettingsRejected(SettingsValueOutOfRange(0, 2, "SETTINGS_ENABLE_PUSH", value, 0, 1, "local_settings")))
			false => match connection
				ConnectionState(decode_state, _) => encode_local_enable_push_intent(value, decode_state)
			end
		end
	end
end

fn encode_local_enable_push_intent(value: Int, decode_state: Http2DecodeState) -> Result<OutboundSettingsDecision, String>
	let payload: ByteChunk = byte_append(byte_write_u16_be(2)?, byte_write_u32_be(value)?)
	let encoded_header: Result<ByteChunk, EncodeError> = encode_frame_header({length: 6, kind: 4, flags: 0, stream_id: 0})
	match encoded_header
		Ok(header) => Ok(OutboundSettingsAccepted(2, value, ConnectionState(decode_state, OutstandingLocalSettings(2, 1)), byte_append(header, payload)))
		Err(error) => Ok(OutboundSettingsEncodeFailed(error))
	end
end

fn send_local_header_table_size_setting(value: Int, connection: Http2ConnectionState) -> Result<OutboundSettingsDecision, String>
	match connection
		ConnectionState(decode_state, _) => encode_local_header_table_size_intent(value, decode_state)
	end
end

fn encode_local_header_table_size_intent(value: Int, decode_state: Http2DecodeState) -> Result<OutboundSettingsDecision, String>
	let payload: ByteChunk = byte_append(byte_write_u16_be(1)?, byte_write_u32_be(value)?)
	let encoded_header: Result<ByteChunk, EncodeError> = encode_frame_header({length: 6, kind: 4, flags: 0, stream_id: 0})
	match encoded_header
		Ok(header) => Ok(OutboundSettingsAccepted(1, value, ConnectionState(decode_state, OutstandingLocalSettings(1, 1)), byte_append(header, payload)))
		Err(error) => Ok(OutboundSettingsEncodeFailed(error))
	end
end

fn send_local_max_header_list_size_setting(value: Int, connection: Http2ConnectionState) -> Result<OutboundSettingsDecision, String>
	match connection
		ConnectionState(decode_state, _) => encode_local_max_header_list_size_intent(value, decode_state)
	end
end

fn encode_local_max_header_list_size_intent(value: Int, decode_state: Http2DecodeState) -> Result<OutboundSettingsDecision, String>
	let payload: ByteChunk = byte_append(byte_write_u16_be(6)?, byte_write_u32_be(value)?)
	let encoded_header: Result<ByteChunk, EncodeError> = encode_frame_header({length: 6, kind: 4, flags: 0, stream_id: 0})
	match encoded_header
		Ok(header) => Ok(OutboundSettingsAccepted(6, value, ConnectionState(decode_state, OutstandingLocalSettings(6, 1)), byte_append(header, payload)))
		Err(error) => Ok(OutboundSettingsEncodeFailed(error))
	end
end

fn send_ping_ack_for_received(step: Http2Step) -> Result<OutboundPingAckDecision, String>
	match step
		FrameDecoded(_, _, _, kind, flags, _, _, frame) => match kind == 6
			true => match ping_ack_set(flags)
				true => Ok(OutboundPingAckNoResponse)
				false => encode_ping_ack_intent(frame)
			end
			false => Ok(OutboundPingAckNoResponse)
		end
		Waiting(_) => Ok(OutboundPingAckNoResponse)
		Failed(_, _) => Ok(OutboundPingAckNoResponse)
	end
end

fn encode_ping_ack_intent(frame: Http2Frame) -> Result<OutboundPingAckDecision, String>
	match frame
		KnownFrame(_, _, _, payload) => encode_ping_ack_payload(byte_view_to_chunk(payload))
		PriorityFrame(_, _, _, _, _) => Ok(OutboundPingAckNoResponse)
		UnknownFrame(_, _, _, _) => Ok(OutboundPingAckNoResponse)
	end
end

fn encode_ping_ack_payload(payload: ByteChunk) -> Result<OutboundPingAckDecision, String>
	let encoded_header: Result<ByteChunk, EncodeError> = encode_frame_header({length: 8, kind: 6, flags: 1, stream_id: 0})
	match encoded_header
		Ok(header) => Ok(OutboundPingAckAccepted(byte_append(header, payload)))
		Err(error) => Ok(OutboundPingAckEncodeFailed(error))
	end
end

fn send_goaway(last_stream_id: Int, error_code: Int, state: Http2DecodeState) -> Result<OutboundGoawayDecision, String>
	let encoded_payload: Result<ByteChunk, EncodeError> = encode_goaway_payload({last_stream_id: last_stream_id, error_code: error_code})
	match encoded_payload
		Ok(payload) => encode_goaway_intent(last_stream_id, error_code, state, payload)
		Err(error) => Ok(OutboundGoawayEncodeFailed(last_stream_id, error_code, error))
	end
end

fn encode_goaway_intent(last_stream_id: Int, error_code: Int, state: Http2DecodeState, payload: ByteChunk) -> Result<OutboundGoawayDecision, String>
	let encoded_header: Result<ByteChunk, EncodeError> = encode_frame_header({length: 8, kind: 7, flags: 0, stream_id: 0})
	match encoded_header
		Ok(header) => Ok(OutboundGoawayAccepted(last_stream_id, error_code, goaway_sent_state(last_stream_id, error_code, state), byte_append(header, payload)))
		Err(error) => Ok(OutboundGoawayEncodeFailed(last_stream_id, error_code, error))
	end
end

fn goaway_sent_state(last_stream_id: Int, error_code: Int, state: Http2DecodeState) -> Http2DecodeState
	match state
		State(pending, next_offset, preface_state, continuation, hpack_state, receive_limit, peer_settings, _, receive_flow_control) => State(pending, next_offset, preface_state, continuation, hpack_state, receive_limit, peer_settings, GracefulShutdown(last_stream_id, error_code), receive_flow_control)
	end
end

fn send_rst_stream(stream_id: Int, error_code: Int, receive_credit: OutboundReceiveCredit) -> Result<OutboundRstStreamDecision, String>
	match stream_id == 0
		true => Ok(OutboundRstStreamRejected(stream_id, error_code, InvalidStreamId(0, 3, stream_id, "nonzero open stream id", "local", "stream-id-domain", "outbound_rst_stream_requires_open_stream")))
		false => send_nonzero_rst_stream(stream_id, error_code, receive_credit)
	end
end

fn send_nonzero_rst_stream(stream_id: Int, error_code: Int, receive_credit: OutboundReceiveCredit) -> Result<OutboundRstStreamDecision, String>
	match receive_credit
		OutboundReceiveCredit(connection_window, NoOutboundReceiveCreditStream) => Ok(OutboundRstStreamRejected(stream_id, error_code, InvalidFrameKind(0, 3, stream_id, 1, "idle-stream", "idle_streams_require_headers")))
		OutboundReceiveCredit(connection_window, OutboundReceiveCreditOpenStream(open_stream_id, _)) => match stream_id == open_stream_id
			true => encode_rst_stream_intent(stream_id, error_code, connection_window)
			false => Ok(OutboundRstStreamRejected(stream_id, error_code, InvalidFrameKind(0, 3, stream_id, 1, "idle-stream", "idle_streams_require_headers")))
		end
		OutboundReceiveCredit(connection_window, OutboundReceiveCreditClosedStream(closed_stream_id)) => match stream_id == closed_stream_id
			true => Ok(OutboundRstStreamRejected(stream_id, error_code, InvalidFrameKind(0, 3, stream_id, 1, "closed-stream", "closed_stream_rejects_later_frames")))
			false => Ok(OutboundRstStreamRejected(stream_id, error_code, InvalidFrameKind(0, 3, stream_id, 1, "idle-stream", "idle_streams_require_headers")))
		end
		OutboundReceiveCredit(connection_window, OutboundReceiveCreditResetStream(reset_stream_id, _)) => match stream_id == reset_stream_id
			true => Ok(OutboundRstStreamRejected(stream_id, error_code, InvalidFrameKind(0, 3, stream_id, 1, "reset-stream", "reset_stream_rejects_later_frames")))
			false => Ok(OutboundRstStreamRejected(stream_id, error_code, InvalidFrameKind(0, 3, stream_id, 1, "idle-stream", "idle_streams_require_headers")))
		end
	end
end

fn encode_rst_stream_intent(stream_id: Int, error_code: Int, connection_window: Int) -> Result<OutboundRstStreamDecision, String>
	let encoded_header: Result<ByteChunk, EncodeError> = encode_frame_header({length: 4, kind: 3, flags: 0, stream_id: stream_id})
	match encoded_header
		Ok(header) => encode_rst_stream_payload_intent(stream_id, error_code, connection_window, header)
		Err(error) => Ok(OutboundRstStreamEncodeFailed(stream_id, error_code, error))
	end
end

fn encode_rst_stream_payload_intent(stream_id: Int, error_code: Int, connection_window: Int, header: ByteChunk) -> Result<OutboundRstStreamDecision, String>
	let encoded_payload: Result<ByteChunk, EncodeError> = encode_rst_stream_payload({error_code: error_code})
	match encoded_payload
		Ok(payload) => Ok(OutboundRstStreamAccepted(stream_id, error_code, OutboundReceiveCredit(connection_window, OutboundReceiveCreditResetStream(stream_id, error_code)), byte_append(header, payload)))
		Err(error) => Ok(OutboundRstStreamEncodeFailed(stream_id, error_code, error))
	end
end

fn send_priority(stream_id: Int, dependency_stream_id: Int, exclusive: Bool, weight: Int, receive_credit: OutboundReceiveCredit) -> Result<OutboundPriorityDecision, String>
	match stream_id == 0
		true => Ok(OutboundPriorityRejected(stream_id, dependency_stream_id, exclusive, weight, InvalidStreamId(0, 2, stream_id, "nonzero open stream id", "local", "stream-id-domain", "outbound_priority_requires_open_stream")))
		false => send_nonzero_priority(stream_id, dependency_stream_id, exclusive, weight, receive_credit)
	end
end

fn send_nonzero_priority(stream_id: Int, dependency_stream_id: Int, exclusive: Bool, weight: Int, receive_credit: OutboundReceiveCredit) -> Result<OutboundPriorityDecision, String>
	match receive_credit
		OutboundReceiveCredit(connection_window, NoOutboundReceiveCreditStream) => Ok(OutboundPriorityRejected(stream_id, dependency_stream_id, exclusive, weight, InvalidFrameKind(0, 2, stream_id, 1, "idle-stream", "idle_streams_require_headers")))
		OutboundReceiveCredit(connection_window, OutboundReceiveCreditOpenStream(open_stream_id, stream_window)) => match stream_id == open_stream_id
			true => validate_outbound_priority_dependency(stream_id, dependency_stream_id, exclusive, weight, connection_window, stream_window)
			false => Ok(OutboundPriorityRejected(stream_id, dependency_stream_id, exclusive, weight, InvalidFrameKind(0, 2, stream_id, 1, "idle-stream", "idle_streams_require_headers")))
		end
		OutboundReceiveCredit(connection_window, OutboundReceiveCreditClosedStream(closed_stream_id)) => match stream_id == closed_stream_id
			true => Ok(OutboundPriorityRejected(stream_id, dependency_stream_id, exclusive, weight, InvalidFrameKind(0, 2, stream_id, 1, "closed-stream", "closed_stream_rejects_later_frames")))
			false => Ok(OutboundPriorityRejected(stream_id, dependency_stream_id, exclusive, weight, InvalidFrameKind(0, 2, stream_id, 1, "idle-stream", "idle_streams_require_headers")))
		end
		OutboundReceiveCredit(connection_window, OutboundReceiveCreditResetStream(reset_stream_id, _)) => match stream_id == reset_stream_id
			true => Ok(OutboundPriorityRejected(stream_id, dependency_stream_id, exclusive, weight, InvalidFrameKind(0, 2, stream_id, 1, "reset-stream", "reset_stream_rejects_later_frames")))
			false => Ok(OutboundPriorityRejected(stream_id, dependency_stream_id, exclusive, weight, InvalidFrameKind(0, 2, stream_id, 1, "idle-stream", "idle_streams_require_headers")))
		end
	end
end

fn validate_outbound_priority_dependency(stream_id: Int, dependency_stream_id: Int, exclusive: Bool, weight: Int, connection_window: Int, stream_window: Int) -> Result<OutboundPriorityDecision, String>
	match stream_id == dependency_stream_id
		true => Ok(OutboundPriorityRejected(stream_id, dependency_stream_id, exclusive, weight, InvalidPriorityDependency(0, stream_id, dependency_stream_id, "stream-control", "rfc9113_priority_dependency", empty_byte_preview()?)))
		false => encode_priority_intent(stream_id, dependency_stream_id, exclusive, weight, connection_window, stream_window)
	end
end

fn encode_priority_intent(stream_id: Int, dependency_stream_id: Int, exclusive: Bool, weight: Int, connection_window: Int, stream_window: Int) -> Result<OutboundPriorityDecision, String>
	let encoded_header: Result<ByteChunk, EncodeError> = encode_frame_header({length: 5, kind: 2, flags: 0, stream_id: stream_id})
	match encoded_header
		Ok(header) => encode_priority_payload_intent(stream_id, dependency_stream_id, exclusive, weight, connection_window, stream_window, header)
		Err(error) => Ok(OutboundPriorityEncodeFailed(stream_id, dependency_stream_id, exclusive, weight, error))
	end
end

fn encode_priority_payload_intent(stream_id: Int, dependency_stream_id: Int, exclusive: Bool, weight: Int, connection_window: Int, stream_window: Int, header: ByteChunk) -> Result<OutboundPriorityDecision, String>
	let encoded_dependency: Result<ByteChunk, EncodeError> = encode_priority_dependency_payload({dependency_stream_id: dependency_stream_id})
	match encoded_dependency
		Ok(dependency_payload) => encode_priority_weight_payload_intent(stream_id, dependency_stream_id, exclusive, weight, connection_window, stream_window, header, dependency_payload)
		Err(error) => Ok(OutboundPriorityEncodeFailed(stream_id, dependency_stream_id, exclusive, weight, error))
	end
end

fn encode_priority_weight_payload_intent(stream_id: Int, dependency_stream_id: Int, exclusive: Bool, weight: Int, connection_window: Int, stream_window: Int, header: ByteChunk, dependency_payload: ByteChunk) -> Result<OutboundPriorityDecision, String>
	let encoded_weight: Result<ByteChunk, EncodeError> = encode_priority_weight_payload({weight: weight - 1})
	match encoded_weight
		Ok(weight_payload) => Ok(OutboundPriorityAccepted(stream_id, dependency_stream_id, exclusive, weight, OutboundReceiveCredit(connection_window, OutboundReceiveCreditOpenStream(stream_id, stream_window)), byte_append(header, byte_append(priority_dependency_payload_with_exclusive(dependency_payload, exclusive)?, weight_payload))))
		Err(error) => Ok(OutboundPriorityEncodeFailed(stream_id, dependency_stream_id, exclusive, weight, error))
	end
end

fn priority_dependency_payload_with_exclusive(payload: ByteChunk, exclusive: Bool) -> Result<ByteChunk, String>
	let first: Int = read_byte(payload, 0)?
	let encoded_first: Int = first + exclusive_bit_value(exclusive)
	let second: Int = read_byte(payload, 1)?
	let third: Int = read_byte(payload, 2)?
	let fourth: Int = read_byte(payload, 3)?
	Ok(byte_append(byte_append(byte_append(byte_write_u8_be(encoded_first)?, byte_write_u8_be(second)?), byte_write_u8_be(third)?), byte_write_u8_be(fourth)?))
end

fn exclusive_bit_value(exclusive: Bool) -> Int
	match exclusive
		true => 128
		false => 0
	end
end

fn send_headers(stream_id: Int, header_block: ByteChunk, end_stream: Bool, peer_settings: PeerSettingsState, receive_credit: OutboundReceiveCredit) -> Result<OutboundHeadersDecision, String>
	send_headers_with_shutdown(stream_id, header_block, end_stream, peer_settings, OpenConnection, receive_credit)
end

fn send_headers_with_shutdown(stream_id: Int, header_block: ByteChunk, end_stream: Bool, peer_settings: PeerSettingsState, shutdown_state: ConnectionShutdownState, receive_credit: OutboundReceiveCredit) -> Result<OutboundHeadersDecision, String>
	let payload_length: Int = byte_count_to_int(byte_chunk_count(header_block))
	match stream_id == 0
		true => Ok(OutboundHeadersRejected(stream_id, payload_length, end_stream, InvalidStreamId(0, 1, stream_id, "nonzero open stream id", "local", "stream-id-domain", "outbound_headers_requires_open_stream")))
		false => send_nonzero_headers(stream_id, payload_length, header_block, end_stream, active_peer_max_frame_size(peer_settings), shutdown_state, receive_credit)
	end
end

fn send_nonzero_headers(stream_id: Int, payload_length: Int, header_block: ByteChunk, end_stream: Bool, max_frame_size: Int, shutdown_state: ConnectionShutdownState, receive_credit: OutboundReceiveCredit) -> Result<OutboundHeadersDecision, String>
	match receive_credit
		OutboundReceiveCredit(connection_window, NoOutboundReceiveCreditStream) => Ok(OutboundHeadersRejected(stream_id, payload_length, end_stream, InvalidFrameKind(0, 1, stream_id, 1, "idle-stream", "idle_streams_require_headers")))
		OutboundReceiveCredit(connection_window, OutboundReceiveCreditOpenStream(open_stream_id, stream_window)) => match stream_id == open_stream_id
			true => validate_outbound_headers_after_goaway(stream_id, payload_length, header_block, end_stream, max_frame_size, shutdown_state, connection_window, stream_window)
			false => Ok(OutboundHeadersRejected(stream_id, payload_length, end_stream, InvalidFrameKind(0, 1, stream_id, 1, "idle-stream", "idle_streams_require_headers")))
		end
		OutboundReceiveCredit(connection_window, OutboundReceiveCreditClosedStream(closed_stream_id)) => match stream_id == closed_stream_id
			true => Ok(OutboundHeadersRejected(stream_id, payload_length, end_stream, InvalidFrameKind(0, 1, stream_id, 1, "closed-stream", "closed_stream_rejects_later_frames")))
			false => Ok(OutboundHeadersRejected(stream_id, payload_length, end_stream, InvalidFrameKind(0, 1, stream_id, 1, "idle-stream", "idle_streams_require_headers")))
		end
		OutboundReceiveCredit(connection_window, OutboundReceiveCreditResetStream(reset_stream_id, _)) => match stream_id == reset_stream_id
			true => Ok(OutboundHeadersRejected(stream_id, payload_length, end_stream, InvalidFrameKind(0, 1, stream_id, 1, "reset-stream", "reset_stream_rejects_later_frames")))
			false => Ok(OutboundHeadersRejected(stream_id, payload_length, end_stream, InvalidFrameKind(0, 1, stream_id, 1, "idle-stream", "idle_streams_require_headers")))
		end
	end
end

fn validate_outbound_headers_after_goaway(stream_id: Int, payload_length: Int, header_block: ByteChunk, end_stream: Bool, max_frame_size: Int, shutdown_state: ConnectionShutdownState, connection_window: Int, stream_window: Int) -> Result<OutboundHeadersDecision, String>
	match shutdown_state
		OpenConnection => validate_headers_frame_size(stream_id, payload_length, header_block, end_stream, max_frame_size, connection_window, stream_window)
		GracefulShutdown(last_stream_id, _) => match stream_id > last_stream_id
			true => Ok(OutboundHeadersRejected(stream_id, payload_length, end_stream, StreamAfterGoaway(0, stream_id, last_stream_id, "graceful_shutdown", "local", "goaway_last_stream_id")))
			false => validate_headers_frame_size(stream_id, payload_length, header_block, end_stream, max_frame_size, connection_window, stream_window)
		end
	end
end

fn validate_headers_frame_size(stream_id: Int, payload_length: Int, header_block: ByteChunk, end_stream: Bool, max_frame_size: Int, connection_window: Int, stream_window: Int) -> Result<OutboundHeadersDecision, String>
	encode_headers_intent(stream_id, payload_length, header_block, end_stream, max_frame_size, connection_window, stream_window)
end

fn encode_headers_intent(stream_id: Int, payload_length: Int, header_block: ByteChunk, end_stream: Bool, max_frame_size: Int, connection_window: Int, stream_window: Int) -> Result<OutboundHeadersDecision, String>
	match max_frame_size < 1
		true => Ok(OutboundHeadersRejected(stream_id, payload_length, end_stream, FrameSizeExceeded(0, payload_length, ReceiveLimit(max_frame_size, LocalConfiguration), 1, stream_id)))
		false => match payload_length > max_frame_size
			true => encode_split_headers_intent(stream_id, payload_length, header_block, end_stream, max_frame_size, connection_window, stream_window)
			false => encode_single_headers_intent(stream_id, payload_length, header_block, end_stream, connection_window, stream_window)
		end
	end
end

fn encode_single_headers_intent(stream_id: Int, payload_length: Int, header_block: ByteChunk, end_stream: Bool, connection_window: Int, stream_window: Int) -> Result<OutboundHeadersDecision, String>
	let flags: Int = headers_flags(end_stream)
	let encoded_header: Result<ByteChunk, EncodeError> = encode_frame_header({length: payload_length, kind: 1, flags: flags, stream_id: stream_id})
	match encoded_header
		Ok(header) => Ok(OutboundHeadersAccepted(stream_id, payload_length, end_stream, headers_sent_receive_credit(stream_id, end_stream, connection_window, stream_window), byte_append(header, header_block)))
		Err(error) => Ok(OutboundHeadersEncodeFailed(stream_id, payload_length, end_stream, error))
	end
end

fn encode_split_headers_intent(stream_id: Int, payload_length: Int, header_block: ByteChunk, end_stream: Bool, max_frame_size: Int, connection_window: Int, stream_window: Int) -> Result<OutboundHeadersDecision, String>
	let chunk_count: ByteCount = byte_count(max_frame_size)?
	let first_payload: ByteChunk = byte_take(header_block, chunk_count)?
	let remaining: ByteChunk = byte_drop(header_block, chunk_count)?
	let encoded_header: Result<ByteChunk, EncodeError> = encode_frame_header({length: max_frame_size, kind: 1, flags: first_headers_flags(end_stream), stream_id: stream_id})
	match encoded_header
		Ok(header) => encode_continuation_headers_intent(stream_id, payload_length, end_stream, max_frame_size, connection_window, stream_window, remaining, byte_append(header, first_payload))
		Err(error) => Ok(OutboundHeadersEncodeFailed(stream_id, payload_length, end_stream, error))
	end
end

fn encode_continuation_headers_intent(stream_id: Int, payload_length: Int, end_stream: Bool, max_frame_size: Int, connection_window: Int, stream_window: Int, remaining: ByteChunk, encoded: ByteChunk) -> Result<OutboundHeadersDecision, String>
	let remaining_length: Int = byte_count_to_int(byte_chunk_count(remaining))
	match remaining_length > max_frame_size
		true => encode_nonfinal_continuation_header(stream_id, payload_length, end_stream, max_frame_size, connection_window, stream_window, remaining, encoded)
		false => encode_final_continuation_header(stream_id, payload_length, end_stream, remaining_length, connection_window, stream_window, remaining, encoded)
	end
end

fn encode_nonfinal_continuation_header(stream_id: Int, payload_length: Int, end_stream: Bool, max_frame_size: Int, connection_window: Int, stream_window: Int, remaining: ByteChunk, encoded: ByteChunk) -> Result<OutboundHeadersDecision, String>
	let chunk_count: ByteCount = byte_count(max_frame_size)?
	let payload: ByteChunk = byte_take(remaining, chunk_count)?
	let next_remaining: ByteChunk = byte_drop(remaining, chunk_count)?
	let encoded_header: Result<ByteChunk, EncodeError> = encode_frame_header({length: max_frame_size, kind: 9, flags: 0, stream_id: stream_id})
	match encoded_header
		Ok(header) => encode_continuation_headers_intent(stream_id, payload_length, end_stream, max_frame_size, connection_window, stream_window, next_remaining, byte_append(byte_append(encoded, header), payload))
		Err(error) => Ok(OutboundHeadersEncodeFailed(stream_id, payload_length, end_stream, error))
	end
end

fn encode_final_continuation_header(stream_id: Int, payload_length: Int, end_stream: Bool, final_length: Int, connection_window: Int, stream_window: Int, remaining: ByteChunk, encoded: ByteChunk) -> Result<OutboundHeadersDecision, String>
	let encoded_header: Result<ByteChunk, EncodeError> = encode_frame_header({length: final_length, kind: 9, flags: 4, stream_id: stream_id})
	match encoded_header
		Ok(header) => Ok(OutboundHeadersAccepted(stream_id, payload_length, end_stream, headers_sent_receive_credit(stream_id, end_stream, connection_window, stream_window), byte_append(byte_append(encoded, header), remaining)))
		Err(error) => Ok(OutboundHeadersEncodeFailed(stream_id, payload_length, end_stream, error))
	end
end

fn headers_flags(end_stream: Bool) -> Int
	match end_stream
		true => 5
		false => 4
	end
end

fn first_headers_flags(end_stream: Bool) -> Int
	match end_stream
		true => 1
		false => 0
	end
end

fn headers_sent_receive_credit(stream_id: Int, end_stream: Bool, connection_window: Int, stream_window: Int) -> OutboundReceiveCredit
	match end_stream
		true => OutboundReceiveCredit(connection_window, OutboundReceiveCreditClosedStream(stream_id))
		false => OutboundReceiveCredit(connection_window, OutboundReceiveCreditOpenStream(stream_id, stream_window))
	end
end

fn consume_outbound_data_window(stream_id: Int, payload: ByteChunk, length: Int, end_stream: Bool, max_frame_size: Int, receive_credit: OutboundReceiveCredit) -> Result<OutboundDataDecision, String>
	match receive_credit
		OutboundReceiveCredit(connection_window, NoOutboundReceiveCreditStream) => Ok(OutboundDataRejected(stream_id, length, end_stream, FlowControlWindowExceeded(0, 0, stream_id, length, 0, "open-stream", "outbound_stream_window")))
		OutboundReceiveCredit(connection_window, OutboundReceiveCreditOpenStream(open_stream_id, stream_window)) => match length > connection_window
			true => Ok(OutboundDataRejected(stream_id, length, end_stream, FlowControlWindowExceeded(0, 0, stream_id, length, connection_window, "connection-flow-control", "outbound_connection_window")))
			false => match stream_id == open_stream_id
				false => Ok(OutboundDataRejected(stream_id, length, end_stream, FlowControlWindowExceeded(0, 0, stream_id, length, 0, "open-stream", "outbound_stream_window")))
				true => match length > stream_window
					true => Ok(OutboundDataRejected(stream_id, length, end_stream, FlowControlWindowExceeded(0, 0, stream_id, length, stream_window, "open-stream", "outbound_stream_window")))
					false => encode_data_intent(stream_id, payload, length, end_stream, max_frame_size, connection_window, stream_window)
				end
			end
		end
		OutboundReceiveCredit(connection_window, OutboundReceiveCreditClosedStream(closed_stream_id)) => match stream_id == closed_stream_id
			true => Ok(OutboundDataRejected(stream_id, length, end_stream, InvalidFrameKind(0, 0, stream_id, 1, "closed-stream", "closed_stream_rejects_later_frames")))
			false => Ok(OutboundDataRejected(stream_id, length, end_stream, FlowControlWindowExceeded(0, 0, stream_id, length, 0, "open-stream", "outbound_stream_window")))
		end
		OutboundReceiveCredit(connection_window, OutboundReceiveCreditResetStream(reset_stream_id, _)) => match stream_id == reset_stream_id
			true => Ok(OutboundDataRejected(stream_id, length, end_stream, InvalidFrameKind(0, 0, stream_id, 1, "reset-stream", "reset_stream_rejects_later_frames")))
			false => Ok(OutboundDataRejected(stream_id, length, end_stream, FlowControlWindowExceeded(0, 0, stream_id, length, 0, "open-stream", "outbound_stream_window")))
		end
	end
end

fn consume_outbound_padded_data_window(stream_id: Int, payload: ByteChunk, encoded_length: Int, padding_length: Int, end_stream: Bool, max_frame_size: Int, receive_credit: OutboundReceiveCredit) -> Result<OutboundDataDecision, String>
	match receive_credit
		OutboundReceiveCredit(connection_window, NoOutboundReceiveCreditStream) => Ok(OutboundDataRejected(stream_id, encoded_length, end_stream, FlowControlWindowExceeded(0, 0, stream_id, encoded_length, 0, "open-stream", "outbound_stream_window")))
		OutboundReceiveCredit(connection_window, OutboundReceiveCreditOpenStream(open_stream_id, stream_window)) => match encoded_length > connection_window
			true => Ok(OutboundDataRejected(stream_id, encoded_length, end_stream, FlowControlWindowExceeded(0, 0, stream_id, encoded_length, connection_window, "connection-flow-control", "outbound_connection_window")))
			false => match stream_id == open_stream_id
				false => Ok(OutboundDataRejected(stream_id, encoded_length, end_stream, FlowControlWindowExceeded(0, 0, stream_id, encoded_length, 0, "open-stream", "outbound_stream_window")))
				true => match encoded_length > stream_window
					true => Ok(OutboundDataRejected(stream_id, encoded_length, end_stream, FlowControlWindowExceeded(0, 0, stream_id, encoded_length, stream_window, "open-stream", "outbound_stream_window")))
					false => encode_padded_data_intent(stream_id, payload, encoded_length, padding_length, end_stream, max_frame_size, connection_window, stream_window)
				end
			end
		end
		OutboundReceiveCredit(connection_window, OutboundReceiveCreditClosedStream(closed_stream_id)) => match stream_id == closed_stream_id
			true => Ok(OutboundDataRejected(stream_id, encoded_length, end_stream, InvalidFrameKind(0, 0, stream_id, 1, "closed-stream", "closed_stream_rejects_later_frames")))
			false => Ok(OutboundDataRejected(stream_id, encoded_length, end_stream, FlowControlWindowExceeded(0, 0, stream_id, encoded_length, 0, "open-stream", "outbound_stream_window")))
		end
		OutboundReceiveCredit(connection_window, OutboundReceiveCreditResetStream(reset_stream_id, _)) => match stream_id == reset_stream_id
			true => Ok(OutboundDataRejected(stream_id, encoded_length, end_stream, InvalidFrameKind(0, 0, stream_id, 1, "reset-stream", "reset_stream_rejects_later_frames")))
			false => Ok(OutboundDataRejected(stream_id, encoded_length, end_stream, FlowControlWindowExceeded(0, 0, stream_id, encoded_length, 0, "open-stream", "outbound_stream_window")))
		end
	end
end

fn encode_data_intent(stream_id: Int, payload: ByteChunk, length: Int, end_stream: Bool, max_frame_size: Int, connection_window: Int, stream_window: Int) -> Result<OutboundDataDecision, String>
	match length > max_frame_size
		true => encode_split_data_intent(stream_id, payload, length, end_stream, max_frame_size, connection_window, stream_window)
		false => encode_single_data_intent(stream_id, payload, length, end_stream, connection_window, stream_window)
	end
end

fn encode_single_data_intent(stream_id: Int, payload: ByteChunk, length: Int, end_stream: Bool, connection_window: Int, stream_window: Int) -> Result<OutboundDataDecision, String>
	let encoded_header: Result<ByteChunk, EncodeError> = encode_frame_header({length: length, kind: 0, flags: data_flags(end_stream), stream_id: stream_id})
	match encoded_header
		Ok(header) => Ok(OutboundDataAccepted(stream_id, length, end_stream, data_sent_receive_credit(stream_id, end_stream, connection_window - length, stream_window - length), byte_append(header, payload)))
		Err(error) => Ok(OutboundDataEncodeFailed(stream_id, length, end_stream, error))
	end
end

fn encode_split_data_intent(stream_id: Int, payload: ByteChunk, length: Int, end_stream: Bool, max_frame_size: Int, connection_window: Int, stream_window: Int) -> Result<OutboundDataDecision, String>
	let chunk_count: ByteCount = byte_count(max_frame_size)?
	let first_payload: ByteChunk = byte_take(payload, chunk_count)?
	let remaining: ByteChunk = byte_drop(payload, chunk_count)?
	let encoded_header: Result<ByteChunk, EncodeError> = encode_frame_header({length: max_frame_size, kind: 0, flags: 0, stream_id: stream_id})
	match encoded_header
		Ok(header) => encode_remaining_data_frames(stream_id, length, end_stream, max_frame_size, connection_window, stream_window, remaining, byte_append(header, first_payload))
		Err(error) => Ok(OutboundDataEncodeFailed(stream_id, length, end_stream, error))
	end
end

fn encode_remaining_data_frames(stream_id: Int, length: Int, end_stream: Bool, max_frame_size: Int, connection_window: Int, stream_window: Int, remaining: ByteChunk, encoded: ByteChunk) -> Result<OutboundDataDecision, String>
	let remaining_length: Int = byte_count_to_int(byte_chunk_count(remaining))
	match remaining_length > max_frame_size
		true => encode_nonfinal_data_frame(stream_id, length, end_stream, max_frame_size, connection_window, stream_window, remaining, encoded)
		false => encode_final_data_frame(stream_id, length, end_stream, remaining_length, connection_window, stream_window, remaining, encoded)
	end
end

fn encode_nonfinal_data_frame(stream_id: Int, length: Int, end_stream: Bool, max_frame_size: Int, connection_window: Int, stream_window: Int, remaining: ByteChunk, encoded: ByteChunk) -> Result<OutboundDataDecision, String>
	let chunk_count: ByteCount = byte_count(max_frame_size)?
	let payload: ByteChunk = byte_take(remaining, chunk_count)?
	let next_remaining: ByteChunk = byte_drop(remaining, chunk_count)?
	let encoded_header: Result<ByteChunk, EncodeError> = encode_frame_header({length: max_frame_size, kind: 0, flags: 0, stream_id: stream_id})
	match encoded_header
		Ok(header) => encode_remaining_data_frames(stream_id, length, end_stream, max_frame_size, connection_window, stream_window, next_remaining, byte_append(byte_append(encoded, header), payload))
		Err(error) => Ok(OutboundDataEncodeFailed(stream_id, length, end_stream, error))
	end
end

fn encode_final_data_frame(stream_id: Int, length: Int, end_stream: Bool, final_length: Int, connection_window: Int, stream_window: Int, remaining: ByteChunk, encoded: ByteChunk) -> Result<OutboundDataDecision, String>
	let encoded_header: Result<ByteChunk, EncodeError> = encode_frame_header({length: final_length, kind: 0, flags: data_flags(end_stream), stream_id: stream_id})
	match encoded_header
		Ok(header) => Ok(OutboundDataAccepted(stream_id, length, end_stream, data_sent_receive_credit(stream_id, end_stream, connection_window - length, stream_window - length), byte_append(byte_append(encoded, header), remaining)))
		Err(error) => Ok(OutboundDataEncodeFailed(stream_id, length, end_stream, error))
	end
end

fn encode_padded_data_intent(stream_id: Int, payload: ByteChunk, encoded_length: Int, padding_length: Int, end_stream: Bool, max_frame_size: Int, connection_window: Int, stream_window: Int) -> Result<OutboundDataDecision, String>
	let application_length: Int = byte_count_to_int(byte_chunk_count(payload))
	let max_application_frame_payload: Int = max_padded_application_frame_payload(max_frame_size, padding_length)
	match application_length > max_application_frame_payload
		true => encode_split_padded_data_intent(stream_id, payload, encoded_length, padding_length, end_stream, max_frame_size, max_application_frame_payload, connection_window, stream_window)
		false => encode_single_padded_data_intent(stream_id, payload, encoded_length, padding_length, end_stream, application_length + padding_length + 1, connection_window, stream_window)
	end
end

fn encode_single_padded_data_intent(stream_id: Int, payload: ByteChunk, encoded_length: Int, padding_length: Int, end_stream: Bool, frame_payload_length: Int, connection_window: Int, stream_window: Int) -> Result<OutboundDataDecision, String>
	let encoded_header: Result<ByteChunk, EncodeError> = encode_frame_header({length: frame_payload_length, kind: 0, flags: padded_data_flags(end_stream), stream_id: stream_id})
	match encoded_header
		Ok(header) => encode_single_padded_data_payload(stream_id, payload, encoded_length, padding_length, end_stream, connection_window, stream_window, header)
		Err(error) => Ok(OutboundDataEncodeFailed(stream_id, encoded_length, end_stream, error))
	end
end

fn encode_single_padded_data_payload(stream_id: Int, payload: ByteChunk, encoded_length: Int, padding_length: Int, end_stream: Bool, connection_window: Int, stream_window: Int, header: ByteChunk) -> Result<OutboundDataDecision, String>
	Ok(OutboundDataAccepted(stream_id, encoded_length, end_stream, data_sent_receive_credit(stream_id, end_stream, connection_window - encoded_length, stream_window - encoded_length), byte_append(header, padded_data_payload(padding_length, payload)?)))
end

fn encode_split_padded_data_intent(stream_id: Int, payload: ByteChunk, encoded_length: Int, padding_length: Int, end_stream: Bool, max_frame_size: Int, max_application_frame_payload: Int, connection_window: Int, stream_window: Int) -> Result<OutboundDataDecision, String>
	let chunk_count: ByteCount = byte_count(max_application_frame_payload)?
	let first_payload: ByteChunk = byte_take(payload, chunk_count)?
	let remaining: ByteChunk = byte_drop(payload, chunk_count)?
	let encoded_header: Result<ByteChunk, EncodeError> = encode_frame_header({length: max_frame_size, kind: 0, flags: 8, stream_id: stream_id})
	match encoded_header
		Ok(header) => encode_remaining_padded_data_frames(stream_id, encoded_length, padding_length, end_stream, max_frame_size, max_application_frame_payload, connection_window, stream_window, remaining, byte_append(header, padded_data_payload(padding_length, first_payload)?))
		Err(error) => Ok(OutboundDataEncodeFailed(stream_id, encoded_length, end_stream, error))
	end
end

fn encode_remaining_padded_data_frames(stream_id: Int, encoded_length: Int, padding_length: Int, end_stream: Bool, max_frame_size: Int, max_application_frame_payload: Int, connection_window: Int, stream_window: Int, remaining: ByteChunk, encoded: ByteChunk) -> Result<OutboundDataDecision, String>
	let remaining_length: Int = byte_count_to_int(byte_chunk_count(remaining))
	match remaining_length > max_application_frame_payload
		true => encode_nonfinal_padded_data_frame(stream_id, encoded_length, padding_length, end_stream, max_frame_size, max_application_frame_payload, connection_window, stream_window, remaining, encoded)
		false => encode_final_padded_data_frame(stream_id, encoded_length, padding_length, end_stream, remaining_length, connection_window, stream_window, remaining, encoded)
	end
end

fn encode_nonfinal_padded_data_frame(stream_id: Int, encoded_length: Int, padding_length: Int, end_stream: Bool, max_frame_size: Int, max_application_frame_payload: Int, connection_window: Int, stream_window: Int, remaining: ByteChunk, encoded: ByteChunk) -> Result<OutboundDataDecision, String>
	let chunk_count: ByteCount = byte_count(max_application_frame_payload)?
	let payload: ByteChunk = byte_take(remaining, chunk_count)?
	let next_remaining: ByteChunk = byte_drop(remaining, chunk_count)?
	let encoded_header: Result<ByteChunk, EncodeError> = encode_frame_header({length: max_frame_size, kind: 0, flags: 8, stream_id: stream_id})
	match encoded_header
		Ok(header) => encode_remaining_padded_data_frames(stream_id, encoded_length, padding_length, end_stream, max_frame_size, max_application_frame_payload, connection_window, stream_window, next_remaining, byte_append(byte_append(encoded, header), padded_data_payload(padding_length, payload)?))
		Err(error) => Ok(OutboundDataEncodeFailed(stream_id, encoded_length, end_stream, error))
	end
end

fn encode_final_padded_data_frame(stream_id: Int, encoded_length: Int, padding_length: Int, end_stream: Bool, final_application_length: Int, connection_window: Int, stream_window: Int, remaining: ByteChunk, encoded: ByteChunk) -> Result<OutboundDataDecision, String>
	let encoded_header: Result<ByteChunk, EncodeError> = encode_frame_header({length: final_application_length + padding_length + 1, kind: 0, flags: padded_data_flags(end_stream), stream_id: stream_id})
	match encoded_header
		Ok(header) => Ok(OutboundDataAccepted(stream_id, encoded_length, end_stream, data_sent_receive_credit(stream_id, end_stream, connection_window - encoded_length, stream_window - encoded_length), byte_append(byte_append(encoded, header), padded_data_payload(padding_length, remaining)?)))
		Err(error) => Ok(OutboundDataEncodeFailed(stream_id, encoded_length, end_stream, error))
	end
end

fn padded_data_payload(padding_length: Int, application_payload: ByteChunk) -> Result<ByteChunk, String>
	Ok(byte_append(byte_write_u8_be(padding_length)?, byte_append(application_payload, zero_padding_bytes(padding_length)?)))
end

fn zero_padding_bytes(length: Int) -> Result<ByteChunk, String>
	match length == 0
		true => Ok(byte_chunk([]))
		false => Ok(byte_append(byte_write_u8_be(0)?, zero_padding_bytes(length - 1)?))
	end
end

fn data_flags(end_stream: Bool) -> Int
	match end_stream
		true => 1
		false => 0
	end
end

fn padded_data_flags(end_stream: Bool) -> Int
	data_flags(end_stream) + 8
end

fn data_sent_receive_credit(stream_id: Int, end_stream: Bool, connection_window: Int, stream_window: Int) -> OutboundReceiveCredit
	match end_stream
		true => OutboundReceiveCredit(connection_window, OutboundReceiveCreditClosedStream(stream_id))
		false => OutboundReceiveCredit(connection_window, OutboundReceiveCreditOpenStream(stream_id, stream_window))
	end
end

fn send_connection_window_update(increment: Int, receive_credit: OutboundReceiveCredit) -> Result<OutboundWindowUpdateDecision, String>
	match validate_outbound_window_update_increment(0, increment, "connection-flow-control")
		OutboundWindowUpdateIncrementOk => validate_connection_window_update_bound(increment, receive_credit)
		OutboundWindowUpdateIncrementFailed(error) => Ok(OutboundWindowUpdateRejected(error))
	end
end

fn send_stream_window_update(stream_id: Int, increment: Int, receive_credit: OutboundReceiveCredit) -> Result<OutboundWindowUpdateDecision, String>
	match stream_id == 0
		true => Ok(OutboundWindowUpdateRejected(InvalidStreamId(0, 8, stream_id, "nonzero open stream id", "local", "stream-id-domain", "outbound_window_update_requires_open_stream")))
		false => match validate_outbound_window_update_increment(stream_id, increment, "open-stream")
			OutboundWindowUpdateIncrementOk => send_valid_stream_window_update(stream_id, increment, receive_credit)
			OutboundWindowUpdateIncrementFailed(error) => Ok(OutboundWindowUpdateRejected(error))
		end
	end
end

fn validate_connection_window_update_bound(increment: Int, receive_credit: OutboundReceiveCredit) -> Result<OutboundWindowUpdateDecision, String>
	match receive_credit
		OutboundReceiveCredit(connection_window, stream_credit) => match connection_window + increment > max_receive_flow_control_window()
			true => Ok(OutboundWindowUpdateRejected(FlowControlWindowExceeded(0, 8, 0, increment, max_receive_flow_control_window() - connection_window, "connection-flow-control", "outbound_connection_receive_window")))
			false => encode_window_update_intent(0, increment, OutboundReceiveCredit(connection_window + increment, stream_credit))
		end
	end
end

fn send_valid_stream_window_update(stream_id: Int, increment: Int, receive_credit: OutboundReceiveCredit) -> Result<OutboundWindowUpdateDecision, String>
	match receive_credit
		OutboundReceiveCredit(connection_window, NoOutboundReceiveCreditStream) => Ok(OutboundWindowUpdateRejected(InvalidFrameKind(0, 8, stream_id, 1, "idle-stream", "idle_streams_require_headers")))
		OutboundReceiveCredit(connection_window, OutboundReceiveCreditOpenStream(open_stream_id, stream_window)) => match stream_id == open_stream_id
			true => validate_stream_window_update_bound(stream_id, increment, connection_window, open_stream_id, stream_window)
			false => Ok(OutboundWindowUpdateRejected(InvalidFrameKind(0, 8, stream_id, 1, "idle-stream", "idle_streams_require_headers")))
		end
		OutboundReceiveCredit(connection_window, OutboundReceiveCreditClosedStream(closed_stream_id)) => match stream_id == closed_stream_id
			true => Ok(OutboundWindowUpdateRejected(InvalidFrameKind(0, 8, stream_id, 1, "closed-stream", "closed_stream_rejects_later_frames")))
			false => Ok(OutboundWindowUpdateRejected(InvalidFrameKind(0, 8, stream_id, 1, "idle-stream", "idle_streams_require_headers")))
		end
		OutboundReceiveCredit(connection_window, OutboundReceiveCreditResetStream(reset_stream_id, _)) => match stream_id == reset_stream_id
			true => Ok(OutboundWindowUpdateRejected(InvalidFrameKind(0, 8, stream_id, 1, "reset-stream", "reset_stream_rejects_later_frames")))
			false => Ok(OutboundWindowUpdateRejected(InvalidFrameKind(0, 8, stream_id, 1, "idle-stream", "idle_streams_require_headers")))
		end
	end
end

fn validate_stream_window_update_bound(stream_id: Int, increment: Int, connection_window: Int, open_stream_id: Int, stream_window: Int) -> Result<OutboundWindowUpdateDecision, String>
	match stream_window + increment > max_receive_flow_control_window()
		true => Ok(OutboundWindowUpdateRejected(FlowControlWindowExceeded(0, 8, stream_id, increment, max_receive_flow_control_window() - stream_window, "open-stream", "outbound_stream_receive_window")))
		false => encode_window_update_intent(stream_id, increment, OutboundReceiveCredit(connection_window, OutboundReceiveCreditOpenStream(open_stream_id, stream_window + increment)))
	end
end

fn validate_outbound_window_update_increment(stream_id: Int, increment: Int, active_state: String) -> OutboundWindowUpdateIncrementDecision
	match increment == 0
		true => OutboundWindowUpdateIncrementFailed(FlowControlWindowExceeded(0, 8, stream_id, increment, 1, active_state, "window_update_increment_nonzero"))
		false => match increment < 0
			true => OutboundWindowUpdateIncrementFailed(FlowControlWindowExceeded(0, 8, stream_id, increment, 1, active_state, "window_update_increment_range"))
			false => match increment > max_receive_flow_control_window()
				true => OutboundWindowUpdateIncrementFailed(FlowControlWindowExceeded(0, 8, stream_id, increment, max_receive_flow_control_window(), active_state, "window_update_increment_range"))
				false => OutboundWindowUpdateIncrementOk
			end
		end
	end
end

fn encode_window_update_intent(stream_id: Int, increment: Int, receive_credit: OutboundReceiveCredit) -> Result<OutboundWindowUpdateDecision, String>
	let encoded_header: Result<ByteChunk, EncodeError> = encode_frame_header({length: 4, kind: 8, flags: 0, stream_id: stream_id})
	match encoded_header
		Ok(header) => encode_window_update_payload_intent(stream_id, increment, receive_credit, header)
		Err(error) => Ok(OutboundWindowUpdateEncodeFailed(error))
	end
end

fn encode_window_update_payload_intent(stream_id: Int, increment: Int, receive_credit: OutboundReceiveCredit, header: ByteChunk) -> Result<OutboundWindowUpdateDecision, String>
	let encoded_payload: Result<ByteChunk, EncodeError> = encode_window_update_payload({increment: increment})
	match encoded_payload
		Ok(payload) => Ok(OutboundWindowUpdateAccepted(stream_id, increment, receive_credit, byte_append(header, payload)))
		Err(error) => Ok(OutboundWindowUpdateEncodeFailed(error))
	end
end

fn apply_initial_window_delta(delta: Int, receive_flow_control: ReceiveFlowControl) -> ReceiveFlowControl
	match receive_flow_control
		ReceiveFlowControl(connection_window, NoOpenStreamReceiveWindow) => ReceiveFlowControl(connection_window, NoOpenStreamReceiveWindow)
		ReceiveFlowControl(connection_window, OpenStreamReceiveWindow(stream_id, stream_window, priority)) => ReceiveFlowControl(connection_window, OpenStreamReceiveWindow(stream_id, stream_window + delta, priority))
		ReceiveFlowControl(connection_window, HalfClosedLocalStreamReceiveWindow(stream_id, stream_window, priority)) => ReceiveFlowControl(connection_window, HalfClosedLocalStreamReceiveWindow(stream_id, stream_window + delta, priority))
		ReceiveFlowControl(connection_window, ClosedByPeerStreamReceiveWindow(stream_id, stream_window)) => ReceiveFlowControl(connection_window, ClosedByPeerStreamReceiveWindow(stream_id, stream_window))
		ReceiveFlowControl(connection_window, ResetStreamReceiveWindow(stream_id, error_code)) => ReceiveFlowControl(connection_window, ResetStreamReceiveWindow(stream_id, error_code))
	end
end

fn record_local_end_stream(state: Http2DecodeState, stream_id: Int) -> Http2DecodeState
	match state
		State(pending, next_offset, preface_state, continuation, hpack_state, receive_limit, peer_settings, shutdown_state, ReceiveFlowControl(connection_window, OpenStreamReceiveWindow(open_stream_id, stream_window, priority))) => match stream_id == open_stream_id
			true => State(pending, next_offset, preface_state, continuation, hpack_state, receive_limit, peer_settings, shutdown_state, ReceiveFlowControl(connection_window, HalfClosedLocalStreamReceiveWindow(open_stream_id, stream_window, priority)))
			false => state
		end
		State(_, _, _, _, _, _, _, _, _) => state
	end
end

fn update_shutdown_state(pending: ByteChunk, length: Int, kind: Int, shutdown_state: ConnectionShutdownState) -> Result<ConnectionShutdownState, String>
	match kind == 7
		true => match length == 8
			true => decode_goaway_state(pending)
			false => Ok(shutdown_state)
		end
		false => Ok(shutdown_state)
	end
end

fn decode_goaway_state(pending: ByteChunk) -> Result<ConnectionShutdownState, String>
	let last_stream_offset: ByteOffset = byte_offset(9)?
	let error_code_offset: ByteOffset = byte_offset(13)?
	let field_count: ByteCount = byte_count(4)?
	let last_stream_view: ByteView = byte_view(pending, last_stream_offset, field_count)?
	let error_code_view: ByteView = byte_view(pending, error_code_offset, field_count)?
	let last_stream_id: Int = byte_read_u31_be(last_stream_view)?
	let error_code: Int = byte_read_u32_be(error_code_view)?
	Ok(GracefulShutdown(last_stream_id, error_code))
end

fn validate_continuation(continuation: PendingContinuation, offset: Int, payload: ByteChunk, kind: Int, flags: Int, stream_id: Int, receive_flow_control: ReceiveFlowControl) -> Result<ContinuationDecision, Http2ProtocolFailure>
	match continuation
		NoContinuation => validate_without_continuation(offset, payload, kind, flags, stream_id, receive_flow_control)
		Continuation(expected_stream, started_kind, started_offset, started_flags, accumulated) => validate_with_continuation(expected_stream, started_kind, started_offset, started_flags, accumulated, offset, payload, kind, flags, stream_id)
	end
end

fn validate_without_continuation(offset: Int, payload: ByteChunk, kind: Int, flags: Int, stream_id: Int, receive_flow_control: ReceiveFlowControl) -> Result<ContinuationDecision, Http2ProtocolFailure>
	match kind == 1
		true => match end_headers_set(flags)
			true => Ok(Decision(NoContinuation, payload, data_end_stream_set(flags)))
			false => Ok(Decision(Continuation(stream_id, kind, offset, flags, payload), empty_header_block(), false))
		end
		false => validate_connection_frame_kind(offset, kind, stream_id, receive_flow_control)
	end
end

fn end_headers_set(flags: Int) -> Bool
	let low_three_bits: Int = flags - (flags / 8) * 8
	match low_three_bits < 4
		true => false
		false => true
	end
end

fn data_end_stream_set(flags: Int) -> Bool
	(flags / 2) * 2 != flags
end

fn data_padded_set(flags: Int) -> Bool
	let low_four_bits: Int = flags - (flags / 16) * 16
	low_four_bits >= 8
end

fn empty_header_block() -> ByteChunk
	byte_chunk([])
end

fn validate_connection_frame_kind(offset: Int, kind: Int, stream_id: Int, receive_flow_control: ReceiveFlowControl) -> Result<ContinuationDecision, Http2ProtocolFailure>
	match stream_id == 0
		true => match kind == 4
			true => Ok(Decision(NoContinuation, empty_header_block(), false))
			false => match kind == 6
				true => Ok(Decision(NoContinuation, empty_header_block(), false))
				false => match kind == 7
					true => Ok(Decision(NoContinuation, empty_header_block(), false))
					false => match kind == 8
						true => Ok(Decision(NoContinuation, empty_header_block(), false))
						false => match is_unknown_frame_kind(kind)
							true => Ok(Decision(NoContinuation, empty_header_block(), false))
							false => Err(InvalidFrameKind(offset, kind, stream_id, 4, "connection-control", "connection_frames_require_settings"))
						end
					end
				end
			end
		end
		false => validate_stream_frame_kind(offset, kind, stream_id, receive_flow_control)
	end
end

fn validate_stream_frame_kind(offset: Int, kind: Int, stream_id: Int, receive_flow_control: ReceiveFlowControl) -> Result<ContinuationDecision, Http2ProtocolFailure>
	match kind == 1
		true => Ok(Decision(NoContinuation, empty_header_block(), false))
		false => match kind == 0
			true => validate_data_stream_state(offset, kind, stream_id, receive_flow_control)
			false => match kind == 3
				true => validate_data_stream_state(offset, kind, stream_id, receive_flow_control)
				false => match kind == 8
					true => validate_data_stream_state(offset, kind, stream_id, receive_flow_control)
					false => match kind == 2
						true => validate_data_stream_state(offset, kind, stream_id, receive_flow_control)
						false => match kind == 5
							true => Err(InvalidFrameKind(offset, kind, stream_id, 1, "server-receive", "server_receives_no_push_promise"))
							false => match is_unknown_frame_kind(kind)
								true => validate_unknown_stream_state(offset, kind, stream_id, receive_flow_control)
								false => Err(InvalidFrameKind(offset, kind, stream_id, 1, "idle-stream", "idle_streams_require_headers"))
							end
						end
					end
				end
			end
		end
	end
end

fn validate_unknown_stream_state(offset: Int, kind: Int, stream_id: Int, receive_flow_control: ReceiveFlowControl) -> Result<ContinuationDecision, Http2ProtocolFailure>
	match receive_flow_control
		ReceiveFlowControl(_, NoOpenStreamReceiveWindow) => Err(InvalidFrameKind(offset, kind, stream_id, 1, "idle-stream", "idle_streams_require_headers"))
		ReceiveFlowControl(_, OpenStreamReceiveWindow(open_stream_id, _, _)) => match stream_id == open_stream_id
			true => Ok(Decision(NoContinuation, empty_header_block(), false))
			false => Err(InvalidFrameKind(offset, kind, stream_id, 1, "idle-stream", "idle_streams_require_headers"))
		end
		ReceiveFlowControl(_, HalfClosedLocalStreamReceiveWindow(open_stream_id, _, _)) => match stream_id == open_stream_id
			true => Ok(Decision(NoContinuation, empty_header_block(), false))
			false => Err(InvalidFrameKind(offset, kind, stream_id, 1, "idle-stream", "idle_streams_require_headers"))
		end
		ReceiveFlowControl(_, ClosedByPeerStreamReceiveWindow(closed_stream_id, _)) => match stream_id == closed_stream_id
			true => Err(InvalidFrameKind(offset, kind, stream_id, 1, "closed-by-peer-stream", "closed_by_peer_rejects_later_frames"))
			false => Err(InvalidFrameKind(offset, kind, stream_id, 1, "idle-stream", "idle_streams_require_headers"))
		end
		ReceiveFlowControl(_, ResetStreamReceiveWindow(reset_stream_id, _)) => match stream_id == reset_stream_id
			true => Err(InvalidFrameKind(offset, kind, stream_id, 1, "reset-stream", "reset_stream_rejects_later_frames"))
			false => Err(InvalidFrameKind(offset, kind, stream_id, 1, "idle-stream", "idle_streams_require_headers"))
		end
	end
end

fn validate_data_stream_state(offset: Int, kind: Int, stream_id: Int, receive_flow_control: ReceiveFlowControl) -> Result<ContinuationDecision, Http2ProtocolFailure>
	match receive_flow_control
		ReceiveFlowControl(_, NoOpenStreamReceiveWindow) => Err(InvalidFrameKind(offset, kind, stream_id, 1, "idle-stream", "idle_streams_require_headers"))
		ReceiveFlowControl(_, OpenStreamReceiveWindow(open_stream_id, _, _)) => match stream_id == open_stream_id
			true => Ok(Decision(NoContinuation, empty_header_block(), false))
			false => Err(InvalidFrameKind(offset, kind, stream_id, 1, "idle-stream", "idle_streams_require_headers"))
		end
		ReceiveFlowControl(_, HalfClosedLocalStreamReceiveWindow(open_stream_id, _, _)) => match stream_id == open_stream_id
			true => Ok(Decision(NoContinuation, empty_header_block(), false))
			false => Err(InvalidFrameKind(offset, kind, stream_id, 1, "idle-stream", "idle_streams_require_headers"))
		end
		ReceiveFlowControl(_, ClosedByPeerStreamReceiveWindow(closed_stream_id, _)) => match stream_id == closed_stream_id
			true => Err(InvalidFrameKind(offset, kind, stream_id, 1, "closed-by-peer-stream", "closed_by_peer_rejects_later_frames"))
			false => Err(InvalidFrameKind(offset, kind, stream_id, 1, "idle-stream", "idle_streams_require_headers"))
		end
		ReceiveFlowControl(_, ResetStreamReceiveWindow(reset_stream_id, _)) => match stream_id == reset_stream_id
			true => Err(InvalidFrameKind(offset, kind, stream_id, 1, "reset-stream", "reset_stream_rejects_later_frames"))
			false => Err(InvalidFrameKind(offset, kind, stream_id, 1, "idle-stream", "idle_streams_require_headers"))
		end
	end
end

fn validate_with_continuation(expected_stream: Int, started_kind: Int, started_offset: Int, started_flags: Int, accumulated: ByteChunk, offset: Int, payload: ByteChunk, kind: Int, flags: Int, stream_id: Int) -> Result<ContinuationDecision, Http2ProtocolFailure>
	match kind == 9
		true => validate_continuation_stream(expected_stream, started_kind, started_offset, started_flags, accumulated, offset, payload, kind, flags, stream_id)
		false => Err(ContinuationExpected(offset, kind, stream_id, expected_stream, started_kind, started_offset))
	end
end

fn validate_continuation_stream(expected_stream: Int, started_kind: Int, started_offset: Int, started_flags: Int, accumulated: ByteChunk, offset: Int, payload: ByteChunk, kind: Int, flags: Int, stream_id: Int) -> Result<ContinuationDecision, Http2ProtocolFailure>
	match stream_id == expected_stream
		true => match end_headers_set(flags)
			true => Ok(Decision(NoContinuation, byte_append(accumulated, payload), data_end_stream_set(started_flags)))
			false => Ok(Decision(Continuation(expected_stream, started_kind, started_offset, started_flags, byte_append(accumulated, payload)), empty_header_block(), false))
		end
		false => Err(ContinuationExpected(offset, kind, stream_id, expected_stream, started_kind, started_offset))
	end
end

fn update_receive_flow_control(pending: ByteChunk, offset: Int, length: Int, kind: Int, flags: Int, stream_id: Int, completed_end_stream: Bool, shutdown_state: ConnectionShutdownState, receive_flow_control: ReceiveFlowControl) -> Result<ReceiveFlowControlDecision, String>
	match kind == 1
		true => Ok(open_receive_stream(offset, stream_id, completed_end_stream, shutdown_state, receive_flow_control))
		false => match kind == 0
			true => Ok(consume_data_receive_window(offset, stream_id, length, data_end_stream_set(flags), receive_flow_control))
			false => match kind == 3
				true => reset_receive_stream(pending, offset, stream_id, receive_flow_control)
				false => match kind == 8
					true => update_window_receive_credit(pending, offset, stream_id, receive_flow_control)
					false => match kind == 9
						true => Ok(complete_continuation_receive_stream(offset, stream_id, completed_end_stream, receive_flow_control))
						false => match kind == 2
							true => update_priority_receive_state(pending, offset, length, stream_id, receive_flow_control)
							false => Ok(ReceiveFlowControlOk(receive_flow_control))
						end
					end
				end
			end
		end
	end
end

fn open_receive_stream(offset: Int, stream_id: Int, end_stream: Bool, shutdown_state: ConnectionShutdownState, receive_flow_control: ReceiveFlowControl) -> ReceiveFlowControlDecision
	match receive_flow_control
		ReceiveFlowControl(connection_window, NoOpenStreamReceiveWindow) => match validate_new_stream_after_goaway(offset, stream_id, shutdown_state)
			ReceiveFlowControlOk(_) => ReceiveFlowControlOk(ReceiveFlowControl(connection_window, initial_receive_stream_window(stream_id, end_stream)))
			ReceiveFlowControlFailed(error) => ReceiveFlowControlFailed(error)
		end
		ReceiveFlowControl(connection_window, OpenStreamReceiveWindow(open_stream_id, stream_window, priority)) => match stream_id == open_stream_id
			true => ReceiveFlowControlOk(ReceiveFlowControl(connection_window, receive_stream_window_after_headers(open_stream_id, stream_window, priority, end_stream)))
			false => match validate_new_stream_after_goaway(offset, stream_id, shutdown_state)
				ReceiveFlowControlOk(_) => ReceiveFlowControlFailed(ConcurrentStreamsExceeded(offset, stream_id, 2, concurrent_stream_receive_limit(), "open-stream", concurrent_stream_receive_limit_provenance(), "peer_created_stream_receive_limit"))
				ReceiveFlowControlFailed(error) => ReceiveFlowControlFailed(error)
			end
		end
		ReceiveFlowControl(_, HalfClosedLocalStreamReceiveWindow(open_stream_id, _, _)) => match stream_id == open_stream_id
			true => ReceiveFlowControlFailed(InvalidFrameKind(offset, 1, stream_id, 1, "half-closed-local-stream", "half_closed_local_data_only"))
			false => match validate_new_stream_after_goaway(offset, stream_id, shutdown_state)
				ReceiveFlowControlOk(_) => ReceiveFlowControlFailed(ConcurrentStreamsExceeded(offset, stream_id, 2, concurrent_stream_receive_limit(), "open-stream", concurrent_stream_receive_limit_provenance(), "peer_created_stream_receive_limit"))
				ReceiveFlowControlFailed(error) => ReceiveFlowControlFailed(error)
			end
		end
		ReceiveFlowControl(_, ClosedByPeerStreamReceiveWindow(closed_stream_id, _)) => match stream_id == closed_stream_id
			true => ReceiveFlowControlFailed(InvalidFrameKind(offset, 1, stream_id, 1, "closed-by-peer-stream", "closed_by_peer_rejects_later_frames"))
			false => match validate_new_stream_after_goaway(offset, stream_id, shutdown_state)
				ReceiveFlowControlOk(_) => ReceiveFlowControlFailed(ConcurrentStreamsExceeded(offset, stream_id, 2, concurrent_stream_receive_limit(), "open-stream", concurrent_stream_receive_limit_provenance(), "peer_created_stream_receive_limit"))
				ReceiveFlowControlFailed(error) => ReceiveFlowControlFailed(error)
			end
		end
		ReceiveFlowControl(_, ResetStreamReceiveWindow(reset_stream_id, _)) => match stream_id == reset_stream_id
			true => ReceiveFlowControlFailed(InvalidFrameKind(offset, 1, stream_id, 1, "reset-stream", "reset_stream_rejects_later_frames"))
			false => match validate_new_stream_after_goaway(offset, stream_id, shutdown_state)
				ReceiveFlowControlOk(_) => ReceiveFlowControlFailed(ConcurrentStreamsExceeded(offset, stream_id, 2, concurrent_stream_receive_limit(), "open-stream", concurrent_stream_receive_limit_provenance(), "peer_created_stream_receive_limit"))
				ReceiveFlowControlFailed(error) => ReceiveFlowControlFailed(error)
			end
		end
	end
end

fn initial_receive_stream_window(stream_id: Int, end_stream: Bool) -> OpenStreamReceiveWindow
	receive_stream_window_after_headers(stream_id, 65535, NoStreamPriority, end_stream)
end

fn receive_stream_window_after_headers(stream_id: Int, stream_window: Int, priority: StreamPriorityState, end_stream: Bool) -> OpenStreamReceiveWindow
	match end_stream
		true => ClosedByPeerStreamReceiveWindow(stream_id, stream_window)
		false => OpenStreamReceiveWindow(stream_id, stream_window, priority)
	end
end

fn complete_continuation_receive_stream(offset: Int, stream_id: Int, end_stream: Bool, receive_flow_control: ReceiveFlowControl) -> ReceiveFlowControlDecision
	match end_stream
		false => ReceiveFlowControlOk(receive_flow_control)
		true => close_continuation_receive_stream(offset, stream_id, receive_flow_control)
	end
end

fn close_continuation_receive_stream(offset: Int, stream_id: Int, receive_flow_control: ReceiveFlowControl) -> ReceiveFlowControlDecision
	match receive_flow_control
		ReceiveFlowControl(connection_window, NoOpenStreamReceiveWindow) => ReceiveFlowControlFailed(InvalidFrameKind(offset, 9, stream_id, 1, "idle-stream", "idle_streams_require_headers"))
		ReceiveFlowControl(connection_window, OpenStreamReceiveWindow(open_stream_id, stream_window, _)) => match stream_id == open_stream_id
			true => ReceiveFlowControlOk(ReceiveFlowControl(connection_window, ClosedByPeerStreamReceiveWindow(open_stream_id, stream_window)))
			false => ReceiveFlowControlFailed(InvalidFrameKind(offset, 9, stream_id, 1, "idle-stream", "idle_streams_require_headers"))
		end
		ReceiveFlowControl(connection_window, HalfClosedLocalStreamReceiveWindow(open_stream_id, stream_window, _)) => match stream_id == open_stream_id
			true => ReceiveFlowControlOk(ReceiveFlowControl(connection_window, ClosedByPeerStreamReceiveWindow(open_stream_id, stream_window)))
			false => ReceiveFlowControlFailed(InvalidFrameKind(offset, 9, stream_id, 1, "idle-stream", "idle_streams_require_headers"))
		end
		ReceiveFlowControl(_, ClosedByPeerStreamReceiveWindow(closed_stream_id, _)) => match stream_id == closed_stream_id
			true => ReceiveFlowControlFailed(InvalidFrameKind(offset, 9, stream_id, 1, "closed-by-peer-stream", "closed_by_peer_rejects_later_frames"))
			false => ReceiveFlowControlFailed(InvalidFrameKind(offset, 9, stream_id, 1, "idle-stream", "idle_streams_require_headers"))
		end
		ReceiveFlowControl(_, ResetStreamReceiveWindow(reset_stream_id, _)) => match stream_id == reset_stream_id
			true => ReceiveFlowControlFailed(InvalidFrameKind(offset, 9, stream_id, 1, "reset-stream", "reset_stream_rejects_later_frames"))
			false => ReceiveFlowControlFailed(InvalidFrameKind(offset, 9, stream_id, 1, "idle-stream", "idle_streams_require_headers"))
		end
	end
end

fn validate_new_stream_after_goaway(offset: Int, stream_id: Int, shutdown_state: ConnectionShutdownState) -> ReceiveFlowControlDecision
	match shutdown_state
		OpenConnection => ReceiveFlowControlOk(default_receive_flow_control())
		GracefulShutdown(last_stream_id, _) => match stream_id > last_stream_id
			true => ReceiveFlowControlFailed(StreamAfterGoaway(offset, stream_id, last_stream_id, "graceful_shutdown", "server", "goaway_last_stream_id"))
			false => ReceiveFlowControlOk(default_receive_flow_control())
		end
	end
end

fn consume_data_receive_window(offset: Int, stream_id: Int, length: Int, end_stream: Bool, receive_flow_control: ReceiveFlowControl) -> ReceiveFlowControlDecision
	match receive_flow_control
		ReceiveFlowControl(connection_window, NoOpenStreamReceiveWindow) => ReceiveFlowControlFailed(InvalidFrameKind(offset, 0, stream_id, 1, "idle-stream", "idle_streams_require_headers"))
		ReceiveFlowControl(connection_window, OpenStreamReceiveWindow(open_stream_id, stream_window, priority)) => match length > connection_window
			true => ReceiveFlowControlFailed(FlowControlWindowExceeded(offset, 0, stream_id, length, connection_window, "connection-flow-control", "connection_receive_window"))
			false => match length > stream_window
				true => ReceiveFlowControlFailed(FlowControlWindowExceeded(offset, 0, stream_id, length, stream_window, "open-stream", "stream_receive_window"))
				false => match end_stream
					true => ReceiveFlowControlOk(ReceiveFlowControl(connection_window - length, ClosedByPeerStreamReceiveWindow(open_stream_id, stream_window - length)))
					false => ReceiveFlowControlOk(ReceiveFlowControl(connection_window - length, OpenStreamReceiveWindow(open_stream_id, stream_window - length, priority)))
				end
			end
		end
		ReceiveFlowControl(connection_window, HalfClosedLocalStreamReceiveWindow(open_stream_id, stream_window, priority)) => match length > connection_window
			true => ReceiveFlowControlFailed(FlowControlWindowExceeded(offset, 0, stream_id, length, connection_window, "connection-flow-control", "connection_receive_window"))
			false => match length > stream_window
				true => ReceiveFlowControlFailed(FlowControlWindowExceeded(offset, 0, stream_id, length, stream_window, "half-closed-local-stream", "stream_receive_window"))
				false => match end_stream
					true => ReceiveFlowControlOk(ReceiveFlowControl(connection_window - length, ClosedByPeerStreamReceiveWindow(open_stream_id, stream_window - length)))
					false => ReceiveFlowControlOk(ReceiveFlowControl(connection_window - length, HalfClosedLocalStreamReceiveWindow(open_stream_id, stream_window - length, priority)))
				end
			end
		end
		ReceiveFlowControl(_, ClosedByPeerStreamReceiveWindow(closed_stream_id, _)) => match stream_id == closed_stream_id
			true => ReceiveFlowControlFailed(InvalidFrameKind(offset, 0, stream_id, 1, "closed-by-peer-stream", "closed_by_peer_rejects_later_frames"))
			false => ReceiveFlowControlFailed(InvalidFrameKind(offset, 0, stream_id, 1, "idle-stream", "idle_streams_require_headers"))
		end
		ReceiveFlowControl(_, ResetStreamReceiveWindow(reset_stream_id, _)) => match stream_id == reset_stream_id
			true => ReceiveFlowControlFailed(InvalidFrameKind(offset, 0, stream_id, 1, "reset-stream", "reset_stream_rejects_later_frames"))
			false => ReceiveFlowControlFailed(InvalidFrameKind(offset, 0, stream_id, 1, "idle-stream", "idle_streams_require_headers"))
		end
	end
end

fn reset_receive_stream(pending: ByteChunk, offset: Int, stream_id: Int, receive_flow_control: ReceiveFlowControl) -> Result<ReceiveFlowControlDecision, String>
	let error_code: Int = rst_stream_error_code(pending)?
	match receive_flow_control
		ReceiveFlowControl(connection_window, NoOpenStreamReceiveWindow) => Ok(ReceiveFlowControlFailed(InvalidFrameKind(offset, 3, stream_id, 1, "idle-stream", "idle_streams_require_headers")))
		ReceiveFlowControl(connection_window, OpenStreamReceiveWindow(open_stream_id, _, _)) => match stream_id == open_stream_id
			true => Ok(ReceiveFlowControlOk(ReceiveFlowControl(connection_window, ResetStreamReceiveWindow(stream_id, error_code))))
			false => Ok(ReceiveFlowControlFailed(InvalidFrameKind(offset, 3, stream_id, 1, "idle-stream", "idle_streams_require_headers")))
		end
		ReceiveFlowControl(connection_window, HalfClosedLocalStreamReceiveWindow(open_stream_id, _, _)) => match stream_id == open_stream_id
			true => Ok(ReceiveFlowControlOk(ReceiveFlowControl(connection_window, ResetStreamReceiveWindow(stream_id, error_code))))
			false => Ok(ReceiveFlowControlFailed(InvalidFrameKind(offset, 3, stream_id, 1, "idle-stream", "idle_streams_require_headers")))
		end
		ReceiveFlowControl(connection_window, ClosedByPeerStreamReceiveWindow(closed_stream_id, _)) => match stream_id == closed_stream_id
			true => Ok(ReceiveFlowControlFailed(InvalidFrameKind(offset, 3, stream_id, 1, "closed-by-peer-stream", "closed_by_peer_rejects_later_frames")))
			false => Ok(ReceiveFlowControlFailed(InvalidFrameKind(offset, 3, stream_id, 1, "idle-stream", "idle_streams_require_headers")))
		end
		ReceiveFlowControl(connection_window, ResetStreamReceiveWindow(reset_stream_id, _)) => match stream_id == reset_stream_id
			true => Ok(ReceiveFlowControlFailed(InvalidFrameKind(offset, 3, stream_id, 1, "reset-stream", "reset_stream_rejects_later_frames")))
			false => Ok(ReceiveFlowControlFailed(InvalidFrameKind(offset, 3, stream_id, 1, "idle-stream", "idle_streams_require_headers")))
		end
	end
end

fn rst_stream_error_code(pending: ByteChunk) -> Result<Int, String>
	let payload_offset: ByteOffset = byte_offset(9)?
	let payload_count: ByteCount = byte_count(4)?
	let payload: ByteView = byte_view(pending, payload_offset, payload_count)?
	byte_read_u32_be(payload)
end

fn max_receive_flow_control_window() -> Int
	2147483647
end

fn update_window_receive_credit(pending: ByteChunk, offset: Int, stream_id: Int, receive_flow_control: ReceiveFlowControl) -> Result<ReceiveFlowControlDecision, String>
	let increment: Int = window_update_increment(pending)?
	match stream_id == 0
		true => Ok(update_connection_receive_credit(offset, increment, receive_flow_control))
		false => Ok(update_stream_receive_credit(offset, stream_id, increment, receive_flow_control))
	end
end

fn window_update_increment(pending: ByteChunk) -> Result<Int, String>
	let payload_offset: ByteOffset = byte_offset(9)?
	let payload_count: ByteCount = byte_count(4)?
	let payload: ByteView = byte_view(pending, payload_offset, payload_count)?
	byte_read_u31_be(payload)
end

fn update_connection_receive_credit(offset: Int, increment: Int, receive_flow_control: ReceiveFlowControl) -> ReceiveFlowControlDecision
	match receive_flow_control
		ReceiveFlowControl(connection_window, open_stream) => match increment == 0
			true => ReceiveFlowControlFailed(FlowControlWindowExceeded(offset, 8, 0, increment, 1, "connection-flow-control", "window_update_increment_nonzero"))
			false => match increment > max_receive_flow_control_window() - connection_window
				true => ReceiveFlowControlFailed(FlowControlWindowExceeded(offset, 8, 0, increment, max_receive_flow_control_window() - connection_window, "connection-flow-control", "connection_receive_window"))
				false => ReceiveFlowControlOk(ReceiveFlowControl(connection_window + increment, open_stream))
			end
		end
	end
end

fn update_stream_receive_credit(offset: Int, stream_id: Int, increment: Int, receive_flow_control: ReceiveFlowControl) -> ReceiveFlowControlDecision
	match receive_flow_control
		ReceiveFlowControl(connection_window, NoOpenStreamReceiveWindow) => ReceiveFlowControlFailed(InvalidFrameKind(offset, 8, stream_id, 1, "idle-stream", "idle_streams_require_headers"))
		ReceiveFlowControl(connection_window, OpenStreamReceiveWindow(open_stream_id, stream_window, priority)) => match stream_id == open_stream_id
			false => ReceiveFlowControlFailed(InvalidFrameKind(offset, 8, stream_id, 1, "idle-stream", "idle_streams_require_headers"))
			true => match increment == 0
				true => ReceiveFlowControlFailed(FlowControlWindowExceeded(offset, 8, stream_id, increment, 1, "open-stream", "window_update_increment_nonzero"))
				false => match increment > max_receive_flow_control_window() - stream_window
					true => ReceiveFlowControlFailed(FlowControlWindowExceeded(offset, 8, stream_id, increment, max_receive_flow_control_window() - stream_window, "open-stream", "stream_receive_window"))
					false => ReceiveFlowControlOk(ReceiveFlowControl(connection_window, OpenStreamReceiveWindow(open_stream_id, stream_window + increment, priority)))
				end
			end
		end
		ReceiveFlowControl(_, HalfClosedLocalStreamReceiveWindow(open_stream_id, _, _)) => match stream_id == open_stream_id
			true => ReceiveFlowControlFailed(InvalidFrameKind(offset, 8, stream_id, 1, "half-closed-local-stream", "half_closed_local_data_only"))
			false => ReceiveFlowControlFailed(InvalidFrameKind(offset, 8, stream_id, 1, "idle-stream", "idle_streams_require_headers"))
		end
		ReceiveFlowControl(_, ClosedByPeerStreamReceiveWindow(closed_stream_id, _)) => match stream_id == closed_stream_id
			true => ReceiveFlowControlFailed(InvalidFrameKind(offset, 8, stream_id, 1, "closed-by-peer-stream", "closed_by_peer_rejects_later_frames"))
			false => ReceiveFlowControlFailed(InvalidFrameKind(offset, 8, stream_id, 1, "idle-stream", "idle_streams_require_headers"))
		end
		ReceiveFlowControl(_, ResetStreamReceiveWindow(reset_stream_id, _)) => match stream_id == reset_stream_id
			true => ReceiveFlowControlFailed(InvalidFrameKind(offset, 8, stream_id, 1, "reset-stream", "reset_stream_rejects_later_frames"))
			false => ReceiveFlowControlFailed(InvalidFrameKind(offset, 8, stream_id, 1, "idle-stream", "idle_streams_require_headers"))
		end
	end
end

fn update_priority_receive_state(pending: ByteChunk, offset: Int, length: Int, stream_id: Int, receive_flow_control: ReceiveFlowControl) -> Result<ReceiveFlowControlDecision, String>
	let payload: ByteChunk = frame_payload_chunk(pending, length)?
	let payload_view: ByteView = byte_view(payload, byte_offset(0)?, byte_count(5)?)?
	match receive_flow_control
		ReceiveFlowControl(connection_window, NoOpenStreamReceiveWindow) => Ok(ReceiveFlowControlFailed(InvalidFrameKind(offset, 2, stream_id, 1, "idle-stream", "idle_streams_require_headers")))
		ReceiveFlowControl(connection_window, OpenStreamReceiveWindow(open_stream_id, stream_window, _)) => match stream_id == open_stream_id
			true => Ok(ReceiveFlowControlOk(ReceiveFlowControl(connection_window, OpenStreamReceiveWindow(open_stream_id, stream_window, StreamPriority(priority_dependency_stream_id(payload_view)?, priority_exclusive(payload_view)?, priority_weight(payload_view)?)))))
			false => Ok(ReceiveFlowControlFailed(InvalidFrameKind(offset, 2, stream_id, 1, "idle-stream", "idle_streams_require_headers")))
		end
		ReceiveFlowControl(_, HalfClosedLocalStreamReceiveWindow(open_stream_id, _, _)) => match stream_id == open_stream_id
			true => Ok(ReceiveFlowControlFailed(InvalidFrameKind(offset, 2, stream_id, 1, "half-closed-local-stream", "half_closed_local_data_only")))
			false => Ok(ReceiveFlowControlFailed(InvalidFrameKind(offset, 2, stream_id, 1, "idle-stream", "idle_streams_require_headers")))
		end
		ReceiveFlowControl(_, ClosedByPeerStreamReceiveWindow(closed_stream_id, _)) => match stream_id == closed_stream_id
			true => Ok(ReceiveFlowControlFailed(InvalidFrameKind(offset, 2, stream_id, 1, "closed-by-peer-stream", "closed_by_peer_rejects_later_frames")))
			false => Ok(ReceiveFlowControlFailed(InvalidFrameKind(offset, 2, stream_id, 1, "idle-stream", "idle_streams_require_headers")))
		end
		ReceiveFlowControl(_, ResetStreamReceiveWindow(reset_stream_id, _)) => match stream_id == reset_stream_id
			true => Ok(ReceiveFlowControlFailed(InvalidFrameKind(offset, 2, stream_id, 1, "reset-stream", "reset_stream_rejects_later_frames")))
			false => Ok(ReceiveFlowControlFailed(InvalidFrameKind(offset, 2, stream_id, 1, "idle-stream", "idle_streams_require_headers")))
		end
	end
end

fn step_kind(step: Http2Step) -> String
	match step
		FrameDecoded(_, _, _, _, _, _, _, _) => "frame"
		Waiting(_) => "waiting"
		Failed(_, _) => "failed"
	end
end

fn step_state(step: Http2Step) -> Http2DecodeState
	match step
		FrameDecoded(state, _, _, _, _, _, _, _) => state
		Waiting(state) => state
		Failed(state, _) => state
	end
end

fn step_failure(step: Http2Step) -> Http2ProtocolFailure
	match step
		FrameDecoded(_, _, _, _, _, _, _, _) => ClosedWithPending(0, 0)
		Waiting(_) => ClosedWithPending(0, 0)
		Failed(_, failure) => failure
	end
end

fn step_offset(step: Http2Step) -> Int
	match step
		FrameDecoded(_, offset, _, _, _, _, _, _) => offset
		Waiting(_) => 0
		Failed(_, _) => 0
	end
end

fn step_kind_value(step: Http2Step) -> Int
	match step
		FrameDecoded(_, _, _, kind, _, _, _, _) => kind
		Waiting(_) => 0
		Failed(_, _) => 0
	end
end

fn step_stream_id(step: Http2Step) -> Int
	match step
		FrameDecoded(_, _, _, _, _, stream_id, _, _) => stream_id
		Waiting(_) => 0
		Failed(_, _) => 0
	end
end

fn step_flags(step: Http2Step) -> Int
	match step
		FrameDecoded(_, _, _, _, flags, _, _, _) => flags
		Waiting(_) => 0
		Failed(_, _) => 0
	end
end

fn step_completed_count(step: Http2Step) -> Int
	match step
		FrameDecoded(_, _, _, _, _, _, completed_header_block, _) => byte_count_to_int(byte_chunk_count(completed_header_block))
		Waiting(_) => 0
		Failed(_, _) => 0
	end
end

fn step_completed_header_block(step: Http2Step) -> ByteChunk
	match step
		FrameDecoded(_, _, _, _, _, _, completed_header_block, _) => completed_header_block
		Waiting(_) => empty_header_block()
		Failed(_, _) => empty_header_block()
	end
end

fn step_frame_payload_chunk(step: Http2Step) -> ByteChunk
	match step
		FrameDecoded(_, _, _, _, _, _, _, KnownFrame(_, _, _, payload)) => byte_view_to_chunk(payload)
		FrameDecoded(_, _, _, _, _, _, _, PriorityFrame(_, _, _, _, _)) => byte_chunk([])
		FrameDecoded(_, _, _, _, _, _, _, UnknownFrame(_, _, _, payload)) => byte_view_to_chunk(payload)
		Waiting(_) => byte_chunk([])
		Failed(_, _) => byte_chunk([])
	end
end

fn state_pending_count(state: Http2DecodeState) -> Int
	match state
		State(pending, _, _, _, _, _, _, _, _) => byte_count_to_int(byte_chunk_count(pending))
	end
end

fn state_pending_chunk(state: Http2DecodeState) -> ByteChunk
	match state
		State(pending, _, _, _, _, _, _, _, _) => pending
	end
end

fn state_next_offset(state: Http2DecodeState) -> Int
	match state
		State(_, next_offset, _, _, _, _, _, _, _) => next_offset
	end
end

fn state_receive_limit(state: Http2DecodeState) -> ReceiveLimitEntry
	match state
		State(_, _, _, _, _, receive_limit, _, _, _) => receive_limit
	end
end

fn state_preface_label(state: Http2DecodeState) -> String
	match state
		State(_, _, ExpectPreface, _, _, _, _, _, _) => "expect"
		State(_, _, AfterPreface, _, _, _, _, _, _) => "done"
	end
end

fn state_continuation_label(state: Http2DecodeState) -> String
	match state
		State(_, _, _, NoContinuation, _, _, _, _, _) => "none"
		State(_, _, _, Continuation(_, _, _, _, _), _, _, _, _, _) => "active"
	end
end

fn state_continuation_count(state: Http2DecodeState) -> Int
	match state
		State(_, _, _, NoContinuation, _, _, _, _, _) => 0
		State(_, _, _, Continuation(_, _, _, _, accumulated), _, _, _, _, _) => byte_count_to_int(byte_chunk_count(accumulated))
	end
end

fn state_continuation_stream(state: Http2DecodeState) -> Int
	match state
		State(_, _, _, NoContinuation, _, _, _, _, _) => 0
		State(_, _, _, Continuation(stream_id, _, _, _, _), _, _, _, _, _) => stream_id
	end
end

fn state_continuation_started_kind(state: Http2DecodeState) -> Int
	match state
		State(_, _, _, NoContinuation, _, _, _, _, _) => 0
		State(_, _, _, Continuation(_, started_kind, _, _, _), _, _, _, _, _) => started_kind
	end
end

fn state_continuation_started_offset(state: Http2DecodeState) -> Int
	match state
		State(_, _, _, NoContinuation, _, _, _, _, _) => 0
		State(_, _, _, Continuation(_, _, started_offset, _, _), _, _, _, _, _) => started_offset
	end
end

fn state_peer_max_frame_size(state: Http2DecodeState) -> Int
	match state
		State(_, _, _, _, _, _, PeerSettings(NoPeerMaxFrameSize, _, _, _, _, _), _, _) => 0
		State(_, _, _, _, _, _, PeerSettings(PeerMaxFrameSize(value, _), _, _, _, _, _), _, _) => value
	end
end

