# A pure HTTP/2 core consumes frame headers from explicit input events and emits encoded headers.
use stdio

schema Http2FrameHeaderWire
	format binary

	length: UInt24be
	kind: UInt8
	flags: UInt8
	stream_reserved: ReservedBits(1, 0)
	stream_id: UInt31be
end

type PendingContinuation
	NoContinuation
	Continuation(Int, Int, Int, ByteChunk)
end

type ContinuationDecision
	Decision(PendingContinuation, ByteChunk)
end

type ReceiveLimitProvenance
	ProtocolDefault
	LocalConfiguration
	LocalSettingsItem(Int)
end

type ReceiveLimitEntry
	ReceiveLimit(Int, ReceiveLimitProvenance)
end

type PeerAdvertisedMaxFrameSize
	NoPeerMaxFrameSize
	PeerMaxFrameSize(Int, Int)
end

type PeerAdvertisedInitialWindowSize
	NoPeerInitialWindowSize
	PeerInitialWindowSize(Int, Int)
end

type PeerSettingsState
	PeerSettings(PeerAdvertisedMaxFrameSize, PeerAdvertisedInitialWindowSize)
end

type ConnectionShutdownState
	OpenConnection
	GracefulShutdown(Int, Int)
end

type OpenStreamReceiveWindow
	NoOpenStreamReceiveWindow
	OpenStreamReceiveWindow(Int, Int)
	ResetStreamReceiveWindow(Int, Int)
end

type ReceiveFlowControl
	ReceiveFlowControl(Int, OpenStreamReceiveWindow)
end

type PrefaceState
	ExpectPreface
	AfterPreface
end

type Http2DecodeState
	State(ByteChunk, Int, PrefaceState, PendingContinuation, ReceiveLimitEntry, PeerSettingsState, ConnectionShutdownState, ReceiveFlowControl)
end

type Http2Input
	InputChunk(ByteChunk)
	InputEnd
end

type Http2Frame
	KnownFrame(Int, Int, Int, ByteView)
	UnknownFrame(Int, Int, Int, ByteView)
end

type Http2ProtocolFailure
	ClosedWithPending(Int, Int)
	ClosedWithPartialPreface(Int, Int)
	InvalidPreface(Int, Int, Int, Int)
	ContinuationExpected(Int, Int, Int, Int, Int, Int)
	InvalidFrameKind(Int, Int, Int, Int, String, String)
	InvalidStreamId(Int, Int, Int, String, String, String, String)
	InvalidPayloadLength(Int, Int, Int, Int, Int, String, String)
	StreamAfterGoaway(Int, Int, Int, String, String, String)
	FrameSizeExceeded(Int, Int, ReceiveLimitEntry, Int, Int)
	FlowControlWindowExceeded(Int, Int, Int, Int, Int, String, String)
	ConcurrentStreamsExceeded(Int, Int, Int, Int, String, String, String)
	SettingsValueOutOfRange(Int, Int, String, Int, Int, Int, String)
end

type ProtocolPayloadDecision
	ProtocolPayloadOk
	ProtocolPayloadFailed(Http2ProtocolFailure)
end

type ProtocolStreamIdDecision
	ProtocolStreamIdOk
	ProtocolStreamIdFailed(Http2ProtocolFailure)
end

type SettingsRangeDecision
	SettingsValueOk
	SettingsValueFailed(Http2ProtocolFailure)
end

type ReceiveFlowControlDecision
	ReceiveFlowControlOk(ReceiveFlowControl)
	ReceiveFlowControlFailed(Http2ProtocolFailure)
end

type Http2Step
	FrameDecoded(Http2DecodeState, Int, Int, Int, Int, Int, ByteChunk, Http2Frame)
	Waiting(Http2DecodeState)
	Failed(Http2DecodeState, Http2ProtocolFailure)
end

fn empty_state() -> Http2DecodeState
	State(byte_chunk([]), 0, ExpectPreface, NoContinuation, protocol_default_frame_size_limit(), empty_peer_settings(), OpenConnection, default_receive_flow_control())
end

fn frame_state() -> Http2DecodeState
	State(byte_chunk([]), 0, AfterPreface, NoContinuation, protocol_default_frame_size_limit(), empty_peer_settings(), OpenConnection, default_receive_flow_control())
end

fn local_config_state(max_frame_size: Int) -> Http2DecodeState
	State(byte_chunk([]), 0, AfterPreface, NoContinuation, ReceiveLimit(max_frame_size, LocalConfiguration), empty_peer_settings(), OpenConnection, default_receive_flow_control())
end

fn local_settings_state(max_frame_size: Int, item_offset: Int) -> Http2DecodeState
	State(byte_chunk([]), 0, AfterPreface, NoContinuation, ReceiveLimit(max_frame_size, LocalSettingsItem(item_offset)), empty_peer_settings(), OpenConnection, default_receive_flow_control())
end

fn receive_window_state(connection_window: Int, stream_id: Int, stream_window: Int) -> Http2DecodeState
	State(byte_chunk([]), 0, AfterPreface, NoContinuation, protocol_default_frame_size_limit(), empty_peer_settings(), OpenConnection, ReceiveFlowControl(connection_window, OpenStreamReceiveWindow(stream_id, stream_window)))
end

fn encode_frame_header(header: {length: Int, kind: Int, flags: Int, stream_id: Int}) -> Result<ByteChunk, EncodeError>
	byte_encode_http2_frame_header_wire(header)
end

fn receive(input: Http2Input, state: Http2DecodeState) -> Result<Http2Step, String>
	match input
		InputChunk(bytes) => receive_chunk(bytes, state)
		InputEnd => receive_end(state)
	end
end

fn receive_chunk(bytes: ByteChunk, state: Http2DecodeState) -> Result<Http2Step, String>
	match state
		State(pending, next_offset, preface_state, continuation, receive_limit, peer_settings, shutdown_state, receive_flow_control) => receive_available(byte_append(pending, bytes), next_offset, preface_state, continuation, receive_limit, peer_settings, shutdown_state, receive_flow_control)
	end
end

fn receive_end(state: Http2DecodeState) -> Result<Http2Step, String>
	match state
		State(pending, next_offset, preface_state, continuation, receive_limit, peer_settings, shutdown_state, receive_flow_control) => end_pending(pending, next_offset, preface_state, continuation, receive_limit, peer_settings, shutdown_state, receive_flow_control)
	end
end

fn end_pending(pending: ByteChunk, next_offset: Int, preface_state: PrefaceState, continuation: PendingContinuation, receive_limit: ReceiveLimitEntry, peer_settings: PeerSettingsState, shutdown_state: ConnectionShutdownState, receive_flow_control: ReceiveFlowControl) -> Result<Http2Step, String>
	let available: Int = byte_count_to_int(byte_chunk_count(pending))
	match available == 0
		true => match continuation
			NoContinuation => Ok(Waiting(State(pending, next_offset, preface_state, continuation, receive_limit, peer_settings, shutdown_state, receive_flow_control)))
			Continuation(_, _, _, _) => Ok(Failed(State(pending, next_offset, preface_state, continuation, receive_limit, peer_settings, shutdown_state, receive_flow_control), ClosedWithPending(next_offset, available)))
		end
		false => match preface_state
			ExpectPreface => Ok(Failed(State(pending, next_offset, preface_state, continuation, receive_limit, peer_settings, shutdown_state, receive_flow_control), ClosedWithPartialPreface(next_offset, available)))
			AfterPreface => Ok(Failed(State(pending, next_offset, preface_state, continuation, receive_limit, peer_settings, shutdown_state, receive_flow_control), ClosedWithPending(next_offset, available)))
		end
	end
end

fn receive_available(pending: ByteChunk, next_offset: Int, preface_state: PrefaceState, continuation: PendingContinuation, receive_limit: ReceiveLimitEntry, peer_settings: PeerSettingsState, shutdown_state: ConnectionShutdownState, receive_flow_control: ReceiveFlowControl) -> Result<Http2Step, String>
	match preface_state
		ExpectPreface => validate_preface(pending, next_offset, continuation, receive_limit, peer_settings, shutdown_state, receive_flow_control)
		AfterPreface => decode_available(pending, next_offset, continuation, receive_limit, peer_settings, shutdown_state, receive_flow_control)
	end
end

fn client_connection_preface_count() -> Int
	24
end

fn validate_preface(pending: ByteChunk, next_offset: Int, continuation: PendingContinuation, receive_limit: ReceiveLimitEntry, peer_settings: PeerSettingsState, shutdown_state: ConnectionShutdownState, receive_flow_control: ReceiveFlowControl) -> Result<Http2Step, String>
	let available: Int = byte_count_to_int(byte_chunk_count(pending))
	let matched: Int = matched_preface_count(pending, available, 0)?
	match matched < available
		true => match matched < client_connection_preface_count()
			true => Ok(Failed(State(pending, next_offset, ExpectPreface, continuation, receive_limit, peer_settings, shutdown_state, receive_flow_control), InvalidPreface(next_offset + matched, expected_preface_byte(matched), read_byte(pending, matched)?, matched)))
			false => consume_preface(pending, next_offset, continuation, receive_limit, peer_settings, shutdown_state, receive_flow_control)
		end
		false => match available < client_connection_preface_count()
			true => Ok(Waiting(State(pending, next_offset, ExpectPreface, continuation, receive_limit, peer_settings, shutdown_state, receive_flow_control)))
			false => consume_preface(pending, next_offset, continuation, receive_limit, peer_settings, shutdown_state, receive_flow_control)
		end
	end
end

fn consume_preface(pending: ByteChunk, next_offset: Int, continuation: PendingContinuation, receive_limit: ReceiveLimitEntry, peer_settings: PeerSettingsState, shutdown_state: ConnectionShutdownState, receive_flow_control: ReceiveFlowControl) -> Result<Http2Step, String>
	let preface_count: ByteCount = byte_count(client_connection_preface_count())?
	let suffix: ByteChunk = byte_drop(pending, preface_count)?
	decode_available(suffix, next_offset + client_connection_preface_count(), continuation, receive_limit, peer_settings, shutdown_state, receive_flow_control)
end

fn matched_preface_count(pending: ByteChunk, available: Int, index: Int) -> Result<Int, String>
	match index < available
		false => Ok(index)
		true => match index < client_connection_preface_count()
			false => Ok(index)
			true => match read_byte(pending, index)? == expected_preface_byte(index)
				true => matched_preface_count(pending, available, index + 1)
				false => Ok(index)
			end
		end
	end
end

fn read_byte(pending: ByteChunk, index: Int) -> Result<Int, String>
	byte_read_u8_be(byte_view(pending, byte_offset(index)?, byte_count(1)?)?)
end

fn expected_preface_byte(index: Int) -> Int
	match index == 0
		true => 80
		false => match index == 1
			true => 82
			false => match index == 2
				true => 73
				false => match index == 3
					true => 32
					false => match index == 4
						true => 42
						false => match index == 5
							true => 32
							false => match index == 6
								true => 72
								false => match index == 7
									true => 84
									false => match index == 8
										true => 84
										false => match index == 9
											true => 80
											false => match index == 10
												true => 47
												false => match index == 11
													true => 50
													false => match index == 12
														true => 46
														false => match index == 13
															true => 48
															false => match index == 14
																true => 13
																false => match index == 15
																	true => 10
																	false => match index == 16
																		true => 13
																		false => match index == 17
																			true => 10
																			false => match index == 18
																				true => 83
																				false => match index == 19
																					true => 77
																					false => match index == 20
																						true => 13
																						false => match index == 21
																							true => 10
																							false => match index == 22
																								true => 13
																								false => match index == 23
																									true => 10
																									false => 0
																								end
																							end
																						end
																					end
																				end
																			end
																		end
																	end
																end
															end
														end
													end
												end
											end
										end
									end
								end
							end
						end
					end
				end
			end
		end
	end
end

fn decode_available(pending: ByteChunk, next_offset: Int, continuation: PendingContinuation, receive_limit: ReceiveLimitEntry, peer_settings: PeerSettingsState, shutdown_state: ConnectionShutdownState, receive_flow_control: ReceiveFlowControl) -> Result<Http2Step, String>
	let available: Int = byte_count_to_int(byte_chunk_count(pending))
	match available < 9
		true => Ok(Waiting(State(pending, next_offset, AfterPreface, continuation, receive_limit, peer_settings, shutdown_state, receive_flow_control)))
		false => decode_header(pending, next_offset, continuation, receive_limit, peer_settings, shutdown_state, receive_flow_control)
	end
end

fn decode_header(pending: ByteChunk, next_offset: Int, continuation: PendingContinuation, receive_limit: ReceiveLimitEntry, peer_settings: PeerSettingsState, shutdown_state: ConnectionShutdownState, receive_flow_control: ReceiveFlowControl) -> Result<Http2Step, String>
	let available: Int = byte_count_to_int(byte_chunk_count(pending))
	let zero: ByteOffset = byte_offset(0)?
	let header_count: ByteCount = byte_count(9)?
	let view: ByteView = byte_view(pending, zero, header_count)?
	let header: {length: Int, kind: Int, flags: Int, stream_id: Int} = byte_decode_http2_frame_header(view)?
	let max_frame_size: Int = receive_limit_value(receive_limit)
	match header.length > max_frame_size
		true => Ok(Failed(State(pending, next_offset, AfterPreface, continuation, receive_limit, peer_settings, shutdown_state, receive_flow_control), FrameSizeExceeded(next_offset, header.length, receive_limit, header.kind, header.stream_id)))
		false => decode_sized_frame(pending, next_offset, continuation, receive_limit, peer_settings, shutdown_state, receive_flow_control, available, header.length, header.kind, header.flags, header.stream_id)
	end
end

fn protocol_default_frame_size_limit() -> ReceiveLimitEntry
	ReceiveLimit(16384, ProtocolDefault)
end

fn empty_peer_settings() -> PeerSettingsState
	PeerSettings(NoPeerMaxFrameSize, NoPeerInitialWindowSize)
end

fn default_receive_flow_control() -> ReceiveFlowControl
	ReceiveFlowControl(65535, NoOpenStreamReceiveWindow)
end

fn concurrent_stream_receive_limit() -> Int
	1
end

fn concurrent_stream_receive_limit_provenance() -> String
	"local_configuration"
end

fn receive_limit_value(receive_limit: ReceiveLimitEntry) -> Int
	match receive_limit
		ReceiveLimit(value, _) => value
	end
end

fn receive_limit_provenance_label(receive_limit: ReceiveLimitEntry) -> String
	match receive_limit
		ReceiveLimit(_, ProtocolDefault) => "protocol_default"
		ReceiveLimit(_, LocalConfiguration) => "local_configuration"
		ReceiveLimit(_, LocalSettingsItem(_)) => "local_settings_item"
	end
end

fn decode_sized_frame(pending: ByteChunk, next_offset: Int, continuation: PendingContinuation, receive_limit: ReceiveLimitEntry, peer_settings: PeerSettingsState, shutdown_state: ConnectionShutdownState, receive_flow_control: ReceiveFlowControl, available: Int, length: Int, kind: Int, flags: Int, stream_id: Int) -> Result<Http2Step, String>
	let frame_count_int: Int = 9 + length
	match available < frame_count_int
		true => Ok(Waiting(State(pending, next_offset, AfterPreface, continuation, receive_limit, peer_settings, shutdown_state, receive_flow_control)))
		false => decode_complete_frame(pending, next_offset, continuation, receive_limit, peer_settings, shutdown_state, receive_flow_control, length, kind, flags, stream_id, frame_count_int)
	end
end

fn decode_complete_frame(pending: ByteChunk, next_offset: Int, continuation: PendingContinuation, receive_limit: ReceiveLimitEntry, peer_settings: PeerSettingsState, shutdown_state: ConnectionShutdownState, receive_flow_control: ReceiveFlowControl, length: Int, kind: Int, flags: Int, stream_id: Int, frame_count_int: Int) -> Result<Http2Step, String>
	let frame_count: ByteCount = byte_count(frame_count_int)?
	let suffix: ByteChunk = byte_drop(pending, frame_count)?
	let payload: ByteChunk = frame_payload_chunk(pending, length)?
	let consumed_state: Http2DecodeState = State(suffix, next_offset + frame_count_int, AfterPreface, continuation, receive_limit, peer_settings, shutdown_state, receive_flow_control)
	let stream_id_decision: ProtocolStreamIdDecision = validate_stream_id_domain(next_offset, kind, stream_id)
	match stream_id_decision
		ProtocolStreamIdOk => decode_complete_frame_after_stream_id(pending, suffix, payload, next_offset, frame_count_int, continuation, receive_limit, peer_settings, shutdown_state, receive_flow_control, length, kind, flags, stream_id, consumed_state)
		ProtocolStreamIdFailed(error) => Ok(Failed(consumed_state, error))
	end
end

fn decode_complete_frame_after_stream_id(pending: ByteChunk, suffix: ByteChunk, payload: ByteChunk, next_offset: Int, frame_count_int: Int, continuation: PendingContinuation, receive_limit: ReceiveLimitEntry, peer_settings: PeerSettingsState, shutdown_state: ConnectionShutdownState, receive_flow_control: ReceiveFlowControl, length: Int, kind: Int, flags: Int, stream_id: Int, consumed_state: Http2DecodeState) -> Result<Http2Step, String>
	let settings_decision: SettingsRangeDecision = validate_settings_value(pending, next_offset, length, kind, flags)?
	match settings_decision
		SettingsValueOk => match validate_protocol_payload(next_offset, length, kind, flags, stream_id)
			ProtocolPayloadOk => match validate_continuation(continuation, next_offset, payload, kind, flags, stream_id, receive_flow_control)
				Ok(Decision(next_continuation, completed_header_block)) => complete_receive_flow_control_update(pending, suffix, next_offset, frame_count_int, next_continuation, receive_limit, peer_settings, shutdown_state, receive_flow_control, length, kind, flags, stream_id, completed_header_block, consumed_state)
				Err(error) => Ok(Failed(consumed_state, error))
			end
			ProtocolPayloadFailed(error) => Ok(Failed(consumed_state, error))
		end
		SettingsValueFailed(error) => Ok(Failed(consumed_state, error))
	end
end

fn frame_payload_chunk(frame: ByteChunk, length: Int) -> Result<ByteChunk, String>
	let payload_offset: ByteOffset = byte_offset(9)?
	let payload_count: ByteCount = byte_count(length)?
	Ok(byte_view_to_chunk(byte_view(frame, payload_offset, payload_count)?))
end

fn validate_stream_id_domain(offset: Int, kind: Int, stream_id: Int) -> ProtocolStreamIdDecision
	match kind == 4
		true => require_connection_stream_id(offset, kind, stream_id)
		false => match kind == 6
			true => require_connection_stream_id(offset, kind, stream_id)
			false => match kind == 7
				true => require_connection_stream_id(offset, kind, stream_id)
				false => match kind == 0
					true => require_client_stream_id(offset, kind, stream_id)
					false => match kind == 1
						true => require_client_stream_id(offset, kind, stream_id)
						false => match kind == 3
							true => require_client_stream_id(offset, kind, stream_id)
							false => match kind == 9
								true => require_client_stream_id(offset, kind, stream_id)
								false => match kind == 8
									true => validate_window_update_stream_id(offset, kind, stream_id)
									false => ProtocolStreamIdOk
								end
							end
						end
					end
				end
			end
		end
	end
end

fn validate_window_update_stream_id(offset: Int, kind: Int, stream_id: Int) -> ProtocolStreamIdDecision
	match stream_id == 0
		true => ProtocolStreamIdOk
		false => require_client_stream_id(offset, kind, stream_id)
	end
end

fn require_connection_stream_id(offset: Int, kind: Int, stream_id: Int) -> ProtocolStreamIdDecision
	match stream_id == 0
		true => ProtocolStreamIdOk
		false => ProtocolStreamIdFailed(InvalidStreamId(offset, kind, stream_id, "connection stream id zero", "server", "stream-id-domain", "connection_frames_require_stream_zero"))
	end
end

fn require_client_stream_id(offset: Int, kind: Int, stream_id: Int) -> ProtocolStreamIdDecision
	match stream_id == 0
		true => ProtocolStreamIdFailed(InvalidStreamId(offset, kind, stream_id, "nonzero client-initiated stream id", "server", "stream-id-domain", "server_receives_client_initiated_streams"))
		false => match stream_id_is_client_initiated(stream_id)
			true => ProtocolStreamIdOk
			false => ProtocolStreamIdFailed(InvalidStreamId(offset, kind, stream_id, "nonzero client-initiated stream id", "server", "stream-id-domain", "server_receives_client_initiated_streams"))
		end
	end
end

fn stream_id_is_client_initiated(stream_id: Int) -> Bool
	(stream_id / 2) * 2 != stream_id
end

fn complete_receive_flow_control_update(pending: ByteChunk, suffix: ByteChunk, next_offset: Int, frame_count_int: Int, next_continuation: PendingContinuation, receive_limit: ReceiveLimitEntry, peer_settings: PeerSettingsState, shutdown_state: ConnectionShutdownState, receive_flow_control: ReceiveFlowControl, length: Int, kind: Int, flags: Int, stream_id: Int, completed_header_block: ByteChunk, consumed_state: Http2DecodeState) -> Result<Http2Step, String>
	let flow_control_decision: ReceiveFlowControlDecision = update_receive_flow_control(pending, next_offset, length, kind, stream_id, shutdown_state, receive_flow_control)?
	match flow_control_decision
		ReceiveFlowControlOk(next_receive_flow_control) => Ok(FrameDecoded(State(suffix, next_offset + frame_count_int, AfterPreface, next_continuation, receive_limit, update_peer_settings(pending, next_offset, length, kind, flags, peer_settings)?, update_shutdown_state(pending, length, kind, shutdown_state)?, next_receive_flow_control), next_offset, length, kind, flags, stream_id, completed_header_block, frame_value(pending, length, kind, flags, stream_id)?))
		ReceiveFlowControlFailed(error) => Ok(Failed(consumed_state, error))
	end
end

fn frame_value(pending: ByteChunk, length: Int, kind: Int, flags: Int, stream_id: Int) -> Result<Http2Frame, String>
	let payload: ByteView = byte_view(pending, byte_offset(9)?, byte_count(length)?)?
	match is_known_frame_kind(kind)
		true => Ok(KnownFrame(kind, flags, stream_id, payload))
		false => Ok(UnknownFrame(kind, flags, stream_id, payload))
	end
end

fn is_known_frame_kind(kind: Int) -> Bool
	match kind == 0
		true => true
		false => match kind == 1
			true => true
			false => match kind == 3
				true => true
				false => match kind == 4
					true => true
					false => match kind == 6
						true => true
						false => match kind == 7
							true => true
							false => match kind == 8
								true => true
								false => match kind == 9
									true => true
									false => false
								end
							end
						end
					end
				end
			end
		end
	end
end

fn is_unknown_frame_kind(kind: Int) -> Bool
	match is_known_frame_kind(kind)
		true => false
		false => true
	end
end

fn validate_protocol_payload(offset: Int, length: Int, kind: Int, flags: Int, stream_id: Int) -> ProtocolPayloadDecision
	match kind == 6
		true => validate_fixed_payload_length(offset, length, kind, stream_id, 8, "connection-control", "rfc9113_ping_payload_length")
		false => match kind == 7
			true => validate_fixed_payload_length(offset, length, kind, stream_id, 8, "connection-control", "rfc9113_goaway_payload_length")
			false => match kind == 8
				true => validate_fixed_payload_length(offset, length, kind, stream_id, 4, "flow-control", "rfc9113_window_update_payload_length")
				false => match kind == 4
					true => validate_settings_ack_payload_length(offset, length, flags, stream_id)
					false => match kind == 3
						true => validate_fixed_payload_length(offset, length, kind, stream_id, 4, "stream-control", "rfc9113_rst_stream_payload_length")
						false => ProtocolPayloadOk
					end
				end
			end
		end
	end
end

fn settings_ack_set(flags: Int) -> Bool
	(flags / 2) * 2 != flags
end

fn validate_settings_ack_payload_length(offset: Int, length: Int, flags: Int, stream_id: Int) -> ProtocolPayloadDecision
	match settings_ack_set(flags)
		true => validate_fixed_payload_length(offset, length, 4, stream_id, 0, "connection-control", "rfc9113_settings_ack_payload_length")
		false => ProtocolPayloadOk
	end
end

fn validate_fixed_payload_length(offset: Int, length: Int, kind: Int, stream_id: Int, expected_length: Int, active_state: String, rule_provenance: String) -> ProtocolPayloadDecision
	match length == expected_length
		true => ProtocolPayloadOk
		false => ProtocolPayloadFailed(InvalidPayloadLength(offset, kind, stream_id, length, expected_length, active_state, rule_provenance))
	end
end

fn validate_settings_value(pending: ByteChunk, next_offset: Int, length: Int, kind: Int, flags: Int) -> Result<SettingsRangeDecision, String>
	match kind == 4
		true => match settings_ack_set(flags)
			true => Ok(SettingsValueOk)
			false => match length == 6
				true => validate_single_settings_value(pending, next_offset)
				false => Ok(SettingsValueOk)
			end
		end
		false => Ok(SettingsValueOk)
	end
end

fn validate_single_settings_value(pending: ByteChunk, next_offset: Int) -> Result<SettingsRangeDecision, String>
	let item_offset: ByteOffset = byte_offset(9)?
	let item_count: ByteCount = byte_count(6)?
	let item: ByteView = byte_view(pending, item_offset, item_count)?
	let identifier_count: ByteCount = byte_count(2)?
	let value_offset: ByteOffset = byte_offset(2)?
	let value_count: ByteCount = byte_count(4)?
	let identifier: Int = byte_read_u16_be(byte_view(byte_view_to_chunk(item), byte_offset(0)?, identifier_count)?)?
	let value: Int = byte_read_u32_be(byte_view(byte_view_to_chunk(item), value_offset, value_count)?)?
	match identifier == 5
		true => validate_max_frame_size_setting(next_offset + 9, value)
		false => match identifier == 4
			true => validate_initial_window_size_setting(next_offset + 9, value)
			false => Ok(SettingsValueOk)
		end
	end
end

fn validate_max_frame_size_setting(item_offset: Int, value: Int) -> Result<SettingsRangeDecision, String>
	match value < 16384
		true => Ok(SettingsValueFailed(SettingsValueOutOfRange(item_offset, 5, "SETTINGS_MAX_FRAME_SIZE", value, 16384, 16777215, "peer_settings")))
		false => match value > 16777215
			true => Ok(SettingsValueFailed(SettingsValueOutOfRange(item_offset, 5, "SETTINGS_MAX_FRAME_SIZE", value, 16384, 16777215, "peer_settings")))
			false => Ok(SettingsValueOk)
		end
	end
end

fn validate_initial_window_size_setting(item_offset: Int, value: Int) -> Result<SettingsRangeDecision, String>
	match value > 2147483647
		true => Ok(SettingsValueFailed(SettingsValueOutOfRange(item_offset, 4, "SETTINGS_INITIAL_WINDOW_SIZE", value, 0, 2147483647, "peer_settings")))
		false => Ok(SettingsValueOk)
	end
end

fn update_peer_settings(pending: ByteChunk, next_offset: Int, length: Int, kind: Int, flags: Int, peer_settings: PeerSettingsState) -> Result<PeerSettingsState, String>
	match kind == 4
		true => match settings_ack_set(flags)
			true => Ok(peer_settings)
			false => update_settings_frame(pending, next_offset, length, peer_settings)
		end
		false => Ok(peer_settings)
	end
end

fn update_settings_frame(pending: ByteChunk, next_offset: Int, length: Int, peer_settings: PeerSettingsState) -> Result<PeerSettingsState, String>
	match length == 6
		true => update_single_settings_item(pending, next_offset, peer_settings)
		false => Ok(peer_settings)
	end
end

fn update_single_settings_item(pending: ByteChunk, next_offset: Int, peer_settings: PeerSettingsState) -> Result<PeerSettingsState, String>
	let item_offset: ByteOffset = byte_offset(9)?
	let item_count: ByteCount = byte_count(6)?
	let item: ByteView = byte_view(pending, item_offset, item_count)?
	let identifier_count: ByteCount = byte_count(2)?
	let value_offset: ByteOffset = byte_offset(2)?
	let value_count: ByteCount = byte_count(4)?
	let identifier: Int = byte_read_u16_be(byte_view(byte_view_to_chunk(item), byte_offset(0)?, identifier_count)?)?
	let value: Int = byte_read_u32_be(byte_view(byte_view_to_chunk(item), value_offset, value_count)?)?
	match peer_settings
		PeerSettings(max_frame_size, initial_window_size) => match identifier == 5
			true => Ok(PeerSettings(PeerMaxFrameSize(value, next_offset + 9), initial_window_size))
			false => match identifier == 4
				true => Ok(PeerSettings(max_frame_size, PeerInitialWindowSize(value, next_offset + 9)))
				false => Ok(peer_settings)
			end
		end
	end
end

fn update_shutdown_state(pending: ByteChunk, length: Int, kind: Int, shutdown_state: ConnectionShutdownState) -> Result<ConnectionShutdownState, String>
	match kind == 7
		true => match length == 8
			true => decode_goaway_state(pending)
			false => Ok(shutdown_state)
		end
		false => Ok(shutdown_state)
	end
end

fn decode_goaway_state(pending: ByteChunk) -> Result<ConnectionShutdownState, String>
	let last_stream_offset: ByteOffset = byte_offset(9)?
	let error_code_offset: ByteOffset = byte_offset(13)?
	let field_count: ByteCount = byte_count(4)?
	let last_stream_view: ByteView = byte_view(pending, last_stream_offset, field_count)?
	let error_code_view: ByteView = byte_view(pending, error_code_offset, field_count)?
	let last_stream_id: Int = byte_read_u31_be(last_stream_view)?
	let error_code: Int = byte_read_u32_be(error_code_view)?
	Ok(GracefulShutdown(last_stream_id, error_code))
end

fn validate_continuation(continuation: PendingContinuation, offset: Int, payload: ByteChunk, kind: Int, flags: Int, stream_id: Int, receive_flow_control: ReceiveFlowControl) -> Result<ContinuationDecision, Http2ProtocolFailure>
	match continuation
		NoContinuation => validate_without_continuation(offset, payload, kind, flags, stream_id, receive_flow_control)
		Continuation(expected_stream, started_kind, started_offset, accumulated) => validate_with_continuation(expected_stream, started_kind, started_offset, accumulated, offset, payload, kind, flags, stream_id)
	end
end

fn validate_without_continuation(offset: Int, payload: ByteChunk, kind: Int, flags: Int, stream_id: Int, receive_flow_control: ReceiveFlowControl) -> Result<ContinuationDecision, Http2ProtocolFailure>
	match kind == 1
		true => match end_headers_set(flags)
			true => Ok(Decision(NoContinuation, payload))
			false => Ok(Decision(Continuation(stream_id, kind, offset, payload), empty_header_block()))
		end
		false => validate_connection_frame_kind(offset, kind, stream_id, receive_flow_control)
	end
end

fn end_headers_set(flags: Int) -> Bool
	let low_three_bits: Int = flags - (flags / 8) * 8
	match low_three_bits < 4
		true => false
		false => true
	end
end

fn empty_header_block() -> ByteChunk
	byte_chunk([])
end

fn validate_connection_frame_kind(offset: Int, kind: Int, stream_id: Int, receive_flow_control: ReceiveFlowControl) -> Result<ContinuationDecision, Http2ProtocolFailure>
	match stream_id == 0
		true => match kind == 4
			true => Ok(Decision(NoContinuation, empty_header_block()))
			false => match kind == 6
				true => Ok(Decision(NoContinuation, empty_header_block()))
				false => match kind == 7
					true => Ok(Decision(NoContinuation, empty_header_block()))
					false => match kind == 8
						true => Ok(Decision(NoContinuation, empty_header_block()))
						false => match is_unknown_frame_kind(kind)
							true => Ok(Decision(NoContinuation, empty_header_block()))
							false => Err(InvalidFrameKind(offset, kind, stream_id, 4, "connection-control", "connection_frames_require_settings"))
						end
					end
				end
			end
		end
		false => validate_stream_frame_kind(offset, kind, stream_id, receive_flow_control)
	end
end

fn validate_stream_frame_kind(offset: Int, kind: Int, stream_id: Int, receive_flow_control: ReceiveFlowControl) -> Result<ContinuationDecision, Http2ProtocolFailure>
	match kind == 1
		true => Ok(Decision(NoContinuation, empty_header_block()))
		false => match kind == 0
			true => validate_data_stream_state(offset, kind, stream_id, receive_flow_control)
			false => match kind == 3
				true => validate_data_stream_state(offset, kind, stream_id, receive_flow_control)
				false => match kind == 8
					true => validate_data_stream_state(offset, kind, stream_id, receive_flow_control)
					false => match is_unknown_frame_kind(kind)
						true => validate_unknown_stream_state(offset, kind, stream_id, receive_flow_control)
						false => Err(InvalidFrameKind(offset, kind, stream_id, 1, "idle-stream", "idle_streams_require_headers"))
					end
				end
			end
		end
	end
end

fn validate_unknown_stream_state(offset: Int, kind: Int, stream_id: Int, receive_flow_control: ReceiveFlowControl) -> Result<ContinuationDecision, Http2ProtocolFailure>
	match receive_flow_control
		ReceiveFlowControl(_, NoOpenStreamReceiveWindow) => Err(InvalidFrameKind(offset, kind, stream_id, 1, "idle-stream", "idle_streams_require_headers"))
		ReceiveFlowControl(_, OpenStreamReceiveWindow(open_stream_id, _)) => match stream_id == open_stream_id
			true => Ok(Decision(NoContinuation, empty_header_block()))
			false => Err(InvalidFrameKind(offset, kind, stream_id, 1, "idle-stream", "idle_streams_require_headers"))
		end
		ReceiveFlowControl(_, ResetStreamReceiveWindow(reset_stream_id, _)) => match stream_id == reset_stream_id
			true => Err(InvalidFrameKind(offset, kind, stream_id, 1, "reset-stream", "reset_stream_rejects_later_frames"))
			false => Err(InvalidFrameKind(offset, kind, stream_id, 1, "idle-stream", "idle_streams_require_headers"))
		end
	end
end

fn validate_data_stream_state(offset: Int, kind: Int, stream_id: Int, receive_flow_control: ReceiveFlowControl) -> Result<ContinuationDecision, Http2ProtocolFailure>
	match receive_flow_control
		ReceiveFlowControl(_, NoOpenStreamReceiveWindow) => Err(InvalidFrameKind(offset, kind, stream_id, 1, "idle-stream", "idle_streams_require_headers"))
		ReceiveFlowControl(_, OpenStreamReceiveWindow(open_stream_id, _)) => match stream_id == open_stream_id
			true => Ok(Decision(NoContinuation, empty_header_block()))
			false => Err(InvalidFrameKind(offset, kind, stream_id, 1, "idle-stream", "idle_streams_require_headers"))
		end
		ReceiveFlowControl(_, ResetStreamReceiveWindow(reset_stream_id, _)) => match stream_id == reset_stream_id
			true => Err(InvalidFrameKind(offset, kind, stream_id, 1, "reset-stream", "reset_stream_rejects_later_frames"))
			false => Err(InvalidFrameKind(offset, kind, stream_id, 1, "idle-stream", "idle_streams_require_headers"))
		end
	end
end

fn validate_with_continuation(expected_stream: Int, started_kind: Int, started_offset: Int, accumulated: ByteChunk, offset: Int, payload: ByteChunk, kind: Int, flags: Int, stream_id: Int) -> Result<ContinuationDecision, Http2ProtocolFailure>
	match kind == 9
		true => validate_continuation_stream(expected_stream, started_kind, started_offset, accumulated, offset, payload, kind, flags, stream_id)
		false => Err(ContinuationExpected(offset, kind, stream_id, expected_stream, started_kind, started_offset))
	end
end

fn validate_continuation_stream(expected_stream: Int, started_kind: Int, started_offset: Int, accumulated: ByteChunk, offset: Int, payload: ByteChunk, kind: Int, flags: Int, stream_id: Int) -> Result<ContinuationDecision, Http2ProtocolFailure>
	match stream_id == expected_stream
		true => match end_headers_set(flags)
			true => Ok(Decision(NoContinuation, byte_append(accumulated, payload)))
			false => Ok(Decision(Continuation(expected_stream, started_kind, started_offset, byte_append(accumulated, payload)), empty_header_block()))
		end
		false => Err(ContinuationExpected(offset, kind, stream_id, expected_stream, started_kind, started_offset))
	end
end

fn update_receive_flow_control(pending: ByteChunk, offset: Int, length: Int, kind: Int, stream_id: Int, shutdown_state: ConnectionShutdownState, receive_flow_control: ReceiveFlowControl) -> Result<ReceiveFlowControlDecision, String>
	match kind == 1
		true => Ok(open_receive_stream(offset, stream_id, shutdown_state, receive_flow_control))
		false => match kind == 0
			true => Ok(consume_data_receive_window(offset, stream_id, length, receive_flow_control))
			false => match kind == 3
				true => reset_receive_stream(pending, offset, stream_id, receive_flow_control)
				false => match kind == 8
					true => update_window_receive_credit(pending, offset, stream_id, receive_flow_control)
					false => Ok(ReceiveFlowControlOk(receive_flow_control))
				end
			end
		end
	end
end

fn open_receive_stream(offset: Int, stream_id: Int, shutdown_state: ConnectionShutdownState, receive_flow_control: ReceiveFlowControl) -> ReceiveFlowControlDecision
	match receive_flow_control
		ReceiveFlowControl(connection_window, NoOpenStreamReceiveWindow) => match validate_new_stream_after_goaway(offset, stream_id, shutdown_state)
			ReceiveFlowControlOk(_) => ReceiveFlowControlOk(ReceiveFlowControl(connection_window, OpenStreamReceiveWindow(stream_id, 65535)))
			ReceiveFlowControlFailed(error) => ReceiveFlowControlFailed(error)
		end
		ReceiveFlowControl(connection_window, OpenStreamReceiveWindow(open_stream_id, stream_window)) => match stream_id == open_stream_id
			true => ReceiveFlowControlOk(receive_flow_control)
			false => match validate_new_stream_after_goaway(offset, stream_id, shutdown_state)
				ReceiveFlowControlOk(_) => ReceiveFlowControlFailed(ConcurrentStreamsExceeded(offset, stream_id, 2, concurrent_stream_receive_limit(), "open-stream", concurrent_stream_receive_limit_provenance(), "peer_created_stream_receive_limit"))
				ReceiveFlowControlFailed(error) => ReceiveFlowControlFailed(error)
			end
		end
		ReceiveFlowControl(_, ResetStreamReceiveWindow(reset_stream_id, _)) => match stream_id == reset_stream_id
			true => ReceiveFlowControlFailed(InvalidFrameKind(offset, 1, stream_id, 1, "reset-stream", "reset_stream_rejects_later_frames"))
			false => match validate_new_stream_after_goaway(offset, stream_id, shutdown_state)
				ReceiveFlowControlOk(_) => ReceiveFlowControlFailed(ConcurrentStreamsExceeded(offset, stream_id, 2, concurrent_stream_receive_limit(), "open-stream", concurrent_stream_receive_limit_provenance(), "peer_created_stream_receive_limit"))
				ReceiveFlowControlFailed(error) => ReceiveFlowControlFailed(error)
			end
		end
	end
end

fn validate_new_stream_after_goaway(offset: Int, stream_id: Int, shutdown_state: ConnectionShutdownState) -> ReceiveFlowControlDecision
	match shutdown_state
		OpenConnection => ReceiveFlowControlOk(default_receive_flow_control())
		GracefulShutdown(last_stream_id, _) => match stream_id > last_stream_id
			true => ReceiveFlowControlFailed(StreamAfterGoaway(offset, stream_id, last_stream_id, "graceful_shutdown", "server", "goaway_last_stream_id"))
			false => ReceiveFlowControlOk(default_receive_flow_control())
		end
	end
end

fn consume_data_receive_window(offset: Int, stream_id: Int, length: Int, receive_flow_control: ReceiveFlowControl) -> ReceiveFlowControlDecision
	match receive_flow_control
		ReceiveFlowControl(connection_window, NoOpenStreamReceiveWindow) => ReceiveFlowControlFailed(InvalidFrameKind(offset, 0, stream_id, 1, "idle-stream", "idle_streams_require_headers"))
		ReceiveFlowControl(connection_window, OpenStreamReceiveWindow(open_stream_id, stream_window)) => match length > connection_window
			true => ReceiveFlowControlFailed(FlowControlWindowExceeded(offset, 0, stream_id, length, connection_window, "connection-flow-control", "connection_receive_window"))
			false => match length > stream_window
				true => ReceiveFlowControlFailed(FlowControlWindowExceeded(offset, 0, stream_id, length, stream_window, "open-stream", "stream_receive_window"))
				false => ReceiveFlowControlOk(ReceiveFlowControl(connection_window - length, OpenStreamReceiveWindow(open_stream_id, stream_window - length)))
			end
		end
		ReceiveFlowControl(_, ResetStreamReceiveWindow(reset_stream_id, _)) => match stream_id == reset_stream_id
			true => ReceiveFlowControlFailed(InvalidFrameKind(offset, 0, stream_id, 1, "reset-stream", "reset_stream_rejects_later_frames"))
			false => ReceiveFlowControlFailed(InvalidFrameKind(offset, 0, stream_id, 1, "idle-stream", "idle_streams_require_headers"))
		end
	end
end

fn reset_receive_stream(pending: ByteChunk, offset: Int, stream_id: Int, receive_flow_control: ReceiveFlowControl) -> Result<ReceiveFlowControlDecision, String>
	let error_code: Int = rst_stream_error_code(pending)?
	match receive_flow_control
		ReceiveFlowControl(connection_window, NoOpenStreamReceiveWindow) => Ok(ReceiveFlowControlFailed(InvalidFrameKind(offset, 3, stream_id, 1, "idle-stream", "idle_streams_require_headers")))
		ReceiveFlowControl(connection_window, OpenStreamReceiveWindow(open_stream_id, _)) => match stream_id == open_stream_id
			true => Ok(ReceiveFlowControlOk(ReceiveFlowControl(connection_window, ResetStreamReceiveWindow(stream_id, error_code))))
			false => Ok(ReceiveFlowControlFailed(InvalidFrameKind(offset, 3, stream_id, 1, "idle-stream", "idle_streams_require_headers")))
		end
		ReceiveFlowControl(connection_window, ResetStreamReceiveWindow(reset_stream_id, _)) => match stream_id == reset_stream_id
			true => Ok(ReceiveFlowControlFailed(InvalidFrameKind(offset, 3, stream_id, 1, "reset-stream", "reset_stream_rejects_later_frames")))
			false => Ok(ReceiveFlowControlFailed(InvalidFrameKind(offset, 3, stream_id, 1, "idle-stream", "idle_streams_require_headers")))
		end
	end
end

fn rst_stream_error_code(pending: ByteChunk) -> Result<Int, String>
	let payload_offset: ByteOffset = byte_offset(9)?
	let payload_count: ByteCount = byte_count(4)?
	let payload: ByteView = byte_view(pending, payload_offset, payload_count)?
	byte_read_u32_be(payload)
end

fn max_receive_flow_control_window() -> Int
	2147483647
end

fn update_window_receive_credit(pending: ByteChunk, offset: Int, stream_id: Int, receive_flow_control: ReceiveFlowControl) -> Result<ReceiveFlowControlDecision, String>
	let increment: Int = window_update_increment(pending)?
	match stream_id == 0
		true => Ok(update_connection_receive_credit(offset, increment, receive_flow_control))
		false => Ok(update_stream_receive_credit(offset, stream_id, increment, receive_flow_control))
	end
end

fn window_update_increment(pending: ByteChunk) -> Result<Int, String>
	let payload_offset: ByteOffset = byte_offset(9)?
	let payload_count: ByteCount = byte_count(4)?
	let payload: ByteView = byte_view(pending, payload_offset, payload_count)?
	byte_read_u31_be(payload)
end

fn update_connection_receive_credit(offset: Int, increment: Int, receive_flow_control: ReceiveFlowControl) -> ReceiveFlowControlDecision
	match receive_flow_control
		ReceiveFlowControl(connection_window, open_stream) => match increment == 0
			true => ReceiveFlowControlFailed(FlowControlWindowExceeded(offset, 8, 0, increment, 1, "connection-flow-control", "window_update_increment_nonzero"))
			false => match increment > max_receive_flow_control_window() - connection_window
				true => ReceiveFlowControlFailed(FlowControlWindowExceeded(offset, 8, 0, increment, max_receive_flow_control_window() - connection_window, "connection-flow-control", "connection_receive_window"))
				false => ReceiveFlowControlOk(ReceiveFlowControl(connection_window + increment, open_stream))
			end
		end
	end
end

fn update_stream_receive_credit(offset: Int, stream_id: Int, increment: Int, receive_flow_control: ReceiveFlowControl) -> ReceiveFlowControlDecision
	match receive_flow_control
		ReceiveFlowControl(connection_window, NoOpenStreamReceiveWindow) => ReceiveFlowControlFailed(InvalidFrameKind(offset, 8, stream_id, 1, "idle-stream", "idle_streams_require_headers"))
		ReceiveFlowControl(connection_window, OpenStreamReceiveWindow(open_stream_id, stream_window)) => match stream_id == open_stream_id
			false => ReceiveFlowControlFailed(InvalidFrameKind(offset, 8, stream_id, 1, "idle-stream", "idle_streams_require_headers"))
			true => match increment == 0
				true => ReceiveFlowControlFailed(FlowControlWindowExceeded(offset, 8, stream_id, increment, 1, "open-stream", "window_update_increment_nonzero"))
				false => match increment > max_receive_flow_control_window() - stream_window
					true => ReceiveFlowControlFailed(FlowControlWindowExceeded(offset, 8, stream_id, increment, max_receive_flow_control_window() - stream_window, "open-stream", "stream_receive_window"))
					false => ReceiveFlowControlOk(ReceiveFlowControl(connection_window, OpenStreamReceiveWindow(open_stream_id, stream_window + increment)))
				end
			end
		end
		ReceiveFlowControl(_, ResetStreamReceiveWindow(reset_stream_id, _)) => match stream_id == reset_stream_id
			true => ReceiveFlowControlFailed(InvalidFrameKind(offset, 8, stream_id, 1, "reset-stream", "reset_stream_rejects_later_frames"))
			false => ReceiveFlowControlFailed(InvalidFrameKind(offset, 8, stream_id, 1, "idle-stream", "idle_streams_require_headers"))
		end
	end
end

fn step_kind(step: Http2Step) -> String
	match step
		FrameDecoded(_, _, _, _, _, _, _, _) => "frame"
		Waiting(_) => "waiting"
		Failed(_, _) => "failed"
	end
end

fn step_state(step: Http2Step) -> Http2DecodeState
	match step
		FrameDecoded(state, _, _, _, _, _, _, _) => state
		Waiting(state) => state
		Failed(state, _) => state
	end
end

fn step_failure(step: Http2Step) -> Http2ProtocolFailure
	match step
		FrameDecoded(_, _, _, _, _, _, _, _) => ClosedWithPending(0, 0)
		Waiting(_) => ClosedWithPending(0, 0)
		Failed(_, failure) => failure
	end
end

fn step_offset(step: Http2Step) -> Int
	match step
		FrameDecoded(_, offset, _, _, _, _, _, _) => offset
		Waiting(_) => 0
		Failed(_, _) => 0
	end
end

fn step_kind_value(step: Http2Step) -> Int
	match step
		FrameDecoded(_, _, _, kind, _, _, _, _) => kind
		Waiting(_) => 0
		Failed(_, _) => 0
	end
end

fn step_stream_id(step: Http2Step) -> Int
	match step
		FrameDecoded(_, _, _, _, _, stream_id, _, _) => stream_id
		Waiting(_) => 0
		Failed(_, _) => 0
	end
end

fn step_flags(step: Http2Step) -> Int
	match step
		FrameDecoded(_, _, _, _, flags, _, _, _) => flags
		Waiting(_) => 0
		Failed(_, _) => 0
	end
end

fn step_completed_count(step: Http2Step) -> Int
	match step
		FrameDecoded(_, _, _, _, _, _, completed_header_block, _) => byte_count_to_int(byte_chunk_count(completed_header_block))
		Waiting(_) => 0
		Failed(_, _) => 0
	end
end

fn step_completed_header_block(step: Http2Step) -> ByteChunk
	match step
		FrameDecoded(_, _, _, _, _, _, completed_header_block, _) => completed_header_block
		Waiting(_) => empty_header_block()
		Failed(_, _) => empty_header_block()
	end
end

fn state_pending_count(state: Http2DecodeState) -> Int
	match state
		State(pending, _, _, _, _, _, _, _) => byte_count_to_int(byte_chunk_count(pending))
	end
end

fn state_next_offset(state: Http2DecodeState) -> Int
	match state
		State(_, next_offset, _, _, _, _, _, _) => next_offset
	end
end

fn state_preface_label(state: Http2DecodeState) -> String
	match state
		State(_, _, ExpectPreface, _, _, _, _, _) => "expect"
		State(_, _, AfterPreface, _, _, _, _, _) => "done"
	end
end

fn state_continuation_label(state: Http2DecodeState) -> String
	match state
		State(_, _, _, NoContinuation, _, _, _, _) => "none"
		State(_, _, _, Continuation(_, _, _, _), _, _, _, _) => "active"
	end
end

fn state_continuation_count(state: Http2DecodeState) -> Int
	match state
		State(_, _, _, NoContinuation, _, _, _, _) => 0
		State(_, _, _, Continuation(_, _, _, accumulated), _, _, _, _) => byte_count_to_int(byte_chunk_count(accumulated))
	end
end

fn state_continuation_stream(state: Http2DecodeState) -> Int
	match state
		State(_, _, _, NoContinuation, _, _, _, _) => 0
		State(_, _, _, Continuation(stream_id, _, _, _), _, _, _, _) => stream_id
	end
end

fn state_continuation_started_kind(state: Http2DecodeState) -> Int
	match state
		State(_, _, _, NoContinuation, _, _, _, _) => 0
		State(_, _, _, Continuation(_, started_kind, _, _), _, _, _, _) => started_kind
	end
end

fn state_continuation_started_offset(state: Http2DecodeState) -> Int
	match state
		State(_, _, _, NoContinuation, _, _, _, _) => 0
		State(_, _, _, Continuation(_, _, started_offset, _), _, _, _, _) => started_offset
	end
end

fn state_peer_max_frame_size(state: Http2DecodeState) -> Int
	match state
		State(_, _, _, _, _, PeerSettings(NoPeerMaxFrameSize, _), _, _) => 0
		State(_, _, _, _, _, PeerSettings(PeerMaxFrameSize(value, _), _), _, _) => value
	end
end

fn state_peer_max_frame_size_offset(state: Http2DecodeState) -> Int
	match state
		State(_, _, _, _, _, PeerSettings(NoPeerMaxFrameSize, _), _, _) => 0
		State(_, _, _, _, _, PeerSettings(PeerMaxFrameSize(_, item_offset), _), _, _) => item_offset
	end
end

fn state_peer_initial_window_size(state: Http2DecodeState) -> Int
	match state
		State(_, _, _, _, _, PeerSettings(_, NoPeerInitialWindowSize), _, _) => 0
		State(_, _, _, _, _, PeerSettings(_, PeerInitialWindowSize(value, _)), _, _) => value
	end
end

fn state_peer_initial_window_size_offset(state: Http2DecodeState) -> Int
	match state
		State(_, _, _, _, _, PeerSettings(_, NoPeerInitialWindowSize), _, _) => 0
		State(_, _, _, _, _, PeerSettings(_, PeerInitialWindowSize(_, item_offset)), _, _) => item_offset
	end
end

fn state_shutdown_label(state: Http2DecodeState) -> String
	match state
		State(_, _, _, _, _, _, OpenConnection, _) => "open"
		State(_, _, _, _, _, _, GracefulShutdown(_, _), _) => "graceful_shutdown"
	end
end

fn state_shutdown_last_stream_id(state: Http2DecodeState) -> Int
	match state
		State(_, _, _, _, _, _, OpenConnection, _) => 0
		State(_, _, _, _, _, _, GracefulShutdown(last_stream_id, _), _) => last_stream_id
	end
end

fn state_shutdown_error_code(state: Http2DecodeState) -> Int
	match state
		State(_, _, _, _, _, _, OpenConnection, _) => 0
		State(_, _, _, _, _, _, GracefulShutdown(_, error_code), _) => error_code
	end
end

fn state_connection_window(state: Http2DecodeState) -> Int
	match state
		State(_, _, _, _, _, _, _, ReceiveFlowControl(connection_window, _)) => connection_window
	end
end

fn state_stream_window(state: Http2DecodeState) -> Int
	match state
		State(_, _, _, _, _, _, _, ReceiveFlowControl(_, NoOpenStreamReceiveWindow)) => 0
		State(_, _, _, _, _, _, _, ReceiveFlowControl(_, OpenStreamReceiveWindow(_, stream_window))) => stream_window
