	stdio::println(int_to_string(count))
end

fn emit_encoded_header(name: String, bytes: ByteChunk, expected_hex: String) -> Result<(), String> effects [stdio]
	emit_output_chunk_list_header(name, 1)
	emit_output_chunk(name, 0, bytes, expected_hex)
end

fn emit_header_block(name: String, step: Http2Step, expected_hex: String) -> Result<(), String> effects [stdio]
	emit_output_chunk_list_header(name, 1)
	emit_output_chunk(name, 0, step_completed_header_block(step), expected_hex)
end

fn emit_frame_payload(name: String, step: Http2Step, expected_hex: String) -> Result<(), String> effects [stdio]
	emit_output_chunk_list_header(name, 1)
	emit_output_chunk(name, 0, step_frame_payload_chunk(step), expected_hex)
end

fn print_hpack_decoded(label: String, transition: HpackDecodeTransition) -> () effects [stdio]
	let headers: HpackHeaderList = hpack_fixture::transition_headers(transition)
	stdio::print(label)
	stdio::print(" hpack decoded ")
	stdio::print(hpack_fixture::header_list_first_name(headers))
	stdio::print(" ")
	stdio::print(hpack_fixture::header_list_first_value(headers))
	stdio::print(" wire_size ")
	stdio::print(int_to_string(hpack_fixture::header_list_wire_size(headers)))
	stdio::print(" next_decode_count ")
	stdio::println(int_to_string(hpack_fixture::state_decode_count(hpack_fixture::transition_state(transition))))
end

fn print_hpack_failed(label: String, failure: HpackFixtureFailure) -> () effects [stdio]
	stdio::print(label)
	stdio::print(" hpack failed ")
	stdio::println(hpack_fixture::hpack_failure_expected_fixture(failure))
end

fn print_hpack_transition(label: String, step: Http2Step) -> () effects [stdio]
	match hpack_fixture::decode_header_block(step_completed_header_block(step), hpack_fixture::initial_state(), step_offset(step))
		Ok(transition) => print_hpack_decoded(label, transition)
		Err(failure) => print_hpack_failed(label, failure)
	end
end

fn unexpected_frame_header_encode_failure() -> Result<(), String> effects [stdio]
	stdio::println("unexpected frame header encode failure")
	Ok(())
end

fn print_encoded_header(name: String, encoded: Result<ByteChunk, EncodeError>, expected_hex: String) -> Result<(), String> effects [stdio]
	match encoded
		Ok(bytes) => emit_encoded_header(name, bytes, expected_hex)
		Err(_) => unexpected_frame_header_encode_failure()
	end
end

fn encode_error_id(error: EncodeError) -> String
	match error
		EncodeError(id, _, _) => id
	end
end

fn encode_error_path(error: EncodeError) -> String
	match error
		EncodeError(_, field_path, _) => field_path
	end
end

fn encode_error_reason(error: EncodeError) -> String
	match error
		EncodeError(_, _, reason) => reason
	end
end

fn print_encode_error_detail(label: String, error: EncodeError) -> () effects [stdio]
	stdio::print(label)
	stdio::print(" encode_error ")
	stdio::print(encode_error_id(error))
	stdio::print(" ")
	stdio::print(encode_error_path(error))
	stdio::print(" ")
	stdio::println(encode_error_reason(error))
end

fn print_encode_error(label: String, encoded: Result<ByteChunk, EncodeError>) -> () effects [stdio]
	match encoded
		Ok(_) => stdio::println("unexpected frame header encode success")
		Err(error) => print_encode_error_detail(label, error)
	end
end

