fn context_expected_stream(failure: Http2ProtocolFailure, state: Http2DecodeState) -> Int
	match failure_expected_stream(failure) == 0
		true => state_continuation_stream(state)
		false => failure_expected_stream(failure)
	end
end

fn context_expected_kind(failure: Http2ProtocolFailure, state: Http2DecodeState) -> Int
	match failure_expected_kind(failure) == 0
		true => match state_continuation_label(state) == "active"
			true => 9
			false => 0
		end
		false => failure_expected_kind(failure)
	end
end

fn context_started_kind(failure: Http2ProtocolFailure, state: Http2DecodeState) -> Int
	match failure_started_kind(failure) == 0
		true => state_continuation_started_kind(state)
		false => failure_started_kind(failure)
	end
end

fn context_started_offset(failure: Http2ProtocolFailure, state: Http2DecodeState) -> Int
	match failure_started_offset(failure) == 0
		true => state_continuation_started_offset(state)
		false => failure_started_offset(failure)
	end
end

fn context_active_state(failure: Http2ProtocolFailure, state: Http2DecodeState) -> String
	match failure_active_state(failure) == "none"
		true => match state_continuation_label(state) == "active"
			true => "headers"
			false => "none"
		end
		false => failure_active_state(failure)
	end
end

fn context_rule_provenance(failure: Http2ProtocolFailure, state: Http2DecodeState) -> String
	match failure_rule_provenance(failure) == "none"
		true => match state_continuation_label(state) == "active"
			true => "rfc9113_continuation_sequence"
			false => "none"
		end
		false => failure_rule_provenance(failure)
	end
end

fn diagnostic_context_state(context: Http2DiagnosticContext) -> Http2DecodeState
	match context
		DiagnosticContext(state) => state
	end
end

fn diagnostic_context_pending_view(context: Http2DiagnosticContext) -> Result<ByteView, String>
	let pending: ByteChunk = state_pending_chunk(diagnostic_context_state(context))
	byte_view(pending, byte_offset(0)?, byte_chunk_count(pending))
end

fn http2_protocol_diagnostic(failure: Http2ProtocolFailure, context: Http2DiagnosticContext) -> Result<(), String>
	match failure
		ClosedWithPending(offset, pending_count) => http2_protocol_closed_with_pending(offset, pending_count, state_continuation_label(diagnostic_context_state(context)))
		ClosedWithPartialPreface(offset, pending_count) => http2_protocol_partial_preface(offset, pending_count, diagnostic_context_pending_view(context)?)
		InvalidPreface(offset, expected_byte, actual_byte, matched_count) => http2_protocol_invalid_preface(offset, expected_byte, actual_byte, matched_count, diagnostic_context_pending_view(context)?)
		ContinuationExpected(offset, actual_kind, actual_stream, expected_stream, started_kind, started_offset) => http2_protocol_continuation_expected(offset, actual_kind, actual_stream, expected_stream, started_kind, started_offset, state_continuation_label(diagnostic_context_state(context)))
		InvalidFrameKind(offset, actual_kind, stream_id, expected_kind, active_state, rule_provenance) => http2_protocol_invalid_frame_kind(offset, actual_kind, stream_id, expected_kind, active_state, rule_provenance, empty_byte_preview()?)
		InvalidStreamId(offset, frame_kind, stream_id, required_domain, endpoint_role, active_state, rule_provenance) => http2_protocol_invalid_stream_id(offset, frame_kind, stream_id, required_domain, endpoint_role, active_state, rule_provenance)
		InvalidPayloadLength(offset, frame_kind, stream_id, observed_length, expected_length, active_state, rule_provenance, preview) => http2_protocol_invalid_payload_length(offset, frame_kind, stream_id, observed_length, expected_length, active_state, rule_provenance, preview)
		UnexpectedSettingsAck(offset, active_state, rule_provenance) => http2_protocol_unexpected_settings_ack(offset, active_state, rule_provenance)
		InvalidPriorityDependency(offset, stream_id, dependency_stream_id, active_state, rule_provenance, preview) => http2_protocol_invalid_priority_dependency(offset, stream_id, dependency_stream_id, active_state, rule_provenance, preview)
		StreamAfterGoaway(offset, stream_id, last_stream_id, shutdown_state, endpoint_role, rule_provenance) => http2_protocol_stream_after_goaway(offset, stream_id, last_stream_id, shutdown_state, endpoint_role, rule_provenance)
		FrameSizeExceeded(offset, observed_length, receive_limit, frame_kind, stream_id) => http2_peer_limit_frame_size_exceeded(offset, observed_length, receive_limit_value(receive_limit), frame_kind, stream_id, receive_limit_provenance_label(receive_limit))
		FlowControlWindowExceeded(offset, frame_kind, stream_id, observed_length, allowed_window_credit, active_state, rule_provenance) => http2_peer_limit_flow_control_window_exceeded(offset, observed_length, allowed_window_credit, frame_kind, stream_id, active_state, rule_provenance)
		ConcurrentStreamsExceeded(offset, stream_id, attempted_count, allowed_count, active_state, receive_limit_provenance, rule_provenance) => http2_peer_limit_concurrent_streams_exceeded(offset, stream_id, attempted_count, allowed_count, active_state, receive_limit_provenance, rule_provenance)
		HeaderListSizeExceeded(offset, observed_size, receive_limit, frame_kind, stream_id, rule_provenance) => http2_peer_limit_header_list_size_exceeded(offset, observed_size, receive_limit_value(receive_limit), frame_kind, stream_id, receive_limit_provenance_label(receive_limit), rule_provenance)
		SettingsValueOutOfRange(offset, setting_identifier, setting_name, observed_value, accepted_min_value, accepted_max_value, peer_limit_provenance) => http2_peer_limit_settings_value_out_of_range(offset, setting_identifier, setting_name, observed_value, accepted_min_value, accepted_max_value, peer_limit_provenance)
		InvalidDataPadding(offset, stream_id, pad_length, remaining_payload_length, active_state, rule_provenance, preview) => http2_protocol_invalid_data_padding(offset, stream_id, pad_length, remaining_payload_length, active_state, rule_provenance, preview)
		HpackFixtureDecodeFailed(offset, observed_size, observed_first_byte, expected_fixture, codec_module) => hpack_fixture_unsupported_header_block(offset, observed_size, observed_first_byte, expected_fixture, codec_module)
	end
end

