	let goaway_allowed_headers: Http2Step = receive(InputChunk(byte_chunk_from_hex("000000010400000005")?), step_state(goaway))?
	print_step("goaway-allowed-headers", goaway_allowed_headers)
	print_peer_streams("goaway-allowed-headers", step_state(goaway_allowed_headers))
	let goaway_late_headers: Http2Step = receive(InputChunk(byte_chunk_from_hex("000000010400000007")?), step_state(goaway))?
	print_goaway_stream_failure("goaway-late-headers", goaway_late_headers)
	let goaway_even_headers: Http2Step = receive(InputChunk(byte_chunk_from_hex("000000010400000006")?), step_state(goaway))?
	print_stream_id_failure("goaway-even-headers", goaway_even_headers)
	let goaway_bad_length: Http2Step = receive(InputChunk(byte_chunk_from_hex("00000707000000000000000005000000")?), frame_state())?
	print_failure("goaway-length", goaway_bad_length)
	let goaway_bad_stream: Http2Step = receive(InputChunk(byte_chunk_from_hex("000008070000000001000000050000000b")?), frame_state())?
	print_failure("goaway-stream", goaway_bad_stream)
	let encoded_settings_header: Result<ByteChunk, EncodeError> = encode_frame_header({length: 0, kind: 4, flags: 0, stream_id: 0})
	let ignored_settings_header: () = print_encoded_header("http2-settings-header", encoded_settings_header, "000000040000000000")?
	let encoded_data_header: Result<ByteChunk, EncodeError> = encode_frame_header({length: 5, kind: 0, flags: 1, stream_id: 1})
	let ignored_data_header: () = print_encoded_header("http2-data-header", encoded_data_header, "000005000100000001")?
	let encoded_max_stream_header: Result<ByteChunk, EncodeError> = encode_frame_header({length: 0, kind: 8, flags: 0, stream_id: 2147483647})
	let ignored_max_stream_header: () = print_encoded_header("http2-max-stream-header", encoded_max_stream_header, "00000008007fffffff")?
	let invalid_stream_header: Result<ByteChunk, EncodeError> = encode_frame_header({length: 0, kind: 0, flags: 0, stream_id: 2147483648})
	print_encode_error("http2-stream-id-range", invalid_stream_header)
	Ok(())
end
