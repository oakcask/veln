fn print_hpack_header_block_case(state: Http2DecodeState, label: String, output_label: String, frame_hex: String, block_hex: String) -> Result<(), String> effects [stdio]
	let step: Http2Step = receive(InputChunk(byte_chunk_from_hex(frame_hex)?), state)?
	print_step(label, step)
	let ignored: () = emit_header_block(output_label, step, block_hex)?
	print_hpack_transition(label, step)
	Ok(())
end

fn print_hpack_header_block_case_with_header(state: Http2DecodeState, label: String, output_label: String, frame_hex: String, block_hex: String, expected_name: String, expected_value: String) -> Result<(), String> effects [stdio]
	let step: Http2Step = receive(InputChunk(byte_chunk_from_hex(frame_hex)?), state)?
	print_step(label, step)
	let ignored_emit: () = emit_header_block(output_label, step, block_hex)?
	print_hpack_transition(label, step)
	require_hpack_transition_header(step, state, expected_name, expected_value)
end

