end

fn project_flow_control_window_payload(offset: Int, observed_length: Int, allowed_window_credit: Int, frame_kind: Int, stream_id: Int, active_state: String, rule_provenance: String, preview_chunk: ByteChunk) -> Result<(), RuntimeDiagnostic>
	Err(flow_control_window_runtime_payload(offset, observed_length, allowed_window_credit, frame_kind, stream_id, active_state, rule_provenance, preview_chunk))
end

fn project_invalid_data_padding_payload(offset: Int, stream_id: Int, pad_length: Int, remaining_payload_length: Int, active_state: String, rule_provenance: String, preview_chunk: ByteChunk) -> Result<(), RuntimeDiagnostic>
	Err(invalid_data_padding_runtime_payload(offset, stream_id, pad_length, remaining_payload_length, active_state, rule_provenance, preview_chunk))
end

fn project_content_length_mismatch_payload(offset: Int, frame_kind: Int, stream_id: Int, expected_length: Int, observed_length: Int, active_state: String, rule_provenance: String, preview_chunk: ByteChunk) -> Result<(), RuntimeDiagnostic>
	Err(content_length_mismatch_runtime_payload(offset, frame_kind, stream_id, expected_length, observed_length, active_state, rule_provenance, preview_chunk))
end

fn project_priority_dependency_payload(offset: Int, stream_id: Int, dependency_stream_id: Int, active_state: String, rule_provenance: String, preview_chunk: ByteChunk) -> Result<(), RuntimeDiagnostic>
	Err(priority_dependency_runtime_payload(offset, stream_id, dependency_stream_id, active_state, rule_provenance, preview_chunk))
end

fn hpack_static_unsupported_index(offset: Int, observed_size: Int, observed_first_byte: Int, expected_header: String, decoder_module: String, preview_chunk: ByteChunk) -> Result<(), RuntimeDiagnostic>
	Err(RuntimeDiagnostic("hpack.static.unsupported_index", "HPACK static index is not supported", RuntimeHpackFixtureDiagnostic(offset, observed_size, observed_first_byte, expected_header, decoder_module, preview_chunk)))
end

fn accept_runtime_diagnostic(result: Result<(), RuntimeDiagnostic>) -> Result<(), String>
	match result
		Ok(_) => Ok(())
		Err(_) => Ok(())
	end
end

fn project_closed_step_payload(step: Http2Step) -> Result<(), String>
	accept_runtime_diagnostic(project_closed_with_pending_payload(failure_offset(step_failure(step)), failure_pending_count(step_failure(step)), state_continuation_label(step_state(step)), state_pending_chunk(step_state(step))))
end

fn project_continuation_step_payload(step: Http2Step, preview_chunk: ByteChunk) -> Result<(), String>
	accept_runtime_diagnostic(project_continuation_expected_payload(failure_offset(step_failure(step)), failure_actual_kind(step_failure(step)), failure_actual_stream(step_failure(step)), context_expected_stream(step_failure(step), step_state(step)), context_started_kind(step_failure(step), step_state(step)), context_started_offset(step_failure(step), step_state(step)), state_continuation_label(step_state(step)), preview_chunk))
end

fn http2_protocol_diagnostic(failure: Http2ProtocolFailure, context: Http2DiagnosticContext) -> Result<(), String>
	match failure
		ClosedWithPending(offset, pending_count, preview_chunk) => accept_runtime_diagnostic(http2_protocol_closed_with_pending(offset, pending_count, state_continuation_label(diagnostic_context_state(context)), byte_chunk_view(preview_chunk)?))
		ClosedWithPartialPreface(offset, pending_count) => accept_runtime_diagnostic(http2_protocol_partial_preface(offset, pending_count, diagnostic_context_pending_view(context)?))
		InvalidPreface(offset, expected_byte, actual_byte, matched_count) => accept_runtime_diagnostic(http2_protocol_invalid_preface(offset, expected_byte, actual_byte, matched_count, diagnostic_context_pending_view(context)?))
		ContinuationExpected(offset, actual_kind, actual_stream, expected_stream, started_kind, started_offset, preview_chunk) => accept_runtime_diagnostic(http2_protocol_continuation_expected(offset, actual_kind, actual_stream, expected_stream, started_kind, started_offset, state_continuation_label(diagnostic_context_state(context)), byte_chunk_view(preview_chunk)?))
		InvalidFrameKind(offset, actual_kind, stream_id, expected_kind, active_state, rule_provenance) => accept_runtime_diagnostic(http2_protocol_invalid_frame_kind(offset, actual_kind, stream_id, expected_kind, active_state, rule_provenance, empty_byte_preview()?))
			InvalidStreamId(offset, frame_kind, stream_id, required_domain, endpoint_role, active_state, rule_provenance) => accept_runtime_diagnostic(http2_protocol_invalid_stream_id(offset, frame_kind, stream_id, required_domain, endpoint_role, active_state, rule_provenance, diagnostic_context_pending_view(context)?))
			InvalidPayloadLength(offset, frame_kind, stream_id, observed_length, expected_length, active_state, rule_provenance, preview) => accept_runtime_diagnostic(http2_protocol_invalid_payload_length(offset, frame_kind, stream_id, observed_length, expected_length, active_state, rule_provenance, preview))
			InvalidWindowUpdateIncrement(offset, stream_id, observed_increment, accepted_min_increment, accepted_max_increment, active_state, rule_provenance, preview) => accept_runtime_diagnostic(http2_protocol_invalid_window_update_increment(offset, stream_id, observed_increment, accepted_min_increment, accepted_max_increment, active_state, rule_provenance, preview))
			InvalidRequestHeaderList(offset, frame_kind, stream_id, failed_header_fact, header_name, decoded_header_names, preview_chunk) => accept_runtime_diagnostic(http2_protocol_invalid_request_header_list(offset, frame_kind, stream_id, failed_header_fact, header_name, decoded_header_names, failure_active_state(failure), failure_rule_provenance(failure), byte_chunk_view(preview_chunk)?))
			InvalidResponseHeaderList(offset, frame_kind, stream_id, failed_header_fact, header_name, decoded_header_names, active_state, preview_chunk) => accept_runtime_diagnostic(http2_protocol_invalid_response_header_list(offset, frame_kind, stream_id, failed_header_fact, header_name, decoded_header_names, failure_active_state(failure), failure_rule_provenance(failure), byte_chunk_view(preview_chunk)?))
			UnexpectedSettingsAck(offset, active_state, rule_provenance, preview) => accept_runtime_diagnostic(http2_protocol_unexpected_settings_ack(offset, active_state, rule_provenance, preview))
		InvalidPriorityDependency(offset, stream_id, dependency_stream_id, active_state, rule_provenance, preview) => accept_runtime_diagnostic(project_priority_dependency_payload(offset, stream_id, dependency_stream_id, active_state, rule_provenance, byte_view_to_chunk(preview)))
		StreamAfterGoaway(offset, stream_id, last_stream_id, shutdown_state, endpoint_role, rule_provenance, preview_chunk) => accept_runtime_diagnostic(http2_protocol_stream_after_goaway(offset, stream_id, last_stream_id, shutdown_state, endpoint_role, rule_provenance, byte_chunk_view(preview_chunk)?))
		FrameSizeExceeded(offset, observed_length, receive_limit, frame_kind, stream_id) => accept_runtime_diagnostic(http2_peer_limit_frame_size_exceeded(offset, observed_length, receive_limit_value(receive_limit), frame_kind, stream_id, receive_limit_provenance_label(receive_limit), diagnostic_context_pending_view(context)?))
		FlowControlWindowExceeded(offset, frame_kind, stream_id, observed_length, allowed_window_credit, active_state, rule_provenance, preview_chunk) => accept_runtime_diagnostic(project_flow_control_window_payload(offset, observed_length, allowed_window_credit, frame_kind, stream_id, active_state, rule_provenance, preview_chunk))
		ConcurrentStreamsExceeded(offset, stream_id, attempted_count, allowed_count, endpoint_role, active_state, receive_limit_provenance, rule_provenance, preview_chunk) => accept_runtime_diagnostic(http2_peer_limit_concurrent_streams_exceeded(offset, stream_id, attempted_count, allowed_count, endpoint_role, active_state, receive_limit_provenance, rule_provenance, byte_view(preview_chunk, byte_offset(0)?, byte_chunk_count(preview_chunk))?))
		HeaderListSizeExceeded(offset, observed_size, receive_limit, frame_kind, stream_id, rule_provenance, preview_chunk) => accept_runtime_diagnostic(http2_peer_limit_header_list_size_exceeded(offset, observed_size, receive_limit_value(receive_limit), frame_kind, stream_id, receive_limit_provenance_label(receive_limit), rule_provenance, byte_view(preview_chunk, byte_offset(0)?, byte_chunk_count(preview_chunk))?))
		HeaderTableSizeExceeded(offset, observed_size, receive_limit, frame_kind, stream_id, rule_provenance, preview_chunk) => accept_runtime_diagnostic(http2_peer_limit_header_table_size_exceeded(offset, observed_size, receive_limit_value(receive_limit), frame_kind, stream_id, receive_limit_provenance_label(receive_limit), rule_provenance, byte_view(preview_chunk, byte_offset(0)?, byte_chunk_count(preview_chunk))?))
		SettingsValueOutOfRange(offset, setting_identifier, setting_name, observed_value, accepted_min_value, accepted_max_value, peer_limit_provenance, preview) => accept_runtime_diagnostic(http2_peer_limit_settings_value_out_of_range(offset, setting_identifier, setting_name, observed_value, accepted_min_value, accepted_max_value, peer_limit_provenance, preview))
		InvalidDataPadding(offset, stream_id, pad_length, remaining_payload_length, active_state, rule_provenance, preview) => accept_runtime_diagnostic(project_invalid_data_padding_payload(offset, stream_id, pad_length, remaining_payload_length, active_state, rule_provenance, byte_view_to_chunk(preview)))
		ContentLengthMismatch(offset, frame_kind, stream_id, expected_length, observed_length, active_state, rule_provenance, preview) => accept_runtime_diagnostic(project_content_length_mismatch_payload(offset, frame_kind, stream_id, expected_length, observed_length, active_state, rule_provenance, byte_view_to_chunk(preview)))
		HpackTableSizeUpdateNotAtStart(offset, observed_size, observed_first_byte, observed_update_size, frame_kind, stream_id, active_state, expected_fixture, codec_module, preview_chunk) => match expected_fixture == "fixture HPACK table-size update without trailing bytes"
			true => accept_runtime_diagnostic(hpack_fixture_table_size_update_trailing_bytes(offset, observed_size, observed_first_byte, observed_update_size, frame_kind, stream_id, active_state, expected_fixture, codec_module, byte_view(preview_chunk, byte_offset(0)?, byte_chunk_count(preview_chunk))?))
			false => accept_runtime_diagnostic(hpack_fixture_table_size_update_not_at_start(offset, observed_size, observed_first_byte, observed_update_size, frame_kind, stream_id, active_state, expected_fixture, codec_module, byte_view(preview_chunk, byte_offset(0)?, byte_chunk_count(preview_chunk))?))
		end
		HpackFixtureDecodeFailed(offset, observed_size, observed_first_byte, requested_dynamic_index, dynamic_table_entry_count, expected_fixture, codec_module, preview_chunk) => match expected_fixture == "HPACK static indexed header" and codec_module == "hpack_static"
			true => accept_runtime_diagnostic(hpack_static_unsupported_index(offset, observed_size, observed_first_byte, expected_fixture, codec_module, preview_chunk))
			false => match hpack_fixture_failure_id(expected_fixture) == "hpack.fixture.unsupported_static_index"
			true => accept_runtime_diagnostic(hpack_fixture_unsupported_static_index(offset, observed_size, observed_first_byte, expected_fixture, codec_module, byte_view(preview_chunk, byte_offset(0)?, byte_chunk_count(preview_chunk))?))
			false => match hpack_fixture_failure_id(expected_fixture) == "hpack.fixture.table_size_update_malformed"
			true => accept_runtime_diagnostic(hpack_fixture_table_size_update_malformed(offset, observed_size, observed_first_byte, expected_fixture, codec_module, byte_view(preview_chunk, byte_offset(0)?, byte_chunk_count(preview_chunk))?))
			false => match hpack_fixture_failure_id(expected_fixture) == "hpack.fixture.malformed_string_length"
			true => accept_runtime_diagnostic(hpack_fixture_malformed_string_length(offset, observed_size, observed_first_byte, expected_fixture, codec_module, byte_view(preview_chunk, byte_offset(0)?, byte_chunk_count(preview_chunk))?))
			false => match hpack_fixture_failure_id(expected_fixture) == "hpack.fixture.malformed_raw_string_value"
				true => accept_runtime_diagnostic(hpack_fixture_malformed_raw_string_value(offset, observed_size, observed_first_byte, expected_fixture, codec_module, byte_view(preview_chunk, byte_offset(0)?, byte_chunk_count(preview_chunk))?))
				false => match hpack_fixture_failure_id(expected_fixture) == "hpack.fixture.malformed_huffman_padding"
					true => accept_runtime_diagnostic(hpack_fixture_malformed_huffman_padding(offset, observed_size, observed_first_byte, expected_fixture, codec_module, byte_view(preview_chunk, byte_offset(0)?, byte_chunk_count(preview_chunk))?))
					false => match hpack_fixture_failure_id(expected_fixture) == "hpack.fixture.huffman_eos_symbol"
						true => accept_runtime_diagnostic(hpack_fixture_huffman_eos_symbol(offset, observed_size, observed_first_byte, expected_fixture, codec_module, byte_view(preview_chunk, byte_offset(0)?, byte_chunk_count(preview_chunk))?))
						false => match hpack_fixture_failure_id(expected_fixture) == "hpack.fixture.huffman_non_visible_value"
							true => accept_runtime_diagnostic(hpack_fixture_huffman_non_visible_value(offset, observed_size, observed_first_byte, expected_fixture, codec_module, byte_view(preview_chunk, byte_offset(0)?, byte_chunk_count(preview_chunk))?))
							false => match hpack_fixture_failure_id(expected_fixture) == "hpack.fixture.dynamic_index_out_of_range"
								true => accept_runtime_diagnostic(hpack_fixture_dynamic_index_out_of_range(offset, observed_size, observed_first_byte, requested_dynamic_index, dynamic_table_entry_count, expected_fixture, codec_module, byte_view(preview_chunk, byte_offset(0)?, byte_chunk_count(preview_chunk))?))
								false => match hpack_fixture_failure_id(expected_fixture) == "hpack.fixture.dynamic_name_continuation_missing"
									true => accept_runtime_diagnostic(hpack_fixture_dynamic_name_continuation_missing(offset, observed_size, observed_first_byte, requested_dynamic_index, dynamic_table_entry_count, expected_fixture, codec_module, byte_view(preview_chunk, byte_offset(0)?, byte_chunk_count(preview_chunk))?))
									false => match hpack_fixture_failure_id(expected_fixture) == "hpack.fixture.dynamic_name_continuation_malformed"
										true => accept_runtime_diagnostic(hpack_fixture_dynamic_name_continuation_malformed(offset, observed_size, observed_first_byte, requested_dynamic_index, dynamic_table_entry_count, expected_fixture, codec_module, byte_view(preview_chunk, byte_offset(0)?, byte_chunk_count(preview_chunk))?))
										false => match hpack_fixture_failure_id(expected_fixture) == "hpack.fixture.dynamic_name_continuation_out_of_range"
											true => accept_runtime_diagnostic(hpack_fixture_dynamic_name_continuation_out_of_range(offset, observed_size, observed_first_byte, requested_dynamic_index, dynamic_table_entry_count, expected_fixture, codec_module, byte_view(preview_chunk, byte_offset(0)?, byte_chunk_count(preview_chunk))?))
											false => accept_runtime_diagnostic(hpack_fixture_unsupported_header_block(offset, observed_size, observed_first_byte, expected_fixture, codec_module, byte_view(preview_chunk, byte_offset(0)?, byte_chunk_count(preview_chunk))?))
										end
									end
								end
							end
						end
					end
				end
			end
			end
		end
	end
end
	end
end

fn failure_required_stream_id_domain(failure: Http2ProtocolFailure) -> String
	match failure
		ClosedWithPending(_, _, _) => "none"
		ClosedWithPartialPreface(_, _) => "none"
		InvalidPreface(_, _, _, _) => "none"
		ContinuationExpected(offset, actual_kind, actual_stream, expected_stream, started_kind, started_offset, preview_chunk) => "none"
		InvalidFrameKind(offset, actual_kind, stream_id, expected_kind, active_state, rule_provenance) => "none"
			InvalidStreamId(offset, frame_kind, stream_id, required_domain, endpoint_role, active_state, rule_provenance) => required_domain
			InvalidPayloadLength(offset, frame_kind, stream_id, observed_length, expected_length, active_state, rule_provenance, preview) => "none"
			InvalidWindowUpdateIncrement(offset, stream_id, observed_increment, accepted_min_increment, accepted_max_increment, active_state, rule_provenance, preview) => "none"
			InvalidDataPadding(offset, stream_id, pad_length, remaining_payload_length, active_state, rule_provenance, preview) => "none"
			ContentLengthMismatch(offset, frame_kind, stream_id, expected_length, observed_length, active_state, rule_provenance, preview) => "none"
			InvalidRequestHeaderList(offset, frame_kind, stream_id, failed_header_fact, header_name, decoded_header_names, preview_chunk) => "request pseudo-header list"
			InvalidResponseHeaderList(offset, frame_kind, stream_id, failed_header_fact, header_name, decoded_header_names, active_state, preview_chunk) => "response pseudo-header list"
			UnexpectedSettingsAck(_, _, _, _) => "none"
		InvalidPriorityDependency(offset, stream_id, dependency_stream_id, active_state, rule_provenance, preview) => "none"
		StreamAfterGoaway(offset, stream_id, last_stream_id, shutdown_state, endpoint_role, rule_provenance, preview_chunk) => "none"
		FrameSizeExceeded(offset, observed_length, receive_limit, frame_kind, stream_id) => "none"
		FlowControlWindowExceeded(offset, frame_kind, stream_id, observed_length, allowed_window_credit, active_state, rule_provenance, preview_chunk) => "none"
		ConcurrentStreamsExceeded(offset, stream_id, attempted_count, allowed_count, endpoint_role, active_state, receive_limit_provenance, rule_provenance, preview_chunk) => "none"
		HeaderListSizeExceeded(offset, observed_size, receive_limit, frame_kind, stream_id, rule_provenance, preview_chunk) => "none"
		HeaderTableSizeExceeded(offset, observed_size, receive_limit, frame_kind, stream_id, rule_provenance, preview_chunk) => "none"
		SettingsValueOutOfRange(offset, setting_identifier, setting_name, observed_value, accepted_min_value, accepted_max_value, peer_limit_provenance, preview) => "none"
		HpackFixtureDecodeFailed(offset, observed_size, observed_first_byte, requested_dynamic_index, dynamic_table_entry_count, expected_fixture, codec_module, preview_chunk) => "none"
		HpackTableSizeUpdateNotAtStart(offset, observed_size, observed_first_byte, observed_update_size, frame_kind, stream_id, active_state, expected_fixture, codec_module, preview_chunk) => "none"
	end
end

fn failure_endpoint_role(failure: Http2ProtocolFailure) -> String
	match failure
		ClosedWithPending(_, _, _) => "none"
		ClosedWithPartialPreface(_, _) => "none"
		InvalidPreface(_, _, _, _) => "none"
		ContinuationExpected(offset, actual_kind, actual_stream, expected_stream, started_kind, started_offset, preview_chunk) => "none"
		InvalidFrameKind(offset, actual_kind, stream_id, expected_kind, active_state, rule_provenance) => "none"
			InvalidStreamId(offset, frame_kind, stream_id, required_domain, endpoint_role, active_state, rule_provenance) => endpoint_role
			InvalidPayloadLength(offset, frame_kind, stream_id, observed_length, expected_length, active_state, rule_provenance, preview) => "none"
			InvalidWindowUpdateIncrement(offset, stream_id, observed_increment, accepted_min_increment, accepted_max_increment, active_state, rule_provenance, preview) => "none"
			InvalidDataPadding(offset, stream_id, pad_length, remaining_payload_length, active_state, rule_provenance, preview) => "none"
			ContentLengthMismatch(offset, frame_kind, stream_id, expected_length, observed_length, active_state, rule_provenance, preview) => "none"
			InvalidRequestHeaderList(offset, frame_kind, stream_id, failed_header_fact, header_name, decoded_header_names, preview_chunk) => "server"
			InvalidResponseHeaderList(offset, frame_kind, stream_id, failed_header_fact, header_name, decoded_header_names, active_state, preview_chunk) => "server"
			UnexpectedSettingsAck(_, _, _, _) => "none"
		InvalidPriorityDependency(offset, stream_id, dependency_stream_id, active_state, rule_provenance, preview) => "none"
		StreamAfterGoaway(offset, stream_id, last_stream_id, shutdown_state, endpoint_role, rule_provenance, preview_chunk) => endpoint_role
		FrameSizeExceeded(offset, observed_length, receive_limit, frame_kind, stream_id) => "none"
		FlowControlWindowExceeded(offset, frame_kind, stream_id, observed_length, allowed_window_credit, active_state, rule_provenance, preview_chunk) => "none"
		ConcurrentStreamsExceeded(offset, stream_id, attempted_count, allowed_count, endpoint_role, active_state, receive_limit_provenance, rule_provenance, preview_chunk) => endpoint_role
		HeaderListSizeExceeded(offset, observed_size, receive_limit, frame_kind, stream_id, rule_provenance, preview_chunk) => "none"
		HeaderTableSizeExceeded(offset, observed_size, receive_limit, frame_kind, stream_id, rule_provenance, preview_chunk) => "none"
		SettingsValueOutOfRange(offset, setting_identifier, setting_name, observed_value, accepted_min_value, accepted_max_value, peer_limit_provenance, preview) => "none"
		HpackFixtureDecodeFailed(offset, observed_size, observed_first_byte, requested_dynamic_index, dynamic_table_entry_count, expected_fixture, codec_module, preview_chunk) => "none"
		HpackTableSizeUpdateNotAtStart(offset, observed_size, observed_first_byte, observed_update_size, frame_kind, stream_id, active_state, expected_fixture, codec_module, preview_chunk) => "none"
	end
end

fn failure_shutdown_last_stream_id(failure: Http2ProtocolFailure) -> Int
	match failure
		StreamAfterGoaway(offset, stream_id, last_stream_id, shutdown_state, endpoint_role, rule_provenance, preview_chunk) => last_stream_id
		ClosedWithPending(_, _, _) => 0
		ClosedWithPartialPreface(_, _) => 0
		InvalidPreface(_, _, _, _) => 0
		ContinuationExpected(offset, actual_kind, actual_stream, expected_stream, started_kind, started_offset, preview_chunk) => 0
		InvalidFrameKind(offset, actual_kind, stream_id, expected_kind, active_state, rule_provenance) => 0
		InvalidStreamId(offset, frame_kind, stream_id, required_domain, endpoint_role, active_state, rule_provenance) => 0
		InvalidPayloadLength(offset, frame_kind, stream_id, observed_length, expected_length, active_state, rule_provenance, preview) => 0
		InvalidWindowUpdateIncrement(offset, stream_id, observed_increment, accepted_min_increment, accepted_max_increment, active_state, rule_provenance, preview) => 0
		InvalidDataPadding(offset, stream_id, pad_length, remaining_payload_length, active_state, rule_provenance, preview) => 0
		ContentLengthMismatch(offset, frame_kind, stream_id, expected_length, observed_length, active_state, rule_provenance, preview) => 0
		InvalidRequestHeaderList(offset, frame_kind, stream_id, failed_header_fact, header_name, decoded_header_names, preview_chunk) => 0
		InvalidResponseHeaderList(offset, frame_kind, stream_id, failed_header_fact, header_name, decoded_header_names, active_state, preview_chunk) => 0
		UnexpectedSettingsAck(_, _, _, _) => 0
		InvalidPriorityDependency(offset, stream_id, dependency_stream_id, active_state, rule_provenance, preview) => 0
		FrameSizeExceeded(offset, observed_length, receive_limit, frame_kind, stream_id) => 0
		FlowControlWindowExceeded(offset, frame_kind, stream_id, observed_length, allowed_window_credit, active_state, rule_provenance, preview_chunk) => 0
		ConcurrentStreamsExceeded(offset, stream_id, attempted_count, allowed_count, endpoint_role, active_state, receive_limit_provenance, rule_provenance, preview_chunk) => 0
		HeaderListSizeExceeded(offset, observed_size, receive_limit, frame_kind, stream_id, rule_provenance, preview_chunk) => 0
		HeaderTableSizeExceeded(offset, observed_size, receive_limit, frame_kind, stream_id, rule_provenance, preview_chunk) => 0
		SettingsValueOutOfRange(offset, setting_identifier, setting_name, observed_value, accepted_min_value, accepted_max_value, peer_limit_provenance, preview) => 0
		HpackFixtureDecodeFailed(offset, observed_size, observed_first_byte, requested_dynamic_index, dynamic_table_entry_count, expected_fixture, codec_module, preview_chunk) => 0
		HpackTableSizeUpdateNotAtStart(offset, observed_size, observed_first_byte, observed_update_size, frame_kind, stream_id, active_state, expected_fixture, codec_module, preview_chunk) => 0
	end
end

fn print_step(label: String, step: Http2Step) -> () effects [stdio]
	let state: Http2DecodeState = step_state(step)
	stdio::print(label)
	stdio::print(" result ")
	stdio::print(step_kind(step))
	stdio::print(" offset ")
	stdio::print(int_to_string(step_offset(step)))
	stdio::print(" kind ")
	stdio::print(int_to_string(step_kind_value(step)))
	stdio::print(" stream ")
	stdio::print(int_to_string(step_stream_id(step)))
	stdio::print(" next ")
	stdio::print(int_to_string(state_next_offset(state)))
	stdio::print(" pending ")
	stdio::print(int_to_string(state_pending_count(state)))
	stdio::print(" continuation ")
	stdio::print(state_continuation_label(state))
	stdio::print(" accumulated ")
	stdio::print(int_to_string(state_continuation_count(state)))
	stdio::print(" completed ")
	stdio::println(int_to_string(step_completed_count(step)))
end

fn print_failure(label: String, step: Http2Step) -> () effects [stdio]
	let failure: Http2ProtocolFailure = step_failure(step)
	let state: Http2DecodeState = step_state(step)
	stdio::print(label)
	stdio::print(" id ")
	stdio::print(failure_id(failure))
	stdio::print(" offset ")
	stdio::print(int_to_string(failure_offset(failure)))
	stdio::print(" pending ")
	stdio::print(int_to_string(failure_pending_count(failure)))
	stdio::print(" actual_kind ")
	stdio::print(int_to_string(failure_actual_kind(failure)))
	stdio::print(" actual_stream ")
	stdio::print(int_to_string(failure_actual_stream(failure)))
	stdio::print(" expected_stream ")
	stdio::print(int_to_string(context_expected_stream(failure, state)))
	stdio::print(" expected_kind ")
	stdio::print(int_to_string(context_expected_kind(failure, state)))
