	stdio::print(outbound_settings_ack_status(decision))
	stdio::print(" pending ")
	stdio::println(pending_settings_ack_label(connection_pending_settings_ack(outbound_settings_ack_connection(decision))))
end

fn outbound_settings_ack_status(decision: OutboundSettingsAckDecision) -> String
	match decision
		OutboundSettingsAckAccepted(_, _) => "accepted"
		OutboundSettingsAckNoPending(_) => "no_pending"
		OutboundSettingsAckEncodeFailed(_, _) => "encode_error"
	end
end

fn outbound_settings_ack_connection(decision: OutboundSettingsAckDecision) -> Http2ConnectionState
	match decision
		OutboundSettingsAckAccepted(connection, _) => connection
		OutboundSettingsAckNoPending(connection) => connection
		OutboundSettingsAckEncodeFailed(connection, _) => connection
	end
end

fn outbound_settings_ack_chunk(decision: OutboundSettingsAckDecision) -> ByteChunk
	match decision
		OutboundSettingsAckAccepted(_, chunk) => chunk
		OutboundSettingsAckNoPending(_) => byte_chunk([])
		OutboundSettingsAckEncodeFailed(_, _) => byte_chunk([])
	end
end

fn print_peer_settings_ack_send_state_cases() -> Result<(), String> effects [stdio]
	let peer_settings_connection: Http2ConnectionStep = receive_connection(InputChunk(byte_chunk_from_hex("000006040000000000000500008000")?), connection_state(frame_state()))?
	print_step("peer-settings-connection", connection_step_decode_step(peer_settings_connection))
	print_pending_settings_ack("peer-settings-connection", connection_step_state(peer_settings_connection))
	print_peer_settings("peer-settings-connection", connection_decode_state(connection_step_state(peer_settings_connection)))
	let peer_settings_ack_intent: OutboundSettingsAckDecision = send_pending_settings_ack(connection_step_state(peer_settings_connection))?
	print_outbound_settings_ack("peer-settings-ack-send", peer_settings_ack_intent)
	let ignored_peer_settings_ack_chunk: () = emit_encoded_header("http2-peer-settings-ack", outbound_settings_ack_chunk(peer_settings_ack_intent), "000000040100000000")?
	print_peer_settings("peer-settings-ack-send", connection_decode_state(outbound_settings_ack_connection(peer_settings_ack_intent)))
	let peer_settings_ack_cleared: OutboundSettingsAckDecision = send_pending_settings_ack(outbound_settings_ack_connection(peer_settings_ack_intent))?
	print_outbound_settings_ack("peer-settings-ack-cleared", peer_settings_ack_cleared)
	let ignored_peer_settings_ack_cleared_chunk: () = print_empty_output_chunks("http2-peer-settings-ack-cleared")?
	let peer_settings_coalesce_first: Http2ConnectionStep = receive_connection(InputChunk(byte_chunk_from_hex("000006040000000000000500008000")?), connection_state(frame_state()))?
	let peer_settings_coalesce_second: Http2ConnectionStep = receive_connection(InputChunk(byte_chunk_from_hex("000006040000000000aaaa12345678")?), connection_step_state(peer_settings_coalesce_first))?
	print_step("peer-settings-ack-coalesce", connection_step_decode_step(peer_settings_coalesce_second))
	print_pending_settings_ack("peer-settings-ack-coalesce", connection_step_state(peer_settings_coalesce_second))
	let peer_settings_coalesced_ack: OutboundSettingsAckDecision = send_pending_settings_ack(connection_step_state(peer_settings_coalesce_second))?
	print_outbound_settings_ack("peer-settings-ack-coalesced-send", peer_settings_coalesced_ack)
	let ignored_peer_settings_coalesced_ack_chunk: () = emit_encoded_header("http2-peer-settings-ack-coalesced", outbound_settings_ack_chunk(peer_settings_coalesced_ack), "000000040100000000")?
	Ok(())
end

