	let trailer_continuation_start: Http2Step = receive(InputChunk(byte_chunk_from_hex("0000020101000000012122")?), step_state(continuation_initial_response))?
	print_step("response-trailers-continuation-start", trailer_continuation_start)
	let trailer_continuation_done: Http2Step = receive(InputChunk(byte_chunk_from_hex("0000020904000000012324")?), step_state(trailer_continuation_start))?
	print_step("response-trailers-continuation-done", trailer_continuation_done)
	let ignored_trailers_continuation: () = emit_header_block("http2-response-trailers-continuation", trailer_continuation_done, "21222324")?
	print_hpack_transition("response-trailers-continuation-done", trailer_continuation_done)
	print_closed_by_peer_stream("response-trailers-continuation", step_state(trailer_continuation_done))
	let pseudo_initial_response: Http2Step = response_headers_open_stream()?
	let pseudo_trailers: Http2Step = receive(InputChunk(byte_chunk_from_hex("00000101050000000182")?), step_state(pseudo_initial_response))?
	print_request_header_failure("response-trailers-pseudo-header", pseudo_trailers)
	let uppercase_initial_response: Http2Step = response_headers_open_stream()?
	let uppercase_trailers: Http2Step = receive(InputChunk(byte_chunk_from_hex("00000401050000000122232425")?), step_state(uppercase_initial_response))?
	print_request_header_failure("response-trailers-uppercase-ordinary", uppercase_trailers)
	let token_initial_response: Http2Step = response_headers_open_stream()?
	let token_trailers: Http2Step = receive(InputChunk(byte_chunk_from_hex("00000401050000000123242526")?), step_state(token_initial_response))?
	print_request_header_failure("response-trailers-bad-token-ordinary", token_trailers)
	let connection_initial_response: Http2Step = response_headers_open_stream()?
	let connection_trailers: Http2Step = receive(InputChunk(byte_chunk_from_hex("00000401050000000124252627")?), step_state(connection_initial_response))?
	print_request_header_failure("response-trailers-connection-specific", connection_trailers)
	let te_initial_response: Http2Step = response_headers_open_stream()?
	let te_trailers: Http2Step = receive(InputChunk(byte_chunk_from_hex("00000401050000000125262728")?), step_state(te_initial_response))?
	print_request_header_failure("response-trailers-bad-te", te_trailers)
	Ok(())
end

fn print_outbound_content_length_data_cases(outbound_peer_settings: PeerSettingsState) -> Result<(), String> effects [stdio]
	let outbound_content_length_headers: HpackHeaderList = hpack_fixture::outbound_request_content_length_headers()
	let outbound_content_length_headers_sent: Result<OutboundHeadersDecision, HpackFixtureFailure> = send_headers_from_header_list(1, outbound_content_length_headers, false, outbound_peer_settings, outbound_receive_credit_with_open_stream(20, 1, 20))?
	let ignored_outbound_content_length_headers: () = print_outbound_headers_from_list("outbound-content-length-headers", outbound_content_length_headers_sent)?
	let outbound_content_length_credit: OutboundSendCredit = outbound_send_credit_from_headers(outbound_content_length_headers, outbound_headers_result_decision(outbound_content_length_headers_sent))
	let outbound_content_length_data_first: OutboundDataDecision = send_data(1, byte_chunk_from_hex("aabb")?, false, outbound_peer_settings, outbound_content_length_credit)?
	print_outbound_data("outbound-content-length-data-first", outbound_content_length_data_first)
	let ignored_content_length_data_first_chunk: () = print_outbound_data_chunk("http2-content-length-data-first", outbound_content_length_data_first, "000002000000000001aabb")?
	let outbound_content_length_data_exact: OutboundDataDecision = send_data(1, byte_chunk_from_hex("ccddee")?, true, outbound_peer_settings, outbound_data_send_credit(outbound_content_length_data_first))?
	print_outbound_data("outbound-content-length-data-exact", outbound_content_length_data_exact)
	let ignored_content_length_data_exact_chunk: () = print_outbound_data_chunk("http2-content-length-data-exact", outbound_content_length_data_exact, "000003000100000001ccddee")?
	let outbound_response_content_length_headers: HpackHeaderList = hpack_fixture::outbound_response_content_length_headers()
	let outbound_response_content_length_headers_sent: Result<OutboundHeadersDecision, HpackFixtureFailure> = send_headers_from_header_list(1, outbound_response_content_length_headers, false, outbound_peer_settings, outbound_receive_credit_with_open_stream(20, 1, 20))?
	let ignored_outbound_response_content_length_headers: () = print_outbound_headers_from_list("outbound-response-content-length-headers", outbound_response_content_length_headers_sent)?
	let outbound_response_content_length_credit: OutboundSendCredit = outbound_send_credit_from_headers(outbound_response_content_length_headers, outbound_headers_result_decision(outbound_response_content_length_headers_sent))
	let outbound_content_length_padded: OutboundDataDecision = send_padded_data(1, byte_chunk_from_hex("aabbccddee")?, 2, true, outbound_peer_settings, outbound_response_content_length_credit)?
	print_outbound_data("outbound-content-length-padded", outbound_content_length_padded)
	let ignored_content_length_padded_chunk: () = print_outbound_data_chunk("http2-content-length-padded", outbound_content_length_padded, "00000800090000000102aabbccddee0000")?
	let outbound_content_length_over: OutboundDataDecision = send_data(1, byte_chunk_from_hex("aabbccddee00")?, false, outbound_peer_settings, outbound_content_length_credit)?
	print_outbound_data("outbound-content-length-over", outbound_content_length_over)
	let ignored_content_length_over_chunk: () = print_outbound_data_chunk("http2-content-length-over", outbound_content_length_over, "")?
	print_failure("outbound-content-length-over", Failed(frame_state(), outbound_data_failure(outbound_content_length_over)))
	let outbound_content_length_early: OutboundDataDecision = send_data(1, byte_chunk_from_hex("aabbcc")?, true, outbound_peer_settings, outbound_content_length_credit)?
	print_outbound_data("outbound-content-length-early-end-stream", outbound_content_length_early)
	let ignored_content_length_early_chunk: () = print_outbound_data_chunk("http2-content-length-early-end-stream", outbound_content_length_early, "")?
	print_failure("outbound-content-length-early-end-stream", Failed(frame_state(), outbound_data_failure(outbound_content_length_early)))
	Ok(())
end

fn verify_outbound_credit_facts(send_credit: OutboundSendCredit, connection_window: Int, stream_one_window: Int, stream_three_window: Int, stream_three_observed_length: Int, stream_five_window: Int, context: String) -> Result<(), String>
	match outbound_send_connection_window(send_credit) == connection_window and outbound_send_stream_window_for(send_credit, 1) == stream_one_window and outbound_send_stream_window_for(send_credit, 3) == stream_three_window and outbound_send_observed_length_for(send_credit, 3) == stream_three_observed_length and outbound_send_stream_window_for(send_credit, 5) == stream_five_window
		true => Ok(())
		false => Err(context)
	end
end

fn require_outbound_credit_update_rejected(decision: OutboundSendCreditUpdateDecision, context: String) -> Result<(), String>
	match decision
		OutboundSendCreditUpdateRejected(_) => Ok(())
		OutboundSendCreditUpdated(_) => Err(context)
		OutboundSendCreditUnchanged(_) => Err(context)
	end
end

fn require_outbound_data_rejected(decision: OutboundDataDecision, context: String) -> Result<(), String>
	match decision
		OutboundDataRejected(_, _, _, _) => Ok(())
		OutboundDataAccepted(_, _, _, _, _) => Err(context)
		OutboundDataEncodeFailed(_, _, _, _) => Err(context)
	end
end

fn verify_outbound_multi_stream_flow_control() -> Result<(), String>
	let stream_one_credit: OutboundSendCredit = add_outbound_open_stream(outbound_send_credit_without_stream(20), 1, 10)
	let stream_three_credit: OutboundSendCredit = add_outbound_content_length_stream(stream_one_credit, 3, 10, 6, 0)
	let initial_credit: OutboundSendCredit = add_outbound_open_stream(stream_three_credit, 5, 8)
	let initial_facts: () = verify_outbound_credit_facts(initial_credit, 20, 10, 10, 0, 8, "expected three independent initial outbound stream credits")?
	let stream_three_data: OutboundDataDecision = send_data(3, byte_chunk_from_hex("aabb")?, false, empty_peer_settings(), initial_credit)?
	let after_stream_three: OutboundSendCredit = outbound_data_send_credit(stream_three_data)
	let stream_three_facts: () = verify_outbound_credit_facts(after_stream_three, 18, 10, 8, 2, 8, "expected DATA on stream three to preserve unrelated outbound stream facts")?
	let stream_five_data: OutboundDataDecision = send_data(5, byte_chunk_from_hex("010203")?, false, empty_peer_settings(), after_stream_three)?
	let after_stream_five: OutboundSendCredit = outbound_data_send_credit(stream_five_data)
	let stream_five_facts: () = verify_outbound_credit_facts(after_stream_five, 15, 10, 8, 2, 5, "expected DATA on stream five to preserve unrelated outbound stream facts")?
	let stream_three_window_update: Http2Step = receive(InputChunk(byte_chunk_from_hex("00000408000000000300000004")?), receive_window_state(10, 3, 10))?
	let stream_three_refill: OutboundSendCreditUpdateDecision = refill_outbound_send_credit_from_received_window_update(stream_three_window_update, after_stream_five)?
	let after_stream_three_refill: OutboundSendCredit = outbound_send_credit_update_credit(stream_three_refill)
	let stream_three_refill_facts: () = verify_outbound_credit_facts(after_stream_three_refill, 15, 10, 12, 2, 5, "expected stream WINDOW_UPDATE to refill only stream three")?
	let connection_window_update: Http2Step = receive(InputChunk(byte_chunk_from_hex("00000408000000000000000005")?), frame_state())?
	let connection_refill: OutboundSendCreditUpdateDecision = refill_outbound_send_credit_from_received_window_update(connection_window_update, after_stream_three_refill)?
	let after_connection_refill: OutboundSendCredit = outbound_send_credit_update_credit(connection_refill)
	let connection_refill_facts: () = verify_outbound_credit_facts(after_connection_refill, 20, 10, 12, 2, 5, "expected connection WINDOW_UPDATE to preserve every stream fact")?
	let reduced_initial_window: Http2Step = receive(InputChunk(byte_chunk_from_hex("00000604000000000000040000fff5")?), frame_state())?
	let reduced_credit: OutboundSendCreditUpdateDecision = update_outbound_send_credit_from_received_settings(reduced_initial_window, empty_peer_settings(), after_connection_refill)?
	let after_reduction: OutboundSendCredit = outbound_send_credit_update_credit(reduced_credit)
	let reduced_facts: () = verify_outbound_credit_facts(after_reduction, 20, 0, 2, 2, -5, "expected initial-window delta on every open outbound stream")?
	let stream_five_window_update: Http2Step = receive(InputChunk(byte_chunk_from_hex("00000408000000000500000006")?), receive_window_state(10, 5, 10))?
	let stream_five_refill: OutboundSendCreditUpdateDecision = refill_outbound_send_credit_from_received_window_update(stream_five_window_update, after_reduction)?
	let after_stream_five_refill: OutboundSendCredit = outbound_send_credit_update_credit(stream_five_refill)
	let restored_facts: () = verify_outbound_credit_facts(after_stream_five_refill, 20, 0, 2, 2, 1, "expected later stream refill to restore only negative stream five credit")?
	let zero_stream_update: () = require_outbound_credit_update_rejected(refill_outbound_send_credit(0, 3, 0, byte_chunk([]), after_stream_five_refill)?, "expected zero stream WINDOW_UPDATE increment rejection")?
	let overflowing_stream_update: () = require_outbound_credit_update_rejected(refill_outbound_send_credit(0, 3, 2147483647, byte_chunk([]), after_stream_five_refill)?, "expected overflowing stream WINDOW_UPDATE rejection")?
	let unknown_stream_update: () = require_outbound_credit_update_rejected(refill_outbound_send_credit(0, 7, 1, byte_chunk([]), after_stream_five_refill)?, "expected unknown stream WINDOW_UPDATE rejection")?
	let zero_connection_update: () = require_outbound_credit_update_rejected(refill_outbound_send_credit(0, 0, 0, byte_chunk([]), after_stream_five_refill)?, "expected zero connection WINDOW_UPDATE increment rejection")?
	let overflowing_connection_credit: OutboundSendCredit = apply_initial_window_delta_to_outbound_send_credit(0, add_outbound_open_stream(outbound_send_credit_without_stream(2147483647), 1, 1))?
	let overflowing_connection_update: () = require_outbound_credit_update_rejected(refill_outbound_send_credit(0, 0, 1, byte_chunk([]), overflowing_connection_credit)?, "expected overflowing connection WINDOW_UPDATE rejection")?
	let closed_and_reset_credit: OutboundSendCredit = add_outbound_reset_stream(add_outbound_closed_stream(after_stream_five_refill, 7), 9, 8)
	let closed_stream_update: () = require_outbound_credit_update_rejected(refill_outbound_send_credit(0, 7, 1, byte_chunk([]), closed_and_reset_credit)?, "expected closed stream WINDOW_UPDATE rejection")?
	let reset_stream_update: () = require_outbound_credit_update_rejected(refill_outbound_send_credit(0, 9, 1, byte_chunk([]), closed_and_reset_credit)?, "expected reset stream WINDOW_UPDATE rejection")?
	let closed_stream_data: () = require_outbound_data_rejected(send_data(7, byte_chunk_from_hex("01")?, false, empty_peer_settings(), closed_and_reset_credit)?, "expected closed stream DATA rejection")?
	let reset_stream_data: () = require_outbound_data_rejected(send_data(9, byte_chunk_from_hex("01")?, false, empty_peer_settings(), closed_and_reset_credit)?, "expected reset stream DATA rejection")?
	let rejected_updates_preserved_facts: () = verify_outbound_credit_facts(closed_and_reset_credit, 20, 0, 2, 2, 1, "expected rejected multi-stream updates to preserve unrelated credit")?
	Ok(())
end

