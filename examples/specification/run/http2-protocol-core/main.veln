	match state
		State(_, _, _, _, _, _, PeerSettings(_, NoPeerInitialWindowSize, _, _, _, _), _, _) => 0
		State(_, _, _, _, _, _, PeerSettings(_, PeerInitialWindowSize(value, _), _, _, _, _), _, _) => value
	end
end

fn state_peer_initial_window_size_offset(state: Http2DecodeState) -> Int
	match state
		State(_, _, _, _, _, _, PeerSettings(_, NoPeerInitialWindowSize, _, _, _, _), _, _) => 0
		State(_, _, _, _, _, _, PeerSettings(_, PeerInitialWindowSize(_, item_offset), _, _, _, _), _, _) => item_offset
	end
end

fn state_peer_enable_push(state: Http2DecodeState) -> Int
	match state
		State(_, _, _, _, _, _, PeerSettings(_, _, NoPeerEnablePush, _, _, _), _, _) => 0
		State(_, _, _, _, _, _, PeerSettings(_, _, PeerEnablePush(value, _), _, _, _), _, _) => value
	end
end

fn state_peer_enable_push_offset(state: Http2DecodeState) -> Int
	match state
		State(_, _, _, _, _, _, PeerSettings(_, _, NoPeerEnablePush, _, _, _), _, _) => 0
		State(_, _, _, _, _, _, PeerSettings(_, _, PeerEnablePush(_, item_offset), _, _, _), _, _) => item_offset
	end
end

fn state_peer_max_concurrent_streams(state: Http2DecodeState) -> Int
	match state
		State(_, _, _, _, _, _, PeerSettings(_, _, _, NoPeerMaxConcurrentStreams, _, _), _, _) => 0
		State(_, _, _, _, _, _, PeerSettings(_, _, _, PeerMaxConcurrentStreams(value, _), _, _), _, _) => value
	end
end

fn state_peer_max_concurrent_streams_offset(state: Http2DecodeState) -> Int
	match state
		State(_, _, _, _, _, _, PeerSettings(_, _, _, NoPeerMaxConcurrentStreams, _, _), _, _) => 0
		State(_, _, _, _, _, _, PeerSettings(_, _, _, PeerMaxConcurrentStreams(_, item_offset), _, _), _, _) => item_offset
	end
