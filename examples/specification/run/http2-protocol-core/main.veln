fn payload_byte_at(payload: ByteView, index: Int) -> Result<Int, String>
	byte_read_u8_be(byte_view(byte_view_to_chunk(payload), byte_offset(index)?, byte_count(1)?)?)
end

fn print_unknown_frame_value(label: String, frame: Http2Frame) -> Result<(), String> effects [stdio]
	match frame
		PriorityFrame(_, _, _, _, _) => Err("expected unknown frame")
		KnownFrame(_, _, _, _) => Err("expected unknown frame")
		UnknownFrame(kind, flags, stream_id, payload) => print_unknown_frame_payload(label, kind, flags, stream_id, payload)
	end
end

fn print_unknown_frame_payload(label: String, kind: Int, flags: Int, stream_id: Int, payload: ByteView) -> Result<(), String> effects [stdio]
	let payload_chunk: ByteChunk = byte_view_to_chunk(payload)
	let payload_count: Int = byte_count_to_int(byte_chunk_count(payload_chunk))
	stdio::print(label)
	stdio::print(" result unknown kind ")
	stdio::print(int_to_string(kind))
	stdio::print(" stream ")
	stdio::print(int_to_string(stream_id))
	stdio::print(" flags ")
	stdio::print(int_to_string(flags))
	stdio::print(" payload_count ")
	stdio::print(int_to_string(payload_count))
	stdio::print(" payload_first ")
	stdio::print(int_to_string(payload_byte_at(payload, 0)?))
	stdio::print(" payload_middle ")
	stdio::print(int_to_string(payload_byte_at(payload, 1)?))
	stdio::print(" payload_last ")
	stdio::println(int_to_string(payload_byte_at(payload, payload_count - 1)?))
	emit_encoded_header(label, payload_chunk, "aabbcc")
	Ok(())
end

fn print_unknown_frame(label: String, step: Http2Step) -> Result<(), String> effects [stdio]
	match step
		FrameDecoded(_, _, _, _, _, _, _, frame) => print_unknown_frame_value(label, frame)
		Waiting(_) => Err("expected unknown frame but step was waiting")
		Failed(_, _) => Err("expected unknown frame but step failed")
	end
end

fn byte_chunks_equal(left: ByteChunk, right: ByteChunk) -> Result<Bool, String>
	let left_count: Int = byte_count_to_int(byte_chunk_count(left))
	let right_count: Int = byte_count_to_int(byte_chunk_count(right))
	match left_count == right_count
		true => byte_chunks_equal_at(left, right, 0, left_count)
		false => Ok(false)
	end
end

fn byte_chunks_equal_at(left: ByteChunk, right: ByteChunk, index: Int, count: Int) -> Result<Bool, String>
	match index == count
		true => Ok(true)
		false => match read_byte(left, index)? == read_byte(right, index)?
			true => byte_chunks_equal_at(left, right, index + 1, count)
			false => Ok(false)
		end
	end
end

fn checked_hex_label(chunk: ByteChunk, expected_hex: String) -> Result<String, String>
	let expected: ByteChunk = byte_chunk_from_hex(expected_hex)?
	let matches_expected: Bool = byte_chunks_equal(chunk, expected)?
	match matches_expected
		true => Ok(expected_hex)
		false => Ok("mismatch")
	end
end

fn emit_output_chunk(name: String, index: Int, chunk: ByteChunk, expected_hex: String) -> Result<(), String> effects [stdio]
	stdio::print("output_chunk ")
	stdio::print(name)
	stdio::print(" index ")
	stdio::print(int_to_string(index))
	stdio::print(" hex \"")
	stdio::print(checked_hex_label(chunk, expected_hex)?)
	stdio::print("\" count ")
	stdio::println(int_to_string(byte_count_to_int(byte_chunk_count(chunk))))
	Ok(())
end

