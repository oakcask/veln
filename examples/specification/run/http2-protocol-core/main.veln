fn verify_outbound_local_stream_lifecycle_cases() -> Result<(), String>
	let initial: OutboundHeadersConnectionState = initial_outbound_headers_connection_state(ClientEndpoint, empty_peer_settings(), OpenConnection, outbound_receive_credit_without_stream(10))
	let first: OutboundHeadersConnectionTransition = send_headers_on_connection(1, byte_chunk_from_hex("82")?, false, initial)?
	let ignored_first: () = require_outbound_headers_connection_accepted("first local stream id was rejected", first, 1)?
	let first_state: OutboundHeadersConnectionState = outbound_headers_connection_state(first)
	let ignored_first_high_water: () = require_equal_int("first local stream did not advance high-water", outbound_headers_connection_high_water(first_state), 1)?
	let existing: OutboundHeadersConnectionTransition = send_headers_on_connection(1, byte_chunk_from_hex("84")?, false, first_state)?
	let ignored_existing: () = require_outbound_headers_connection_accepted("existing open stream HEADERS used new-stream ordering", existing, 1)?
	let existing_state: OutboundHeadersConnectionState = outbound_headers_connection_state(existing)
	let ignored_existing_high_water: () = require_equal_int("existing open stream changed high-water", outbound_headers_connection_high_water(existing_state), 1)?
	let closed: OutboundHeadersConnectionTransition = send_headers_on_connection(1, byte_chunk_from_hex("86")?, true, existing_state)?
	let ignored_closed: () = require_outbound_headers_connection_accepted("existing stream END_STREAM HEADERS was rejected", closed, 1)?
	let closed_state: OutboundHeadersConnectionState = outbound_headers_connection_state(closed)
	let repeated: OutboundHeadersConnectionTransition = send_headers_on_connection(1, byte_chunk_from_hex("88")?, false, closed_state)?
	let ignored_repeated: () = require_outbound_headers_connection_failure("closed local stream id reuse was accepted", repeated, "http2.protocol.peer_stream_id_not_increasing")?
	let ignored_repeated_chunk: String = checked_hex_label(outbound_headers_chunk(outbound_headers_connection_decision(repeated)), "")?
	let ignored_repeated_state: () = require_outbound_headers_connection_state_preserved("repeated local stream id changed connection state", closed_state, outbound_headers_connection_state(repeated))?
	let increasing: OutboundHeadersConnectionTransition = send_headers_on_connection(3, byte_chunk_from_hex("828486")?, false, closed_state)?
	let ignored_increasing: () = require_outbound_headers_connection_accepted("increasing local stream id was rejected", increasing, 3)?
	let ignored_increasing_chunk: String = checked_hex_label(outbound_headers_chunk(outbound_headers_connection_decision(increasing)), "000003010400000003828486")?
	let increasing_state: OutboundHeadersConnectionState = outbound_headers_connection_state(increasing)
	let reset_state: OutboundHeadersConnectionState = with_outbound_headers_connection_lifecycle(increasing_state, ResetOutboundLocalStream(3, 8), outbound_receive_credit_with_reset_stream(10, 3, 8))
	let lower_after_reset: OutboundHeadersConnectionTransition = send_headers_on_connection(1, byte_chunk_from_hex("82")?, false, reset_state)?
	let ignored_lower_after_reset: () = require_outbound_headers_connection_failure("reset lifecycle lost local stream high-water", lower_after_reset, "http2.protocol.peer_stream_id_not_increasing")?
	let ignored_lower_after_reset_state: () = require_outbound_headers_connection_state_preserved("ordering rejection changed reset lifecycle", reset_state, outbound_headers_connection_state(lower_after_reset))?
	Ok(())
end

fn verify_outbound_local_stream_role_and_domain_cases() -> Result<(), String>
	let initial: OutboundHeadersConnectionState = initial_outbound_headers_connection_state(ClientEndpoint, empty_peer_settings(), OpenConnection, outbound_receive_credit_without_stream(10))
	let closed: OutboundHeadersConnectionTransition = send_headers_on_connection(1, byte_chunk_from_hex("82")?, true, initial)?
	let closed_state: OutboundHeadersConnectionState = outbound_headers_connection_state(closed)
	let zero: OutboundHeadersConnectionTransition = send_headers_on_connection(0, byte_chunk_from_hex("82")?, false, closed_state)?
	let ignored_zero: () = require_outbound_headers_connection_failure("zero local stream id was accepted", zero, "http2.protocol.invalid_stream_id")?
	let even: OutboundHeadersConnectionTransition = send_headers_on_connection(2, byte_chunk_from_hex("82")?, false, closed_state)?
	let ignored_even: () = require_outbound_headers_connection_failure("server-initiated local stream id was accepted", even, "http2.protocol.invalid_stream_id")?
	let out_of_range: OutboundHeadersConnectionTransition = send_headers_on_connection(2147483649, byte_chunk_from_hex("82")?, false, closed_state)?
	let ignored_out_of_range: () = require_outbound_headers_connection_failure("out-of-range local stream id was accepted", out_of_range, "http2.protocol.invalid_stream_id")?
	let server_initial: OutboundHeadersConnectionState = initial_outbound_headers_connection_state(ServerEndpoint, empty_peer_settings(), OpenConnection, outbound_receive_credit_without_stream(10))
	let server_new: OutboundHeadersConnectionTransition = send_headers_on_connection(1, byte_chunk_from_hex("82")?, false, server_initial)?
	let ignored_server_new: () = require_outbound_headers_connection_failure("server endpoint started a regular local stream", server_new, "http2.protocol.invalid_frame_kind")?
	let ignored_server_state: () = require_outbound_headers_connection_state_preserved("server-role rejection changed connection state", server_initial, outbound_headers_connection_state(server_new))?
	let server_existing_state: OutboundHeadersConnectionState = with_outbound_headers_connection_lifecycle(server_initial, OpenOutboundLocalStream(1), outbound_receive_credit_with_open_stream(10, 1, 20))
	let server_existing: OutboundHeadersConnectionTransition = send_headers_on_connection(1, byte_chunk_from_hex("82")?, false, server_existing_state)?
	let ignored_server_existing: () = require_outbound_headers_connection_accepted("server existing-stream HEADERS was rejected", server_existing, 1)?
	Ok(())
end


fn verify_outbound_local_stream_validation_cases() -> Result<(), String>
	let initial: OutboundHeadersConnectionState = initial_outbound_headers_connection_state(ClientEndpoint, empty_peer_settings(), OpenConnection, outbound_receive_credit_without_stream(10))
	let first: OutboundHeadersConnectionTransition = send_headers_on_connection(3, byte_chunk_from_hex("82")?, false, initial)?
	let first_state: OutboundHeadersConnectionState = outbound_headers_connection_state(first)
	let reset_state: OutboundHeadersConnectionState = with_outbound_headers_connection_lifecycle(first_state, ResetOutboundLocalStream(3, 8), outbound_receive_credit_with_reset_stream(10, 3, 8))
	let goaway_state: OutboundHeadersConnectionState = with_outbound_headers_connection_shutdown(reset_state, GracefulShutdown(0, 11))
	let goaway_failure: OutboundHeadersConnectionTransition = send_headers_on_connection(1, byte_chunk_from_hex("82")?, false, goaway_state)?
	let ignored_goaway_failure: () = require_outbound_headers_connection_failure("GOAWAY validation did not precede local ordering", goaway_failure, "http2.protocol.stream_after_goaway")?
	let ignored_goaway_state: () = require_outbound_headers_connection_state_preserved("GOAWAY rejection changed local ordering state", goaway_state, outbound_headers_connection_state(goaway_failure))?
	let limit_state: OutboundHeadersConnectionState = with_outbound_headers_connection_peer_settings(reset_state, peer_max_concurrent_streams_settings(0))
	let limit_failure: OutboundHeadersConnectionTransition = send_headers_on_connection(1, byte_chunk_from_hex("82")?, false, limit_state)?
	let ignored_limit_failure: () = require_outbound_headers_connection_failure("peer concurrent-stream validation did not precede local ordering", limit_failure, "http2.peer_limit.concurrent_streams_exceeded")?
	let ignored_limit_state: () = require_outbound_headers_connection_state_preserved("peer concurrent-stream rejection changed local ordering state", limit_state, outbound_headers_connection_state(limit_failure))?
	let frame_size_state: OutboundHeadersConnectionState = with_outbound_headers_connection_peer_settings(reset_state, small_peer_max_frame_size_settings(0))
	let frame_size_failure: OutboundHeadersConnectionTransition = send_headers_on_connection(5, byte_chunk_from_hex("8284")?, false, frame_size_state)?
	let ignored_frame_size_failure: () = require_outbound_headers_connection_failure("frame-size validation did not precede high-water commit", frame_size_failure, "http2.peer_limit.frame_size_exceeded")?
	let ignored_frame_size_state: () = require_outbound_headers_connection_state_preserved("frame-size rejection changed local ordering state", frame_size_state, outbound_headers_connection_state(frame_size_failure))?
	let frame_size_retry_state: OutboundHeadersConnectionState = with_outbound_headers_connection_peer_settings(outbound_headers_connection_state(frame_size_failure), empty_peer_settings())
	let frame_size_retry: OutboundHeadersConnectionTransition = send_headers_on_connection(5, byte_chunk_from_hex("8284")?, false, frame_size_retry_state)?
	let ignored_frame_size_retry: () = require_outbound_headers_connection_accepted("frame-size-rejected local stream id was not retryable", frame_size_retry, 5)?
	let split_state: OutboundHeadersConnectionState = with_outbound_headers_connection_peer_settings(reset_state, small_peer_max_frame_size_settings(2))
	let split: OutboundHeadersConnectionTransition = send_headers_on_connection(5, byte_chunk_from_hex("828486")?, false, split_state)?
	let ignored_split: () = require_outbound_headers_connection_accepted("split local HEADERS did not commit", split, 5)?
	let ignored_split_high_water: () = require_equal_int("split local HEADERS did not advance high-water once", outbound_headers_connection_high_water(outbound_headers_connection_state(split)), 5)?
	Ok(())
end


fn verify_outbound_local_stream_hpack_cases() -> Result<(), String>
	let initial: OutboundHeadersConnectionState = initial_outbound_headers_connection_state(ClientEndpoint, empty_peer_settings(), OpenConnection, outbound_receive_credit_without_stream(10))
	let hpack_first_result: Result<OutboundHeadersConnectionTransition, HpackFixtureFailure> = send_headers_header_list_on_connection(1, hpack_fixture::outbound_literal_indexed_path_target_headers(), true, initial)?
	let hpack_first: OutboundHeadersConnectionTransition = require_outbound_headers_connection_transition(hpack_first_result)?
	let ignored_hpack_first: () = require_outbound_headers_connection_accepted("stateful HPACK local stream was rejected", hpack_first, 1)?
	let hpack_first_state: OutboundHeadersConnectionState = outbound_headers_connection_state(hpack_first)
	let hpack_repeated_result: Result<OutboundHeadersConnectionTransition, HpackFixtureFailure> = send_headers_header_list_on_connection(1, hpack_fixture::outbound_literal_indexed_path_target_headers(), false, hpack_first_state)?
	let hpack_repeated: OutboundHeadersConnectionTransition = require_outbound_headers_connection_transition(hpack_repeated_result)?
	let ignored_hpack_repeated: () = require_outbound_headers_connection_failure("stateful HPACK repeated local id was accepted", hpack_repeated, "http2.protocol.peer_stream_id_not_increasing")?
	let ignored_hpack_repeated_state: () = require_outbound_headers_connection_state_preserved("ordering rejection committed HPACK state", hpack_first_state, outbound_headers_connection_state(hpack_repeated))?
	let hpack_invalid: Result<OutboundHeadersConnectionTransition, HpackFixtureFailure> = send_headers_header_list_on_connection(3, hpack_fixture::outbound_unsupported_static_headers(), false, hpack_first_state)?
	match hpack_invalid
		Ok(_) => Err("HPACK validation must precede local stream ordering")
		Err(_) => match send_headers_on_connection(3, byte_chunk_from_hex("88")?, false, hpack_first_state)
			Err(error) => Err(error)
			Ok(hpack_retry) => require_outbound_headers_connection_accepted("HPACK-rejected local stream id was not retryable", hpack_retry, 3)
		end
	end
end

fn verify_outbound_local_stream_ordering_cases() -> Result<(), String>
	let ignored_lifecycle: () = verify_outbound_local_stream_lifecycle_cases()?
	let ignored_role_and_domain: () = verify_outbound_local_stream_role_and_domain_cases()?
	let ignored_validation: () = verify_outbound_local_stream_validation_cases()?
	verify_outbound_local_stream_hpack_cases()
end

