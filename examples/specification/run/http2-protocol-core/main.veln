fn send_local_enable_push_setting(value: Int, connection: Http2ConnectionState) -> Result<OutboundSettingsDecision, String>
	match validate_local_enable_push_setting(0, value)?
		SettingsValueOk => match connection
			ConnectionState(decode_state, outstanding_settings, pending_ack) => encode_local_enable_push_intent(value, decode_state, outstanding_settings, pending_ack)
		end
		SettingsValueFailed(error) => Ok(OutboundSettingsRejected(error))
	end
end

fn validate_local_max_frame_size_setting(offset: Int, value: Int) -> Result<SettingsRangeDecision, String>
	match value < 16384
		true => Ok(SettingsValueFailed(SettingsValueOutOfRange(offset, 5, "SETTINGS_MAX_FRAME_SIZE", value, 16384, 16777215, "local_settings", empty_byte_preview()?)))
		false => match value > 16777215
			true => Ok(SettingsValueFailed(SettingsValueOutOfRange(offset, 5, "SETTINGS_MAX_FRAME_SIZE", value, 16384, 16777215, "local_settings", empty_byte_preview()?)))
			false => Ok(SettingsValueOk)
		end
	end
end

fn validate_local_initial_window_size_setting(offset: Int, value: Int) -> Result<SettingsRangeDecision, String>
	match value < 0
		true => Ok(SettingsValueFailed(SettingsValueOutOfRange(offset, 4, "SETTINGS_INITIAL_WINDOW_SIZE", value, 0, 2147483647, "local_settings", empty_byte_preview()?)))
		false => match value > 2147483647
			true => Ok(SettingsValueFailed(SettingsValueOutOfRange(offset, 4, "SETTINGS_INITIAL_WINDOW_SIZE", value, 0, 2147483647, "local_settings", empty_byte_preview()?)))
			false => Ok(SettingsValueOk)
		end
	end
end

fn validate_local_enable_push_setting(offset: Int, value: Int) -> Result<SettingsRangeDecision, String>
	match value < 0
		true => Ok(SettingsValueFailed(SettingsValueOutOfRange(offset, 2, "SETTINGS_ENABLE_PUSH", value, 0, 1, "local_settings", empty_byte_preview()?)))
		false => match value > 1
			true => Ok(SettingsValueFailed(SettingsValueOutOfRange(offset, 2, "SETTINGS_ENABLE_PUSH", value, 0, 1, "local_settings", empty_byte_preview()?)))
			false => Ok(SettingsValueOk)
		end
	end
end

fn encode_local_enable_push_intent(value: Int, decode_state: Http2DecodeState, outstanding_settings: OutstandingLocalSettings, pending_ack: PendingPeerSettingsAck) -> Result<OutboundSettingsDecision, String>
	let payload: ByteChunk = byte_append(byte_write_u16_be(2)?, byte_write_u32_be(value)?)
	let encoded_header: Result<ByteChunk, EncodeError> = encode_frame_header({length: 6, kind: 4, flags: 0, stream_id: 0})
	match encoded_header
		Ok(header) => Ok(OutboundSettingsAccepted(2, value, ConnectionState(update_local_enable_push_state(decode_state, value, 0), add_outstanding_settings(outstanding_settings, 2, 1), pending_ack), byte_append(header, payload)))
		Err(error) => Ok(OutboundSettingsEncodeFailed(error))
	end
end

