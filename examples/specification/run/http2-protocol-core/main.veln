		State(_, _, _, _, _, _, PeerSettings(_, NoPeerInitialWindowSize, _, _, _, _, _), _, _, _) => 0
		State(_, _, _, _, _, _, PeerSettings(_, PeerInitialWindowSize(value, _), _, _, _, _, _), _, _, _) => value
	end
