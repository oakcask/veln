# A pure HTTP/2 decode state consumes frame headers from explicit input events.
use stdio

type PendingContinuation
	NoContinuation
	Continuation(Int, Int, Int, Int)
end

type ContinuationDecision
	Decision(PendingContinuation, Int)
end

type ReceiveLimitProvenance
	ProtocolDefault
	LocalConfiguration
	LocalSettingsItem(Int)
end

type ReceiveLimitEntry
	ReceiveLimit(Int, ReceiveLimitProvenance)
end

type PeerAdvertisedMaxFrameSize
	NoPeerMaxFrameSize
	PeerMaxFrameSize(Int, Int)
end

type PeerSettingsState
	PeerSettings(PeerAdvertisedMaxFrameSize)
end

type ConnectionShutdownState
	OpenConnection
	GracefulShutdown(Int, Int)
end

type Http2DecodeState
	State(ByteChunk, Int, PendingContinuation, ReceiveLimitEntry, PeerSettingsState, ConnectionShutdownState)
end

type Http2Input
	InputChunk(ByteChunk)
	InputEnd
end

type Http2ProtocolFailure
	ClosedWithPending(Int, Int)
	ContinuationExpected(Int, Int, Int, Int, Int, Int)
	InvalidFrameKind(Int, Int, Int, Int, String, String)
	InvalidPayloadLength(Int, Int, Int, Int, Int, String, String)
	FrameSizeExceeded(Int, Int, ReceiveLimitEntry, Int, Int)
	SettingsValueOutOfRange(Int, Int, String, Int, Int, Int, String)
end

type ProtocolPayloadDecision
	ProtocolPayloadOk
	ProtocolPayloadFailed(Http2ProtocolFailure)
end

type SettingsRangeDecision
	SettingsValueOk
	SettingsValueFailed(Http2ProtocolFailure)
end

type Http2Step
	FrameDecoded(Http2DecodeState, Int, Int, Int, Int, Int, Int)
	Waiting(Http2DecodeState)
	Failed(Http2DecodeState, Http2ProtocolFailure)
end

fn empty_state() -> Http2DecodeState
	State(byte_chunk([]), 0, NoContinuation, protocol_default_frame_size_limit(), empty_peer_settings(), OpenConnection)
end

fn local_config_state(max_frame_size: Int) -> Http2DecodeState
	State(byte_chunk([]), 0, NoContinuation, ReceiveLimit(max_frame_size, LocalConfiguration), empty_peer_settings(), OpenConnection)
end

fn local_settings_state(max_frame_size: Int, item_offset: Int) -> Http2DecodeState
	State(byte_chunk([]), 0, NoContinuation, ReceiveLimit(max_frame_size, LocalSettingsItem(item_offset)), empty_peer_settings(), OpenConnection)
end

fn receive(input: Http2Input, state: Http2DecodeState) -> Result<Http2Step, String>
	match input
		InputChunk(bytes) => receive_chunk(bytes, state)
		InputEnd => receive_end(state)
	end
end

fn receive_chunk(bytes: ByteChunk, state: Http2DecodeState) -> Result<Http2Step, String>
	match state
		State(pending, next_offset, continuation, receive_limit, peer_settings, shutdown_state) => decode_available(byte_append(pending, bytes), next_offset, continuation, receive_limit, peer_settings, shutdown_state)
	end
end

fn receive_end(state: Http2DecodeState) -> Result<Http2Step, String>
	match state
		State(pending, next_offset, continuation, receive_limit, peer_settings, shutdown_state) => end_pending(pending, next_offset, continuation, receive_limit, peer_settings, shutdown_state)
	end
end

fn end_pending(pending: ByteChunk, next_offset: Int, continuation: PendingContinuation, receive_limit: ReceiveLimitEntry, peer_settings: PeerSettingsState, shutdown_state: ConnectionShutdownState) -> Result<Http2Step, String>
	let available: Int = byte_count_to_int(byte_chunk_count(pending))
	match available == 0
		true => Ok(Waiting(State(pending, next_offset, continuation, receive_limit, peer_settings, shutdown_state)))
		false => Ok(Failed(State(pending, next_offset, continuation, receive_limit, peer_settings, shutdown_state), ClosedWithPending(next_offset, available)))
	end
end

fn decode_available(pending: ByteChunk, next_offset: Int, continuation: PendingContinuation, receive_limit: ReceiveLimitEntry, peer_settings: PeerSettingsState, shutdown_state: ConnectionShutdownState) -> Result<Http2Step, String>
	let available: Int = byte_count_to_int(byte_chunk_count(pending))
	match available < 9
		true => Ok(Waiting(State(pending, next_offset, continuation, receive_limit, peer_settings, shutdown_state)))
		false => decode_header(pending, next_offset, continuation, receive_limit, peer_settings, shutdown_state)
	end
end

fn decode_header(pending: ByteChunk, next_offset: Int, continuation: PendingContinuation, receive_limit: ReceiveLimitEntry, peer_settings: PeerSettingsState, shutdown_state: ConnectionShutdownState) -> Result<Http2Step, String>
	let available: Int = byte_count_to_int(byte_chunk_count(pending))
	let zero: ByteOffset = byte_offset(0)?
	let header_count: ByteCount = byte_count(9)?
	let view: ByteView = byte_view(pending, zero, header_count)?
	let header: {length: Int, kind: Int, flags: Int, stream_id: Int} = byte_decode_http2_frame_header(view)?
	let max_frame_size: Int = receive_limit_value(receive_limit)
	match header.length > max_frame_size
		true => Ok(Failed(State(pending, next_offset, continuation, receive_limit, peer_settings, shutdown_state), FrameSizeExceeded(next_offset, header.length, receive_limit, header.kind, header.stream_id)))
		false => decode_sized_frame(pending, next_offset, continuation, receive_limit, peer_settings, shutdown_state, available, header.length, header.kind, header.flags, header.stream_id)
	end
end

fn protocol_default_frame_size_limit() -> ReceiveLimitEntry
	ReceiveLimit(16384, ProtocolDefault)
end

fn empty_peer_settings() -> PeerSettingsState
	PeerSettings(NoPeerMaxFrameSize)
end

fn receive_limit_value(receive_limit: ReceiveLimitEntry) -> Int
	match receive_limit
		ReceiveLimit(value, _) => value
	end
end

fn receive_limit_provenance_label(receive_limit: ReceiveLimitEntry) -> String
	match receive_limit
		ReceiveLimit(_, ProtocolDefault) => "protocol_default"
		ReceiveLimit(_, LocalConfiguration) => "local_configuration"
		ReceiveLimit(_, LocalSettingsItem(_)) => "local_settings_item"
	end
end

fn decode_sized_frame(pending: ByteChunk, next_offset: Int, continuation: PendingContinuation, receive_limit: ReceiveLimitEntry, peer_settings: PeerSettingsState, shutdown_state: ConnectionShutdownState, available: Int, length: Int, kind: Int, flags: Int, stream_id: Int) -> Result<Http2Step, String>
	let frame_count_int: Int = 9 + length
	match available < frame_count_int
		true => Ok(Waiting(State(pending, next_offset, continuation, receive_limit, peer_settings, shutdown_state)))
		false => decode_complete_frame(pending, next_offset, continuation, receive_limit, peer_settings, shutdown_state, length, kind, flags, stream_id, frame_count_int)
	end
end

fn decode_complete_frame(pending: ByteChunk, next_offset: Int, continuation: PendingContinuation, receive_limit: ReceiveLimitEntry, peer_settings: PeerSettingsState, shutdown_state: ConnectionShutdownState, length: Int, kind: Int, flags: Int, stream_id: Int, frame_count_int: Int) -> Result<Http2Step, String>
	let frame_count: ByteCount = byte_count(frame_count_int)?
	let suffix: ByteChunk = byte_drop(pending, frame_count)?
	let consumed_state: Http2DecodeState = State(suffix, next_offset + frame_count_int, continuation, receive_limit, peer_settings, shutdown_state)
	let settings_decision: SettingsRangeDecision = validate_settings_value(pending, next_offset, length, kind)?
	match settings_decision
		SettingsValueOk => match validate_protocol_payload(next_offset, length, kind, stream_id)
			ProtocolPayloadOk => match validate_continuation(continuation, next_offset, length, kind, flags, stream_id)
				Ok(Decision(next_continuation, completed_count)) => Ok(FrameDecoded(State(suffix, next_offset + frame_count_int, next_continuation, receive_limit, update_peer_settings(pending, next_offset, length, kind, peer_settings)?, update_shutdown_state(pending, length, kind, shutdown_state)?), next_offset, length, kind, flags, stream_id, completed_count))
				Err(error) => Ok(Failed(consumed_state, error))
			end
			ProtocolPayloadFailed(error) => Ok(Failed(consumed_state, error))
		end
		SettingsValueFailed(error) => Ok(Failed(consumed_state, error))
	end
end

fn validate_protocol_payload(offset: Int, length: Int, kind: Int, stream_id: Int) -> ProtocolPayloadDecision
	match kind == 6
		true => validate_fixed_payload_length(offset, length, kind, stream_id, 8, "connection-control", "rfc9113_ping_payload_length")
		false => match kind == 7
			true => validate_fixed_payload_length(offset, length, kind, stream_id, 8, "connection-control", "rfc9113_goaway_payload_length")
			false => ProtocolPayloadOk
		end
	end
end

fn validate_fixed_payload_length(offset: Int, length: Int, kind: Int, stream_id: Int, expected_length: Int, active_state: String, rule_provenance: String) -> ProtocolPayloadDecision
	match length == expected_length
		true => ProtocolPayloadOk
		false => ProtocolPayloadFailed(InvalidPayloadLength(offset, kind, stream_id, length, expected_length, active_state, rule_provenance))
	end
end

fn validate_settings_value(pending: ByteChunk, next_offset: Int, length: Int, kind: Int) -> Result<SettingsRangeDecision, String>
	match kind == 4
		true => match length == 6
			true => validate_single_settings_value(pending, next_offset)
			false => Ok(SettingsValueOk)
		end
		false => Ok(SettingsValueOk)
	end
end

fn validate_single_settings_value(pending: ByteChunk, next_offset: Int) -> Result<SettingsRangeDecision, String>
	let item_offset: ByteOffset = byte_offset(9)?
	let item_count: ByteCount = byte_count(6)?
	let item: ByteView = byte_view(pending, item_offset, item_count)?
	let identifier_count: ByteCount = byte_count(2)?
	let value_offset: ByteOffset = byte_offset(2)?
	let value_count: ByteCount = byte_count(4)?
	let identifier: Int = byte_read_u16_be(byte_view(byte_view_to_chunk(item), byte_offset(0)?, identifier_count)?)?
	let value: Int = byte_read_u32_be(byte_view(byte_view_to_chunk(item), value_offset, value_count)?)?
	match identifier == 5
		true => validate_max_frame_size_setting(next_offset + 9, value)
		false => Ok(SettingsValueOk)
	end
end

fn validate_max_frame_size_setting(item_offset: Int, value: Int) -> Result<SettingsRangeDecision, String>
	match value < 16384
		true => Ok(SettingsValueFailed(SettingsValueOutOfRange(item_offset, 5, "SETTINGS_MAX_FRAME_SIZE", value, 16384, 16777215, "peer_settings")))
		false => match value > 16777215
			true => Ok(SettingsValueFailed(SettingsValueOutOfRange(item_offset, 5, "SETTINGS_MAX_FRAME_SIZE", value, 16384, 16777215, "peer_settings")))
			false => Ok(SettingsValueOk)
		end
	end
end

fn update_peer_settings(pending: ByteChunk, next_offset: Int, length: Int, kind: Int, peer_settings: PeerSettingsState) -> Result<PeerSettingsState, String>
	match kind == 4
		true => update_settings_frame(pending, next_offset, length, peer_settings)
		false => Ok(peer_settings)
	end
end

fn update_settings_frame(pending: ByteChunk, next_offset: Int, length: Int, peer_settings: PeerSettingsState) -> Result<PeerSettingsState, String>
	match length == 6
		true => update_single_settings_item(pending, next_offset)
		false => Ok(peer_settings)
	end
end

fn update_single_settings_item(pending: ByteChunk, next_offset: Int) -> Result<PeerSettingsState, String>
	let item_offset: ByteOffset = byte_offset(9)?
	let item_count: ByteCount = byte_count(6)?
	let item: ByteView = byte_view(pending, item_offset, item_count)?
	let identifier_count: ByteCount = byte_count(2)?
	let value_offset: ByteOffset = byte_offset(2)?
	let value_count: ByteCount = byte_count(4)?
	let identifier: Int = byte_read_u16_be(byte_view(byte_view_to_chunk(item), byte_offset(0)?, identifier_count)?)?
	let value: Int = byte_read_u32_be(byte_view(byte_view_to_chunk(item), value_offset, value_count)?)?
	match identifier == 5
		true => Ok(PeerSettings(PeerMaxFrameSize(value, next_offset + 9)))
		false => Ok(PeerSettings(NoPeerMaxFrameSize))
	end
end

fn update_shutdown_state(pending: ByteChunk, length: Int, kind: Int, shutdown_state: ConnectionShutdownState) -> Result<ConnectionShutdownState, String>
	match kind == 7
		true => match length == 8
			true => decode_goaway_state(pending)
			false => Ok(shutdown_state)
		end
		false => Ok(shutdown_state)
	end
end

fn decode_goaway_state(pending: ByteChunk) -> Result<ConnectionShutdownState, String>
	let last_stream_offset: ByteOffset = byte_offset(9)?
	let error_code_offset: ByteOffset = byte_offset(13)?
	let field_count: ByteCount = byte_count(4)?
	let last_stream_view: ByteView = byte_view(pending, last_stream_offset, field_count)?
	let error_code_view: ByteView = byte_view(pending, error_code_offset, field_count)?
	let last_stream_id: Int = byte_read_u31_be(last_stream_view)?
	let error_code: Int = byte_read_u32_be(error_code_view)?
	Ok(GracefulShutdown(last_stream_id, error_code))
end

fn validate_continuation(continuation: PendingContinuation, offset: Int, length: Int, kind: Int, flags: Int, stream_id: Int) -> Result<ContinuationDecision, Http2ProtocolFailure>
	match continuation
		NoContinuation => validate_without_continuation(offset, length, kind, flags, stream_id)
		Continuation(expected_stream, started_kind, started_offset, accumulated) => validate_with_continuation(expected_stream, started_kind, started_offset, accumulated, offset, length, kind, flags, stream_id)
	end
end

fn validate_without_continuation(offset: Int, length: Int, kind: Int, flags: Int, stream_id: Int) -> Result<ContinuationDecision, Http2ProtocolFailure>
	match kind == 1
		true => match flags == 4
			true => Ok(Decision(NoContinuation, length))
			false => Ok(Decision(Continuation(stream_id, kind, offset, length), 0))
		end
		false => validate_connection_frame_kind(offset, kind, stream_id)
	end
end

fn validate_connection_frame_kind(offset: Int, kind: Int, stream_id: Int) -> Result<ContinuationDecision, Http2ProtocolFailure>
	match stream_id == 0
		true => match kind == 4
			true => Ok(Decision(NoContinuation, 0))
			false => match kind == 6
				true => Ok(Decision(NoContinuation, 0))
				false => match kind == 7
					true => Ok(Decision(NoContinuation, 0))
					false => Err(InvalidFrameKind(offset, kind, stream_id, 4, "connection-control", "connection_frames_require_settings"))
				end
			end
		end
		false => validate_stream_frame_kind(offset, kind, stream_id)
	end
end

fn validate_stream_frame_kind(offset: Int, kind: Int, stream_id: Int) -> Result<ContinuationDecision, Http2ProtocolFailure>
	match kind == 1
		true => Ok(Decision(NoContinuation, 0))
		false => Err(InvalidFrameKind(offset, kind, stream_id, 1, "idle-stream", "idle_streams_require_headers"))
	end
end

fn validate_with_continuation(expected_stream: Int, started_kind: Int, started_offset: Int, accumulated: Int, offset: Int, length: Int, kind: Int, flags: Int, stream_id: Int) -> Result<ContinuationDecision, Http2ProtocolFailure>
	match kind == 9
		true => validate_continuation_stream(expected_stream, started_kind, started_offset, accumulated, offset, length, kind, flags, stream_id)
		false => Err(ContinuationExpected(offset, kind, stream_id, expected_stream, started_kind, started_offset))
	end
end

fn validate_continuation_stream(expected_stream: Int, started_kind: Int, started_offset: Int, accumulated: Int, offset: Int, length: Int, kind: Int, flags: Int, stream_id: Int) -> Result<ContinuationDecision, Http2ProtocolFailure>
	match stream_id == expected_stream
		true => match flags == 4
			true => Ok(Decision(NoContinuation, accumulated + length))
			false => Ok(Decision(Continuation(expected_stream, started_kind, started_offset, accumulated + length), 0))
		end
		false => Err(ContinuationExpected(offset, kind, stream_id, expected_stream, started_kind, started_offset))
	end
end

fn step_kind(step: Http2Step) -> String
	match step
		FrameDecoded(_, _, _, _, _, _, _) => "frame"
		Waiting(_) => "waiting"
		Failed(_, _) => "failed"
	end
end

fn step_state(step: Http2Step) -> Http2DecodeState
	match step
		FrameDecoded(state, _, _, _, _, _, _) => state
		Waiting(state) => state
		Failed(state, _) => state
	end
end

fn step_failure(step: Http2Step) -> Http2ProtocolFailure
	match step
		FrameDecoded(_, _, _, _, _, _, _) => ClosedWithPending(0, 0)
		Waiting(_) => ClosedWithPending(0, 0)
		Failed(_, failure) => failure
	end
end

fn step_offset(step: Http2Step) -> Int
	match step
		FrameDecoded(_, offset, _, _, _, _, _) => offset
		Waiting(_) => 0
		Failed(_, _) => 0
	end
end

fn step_kind_value(step: Http2Step) -> Int
	match step
		FrameDecoded(_, _, _, kind, _, _, _) => kind
		Waiting(_) => 0
		Failed(_, _) => 0
	end
end

fn step_stream_id(step: Http2Step) -> Int
	match step
		FrameDecoded(_, _, _, _, _, stream_id, _) => stream_id
		Waiting(_) => 0
		Failed(_, _) => 0
	end
end

fn step_flags(step: Http2Step) -> Int
	match step
		FrameDecoded(_, _, _, _, flags, _, _) => flags
		Waiting(_) => 0
		Failed(_, _) => 0
	end
end

fn step_completed_count(step: Http2Step) -> Int
	match step
		FrameDecoded(_, _, _, _, _, _, completed_count) => completed_count
		Waiting(_) => 0
		Failed(_, _) => 0
	end
end

fn state_pending_count(state: Http2DecodeState) -> Int
	match state
		State(pending, _, _, _, _, _) => byte_count_to_int(byte_chunk_count(pending))
	end
end

fn state_next_offset(state: Http2DecodeState) -> Int
	match state
		State(_, next_offset, _, _, _, _) => next_offset
	end
end

fn state_continuation_label(state: Http2DecodeState) -> String
	match state
		State(_, _, NoContinuation, _, _, _) => "none"
		State(_, _, Continuation(_, _, _, _), _, _, _) => "active"
	end
end

fn state_continuation_count(state: Http2DecodeState) -> Int
	match state
		State(_, _, NoContinuation, _, _, _) => 0
		State(_, _, Continuation(_, _, _, accumulated), _, _, _) => accumulated
	end
end

fn state_peer_max_frame_size(state: Http2DecodeState) -> Int
	match state
		State(_, _, _, _, PeerSettings(NoPeerMaxFrameSize), _) => 0
		State(_, _, _, _, PeerSettings(PeerMaxFrameSize(value, _)), _) => value
	end
end

fn state_peer_max_frame_size_offset(state: Http2DecodeState) -> Int
	match state
		State(_, _, _, _, PeerSettings(NoPeerMaxFrameSize), _) => 0
		State(_, _, _, _, PeerSettings(PeerMaxFrameSize(_, item_offset)), _) => item_offset
	end
end

fn state_shutdown_label(state: Http2DecodeState) -> String
	match state
		State(_, _, _, _, _, OpenConnection) => "open"
		State(_, _, _, _, _, GracefulShutdown(_, _)) => "graceful_shutdown"
	end
end

fn state_shutdown_last_stream_id(state: Http2DecodeState) -> Int
	match state
		State(_, _, _, _, _, OpenConnection) => 0
		State(_, _, _, _, _, GracefulShutdown(last_stream_id, _)) => last_stream_id
	end
end

fn state_shutdown_error_code(state: Http2DecodeState) -> Int
	match state
		State(_, _, _, _, _, OpenConnection) => 0
		State(_, _, _, _, _, GracefulShutdown(_, error_code)) => error_code
	end
end

fn failure_id(failure: Http2ProtocolFailure) -> String
	match failure
		ClosedWithPending(_, _) => "http2.protocol.closed_with_pending"
		ContinuationExpected(_, _, _, _, _, _) => "http2.protocol.continuation_expected"
		InvalidFrameKind(_, _, _, _, _, _) => "http2.protocol.invalid_frame_kind"
		InvalidPayloadLength(_, _, _, _, _, _, _) => "http2.protocol.invalid_payload_length"
		FrameSizeExceeded(_, _, _, _, _) => "http2.peer_limit.frame_size_exceeded"
		SettingsValueOutOfRange(_, _, _, _, _, _, _) => "http2.peer_limit.settings_value_out_of_range"
	end
end

fn failure_offset(failure: Http2ProtocolFailure) -> Int
	match failure
		ClosedWithPending(offset, _) => offset
		ContinuationExpected(offset, _, _, _, _, _) => offset
		InvalidFrameKind(offset, _, _, _, _, _) => offset
		InvalidPayloadLength(offset, _, _, _, _, _, _) => offset
		FrameSizeExceeded(offset, _, _, _, _) => offset
		SettingsValueOutOfRange(offset, _, _, _, _, _, _) => offset
	end
end

fn failure_pending_count(failure: Http2ProtocolFailure) -> Int
	match failure
		ClosedWithPending(_, pending_count) => pending_count
		ContinuationExpected(_, _, _, _, _, _) => 0
		InvalidFrameKind(_, _, _, _, _, _) => 0
		InvalidPayloadLength(_, _, _, _, _, _, _) => 0
		FrameSizeExceeded(_, _, _, _, _) => 0
		SettingsValueOutOfRange(_, _, _, _, _, _, _) => 0
	end
end

fn failure_actual_kind(failure: Http2ProtocolFailure) -> Int
	match failure
		ClosedWithPending(_, _) => 0
		ContinuationExpected(_, actual_kind, _, _, _, _) => actual_kind
		InvalidFrameKind(_, actual_kind, _, _, _, _) => actual_kind
		InvalidPayloadLength(_, actual_kind, _, _, _, _, _) => actual_kind
		FrameSizeExceeded(_, _, _, actual_kind, _) => actual_kind
		SettingsValueOutOfRange(_, _, _, _, _, _, _) => 4
	end
end

fn failure_actual_stream(failure: Http2ProtocolFailure) -> Int
	match failure
		ClosedWithPending(_, _) => 0
		ContinuationExpected(_, _, actual_stream, _, _, _) => actual_stream
		InvalidFrameKind(_, _, actual_stream, _, _, _) => actual_stream
		InvalidPayloadLength(_, _, actual_stream, _, _, _, _) => actual_stream
		FrameSizeExceeded(_, _, _, _, actual_stream) => actual_stream
		SettingsValueOutOfRange(_, _, _, _, _, _, _) => 0
	end
end

fn failure_expected_stream(failure: Http2ProtocolFailure) -> Int
	match failure
		ClosedWithPending(_, _) => 0
		ContinuationExpected(_, _, _, expected_stream, _, _) => expected_stream
		InvalidFrameKind(_, _, _, _, _, _) => 0
		InvalidPayloadLength(_, _, _, _, _, _, _) => 0
		FrameSizeExceeded(_, _, _, _, _) => 0
		SettingsValueOutOfRange(_, _, _, _, _, _, _) => 0
	end
end

fn failure_expected_kind(failure: Http2ProtocolFailure) -> Int
	match failure
		ClosedWithPending(_, _) => 0
		ContinuationExpected(_, _, _, _, _, _) => 9
		InvalidFrameKind(_, _, _, expected_kind, _, _) => expected_kind
		InvalidPayloadLength(_, actual_kind, _, _, _, _, _) => actual_kind
		FrameSizeExceeded(_, _, _, _, _) => 0
		SettingsValueOutOfRange(_, _, _, _, _, _, _) => 4
	end
end

fn failure_started_kind(failure: Http2ProtocolFailure) -> Int
	match failure
		ClosedWithPending(_, _) => 0
		ContinuationExpected(_, _, _, _, started_kind, _) => started_kind
		InvalidFrameKind(_, _, _, _, _, _) => 0
		InvalidPayloadLength(_, _, _, _, _, _, _) => 0
		FrameSizeExceeded(_, _, _, _, _) => 0
		SettingsValueOutOfRange(_, _, _, _, _, _, _) => 0
	end
end

fn failure_started_offset(failure: Http2ProtocolFailure) -> Int
	match failure
		ClosedWithPending(_, _) => 0
		ContinuationExpected(_, _, _, _, _, started_offset) => started_offset
		InvalidFrameKind(_, _, _, _, _, _) => 0
		InvalidPayloadLength(_, _, _, _, _, _, _) => 0
		FrameSizeExceeded(_, _, _, _, _) => 0
		SettingsValueOutOfRange(_, _, _, _, _, _, _) => 0
	end
end

fn failure_observed_length(failure: Http2ProtocolFailure) -> Int
	match failure
		ClosedWithPending(_, _) => 0
		ContinuationExpected(_, _, _, _, _, _) => 0
		InvalidFrameKind(_, _, _, _, _, _) => 0
		InvalidPayloadLength(_, _, _, observed_length, _, _, _) => observed_length
		FrameSizeExceeded(_, observed_length, _, _, _) => observed_length
		SettingsValueOutOfRange(_, _, _, _, _, _, _) => 0
	end
end

fn failure_allowed_length(failure: Http2ProtocolFailure) -> Int
	match failure
		ClosedWithPending(_, _) => 0
		ContinuationExpected(_, _, _, _, _, _) => 0
		InvalidFrameKind(_, _, _, _, _, _) => 0
		InvalidPayloadLength(_, _, _, _, expected_length, _, _) => expected_length
		FrameSizeExceeded(_, _, receive_limit, _, _) => receive_limit_value(receive_limit)
		SettingsValueOutOfRange(_, _, _, _, _, _, _) => 0
	end
end

fn failure_active_state(failure: Http2ProtocolFailure) -> String
	match failure
		ClosedWithPending(_, _) => "none"
		ContinuationExpected(_, _, _, _, _, _) => "headers"
		InvalidFrameKind(_, _, _, _, active_state, _) => active_state
		InvalidPayloadLength(_, _, _, _, _, active_state, _) => active_state
		FrameSizeExceeded(_, _, _, _, _) => "none"
		SettingsValueOutOfRange(_, _, _, _, _, _, _) => "connection-control"
	end
end

fn failure_rule_provenance(failure: Http2ProtocolFailure) -> String
	match failure
		ClosedWithPending(_, _) => "none"
		ContinuationExpected(_, _, _, _, _, _) => "rfc9113_continuation_sequence"
		InvalidFrameKind(_, _, _, _, _, rule_provenance) => rule_provenance
		InvalidPayloadLength(_, _, _, _, _, _, rule_provenance) => rule_provenance
		FrameSizeExceeded(_, _, _, _, _) => "none"
		SettingsValueOutOfRange(_, _, _, _, _, _, _) => "http2_settings_value_range"
	end
end

fn failure_receive_limit_provenance(failure: Http2ProtocolFailure) -> String
	match failure
		ClosedWithPending(_, _) => "none"
		ContinuationExpected(_, _, _, _, _, _) => "none"
		InvalidFrameKind(_, _, _, _, _, _) => "none"
		InvalidPayloadLength(_, _, _, _, _, _, _) => "none"
		FrameSizeExceeded(_, _, receive_limit, _, _) => receive_limit_provenance_label(receive_limit)
		SettingsValueOutOfRange(_, _, _, _, _, _, _) => "none"
	end
end

fn failure_setting_identifier(failure: Http2ProtocolFailure) -> Int
	match failure
		ClosedWithPending(_, _) => 0
		ContinuationExpected(_, _, _, _, _, _) => 0
		InvalidFrameKind(_, _, _, _, _, _) => 0
		InvalidPayloadLength(_, _, _, _, _, _, _) => 0
		FrameSizeExceeded(_, _, _, _, _) => 0
		SettingsValueOutOfRange(_, setting_identifier, _, _, _, _, _) => setting_identifier
	end
end

fn failure_setting_name(failure: Http2ProtocolFailure) -> String
	match failure
		ClosedWithPending(_, _) => "none"
		ContinuationExpected(_, _, _, _, _, _) => "none"
		InvalidFrameKind(_, _, _, _, _, _) => "none"
		InvalidPayloadLength(_, _, _, _, _, _, _) => "none"
		FrameSizeExceeded(_, _, _, _, _) => "none"
		SettingsValueOutOfRange(_, _, setting_name, _, _, _, _) => setting_name
	end
end

fn failure_observed_value(failure: Http2ProtocolFailure) -> Int
	match failure
		ClosedWithPending(_, _) => 0
		ContinuationExpected(_, _, _, _, _, _) => 0
		InvalidFrameKind(_, _, _, _, _, _) => 0
		InvalidPayloadLength(_, _, _, _, _, _, _) => 0
		FrameSizeExceeded(_, _, _, _, _) => 0
		SettingsValueOutOfRange(_, _, _, observed_value, _, _, _) => observed_value
	end
end

fn failure_accepted_min_value(failure: Http2ProtocolFailure) -> Int
	match failure
		ClosedWithPending(_, _) => 0
		ContinuationExpected(_, _, _, _, _, _) => 0
		InvalidFrameKind(_, _, _, _, _, _) => 0
		InvalidPayloadLength(_, _, _, _, _, _, _) => 0
		FrameSizeExceeded(_, _, _, _, _) => 0
		SettingsValueOutOfRange(_, _, _, _, accepted_min_value, _, _) => accepted_min_value
	end
end

fn failure_accepted_max_value(failure: Http2ProtocolFailure) -> Int
	match failure
		ClosedWithPending(_, _) => 0
		ContinuationExpected(_, _, _, _, _, _) => 0
		InvalidFrameKind(_, _, _, _, _, _) => 0
		InvalidPayloadLength(_, _, _, _, _, _, _) => 0
		FrameSizeExceeded(_, _, _, _, _) => 0
		SettingsValueOutOfRange(_, _, _, _, _, accepted_max_value, _) => accepted_max_value
	end
end

fn failure_peer_limit_provenance(failure: Http2ProtocolFailure) -> String
	match failure
		ClosedWithPending(_, _) => "none"
		ContinuationExpected(_, _, _, _, _, _) => "none"
		InvalidFrameKind(_, _, _, _, _, _) => "none"
		InvalidPayloadLength(_, _, _, _, _, _, _) => "none"
		FrameSizeExceeded(_, _, _, _, _) => "none"
		SettingsValueOutOfRange(_, _, _, _, _, _, peer_limit_provenance) => peer_limit_provenance
	end
end

fn print_step(label: String, step: Http2Step) -> () effects [stdio]
	let state: Http2DecodeState = step_state(step)
	stdio::print(label)
	stdio::print(" result ")
	stdio::print(step_kind(step))
	stdio::print(" offset ")
	stdio::print(int_to_string(step_offset(step)))
	stdio::print(" kind ")
	stdio::print(int_to_string(step_kind_value(step)))
	stdio::print(" stream ")
	stdio::print(int_to_string(step_stream_id(step)))
	stdio::print(" next ")
	stdio::print(int_to_string(state_next_offset(state)))
	stdio::print(" pending ")
	stdio::print(int_to_string(state_pending_count(state)))
	stdio::print(" continuation ")
	stdio::print(state_continuation_label(state))
	stdio::print(" accumulated ")
	stdio::print(int_to_string(state_continuation_count(state)))
	stdio::print(" completed ")
	stdio::println(int_to_string(step_completed_count(step)))
end

fn print_failure(label: String, step: Http2Step) -> () effects [stdio]
	let failure: Http2ProtocolFailure = step_failure(step)
	let state: Http2DecodeState = step_state(step)
	stdio::print(label)
	stdio::print(" id ")
	stdio::print(failure_id(failure))
	stdio::print(" offset ")
	stdio::print(int_to_string(failure_offset(failure)))
	stdio::print(" pending ")
	stdio::print(int_to_string(failure_pending_count(failure)))
	stdio::print(" actual_kind ")
	stdio::print(int_to_string(failure_actual_kind(failure)))
	stdio::print(" actual_stream ")
	stdio::print(int_to_string(failure_actual_stream(failure)))
	stdio::print(" expected_stream ")
	stdio::print(int_to_string(failure_expected_stream(failure)))
	stdio::print(" expected_kind ")
	stdio::print(int_to_string(failure_expected_kind(failure)))
	stdio::print(" started_kind ")
	stdio::print(int_to_string(failure_started_kind(failure)))
	stdio::print(" started_offset ")
	stdio::print(int_to_string(failure_started_offset(failure)))
	stdio::print(" continuation ")
	stdio::print(state_continuation_label(state))
	stdio::print(" accumulated ")
	stdio::print(int_to_string(state_continuation_count(state)))
	stdio::print(" observed_length ")
	stdio::print(int_to_string(failure_observed_length(failure)))
	stdio::print(" allowed_length ")
	stdio::print(int_to_string(failure_allowed_length(failure)))
	stdio::print(" receive_limit ")
	stdio::print(failure_receive_limit_provenance(failure))
	stdio::print(" active_state ")
	stdio::print(failure_active_state(failure))
	stdio::print(" rule ")
	stdio::println(failure_rule_provenance(failure))
end

fn print_peer_settings(label: String, state: Http2DecodeState) -> () effects [stdio]
	stdio::print(label)
	stdio::print(" peer_max_frame_size ")
	stdio::print(int_to_string(state_peer_max_frame_size(state)))
	stdio::print(" peer_max_frame_size_offset ")
	stdio::println(int_to_string(state_peer_max_frame_size_offset(state)))
end

fn print_settings_failure(label: String, step: Http2Step) -> () effects [stdio]
	let failure: Http2ProtocolFailure = step_failure(step)
	stdio::print(label)
	stdio::print(" id ")
	stdio::print(failure_id(failure))
	stdio::print(" offset ")
	stdio::print(int_to_string(failure_offset(failure)))
	stdio::print(" setting_identifier ")
	stdio::print(int_to_string(failure_setting_identifier(failure)))
	stdio::print(" setting_name ")
	stdio::print(failure_setting_name(failure))
	stdio::print(" observed_value ")
	stdio::print(int_to_string(failure_observed_value(failure)))
	stdio::print(" accepted_min ")
	stdio::print(int_to_string(failure_accepted_min_value(failure)))
	stdio::print(" accepted_max ")
	stdio::print(int_to_string(failure_accepted_max_value(failure)))
	stdio::print(" peer_limit ")
	stdio::println(failure_peer_limit_provenance(failure))
end

fn ping_ack_label(flags: Int) -> String
	match flags == 1
		true => "ack"
		false => "data"
	end
end

fn print_ping(label: String, step: Http2Step) -> () effects [stdio]
	stdio::print(label)
	stdio::print(" result ")
	stdio::print(step_kind(step))
	stdio::print(" kind ")
	stdio::print(int_to_string(step_kind_value(step)))
	stdio::print(" stream ")
	stdio::print(int_to_string(step_stream_id(step)))
	stdio::print(" flags ")
	stdio::print(int_to_string(step_flags(step)))
	stdio::print(" ping ")
	stdio::println(ping_ack_label(step_flags(step)))
end

fn print_goaway(label: String, step: Http2Step) -> () effects [stdio]
	let state: Http2DecodeState = step_state(step)
	stdio::print(label)
	stdio::print(" result ")
	stdio::print(step_kind(step))
	stdio::print(" kind ")
	stdio::print(int_to_string(step_kind_value(step)))
	stdio::print(" stream ")
	stdio::print(int_to_string(step_stream_id(step)))
	stdio::print(" shutdown ")
	stdio::print(state_shutdown_label(state))
	stdio::print(" last_stream_id ")
	stdio::print(int_to_string(state_shutdown_last_stream_id(state)))
	stdio::print(" error_code ")
	stdio::println(int_to_string(state_shutdown_error_code(state)))
end

pub fn main() -> Result<(), String> effects [stdio]
	let valid: Http2Step = receive(InputChunk(byte_chunk_from_hex("000000040000000000")?), empty_state())?
	print_step("valid", valid)
	let incomplete: Http2Step = receive(InputChunk(byte_chunk_from_hex("00000004")?), empty_state())?
	print_step("incomplete", incomplete)
	let truncated: Http2Step = receive(InputEnd, step_state(incomplete))?
	print_failure("closed", truncated)
	let header_start: Http2Step = receive(InputChunk(byte_chunk_from_hex("000003010000000001aabbcc")?), empty_state())?
	print_step("headers", header_start)
	let continuation_more: Http2Step = receive(InputChunk(byte_chunk_from_hex("000002090000000001ddee")?), step_state(header_start))?
	print_step("continuation-more", continuation_more)
	let continuation_done: Http2Step = receive(InputChunk(byte_chunk_from_hex("00000409040000000101020304")?), step_state(continuation_more))?
	print_step("continuation-done", continuation_done)
	let bad_continuation: Http2Step = receive(InputChunk(byte_chunk_from_hex("000000000000000001")?), step_state(header_start))?
	print_failure("continuation", bad_continuation)
	let max_allowed_incomplete: Http2Step = receive(InputChunk(byte_chunk_from_hex("004000000000000003")?), empty_state())?
	print_step("frame-size-at-limit", max_allowed_incomplete)
	let too_large: Http2Step = receive(InputChunk(byte_chunk_from_hex("004001000000000003")?), empty_state())?
	print_failure("frame-size", too_large)
	let local_config_too_large: Http2Step = receive(InputChunk(byte_chunk_from_hex("000401000000000003")?), local_config_state(1024))?
	print_failure("frame-size-config", local_config_too_large)
	let local_settings_too_large: Http2Step = receive(InputChunk(byte_chunk_from_hex("002ee1000000000003")?), local_settings_state(12000, 2))?
	print_failure("frame-size-local-settings", local_settings_too_large)
	let peer_settings: Http2Step = receive(InputChunk(byte_chunk_from_hex("000006040000000000000500008000")?), empty_state())?
	print_step("peer-settings", peer_settings)
	print_peer_settings("peer-settings", step_state(peer_settings))
	let peer_settings_too_low: Http2Step = receive(InputChunk(byte_chunk_from_hex("000006040000000000000500003fff")?), empty_state())?
	print_settings_failure("settings-range", peer_settings_too_low)
	print_peer_settings("settings-range", step_state(peer_settings_too_low))
	let peer_settings_too_high: Http2Step = receive(InputChunk(byte_chunk_from_hex("000006040000000000000501000000")?), empty_state())?
	print_settings_failure("settings-range-high", peer_settings_too_high)
	print_peer_settings("settings-range-high", step_state(peer_settings_too_high))
	let peer_advertised_too_large: Http2Step = receive(InputChunk(byte_chunk_from_hex("004001000000000003")?), step_state(peer_settings))?
	print_failure("frame-size-peer-advertised", peer_advertised_too_large)
	print_peer_settings("frame-size-peer-advertised", step_state(peer_advertised_too_large))
	let bad_connection_kind: Http2Step = receive(InputChunk(byte_chunk_from_hex("000000000000000000")?), empty_state())?
	print_failure("invalid-kind", bad_connection_kind)
	let bad_stream_kind: Http2Step = receive(InputChunk(byte_chunk_from_hex("000000000000000001")?), empty_state())?
	print_failure("invalid-stream-kind", bad_stream_kind)
	let ping_data: Http2Step = receive(InputChunk(byte_chunk_from_hex("0000080600000000000102030405060708")?), empty_state())?
	print_ping("ping-data", ping_data)
	let ping_ack: Http2Step = receive(InputChunk(byte_chunk_from_hex("0000080601000000000102030405060708")?), empty_state())?
	print_ping("ping-ack", ping_ack)
	let ping_bad_length: Http2Step = receive(InputChunk(byte_chunk_from_hex("00000706000000000001020304050607")?), empty_state())?
	print_failure("ping-length", ping_bad_length)
	let ping_bad_stream: Http2Step = receive(InputChunk(byte_chunk_from_hex("0000080600000000010102030405060708")?), empty_state())?
	print_failure("ping-stream", ping_bad_stream)
	let goaway: Http2Step = receive(InputChunk(byte_chunk_from_hex("000008070000000000000000050000000b")?), empty_state())?
	print_goaway("goaway", goaway)
	let goaway_bad_length: Http2Step = receive(InputChunk(byte_chunk_from_hex("00000707000000000000000005000000")?), empty_state())?
	print_failure("goaway-length", goaway_bad_length)
	let goaway_bad_stream: Http2Step = receive(InputChunk(byte_chunk_from_hex("000008070000000001000000050000000b")?), empty_state())?
	print_failure("goaway-stream", goaway_bad_stream)
	Ok(())
end
