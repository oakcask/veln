	let request_uppercase: Http2Step = receive(InputChunk(byte_chunk_from_hex("0000080104000000018287840001580161")?), frame_state())?
	let ignored_request_uppercase: () = require_request_header_failure_fact("production later request uppercase field was hidden", request_uppercase, "ordinary_header_name_not_lowercase")?
	let response_request_pseudo_start: Http2Step = receive(InputChunk(byte_chunk_from_hex("000003010000000001888200")?), frame_state())?
	let response_request_pseudo: Http2Step = receive(InputChunk(byte_chunk_from_hex("00000409040000000101780161")?), step_state(response_request_pseudo_start))?
	let ignored_response_request_pseudo: () = require_response_header_failure_fact("production later response request pseudo-header was hidden", response_request_pseudo, "request_only_pseudo_header")?
	let trailer_initial: Http2Step = receive(InputChunk(byte_chunk_from_hex("000003010400000001828784")?), frame_state())?
	let trailer_late_pseudo: Http2Step = receive(InputChunk(byte_chunk_from_hex("000006010500000001000178016182")?), step_state(trailer_initial))?
	let ignored_trailer_late_pseudo: () = require_request_header_failure_fact("production later trailer pseudo-header was hidden", trailer_late_pseudo, "trailer_pseudo_header")?
	let accepted_stateful: Http2Step = receive(InputChunk(byte_chunk_from_hex("0000090104000000018287844001780161be")?), frame_state())?
