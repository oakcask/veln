fn outbound_stream_window(flow_control: OutboundFlowControl) -> Int
	match flow_control
		OutboundFlowControl(_, NoOutboundOpenStreamWindow) => 0
		OutboundFlowControl(_, OutboundOpenStreamWindow(_, stream_window)) => stream_window
