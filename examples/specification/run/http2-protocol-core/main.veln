fn require_hpack_transition_header(step: Http2Step, previous_state: Http2DecodeState, expected_name: String, expected_value: String) -> Result<(), String>
	match hpack_fixture::decode_header_block(step_completed_header_block(step), state_hpack_fixture_state(previous_state), step_offset(step))
		Ok(transition) => match hpack_fixture::header_list_first_name(hpack_fixture::transition_headers(transition)) == expected_name and hpack_fixture::header_list_first_value(hpack_fixture::transition_headers(transition)) == expected_value
			true => Ok(())
			false => Err("unexpected HTTP/2 HPACK carried header")
		end
		Err(_) => Err("expected HTTP/2 HPACK carried decode")
	end
end

fn require_completed_header_list_decode(step: Http2Step, previous_state: Http2DecodeState, expected_name: String, expected_value: String, expected_wire_size: Int) -> Result<(), String>
	match decode_completed_header_list(step_offset(step), step_kind_value(step), step_flags(step), step_stream_id(step), step_completed_header_block(step), state_hpack_fixture_state(previous_state))
		HeaderListDecodeOk(decoded_header_list_size, _, headers) => match hpack_fixture::production_header_list_name_at(headers, 0)
			Some(name) => match hpack_fixture::production_header_list_value_at(headers, 0)
				Some(value) => match decoded_header_list_size == expected_wire_size and name == expected_name and value == expected_value
					true => Ok(())
					false => Err("unexpected HTTP/2 completed header-list decode")
				end
				None => Err("missing HTTP/2 completed header-list value")
			end
			None => Err("missing HTTP/2 completed header-list name")
		end
		HeaderListDecodeFailed(_) => Err("expected HTTP/2 completed header-list decode")
	end
end

fn require_hpack_state_table_size(state: Http2DecodeState, expected_table_size: Int) -> Result<(), String>
	match hpack_fixture::state_table_size(state_hpack_fixture_state(state)) == expected_table_size
		true => Ok(())
		false => Err("unexpected HTTP/2 HPACK carried table size")
	end
end

