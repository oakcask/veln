fn failure_id(failure: Http2ProtocolFailure) -> String
	match failure
		ClosedWithPending(_, _) => "http2.protocol.closed_with_pending"
		ClosedWithPartialPreface(_, _) => "http2.protocol.partial_preface"
		InvalidPreface(_, _, _, _) => "http2.protocol.invalid_preface"
		ContinuationExpected(_, _, _, _, _, _) => "http2.protocol.continuation_expected"
		InvalidFrameKind(_, _, _, _, _, _) => "http2.protocol.invalid_frame_kind"
