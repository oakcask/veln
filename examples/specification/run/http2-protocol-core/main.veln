fn require_frame_decoded(label: String, step: Http2Step) -> Result<(), String>
	match step
		FrameDecoded(_, _, _, _, _, _, _, _) => Ok(())
		Waiting(_) => Err(label)
		Failed(_, _) => Err(label)
	end
end

fn require_request_header_failure_fact(label: String, step: Http2Step, expected_fact: String) -> Result<(), String>
	match step
		FrameDecoded(_, _, _, _, _, _, _, _) => Err(label)
		Waiting(_) => Err(label)
		Failed(_, failure) => match failure
			InvalidRequestHeaderList(_, _, _, failed_header_fact, _, _, _) => match failed_header_fact == expected_fact
				true => Ok(())
				false => Err(label)
			end
			_ => Err(label)
		end
	end
end

fn require_production_request_content_length_validation(state: Http2DecodeState) -> Result<(), String>
	let production_single: Http2Step = receive(InputChunk(byte_chunk_from_hex("0000040104000000016768696a")?), state)?
	let ignored_production_single_decoded: () = require_frame_decoded("production-single", production_single)?
	let production_repeated: Http2Step = receive(InputChunk(byte_chunk_from_hex("00000401040000000168696a6b")?), state)?
	let ignored_production_repeated_decoded: () = require_frame_decoded("production-repeated", production_repeated)?
	let production_mismatch: Http2Step = receive(InputChunk(byte_chunk_from_hex("000004010400000001696a6b6c")?), state)?
	let ignored_production_mismatch: () = require_request_header_failure_fact("production-mismatch", production_mismatch, "content_length_mismatch")?
	let production_empty: Http2Step = receive(InputChunk(byte_chunk_from_hex("0000040104000000016a6b6c6d")?), state)?
	let ignored_production_empty: () = require_request_header_failure_fact("production-empty", production_empty, "content_length_invalid")?
	let production_non_decimal: Http2Step = receive(InputChunk(byte_chunk_from_hex("0000040104000000016b6c6d6e")?), state)?
	let ignored_production_non_decimal: () = require_request_header_failure_fact("production-non-decimal", production_non_decimal, "content_length_invalid")?
	let production_sign: Http2Step = receive(InputChunk(byte_chunk_from_hex("0000040104000000016c6d6e6f")?), state)?
	let ignored_production_sign: () = require_request_header_failure_fact("production-sign", production_sign, "content_length_invalid")?
	let production_whitespace: Http2Step = receive(InputChunk(byte_chunk_from_hex("0000040104000000016d6e6f70")?), state)?
	let ignored_production_whitespace: () = require_request_header_failure_fact("production-whitespace", production_whitespace, "content_length_invalid")?
	let production_negative: Http2Step = receive(InputChunk(byte_chunk_from_hex("0000040104000000016e6f7071")?), state)?
	let ignored_production_negative: () = require_request_header_failure_fact("production-negative", production_negative, "content_length_invalid")?
	let production_continuation_start: Http2Step = receive(InputChunk(byte_chunk_from_hex("0000020100000000016768")?), state)?
	let production_continuation_done: Http2Step = receive(InputChunk(byte_chunk_from_hex("000002090400000001696a")?), step_state(production_continuation_start))?
	let ignored_production_continuation_decoded: () = require_frame_decoded("production-continuation", production_continuation_done)?
	let production_continuation_mismatch_start: Http2Step = receive(InputChunk(byte_chunk_from_hex("000002010000000001696a")?), state)?
	let production_continuation_mismatch_done: Http2Step = receive(InputChunk(byte_chunk_from_hex("0000020904000000016b6c")?), step_state(production_continuation_mismatch_start))?
	require_request_header_failure_fact("production-continuation-mismatch", production_continuation_mismatch_done, "content_length_mismatch")
end

fn require_hpack_fixture_failure(step: Http2Step) -> Result<(), String>
	match step
		FrameDecoded(_, _, _, _, _, _, _, _) => Err("expected HTTP/2 HPACK fixture failure")
		Waiting(_) => Err("expected HTTP/2 HPACK fixture failure")
		Failed(_, failure) => match failure_id(failure) == "hpack.fixture.unsupported_header_block" or failure_id(failure) == "hpack.fixture.unsupported_static_index" or failure_id(failure) == "hpack.fixture.malformed_string_length" or failure_id(failure) == "hpack.fixture.malformed_raw_string_value" or failure_id(failure) == "hpack.fixture.malformed_huffman_padding" or failure_id(failure) == "hpack.fixture.huffman_eos_symbol" or failure_id(failure) == "hpack.fixture.huffman_non_visible_value" or failure_id(failure) == "hpack.fixture.dynamic_index_out_of_range" or failure_id(failure) == "hpack.fixture.dynamic_name_continuation_missing" or failure_id(failure) == "hpack.fixture.dynamic_name_continuation_malformed" or failure_id(failure) == "hpack.fixture.dynamic_name_continuation_out_of_range" or failure_id(failure) == "hpack.fixture.table_size_update_not_at_start" or failure_id(failure) == "hpack.fixture.table_size_update_trailing_bytes" or failure_id(failure) == "hpack.fixture.table_size_update_malformed"
			true => Ok(())
			false => Err("expected HTTP/2 HPACK fixture failure")
		end
	end
end

fn project_hpack_fixture_decode_failure(failure: Http2ProtocolFailure) -> Result<(), String>
	match failure
		HpackFixtureDecodeFailed(offset, observed_size, observed_first_byte, requested_dynamic_index, dynamic_table_entry_count, expected_fixture, codec_module, preview_chunk) => match hpack_fixture_failure_id(expected_fixture) == "hpack.fixture.dynamic_name_continuation_missing"
			true => accept_runtime_diagnostic(hpack_fixture_dynamic_name_continuation_missing(offset, observed_size, observed_first_byte, requested_dynamic_index, dynamic_table_entry_count, expected_fixture, codec_module, byte_view(preview_chunk, byte_offset(0)?, byte_chunk_count(preview_chunk))?))
			false => match hpack_fixture_failure_id(expected_fixture) == "hpack.fixture.dynamic_index_out_of_range"
				true => accept_runtime_diagnostic(hpack_fixture_dynamic_index_out_of_range(offset, observed_size, observed_first_byte, requested_dynamic_index, dynamic_table_entry_count, expected_fixture, codec_module, byte_view(preview_chunk, byte_offset(0)?, byte_chunk_count(preview_chunk))?))
				false => match hpack_fixture_failure_id(expected_fixture) == "hpack.fixture.dynamic_name_continuation_malformed"
					true => accept_runtime_diagnostic(hpack_fixture_dynamic_name_continuation_malformed(offset, observed_size, observed_first_byte, requested_dynamic_index, dynamic_table_entry_count, expected_fixture, codec_module, byte_view(preview_chunk, byte_offset(0)?, byte_chunk_count(preview_chunk))?))
					false => match hpack_fixture_failure_id(expected_fixture) == "hpack.fixture.dynamic_name_continuation_out_of_range"
						true => accept_runtime_diagnostic(hpack_fixture_dynamic_name_continuation_out_of_range(offset, observed_size, observed_first_byte, requested_dynamic_index, dynamic_table_entry_count, expected_fixture, codec_module, byte_view(preview_chunk, byte_offset(0)?, byte_chunk_count(preview_chunk))?))
						false => Err("expected projected HPACK dynamic fixture failure")
					end
				end
			end
		end
		_ => Err("expected projected HPACK fixture failure")
	end
end

fn require_projected_hpack_fixture_failure(step: Http2Step) -> Result<(), String>
	let ignored_failure: () = require_hpack_fixture_failure(step)?
	project_hpack_fixture_decode_failure(step_failure(step))
end

fn continue_http2_deep_dynamic_path_state(inserted: Http2Step, state: Http2DecodeState, remaining: Int) -> Result<Http2DecodeState, String>
	let ignored_inserted: () = require_hpack_transition_header(inserted, state, ":path", "/a")?
	build_http2_deep_dynamic_path_state(remaining - 1, hpack_carry_only_state(step_state(inserted)))
end

fn build_http2_deep_dynamic_path_state(remaining: Int, state: Http2DecodeState) -> Result<Http2DecodeState, String>
	match remaining
		0 => Ok(state)
		_ => continue_http2_deep_dynamic_path_state(receive(InputChunk(byte_chunk_from_hex("00000401040000000144022f61")?), state)?, state, remaining)
	end
end

fn print_hpack_wide_dynamic_name_cases() -> Result<(), String> effects [stdio]
	let deep_state: Http2DecodeState = build_http2_deep_dynamic_path_state(66, frame_state())?
