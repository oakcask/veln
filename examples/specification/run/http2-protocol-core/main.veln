	match state
		State(_, _, _, _, _, _, PeerSettings(_, _, _, NoPeerMaxConcurrentStreams, _, _, _), _, _, _) => 0
		State(_, _, _, _, _, _, PeerSettings(_, _, _, PeerMaxConcurrentStreams(value, _), _, _, _), _, _, _) => value
	end
end

fn state_peer_max_concurrent_streams_offset(state: Http2DecodeState) -> Int
	match state
		State(_, _, _, _, _, _, PeerSettings(_, _, _, NoPeerMaxConcurrentStreams, _, _, _), _, _, _) => 0
		State(_, _, _, _, _, _, PeerSettings(_, _, _, PeerMaxConcurrentStreams(_, item_offset), _, _, _), _, _, _) => item_offset
	end
end

