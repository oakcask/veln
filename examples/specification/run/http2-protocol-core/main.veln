fn print_outbound_content_length_data_cases(outbound_peer_settings: PeerSettingsState) -> Result<(), String> effects [stdio]
	let outbound_content_length_headers: HpackHeaderList = hpack_fixture::outbound_request_content_length_headers()
	let outbound_content_length_headers_sent: Result<OutboundHeadersDecision, HpackFixtureFailure> = send_headers_from_header_list(1, outbound_content_length_headers, false, outbound_peer_settings, outbound_receive_credit_with_open_stream(20, 1, 20))?
	let ignored_outbound_content_length_headers: () = print_outbound_headers_from_list("outbound-content-length-headers", outbound_content_length_headers_sent)?
	let outbound_content_length_credit: OutboundSendCredit = outbound_send_credit_from_headers(outbound_content_length_headers, outbound_headers_result_decision(outbound_content_length_headers_sent))
	let outbound_content_length_data_first: OutboundDataDecision = send_data(1, byte_chunk_from_hex("aabb")?, false, outbound_peer_settings, outbound_content_length_credit)?
	print_outbound_data("outbound-content-length-data-first", outbound_content_length_data_first)
	let ignored_content_length_data_first_chunk: () = print_outbound_data_chunk("http2-content-length-data-first", outbound_content_length_data_first, "000002000000000001aabb")?
	let outbound_content_length_data_exact: OutboundDataDecision = send_data(1, byte_chunk_from_hex("ccddee")?, true, outbound_peer_settings, outbound_data_send_credit(outbound_content_length_data_first))?
	print_outbound_data("outbound-content-length-data-exact", outbound_content_length_data_exact)
	let ignored_content_length_data_exact_chunk: () = print_outbound_data_chunk("http2-content-length-data-exact", outbound_content_length_data_exact, "000003000100000001ccddee")?
	let outbound_response_content_length_headers: HpackHeaderList = hpack_fixture::outbound_response_content_length_headers()
	let outbound_response_content_length_headers_sent: Result<OutboundHeadersDecision, HpackFixtureFailure> = send_headers_from_header_list(1, outbound_response_content_length_headers, false, outbound_peer_settings, outbound_receive_credit_with_open_stream(20, 1, 20))?
	let ignored_outbound_response_content_length_headers: () = print_outbound_headers_from_list("outbound-response-content-length-headers", outbound_response_content_length_headers_sent)?
	let outbound_response_content_length_credit: OutboundSendCredit = outbound_send_credit_from_headers(outbound_response_content_length_headers, outbound_headers_result_decision(outbound_response_content_length_headers_sent))
	let outbound_content_length_padded: OutboundDataDecision = send_padded_data(1, byte_chunk_from_hex("aabbccddee")?, 2, true, outbound_peer_settings, outbound_response_content_length_credit)?
	print_outbound_data("outbound-content-length-padded", outbound_content_length_padded)
	let ignored_content_length_padded_chunk: () = print_outbound_data_chunk("http2-content-length-padded", outbound_content_length_padded, "00000800090000000102aabbccddee0000")?
	let outbound_content_length_over: OutboundDataDecision = send_data(1, byte_chunk_from_hex("aabbccddee00")?, false, outbound_peer_settings, outbound_content_length_credit)?
	print_outbound_data("outbound-content-length-over", outbound_content_length_over)
	let ignored_content_length_over_chunk: () = print_outbound_data_chunk("http2-content-length-over", outbound_content_length_over, "")?
	print_failure("outbound-content-length-over", Failed(frame_state(), outbound_data_failure(outbound_content_length_over)))
	let outbound_content_length_early: OutboundDataDecision = send_data(1, byte_chunk_from_hex("aabbcc")?, true, outbound_peer_settings, outbound_content_length_credit)?
	print_outbound_data("outbound-content-length-early-end-stream", outbound_content_length_early)
	let ignored_content_length_early_chunk: () = print_outbound_data_chunk("http2-content-length-early-end-stream", outbound_content_length_early, "")?
	print_failure("outbound-content-length-early-end-stream", Failed(frame_state(), outbound_data_failure(outbound_content_length_early)))
	Ok(())
end

