fn print_outbound_headers_selected_cases(outbound_receive_credit: OutboundHeadersDecision) -> Result<(), String> effects [stdio]
	let ignored_production_header_fields: () = check_production_outbound_header_fields()?
	let seed_result: Result<OutboundHeadersHpackTransition, HpackFixtureFailure> = send_headers_from_selected_header_list_with_state(1, hpack_fixture::outbound_selected_seed_headers(), hpack_fixture::initial_encode_state(), 4096, false, empty_peer_settings(), outbound_headers_receive_credit(outbound_receive_credit))?
	let seed_transition: OutboundHeadersHpackTransition = require_outbound_headers_hpack_transition(seed_result)?
	let seed_encode: Result<HpackEncodeTransition, HpackFixtureFailure> = Ok(outbound_headers_hpack_encode_transition(seed_transition))
	let seed_state: HpackFixtureState = print_outbound_hpack_encode_transition("outbound-headers-hpack-selected-seed", seed_encode, "824007782d7472616365026f6b")?
	print_outbound_hpack_encode_state_entries("outbound-headers-hpack-selected-seed-state", seed_state)
	let seed_headers: OutboundHeadersDecision = outbound_headers_hpack_decision(seed_transition)
	print_outbound_headers("outbound-headers-hpack-selected-seed", seed_headers)
	let ignored_seed_chunk: () = print_outbound_headers_chunk("http2-headers-hpack-selected-seed", seed_headers, "00000d010400000001824007782d7472616365026f6b")?

	let carried_result: Result<OutboundHeadersHpackTransition, HpackFixtureFailure> = send_headers_from_selected_header_list_with_state(1, hpack_fixture::outbound_selected_carried_headers(), seed_state, 4096, false, empty_peer_settings(), outbound_headers_receive_credit(seed_headers))?
	let carried_transition: OutboundHeadersHpackTransition = require_outbound_headers_hpack_transition(carried_result)?
	let carried_encode: Result<HpackEncodeTransition, HpackFixtureFailure> = Ok(outbound_headers_hpack_encode_transition(carried_transition))
	let carried_state: HpackFixtureState = print_outbound_hpack_encode_transition("outbound-headers-hpack-selected-carried", carried_encode, "be7e05616761696e")?
	print_outbound_hpack_encode_state_entries("outbound-headers-hpack-selected-carried-state", carried_state)
	let carried_headers: OutboundHeadersDecision = outbound_headers_hpack_decision(carried_transition)
	print_outbound_headers("outbound-headers-hpack-selected-carried", carried_headers)
	let ignored_carried_chunk: () = print_outbound_headers_chunk("http2-headers-hpack-selected-carried", carried_headers, "000008010400000001be7e05616761696e")?
	Ok(())
end

