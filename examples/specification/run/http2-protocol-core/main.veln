fn outbound_receive_reset_stream_id(receive_credit: OutboundReceiveCredit) -> Int
	match receive_credit
		OutboundReceiveCredit(_, NoOutboundReceiveCreditStream) => 0
		OutboundReceiveCredit(_, OutboundReceiveCreditOpenStream(_, _)) => 0
		OutboundReceiveCredit(_, OutboundReceiveCreditClosedStream(_)) => 0
		OutboundReceiveCredit(_, OutboundReceiveCreditResetStream(stream_id, _)) => stream_id
	end
end

fn failure_id(failure: Http2ProtocolFailure) -> String
	match failure
		ClosedWithPending(_, _) => "http2.protocol.closed_with_pending"
		ClosedWithPartialPreface(_, _) => "http2.protocol.partial_preface"
		InvalidPreface(_, _, _, _) => "http2.protocol.invalid_preface"
		ContinuationExpected(_, _, _, _, _, _) => "http2.protocol.continuation_expected"
		InvalidFrameKind(_, _, _, _, _, _) => "http2.protocol.invalid_frame_kind"
		InvalidStreamId(_, _, _, _, _, _, _) => "http2.protocol.invalid_stream_id"
		InvalidPayloadLength(_, _, _, _, _, _, _, _) => "http2.protocol.invalid_payload_length"
		InvalidDataPadding(_, _, _, _, _, _, _) => "http2.protocol.invalid_data_padding"
		UnexpectedSettingsAck(_, _, _) => "http2.protocol.unexpected_settings_ack"
		InvalidPriorityDependency(_, _, _, _, _) => "http2.protocol.invalid_priority_dependency"
		StreamAfterGoaway(_, _, _, _, _, _) => "http2.protocol.stream_after_goaway"
		FrameSizeExceeded(_, _, _, _, _) => "http2.peer_limit.frame_size_exceeded"
		FlowControlWindowExceeded(_, _, _, _, _, _, _) => "http2.peer_limit.flow_control_window_exceeded"
		ConcurrentStreamsExceeded(_, _, _, _, _, _, _) => "http2.peer_limit.concurrent_streams_exceeded"
		HeaderListSizeExceeded(_, _, _, _, _, _) => "http2.peer_limit.header_list_size_exceeded"
		SettingsValueOutOfRange(_, _, _, _, _, _, _) => "http2.peer_limit.settings_value_out_of_range"
		HpackFixtureDecodeFailed(_, _, _, _, _) => "hpack.fixture.unsupported_header_block"
	end
end

fn failure_offset(failure: Http2ProtocolFailure) -> Int
	match failure
		ClosedWithPending(offset, _) => offset
		ClosedWithPartialPreface(offset, _) => offset
		InvalidPreface(offset, _, _, _) => offset
		ContinuationExpected(offset, _, _, _, _, _) => offset
		InvalidFrameKind(offset, _, _, _, _, _) => offset
		InvalidStreamId(offset, _, _, _, _, _, _) => offset
		InvalidPayloadLength(offset, _, _, _, _, _, _, _) => offset
		InvalidDataPadding(offset, _, _, _, _, _, _) => offset
		UnexpectedSettingsAck(offset, _, _) => offset
		InvalidPriorityDependency(offset, _, _, _, _) => offset
		StreamAfterGoaway(offset, _, _, _, _, _) => offset
		FrameSizeExceeded(offset, _, _, _, _) => offset
		FlowControlWindowExceeded(offset, _, _, _, _, _, _) => offset
		ConcurrentStreamsExceeded(offset, _, _, _, _, _, _) => offset
		HeaderListSizeExceeded(offset, _, _, _, _, _) => offset
		SettingsValueOutOfRange(offset, _, _, _, _, _, _) => offset
		HpackFixtureDecodeFailed(offset, _, _, _, _) => offset
	end
end

fn failure_pending_count(failure: Http2ProtocolFailure) -> Int
	match failure
		ClosedWithPending(_, pending_count) => pending_count
		ClosedWithPartialPreface(_, pending_count) => pending_count
		InvalidPreface(_, _, _, matched_count) => matched_count
		ContinuationExpected(_, _, _, _, _, _) => 0
		InvalidFrameKind(_, _, _, _, _, _) => 0
		InvalidStreamId(_, _, _, _, _, _, _) => 0
		InvalidPayloadLength(_, _, _, _, _, _, _, _) => 0
		InvalidDataPadding(_, _, _, _, _, _, _) => 0
		UnexpectedSettingsAck(_, _, _) => 0
		InvalidPriorityDependency(_, _, _, _, _) => 0
		StreamAfterGoaway(_, _, _, _, _, _) => 0
		FrameSizeExceeded(_, _, _, _, _) => 0
		FlowControlWindowExceeded(_, _, _, _, _, _, _) => 0
		ConcurrentStreamsExceeded(_, _, _, _, _, _, _) => 0
		HeaderListSizeExceeded(_, _, _, _, _, _) => 0
		SettingsValueOutOfRange(_, _, _, _, _, _, _) => 0
		HpackFixtureDecodeFailed(_, _, _, _, _) => 0
	end
end

fn failure_actual_kind(failure: Http2ProtocolFailure) -> Int
	match failure
		ClosedWithPending(_, _) => 0
		ClosedWithPartialPreface(_, _) => 0
		InvalidPreface(_, _, actual_byte, _) => actual_byte
		ContinuationExpected(_, actual_kind, _, _, _, _) => actual_kind
		InvalidFrameKind(_, actual_kind, _, _, _, _) => actual_kind
		InvalidStreamId(_, actual_kind, _, _, _, _, _) => actual_kind
		InvalidPayloadLength(_, actual_kind, _, _, _, _, _, _) => actual_kind
		InvalidDataPadding(_, _, _, _, _, _, _) => 0
		UnexpectedSettingsAck(_, _, _) => 4
		InvalidPriorityDependency(_, _, _, _, _) => 2
		StreamAfterGoaway(_, _, _, _, _, _) => 1
		FrameSizeExceeded(_, _, _, actual_kind, _) => actual_kind
		FlowControlWindowExceeded(_, actual_kind, _, _, _, _, _) => actual_kind
		ConcurrentStreamsExceeded(_, _, _, _, _, _, _) => 1
		HeaderListSizeExceeded(_, _, _, actual_kind, _, _) => actual_kind
		SettingsValueOutOfRange(_, _, _, _, _, _, _) => 4
		HpackFixtureDecodeFailed(_, _, _, _, _) => 1
	end
end

fn failure_actual_stream(failure: Http2ProtocolFailure) -> Int
	match failure
		ClosedWithPending(_, _) => 0
		ClosedWithPartialPreface(_, _) => 0
		InvalidPreface(_, _, _, _) => 0
		ContinuationExpected(_, _, actual_stream, _, _, _) => actual_stream
		InvalidFrameKind(_, _, actual_stream, _, _, _) => actual_stream
		InvalidStreamId(_, _, actual_stream, _, _, _, _) => actual_stream
		InvalidPayloadLength(_, _, actual_stream, _, _, _, _, _) => actual_stream
		InvalidDataPadding(_, actual_stream, _, _, _, _, _) => actual_stream
		UnexpectedSettingsAck(_, _, _) => 0
		InvalidPriorityDependency(_, stream_id, _, _, _) => stream_id
		StreamAfterGoaway(_, stream_id, _, _, _, _) => stream_id
		FrameSizeExceeded(_, _, _, _, actual_stream) => actual_stream
		FlowControlWindowExceeded(_, _, actual_stream, _, _, _, _) => actual_stream
		ConcurrentStreamsExceeded(_, stream_id, _, _, _, _, _) => stream_id
		HeaderListSizeExceeded(_, _, _, _, actual_stream, _) => actual_stream
		SettingsValueOutOfRange(_, _, _, _, _, _, _) => 0
		HpackFixtureDecodeFailed(_, _, _, _, _) => 0
	end
end

fn failure_expected_stream(failure: Http2ProtocolFailure) -> Int
	match failure
		ClosedWithPending(_, _) => 0
		ClosedWithPartialPreface(_, _) => 0
		InvalidPreface(_, _, _, _) => 0
		ContinuationExpected(_, _, _, expected_stream, _, _) => expected_stream
		InvalidFrameKind(_, _, _, _, _, _) => 0
		InvalidStreamId(_, _, _, _, _, _, _) => 0
