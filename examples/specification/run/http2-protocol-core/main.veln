	match state
		State(_, _, _, _, _, _, PeerSettings(_, NoPeerInitialWindowSize, _, _, _, _, _), _, _, _) => 0
		State(_, _, _, _, _, _, PeerSettings(_, PeerInitialWindowSize(_, item_offset), _, _, _, _, _), _, _, _) => item_offset
