fn send_ping_ack_for_received(step: Http2Step) -> Result<OutboundPingAckDecision, String>
	match step
		FrameDecoded(_, _, _, kind, flags, _, _, frame) => match kind == 6
			true => match ping_ack_set(flags)
				true => Ok(OutboundPingAckNoResponse)
				false => encode_ping_ack_intent(frame)
			end
			false => Ok(OutboundPingAckNoResponse)
		end
		Waiting(_) => Ok(OutboundPingAckNoResponse)
		Failed(_, _) => Ok(OutboundPingAckNoResponse)
	end
end

fn encode_ping_ack_intent(frame: Http2Frame) -> Result<OutboundPingAckDecision, String>
	match frame
		KnownFrame(_, _, _, payload) => encode_ping_ack_payload(byte_view_to_chunk(payload))
		PriorityFrame(_, _, _, _, _) => Ok(OutboundPingAckNoResponse)
		UnknownFrame(_, _, _, _) => Ok(OutboundPingAckNoResponse)
	end
end

fn encode_ping_ack_payload(payload: ByteChunk) -> Result<OutboundPingAckDecision, String>
	let encoded_header: Result<ByteChunk, EncodeError> = encode_frame_header({length: 8, kind: 6, flags: 1, stream_id: 0})
	match encoded_header
		Ok(header) => Ok(OutboundPingAckAccepted(byte_append(header, payload)))
		Err(error) => Ok(OutboundPingAckEncodeFailed(error))
	end
end

fn send_goaway(last_stream_id: Int, error_code: Int, state: Http2DecodeState) -> Result<OutboundGoawayDecision, String>
	let encoded_payload: Result<ByteChunk, EncodeError> = encode_goaway_payload({last_stream_id: last_stream_id, error_code: error_code})
	match encoded_payload
		Ok(payload) => encode_goaway_intent(last_stream_id, error_code, state, payload)
		Err(error) => Ok(OutboundGoawayEncodeFailed(last_stream_id, error_code, error))
	end
end

fn encode_goaway_intent(last_stream_id: Int, error_code: Int, state: Http2DecodeState, payload: ByteChunk) -> Result<OutboundGoawayDecision, String>
	let encoded_header: Result<ByteChunk, EncodeError> = encode_frame_header({length: 8, kind: 7, flags: 0, stream_id: 0})
	match encoded_header
		Ok(header) => Ok(OutboundGoawayAccepted(last_stream_id, error_code, goaway_sent_state(last_stream_id, error_code, state), byte_append(header, payload)))
		Err(error) => Ok(OutboundGoawayEncodeFailed(last_stream_id, error_code, error))
	end
end

fn goaway_sent_state(last_stream_id: Int, error_code: Int, state: Http2DecodeState) -> Http2DecodeState
	match state
		State(pending, next_offset, preface_state, continuation, hpack_state, receive_limit, peer_settings, _, receive_flow_control) => State(pending, next_offset, preface_state, continuation, hpack_state, receive_limit, peer_settings, GracefulShutdown(last_stream_id, error_code), receive_flow_control)
	end
end

fn send_rst_stream(stream_id: Int, error_code: Int, receive_credit: OutboundReceiveCredit) -> Result<OutboundRstStreamDecision, String>
	match stream_id
		0 => Ok(OutboundRstStreamRejected(stream_id, error_code, InvalidStreamId(0, 3, stream_id, "nonzero open stream id", "local", "stream-id-domain", "outbound_rst_stream_requires_open_stream")))
		_ => send_nonzero_rst_stream(stream_id, error_code, receive_credit)
	end
end

fn send_nonzero_rst_stream(stream_id: Int, error_code: Int, receive_credit: OutboundReceiveCredit) -> Result<OutboundRstStreamDecision, String>
	match receive_credit
		OutboundReceiveCredit(connection_window, NoOutboundReceiveCreditStream) => Ok(OutboundRstStreamRejected(stream_id, error_code, InvalidFrameKind(0, 3, stream_id, 1, "idle-stream", "idle_streams_require_headers")))
		OutboundReceiveCredit(connection_window, OutboundReceiveCreditOpenStream(open_stream_id, _)) => match stream_id == open_stream_id
			true => encode_rst_stream_intent(stream_id, error_code, connection_window)
			false => Ok(OutboundRstStreamRejected(stream_id, error_code, InvalidFrameKind(0, 3, stream_id, 1, "idle-stream", "idle_streams_require_headers")))
		end
		OutboundReceiveCredit(connection_window, OutboundReceiveCreditOpenStreamContentLength(open_stream_id, _, _, _)) => match stream_id == open_stream_id
			true => encode_rst_stream_intent(stream_id, error_code, connection_window)
			false => Ok(OutboundRstStreamRejected(stream_id, error_code, InvalidFrameKind(0, 3, stream_id, 1, "idle-stream", "idle_streams_require_headers")))
		end
		OutboundReceiveCredit(connection_window, OutboundReceiveCreditClosedStream(closed_stream_id)) => match stream_id == closed_stream_id
			true => Ok(OutboundRstStreamRejected(stream_id, error_code, InvalidFrameKind(0, 3, stream_id, 1, "closed-stream", "closed_stream_rejects_later_frames")))
			false => Ok(OutboundRstStreamRejected(stream_id, error_code, InvalidFrameKind(0, 3, stream_id, 1, "idle-stream", "idle_streams_require_headers")))
		end
		OutboundReceiveCredit(connection_window, OutboundReceiveCreditResetStream(reset_stream_id, _)) => match stream_id == reset_stream_id
			true => Ok(OutboundRstStreamRejected(stream_id, error_code, InvalidFrameKind(0, 3, stream_id, 1, "reset-stream", "reset_stream_rejects_later_frames")))
			false => Ok(OutboundRstStreamRejected(stream_id, error_code, InvalidFrameKind(0, 3, stream_id, 1, "idle-stream", "idle_streams_require_headers")))
		end
	end
end

fn encode_rst_stream_intent(stream_id: Int, error_code: Int, connection_window: Int) -> Result<OutboundRstStreamDecision, String>
	let encoded_header: Result<ByteChunk, EncodeError> = encode_frame_header({length: 4, kind: 3, flags: 0, stream_id: stream_id})
	match encoded_header
		Ok(header) => encode_rst_stream_payload_intent(stream_id, error_code, connection_window, header)
		Err(error) => Ok(OutboundRstStreamEncodeFailed(stream_id, error_code, error))
	end
end

fn encode_rst_stream_payload_intent(stream_id: Int, error_code: Int, connection_window: Int, header: ByteChunk) -> Result<OutboundRstStreamDecision, String>
	let encoded_payload: Result<ByteChunk, EncodeError> = encode_rst_stream_payload({error_code: error_code})
	match encoded_payload
		Ok(payload) => Ok(OutboundRstStreamAccepted(stream_id, error_code, OutboundReceiveCredit(connection_window, OutboundReceiveCreditResetStream(stream_id, error_code)), byte_append(header, payload)))
		Err(error) => Ok(OutboundRstStreamEncodeFailed(stream_id, error_code, error))
	end
end

fn send_priority(stream_id: Int, dependency_stream_id: Int, exclusive: Bool, weight: Int, receive_credit: OutboundReceiveCredit) -> Result<OutboundPriorityDecision, String>
	match stream_id
		0 => Ok(OutboundPriorityRejected(stream_id, dependency_stream_id, exclusive, weight, InvalidStreamId(0, 2, stream_id, "nonzero open stream id", "local", "stream-id-domain", "outbound_priority_requires_open_stream")))
		_ => send_nonzero_priority(stream_id, dependency_stream_id, exclusive, weight, receive_credit)
	end
end

fn send_nonzero_priority(stream_id: Int, dependency_stream_id: Int, exclusive: Bool, weight: Int, receive_credit: OutboundReceiveCredit) -> Result<OutboundPriorityDecision, String>
	match receive_credit
		OutboundReceiveCredit(connection_window, NoOutboundReceiveCreditStream) => Ok(OutboundPriorityRejected(stream_id, dependency_stream_id, exclusive, weight, InvalidFrameKind(0, 2, stream_id, 1, "idle-stream", "idle_streams_require_headers")))
		OutboundReceiveCredit(connection_window, OutboundReceiveCreditOpenStream(open_stream_id, stream_window)) => match stream_id == open_stream_id
			true => validate_outbound_priority_dependency(stream_id, dependency_stream_id, exclusive, weight, connection_window, stream_window)
			false => Ok(OutboundPriorityRejected(stream_id, dependency_stream_id, exclusive, weight, InvalidFrameKind(0, 2, stream_id, 1, "idle-stream", "idle_streams_require_headers")))
		end
		OutboundReceiveCredit(connection_window, OutboundReceiveCreditOpenStreamContentLength(open_stream_id, stream_window, _, _)) => match stream_id == open_stream_id
			true => validate_outbound_priority_dependency(stream_id, dependency_stream_id, exclusive, weight, connection_window, stream_window)
			false => Ok(OutboundPriorityRejected(stream_id, dependency_stream_id, exclusive, weight, InvalidFrameKind(0, 2, stream_id, 1, "idle-stream", "idle_streams_require_headers")))
		end
		OutboundReceiveCredit(connection_window, OutboundReceiveCreditClosedStream(closed_stream_id)) => match stream_id == closed_stream_id
			true => Ok(OutboundPriorityRejected(stream_id, dependency_stream_id, exclusive, weight, InvalidFrameKind(0, 2, stream_id, 1, "closed-stream", "closed_stream_rejects_later_frames")))
			false => Ok(OutboundPriorityRejected(stream_id, dependency_stream_id, exclusive, weight, InvalidFrameKind(0, 2, stream_id, 1, "idle-stream", "idle_streams_require_headers")))
		end
		OutboundReceiveCredit(connection_window, OutboundReceiveCreditResetStream(reset_stream_id, _)) => match stream_id == reset_stream_id
			true => Ok(OutboundPriorityRejected(stream_id, dependency_stream_id, exclusive, weight, InvalidFrameKind(0, 2, stream_id, 1, "reset-stream", "reset_stream_rejects_later_frames")))
			false => Ok(OutboundPriorityRejected(stream_id, dependency_stream_id, exclusive, weight, InvalidFrameKind(0, 2, stream_id, 1, "idle-stream", "idle_streams_require_headers")))
		end
	end
end

fn validate_outbound_priority_dependency(stream_id: Int, dependency_stream_id: Int, exclusive: Bool, weight: Int, connection_window: Int, stream_window: Int) -> Result<OutboundPriorityDecision, String>
	match stream_id == dependency_stream_id
		true => Ok(OutboundPriorityRejected(stream_id, dependency_stream_id, exclusive, weight, InvalidPriorityDependency(0, stream_id, dependency_stream_id, "stream-control", "rfc9113_priority_dependency", empty_byte_preview()?)))
		false => encode_priority_intent(stream_id, dependency_stream_id, exclusive, weight, connection_window, stream_window)
	end
end

fn encode_priority_intent(stream_id: Int, dependency_stream_id: Int, exclusive: Bool, weight: Int, connection_window: Int, stream_window: Int) -> Result<OutboundPriorityDecision, String>
	let encoded_header: Result<ByteChunk, EncodeError> = encode_frame_header({length: 5, kind: 2, flags: 0, stream_id: stream_id})
	match encoded_header
		Ok(header) => encode_priority_payload_intent(stream_id, dependency_stream_id, exclusive, weight, connection_window, stream_window, header)
		Err(error) => Ok(OutboundPriorityEncodeFailed(stream_id, dependency_stream_id, exclusive, weight, error))
	end
end

fn encode_priority_payload_intent(stream_id: Int, dependency_stream_id: Int, exclusive: Bool, weight: Int, connection_window: Int, stream_window: Int, header: ByteChunk) -> Result<OutboundPriorityDecision, String>
	let encoded_dependency: Result<ByteChunk, EncodeError> = encode_priority_dependency_payload({dependency_stream_id: dependency_stream_id})
	match encoded_dependency
		Ok(dependency_payload) => encode_priority_weight_payload_intent(stream_id, dependency_stream_id, exclusive, weight, connection_window, stream_window, header, dependency_payload)
		Err(error) => Ok(OutboundPriorityEncodeFailed(stream_id, dependency_stream_id, exclusive, weight, error))
	end
end

fn encode_priority_weight_payload_intent(stream_id: Int, dependency_stream_id: Int, exclusive: Bool, weight: Int, connection_window: Int, stream_window: Int, header: ByteChunk, dependency_payload: ByteChunk) -> Result<OutboundPriorityDecision, String>
	let encoded_weight: Result<ByteChunk, EncodeError> = encode_priority_weight_payload({weight: weight - 1})
	match encoded_weight
		Ok(weight_payload) => Ok(OutboundPriorityAccepted(stream_id, dependency_stream_id, exclusive, weight, OutboundReceiveCredit(connection_window, OutboundReceiveCreditOpenStream(stream_id, stream_window)), byte_append(header, byte_append(priority_dependency_payload_with_exclusive(dependency_payload, exclusive)?, weight_payload))))
		Err(error) => Ok(OutboundPriorityEncodeFailed(stream_id, dependency_stream_id, exclusive, weight, error))
	end
end

fn priority_dependency_payload_with_exclusive(payload: ByteChunk, exclusive: Bool) -> Result<ByteChunk, String>
	let first: Int = read_byte(payload, 0)?
	let encoded_first: Int = first + exclusive_bit_value(exclusive)
	let second: Int = read_byte(payload, 1)?
	let third: Int = read_byte(payload, 2)?
	let fourth: Int = read_byte(payload, 3)?
	Ok(byte_append(byte_append(byte_append(byte_write_u8_be(encoded_first)?, byte_write_u8_be(second)?), byte_write_u8_be(third)?), byte_write_u8_be(fourth)?))
end

fn exclusive_bit_value(exclusive: Bool) -> Int
	match exclusive
		true => 128
		false => 0
	end
end

fn send_headers(stream_id: Int, header_block: ByteChunk, end_stream: Bool, peer_settings: PeerSettingsState, receive_credit: OutboundReceiveCredit) -> Result<OutboundHeadersDecision, String>
	send_headers_with_shutdown(stream_id, header_block, end_stream, peer_settings, OpenConnection, receive_credit)
end

fn send_headers_with_shutdown(stream_id: Int, header_block: ByteChunk, end_stream: Bool, peer_settings: PeerSettingsState, shutdown_state: ConnectionShutdownState, receive_credit: OutboundReceiveCredit) -> Result<OutboundHeadersDecision, String>
	let payload_length: Int = byte_count_to_int(byte_chunk_count(header_block))
	match stream_id
		0 => Ok(OutboundHeadersRejected(stream_id, payload_length, end_stream, InvalidStreamId(0, 1, stream_id, "nonzero open stream id", "local", "stream-id-domain", "outbound_headers_requires_open_stream")))
		_ => send_nonzero_headers(stream_id, payload_length, header_block, end_stream, active_peer_max_frame_size(peer_settings), shutdown_state, receive_credit)
	end
end

fn send_headers_from_header_list(stream_id: Int, headers: HpackHeaderList, end_stream: Bool, peer_settings: PeerSettingsState, receive_credit: OutboundReceiveCredit) -> Result<Result<OutboundHeadersDecision, HpackFixtureFailure>, String>
	match hpack_fixture::encode_header_list_with_state(headers, hpack_fixture::initial_encode_state(), 0)
		Ok(transition) => match send_headers(stream_id, hpack_fixture::encode_transition_bytes(transition), end_stream, peer_settings, receive_credit)
			Ok(decision) => Ok(Ok(decision))
			Err(error) => Err(error)
		end
		Err(failure) => Ok(Err(failure))
	end
end

fn encode_hpack_table_size_update(table_size: Int, peer_settings: PeerSettingsState, state: HpackFixtureState) -> Result<HpackEncodeTransition, HpackFixtureFailure>
	hpack_fixture::encode_table_size_update_with_state(table_size, active_peer_header_table_size(peer_settings), state, 0)
end

fn send_headers_from_hpack_table_size_update(stream_id: Int, table_size: Int, end_stream: Bool, peer_settings: PeerSettingsState, state: HpackFixtureState, receive_credit: OutboundReceiveCredit) -> Result<Result<OutboundHeadersDecision, HpackFixtureFailure>, String>
	match encode_hpack_table_size_update(table_size, peer_settings, state)
		Ok(transition) => match send_headers(stream_id, hpack_fixture::encode_transition_bytes(transition), end_stream, peer_settings, receive_credit)
			Ok(decision) => Ok(Ok(decision))
			Err(error) => Err(error)
		end
		Err(failure) => Ok(Err(failure))
	end
end

fn send_nonzero_headers(stream_id: Int, payload_length: Int, header_block: ByteChunk, end_stream: Bool, max_frame_size: Int, shutdown_state: ConnectionShutdownState, receive_credit: OutboundReceiveCredit) -> Result<OutboundHeadersDecision, String>
	match receive_credit
		OutboundReceiveCredit(connection_window, NoOutboundReceiveCreditStream) => Ok(OutboundHeadersRejected(stream_id, payload_length, end_stream, InvalidFrameKind(0, 1, stream_id, 1, "idle-stream", "idle_streams_require_headers")))
		OutboundReceiveCredit(connection_window, OutboundReceiveCreditOpenStream(open_stream_id, stream_window)) => match stream_id == open_stream_id
			true => validate_outbound_headers_after_goaway(stream_id, payload_length, header_block, end_stream, max_frame_size, shutdown_state, connection_window, stream_window)
			false => Ok(OutboundHeadersRejected(stream_id, payload_length, end_stream, InvalidFrameKind(0, 1, stream_id, 1, "idle-stream", "idle_streams_require_headers")))
		end
		OutboundReceiveCredit(connection_window, OutboundReceiveCreditOpenStreamContentLength(open_stream_id, stream_window, _, _)) => match stream_id == open_stream_id
			true => validate_outbound_headers_after_goaway(stream_id, payload_length, header_block, end_stream, max_frame_size, shutdown_state, connection_window, stream_window)
			false => Ok(OutboundHeadersRejected(stream_id, payload_length, end_stream, InvalidFrameKind(0, 1, stream_id, 1, "idle-stream", "idle_streams_require_headers")))
		end
		OutboundReceiveCredit(connection_window, OutboundReceiveCreditClosedStream(closed_stream_id)) => match stream_id == closed_stream_id
			true => Ok(OutboundHeadersRejected(stream_id, payload_length, end_stream, InvalidFrameKind(0, 1, stream_id, 1, "closed-stream", "closed_stream_rejects_later_frames")))
			false => Ok(OutboundHeadersRejected(stream_id, payload_length, end_stream, InvalidFrameKind(0, 1, stream_id, 1, "idle-stream", "idle_streams_require_headers")))
		end
		OutboundReceiveCredit(connection_window, OutboundReceiveCreditResetStream(reset_stream_id, _)) => match stream_id == reset_stream_id
			true => Ok(OutboundHeadersRejected(stream_id, payload_length, end_stream, InvalidFrameKind(0, 1, stream_id, 1, "reset-stream", "reset_stream_rejects_later_frames")))
			false => Ok(OutboundHeadersRejected(stream_id, payload_length, end_stream, InvalidFrameKind(0, 1, stream_id, 1, "idle-stream", "idle_streams_require_headers")))
		end
	end
end

fn validate_outbound_headers_after_goaway(stream_id: Int, payload_length: Int, header_block: ByteChunk, end_stream: Bool, max_frame_size: Int, shutdown_state: ConnectionShutdownState, connection_window: Int, stream_window: Int) -> Result<OutboundHeadersDecision, String>
	match shutdown_state
		OpenConnection => validate_headers_frame_size(stream_id, payload_length, header_block, end_stream, max_frame_size, connection_window, stream_window)
		GracefulShutdown(last_stream_id, _) => match stream_id > last_stream_id
			true => Ok(OutboundHeadersRejected(stream_id, payload_length, end_stream, StreamAfterGoaway(0, stream_id, last_stream_id, "graceful_shutdown", "local", "goaway_last_stream_id", empty_header_block())))
			false => validate_headers_frame_size(stream_id, payload_length, header_block, end_stream, max_frame_size, connection_window, stream_window)
		end
	end
end

fn validate_headers_frame_size(stream_id: Int, payload_length: Int, header_block: ByteChunk, end_stream: Bool, max_frame_size: Int, connection_window: Int, stream_window: Int) -> Result<OutboundHeadersDecision, String>
	encode_headers_intent(stream_id, payload_length, header_block, end_stream, max_frame_size, connection_window, stream_window)
end

fn encode_headers_intent(stream_id: Int, payload_length: Int, header_block: ByteChunk, end_stream: Bool, max_frame_size: Int, connection_window: Int, stream_window: Int) -> Result<OutboundHeadersDecision, String>
	match max_frame_size < 1
		true => Ok(OutboundHeadersRejected(stream_id, payload_length, end_stream, FrameSizeExceeded(0, payload_length, ReceiveLimit(max_frame_size, LocalConfiguration), 1, stream_id)))
		false => match payload_length > max_frame_size
			true => encode_split_headers_intent(stream_id, payload_length, header_block, end_stream, max_frame_size, connection_window, stream_window)
			false => encode_single_headers_intent(stream_id, payload_length, header_block, end_stream, connection_window, stream_window)
		end
	end
end

fn encode_single_headers_intent(stream_id: Int, payload_length: Int, header_block: ByteChunk, end_stream: Bool, connection_window: Int, stream_window: Int) -> Result<OutboundHeadersDecision, String>
	let flags: Int = headers_flags(end_stream)
	let encoded_header: Result<ByteChunk, EncodeError> = encode_frame_header({length: payload_length, kind: 1, flags: flags, stream_id: stream_id})
	match encoded_header
		Ok(header) => Ok(OutboundHeadersAccepted(stream_id, payload_length, end_stream, headers_sent_receive_credit(stream_id, end_stream, connection_window, stream_window), byte_append(header, header_block)))
		Err(error) => Ok(OutboundHeadersEncodeFailed(stream_id, payload_length, end_stream, error))
	end
end

fn encode_split_headers_intent(stream_id: Int, payload_length: Int, header_block: ByteChunk, end_stream: Bool, max_frame_size: Int, connection_window: Int, stream_window: Int) -> Result<OutboundHeadersDecision, String>
	let chunk_count: ByteCount = byte_count(max_frame_size)?
	let first_payload: ByteChunk = byte_take(header_block, chunk_count)?
	let remaining: ByteChunk = byte_drop(header_block, chunk_count)?
	let encoded_header: Result<ByteChunk, EncodeError> = encode_frame_header({length: max_frame_size, kind: 1, flags: first_headers_flags(end_stream), stream_id: stream_id})
	match encoded_header
		Ok(header) => encode_continuation_headers_intent(stream_id, payload_length, end_stream, max_frame_size, connection_window, stream_window, remaining, byte_append(header, first_payload))
		Err(error) => Ok(OutboundHeadersEncodeFailed(stream_id, payload_length, end_stream, error))
	end
end

fn encode_continuation_headers_intent(stream_id: Int, payload_length: Int, end_stream: Bool, max_frame_size: Int, connection_window: Int, stream_window: Int, remaining: ByteChunk, encoded: ByteChunk) -> Result<OutboundHeadersDecision, String>
	let remaining_length: Int = byte_count_to_int(byte_chunk_count(remaining))
	match remaining_length > max_frame_size
		true => encode_nonfinal_continuation_header(stream_id, payload_length, end_stream, max_frame_size, connection_window, stream_window, remaining, encoded)
		false => encode_final_continuation_header(stream_id, payload_length, end_stream, remaining_length, connection_window, stream_window, remaining, encoded)
	end
end

fn encode_nonfinal_continuation_header(stream_id: Int, payload_length: Int, end_stream: Bool, max_frame_size: Int, connection_window: Int, stream_window: Int, remaining: ByteChunk, encoded: ByteChunk) -> Result<OutboundHeadersDecision, String>
	let chunk_count: ByteCount = byte_count(max_frame_size)?
	let payload: ByteChunk = byte_take(remaining, chunk_count)?
	let next_remaining: ByteChunk = byte_drop(remaining, chunk_count)?
	let encoded_header: Result<ByteChunk, EncodeError> = encode_frame_header({length: max_frame_size, kind: 9, flags: 0, stream_id: stream_id})
	match encoded_header
		Ok(header) => encode_continuation_headers_intent(stream_id, payload_length, end_stream, max_frame_size, connection_window, stream_window, next_remaining, byte_append(byte_append(encoded, header), payload))
		Err(error) => Ok(OutboundHeadersEncodeFailed(stream_id, payload_length, end_stream, error))
	end
end

fn encode_final_continuation_header(stream_id: Int, payload_length: Int, end_stream: Bool, final_length: Int, connection_window: Int, stream_window: Int, remaining: ByteChunk, encoded: ByteChunk) -> Result<OutboundHeadersDecision, String>
	let encoded_header: Result<ByteChunk, EncodeError> = encode_frame_header({length: final_length, kind: 9, flags: 4, stream_id: stream_id})
	match encoded_header
		Ok(header) => Ok(OutboundHeadersAccepted(stream_id, payload_length, end_stream, headers_sent_receive_credit(stream_id, end_stream, connection_window, stream_window), byte_append(byte_append(encoded, header), remaining)))
		Err(error) => Ok(OutboundHeadersEncodeFailed(stream_id, payload_length, end_stream, error))
	end
end

fn headers_flags(end_stream: Bool) -> Int
	match end_stream
		true => 5
		false => 4
	end
end

fn first_headers_flags(end_stream: Bool) -> Int
	match end_stream
		true => 1
		false => 0
	end
end

fn headers_sent_receive_credit(stream_id: Int, end_stream: Bool, connection_window: Int, stream_window: Int) -> OutboundReceiveCredit
	match end_stream
		true => OutboundReceiveCredit(connection_window, OutboundReceiveCreditClosedStream(stream_id))
		false => OutboundReceiveCredit(connection_window, OutboundReceiveCreditOpenStream(stream_id, stream_window))
	end
end

fn send_push_promise(stream_id: Int, promised_stream_id: Int, header_block: ByteChunk, peer_settings: PeerSettingsState, receive_credit: OutboundReceiveCredit) -> Result<OutboundPushPromiseDecision, String>
	let header_block_length: Int = byte_count_to_int(byte_chunk_count(header_block))
	let payload_length: Int = header_block_length + 4
	match stream_id
		0 => Ok(OutboundPushPromiseRejected(stream_id, promised_stream_id, payload_length, InvalidStreamId(0, 5, stream_id, "nonzero open client-created stream id", "local", "stream-id-domain", "outbound_push_promise_requires_open_stream")))
		_ => match stream_id_is_client_initiated(stream_id)
			true => match peer_enable_push_disabled(peer_settings)
				true => Ok(OutboundPushPromiseRejected(stream_id, promised_stream_id, payload_length, InvalidFrameKind(0, 5, stream_id, 5, "peer-settings", "settings_enable_push_disabled")))
				false => send_nonzero_push_promise(stream_id, promised_stream_id, payload_length, header_block, active_peer_max_frame_size(peer_settings), receive_credit)
			end
			false => Ok(OutboundPushPromiseRejected(stream_id, promised_stream_id, payload_length, InvalidStreamId(0, 5, stream_id, "nonzero open client-created stream id", "local", "stream-id-domain", "outbound_push_promise_requires_open_stream")))
		end
	end
end

fn send_push_promise_from_header_list(stream_id: Int, promised_stream_id: Int, headers: HpackHeaderList, peer_settings: PeerSettingsState, receive_credit: OutboundReceiveCredit) -> Result<Result<OutboundPushPromiseDecision, HpackFixtureFailure>, String>
	match hpack_fixture::encode_header_list_with_state(headers, hpack_fixture::initial_encode_state(), 0)
		Ok(transition) => match send_push_promise(stream_id, promised_stream_id, hpack_fixture::encode_transition_bytes(transition), peer_settings, receive_credit)
			Ok(decision) => Ok(Ok(decision))
			Err(error) => Err(error)
		end
		Err(failure) => Ok(Err(failure))
	end
end

fn send_push_promise_from_header_list_with_state(stream_id: Int, promised_stream_id: Int, headers: HpackHeaderList, state: HpackFixtureState, peer_settings: PeerSettingsState, receive_credit: OutboundReceiveCredit) -> Result<Result<OutboundPushPromiseHpackTransition, HpackFixtureFailure>, String>
	match hpack_fixture::encode_header_list_with_state(headers, state, 0)
		Ok(transition) => match send_push_promise(stream_id, promised_stream_id, hpack_fixture::encode_transition_bytes(transition), peer_settings, receive_credit)
			Ok(decision) => Ok(Ok(OutboundPushPromiseHpackTransition(decision, hpack_fixture::encode_transition_state(transition))))
			Err(error) => Err(error)
		end
		Err(failure) => Ok(Err(failure))
	end
end

fn send_nonzero_push_promise(stream_id: Int, promised_stream_id: Int, payload_length: Int, header_block: ByteChunk, max_frame_size: Int, receive_credit: OutboundReceiveCredit) -> Result<OutboundPushPromiseDecision, String>
	match receive_credit
		OutboundReceiveCredit(connection_window, NoOutboundReceiveCreditStream) => Ok(OutboundPushPromiseRejected(stream_id, promised_stream_id, payload_length, InvalidFrameKind(0, 5, stream_id, 1, "idle-stream", "idle_streams_require_headers")))
		OutboundReceiveCredit(connection_window, OutboundReceiveCreditOpenStream(open_stream_id, stream_window)) => match stream_id == open_stream_id
			true => validate_promised_stream_id(stream_id, promised_stream_id, payload_length, header_block, max_frame_size, connection_window, stream_window)
			false => Ok(OutboundPushPromiseRejected(stream_id, promised_stream_id, payload_length, InvalidFrameKind(0, 5, stream_id, 1, "idle-stream", "idle_streams_require_headers")))
		end
		OutboundReceiveCredit(connection_window, OutboundReceiveCreditOpenStreamContentLength(open_stream_id, stream_window, _, _)) => match stream_id == open_stream_id
			true => validate_promised_stream_id(stream_id, promised_stream_id, payload_length, header_block, max_frame_size, connection_window, stream_window)
			false => Ok(OutboundPushPromiseRejected(stream_id, promised_stream_id, payload_length, InvalidFrameKind(0, 5, stream_id, 1, "idle-stream", "idle_streams_require_headers")))
		end
		OutboundReceiveCredit(connection_window, OutboundReceiveCreditClosedStream(closed_stream_id)) => match stream_id == closed_stream_id
			true => Ok(OutboundPushPromiseRejected(stream_id, promised_stream_id, payload_length, InvalidFrameKind(0, 5, stream_id, 1, "closed-stream", "closed_stream_rejects_later_frames")))
			false => Ok(OutboundPushPromiseRejected(stream_id, promised_stream_id, payload_length, InvalidFrameKind(0, 5, stream_id, 1, "idle-stream", "idle_streams_require_headers")))
		end
		OutboundReceiveCredit(connection_window, OutboundReceiveCreditResetStream(reset_stream_id, _)) => match stream_id == reset_stream_id
			true => Ok(OutboundPushPromiseRejected(stream_id, promised_stream_id, payload_length, InvalidFrameKind(0, 5, stream_id, 1, "reset-stream", "reset_stream_rejects_later_frames")))
			false => Ok(OutboundPushPromiseRejected(stream_id, promised_stream_id, payload_length, InvalidFrameKind(0, 5, stream_id, 1, "idle-stream", "idle_streams_require_headers")))
		end
	end
end

fn validate_promised_stream_id(stream_id: Int, promised_stream_id: Int, payload_length: Int, header_block: ByteChunk, max_frame_size: Int, connection_window: Int, stream_window: Int) -> Result<OutboundPushPromiseDecision, String>
	match promised_stream_id
		0 => Ok(OutboundPushPromiseRejected(stream_id, promised_stream_id, payload_length, InvalidStreamId(0, 5, promised_stream_id, "nonzero server-initiated promised stream id", "local", "stream-id-domain", "outbound_push_promise_requires_server_stream")))
		_ => encode_push_promise_intent(stream_id, promised_stream_id, payload_length, header_block, max_frame_size, connection_window, stream_window)
	end
end

fn stream_id_is_server_initiated(stream_id: Int) -> Bool
	(stream_id / 2) * 2 == stream_id
end

fn encode_push_promise_intent(stream_id: Int, promised_stream_id: Int, payload_length: Int, header_block: ByteChunk, max_frame_size: Int, connection_window: Int, stream_window: Int) -> Result<OutboundPushPromiseDecision, String>
	match max_frame_size < 4
		true => Ok(OutboundPushPromiseRejected(stream_id, promised_stream_id, payload_length, FrameSizeExceeded(0, 4, ReceiveLimit(max_frame_size, LocalConfiguration), 5, stream_id)))
		false => encode_representable_push_promise_intent(stream_id, promised_stream_id, payload_length, header_block, max_frame_size, connection_window, stream_window)
	end
end

fn encode_representable_push_promise_intent(stream_id: Int, promised_stream_id: Int, payload_length: Int, header_block: ByteChunk, max_frame_size: Int, connection_window: Int, stream_window: Int) -> Result<OutboundPushPromiseDecision, String>
	let encoded_payload: Result<ByteChunk, EncodeError> = encode_push_promise_payload({promised_stream_id: promised_stream_id})
	match encoded_payload
		Ok(promised_payload) => match stream_id_is_server_initiated(promised_stream_id)
			true => match payload_length > max_frame_size
				true => encode_split_push_promise_intent(stream_id, promised_stream_id, payload_length, promised_payload, header_block, max_frame_size, connection_window, stream_window)
				false => encode_single_push_promise_intent(stream_id, promised_stream_id, payload_length, promised_payload, header_block, connection_window, stream_window)
			end
			false => Ok(OutboundPushPromiseRejected(stream_id, promised_stream_id, payload_length, InvalidStreamId(0, 5, promised_stream_id, "nonzero server-initiated promised stream id", "local", "stream-id-domain", "outbound_push_promise_requires_server_stream")))
		end
		Err(error) => Ok(OutboundPushPromiseEncodeFailed(stream_id, promised_stream_id, payload_length, error))
	end
end

fn encode_single_push_promise_intent(stream_id: Int, promised_stream_id: Int, payload_length: Int, promised_payload: ByteChunk, header_block: ByteChunk, connection_window: Int, stream_window: Int) -> Result<OutboundPushPromiseDecision, String>
	let encoded_header: Result<ByteChunk, EncodeError> = encode_frame_header({length: payload_length, kind: 5, flags: 4, stream_id: stream_id})
	match encoded_header
		Ok(header) => Ok(OutboundPushPromiseAccepted(stream_id, promised_stream_id, payload_length, OutboundReceiveCredit(connection_window, OutboundReceiveCreditOpenStream(stream_id, stream_window)), byte_append(byte_append(header, promised_payload), header_block)))
		Err(error) => Ok(OutboundPushPromiseEncodeFailed(stream_id, promised_stream_id, payload_length, error))
	end
end

fn encode_split_push_promise_intent(stream_id: Int, promised_stream_id: Int, payload_length: Int, promised_payload: ByteChunk, header_block: ByteChunk, max_frame_size: Int, connection_window: Int, stream_window: Int) -> Result<OutboundPushPromiseDecision, String>
	let first_header_block_count: ByteCount = byte_count(max_frame_size - 4)?
	let first_header_block: ByteChunk = byte_take(header_block, first_header_block_count)?
	let remaining: ByteChunk = byte_drop(header_block, first_header_block_count)?
	let encoded_header: Result<ByteChunk, EncodeError> = encode_frame_header({length: max_frame_size, kind: 5, flags: 0, stream_id: stream_id})
	match encoded_header
		Ok(header) => encode_continuation_push_promise_intent(stream_id, promised_stream_id, payload_length, max_frame_size, connection_window, stream_window, remaining, byte_append(byte_append(header, promised_payload), first_header_block))
		Err(error) => Ok(OutboundPushPromiseEncodeFailed(stream_id, promised_stream_id, payload_length, error))
	end
end

fn encode_continuation_push_promise_intent(stream_id: Int, promised_stream_id: Int, payload_length: Int, max_frame_size: Int, connection_window: Int, stream_window: Int, remaining: ByteChunk, encoded: ByteChunk) -> Result<OutboundPushPromiseDecision, String>
	let remaining_length: Int = byte_count_to_int(byte_chunk_count(remaining))
	match remaining_length > max_frame_size
		true => encode_nonfinal_push_promise_continuation(stream_id, promised_stream_id, payload_length, max_frame_size, connection_window, stream_window, remaining, encoded)
		false => encode_final_push_promise_continuation(stream_id, promised_stream_id, payload_length, remaining_length, connection_window, stream_window, remaining, encoded)
	end
end

fn encode_nonfinal_push_promise_continuation(stream_id: Int, promised_stream_id: Int, payload_length: Int, max_frame_size: Int, connection_window: Int, stream_window: Int, remaining: ByteChunk, encoded: ByteChunk) -> Result<OutboundPushPromiseDecision, String>
	let chunk_count: ByteCount = byte_count(max_frame_size)?
	let payload: ByteChunk = byte_take(remaining, chunk_count)?
	let next_remaining: ByteChunk = byte_drop(remaining, chunk_count)?
	let encoded_header: Result<ByteChunk, EncodeError> = encode_frame_header({length: max_frame_size, kind: 9, flags: 0, stream_id: stream_id})
	match encoded_header
		Ok(header) => encode_continuation_push_promise_intent(stream_id, promised_stream_id, payload_length, max_frame_size, connection_window, stream_window, next_remaining, byte_append(byte_append(encoded, header), payload))
		Err(error) => Ok(OutboundPushPromiseEncodeFailed(stream_id, promised_stream_id, payload_length, error))
	end
end

fn encode_final_push_promise_continuation(stream_id: Int, promised_stream_id: Int, payload_length: Int, final_length: Int, connection_window: Int, stream_window: Int, remaining: ByteChunk, encoded: ByteChunk) -> Result<OutboundPushPromiseDecision, String>
	let encoded_header: Result<ByteChunk, EncodeError> = encode_frame_header({length: final_length, kind: 9, flags: 4, stream_id: stream_id})
	match encoded_header
		Ok(header) => Ok(OutboundPushPromiseAccepted(stream_id, promised_stream_id, payload_length, OutboundReceiveCredit(connection_window, OutboundReceiveCreditOpenStream(stream_id, stream_window)), byte_append(byte_append(encoded, header), remaining)))
		Err(error) => Ok(OutboundPushPromiseEncodeFailed(stream_id, promised_stream_id, payload_length, error))
	end
end

fn consume_outbound_data_window(stream_id: Int, payload: ByteChunk, length: Int, end_stream: Bool, max_frame_size: Int, shutdown_state: ConnectionShutdownState, send_credit: OutboundSendCredit) -> Result<OutboundDataDecision, String>
	match send_credit
		OutboundSendCredit(connection_window, NoOutboundReceiveCreditStream) => Ok(OutboundDataRejected(stream_id, length, end_stream, FlowControlWindowExceeded(0, 0, stream_id, length, 0, "open-stream", "outbound_stream_window", empty_header_block())))
		OutboundSendCredit(connection_window, OutboundReceiveCreditOpenStream(open_stream_id, stream_window)) => validate_open_stream_outbound_data_window(stream_id, open_stream_id, payload, length, end_stream, max_frame_size, shutdown_state, connection_window, stream_window)
		OutboundSendCredit(connection_window, OutboundReceiveCreditOpenStreamContentLength(open_stream_id, stream_window, expected_length, observed_length)) => validate_open_stream_outbound_data_window_with_content_length(stream_id, open_stream_id, payload, length, length, end_stream, max_frame_size, shutdown_state, connection_window, stream_window, expected_length, observed_length)
		OutboundSendCredit(connection_window, OutboundReceiveCreditClosedStream(closed_stream_id)) => match stream_id == closed_stream_id
			true => Ok(OutboundDataRejected(stream_id, length, end_stream, InvalidFrameKind(0, 0, stream_id, 1, "closed-stream", "closed_stream_rejects_later_frames")))
			false => Ok(OutboundDataRejected(stream_id, length, end_stream, FlowControlWindowExceeded(0, 0, stream_id, length, 0, "open-stream", "outbound_stream_window", empty_header_block())))
		end
		OutboundSendCredit(connection_window, OutboundReceiveCreditResetStream(reset_stream_id, _)) => match stream_id == reset_stream_id
			true => Ok(OutboundDataRejected(stream_id, length, end_stream, InvalidFrameKind(0, 0, stream_id, 1, "reset-stream", "reset_stream_rejects_later_frames")))
			false => Ok(OutboundDataRejected(stream_id, length, end_stream, FlowControlWindowExceeded(0, 0, stream_id, length, 0, "open-stream", "outbound_stream_window", empty_header_block())))
		end
	end
end

fn validate_open_stream_outbound_data_window(stream_id: Int, open_stream_id: Int, payload: ByteChunk, length: Int, end_stream: Bool, max_frame_size: Int, shutdown_state: ConnectionShutdownState, connection_window: Int, stream_window: Int) -> Result<OutboundDataDecision, String>
	match shutdown_state
		OpenConnection => validate_open_connection_outbound_data_window(stream_id, open_stream_id, payload, length, end_stream, max_frame_size, connection_window, stream_window)
		GracefulShutdown(_, _) => match stream_id == open_stream_id
			false => Ok(OutboundDataRejected(stream_id, length, end_stream, FlowControlWindowExceeded(0, 0, stream_id, length, 0, "open-stream", "outbound_stream_window", empty_header_block())))
			true => validate_outbound_data_after_goaway(stream_id, payload, length, end_stream, max_frame_size, shutdown_state, connection_window, stream_window)
		end
	end
end

fn validate_open_stream_outbound_data_window_with_content_length(stream_id: Int, open_stream_id: Int, payload: ByteChunk, encoded_length: Int, application_length: Int, end_stream: Bool, max_frame_size: Int, shutdown_state: ConnectionShutdownState, connection_window: Int, stream_window: Int, expected_length: Int, observed_length: Int) -> Result<OutboundDataDecision, String>
	match shutdown_state
		OpenConnection => validate_open_connection_outbound_data_window_with_content_length(stream_id, open_stream_id, payload, encoded_length, application_length, end_stream, max_frame_size, connection_window, stream_window, expected_length, observed_length)
		GracefulShutdown(_, _) => match stream_id == open_stream_id
			false => Ok(OutboundDataRejected(stream_id, encoded_length, end_stream, FlowControlWindowExceeded(0, 0, stream_id, encoded_length, 0, "open-stream", "outbound_stream_window", empty_header_block())))
			true => validate_outbound_data_after_goaway_with_content_length(stream_id, payload, encoded_length, application_length, end_stream, max_frame_size, shutdown_state, connection_window, stream_window, expected_length, observed_length)
		end
	end
end

fn validate_open_connection_outbound_data_window(stream_id: Int, open_stream_id: Int, payload: ByteChunk, length: Int, end_stream: Bool, max_frame_size: Int, connection_window: Int, stream_window: Int) -> Result<OutboundDataDecision, String>
	match length > connection_window
		true => Ok(OutboundDataRejected(stream_id, length, end_stream, FlowControlWindowExceeded(0, 0, stream_id, length, connection_window, "connection-flow-control", "outbound_connection_window", empty_header_block())))
		false => match stream_id == open_stream_id
			false => Ok(OutboundDataRejected(stream_id, length, end_stream, FlowControlWindowExceeded(0, 0, stream_id, length, 0, "open-stream", "outbound_stream_window", empty_header_block())))
			true => match length > stream_window
				true => Ok(OutboundDataRejected(stream_id, length, end_stream, FlowControlWindowExceeded(0, 0, stream_id, length, stream_window, "open-stream", "outbound_stream_window", empty_header_block())))
				false => encode_data_intent(stream_id, payload, length, end_stream, max_frame_size, connection_window, stream_window)
			end
		end
	end
end

fn validate_open_connection_outbound_data_window_with_content_length(stream_id: Int, open_stream_id: Int, payload: ByteChunk, encoded_length: Int, application_length: Int, end_stream: Bool, max_frame_size: Int, connection_window: Int, stream_window: Int, expected_length: Int, observed_length: Int) -> Result<OutboundDataDecision, String>
	match encoded_length > connection_window
		true => Ok(OutboundDataRejected(stream_id, encoded_length, end_stream, FlowControlWindowExceeded(0, 0, stream_id, encoded_length, connection_window, "connection-flow-control", "outbound_connection_window", empty_header_block())))
		false => match stream_id == open_stream_id
			false => Ok(OutboundDataRejected(stream_id, encoded_length, end_stream, FlowControlWindowExceeded(0, 0, stream_id, encoded_length, 0, "open-stream", "outbound_stream_window", empty_header_block())))
			true => match encoded_length > stream_window
				true => Ok(OutboundDataRejected(stream_id, encoded_length, end_stream, FlowControlWindowExceeded(0, 0, stream_id, encoded_length, stream_window, "open-stream", "outbound_stream_window", empty_header_block())))
				false => validate_data_frame_size_with_content_length(stream_id, payload, encoded_length, application_length, end_stream, max_frame_size, connection_window, stream_window, expected_length, observed_length)
			end
		end
	end
end

fn validate_outbound_data_after_goaway(stream_id: Int, payload: ByteChunk, length: Int, end_stream: Bool, max_frame_size: Int, shutdown_state: ConnectionShutdownState, connection_window: Int, stream_window: Int) -> Result<OutboundDataDecision, String>
	match shutdown_state
		OpenConnection => validate_outbound_data_windows(stream_id, payload, length, end_stream, max_frame_size, connection_window, stream_window)
		GracefulShutdown(last_stream_id, _) => match stream_id > last_stream_id
			true => Ok(OutboundDataRejected(stream_id, length, end_stream, StreamAfterGoaway(0, stream_id, last_stream_id, "graceful_shutdown", "local", "goaway_last_stream_id", empty_header_block())))
			false => validate_outbound_data_windows(stream_id, payload, length, end_stream, max_frame_size, connection_window, stream_window)
		end
	end
end

fn validate_outbound_data_after_goaway_with_content_length(stream_id: Int, payload: ByteChunk, encoded_length: Int, application_length: Int, end_stream: Bool, max_frame_size: Int, shutdown_state: ConnectionShutdownState, connection_window: Int, stream_window: Int, expected_length: Int, observed_length: Int) -> Result<OutboundDataDecision, String>
	match shutdown_state
		OpenConnection => validate_outbound_data_windows_with_content_length(stream_id, payload, encoded_length, application_length, end_stream, max_frame_size, connection_window, stream_window, expected_length, observed_length)
		GracefulShutdown(last_stream_id, _) => match stream_id > last_stream_id
			true => Ok(OutboundDataRejected(stream_id, encoded_length, end_stream, StreamAfterGoaway(0, stream_id, last_stream_id, "graceful_shutdown", "local", "goaway_last_stream_id", empty_header_block())))
			false => validate_outbound_data_windows_with_content_length(stream_id, payload, encoded_length, application_length, end_stream, max_frame_size, connection_window, stream_window, expected_length, observed_length)
		end
	end
end

fn validate_outbound_data_windows(stream_id: Int, payload: ByteChunk, length: Int, end_stream: Bool, max_frame_size: Int, connection_window: Int, stream_window: Int) -> Result<OutboundDataDecision, String>
	match length > connection_window
		true => Ok(OutboundDataRejected(stream_id, length, end_stream, FlowControlWindowExceeded(0, 0, stream_id, length, connection_window, "connection-flow-control", "outbound_connection_window", empty_header_block())))
		false => match length > stream_window
			true => Ok(OutboundDataRejected(stream_id, length, end_stream, FlowControlWindowExceeded(0, 0, stream_id, length, stream_window, "open-stream", "outbound_stream_window", empty_header_block())))
			false => validate_data_frame_size(stream_id, payload, length, end_stream, max_frame_size, connection_window, stream_window)
		end
	end
end

fn validate_outbound_data_windows_with_content_length(stream_id: Int, payload: ByteChunk, encoded_length: Int, application_length: Int, end_stream: Bool, max_frame_size: Int, connection_window: Int, stream_window: Int, expected_length: Int, observed_length: Int) -> Result<OutboundDataDecision, String>
	match encoded_length > connection_window
		true => Ok(OutboundDataRejected(stream_id, encoded_length, end_stream, FlowControlWindowExceeded(0, 0, stream_id, encoded_length, connection_window, "connection-flow-control", "outbound_connection_window", empty_header_block())))
		false => match encoded_length > stream_window
			true => Ok(OutboundDataRejected(stream_id, encoded_length, end_stream, FlowControlWindowExceeded(0, 0, stream_id, encoded_length, stream_window, "open-stream", "outbound_stream_window", empty_header_block())))
			false => validate_data_frame_size_with_content_length(stream_id, payload, encoded_length, application_length, end_stream, max_frame_size, connection_window, stream_window, expected_length, observed_length)
		end
	end
end

fn validate_data_frame_size(stream_id: Int, payload: ByteChunk, length: Int, end_stream: Bool, max_frame_size: Int, connection_window: Int, stream_window: Int) -> Result<OutboundDataDecision, String>
	match max_frame_size < 1
		true => Ok(OutboundDataRejected(stream_id, length, end_stream, FrameSizeExceeded(0, length, ReceiveLimit(max_frame_size, LocalConfiguration), 0, stream_id)))
		false => encode_data_intent(stream_id, payload, length, end_stream, max_frame_size, connection_window, stream_window)
	end
end

fn validate_data_frame_size_with_content_length(stream_id: Int, payload: ByteChunk, encoded_length: Int, application_length: Int, end_stream: Bool, max_frame_size: Int, connection_window: Int, stream_window: Int, expected_length: Int, observed_length: Int) -> Result<OutboundDataDecision, String>
	match max_frame_size < 1
		true => Ok(OutboundDataRejected(stream_id, encoded_length, end_stream, FrameSizeExceeded(0, encoded_length, ReceiveLimit(max_frame_size, LocalConfiguration), 0, stream_id)))
		false => validate_outbound_content_length(stream_id, payload, encoded_length, application_length, end_stream, max_frame_size, connection_window, stream_window, expected_length, observed_length)
	end
end

fn validate_outbound_content_length(stream_id: Int, payload: ByteChunk, encoded_length: Int, application_length: Int, end_stream: Bool, max_frame_size: Int, connection_window: Int, stream_window: Int, expected_length: Int, observed_length: Int) -> Result<OutboundDataDecision, String>
	let next_observed_length: Int = observed_length + application_length
	match next_observed_length > expected_length
		true => Ok(OutboundDataRejected(stream_id, encoded_length, end_stream, ContentLengthMismatch(0, 0, stream_id, expected_length, next_observed_length, "open-stream", "rfc9113_content_length_body", byte_chunk_view(payload)?)))
		false => match end_stream and next_observed_length < expected_length
			true => Ok(OutboundDataRejected(stream_id, encoded_length, end_stream, ContentLengthMismatch(0, 0, stream_id, expected_length, next_observed_length, "open-stream", "rfc9113_content_length_body", byte_chunk_view(payload)?)))
			false => encode_data_intent_with_content_length(stream_id, payload, encoded_length, end_stream, max_frame_size, connection_window, stream_window, expected_length, next_observed_length)
		end
	end
end

fn consume_outbound_padded_data_window(stream_id: Int, payload: ByteChunk, encoded_length: Int, padding_length: Int, end_stream: Bool, max_frame_size: Int, send_credit: OutboundSendCredit) -> Result<OutboundDataDecision, String>
	match send_credit
		OutboundSendCredit(connection_window, NoOutboundReceiveCreditStream) => Ok(OutboundDataRejected(stream_id, encoded_length, end_stream, FlowControlWindowExceeded(0, 0, stream_id, encoded_length, 0, "open-stream", "outbound_stream_window", empty_header_block())))
		OutboundSendCredit(connection_window, OutboundReceiveCreditOpenStream(open_stream_id, stream_window)) => match encoded_length > connection_window
			true => Ok(OutboundDataRejected(stream_id, encoded_length, end_stream, FlowControlWindowExceeded(0, 0, stream_id, encoded_length, connection_window, "connection-flow-control", "outbound_connection_window", empty_header_block())))
			false => match stream_id == open_stream_id
				false => Ok(OutboundDataRejected(stream_id, encoded_length, end_stream, FlowControlWindowExceeded(0, 0, stream_id, encoded_length, 0, "open-stream", "outbound_stream_window", empty_header_block())))
				true => match encoded_length > stream_window
					true => Ok(OutboundDataRejected(stream_id, encoded_length, end_stream, FlowControlWindowExceeded(0, 0, stream_id, encoded_length, stream_window, "open-stream", "outbound_stream_window", empty_header_block())))
					false => encode_padded_data_intent(stream_id, payload, encoded_length, padding_length, end_stream, max_frame_size, connection_window, stream_window)
				end
			end
		end
		OutboundSendCredit(connection_window, OutboundReceiveCreditOpenStreamContentLength(open_stream_id, stream_window, expected_length, observed_length)) => match encoded_length > connection_window
			true => Ok(OutboundDataRejected(stream_id, encoded_length, end_stream, FlowControlWindowExceeded(0, 0, stream_id, encoded_length, connection_window, "connection-flow-control", "outbound_connection_window", empty_header_block())))
			false => match stream_id == open_stream_id
				false => Ok(OutboundDataRejected(stream_id, encoded_length, end_stream, FlowControlWindowExceeded(0, 0, stream_id, encoded_length, 0, "open-stream", "outbound_stream_window", empty_header_block())))
				true => match encoded_length > stream_window
					true => Ok(OutboundDataRejected(stream_id, encoded_length, end_stream, FlowControlWindowExceeded(0, 0, stream_id, encoded_length, stream_window, "open-stream", "outbound_stream_window", empty_header_block())))
					false => validate_outbound_padded_content_length(stream_id, payload, encoded_length, padding_length, end_stream, max_frame_size, connection_window, stream_window, expected_length, observed_length)
				end
			end
		end
		OutboundSendCredit(connection_window, OutboundReceiveCreditClosedStream(closed_stream_id)) => match stream_id == closed_stream_id
			true => Ok(OutboundDataRejected(stream_id, encoded_length, end_stream, InvalidFrameKind(0, 0, stream_id, 1, "closed-stream", "closed_stream_rejects_later_frames")))
			false => Ok(OutboundDataRejected(stream_id, encoded_length, end_stream, FlowControlWindowExceeded(0, 0, stream_id, encoded_length, 0, "open-stream", "outbound_stream_window", empty_header_block())))
		end
		OutboundSendCredit(connection_window, OutboundReceiveCreditResetStream(reset_stream_id, _)) => match stream_id == reset_stream_id
			true => Ok(OutboundDataRejected(stream_id, encoded_length, end_stream, InvalidFrameKind(0, 0, stream_id, 1, "reset-stream", "reset_stream_rejects_later_frames")))
			false => Ok(OutboundDataRejected(stream_id, encoded_length, end_stream, FlowControlWindowExceeded(0, 0, stream_id, encoded_length, 0, "open-stream", "outbound_stream_window", empty_header_block())))
		end
	end
end

fn validate_outbound_padded_content_length(stream_id: Int, payload: ByteChunk, encoded_length: Int, padding_length: Int, end_stream: Bool, max_frame_size: Int, connection_window: Int, stream_window: Int, expected_length: Int, observed_length: Int) -> Result<OutboundDataDecision, String>
	let application_length: Int = byte_count_to_int(byte_chunk_count(payload))
	let next_observed_length: Int = observed_length + application_length
	match next_observed_length > expected_length
		true => Ok(OutboundDataRejected(stream_id, encoded_length, end_stream, ContentLengthMismatch(0, 0, stream_id, expected_length, next_observed_length, "open-stream", "rfc9113_content_length_body", byte_chunk_view(payload)?)))
		false => match end_stream and next_observed_length < expected_length
			true => Ok(OutboundDataRejected(stream_id, encoded_length, end_stream, ContentLengthMismatch(0, 0, stream_id, expected_length, next_observed_length, "open-stream", "rfc9113_content_length_body", byte_chunk_view(payload)?)))
			false => encode_padded_data_intent_with_content_length(stream_id, payload, encoded_length, padding_length, end_stream, max_frame_size, connection_window, stream_window, expected_length, next_observed_length)
		end
	end
end

fn encode_data_intent(stream_id: Int, payload: ByteChunk, length: Int, end_stream: Bool, max_frame_size: Int, connection_window: Int, stream_window: Int) -> Result<OutboundDataDecision, String>
	match length > max_frame_size
		true => encode_split_data_intent(stream_id, payload, length, end_stream, max_frame_size, connection_window, stream_window)
		false => encode_single_data_intent(stream_id, payload, length, end_stream, connection_window, stream_window)
	end
end

fn encode_data_intent_with_content_length(stream_id: Int, payload: ByteChunk, length: Int, end_stream: Bool, max_frame_size: Int, connection_window: Int, stream_window: Int, expected_length: Int, observed_length: Int) -> Result<OutboundDataDecision, String>
	match encode_data_intent(stream_id, payload, length, end_stream, max_frame_size, connection_window, stream_window)
		Ok(OutboundDataAccepted(_, _, _, _, chunk)) => Ok(OutboundDataAccepted(stream_id, length, end_stream, data_sent_send_credit_with_content_length(stream_id, end_stream, connection_window - length, stream_window - length, expected_length, observed_length), chunk))
		Ok(OutboundDataRejected(_, _, _, error)) => Ok(OutboundDataRejected(stream_id, length, end_stream, error))
		Ok(OutboundDataEncodeFailed(_, _, _, error)) => Ok(OutboundDataEncodeFailed(stream_id, length, end_stream, error))
		Err(error) => Err(error)
	end
end

fn encode_single_data_intent(stream_id: Int, payload: ByteChunk, length: Int, end_stream: Bool, connection_window: Int, stream_window: Int) -> Result<OutboundDataDecision, String>
	let encoded_header: Result<ByteChunk, EncodeError> = encode_frame_header({length: length, kind: 0, flags: data_flags(end_stream), stream_id: stream_id})
	match encoded_header
		Ok(header) => Ok(OutboundDataAccepted(stream_id, length, end_stream, data_sent_send_credit(stream_id, end_stream, connection_window - length, stream_window - length), byte_append(header, payload)))
		Err(error) => Ok(OutboundDataEncodeFailed(stream_id, length, end_stream, error))
	end
end

fn encode_split_data_intent(stream_id: Int, payload: ByteChunk, length: Int, end_stream: Bool, max_frame_size: Int, connection_window: Int, stream_window: Int) -> Result<OutboundDataDecision, String>
	let chunk_count: ByteCount = byte_count(max_frame_size)?
	let first_payload: ByteChunk = byte_take(payload, chunk_count)?
	let remaining: ByteChunk = byte_drop(payload, chunk_count)?
	let encoded_header: Result<ByteChunk, EncodeError> = encode_frame_header({length: max_frame_size, kind: 0, flags: 0, stream_id: stream_id})
	match encoded_header
		Ok(header) => encode_remaining_data_frames(stream_id, length, end_stream, max_frame_size, connection_window, stream_window, remaining, byte_append(header, first_payload))
		Err(error) => Ok(OutboundDataEncodeFailed(stream_id, length, end_stream, error))
	end
end

fn encode_remaining_data_frames(stream_id: Int, length: Int, end_stream: Bool, max_frame_size: Int, connection_window: Int, stream_window: Int, remaining: ByteChunk, encoded: ByteChunk) -> Result<OutboundDataDecision, String>
	let remaining_length: Int = byte_count_to_int(byte_chunk_count(remaining))
	match remaining_length > max_frame_size
		true => encode_nonfinal_data_frame(stream_id, length, end_stream, max_frame_size, connection_window, stream_window, remaining, encoded)
		false => encode_final_data_frame(stream_id, length, end_stream, remaining_length, connection_window, stream_window, remaining, encoded)
	end
end

fn encode_nonfinal_data_frame(stream_id: Int, length: Int, end_stream: Bool, max_frame_size: Int, connection_window: Int, stream_window: Int, remaining: ByteChunk, encoded: ByteChunk) -> Result<OutboundDataDecision, String>
	let chunk_count: ByteCount = byte_count(max_frame_size)?
	let payload: ByteChunk = byte_take(remaining, chunk_count)?
	let next_remaining: ByteChunk = byte_drop(remaining, chunk_count)?
	let encoded_header: Result<ByteChunk, EncodeError> = encode_frame_header({length: max_frame_size, kind: 0, flags: 0, stream_id: stream_id})
	match encoded_header
		Ok(header) => encode_remaining_data_frames(stream_id, length, end_stream, max_frame_size, connection_window, stream_window, next_remaining, byte_append(byte_append(encoded, header), payload))
		Err(error) => Ok(OutboundDataEncodeFailed(stream_id, length, end_stream, error))
	end
end

fn encode_final_data_frame(stream_id: Int, length: Int, end_stream: Bool, final_length: Int, connection_window: Int, stream_window: Int, remaining: ByteChunk, encoded: ByteChunk) -> Result<OutboundDataDecision, String>
	let encoded_header: Result<ByteChunk, EncodeError> = encode_frame_header({length: final_length, kind: 0, flags: data_flags(end_stream), stream_id: stream_id})
	match encoded_header
		Ok(header) => Ok(OutboundDataAccepted(stream_id, length, end_stream, data_sent_send_credit(stream_id, end_stream, connection_window - length, stream_window - length), byte_append(byte_append(encoded, header), remaining)))
		Err(error) => Ok(OutboundDataEncodeFailed(stream_id, length, end_stream, error))
	end
end

fn encode_padded_data_intent(stream_id: Int, payload: ByteChunk, encoded_length: Int, padding_length: Int, end_stream: Bool, max_frame_size: Int, connection_window: Int, stream_window: Int) -> Result<OutboundDataDecision, String>
	let application_length: Int = byte_count_to_int(byte_chunk_count(payload))
	let max_application_frame_payload: Int = max_padded_application_frame_payload(max_frame_size, padding_length)
	match application_length > max_application_frame_payload
		true => encode_split_padded_data_intent(stream_id, payload, encoded_length, padding_length, end_stream, max_frame_size, max_application_frame_payload, connection_window, stream_window)
		false => encode_single_padded_data_intent(stream_id, payload, encoded_length, padding_length, end_stream, application_length + padding_length + 1, connection_window, stream_window)
	end
end

fn encode_padded_data_intent_with_content_length(stream_id: Int, payload: ByteChunk, encoded_length: Int, padding_length: Int, end_stream: Bool, max_frame_size: Int, connection_window: Int, stream_window: Int, expected_length: Int, observed_length: Int) -> Result<OutboundDataDecision, String>
	match encode_padded_data_intent(stream_id, payload, encoded_length, padding_length, end_stream, max_frame_size, connection_window, stream_window)
		Ok(OutboundDataAccepted(_, _, _, _, chunk)) => Ok(OutboundDataAccepted(stream_id, encoded_length, end_stream, data_sent_send_credit_with_content_length(stream_id, end_stream, connection_window - encoded_length, stream_window - encoded_length, expected_length, observed_length), chunk))
		Ok(OutboundDataRejected(_, _, _, error)) => Ok(OutboundDataRejected(stream_id, encoded_length, end_stream, error))
		Ok(OutboundDataEncodeFailed(_, _, _, error)) => Ok(OutboundDataEncodeFailed(stream_id, encoded_length, end_stream, error))
		Err(error) => Err(error)
	end
end

fn encode_single_padded_data_intent(stream_id: Int, payload: ByteChunk, encoded_length: Int, padding_length: Int, end_stream: Bool, frame_payload_length: Int, connection_window: Int, stream_window: Int) -> Result<OutboundDataDecision, String>
	let encoded_header: Result<ByteChunk, EncodeError> = encode_frame_header({length: frame_payload_length, kind: 0, flags: padded_data_flags(end_stream), stream_id: stream_id})
	match encoded_header
		Ok(header) => encode_single_padded_data_payload(stream_id, payload, encoded_length, padding_length, end_stream, connection_window, stream_window, header)
		Err(error) => Ok(OutboundDataEncodeFailed(stream_id, encoded_length, end_stream, error))
	end
end

fn encode_single_padded_data_payload(stream_id: Int, payload: ByteChunk, encoded_length: Int, padding_length: Int, end_stream: Bool, connection_window: Int, stream_window: Int, header: ByteChunk) -> Result<OutboundDataDecision, String>
	Ok(OutboundDataAccepted(stream_id, encoded_length, end_stream, data_sent_send_credit(stream_id, end_stream, connection_window - encoded_length, stream_window - encoded_length), byte_append(header, padded_data_payload(padding_length, payload)?)))
end

fn encode_split_padded_data_intent(stream_id: Int, payload: ByteChunk, encoded_length: Int, padding_length: Int, end_stream: Bool, max_frame_size: Int, max_application_frame_payload: Int, connection_window: Int, stream_window: Int) -> Result<OutboundDataDecision, String>
	let chunk_count: ByteCount = byte_count(max_application_frame_payload)?
	let first_payload: ByteChunk = byte_take(payload, chunk_count)?
	let remaining: ByteChunk = byte_drop(payload, chunk_count)?
	let encoded_header: Result<ByteChunk, EncodeError> = encode_frame_header({length: max_frame_size, kind: 0, flags: 8, stream_id: stream_id})
	match encoded_header
		Ok(header) => encode_remaining_padded_data_frames(stream_id, encoded_length, padding_length, end_stream, max_frame_size, max_application_frame_payload, connection_window, stream_window, remaining, byte_append(header, padded_data_payload(padding_length, first_payload)?))
		Err(error) => Ok(OutboundDataEncodeFailed(stream_id, encoded_length, end_stream, error))
	end
end

fn encode_remaining_padded_data_frames(stream_id: Int, encoded_length: Int, padding_length: Int, end_stream: Bool, max_frame_size: Int, max_application_frame_payload: Int, connection_window: Int, stream_window: Int, remaining: ByteChunk, encoded: ByteChunk) -> Result<OutboundDataDecision, String>
	let remaining_length: Int = byte_count_to_int(byte_chunk_count(remaining))
	match remaining_length > max_application_frame_payload
		true => encode_nonfinal_padded_data_frame(stream_id, encoded_length, padding_length, end_stream, max_frame_size, max_application_frame_payload, connection_window, stream_window, remaining, encoded)
		false => encode_final_padded_data_frame(stream_id, encoded_length, padding_length, end_stream, remaining_length, connection_window, stream_window, remaining, encoded)
	end
end

fn encode_nonfinal_padded_data_frame(stream_id: Int, encoded_length: Int, padding_length: Int, end_stream: Bool, max_frame_size: Int, max_application_frame_payload: Int, connection_window: Int, stream_window: Int, remaining: ByteChunk, encoded: ByteChunk) -> Result<OutboundDataDecision, String>
	let chunk_count: ByteCount = byte_count(max_application_frame_payload)?
	let payload: ByteChunk = byte_take(remaining, chunk_count)?
	let next_remaining: ByteChunk = byte_drop(remaining, chunk_count)?
	let encoded_header: Result<ByteChunk, EncodeError> = encode_frame_header({length: max_frame_size, kind: 0, flags: 8, stream_id: stream_id})
	match encoded_header
		Ok(header) => encode_remaining_padded_data_frames(stream_id, encoded_length, padding_length, end_stream, max_frame_size, max_application_frame_payload, connection_window, stream_window, next_remaining, byte_append(byte_append(encoded, header), padded_data_payload(padding_length, payload)?))
		Err(error) => Ok(OutboundDataEncodeFailed(stream_id, encoded_length, end_stream, error))
	end
end

fn encode_final_padded_data_frame(stream_id: Int, encoded_length: Int, padding_length: Int, end_stream: Bool, final_application_length: Int, connection_window: Int, stream_window: Int, remaining: ByteChunk, encoded: ByteChunk) -> Result<OutboundDataDecision, String>
	let encoded_header: Result<ByteChunk, EncodeError> = encode_frame_header({length: final_application_length + padding_length + 1, kind: 0, flags: padded_data_flags(end_stream), stream_id: stream_id})
	match encoded_header
		Ok(header) => Ok(OutboundDataAccepted(stream_id, encoded_length, end_stream, data_sent_send_credit(stream_id, end_stream, connection_window - encoded_length, stream_window - encoded_length), byte_append(byte_append(encoded, header), padded_data_payload(padding_length, remaining)?)))
		Err(error) => Ok(OutboundDataEncodeFailed(stream_id, encoded_length, end_stream, error))
	end
end

fn padded_data_payload(padding_length: Int, application_payload: ByteChunk) -> Result<ByteChunk, String>
	Ok(byte_append(byte_write_u8_be(padding_length)?, byte_append(application_payload, zero_padding_bytes(padding_length)?)))
end

fn zero_padding_bytes(length: Int) -> Result<ByteChunk, String>
	match length
		0 => Ok(byte_chunk([]))
		_ => Ok(byte_append(byte_write_u8_be(0)?, zero_padding_bytes(length - 1)?))
	end
end

fn data_flags(end_stream: Bool) -> Int
	match end_stream
		true => 1
		false => 0
	end
end

fn padded_data_flags(end_stream: Bool) -> Int
	data_flags(end_stream) + 8
end

fn data_sent_send_credit(stream_id: Int, end_stream: Bool, connection_window: Int, stream_window: Int) -> OutboundSendCredit
	match end_stream
		true => OutboundSendCredit(connection_window, OutboundReceiveCreditClosedStream(stream_id))
		false => OutboundSendCredit(connection_window, OutboundReceiveCreditOpenStream(stream_id, stream_window))
	end
end

fn data_sent_send_credit_with_content_length(stream_id: Int, end_stream: Bool, connection_window: Int, stream_window: Int, expected_length: Int, observed_length: Int) -> OutboundSendCredit
	match end_stream
		true => OutboundSendCredit(connection_window, OutboundReceiveCreditClosedStream(stream_id))
		false => OutboundSendCredit(connection_window, OutboundReceiveCreditOpenStreamContentLength(stream_id, stream_window, expected_length, observed_length))
	end
end

fn send_connection_window_update(increment: Int, receive_credit: OutboundReceiveCredit) -> Result<OutboundWindowUpdateDecision, String>
	match validate_outbound_window_update_increment(0, increment, "connection-flow-control")
		OutboundWindowUpdateIncrementOk => validate_connection_window_update_bound(increment, receive_credit)
		OutboundWindowUpdateIncrementFailed(error) => Ok(OutboundWindowUpdateRejected(error))
	end
end

fn send_stream_window_update(stream_id: Int, increment: Int, receive_credit: OutboundReceiveCredit) -> Result<OutboundWindowUpdateDecision, String>
	match stream_id
		0 => Ok(OutboundWindowUpdateRejected(InvalidStreamId(0, 8, stream_id, "nonzero open stream id", "local", "stream-id-domain", "outbound_window_update_requires_open_stream")))
		_ => match validate_outbound_window_update_increment(stream_id, increment, "open-stream")
			OutboundWindowUpdateIncrementOk => send_valid_stream_window_update(stream_id, increment, receive_credit)
			OutboundWindowUpdateIncrementFailed(error) => Ok(OutboundWindowUpdateRejected(error))
		end
	end
end

fn validate_connection_window_update_bound(increment: Int, receive_credit: OutboundReceiveCredit) -> Result<OutboundWindowUpdateDecision, String>
	match receive_credit
		OutboundReceiveCredit(connection_window, stream_credit) => match connection_window + increment > max_receive_flow_control_window()
			true => Ok(OutboundWindowUpdateRejected(FlowControlWindowExceeded(0, 8, 0, increment, max_receive_flow_control_window() - connection_window, "connection-flow-control", "outbound_connection_receive_window", empty_header_block())))
			false => encode_window_update_intent(0, increment, OutboundReceiveCredit(connection_window + increment, stream_credit))
		end
	end
end

fn send_valid_stream_window_update(stream_id: Int, increment: Int, receive_credit: OutboundReceiveCredit) -> Result<OutboundWindowUpdateDecision, String>
	match receive_credit
		OutboundReceiveCredit(connection_window, NoOutboundReceiveCreditStream) => Ok(OutboundWindowUpdateRejected(InvalidFrameKind(0, 8, stream_id, 1, "idle-stream", "idle_streams_require_headers")))
		OutboundReceiveCredit(connection_window, OutboundReceiveCreditOpenStream(open_stream_id, stream_window)) => match stream_id == open_stream_id
			true => validate_stream_window_update_bound(stream_id, increment, connection_window, open_stream_id, stream_window)
			false => Ok(OutboundWindowUpdateRejected(InvalidFrameKind(0, 8, stream_id, 1, "idle-stream", "idle_streams_require_headers")))
		end
		OutboundReceiveCredit(connection_window, OutboundReceiveCreditOpenStreamContentLength(open_stream_id, stream_window, _, _)) => match stream_id == open_stream_id
			true => validate_stream_window_update_bound(stream_id, increment, connection_window, open_stream_id, stream_window)
			false => Ok(OutboundWindowUpdateRejected(InvalidFrameKind(0, 8, stream_id, 1, "idle-stream", "idle_streams_require_headers")))
		end
		OutboundReceiveCredit(connection_window, OutboundReceiveCreditClosedStream(closed_stream_id)) => match stream_id == closed_stream_id
			true => Ok(OutboundWindowUpdateRejected(InvalidFrameKind(0, 8, stream_id, 1, "closed-stream", "closed_stream_rejects_later_frames")))
			false => Ok(OutboundWindowUpdateRejected(InvalidFrameKind(0, 8, stream_id, 1, "idle-stream", "idle_streams_require_headers")))
		end
		OutboundReceiveCredit(connection_window, OutboundReceiveCreditResetStream(reset_stream_id, _)) => match stream_id == reset_stream_id
			true => Ok(OutboundWindowUpdateRejected(InvalidFrameKind(0, 8, stream_id, 1, "reset-stream", "reset_stream_rejects_later_frames")))
			false => Ok(OutboundWindowUpdateRejected(InvalidFrameKind(0, 8, stream_id, 1, "idle-stream", "idle_streams_require_headers")))
		end
	end
end

fn validate_stream_window_update_bound(stream_id: Int, increment: Int, connection_window: Int, open_stream_id: Int, stream_window: Int) -> Result<OutboundWindowUpdateDecision, String>
	match stream_window + increment > max_receive_flow_control_window()
		true => Ok(OutboundWindowUpdateRejected(FlowControlWindowExceeded(0, 8, stream_id, increment, max_receive_flow_control_window() - stream_window, "open-stream", "outbound_stream_receive_window", empty_header_block())))
		false => encode_window_update_intent(stream_id, increment, OutboundReceiveCredit(connection_window, OutboundReceiveCreditOpenStream(open_stream_id, stream_window + increment)))
	end
end

fn validate_outbound_window_update_increment(stream_id: Int, increment: Int, active_state: String) -> OutboundWindowUpdateIncrementDecision
	match increment
		0 => OutboundWindowUpdateIncrementFailed(FlowControlWindowExceeded(0, 8, stream_id, increment, 1, active_state, "window_update_increment_nonzero", empty_header_block()))
		_ => match increment < 0
			true => OutboundWindowUpdateIncrementFailed(FlowControlWindowExceeded(0, 8, stream_id, increment, 1, active_state, "window_update_increment_range", empty_header_block()))
			false => match increment > max_receive_flow_control_window()
				true => OutboundWindowUpdateIncrementFailed(FlowControlWindowExceeded(0, 8, stream_id, increment, max_receive_flow_control_window(), active_state, "window_update_increment_range", empty_header_block()))
				false => OutboundWindowUpdateIncrementOk
			end
		end
	end
end

fn encode_window_update_intent(stream_id: Int, increment: Int, receive_credit: OutboundReceiveCredit) -> Result<OutboundWindowUpdateDecision, String>
	let encoded_header: Result<ByteChunk, EncodeError> = encode_frame_header({length: 4, kind: 8, flags: 0, stream_id: stream_id})
	match encoded_header
		Ok(header) => encode_window_update_payload_intent(stream_id, increment, receive_credit, header)
		Err(error) => Ok(OutboundWindowUpdateEncodeFailed(error))
	end
end

fn encode_window_update_payload_intent(stream_id: Int, increment: Int, receive_credit: OutboundReceiveCredit, header: ByteChunk) -> Result<OutboundWindowUpdateDecision, String>
	let encoded_payload: Result<ByteChunk, EncodeError> = encode_window_update_payload({increment: increment})
	match encoded_payload
		Ok(payload) => Ok(OutboundWindowUpdateAccepted(stream_id, increment, receive_credit, byte_append(header, payload)))
		Err(error) => Ok(OutboundWindowUpdateEncodeFailed(error))
	end
end

fn refill_outbound_send_credit_from_received_window_update(step: Http2Step, send_credit: OutboundSendCredit) -> Result<OutboundSendCreditUpdateDecision, String>
	match step
		FrameDecoded(_, offset, length, kind, _, stream_id, _, KnownFrame(_, _, _, payload)) => match kind == 8
			true => match length == 4
				true => refill_outbound_send_credit(offset, stream_id, byte_read_u31_be(payload)?, byte_view_to_chunk(payload), send_credit)
				false => Ok(OutboundSendCreditUnchanged(send_credit))
			end
			false => Ok(OutboundSendCreditUnchanged(send_credit))
		end
		FrameDecoded(_, _, _, _, _, _, _, _) => Ok(OutboundSendCreditUnchanged(send_credit))
		Waiting(_) => Ok(OutboundSendCreditUnchanged(send_credit))
		Failed(_, _) => Ok(OutboundSendCreditUnchanged(send_credit))
	end
end

fn update_outbound_send_credit_from_received_settings(step: Http2Step, peer_settings: PeerSettingsState, send_credit: OutboundSendCredit) -> Result<OutboundSendCreditUpdateDecision, String>
	match step
		FrameDecoded(_, _, length, kind, flags, _, _, KnownFrame(_, _, _, payload)) => match kind == 4
			true => match settings_ack_set(flags)
				true => Ok(OutboundSendCreditUnchanged(send_credit))
				false => match settings_payload_has_complete_items(length)
					true => update_outbound_send_credit_from_settings_items(byte_view_to_chunk(payload), 0, length, peer_settings, OutboundSendCreditUnchanged(send_credit))
					false => Ok(OutboundSendCreditUnchanged(send_credit))
				end
			end
			false => Ok(OutboundSendCreditUnchanged(send_credit))
		end
		FrameDecoded(_, _, _, _, _, _, _, _) => Ok(OutboundSendCreditUnchanged(send_credit))
		Waiting(_) => Ok(OutboundSendCreditUnchanged(send_credit))
		Failed(_, _) => Ok(OutboundSendCreditUnchanged(send_credit))
	end
end

fn update_outbound_send_credit_from_settings_items(payload: ByteChunk, item_offset: Int, payload_end_offset: Int, peer_settings: PeerSettingsState, decision: OutboundSendCreditUpdateDecision) -> Result<OutboundSendCreditUpdateDecision, String>
	match item_offset == payload_end_offset
		true => Ok(decision)
		false => update_outbound_send_credit_from_settings_items(payload, item_offset + 6, payload_end_offset, update_single_settings_payload_item(payload, item_offset, peer_settings)?, update_single_initial_window_send_credit(payload, item_offset, peer_settings, decision)?)
	end
end

fn update_single_settings_payload_item(payload: ByteChunk, item_offset: Int, peer_settings: PeerSettingsState) -> Result<PeerSettingsState, String>
	let item: ByteView = byte_view(payload, byte_offset(item_offset)?, byte_count(6)?)?
	let identifier: Int = byte_read_u16_be(byte_view(byte_view_to_chunk(item), byte_offset(0)?, byte_count(2)?)?)?
	let value: Int = byte_read_u32_be(byte_view(byte_view_to_chunk(item), byte_offset(2)?, byte_count(4)?)?)?
	match peer_settings
		PeerSettings(max_frame_size, initial_window_size, enable_push, max_concurrent_streams, header_table_size, max_header_list_size, local_enable_push) => match identifier
			5 => Ok(PeerSettings(PeerMaxFrameSize(value, item_offset), initial_window_size, enable_push, max_concurrent_streams, header_table_size, max_header_list_size, local_enable_push))
			4 => Ok(PeerSettings(max_frame_size, PeerInitialWindowSize(value, item_offset), enable_push, max_concurrent_streams, header_table_size, max_header_list_size, local_enable_push))
			2 => Ok(PeerSettings(max_frame_size, initial_window_size, PeerEnablePush(value, item_offset), max_concurrent_streams, header_table_size, max_header_list_size, local_enable_push))
			3 => Ok(PeerSettings(max_frame_size, initial_window_size, enable_push, PeerMaxConcurrentStreams(value, item_offset), header_table_size, max_header_list_size, local_enable_push))
			1 => Ok(PeerSettings(max_frame_size, initial_window_size, enable_push, max_concurrent_streams, PeerHeaderTableSize(value, item_offset), max_header_list_size, local_enable_push))
			6 => Ok(PeerSettings(max_frame_size, initial_window_size, enable_push, max_concurrent_streams, header_table_size, PeerMaxHeaderListSize(value, item_offset), local_enable_push))
			_ => Ok(peer_settings)
		end
	end
end

fn update_single_initial_window_send_credit(payload: ByteChunk, item_offset: Int, peer_settings: PeerSettingsState, decision: OutboundSendCreditUpdateDecision) -> Result<OutboundSendCreditUpdateDecision, String>
	let item: ByteView = byte_view(payload, byte_offset(item_offset)?, byte_count(6)?)?
	let identifier: Int = byte_read_u16_be(byte_view(byte_view_to_chunk(item), byte_offset(0)?, byte_count(2)?)?)?
	let value: Int = byte_read_u32_be(byte_view(byte_view_to_chunk(item), byte_offset(2)?, byte_count(4)?)?)?
	match identifier
		4 => Ok(OutboundSendCreditUpdated(apply_initial_window_delta_to_outbound_send_credit(value - active_peer_initial_window_size(peer_settings), outbound_send_credit_update_credit(decision))))
		_ => Ok(decision)
	end
end

fn apply_initial_window_delta_to_outbound_send_credit(delta: Int, send_credit: OutboundSendCredit) -> OutboundSendCredit
	match send_credit
		OutboundSendCredit(connection_window, NoOutboundReceiveCreditStream) => OutboundSendCredit(connection_window, NoOutboundReceiveCreditStream)
		OutboundSendCredit(connection_window, OutboundReceiveCreditOpenStream(stream_id, stream_window)) => OutboundSendCredit(connection_window, OutboundReceiveCreditOpenStream(stream_id, stream_window + delta))
		OutboundSendCredit(connection_window, OutboundReceiveCreditOpenStreamContentLength(stream_id, stream_window, expected_length, observed_length)) => OutboundSendCredit(connection_window, OutboundReceiveCreditOpenStreamContentLength(stream_id, stream_window + delta, expected_length, observed_length))
		OutboundSendCredit(connection_window, OutboundReceiveCreditClosedStream(stream_id)) => OutboundSendCredit(connection_window, OutboundReceiveCreditClosedStream(stream_id))
		OutboundSendCredit(connection_window, OutboundReceiveCreditResetStream(stream_id, error_code)) => OutboundSendCredit(connection_window, OutboundReceiveCreditResetStream(stream_id, error_code))
	end
end

fn refill_outbound_send_credit(offset: Int, stream_id: Int, increment: Int, preview: ByteChunk, send_credit: OutboundSendCredit) -> Result<OutboundSendCreditUpdateDecision, String>
	match stream_id
		0 => refill_outbound_connection_send_credit(offset, increment, preview, send_credit)
		_ => refill_outbound_stream_send_credit(offset, stream_id, increment, preview, send_credit)
	end
end

fn refill_outbound_connection_send_credit(offset: Int, increment: Int, preview: ByteChunk, send_credit: OutboundSendCredit) -> Result<OutboundSendCreditUpdateDecision, String>
	match send_credit
		OutboundSendCredit(connection_window, stream_credit) => match increment == 0
			true => Ok(OutboundSendCreditUpdateRejected(InvalidWindowUpdateIncrement(offset, 0, increment, 1, max_receive_flow_control_window(), "connection-flow-control", "window_update_increment_nonzero", byte_chunk_view(preview)?)))
			false => match increment > max_receive_flow_control_window() - connection_window
				true => Ok(OutboundSendCreditUpdateRejected(FlowControlWindowExceeded(offset, 8, 0, increment, max_receive_flow_control_window() - connection_window, "connection-flow-control", "outbound_connection_window", preview)))
				false => Ok(OutboundSendCreditUpdated(OutboundSendCredit(connection_window + increment, stream_credit)))
			end
		end
	end
end

fn refill_outbound_stream_send_credit(offset: Int, stream_id: Int, increment: Int, preview: ByteChunk, send_credit: OutboundSendCredit) -> Result<OutboundSendCreditUpdateDecision, String>
	match send_credit
		OutboundSendCredit(_, NoOutboundReceiveCreditStream) => Ok(OutboundSendCreditUpdateRejected(InvalidFrameKind(offset, 8, stream_id, 1, "idle-stream", "idle_streams_require_headers")))
		OutboundSendCredit(connection_window, OutboundReceiveCreditOpenStream(open_stream_id, stream_window)) => match stream_id == open_stream_id
			false => Ok(OutboundSendCreditUpdateRejected(InvalidFrameKind(offset, 8, stream_id, 1, "idle-stream", "idle_streams_require_headers")))
			true => match increment == 0
				true => Ok(OutboundSendCreditUpdateRejected(InvalidWindowUpdateIncrement(offset, stream_id, increment, 1, max_receive_flow_control_window(), "open-stream", "window_update_increment_nonzero", byte_chunk_view(preview)?)))
				false => match increment > max_receive_flow_control_window() - stream_window
					true => Ok(OutboundSendCreditUpdateRejected(FlowControlWindowExceeded(offset, 8, stream_id, increment, max_receive_flow_control_window() - stream_window, "open-stream", "outbound_stream_window", preview)))
					false => Ok(OutboundSendCreditUpdated(OutboundSendCredit(connection_window, OutboundReceiveCreditOpenStream(open_stream_id, stream_window + increment))))
				end
			end
		end
		OutboundSendCredit(connection_window, OutboundReceiveCreditOpenStreamContentLength(open_stream_id, stream_window, expected_length, observed_length)) => match stream_id == open_stream_id
			false => Ok(OutboundSendCreditUpdateRejected(InvalidFrameKind(offset, 8, stream_id, 1, "idle-stream", "idle_streams_require_headers")))
			true => match increment == 0
				true => Ok(OutboundSendCreditUpdateRejected(InvalidWindowUpdateIncrement(offset, stream_id, increment, 1, max_receive_flow_control_window(), "open-stream", "window_update_increment_nonzero", byte_chunk_view(preview)?)))
				false => match increment > max_receive_flow_control_window() - stream_window
					true => Ok(OutboundSendCreditUpdateRejected(FlowControlWindowExceeded(offset, 8, stream_id, increment, max_receive_flow_control_window() - stream_window, "open-stream", "outbound_stream_window", preview)))
					false => Ok(OutboundSendCreditUpdated(OutboundSendCredit(connection_window, OutboundReceiveCreditOpenStreamContentLength(open_stream_id, stream_window + increment, expected_length, observed_length))))
				end
			end
		end
		OutboundSendCredit(_, OutboundReceiveCreditClosedStream(closed_stream_id)) => match stream_id == closed_stream_id
			true => Ok(OutboundSendCreditUpdateRejected(InvalidFrameKind(offset, 8, stream_id, 1, "closed-stream", "closed_stream_rejects_later_frames")))
			false => Ok(OutboundSendCreditUpdateRejected(InvalidFrameKind(offset, 8, stream_id, 1, "idle-stream", "idle_streams_require_headers")))
		end
		OutboundSendCredit(_, OutboundReceiveCreditResetStream(reset_stream_id, _)) => match stream_id == reset_stream_id
			true => Ok(OutboundSendCreditUpdateRejected(InvalidFrameKind(offset, 8, stream_id, 1, "reset-stream", "reset_stream_rejects_later_frames")))
			false => Ok(OutboundSendCreditUpdateRejected(InvalidFrameKind(offset, 8, stream_id, 1, "idle-stream", "idle_streams_require_headers")))
		end
	end
end

fn apply_initial_window_delta(delta: Int, receive_flow_control: ReceiveFlowControl) -> ReceiveFlowControl
	match receive_flow_control
		ReceiveFlowControl(connection_window, NoOpenStreamReceiveWindow) => ReceiveFlowControl(connection_window, NoOpenStreamReceiveWindow)
		ReceiveFlowControl(connection_window, OpenStreamReceiveWindow(stream_id, stream_window, priority)) => ReceiveFlowControl(connection_window, OpenStreamReceiveWindow(stream_id, stream_window + delta, priority))
		ReceiveFlowControl(connection_window, TwoOpenStreamReceiveWindows(first_stream_id, first_stream_window, first_priority, second_stream_id, second_stream_window, second_priority)) => ReceiveFlowControl(connection_window, TwoOpenStreamReceiveWindows(first_stream_id, first_stream_window + delta, first_priority, second_stream_id, second_stream_window + delta, second_priority))
		ReceiveFlowControl(connection_window, ClientPushAssociatedStreamReceiveWindow(stream_id, stream_window, priority, promised_stream_id)) => ReceiveFlowControl(connection_window, ClientPushAssociatedStreamReceiveWindow(stream_id, stream_window + delta, priority, promised_stream_id))
		ReceiveFlowControl(connection_window, HalfClosedLocalStreamReceiveWindow(stream_id, stream_window, priority)) => ReceiveFlowControl(connection_window, HalfClosedLocalStreamReceiveWindow(stream_id, stream_window + delta, priority))
		ReceiveFlowControl(connection_window, ClosedByPeerStreamReceiveWindow(stream_id, stream_window)) => ReceiveFlowControl(connection_window, ClosedByPeerStreamReceiveWindow(stream_id, stream_window))
		ReceiveFlowControl(connection_window, ResetStreamReceiveWindow(stream_id, error_code)) => ReceiveFlowControl(connection_window, ResetStreamReceiveWindow(stream_id, error_code))
	end
end

fn record_local_end_stream(state: Http2DecodeState, stream_id: Int) -> Http2DecodeState
	match state
		State(pending, next_offset, preface_state, continuation, hpack_state, receive_limit, peer_settings, shutdown_state, ReceiveFlowControl(connection_window, OpenStreamReceiveWindow(open_stream_id, stream_window, priority))) => match stream_id == open_stream_id
			true => State(pending, next_offset, preface_state, continuation, hpack_state, receive_limit, peer_settings, shutdown_state, ReceiveFlowControl(connection_window, HalfClosedLocalStreamReceiveWindow(open_stream_id, stream_window, priority)))
			false => state
		end
		State(pending, next_offset, preface_state, continuation, hpack_state, receive_limit, peer_settings, shutdown_state, ReceiveFlowControl(connection_window, ClientPushAssociatedStreamReceiveWindow(open_stream_id, stream_window, priority, _))) => match stream_id == open_stream_id
			true => State(pending, next_offset, preface_state, continuation, hpack_state, receive_limit, peer_settings, shutdown_state, ReceiveFlowControl(connection_window, HalfClosedLocalStreamReceiveWindow(open_stream_id, stream_window, priority)))
			false => state
		end
		State(_, _, _, _, _, _, _, _, _) => state
	end
end

fn update_shutdown_state(pending: ByteChunk, offset: Int, length: Int, kind: Int, shutdown_state: ConnectionShutdownState) -> Result<ShutdownStateDecision, String>
	match kind
		7 => match length == 8
			true => validate_goaway_shutdown_update(offset, decode_goaway_state(pending)?, shutdown_state, pending)
			false => Ok(ShutdownStateOk(shutdown_state))
		end
		_ => Ok(ShutdownStateOk(shutdown_state))
	end
end

fn validate_goaway_shutdown_update(offset: Int, decoded_shutdown: ConnectionShutdownState, shutdown_state: ConnectionShutdownState, preview_chunk: ByteChunk) -> Result<ShutdownStateDecision, String>
	match decoded_shutdown
		OpenConnection => Ok(ShutdownStateOk(shutdown_state))
		GracefulShutdown(new_last_stream_id, new_error_code) => match shutdown_state
			OpenConnection => Ok(ShutdownStateOk(GracefulShutdown(new_last_stream_id, new_error_code)))
			GracefulShutdown(current_last_stream_id, _) => match new_last_stream_id > current_last_stream_id
				true => Ok(ShutdownStateFailed(StreamAfterGoaway(offset, new_last_stream_id, current_last_stream_id, "graceful_shutdown", "server", "goaway_last_stream_id", preview_chunk)))
				false => Ok(ShutdownStateOk(GracefulShutdown(new_last_stream_id, new_error_code)))
			end
		end
	end
end

fn decode_goaway_state(pending: ByteChunk) -> Result<ConnectionShutdownState, String>
	let last_stream_offset: ByteOffset = byte_offset(9)?
	let error_code_offset: ByteOffset = byte_offset(13)?
	let field_count: ByteCount = byte_count(4)?
	let last_stream_view: ByteView = byte_view(pending, last_stream_offset, field_count)?
	let error_code_view: ByteView = byte_view(pending, error_code_offset, field_count)?
	let last_stream_id: Int = byte_read_u31_be(last_stream_view)?
	let error_code: Int = byte_read_u32_be(error_code_view)?
	Ok(GracefulShutdown(last_stream_id, error_code))
end

fn validate_continuation(continuation: PendingContinuation, offset: Int, payload: ByteChunk, kind: Int, flags: Int, stream_id: Int, promised_stream_id: Int, peer_settings: PeerSettingsState, receive_flow_control: ReceiveFlowControl, header_preview: ByteChunk) -> Result<ContinuationDecision, Http2ProtocolFailure>
	match continuation
		NoContinuation => validate_without_continuation(offset, payload, kind, flags, stream_id, promised_stream_id, peer_settings, receive_flow_control)
		Continuation(expected_stream, started_kind, started_offset, started_flags, started_is_trailer, pending_promised_stream_id, accumulated) => validate_with_continuation(expected_stream, started_kind, started_offset, started_flags, started_is_trailer, pending_promised_stream_id, accumulated, offset, payload, kind, flags, stream_id, header_preview)
	end
end

fn validate_without_continuation(offset: Int, payload: ByteChunk, kind: Int, flags: Int, stream_id: Int, promised_stream_id: Int, peer_settings: PeerSettingsState, receive_flow_control: ReceiveFlowControl) -> Result<ContinuationDecision, Http2ProtocolFailure>
	match kind
		1 => match end_headers_set(flags)
			true => Ok(Decision(NoContinuation, payload, data_end_stream_set(flags), completed_headers_are_trailers(flags, stream_id, receive_flow_control), 0))
			false => Ok(Decision(Continuation(stream_id, kind, offset, flags, completed_headers_are_trailers(flags, stream_id, receive_flow_control), 0, payload), empty_header_block(), false, false, 0))
		end
		5 => validate_push_promise_header_block(offset, payload, kind, flags, stream_id, promised_stream_id, peer_settings, receive_flow_control)
		_ => validate_connection_frame_kind(offset, kind, stream_id, receive_flow_control)
	end
end

fn validate_push_promise_header_block(offset: Int, payload: ByteChunk, kind: Int, flags: Int, stream_id: Int, promised_stream_id: Int, peer_settings: PeerSettingsState, receive_flow_control: ReceiveFlowControl) -> Result<ContinuationDecision, Http2ProtocolFailure>
	match validate_push_promise_stream_state(offset, kind, stream_id, receive_flow_control)
		Ok(_) => match local_enable_push_disabled(peer_settings)
			true => Err(InvalidFrameKind(offset, kind, stream_id, 1, "local-settings", "local_settings_enable_push_disabled"))
			false => match validate_received_push_promise_stream(offset, kind, stream_id, promised_stream_id, receive_flow_control)
				ProtocolStreamIdOk => match end_headers_set(flags)
					true => Ok(Decision(NoContinuation, payload, false, false, promised_stream_id))
					false => Ok(Decision(Continuation(stream_id, kind, offset, flags, false, promised_stream_id, payload), empty_header_block(), false, false, 0))
				end
				ProtocolStreamIdFailed(error) => Err(error)
			end
		end
		Err(error) => Err(error)
	end
end

fn frame_promised_stream_id(payload: ByteChunk, kind: Int) -> Result<Int, String>
	match kind
		5 => promised_stream_id_from_payload(payload)
		_ => Ok(0)
	end
end

fn promised_stream_id_from_payload(payload: ByteChunk) -> Result<Int, String>
	let decoded: {promised_stream_id: Int} = decoded_push_promise_payload(payload)?
	Ok(decoded.promised_stream_id)
end

fn decoded_push_promise_payload(payload: ByteChunk) -> Result<{promised_stream_id: Int}, String>
	byte_decode_http2_push_promise_payload_wire(byte_view(payload, byte_offset(0)?, byte_count(4)?)?)
end

fn continuation_payload_chunk(payload: ByteChunk, kind: Int, flags: Int) -> Result<ByteChunk, String>
	match kind
		5 => byte_drop(payload, byte_count(4)?)
		1 => headers_payload_chunk(payload, kind, flags)
		_ => Ok(payload)
	end
end

fn headers_payload_chunk(payload: ByteChunk, kind: Int, flags: Int) -> Result<ByteChunk, String>
	match headers_priority_set(kind, flags)
		true => byte_drop(payload, byte_count(5)?)
		false => Ok(payload)
	end
end

fn headers_priority_set(kind: Int, flags: Int) -> Bool
	match kind
		1 => ((flags / 32) * 32) != ((flags / 64) * 64)
		_ => false
	end
end

fn completed_headers_are_trailers(flags: Int, stream_id: Int, receive_flow_control: ReceiveFlowControl) -> Bool
	data_end_stream_set(flags) and stream_is_open_for_trailers(stream_id, receive_flow_control)
end

fn stream_is_open_for_trailers(stream_id: Int, receive_flow_control: ReceiveFlowControl) -> Bool
	match receive_flow_control
		ReceiveFlowControl(_, OpenStreamReceiveWindow(open_stream_id, _, _)) => stream_id == open_stream_id
		ReceiveFlowControl(_, TwoOpenStreamReceiveWindows(first_stream_id, _, _, second_stream_id, _, _)) => stream_id == first_stream_id or stream_id == second_stream_id
		ReceiveFlowControl(_, ClientPushAssociatedStreamReceiveWindow(open_stream_id, _, _, _)) => stream_id == open_stream_id
		ReceiveFlowControl(_, _) => false
	end
end

fn end_headers_set(flags: Int) -> Bool
	let low_three_bits: Int = flags - (flags / 8) * 8
	match low_three_bits < 4
		true => false
		false => true
	end
end

fn data_end_stream_set(flags: Int) -> Bool
	(flags / 2) * 2 != flags
end

fn data_padded_set(flags: Int) -> Bool
	let low_four_bits: Int = flags - (flags / 16) * 16
	low_four_bits >= 8
end

fn empty_header_block() -> ByteChunk
	byte_chunk([])
end

fn validate_connection_frame_kind(offset: Int, kind: Int, stream_id: Int, receive_flow_control: ReceiveFlowControl) -> Result<ContinuationDecision, Http2ProtocolFailure>
	match stream_id
		0 => match kind
			4 => Ok(Decision(NoContinuation, empty_header_block(), false, false, 0))
			6 => Ok(Decision(NoContinuation, empty_header_block(), false, false, 0))
			7 => Ok(Decision(NoContinuation, empty_header_block(), false, false, 0))
			8 => Ok(Decision(NoContinuation, empty_header_block(), false, false, 0))
			_ => match is_unknown_frame_kind(kind)
				true => Ok(Decision(NoContinuation, empty_header_block(), false, false, 0))
				false => Err(InvalidFrameKind(offset, kind, stream_id, 4, "connection-control", "connection_frames_require_settings"))
			end
		end
		_ => validate_stream_frame_kind(offset, kind, stream_id, receive_flow_control)
	end
end

fn validate_stream_frame_kind(offset: Int, kind: Int, stream_id: Int, receive_flow_control: ReceiveFlowControl) -> Result<ContinuationDecision, Http2ProtocolFailure>
	match kind
		1 => Ok(Decision(NoContinuation, empty_header_block(), false, false, 0))
		0 => validate_data_stream_state(offset, kind, stream_id, receive_flow_control)
		3 => validate_data_stream_state(offset, kind, stream_id, receive_flow_control)
		8 => validate_data_stream_state(offset, kind, stream_id, receive_flow_control)
		2 => validate_priority_stream_state(offset, kind, stream_id, receive_flow_control)
		5 => validate_push_promise_stream_state(offset, kind, stream_id, receive_flow_control)
		_ => match is_unknown_frame_kind(kind)
			true => validate_unknown_stream_state(offset, kind, stream_id, receive_flow_control)
			false => Err(InvalidFrameKind(offset, kind, stream_id, 1, "idle-stream", "idle_streams_require_headers"))
		end
	end
end

fn validate_push_promise_stream_state(offset: Int, kind: Int, stream_id: Int, receive_flow_control: ReceiveFlowControl) -> Result<ContinuationDecision, Http2ProtocolFailure>
	match receive_flow_control
		ReceiveFlowControl(_, ClientPushAssociatedStreamReceiveWindow(open_stream_id, _, _, _)) => match stream_id == open_stream_id
			true => Ok(Decision(NoContinuation, empty_header_block(), false, false, 0))
			false => Err(InvalidFrameKind(offset, kind, stream_id, 1, "idle-stream", "idle_streams_require_headers"))
		end
		ReceiveFlowControl(_, _) => Err(InvalidFrameKind(offset, kind, stream_id, 1, "server-receive", "server_receives_no_push_promise"))
	end
end

fn validate_received_push_promise_stream(offset: Int, kind: Int, stream_id: Int, promised_stream_id: Int, receive_flow_control: ReceiveFlowControl) -> ProtocolStreamIdDecision
	match promised_stream_id
		0 => ProtocolStreamIdFailed(InvalidStreamId(offset, kind, promised_stream_id, "nonzero server-initiated promised stream id", "client", "stream-id-domain", "client_push_promise_requires_server_stream"))
		_ => match stream_id_is_server_initiated(promised_stream_id)
			true => validate_received_push_promise_associated_stream(offset, kind, stream_id, receive_flow_control)
			false => ProtocolStreamIdFailed(InvalidStreamId(offset, kind, promised_stream_id, "nonzero server-initiated promised stream id", "client", "stream-id-domain", "client_push_promise_requires_server_stream"))
		end
	end
end

fn validate_received_push_promise_associated_stream(offset: Int, kind: Int, stream_id: Int, receive_flow_control: ReceiveFlowControl) -> ProtocolStreamIdDecision
	match receive_flow_control
		ReceiveFlowControl(_, ClientPushAssociatedStreamReceiveWindow(open_stream_id, _, _, _)) => match stream_id == open_stream_id
			true => ProtocolStreamIdOk
			false => ProtocolStreamIdFailed(InvalidFrameKind(offset, kind, stream_id, 1, "idle-stream", "idle_streams_require_headers"))
		end
		ReceiveFlowControl(_, _) => ProtocolStreamIdFailed(InvalidFrameKind(offset, kind, stream_id, 1, "server-receive", "server_receives_no_push_promise"))
	end
end

fn validate_priority_stream_state(offset: Int, kind: Int, stream_id: Int, receive_flow_control: ReceiveFlowControl) -> Result<ContinuationDecision, Http2ProtocolFailure>
	match receive_flow_control
		ReceiveFlowControl(_, NoOpenStreamReceiveWindow) => Ok(Decision(NoContinuation, empty_header_block(), false, false, 0))
		ReceiveFlowControl(_, OpenStreamReceiveWindow(open_stream_id, _, _)) => match stream_id == open_stream_id
			true => Ok(Decision(NoContinuation, empty_header_block(), false, false, 0))
			false => Ok(Decision(NoContinuation, empty_header_block(), false, false, 0))
		end
		ReceiveFlowControl(_, TwoOpenStreamReceiveWindows(first_stream_id, _, _, second_stream_id, _, _)) => match stream_id == first_stream_id
			true => Ok(Decision(NoContinuation, empty_header_block(), false, false, 0))
			false => match stream_id == second_stream_id
				true => Ok(Decision(NoContinuation, empty_header_block(), false, false, 0))
				false => Err(InvalidFrameKind(offset, kind, stream_id, 1, "idle-stream", "idle_streams_require_headers"))
			end
		end
		ReceiveFlowControl(_, ClientPushAssociatedStreamReceiveWindow(open_stream_id, _, _, promised_stream_id)) => match stream_id == open_stream_id
			true => Ok(Decision(NoContinuation, empty_header_block(), false, false, 0))
			false => match stream_id == promised_stream_id
				true => Err(InvalidFrameKind(offset, kind, stream_id, 1, "reserved-by-peer-stream", "reserved_by_peer_requires_response_headers"))
				false => Err(InvalidFrameKind(offset, kind, stream_id, 1, "idle-stream", "idle_streams_require_headers"))
			end
		end
		ReceiveFlowControl(_, HalfClosedLocalStreamReceiveWindow(open_stream_id, _, _)) => match stream_id == open_stream_id
			true => Ok(Decision(NoContinuation, empty_header_block(), false, false, 0))
			false => Err(InvalidFrameKind(offset, kind, stream_id, 1, "idle-stream", "idle_streams_require_headers"))
		end
		ReceiveFlowControl(_, ClosedByPeerStreamReceiveWindow(closed_stream_id, _)) => match stream_id == closed_stream_id
			true => Err(InvalidFrameKind(offset, kind, stream_id, 1, "closed-by-peer-stream", "closed_by_peer_rejects_later_frames"))
			false => Err(InvalidFrameKind(offset, kind, stream_id, 1, "idle-stream", "idle_streams_require_headers"))
		end
		ReceiveFlowControl(_, ResetStreamReceiveWindow(reset_stream_id, _)) => match stream_id == reset_stream_id
			true => Err(InvalidFrameKind(offset, kind, stream_id, 1, "reset-stream", "reset_stream_rejects_later_frames"))
			false => Err(InvalidFrameKind(offset, kind, stream_id, 1, "idle-stream", "idle_streams_require_headers"))
		end
	end
end

fn validate_unknown_stream_state(offset: Int, kind: Int, stream_id: Int, receive_flow_control: ReceiveFlowControl) -> Result<ContinuationDecision, Http2ProtocolFailure>
	match receive_flow_control
		ReceiveFlowControl(_, NoOpenStreamReceiveWindow) => Err(InvalidFrameKind(offset, kind, stream_id, 1, "idle-stream", "idle_streams_require_headers"))
		ReceiveFlowControl(_, OpenStreamReceiveWindow(open_stream_id, _, _)) => match stream_id == open_stream_id
			true => Ok(Decision(NoContinuation, empty_header_block(), false, false, 0))
			false => Err(InvalidFrameKind(offset, kind, stream_id, 1, "idle-stream", "idle_streams_require_headers"))
		end
		ReceiveFlowControl(_, TwoOpenStreamReceiveWindows(first_stream_id, _, _, second_stream_id, _, _)) => match stream_id == first_stream_id
			true => Ok(Decision(NoContinuation, empty_header_block(), false, false, 0))
			false => match stream_id == second_stream_id
				true => Ok(Decision(NoContinuation, empty_header_block(), false, false, 0))
				false => Err(InvalidFrameKind(offset, kind, stream_id, 1, "idle-stream", "idle_streams_require_headers"))
			end
		end
		ReceiveFlowControl(_, ClientPushAssociatedStreamReceiveWindow(open_stream_id, _, _, promised_stream_id)) => match stream_id == open_stream_id
			true => Ok(Decision(NoContinuation, empty_header_block(), false, false, 0))
			false => match stream_id == promised_stream_id
				true => Err(InvalidFrameKind(offset, kind, stream_id, 1, "reserved-by-peer-stream", "reserved_by_peer_requires_response_headers"))
				false => Err(InvalidFrameKind(offset, kind, stream_id, 1, "idle-stream", "idle_streams_require_headers"))
			end
		end
		ReceiveFlowControl(_, HalfClosedLocalStreamReceiveWindow(open_stream_id, _, _)) => match stream_id == open_stream_id
			true => Ok(Decision(NoContinuation, empty_header_block(), false, false, 0))
			false => Err(InvalidFrameKind(offset, kind, stream_id, 1, "idle-stream", "idle_streams_require_headers"))
		end
		ReceiveFlowControl(_, ClosedByPeerStreamReceiveWindow(closed_stream_id, _)) => match stream_id == closed_stream_id
			true => Err(InvalidFrameKind(offset, kind, stream_id, 1, "closed-by-peer-stream", "closed_by_peer_rejects_later_frames"))
			false => Err(InvalidFrameKind(offset, kind, stream_id, 1, "idle-stream", "idle_streams_require_headers"))
		end
		ReceiveFlowControl(_, ResetStreamReceiveWindow(reset_stream_id, _)) => match stream_id == reset_stream_id
			true => Err(InvalidFrameKind(offset, kind, stream_id, 1, "reset-stream", "reset_stream_rejects_later_frames"))
			false => Err(InvalidFrameKind(offset, kind, stream_id, 1, "idle-stream", "idle_streams_require_headers"))
		end
	end
end

fn validate_data_stream_state(offset: Int, kind: Int, stream_id: Int, receive_flow_control: ReceiveFlowControl) -> Result<ContinuationDecision, Http2ProtocolFailure>
	match receive_flow_control
		ReceiveFlowControl(_, NoOpenStreamReceiveWindow) => Err(InvalidFrameKind(offset, kind, stream_id, 1, "idle-stream", "idle_streams_require_headers"))
		ReceiveFlowControl(_, OpenStreamReceiveWindow(open_stream_id, _, _)) => match stream_id == open_stream_id
			true => Ok(Decision(NoContinuation, empty_header_block(), false, false, 0))
			false => Err(InvalidFrameKind(offset, kind, stream_id, 1, "idle-stream", "idle_streams_require_headers"))
		end
		ReceiveFlowControl(_, TwoOpenStreamReceiveWindows(first_stream_id, _, _, second_stream_id, _, _)) => match stream_id == first_stream_id
			true => Ok(Decision(NoContinuation, empty_header_block(), false, false, 0))
			false => match stream_id == second_stream_id
				true => Ok(Decision(NoContinuation, empty_header_block(), false, false, 0))
				false => Err(InvalidFrameKind(offset, kind, stream_id, 1, "idle-stream", "idle_streams_require_headers"))
			end
		end
		ReceiveFlowControl(_, ClientPushAssociatedStreamReceiveWindow(open_stream_id, _, _, promised_stream_id)) => match stream_id == open_stream_id
			true => Ok(Decision(NoContinuation, empty_header_block(), false, false, 0))
			false => match stream_id == promised_stream_id
				true => Err(InvalidFrameKind(offset, kind, stream_id, 1, "reserved-by-peer-stream", "reserved_by_peer_requires_response_headers"))
				false => Err(InvalidFrameKind(offset, kind, stream_id, 1, "idle-stream", "idle_streams_require_headers"))
			end
		end
		ReceiveFlowControl(_, HalfClosedLocalStreamReceiveWindow(open_stream_id, _, _)) => match stream_id == open_stream_id
			true => Ok(Decision(NoContinuation, empty_header_block(), false, false, 0))
			false => Err(InvalidFrameKind(offset, kind, stream_id, 1, "idle-stream", "idle_streams_require_headers"))
		end
		ReceiveFlowControl(_, ClosedByPeerStreamReceiveWindow(closed_stream_id, _)) => match stream_id == closed_stream_id
			true => Err(InvalidFrameKind(offset, kind, stream_id, 1, "closed-by-peer-stream", "closed_by_peer_rejects_later_frames"))
			false => Err(InvalidFrameKind(offset, kind, stream_id, 1, "idle-stream", "idle_streams_require_headers"))
		end
		ReceiveFlowControl(_, ResetStreamReceiveWindow(reset_stream_id, _)) => match stream_id == reset_stream_id
			true => Err(InvalidFrameKind(offset, kind, stream_id, 1, "reset-stream", "reset_stream_rejects_later_frames"))
			false => Err(InvalidFrameKind(offset, kind, stream_id, 1, "idle-stream", "idle_streams_require_headers"))
		end
	end
end

fn validate_with_continuation(expected_stream: Int, started_kind: Int, started_offset: Int, started_flags: Int, started_is_trailer: Bool, promised_stream_id: Int, accumulated: ByteChunk, offset: Int, payload: ByteChunk, kind: Int, flags: Int, stream_id: Int, header_preview: ByteChunk) -> Result<ContinuationDecision, Http2ProtocolFailure>
	match kind
		9 => validate_continuation_stream(expected_stream, started_kind, started_offset, started_flags, started_is_trailer, promised_stream_id, accumulated, offset, payload, kind, flags, stream_id, header_preview)
		_ => Err(ContinuationExpected(offset, kind, stream_id, expected_stream, started_kind, started_offset, header_preview))
	end
end

fn validate_continuation_stream(expected_stream: Int, started_kind: Int, started_offset: Int, started_flags: Int, started_is_trailer: Bool, promised_stream_id: Int, accumulated: ByteChunk, offset: Int, payload: ByteChunk, kind: Int, flags: Int, stream_id: Int, header_preview: ByteChunk) -> Result<ContinuationDecision, Http2ProtocolFailure>
	match stream_id == expected_stream
		true => match end_headers_set(flags)
			true => Ok(Decision(NoContinuation, byte_append(accumulated, payload), data_end_stream_set(started_flags), started_is_trailer, promised_stream_id))
			false => Ok(Decision(Continuation(expected_stream, started_kind, started_offset, started_flags, started_is_trailer, promised_stream_id, byte_append(accumulated, payload)), empty_header_block(), false, false, 0))
		end
		false => Err(ContinuationExpected(offset, kind, stream_id, expected_stream, started_kind, started_offset, header_preview))
	end
end

fn update_receive_flow_control(pending: ByteChunk, offset: Int, length: Int, kind: Int, flags: Int, stream_id: Int, completed_end_stream: Bool, promised_stream_id: Int, accepted_content_length: Int, headers: HpackHeaderList, completed_is_trailer: Bool, shutdown_state: ConnectionShutdownState, receive_flow_control: ReceiveFlowControl) -> Result<ReceiveFlowControlDecision, String>
	match kind
		1 => open_receive_stream(pending, offset, length, flags, stream_id, completed_end_stream, accepted_content_length, headers, completed_is_trailer, shutdown_state, receive_flow_control)
		0 => consume_data_receive_window(offset, stream_id, length, data_application_length(frame_payload_chunk(pending, length)?, length, flags)?, data_end_stream_set(flags), frame_payload_chunk(pending, length)?, receive_flow_control)
		3 => reset_receive_stream(pending, offset, stream_id, receive_flow_control)
		8 => update_window_receive_credit(pending, offset, stream_id, receive_flow_control)
		9 => match promised_stream_id > 0
			true => reserve_push_promise_stream(offset, stream_id, promised_stream_id, receive_flow_control)
			false => complete_continuation_receive_stream(offset, stream_id, completed_end_stream, accepted_content_length, headers, completed_is_trailer, receive_flow_control)
		end
		2 => update_priority_receive_state(pending, offset, length, stream_id, receive_flow_control)
		5 => reserve_push_promise_stream(offset, stream_id, promised_stream_id, receive_flow_control)
		_ => Ok(ReceiveFlowControlOk(receive_flow_control))
	end
end

fn reserve_push_promise_stream(offset: Int, stream_id: Int, promised_stream_id: Int, receive_flow_control: ReceiveFlowControl) -> Result<ReceiveFlowControlDecision, String>
	match receive_flow_control
		ReceiveFlowControl(connection_window, ClientPushAssociatedStreamReceiveWindow(open_stream_id, stream_window, priority, _)) => match stream_id == open_stream_id
			true => Ok(ReceiveFlowControlOk(ReceiveFlowControl(connection_window, ClientPushAssociatedStreamReceiveWindow(open_stream_id, stream_window, priority, promised_stream_id))))
			false => Ok(ReceiveFlowControlFailed(InvalidFrameKind(offset, 5, stream_id, 1, "idle-stream", "idle_streams_require_headers")))
		end
		ReceiveFlowControl(_, _) => Ok(ReceiveFlowControlFailed(InvalidFrameKind(offset, 5, stream_id, 1, "server-receive", "server_receives_no_push_promise")))
	end
end

fn open_receive_stream(pending: ByteChunk, offset: Int, length: Int, flags: Int, stream_id: Int, end_stream: Bool, accepted_content_length: Int, headers: HpackHeaderList, completed_is_trailer: Bool, shutdown_state: ConnectionShutdownState, receive_flow_control: ReceiveFlowControl) -> Result<ReceiveFlowControlDecision, String>
	let headers_priority: StreamPriorityState = headers_priority_from_frame(pending, length, flags)?
	let preview_chunk: ByteChunk = byte_view_to_chunk(frame_header_preview(length, 1, flags, stream_id)?)
	let header_priority_state: StreamPriorityState = stream_priority_with_header_side(headers, completed_is_trailer, headers_priority)
	match receive_flow_control
		ReceiveFlowControl(connection_window, NoOpenStreamReceiveWindow) => match validate_new_stream_after_goaway(offset, stream_id, shutdown_state, preview_chunk)
			ReceiveFlowControlOk(_) => initial_receive_stream_window_decision(offset, connection_window, stream_id, header_priority_state, end_stream, accepted_content_length)
			ReceiveFlowControlFailed(error) => Ok(ReceiveFlowControlFailed(error))
		end
		ReceiveFlowControl(connection_window, OpenStreamReceiveWindow(open_stream_id, stream_window, priority)) => match stream_id == open_stream_id
			true => receive_stream_window_after_headers_decision(offset, connection_window, open_stream_id, stream_window, stream_priority_with_optional_priority(priority, header_priority_state), end_stream, accepted_content_length)
			false => match validate_new_stream_after_goaway(offset, stream_id, shutdown_state, preview_chunk)
				ReceiveFlowControlOk(_) => Ok(ReceiveFlowControlFailed(ConcurrentStreamsExceeded(offset, stream_id, 2, concurrent_stream_receive_limit(), "server", "open-stream", concurrent_stream_receive_limit_provenance(), "peer_created_stream_receive_limit", preview_chunk)))
				ReceiveFlowControlFailed(error) => Ok(ReceiveFlowControlFailed(error))
			end
		end
		ReceiveFlowControl(_, TwoOpenStreamReceiveWindows(first_stream_id, _, _, second_stream_id, _, _)) => match stream_id == first_stream_id
			true => Ok(ReceiveFlowControlOk(receive_flow_control))
			false => match stream_id == second_stream_id
				true => Ok(ReceiveFlowControlOk(receive_flow_control))
				false => match validate_new_stream_after_goaway(offset, stream_id, shutdown_state, preview_chunk)
					ReceiveFlowControlOk(_) => Ok(ReceiveFlowControlFailed(ConcurrentStreamsExceeded(offset, stream_id, 3, concurrent_stream_receive_limit(), "server", "open-stream", concurrent_stream_receive_limit_provenance(), "peer_created_stream_receive_limit", preview_chunk)))
					ReceiveFlowControlFailed(error) => Ok(ReceiveFlowControlFailed(error))
				end
			end
		end
		ReceiveFlowControl(connection_window, ClientPushAssociatedStreamReceiveWindow(open_stream_id, stream_window, priority, promised_stream_id)) => match stream_id == open_stream_id
			true => receive_stream_window_after_headers_decision(offset, connection_window, open_stream_id, stream_window, stream_priority_with_optional_priority(priority, header_priority_state), end_stream, accepted_content_length)
			false => match stream_id == promised_stream_id
				true => receive_promised_stream_headers_decision(offset, connection_window, open_stream_id, stream_window, priority, promised_stream_id, header_priority_state, end_stream, accepted_content_length)
				false => match validate_new_stream_after_goaway(offset, stream_id, shutdown_state, preview_chunk)
					ReceiveFlowControlOk(_) => Ok(ReceiveFlowControlFailed(ConcurrentStreamsExceeded(offset, stream_id, 2, concurrent_stream_receive_limit(), "server", "open-stream", concurrent_stream_receive_limit_provenance(), "peer_created_stream_receive_limit", preview_chunk)))
					ReceiveFlowControlFailed(error) => Ok(ReceiveFlowControlFailed(error))
				end
			end
		end
		ReceiveFlowControl(_, HalfClosedLocalStreamReceiveWindow(open_stream_id, _, _)) => match stream_id == open_stream_id
			true => Ok(ReceiveFlowControlFailed(InvalidFrameKind(offset, 1, stream_id, 1, "half-closed-local-stream", "half_closed_local_data_only")))
			false => match validate_new_stream_after_goaway(offset, stream_id, shutdown_state, preview_chunk)
				ReceiveFlowControlOk(_) => Ok(ReceiveFlowControlFailed(ConcurrentStreamsExceeded(offset, stream_id, 2, concurrent_stream_receive_limit(), "server", "open-stream", concurrent_stream_receive_limit_provenance(), "peer_created_stream_receive_limit", preview_chunk)))
				ReceiveFlowControlFailed(error) => Ok(ReceiveFlowControlFailed(error))
			end
		end
		ReceiveFlowControl(_, ClosedByPeerStreamReceiveWindow(closed_stream_id, _)) => match stream_id == closed_stream_id
			true => Ok(ReceiveFlowControlFailed(InvalidFrameKind(offset, 1, stream_id, 1, "closed-by-peer-stream", "closed_by_peer_rejects_later_frames")))
			false => match validate_new_stream_after_goaway(offset, stream_id, shutdown_state, preview_chunk)
				ReceiveFlowControlOk(_) => Ok(ReceiveFlowControlFailed(ConcurrentStreamsExceeded(offset, stream_id, 2, concurrent_stream_receive_limit(), "server", "open-stream", concurrent_stream_receive_limit_provenance(), "peer_created_stream_receive_limit", preview_chunk)))
				ReceiveFlowControlFailed(error) => Ok(ReceiveFlowControlFailed(error))
			end
		end
		ReceiveFlowControl(_, ResetStreamReceiveWindow(reset_stream_id, _)) => match stream_id == reset_stream_id
			true => Ok(ReceiveFlowControlFailed(InvalidFrameKind(offset, 1, stream_id, 1, "reset-stream", "reset_stream_rejects_later_frames")))
			false => match validate_new_stream_after_goaway(offset, stream_id, shutdown_state, preview_chunk)
				ReceiveFlowControlOk(_) => Ok(ReceiveFlowControlFailed(ConcurrentStreamsExceeded(offset, stream_id, 2, concurrent_stream_receive_limit(), "server", "open-stream", concurrent_stream_receive_limit_provenance(), "peer_created_stream_receive_limit", preview_chunk)))
				ReceiveFlowControlFailed(error) => Ok(ReceiveFlowControlFailed(error))
			end
		end
	end
end

fn receive_promised_stream_headers_decision(offset: Int, connection_window: Int, associated_stream_id: Int, associated_stream_window: Int, associated_priority: StreamPriorityState, promised_stream_id: Int, headers_priority: StreamPriorityState, end_stream: Bool, accepted_content_length: Int) -> Result<ReceiveFlowControlDecision, String>
	let promised_priority: StreamPriorityState = stream_priority_with_accepted_content_length(headers_priority, accepted_content_length)
	match end_stream
		true => match stream_priority_content_length_expected(promised_priority) > 0
			true => Ok(ReceiveFlowControlFailed(ContentLengthMismatch(offset, 1, promised_stream_id, stream_priority_content_length_expected(promised_priority), stream_priority_content_length_observed(promised_priority), "open-stream", "rfc9113_content_length_body", empty_byte_preview()?)))
			false => Ok(ReceiveFlowControlOk(ReceiveFlowControl(connection_window, ClosedByPeerStreamReceiveWindow(promised_stream_id, 65535))))
		end
		false => Ok(ReceiveFlowControlOk(ReceiveFlowControl(connection_window, TwoOpenStreamReceiveWindows(associated_stream_id, associated_stream_window, associated_priority, promised_stream_id, 65535, promised_priority))))
	end
end

fn initial_receive_stream_window_decision(offset: Int, connection_window: Int, stream_id: Int, priority: StreamPriorityState, end_stream: Bool, accepted_content_length: Int) -> Result<ReceiveFlowControlDecision, String>
	receive_stream_window_after_headers_decision(offset, connection_window, stream_id, 65535, priority, end_stream, accepted_content_length)
end

fn headers_priority_from_frame(pending: ByteChunk, length: Int, flags: Int) -> Result<StreamPriorityState, String>
	match headers_priority_set(1, flags)
		true => headers_priority_from_payload(frame_payload_chunk(pending, length)?)
		false => Ok(NoStreamPriority)
	end
end

fn headers_priority_from_payload(payload: ByteChunk) -> Result<StreamPriorityState, String>
	let payload_view: ByteView = byte_view(payload, byte_offset(0)?, byte_count(5)?)?
	Ok(StreamPriority(priority_dependency_stream_id(payload_view)?, priority_exclusive(payload_view)?, priority_weight(payload_view)?))
end

fn receive_stream_window_after_headers_decision(offset: Int, connection_window: Int, stream_id: Int, stream_window: Int, priority: StreamPriorityState, end_stream: Bool, accepted_content_length: Int) -> Result<ReceiveFlowControlDecision, String>
	let next_priority: StreamPriorityState = stream_priority_with_accepted_content_length(priority, accepted_content_length)
	match end_stream
		true => match stream_priority_content_length_expected(next_priority) > 0
			true => Ok(ReceiveFlowControlFailed(ContentLengthMismatch(offset, 1, stream_id, stream_priority_content_length_expected(next_priority), stream_priority_content_length_observed(next_priority), "open-stream", "rfc9113_content_length_body", empty_byte_preview()?)))
			false => Ok(ReceiveFlowControlOk(ReceiveFlowControl(connection_window, ClosedByPeerStreamReceiveWindow(stream_id, stream_window))))
		end
		false => Ok(ReceiveFlowControlOk(ReceiveFlowControl(connection_window, OpenStreamReceiveWindow(stream_id, stream_window, next_priority))))
	end
end

fn stream_priority_with_accepted_content_length(priority: StreamPriorityState, accepted_content_length: Int) -> StreamPriorityState
	match accepted_content_length >= 0
		true => ExpectedContentLength(accepted_content_length, 0, stream_priority_without_content_length(priority))
		false => priority
	end
end

fn stream_priority_with_header_side(headers: HpackHeaderList, completed_is_trailer: Bool, priority: StreamPriorityState) -> StreamPriorityState
	match completed_is_trailer
		true => priority
		false => match hpack_fixture::header_list_is_response(headers)
			true => ResponseHeaderStream(priority)
			false => priority
		end
	end
end

fn stream_priority_without_content_length(priority: StreamPriorityState) -> StreamPriorityState
	match priority
		ExpectedContentLength(_, _, inner) => stream_priority_without_content_length(inner)
		ResponseHeaderStream(inner) => ResponseHeaderStream(stream_priority_without_content_length(inner))
		_ => priority
	end
end

fn stream_priority_with_priority(priority: StreamPriorityState, next_priority: StreamPriorityState) -> StreamPriorityState
	match priority
		ExpectedContentLength(expected_length, observed_length, _) => ExpectedContentLength(expected_length, observed_length, next_priority)
		ResponseHeaderStream(inner) => ResponseHeaderStream(stream_priority_with_priority(inner, next_priority))
		_ => next_priority
	end
end

fn stream_priority_with_optional_priority(priority: StreamPriorityState, next_priority: StreamPriorityState) -> StreamPriorityState
	match next_priority
		NoStreamPriority => priority
		_ => stream_priority_with_priority(priority, next_priority)
	end
end

fn stream_priority_content_length_expected(priority: StreamPriorityState) -> Int
	match priority
		ExpectedContentLength(expected_length, _, _) => expected_length
		ResponseHeaderStream(inner) => stream_priority_content_length_expected(inner)
		_ => -1
	end
end

fn stream_priority_content_length_observed(priority: StreamPriorityState) -> Int
	match priority
		ExpectedContentLength(_, observed_length, _) => observed_length
		ResponseHeaderStream(inner) => stream_priority_content_length_observed(inner)
		_ => 0
	end
end

fn update_content_length_body(offset: Int, frame_kind: Int, stream_id: Int, application_length: Int, end_stream: Bool, active_state: String, preview: ByteChunk, priority: StreamPriorityState) -> Result<ContentLengthBodyDecision, String>
	match priority
		ExpectedContentLength(expected_length, observed_length, inner) => validate_content_length_body(offset, frame_kind, stream_id, expected_length, observed_length + application_length, end_stream, active_state, preview, inner)
		ResponseHeaderStream(inner) => match update_content_length_body(offset, frame_kind, stream_id, application_length, end_stream, active_state, preview, inner)?
			ContentLengthBodyOk(next_inner) => Ok(ContentLengthBodyOk(ResponseHeaderStream(next_inner)))
			ContentLengthBodyFailed(error) => Ok(ContentLengthBodyFailed(error))
		end
		_ => Ok(ContentLengthBodyOk(priority))
	end
end

fn validate_content_length_body(offset: Int, frame_kind: Int, stream_id: Int, expected_length: Int, observed_length: Int, end_stream: Bool, active_state: String, preview: ByteChunk, inner: StreamPriorityState) -> Result<ContentLengthBodyDecision, String>
	match observed_length > expected_length
		true => Ok(ContentLengthBodyFailed(ContentLengthMismatch(offset, frame_kind, stream_id, expected_length, observed_length, active_state, "rfc9113_content_length_body", byte_chunk_view(preview)?)))
		false => match end_stream and observed_length < expected_length
			true => Ok(ContentLengthBodyFailed(ContentLengthMismatch(offset, frame_kind, stream_id, expected_length, observed_length, active_state, "rfc9113_content_length_body", byte_chunk_view(preview)?)))
			false => Ok(ContentLengthBodyOk(ExpectedContentLength(expected_length, observed_length, inner)))
		end
	end
end

fn complete_continuation_receive_stream(offset: Int, stream_id: Int, end_stream: Bool, accepted_content_length: Int, headers: HpackHeaderList, completed_is_trailer: Bool, receive_flow_control: ReceiveFlowControl) -> Result<ReceiveFlowControlDecision, String>
	match accepted_content_length >= 0
		true => complete_continuation_receive_stream_with_content_length(offset, stream_id, end_stream, accepted_content_length, headers, completed_is_trailer, receive_flow_control)
		false => match end_stream
			false => Ok(ReceiveFlowControlOk(receive_flow_control))
			true => Ok(close_continuation_receive_stream(offset, stream_id, receive_flow_control))
		end
	end
end

fn complete_continuation_receive_stream_with_content_length(offset: Int, stream_id: Int, end_stream: Bool, accepted_content_length: Int, headers: HpackHeaderList, completed_is_trailer: Bool, receive_flow_control: ReceiveFlowControl) -> Result<ReceiveFlowControlDecision, String>
	let header_priority_state: StreamPriorityState = stream_priority_with_header_side(headers, completed_is_trailer, NoStreamPriority)
	match receive_flow_control
		ReceiveFlowControl(connection_window, OpenStreamReceiveWindow(open_stream_id, stream_window, priority)) => match stream_id == open_stream_id
			true => receive_stream_window_after_headers_decision(offset, connection_window, open_stream_id, stream_window, stream_priority_with_optional_priority(priority, header_priority_state), end_stream, accepted_content_length)
			false => Ok(ReceiveFlowControlFailed(InvalidFrameKind(offset, 9, stream_id, 1, "idle-stream", "idle_streams_require_headers")))
		end
		ReceiveFlowControl(connection_window, ClientPushAssociatedStreamReceiveWindow(open_stream_id, stream_window, priority, promised_stream_id)) => match stream_id == open_stream_id
			true => receive_stream_window_after_headers_decision(offset, connection_window, open_stream_id, stream_window, stream_priority_with_optional_priority(priority, header_priority_state), end_stream, accepted_content_length)
			false => match stream_id == promised_stream_id
				true => receive_promised_stream_headers_decision(offset, connection_window, open_stream_id, stream_window, priority, promised_stream_id, header_priority_state, end_stream, accepted_content_length)
				false => Ok(ReceiveFlowControlFailed(InvalidFrameKind(offset, 9, stream_id, 1, "idle-stream", "idle_streams_require_headers")))
			end
		end
		ReceiveFlowControl(connection_window, HalfClosedLocalStreamReceiveWindow(open_stream_id, stream_window, priority)) => match stream_id == open_stream_id
			true => receive_stream_window_after_headers_decision(offset, connection_window, open_stream_id, stream_window, stream_priority_with_optional_priority(priority, header_priority_state), end_stream, accepted_content_length)
			false => Ok(ReceiveFlowControlFailed(InvalidFrameKind(offset, 9, stream_id, 1, "idle-stream", "idle_streams_require_headers")))
		end
		_ => Ok(close_continuation_receive_stream(offset, stream_id, receive_flow_control))
	end
end

fn close_continuation_receive_stream(offset: Int, stream_id: Int, receive_flow_control: ReceiveFlowControl) -> ReceiveFlowControlDecision
	match receive_flow_control
		ReceiveFlowControl(connection_window, NoOpenStreamReceiveWindow) => ReceiveFlowControlFailed(InvalidFrameKind(offset, 9, stream_id, 1, "idle-stream", "idle_streams_require_headers"))
		ReceiveFlowControl(connection_window, OpenStreamReceiveWindow(open_stream_id, stream_window, _)) => match stream_id == open_stream_id
			true => ReceiveFlowControlOk(ReceiveFlowControl(connection_window, ClosedByPeerStreamReceiveWindow(open_stream_id, stream_window)))
			false => ReceiveFlowControlFailed(InvalidFrameKind(offset, 9, stream_id, 1, "idle-stream", "idle_streams_require_headers"))
		end
		ReceiveFlowControl(_, TwoOpenStreamReceiveWindows(first_stream_id, _, _, second_stream_id, _, _)) => match stream_id == first_stream_id
			true => ReceiveFlowControlOk(receive_flow_control)
			false => match stream_id == second_stream_id
				true => ReceiveFlowControlOk(receive_flow_control)
				false => ReceiveFlowControlFailed(InvalidFrameKind(offset, 9, stream_id, 1, "idle-stream", "idle_streams_require_headers"))
			end
		end
		ReceiveFlowControl(connection_window, ClientPushAssociatedStreamReceiveWindow(open_stream_id, stream_window, _, promised_stream_id)) => match stream_id == open_stream_id
			true => ReceiveFlowControlOk(ReceiveFlowControl(connection_window, ClosedByPeerStreamReceiveWindow(open_stream_id, stream_window)))
			false => match stream_id == promised_stream_id
				true => ReceiveFlowControlOk(ReceiveFlowControl(connection_window, ClosedByPeerStreamReceiveWindow(promised_stream_id, 65535)))
				false => ReceiveFlowControlFailed(InvalidFrameKind(offset, 9, stream_id, 1, "idle-stream", "idle_streams_require_headers"))
			end
		end
		ReceiveFlowControl(connection_window, HalfClosedLocalStreamReceiveWindow(open_stream_id, stream_window, _)) => match stream_id == open_stream_id
			true => ReceiveFlowControlOk(ReceiveFlowControl(connection_window, ClosedByPeerStreamReceiveWindow(open_stream_id, stream_window)))
			false => ReceiveFlowControlFailed(InvalidFrameKind(offset, 9, stream_id, 1, "idle-stream", "idle_streams_require_headers"))
		end
		ReceiveFlowControl(_, ClosedByPeerStreamReceiveWindow(closed_stream_id, _)) => match stream_id == closed_stream_id
			true => ReceiveFlowControlFailed(InvalidFrameKind(offset, 9, stream_id, 1, "closed-by-peer-stream", "closed_by_peer_rejects_later_frames"))
			false => ReceiveFlowControlFailed(InvalidFrameKind(offset, 9, stream_id, 1, "idle-stream", "idle_streams_require_headers"))
		end
		ReceiveFlowControl(_, ResetStreamReceiveWindow(reset_stream_id, _)) => match stream_id == reset_stream_id
			true => ReceiveFlowControlFailed(InvalidFrameKind(offset, 9, stream_id, 1, "reset-stream", "reset_stream_rejects_later_frames"))
			false => ReceiveFlowControlFailed(InvalidFrameKind(offset, 9, stream_id, 1, "idle-stream", "idle_streams_require_headers"))
		end
	end
end

fn validate_new_stream_after_goaway(offset: Int, stream_id: Int, shutdown_state: ConnectionShutdownState, preview_chunk: ByteChunk) -> ReceiveFlowControlDecision
	match shutdown_state
		OpenConnection => ReceiveFlowControlOk(default_receive_flow_control())
		GracefulShutdown(last_stream_id, _) => match stream_id > last_stream_id
			true => ReceiveFlowControlFailed(StreamAfterGoaway(offset, stream_id, last_stream_id, "graceful_shutdown", "server", "goaway_last_stream_id", preview_chunk))
			false => ReceiveFlowControlOk(default_receive_flow_control())
		end
	end
end

fn consume_data_receive_window(offset: Int, stream_id: Int, length: Int, application_length: Int, end_stream: Bool, preview: ByteChunk, receive_flow_control: ReceiveFlowControl) -> Result<ReceiveFlowControlDecision, String>
	match receive_flow_control
		ReceiveFlowControl(connection_window, NoOpenStreamReceiveWindow) => Ok(ReceiveFlowControlFailed(InvalidFrameKind(offset, 0, stream_id, 1, "idle-stream", "idle_streams_require_headers")))
		ReceiveFlowControl(connection_window, OpenStreamReceiveWindow(open_stream_id, stream_window, priority)) => match length > connection_window
			true => Ok(ReceiveFlowControlFailed(FlowControlWindowExceeded(offset, 0, stream_id, length, connection_window, "connection-flow-control", "connection_receive_window", preview)))
			false => match length > stream_window
				true => Ok(ReceiveFlowControlFailed(FlowControlWindowExceeded(offset, 0, stream_id, length, stream_window, "open-stream", "stream_receive_window", preview)))
				false => receive_open_stream_data_after_windows(offset, stream_id, length, application_length, end_stream, preview, connection_window, open_stream_id, stream_window, priority)
			end
		end
		ReceiveFlowControl(connection_window, TwoOpenStreamReceiveWindows(first_stream_id, first_stream_window, first_priority, second_stream_id, second_stream_window, second_priority)) => match length > connection_window
			true => Ok(ReceiveFlowControlFailed(FlowControlWindowExceeded(offset, 0, stream_id, length, connection_window, "connection-flow-control", "connection_receive_window", preview)))
			false => match stream_id == first_stream_id
				true => match length > first_stream_window
					true => Ok(ReceiveFlowControlFailed(FlowControlWindowExceeded(offset, 0, stream_id, length, first_stream_window, "open-stream", "stream_receive_window", preview)))
					false => receive_first_open_stream_data_after_windows(offset, stream_id, length, application_length, end_stream, preview, connection_window, first_stream_id, first_stream_window, first_priority, second_stream_id, second_stream_window, second_priority)
				end
				false => match stream_id == second_stream_id
					true => match length > second_stream_window
						true => Ok(ReceiveFlowControlFailed(FlowControlWindowExceeded(offset, 0, stream_id, length, second_stream_window, "open-stream", "stream_receive_window", preview)))
						false => receive_second_open_stream_data_after_windows(offset, stream_id, length, application_length, end_stream, preview, connection_window, first_stream_id, first_stream_window, first_priority, second_stream_id, second_stream_window, second_priority)
					end
					false => Ok(ReceiveFlowControlFailed(InvalidFrameKind(offset, 0, stream_id, 1, "idle-stream", "idle_streams_require_headers")))
				end
			end
		end
		ReceiveFlowControl(connection_window, ClientPushAssociatedStreamReceiveWindow(open_stream_id, stream_window, priority, promised_stream_id)) => match length > connection_window
			true => Ok(ReceiveFlowControlFailed(FlowControlWindowExceeded(offset, 0, stream_id, length, connection_window, "connection-flow-control", "connection_receive_window", preview)))
			false => match stream_id == open_stream_id
				true => match length > stream_window
					true => Ok(ReceiveFlowControlFailed(FlowControlWindowExceeded(offset, 0, stream_id, length, stream_window, "open-stream", "stream_receive_window", preview)))
					false => receive_client_push_associated_data_after_windows(offset, stream_id, length, application_length, end_stream, preview, connection_window, open_stream_id, stream_window, priority, promised_stream_id)
				end
				false => match stream_id == promised_stream_id
					true => Ok(ReceiveFlowControlFailed(InvalidFrameKind(offset, 0, stream_id, 1, "reserved-by-peer-stream", "reserved_by_peer_requires_response_headers")))
					false => Ok(ReceiveFlowControlFailed(InvalidFrameKind(offset, 0, stream_id, 1, "idle-stream", "idle_streams_require_headers")))
				end
			end
		end
		ReceiveFlowControl(connection_window, HalfClosedLocalStreamReceiveWindow(open_stream_id, stream_window, priority)) => match length > connection_window
			true => Ok(ReceiveFlowControlFailed(FlowControlWindowExceeded(offset, 0, stream_id, length, connection_window, "connection-flow-control", "connection_receive_window", preview)))
			false => match length > stream_window
				true => Ok(ReceiveFlowControlFailed(FlowControlWindowExceeded(offset, 0, stream_id, length, stream_window, "half-closed-local-stream", "stream_receive_window", preview)))
				false => receive_half_closed_local_stream_data_after_windows(offset, stream_id, length, application_length, end_stream, preview, connection_window, open_stream_id, stream_window, priority)
			end
		end
		ReceiveFlowControl(_, ClosedByPeerStreamReceiveWindow(closed_stream_id, _)) => match stream_id == closed_stream_id
			true => Ok(ReceiveFlowControlFailed(InvalidFrameKind(offset, 0, stream_id, 1, "closed-by-peer-stream", "closed_by_peer_rejects_later_frames")))
			false => Ok(ReceiveFlowControlFailed(InvalidFrameKind(offset, 0, stream_id, 1, "idle-stream", "idle_streams_require_headers")))
		end
		ReceiveFlowControl(_, ResetStreamReceiveWindow(reset_stream_id, _)) => match stream_id == reset_stream_id
			true => Ok(ReceiveFlowControlFailed(InvalidFrameKind(offset, 0, stream_id, 1, "reset-stream", "reset_stream_rejects_later_frames")))
			false => Ok(ReceiveFlowControlFailed(InvalidFrameKind(offset, 0, stream_id, 1, "idle-stream", "idle_streams_require_headers")))
		end
	end
end

fn receive_client_push_associated_data_after_windows(offset: Int, stream_id: Int, length: Int, application_length: Int, end_stream: Bool, preview: ByteChunk, connection_window: Int, open_stream_id: Int, stream_window: Int, priority: StreamPriorityState, promised_stream_id: Int) -> Result<ReceiveFlowControlDecision, String>
	let body_decision: ContentLengthBodyDecision = update_content_length_body(offset, 0, stream_id, application_length, end_stream, "open-stream", preview, priority)?
	match body_decision
		ContentLengthBodyOk(next_priority) => match end_stream
			true => Ok(ReceiveFlowControlOk(ReceiveFlowControl(connection_window - length, ClosedByPeerStreamReceiveWindow(open_stream_id, stream_window - length))))
			false => Ok(ReceiveFlowControlOk(ReceiveFlowControl(connection_window - length, ClientPushAssociatedStreamReceiveWindow(open_stream_id, stream_window - length, next_priority, promised_stream_id))))
		end
		ContentLengthBodyFailed(error) => Ok(ReceiveFlowControlFailed(error))
	end
end

fn receive_open_stream_data_after_windows(offset: Int, stream_id: Int, length: Int, application_length: Int, end_stream: Bool, preview: ByteChunk, connection_window: Int, open_stream_id: Int, stream_window: Int, priority: StreamPriorityState) -> Result<ReceiveFlowControlDecision, String>
	let body_decision: ContentLengthBodyDecision = update_content_length_body(offset, 0, stream_id, application_length, end_stream, "open-stream", preview, priority)?
	match body_decision
		ContentLengthBodyOk(next_priority) => match end_stream
			true => Ok(ReceiveFlowControlOk(ReceiveFlowControl(connection_window - length, ClosedByPeerStreamReceiveWindow(open_stream_id, stream_window - length))))
			false => Ok(ReceiveFlowControlOk(ReceiveFlowControl(connection_window - length, OpenStreamReceiveWindow(open_stream_id, stream_window - length, next_priority))))
		end
		ContentLengthBodyFailed(error) => Ok(ReceiveFlowControlFailed(error))
	end
end

fn receive_first_open_stream_data_after_windows(offset: Int, stream_id: Int, length: Int, application_length: Int, end_stream: Bool, preview: ByteChunk, connection_window: Int, first_stream_id: Int, first_stream_window: Int, first_priority: StreamPriorityState, second_stream_id: Int, second_stream_window: Int, second_priority: StreamPriorityState) -> Result<ReceiveFlowControlDecision, String>
	let body_decision: ContentLengthBodyDecision = update_content_length_body(offset, 0, stream_id, application_length, end_stream, "open-stream", preview, first_priority)?
	match body_decision
		ContentLengthBodyOk(next_priority) => Ok(ReceiveFlowControlOk(ReceiveFlowControl(connection_window - length, TwoOpenStreamReceiveWindows(first_stream_id, first_stream_window - length, next_priority, second_stream_id, second_stream_window, second_priority))))
		ContentLengthBodyFailed(error) => Ok(ReceiveFlowControlFailed(error))
	end
end

fn receive_second_open_stream_data_after_windows(offset: Int, stream_id: Int, length: Int, application_length: Int, end_stream: Bool, preview: ByteChunk, connection_window: Int, first_stream_id: Int, first_stream_window: Int, first_priority: StreamPriorityState, second_stream_id: Int, second_stream_window: Int, second_priority: StreamPriorityState) -> Result<ReceiveFlowControlDecision, String>
	let body_decision: ContentLengthBodyDecision = update_content_length_body(offset, 0, stream_id, application_length, end_stream, "open-stream", preview, second_priority)?
	match body_decision
		ContentLengthBodyOk(next_priority) => Ok(ReceiveFlowControlOk(ReceiveFlowControl(connection_window - length, TwoOpenStreamReceiveWindows(first_stream_id, first_stream_window, first_priority, second_stream_id, second_stream_window - length, next_priority))))
		ContentLengthBodyFailed(error) => Ok(ReceiveFlowControlFailed(error))
	end
end

fn receive_half_closed_local_stream_data_after_windows(offset: Int, stream_id: Int, length: Int, application_length: Int, end_stream: Bool, preview: ByteChunk, connection_window: Int, open_stream_id: Int, stream_window: Int, priority: StreamPriorityState) -> Result<ReceiveFlowControlDecision, String>
	let body_decision: ContentLengthBodyDecision = update_content_length_body(offset, 0, stream_id, application_length, end_stream, "half-closed-local-stream", preview, priority)?
	match body_decision
		ContentLengthBodyOk(next_priority) => match end_stream
			true => Ok(ReceiveFlowControlOk(ReceiveFlowControl(connection_window - length, ClosedByPeerStreamReceiveWindow(open_stream_id, stream_window - length))))
			false => Ok(ReceiveFlowControlOk(ReceiveFlowControl(connection_window - length, HalfClosedLocalStreamReceiveWindow(open_stream_id, stream_window - length, next_priority))))
		end
		ContentLengthBodyFailed(error) => Ok(ReceiveFlowControlFailed(error))
	end
end

fn reset_receive_stream(pending: ByteChunk, offset: Int, stream_id: Int, receive_flow_control: ReceiveFlowControl) -> Result<ReceiveFlowControlDecision, String>
	let error_code: Int = rst_stream_error_code(pending)?
	match receive_flow_control
		ReceiveFlowControl(connection_window, NoOpenStreamReceiveWindow) => Ok(ReceiveFlowControlFailed(InvalidFrameKind(offset, 3, stream_id, 1, "idle-stream", "idle_streams_require_headers")))
		ReceiveFlowControl(connection_window, OpenStreamReceiveWindow(open_stream_id, _, _)) => match stream_id == open_stream_id
			true => Ok(ReceiveFlowControlOk(ReceiveFlowControl(connection_window, ResetStreamReceiveWindow(stream_id, error_code))))
			false => Ok(ReceiveFlowControlFailed(InvalidFrameKind(offset, 3, stream_id, 1, "idle-stream", "idle_streams_require_headers")))
		end
		ReceiveFlowControl(connection_window, TwoOpenStreamReceiveWindows(first_stream_id, _, _, second_stream_id, _, _)) => match stream_id == first_stream_id
			true => Ok(ReceiveFlowControlOk(ReceiveFlowControl(connection_window, ResetStreamReceiveWindow(stream_id, error_code))))
			false => match stream_id == second_stream_id
				true => Ok(ReceiveFlowControlOk(ReceiveFlowControl(connection_window, ResetStreamReceiveWindow(stream_id, error_code))))
				false => Ok(ReceiveFlowControlFailed(InvalidFrameKind(offset, 3, stream_id, 1, "idle-stream", "idle_streams_require_headers")))
			end
		end
		ReceiveFlowControl(connection_window, ClientPushAssociatedStreamReceiveWindow(open_stream_id, _, _, promised_stream_id)) => match stream_id == open_stream_id
			true => Ok(ReceiveFlowControlOk(ReceiveFlowControl(connection_window, ResetStreamReceiveWindow(stream_id, error_code))))
			false => match stream_id == promised_stream_id
				true => Ok(ReceiveFlowControlFailed(InvalidFrameKind(offset, 3, stream_id, 1, "reserved-by-peer-stream", "reserved_by_peer_requires_response_headers")))
				false => Ok(ReceiveFlowControlFailed(InvalidFrameKind(offset, 3, stream_id, 1, "idle-stream", "idle_streams_require_headers")))
			end
		end
		ReceiveFlowControl(connection_window, HalfClosedLocalStreamReceiveWindow(open_stream_id, _, _)) => match stream_id == open_stream_id
			true => Ok(ReceiveFlowControlOk(ReceiveFlowControl(connection_window, ResetStreamReceiveWindow(stream_id, error_code))))
			false => Ok(ReceiveFlowControlFailed(InvalidFrameKind(offset, 3, stream_id, 1, "idle-stream", "idle_streams_require_headers")))
		end
		ReceiveFlowControl(connection_window, ClosedByPeerStreamReceiveWindow(closed_stream_id, _)) => match stream_id == closed_stream_id
			true => Ok(ReceiveFlowControlFailed(InvalidFrameKind(offset, 3, stream_id, 1, "closed-by-peer-stream", "closed_by_peer_rejects_later_frames")))
			false => Ok(ReceiveFlowControlFailed(InvalidFrameKind(offset, 3, stream_id, 1, "idle-stream", "idle_streams_require_headers")))
		end
		ReceiveFlowControl(connection_window, ResetStreamReceiveWindow(reset_stream_id, _)) => match stream_id == reset_stream_id
			true => Ok(ReceiveFlowControlFailed(InvalidFrameKind(offset, 3, stream_id, 1, "reset-stream", "reset_stream_rejects_later_frames")))
			false => Ok(ReceiveFlowControlFailed(InvalidFrameKind(offset, 3, stream_id, 1, "idle-stream", "idle_streams_require_headers")))
		end
	end
end

fn rst_stream_error_code(pending: ByteChunk) -> Result<Int, String>
	let payload_offset: ByteOffset = byte_offset(9)?
	let payload_count: ByteCount = byte_count(4)?
	let payload: ByteView = byte_view(pending, payload_offset, payload_count)?
	byte_read_u32_be(payload)
end

fn max_receive_flow_control_window() -> Int
	2147483647
end

fn update_window_receive_credit(pending: ByteChunk, offset: Int, stream_id: Int, receive_flow_control: ReceiveFlowControl) -> Result<ReceiveFlowControlDecision, String>
	let increment: Int = window_update_increment(pending)?
	let preview: ByteView = window_update_payload_view(pending)?
	match stream_id
		0 => Ok(update_connection_receive_credit(offset, increment, preview, receive_flow_control))
		_ => Ok(update_stream_receive_credit(offset, stream_id, increment, preview, receive_flow_control))
	end
end

fn window_update_increment(pending: ByteChunk) -> Result<Int, String>
	let payload: ByteView = window_update_payload_view(pending)?
	byte_read_u31_be(payload)
end

fn window_update_payload_view(pending: ByteChunk) -> Result<ByteView, String>
	let payload_offset: ByteOffset = byte_offset(9)?
	let payload_count: ByteCount = byte_count(4)?
	byte_view(pending, payload_offset, payload_count)
end

fn update_connection_receive_credit(offset: Int, increment: Int, preview: ByteView, receive_flow_control: ReceiveFlowControl) -> ReceiveFlowControlDecision
	match receive_flow_control
		ReceiveFlowControl(connection_window, open_stream) => match increment == 0
			true => ReceiveFlowControlFailed(InvalidWindowUpdateIncrement(offset, 0, increment, 1, max_receive_flow_control_window(), "connection-flow-control", "window_update_increment_nonzero", preview))
			false => match increment > max_receive_flow_control_window() - connection_window
				true => ReceiveFlowControlFailed(FlowControlWindowExceeded(offset, 8, 0, increment, max_receive_flow_control_window() - connection_window, "connection-flow-control", "connection_receive_window", byte_view_to_chunk(preview)))
				false => ReceiveFlowControlOk(ReceiveFlowControl(connection_window + increment, open_stream))
			end
		end
	end
end

fn update_stream_receive_credit(offset: Int, stream_id: Int, increment: Int, preview: ByteView, receive_flow_control: ReceiveFlowControl) -> ReceiveFlowControlDecision
	match receive_flow_control
		ReceiveFlowControl(connection_window, NoOpenStreamReceiveWindow) => ReceiveFlowControlFailed(InvalidFrameKind(offset, 8, stream_id, 1, "idle-stream", "idle_streams_require_headers"))
		ReceiveFlowControl(connection_window, OpenStreamReceiveWindow(open_stream_id, stream_window, priority)) => match stream_id == open_stream_id
			false => ReceiveFlowControlFailed(InvalidFrameKind(offset, 8, stream_id, 1, "idle-stream", "idle_streams_require_headers"))
			true => match increment == 0
				true => ReceiveFlowControlFailed(InvalidWindowUpdateIncrement(offset, stream_id, increment, 1, max_receive_flow_control_window(), "open-stream", "window_update_increment_nonzero", preview))
				false => match increment > max_receive_flow_control_window() - stream_window
					true => ReceiveFlowControlFailed(FlowControlWindowExceeded(offset, 8, stream_id, increment, max_receive_flow_control_window() - stream_window, "open-stream", "stream_receive_window", byte_view_to_chunk(preview)))
					false => ReceiveFlowControlOk(ReceiveFlowControl(connection_window, OpenStreamReceiveWindow(open_stream_id, stream_window + increment, priority)))
				end
			end
		end
		ReceiveFlowControl(connection_window, TwoOpenStreamReceiveWindows(first_stream_id, first_stream_window, first_priority, second_stream_id, second_stream_window, second_priority)) => match stream_id == first_stream_id
			true => match increment == 0
				true => ReceiveFlowControlFailed(InvalidWindowUpdateIncrement(offset, stream_id, increment, 1, max_receive_flow_control_window(), "open-stream", "window_update_increment_nonzero", preview))
				false => match increment > max_receive_flow_control_window() - first_stream_window
					true => ReceiveFlowControlFailed(FlowControlWindowExceeded(offset, 8, stream_id, increment, max_receive_flow_control_window() - first_stream_window, "open-stream", "stream_receive_window", byte_view_to_chunk(preview)))
					false => ReceiveFlowControlOk(ReceiveFlowControl(connection_window, TwoOpenStreamReceiveWindows(first_stream_id, first_stream_window + increment, first_priority, second_stream_id, second_stream_window, second_priority)))
				end
			end
			false => match stream_id == second_stream_id
				true => match increment == 0
					true => ReceiveFlowControlFailed(InvalidWindowUpdateIncrement(offset, stream_id, increment, 1, max_receive_flow_control_window(), "open-stream", "window_update_increment_nonzero", preview))
					false => match increment > max_receive_flow_control_window() - second_stream_window
						true => ReceiveFlowControlFailed(FlowControlWindowExceeded(offset, 8, stream_id, increment, max_receive_flow_control_window() - second_stream_window, "open-stream", "stream_receive_window", byte_view_to_chunk(preview)))
						false => ReceiveFlowControlOk(ReceiveFlowControl(connection_window, TwoOpenStreamReceiveWindows(first_stream_id, first_stream_window, first_priority, second_stream_id, second_stream_window + increment, second_priority)))
					end
				end
				false => ReceiveFlowControlFailed(InvalidFrameKind(offset, 8, stream_id, 1, "idle-stream", "idle_streams_require_headers"))
			end
		end
		ReceiveFlowControl(connection_window, ClientPushAssociatedStreamReceiveWindow(open_stream_id, stream_window, priority, promised_stream_id)) => match stream_id == open_stream_id
			true => match increment == 0
				true => ReceiveFlowControlFailed(InvalidWindowUpdateIncrement(offset, stream_id, increment, 1, max_receive_flow_control_window(), "open-stream", "window_update_increment_nonzero", preview))
				false => match increment > max_receive_flow_control_window() - stream_window
					true => ReceiveFlowControlFailed(FlowControlWindowExceeded(offset, 8, stream_id, increment, max_receive_flow_control_window() - stream_window, "open-stream", "stream_receive_window", byte_view_to_chunk(preview)))
					false => ReceiveFlowControlOk(ReceiveFlowControl(connection_window, ClientPushAssociatedStreamReceiveWindow(open_stream_id, stream_window + increment, priority, promised_stream_id)))
				end
			end
			false => match stream_id == promised_stream_id
				true => ReceiveFlowControlFailed(InvalidFrameKind(offset, 8, stream_id, 1, "reserved-by-peer-stream", "reserved_by_peer_requires_response_headers"))
				false => ReceiveFlowControlFailed(InvalidFrameKind(offset, 8, stream_id, 1, "idle-stream", "idle_streams_require_headers"))
			end
		end
		ReceiveFlowControl(_, HalfClosedLocalStreamReceiveWindow(open_stream_id, _, _)) => match stream_id == open_stream_id
			true => ReceiveFlowControlFailed(InvalidFrameKind(offset, 8, stream_id, 1, "half-closed-local-stream", "half_closed_local_data_only"))
			false => ReceiveFlowControlFailed(InvalidFrameKind(offset, 8, stream_id, 1, "idle-stream", "idle_streams_require_headers"))
		end
		ReceiveFlowControl(_, ClosedByPeerStreamReceiveWindow(closed_stream_id, _)) => match stream_id == closed_stream_id
			true => ReceiveFlowControlFailed(InvalidFrameKind(offset, 8, stream_id, 1, "closed-by-peer-stream", "closed_by_peer_rejects_later_frames"))
			false => ReceiveFlowControlFailed(InvalidFrameKind(offset, 8, stream_id, 1, "idle-stream", "idle_streams_require_headers"))
		end
		ReceiveFlowControl(_, ResetStreamReceiveWindow(reset_stream_id, _)) => match stream_id == reset_stream_id
			true => ReceiveFlowControlFailed(InvalidFrameKind(offset, 8, stream_id, 1, "reset-stream", "reset_stream_rejects_later_frames"))
			false => ReceiveFlowControlFailed(InvalidFrameKind(offset, 8, stream_id, 1, "idle-stream", "idle_streams_require_headers"))
		end
	end
end

fn update_priority_receive_state(pending: ByteChunk, offset: Int, length: Int, stream_id: Int, receive_flow_control: ReceiveFlowControl) -> Result<ReceiveFlowControlDecision, String>
	let payload: ByteChunk = frame_payload_chunk(pending, length)?
	let payload_view: ByteView = byte_view(payload, byte_offset(0)?, byte_count(5)?)?
	match receive_flow_control
		ReceiveFlowControl(connection_window, NoOpenStreamReceiveWindow) => Ok(ReceiveFlowControlOk(ReceiveFlowControl(connection_window, NoOpenStreamReceiveWindow)))
		ReceiveFlowControl(connection_window, OpenStreamReceiveWindow(open_stream_id, stream_window, priority)) => match stream_id == open_stream_id
			true => Ok(ReceiveFlowControlOk(ReceiveFlowControl(connection_window, OpenStreamReceiveWindow(open_stream_id, stream_window, stream_priority_with_priority(priority, StreamPriority(priority_dependency_stream_id(payload_view)?, priority_exclusive(payload_view)?, priority_weight(payload_view)?))))))
			false => Ok(ReceiveFlowControlOk(ReceiveFlowControl(connection_window, OpenStreamReceiveWindow(open_stream_id, stream_window, priority))))
		end
		ReceiveFlowControl(connection_window, TwoOpenStreamReceiveWindows(first_stream_id, first_stream_window, first_priority, second_stream_id, second_stream_window, second_priority)) => match stream_id == first_stream_id
			true => Ok(ReceiveFlowControlOk(ReceiveFlowControl(connection_window, TwoOpenStreamReceiveWindows(first_stream_id, first_stream_window, stream_priority_with_priority(first_priority, StreamPriority(priority_dependency_stream_id(payload_view)?, priority_exclusive(payload_view)?, priority_weight(payload_view)?)), second_stream_id, second_stream_window, second_priority))))
			false => match stream_id == second_stream_id
				true => Ok(ReceiveFlowControlOk(ReceiveFlowControl(connection_window, TwoOpenStreamReceiveWindows(first_stream_id, first_stream_window, first_priority, second_stream_id, second_stream_window, stream_priority_with_priority(second_priority, StreamPriority(priority_dependency_stream_id(payload_view)?, priority_exclusive(payload_view)?, priority_weight(payload_view)?))))))
				false => Ok(ReceiveFlowControlFailed(InvalidFrameKind(offset, 2, stream_id, 1, "idle-stream", "idle_streams_require_headers")))
			end
		end
		ReceiveFlowControl(connection_window, ClientPushAssociatedStreamReceiveWindow(open_stream_id, stream_window, priority, promised_stream_id)) => match stream_id == open_stream_id
			true => Ok(ReceiveFlowControlOk(ReceiveFlowControl(connection_window, ClientPushAssociatedStreamReceiveWindow(open_stream_id, stream_window, stream_priority_with_priority(priority, StreamPriority(priority_dependency_stream_id(payload_view)?, priority_exclusive(payload_view)?, priority_weight(payload_view)?)), promised_stream_id))))
			false => match stream_id == promised_stream_id
				true => Ok(ReceiveFlowControlFailed(InvalidFrameKind(offset, 2, stream_id, 1, "reserved-by-peer-stream", "reserved_by_peer_requires_response_headers")))
				false => Ok(ReceiveFlowControlFailed(InvalidFrameKind(offset, 2, stream_id, 1, "idle-stream", "idle_streams_require_headers")))
			end
		end
		ReceiveFlowControl(connection_window, HalfClosedLocalStreamReceiveWindow(open_stream_id, stream_window, priority)) => match stream_id == open_stream_id
			true => Ok(ReceiveFlowControlOk(ReceiveFlowControl(connection_window, HalfClosedLocalStreamReceiveWindow(open_stream_id, stream_window, stream_priority_with_priority(priority, StreamPriority(priority_dependency_stream_id(payload_view)?, priority_exclusive(payload_view)?, priority_weight(payload_view)?))))))
			false => Ok(ReceiveFlowControlFailed(InvalidFrameKind(offset, 2, stream_id, 1, "idle-stream", "idle_streams_require_headers")))
		end
		ReceiveFlowControl(_, ClosedByPeerStreamReceiveWindow(closed_stream_id, _)) => match stream_id == closed_stream_id
			true => Ok(ReceiveFlowControlFailed(InvalidFrameKind(offset, 2, stream_id, 1, "closed-by-peer-stream", "closed_by_peer_rejects_later_frames")))
			false => Ok(ReceiveFlowControlFailed(InvalidFrameKind(offset, 2, stream_id, 1, "idle-stream", "idle_streams_require_headers")))
		end
		ReceiveFlowControl(_, ResetStreamReceiveWindow(reset_stream_id, _)) => match stream_id == reset_stream_id
			true => Ok(ReceiveFlowControlFailed(InvalidFrameKind(offset, 2, stream_id, 1, "reset-stream", "reset_stream_rejects_later_frames")))
			false => Ok(ReceiveFlowControlFailed(InvalidFrameKind(offset, 2, stream_id, 1, "idle-stream", "idle_streams_require_headers")))
		end
	end
end

fn step_kind(step: Http2Step) -> String
	match step
		FrameDecoded(_, _, _, _, _, _, _, _) => "frame"
		Waiting(_) => "waiting"
		Failed(_, _) => "failed"
	end
end

fn step_state(step: Http2Step) -> Http2DecodeState
	match step
		FrameDecoded(state, _, _, _, _, _, _, _) => state
		Waiting(state) => state
		Failed(state, _) => state
	end
end

fn step_failure(step: Http2Step) -> Http2ProtocolFailure
	match step
		FrameDecoded(_, _, _, _, _, _, _, _) => ClosedWithPending(0, 0, byte_chunk([]))
		Waiting(_) => ClosedWithPending(0, 0, byte_chunk([]))
		Failed(_, failure) => failure
	end
end

fn step_offset(step: Http2Step) -> Int
	match step
		FrameDecoded(_, offset, _, _, _, _, _, _) => offset
		Waiting(_) => 0
		Failed(_, _) => 0
	end
end

fn step_kind_value(step: Http2Step) -> Int
	match step
		FrameDecoded(_, _, _, kind, _, _, _, _) => kind
		Waiting(_) => 0
		Failed(_, _) => 0
	end
end

fn step_stream_id(step: Http2Step) -> Int
	match step
		FrameDecoded(_, _, _, _, _, stream_id, _, _) => stream_id
		Waiting(_) => 0
		Failed(_, _) => 0
	end
end

fn step_flags(step: Http2Step) -> Int
	match step
		FrameDecoded(_, _, _, _, flags, _, _, _) => flags
		Waiting(_) => 0
		Failed(_, _) => 0
	end
end

fn step_completed_count(step: Http2Step) -> Int
	match step
		FrameDecoded(_, _, _, _, _, _, completed_header_block, _) => byte_count_to_int(byte_chunk_count(completed_header_block))
		Waiting(_) => 0
		Failed(_, _) => 0
	end
end

fn step_completed_header_block(step: Http2Step) -> ByteChunk
	match step
		FrameDecoded(_, _, _, _, _, _, completed_header_block, _) => completed_header_block
		Waiting(_) => empty_header_block()
		Failed(_, _) => empty_header_block()
	end
end

fn step_frame_payload_chunk(step: Http2Step) -> ByteChunk
	match step
		FrameDecoded(_, _, _, _, _, _, _, KnownFrame(_, _, _, payload)) => byte_view_to_chunk(payload)
		FrameDecoded(_, _, _, _, _, _, _, PriorityFrame(_, _, _, _, _)) => byte_chunk([])
		FrameDecoded(_, _, _, _, _, _, _, UnknownFrame(_, _, _, payload)) => byte_view_to_chunk(payload)
		Waiting(_) => byte_chunk([])
		Failed(_, _) => byte_chunk([])
	end
end

fn state_pending_count(state: Http2DecodeState) -> Int
	match state
		State(pending, _, _, _, _, _, _, _, _) => byte_count_to_int(byte_chunk_count(pending))
	end
end

fn state_pending_chunk(state: Http2DecodeState) -> ByteChunk
	match state
		State(pending, _, _, _, _, _, _, _, _) => pending
	end
end

fn state_next_offset(state: Http2DecodeState) -> Int
	match state
		State(_, next_offset, _, _, _, _, _, _, _) => next_offset
	end
end

fn state_receive_limit(state: Http2DecodeState) -> ReceiveLimitEntry
	match state
		State(_, _, _, _, _, receive_limit, _, _, _) => receive_limit
	end
end

fn state_preface_label(state: Http2DecodeState) -> String
	match state
		State(_, _, ExpectPreface, _, _, _, _, _, _) => "expect"
		State(_, _, AfterPreface, _, _, _, _, _, _) => "done"
	end
end

fn state_continuation_label(state: Http2DecodeState) -> String
	match state
		State(_, _, _, NoContinuation, _, _, _, _, _) => "none"
		State(_, _, _, Continuation(_, _, _, _, _, _, _), _, _, _, _, _) => "active"
	end
end

fn state_continuation_count(state: Http2DecodeState) -> Int
	match state
		State(_, _, _, NoContinuation, _, _, _, _, _) => 0
		State(_, _, _, Continuation(_, _, _, _, _, _, accumulated), _, _, _, _, _) => byte_count_to_int(byte_chunk_count(accumulated))
	end
end

fn state_continuation_stream(state: Http2DecodeState) -> Int
	match state
		State(_, _, _, NoContinuation, _, _, _, _, _) => 0
		State(_, _, _, Continuation(stream_id, _, _, _, _, _, _), _, _, _, _, _) => stream_id
	end
end

fn state_continuation_started_kind(state: Http2DecodeState) -> Int
	match state
		State(_, _, _, NoContinuation, _, _, _, _, _) => 0
		State(_, _, _, Continuation(_, started_kind, _, _, _, _, _), _, _, _, _, _) => started_kind
	end
end

fn state_continuation_started_offset(state: Http2DecodeState) -> Int
	match state
		State(_, _, _, NoContinuation, _, _, _, _, _) => 0
		State(_, _, _, Continuation(_, _, started_offset, _, _, _, _), _, _, _, _, _) => started_offset
	end
end

fn state_peer_max_frame_size(state: Http2DecodeState) -> Int
	match state
		State(_, _, _, _, _, _, PeerSettings(NoPeerMaxFrameSize, _, _, _, _, _, _), _, _) => 0
		State(_, _, _, _, _, _, PeerSettings(PeerMaxFrameSize(value, _), _, _, _, _, _, _), _, _) => value
