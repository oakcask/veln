		Err(failure) => print_outbound_hpack_encode_failure(label, failure)
	end
end

fn print_checked_outbound_hpack_encode_transition(label: String, transition: HpackEncodeTransition, expected_hex: String) -> Result<HpackFixtureState, String> effects [stdio]
	let matches: Bool = byte_chunks_equal(hpack_fixture::encode_transition_bytes(transition), byte_chunk_from_hex(expected_hex)?)?
	match matches
		true => print_outbound_hpack_encode_transition_success(label, transition)
		false => Err("unexpected outbound HPACK fixture header-list encoding")
	end
end

fn print_outbound_hpack_encode_transition_success(label: String, transition: HpackEncodeTransition) -> Result<HpackFixtureState, String> effects [stdio]
	let encoded: ByteChunk = hpack_fixture::encode_transition_bytes(transition)
	let state: HpackFixtureState = hpack_fixture::encode_transition_state(transition)
	stdio::print(label)
	stdio::print(" outbound-hpack-encode encoded_count ")
	stdio::print(int_to_string(byte_count_to_int(byte_chunk_count(encoded))))
	stdio::print(" first_byte ")
	stdio::print(int_to_string(read_byte(encoded, 0)?))
	stdio::print(" next_encode_count ")
	stdio::print(int_to_string(hpack_fixture::state_encode_count(state)))
	stdio::print(" table_size ")
	stdio::println(int_to_string(hpack_fixture::state_table_size(state)))
	Ok(state)
end

