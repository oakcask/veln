fn request_headers_open_stream() -> Result<Http2Step, String>
	receive(InputChunk(byte_chunk_from_hex("000003010400000001303132")?), frame_state())
end

fn response_headers_open_stream() -> Result<Http2Step, String>
	receive(InputChunk(byte_chunk_from_hex("000003010400000001353637")?), frame_state())
end

