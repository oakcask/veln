fn payload_byte_at(payload: ByteView, index: Int) -> Result<Int, String>
	byte_read_u8_be(byte_view(byte_view_to_chunk(payload), byte_offset(index)?, byte_count(1)?)?)
end

fn print_unknown_frame_value(label: String, frame: Http2Frame) -> Result<(), String> effects [stdio]
	match frame
		KnownFrame(_, _, _, _) => Err("expected unknown frame")
		UnknownFrame(kind, flags, stream_id, payload) => print_unknown_frame_payload(label, kind, flags, stream_id, payload)
	end
end

fn print_unknown_frame_payload(label: String, kind: Int, flags: Int, stream_id: Int, payload: ByteView) -> Result<(), String> effects [stdio]
	let payload_chunk: ByteChunk = byte_view_to_chunk(payload)
	let payload_count: Int = byte_count_to_int(byte_chunk_count(payload_chunk))
	stdio::print(label)
	stdio::print(" result unknown kind ")
	stdio::print(int_to_string(kind))
	stdio::print(" stream ")
	stdio::print(int_to_string(stream_id))
	stdio::print(" flags ")
	stdio::print(int_to_string(flags))
	stdio::print(" payload_count ")
	stdio::print(int_to_string(payload_count))
	stdio::print(" payload_first ")
	stdio::print(int_to_string(payload_byte_at(payload, 0)?))
	stdio::print(" payload_middle ")
	stdio::print(int_to_string(payload_byte_at(payload, 1)?))
	stdio::print(" payload_last ")
	stdio::println(int_to_string(payload_byte_at(payload, payload_count - 1)?))
	emit_encoded_header(label, payload_chunk, "aabbcc")
	Ok(())
end

fn print_unknown_frame(label: String, step: Http2Step) -> Result<(), String> effects [stdio]
	match step
		FrameDecoded(_, _, _, _, _, _, _, frame) => print_unknown_frame_value(label, frame)
		Waiting(_) => Err("expected unknown frame but step was waiting")
		Failed(_, _) => Err("expected unknown frame but step failed")
	end
end

fn byte_chunks_equal(left: ByteChunk, right: ByteChunk) -> Result<Bool, String>
	let left_count: Int = byte_count_to_int(byte_chunk_count(left))
	let right_count: Int = byte_count_to_int(byte_chunk_count(right))
	match left_count == right_count
		true => byte_chunks_equal_at(left, right, 0, left_count)
		false => Ok(false)
	end
end

fn byte_chunks_equal_at(left: ByteChunk, right: ByteChunk, index: Int, count: Int) -> Result<Bool, String>
	match index == count
		true => Ok(true)
		false => match read_byte(left, index)? == read_byte(right, index)?
			true => byte_chunks_equal_at(left, right, index + 1, count)
			false => Ok(false)
		end
	end
end

fn checked_hex_label(chunk: ByteChunk, expected_hex: String) -> Result<String, String>
	let expected: ByteChunk = byte_chunk_from_hex(expected_hex)?
	let matches_expected: Bool = byte_chunks_equal(chunk, expected)?
	match matches_expected
		true => Ok(expected_hex)
		false => Ok("mismatch")
	end
end

fn emit_output_chunk(name: String, index: Int, chunk: ByteChunk, expected_hex: String) -> Result<(), String> effects [stdio]
	stdio::print("output_chunk ")
	stdio::print(name)
	stdio::print(" index ")
	stdio::print(int_to_string(index))
	stdio::print(" hex \"")
	stdio::print(checked_hex_label(chunk, expected_hex)?)
	stdio::print("\" count ")
	stdio::println(int_to_string(byte_count_to_int(byte_chunk_count(chunk))))
	Ok(())
end

fn emit_output_chunk_list_header(name: String, count: Int) -> () effects [stdio]
	stdio::print("output_chunk_list ")
	stdio::print(name)
	stdio::print(" count ")
	stdio::println(int_to_string(count))
end

fn emit_encoded_header(name: String, bytes: ByteChunk, expected_hex: String) -> Result<(), String> effects [stdio]
	emit_output_chunk_list_header(name, 1)
	emit_output_chunk(name, 0, bytes, expected_hex)
end

fn emit_header_block(name: String, step: Http2Step, expected_hex: String) -> Result<(), String> effects [stdio]
	emit_output_chunk_list_header(name, 1)
	emit_output_chunk(name, 0, step_completed_header_block(step), expected_hex)
end

fn unexpected_frame_header_encode_failure() -> Result<(), String> effects [stdio]
	stdio::println("unexpected frame header encode failure")
	Ok(())
end

fn print_encoded_header(name: String, encoded: Result<ByteChunk, EncodeError>, expected_hex: String) -> Result<(), String> effects [stdio]
	match encoded
		Ok(bytes) => emit_encoded_header(name, bytes, expected_hex)
		Err(_) => unexpected_frame_header_encode_failure()
	end
end

fn encode_error_id(error: EncodeError) -> String
	match error
		EncodeError(id, _, _) => id
	end
end

fn encode_error_path(error: EncodeError) -> String
	match error
		EncodeError(_, field_path, _) => field_path
	end
end

fn encode_error_reason(error: EncodeError) -> String
	match error
		EncodeError(_, _, reason) => reason
	end
end

fn print_encode_error_detail(label: String, error: EncodeError) -> () effects [stdio]
	stdio::print(label)
	stdio::print(" encode_error ")
	stdio::print(encode_error_id(error))
	stdio::print(" ")
	stdio::print(encode_error_path(error))
	stdio::print(" ")
	stdio::println(encode_error_reason(error))
end

fn print_encode_error(label: String, encoded: Result<ByteChunk, EncodeError>) -> () effects [stdio]
	match encoded
		Ok(_) => stdio::println("unexpected frame header encode success")
		Err(error) => print_encode_error_detail(label, error)
	end
end

pub fn main() -> Result<(), String> effects [stdio]
	let preface_valid: Http2Step = receive(InputChunk(byte_chunk_from_hex("505249202a20485454502f322e300d0a0d0a534d0d0a0d0a000000040000000000")?), empty_state())?
	print_step("preface-valid", preface_valid)
	let preface_unknown: Http2Step = receive(InputChunk(byte_chunk_from_hex("505249202a20485454502f322e300d0a0d0a534d0d0a0d0a0000030a2300000000aabbcc")?), empty_state())?
	let preface_unknown_result: () = print_unknown_frame("preface-unknown", preface_unknown)?
	let preface_partial: Http2Step = receive(InputChunk(byte_chunk_from_hex("505249202a20")?), empty_state())?
	print_step("preface-partial", preface_partial)
	let preface_closed: Http2Step = receive(InputEnd, step_state(preface_partial))?
	print_failure("preface-closed", preface_closed)
	let preface_mismatch: Http2Step = receive(InputChunk(byte_chunk_from_hex("505249202b")?), empty_state())?
	print_failure("preface-mismatch", preface_mismatch)
	let valid: Http2Step = receive(InputChunk(byte_chunk_from_hex("000000040000000000")?), frame_state())?
	print_step("valid", valid)
	let incomplete: Http2Step = receive(InputChunk(byte_chunk_from_hex("00000004")?), frame_state())?
	print_step("incomplete", incomplete)
	let truncated: Http2Step = receive(InputEnd, step_state(incomplete))?
	print_failure("closed", truncated)
	let header_start: Http2Step = receive(InputChunk(byte_chunk_from_hex("000003010000000001aabbcc")?), frame_state())?
	print_step("headers", header_start)
	let continuation_more: Http2Step = receive(InputChunk(byte_chunk_from_hex("000002090000000001ddee")?), step_state(header_start))?
	print_step("continuation-more", continuation_more)
	let continuation_done: Http2Step = receive(InputChunk(byte_chunk_from_hex("00000409040000000101020304")?), step_state(continuation_more))?
	print_step("continuation-done", continuation_done)
	let ignored_continuation_header_block: () = emit_header_block("http2-continuation-header-block", continuation_done, "aabbccddee01020304")?
	let headers_done: Http2Step = receive(InputChunk(byte_chunk_from_hex("000003010500000001102030")?), frame_state())?
	print_step("headers-done", headers_done)
	let ignored_headers_header_block: () = emit_header_block("http2-headers-header-block", headers_done, "102030")?
	let bad_continuation: Http2Step = receive(InputChunk(byte_chunk_from_hex("000000000000000001")?), step_state(header_start))?
	print_failure("continuation", bad_continuation)
	let wrong_stream_continuation: Http2Step = receive(InputChunk(byte_chunk_from_hex("000000090400000003")?), step_state(header_start))?
	print_failure("continuation-stream", wrong_stream_continuation)
	let closed_continuation: Http2Step = receive(InputEnd, step_state(header_start))?
	print_failure("continuation-closed", closed_continuation)
	let unknown_extension: Http2Step = receive(InputChunk(byte_chunk_from_hex("0000030a2300000000aabbcc")?), frame_state())?
	let ignored_unknown: () = print_unknown_frame("unknown-extension", unknown_extension)?
	let unknown_during_continuation: Http2Step = receive(InputChunk(byte_chunk_from_hex("0000030a2300000001aabbcc")?), step_state(header_start))?
	print_failure("unknown-continuation", unknown_during_continuation)
	let max_allowed_incomplete: Http2Step = receive(InputChunk(byte_chunk_from_hex("004000000000000003")?), frame_state())?
	print_step("frame-size-at-limit", max_allowed_incomplete)
	let too_large: Http2Step = receive(InputChunk(byte_chunk_from_hex("004001000000000003")?), frame_state())?
	print_failure("frame-size", too_large)
