fn print_data_receive_cases() -> Result<(), String> effects [stdio]
	let data_headers: Http2Step = receive(InputChunk(byte_chunk_from_hex("000000010400000001")?), frame_state())?
	print_step("data-headers", data_headers)
	print_receive_windows("data-headers", step_state(data_headers))
	let data_open: Http2Step = receive(InputChunk(byte_chunk_from_hex("00000400000000000101020304")?), step_state(data_headers))?
	print_step("data-open", data_open)
	print_receive_windows("data-open", step_state(data_open))
	let ignored_data_padding_cases: () = print_data_padding_cases(data_headers)?
	let ignored_data_end_stream_cases: () = print_data_end_stream_cases()?
	let rst_open: Http2Step = receive(InputChunk(byte_chunk_from_hex("00000403000000000100000008")?), step_state(data_headers))?
	print_rst_stream("rst-open", rst_open)
	let data_after_rst: Http2Step = receive(InputChunk(byte_chunk_from_hex("000000000000000001")?), step_state(rst_open))?
	print_failure("rst-then-data", data_after_rst)
	let window_update_after_rst: Http2Step = receive(InputChunk(byte_chunk_from_hex("00000408000000000100000001")?), step_state(rst_open))?
	print_failure("rst-then-window-update", window_update_after_rst)
	let rst_zero_stream: Http2Step = receive(InputChunk(byte_chunk_from_hex("00000403000000000000000008")?), receive_window_state(65535, 1, 65535))?
	print_stream_id_failure("rst-zero-stream", rst_zero_stream)
	let rst_bad_length: Http2Step = receive(InputChunk(byte_chunk_from_hex("000003030000000001000008")?), receive_window_state(65535, 1, 65535))?
	print_failure("rst-length", rst_bad_length)
	let rst_idle: Http2Step = receive(InputChunk(byte_chunk_from_hex("00000403000000000300000008")?), frame_state())?
	print_failure("rst-idle", rst_idle)
	let data_stream_window: Http2Step = receive(InputChunk(byte_chunk_from_hex("00000400000000000101020304")?), receive_window_state(65535, 1, 3))?
	print_failure("data-stream-window", data_stream_window)
	let data_connection_window: Http2Step = receive(InputChunk(byte_chunk_from_hex("00000400000000000101020304")?), receive_window_state(3, 1, 65535))?
	print_failure("data-connection-window", data_connection_window)
	Ok(())
end

