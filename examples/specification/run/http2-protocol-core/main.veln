		ClosedWithPartialPreface(_, _) => 0
		InvalidPreface(_, _, _, _) => 0
		ContinuationExpected(_, _, _, _, _, _) => 0
		InvalidFrameKind(_, _, _, _, _, _) => 0
		InvalidStreamId(_, _, _, _, _, _, _) => 0
		InvalidPayloadLength(_, _, _, _, _, _, _, _) => 0
		InvalidDataPadding(_, _, _, _, _, _, _) => 0
		UnexpectedSettingsAck(_, _, _) => 0
		InvalidPriorityDependency(_, _, _, _, _) => 0
		FrameSizeExceeded(_, _, _, _, _) => 0
		FlowControlWindowExceeded(_, _, _, _, _, _, _) => 0
		ConcurrentStreamsExceeded(_, _, _, _, _, _, _) => 0
		HeaderListSizeExceeded(_, _, _, _, _, _) => 0
		SettingsValueOutOfRange(_, _, _, _, _, _, _) => 0
		HpackFixtureDecodeFailed(_, _, _, _, _) => 0
	end
end

