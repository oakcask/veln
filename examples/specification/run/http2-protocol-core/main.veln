	let ignored_shutdown: () = require_equal_string(label, outbound_push_promise_connection_shutdown_label(initial_outbound_push_promise_connection_state(empty_peer_settings(), outbound_headers_connection_shutdown(after_state), after_credit)), outbound_push_promise_connection_shutdown_label(initial_outbound_push_promise_connection_state(empty_peer_settings(), outbound_headers_connection_shutdown(before_state), before_credit)))?
	let ignored_shutdown_last_stream: () = require_equal_int(label, outbound_headers_connection_shutdown_last_stream(after_state), outbound_headers_connection_shutdown_last_stream(before_state))?
	let ignored_shutdown_error: () = require_equal_int(label, outbound_headers_connection_shutdown_error(after_state), outbound_headers_connection_shutdown_error(before_state))?
	let ignored_connection_window: () = require_equal_int(label, outbound_receive_connection_window(after_credit), outbound_receive_connection_window(before_credit))?
	let ignored_open_stream: () = require_equal_int(label, outbound_receive_open_stream_id(after_credit), outbound_receive_open_stream_id(before_credit))?
	let ignored_closed_stream: () = require_equal_int(label, outbound_receive_closed_stream_id(after_credit), outbound_receive_closed_stream_id(before_credit))?
	let ignored_reset_stream: () = require_equal_int(label, outbound_receive_reset_stream_id(after_credit), outbound_receive_reset_stream_id(before_credit))?
	let ignored_stream_window: () = require_equal_int(label, outbound_receive_stream_window(after_credit), outbound_receive_stream_window(before_credit))?
	let ignored_hpack_table_size: () = require_equal_int(label, hpack_fixture::state_table_size(after_hpack), hpack_fixture::state_table_size(before_hpack))?
	let ignored_hpack_encode_count: () = require_equal_int(label, hpack_fixture::state_encode_count(after_hpack), hpack_fixture::state_encode_count(before_hpack))?
	require_equal_int(label, hpack_fixture::state_dynamic_table_entry_count(after_hpack), hpack_fixture::state_dynamic_table_entry_count(before_hpack))
