		Ok(transition) => match hpack_fixture::header_list_first_name(hpack_fixture::transition_headers(transition)) == expected_name and hpack_fixture::header_list_first_value(hpack_fixture::transition_headers(transition)) == expected_value
			true => Ok(())
			false => Err("unexpected HTTP/2 HPACK carried header")
		end
		Err(_) => Err("expected HTTP/2 HPACK carried decode")
	end
end

