fn state_continuation_started_offset(state: Http2DecodeState) -> Int
	match state
		State(_, _, _, NoContinuation, _, _, _, _, _, _) => 0
		State(_, _, _, Continuation(_, _, started_offset, _, _, _, _), _, _, _, _, _, _) => started_offset
