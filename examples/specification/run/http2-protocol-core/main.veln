fn require_hpack_bytes(transition: HpackEncodeTransition, expected_hex: String) -> Result<(), String>
	let expected: ByteChunk = byte_chunk_from_hex(expected_hex)?
	let matches: Bool = byte_chunks_equal(hpack_fixture::encode_transition_bytes(transition), expected)?
	match matches
		true => Ok(())
		false => Err("unexpected production HPACK header-list bytes")
	end
end

fn require_production_hpack_state(state: HpackFixtureState, encode_count: Int, dynamic_entries: Int) -> Result<(), String>
	match hpack_fixture::state_encode_count(state) == encode_count and hpack_fixture::state_dynamic_table_entry_count(state) == dynamic_entries
		true => Ok(())
		false => Err("unexpected production HPACK header-list state")
	end
end

fn check_atomic_production_hpack_failure() -> Result<(), String>
	let initial: HpackFixtureState = hpack_fixture::initial_encode_state()
	match hpack_fixture::encode_header_fields_with_state(production_invalid_header_fields(), initial, 4096, 0)
		Ok(_) => Err("expected production HPACK header-list failure")
		Err(_) => match hpack_fixture::encode_header_fields_with_state(production_single_method_header_fields(), initial, 4096, 0)
			Err(_) => Err("expected reusable production HPACK input state")
			Ok(retry) => match require_hpack_bytes(retry, "82")
				Err(error) => Err(error)
				Ok(_) => require_production_hpack_state(hpack_fixture::encode_transition_state(retry), 1, 0)
			end
		end
	end
end

fn check_atomic_production_headers_failure() -> Result<(), String>
	let initial: HpackFixtureState = hpack_fixture::initial_encode_state()
	let receive_credit: OutboundReceiveCredit = outbound_receive_credit_with_open_stream(10, 1, 20)
	match send_headers_from_header_fields_with_state(1, production_unsupported_string_header_fields(), initial, false, empty_peer_settings(), receive_credit)?
		Ok(_) => Err("expected production HPACK HEADERS string failure")
		Err(_) => match send_headers_from_header_fields_with_state(1, production_single_method_header_fields(), initial, false, empty_peer_settings(), receive_credit)?
			Err(_) => Err("expected reusable production HPACK HEADERS state")
			Ok(retry) => match require_hpack_bytes(outbound_headers_hpack_encode_transition(retry), "82")
				Err(error) => Err(error)
				Ok(_) => require_production_hpack_state(hpack_fixture::encode_transition_state(outbound_headers_hpack_encode_transition(retry)), 1, 0)
			end
		end
	end
end

fn check_production_headers_frames(headers: HpackHeaderFields, state: HpackFixtureState, expected_payload_length: Int) -> Result<(), String>
	let result: Result<OutboundHeadersHpackTransition, HpackFixtureFailure> = send_headers_from_header_fields_with_state(1, headers, state, false, small_peer_max_frame_size_settings(2), outbound_receive_credit_with_open_stream(10, 1, 20))?
	let transition: OutboundHeadersHpackTransition = require_outbound_headers_hpack_transition(result)?
	let decision: OutboundHeadersDecision = outbound_headers_hpack_decision(transition)
	let chunk: ByteChunk = outbound_headers_chunk(decision)
	match outbound_headers_payload_length(decision) == expected_payload_length and read_byte(chunk, 3)? == 1 and read_byte(chunk, 14)? == 9
		true => Ok(())
		false => Err("unexpected production HPACK HEADERS continuation framing")
	end
end

fn check_production_peer_capacity_reduction(state: HpackFixtureState) -> Result<(), String>
	let reduced: HpackEncodeTransition = require_outbound_hpack_encode_transition(hpack_fixture::encode_header_fields_with_state(production_single_method_header_fields(), state, 0, 0))?
	let ignored_reduced_bytes: () = require_hpack_bytes(reduced, "2082")?
	match hpack_fixture::state_table_size(hpack_fixture::encode_transition_state(reduced)) == 0
		false => Err("expected production HPACK peer-capacity reduction")
		true => require_production_hpack_state(hpack_fixture::encode_transition_state(reduced), 6, 0)
	end
end

fn check_production_push_promise_frames(state: HpackFixtureState) -> Result<(), String>
	let result: Result<OutboundPushPromiseHpackTransition, HpackFixtureFailure> = send_push_promise_from_header_fields_with_state(1, 2, production_seed_header_fields(), state, small_peer_max_frame_size_settings(8), outbound_receive_credit_with_open_stream(10, 1, 20))?
	let transition: OutboundPushPromiseHpackTransition = require_outbound_push_promise_hpack_transition(result)?
	let decision: OutboundPushPromiseDecision = outbound_push_promise_hpack_decision(transition)
	let chunk: ByteChunk = outbound_push_promise_chunk(decision)
	match read_byte(chunk, 3)? == 5 and read_byte(chunk, 20)? == 9
		true => Ok(())
		false => Err("unexpected production HPACK PUSH_PROMISE continuation framing")
	end
end

fn check_production_outbound_octet_values(initial: HpackFixtureState) -> Result<(), String>
	let raw: HpackEncodeTransition = require_outbound_hpack_encode_transition(hpack_fixture::encode_header_fields_with_state(production_raw_octet_header_fields()?, initial, 4096, 0))?
	let ignored_raw: () = require_hpack_bytes(raw, "4001780200ff")?
	let raw_state: HpackFixtureState = hpack_fixture::encode_transition_state(raw)
	let ignored_raw_state: () = require_production_state_octets(raw_state, 0, "00ff")?
	let reused: HpackEncodeTransition = require_outbound_hpack_encode_transition(hpack_fixture::encode_header_fields_with_state(production_raw_octet_header_fields()?, raw_state, 4096, 0))?
	let ignored_reused: () = require_hpack_bytes(reused, "be")?

	let huffman: HpackEncodeTransition = require_outbound_hpack_encode_transition(hpack_fixture::encode_header_fields_with_state(production_huffman_octet_header_fields()?, initial, 4096, 0))?
	let ignored_huffman: () = require_hpack_bytes(huffman, "400178841cc3355f")?
	let unindexed: HpackEncodeTransition = require_outbound_hpack_encode_transition(hpack_fixture::encode_header_fields_with_state(production_unindexed_octet_header_fields()?, initial, 4096, 0))?
	let ignored_unindexed: () = require_hpack_bytes(unindexed, "0001780200ff")?
	let ignored_unindexed_state: () = require_production_hpack_state(hpack_fixture::encode_transition_state(unindexed), 1, 0)?
	let never_indexed: HpackEncodeTransition = require_outbound_hpack_encode_transition(hpack_fixture::encode_header_fields_with_state(production_never_indexed_octet_header_fields()?, initial, 4096, 0))?
	let ignored_never_indexed: () = require_hpack_bytes(never_indexed, "1001780200ff")?
	let ignored_never_indexed_state: () = require_production_hpack_state(hpack_fixture::encode_transition_state(never_indexed), 1, 0)?

	match hpack_fixture::encode_header_fields_with_state(production_invalid_octet_header_fields()?, initial, 4096, 0)
		Ok(_) => Err("expected late production outbound octet failure")
		Err(_) => match hpack_fixture::encode_header_fields_with_state(production_raw_octet_header_fields()?, initial, 4096, 0)
			Err(_) => Err("production outbound octet failure changed reusable state")
			Ok(retry) => match require_hpack_bytes(retry, "4001780200ff")
				Err(error) => Err(error)
				Ok(_) => match check_production_headers_frames(production_octet_request_header_fields()?, initial, 7)
					Err(error) => Err(error)
					Ok(_) => check_production_push_promise_frames_for_fields(production_octet_request_header_fields()?, initial)
				end
			end
		end
	end
end

fn check_production_push_promise_frames_for_fields(headers: HpackHeaderFields, state: HpackFixtureState) -> Result<(), String>
	let result: Result<OutboundPushPromiseHpackTransition, HpackFixtureFailure> = send_push_promise_from_header_fields_with_state(1, 2, headers, state, small_peer_max_frame_size_settings(8), outbound_receive_credit_with_open_stream(10, 1, 20))?
	let transition: OutboundPushPromiseHpackTransition = require_outbound_push_promise_hpack_transition(result)?
	let chunk: ByteChunk = outbound_push_promise_chunk(outbound_push_promise_hpack_decision(transition))
	match read_byte(chunk, 3)? == 5
		true => Ok(())
		false => Err("unexpected production octet HPACK PUSH_PROMISE framing")
	end
end

fn check_production_outbound_header_fields() -> Result<(), String>
	let initial: HpackFixtureState = hpack_fixture::initial_encode_state()
	let ignored_octet_values: () = check_production_outbound_octet_values(initial)?
	let seed: HpackEncodeTransition = require_outbound_hpack_encode_transition(hpack_fixture::encode_header_fields_with_state(production_seed_header_fields(), initial, 4096, 0))?
	let ignored_seed_bytes: () = require_hpack_bytes(seed, "8244856123b262a74085f2b26c190b026f6b7e841cc3355f")?
	let seed_state: HpackFixtureState = hpack_fixture::encode_transition_state(seed)
	let ignored_seed_state: () = require_production_hpack_state(seed_state, 4, 3)?

	let carried: HpackEncodeTransition = require_outbound_hpack_encode_transition(hpack_fixture::encode_header_fields_with_state(production_carried_header_fields(), seed_state, 4096, 0))?
	let ignored_carried_bytes: () = require_hpack_bytes(carried, "82c0be")?
	let ignored_carried_state: () = require_production_hpack_state(hpack_fixture::encode_transition_state(carried), 7, 3)?

	let reduced: HpackEncodeTransition = require_outbound_hpack_encode_transition(hpack_fixture::encode_table_size_update_with_state(42, 4096, initial, 0))?
	let evicted: HpackEncodeTransition = require_outbound_hpack_encode_transition(hpack_fixture::encode_header_fields_with_state(production_eviction_header_fields(), hpack_fixture::encode_transition_state(reduced), 42, 0))?
	let ignored_evicted_state: () = require_production_hpack_state(hpack_fixture::encode_transition_state(evicted), 3, 1)?

	let zero: HpackEncodeTransition = require_outbound_hpack_encode_transition(hpack_fixture::encode_table_size_update_with_state(0, 4096, seed_state, 0))?
	let zero_encoded: HpackEncodeTransition = require_outbound_hpack_encode_transition(hpack_fixture::encode_header_fields_with_state(production_single_method_header_fields(), hpack_fixture::encode_transition_state(zero), 0, 0))?
	let ignored_zero_state: () = require_production_hpack_state(hpack_fixture::encode_transition_state(zero_encoded), 6, 0)?

	let ignored_atomic_failure: () = check_atomic_production_hpack_failure()?
	let ignored_atomic_headers_failure: () = check_atomic_production_headers_failure()?
	let ignored_peer_capacity_reduction: () = check_production_peer_capacity_reduction(seed_state)?
	let ignored_request_headers_frames: () = check_production_headers_frames(production_seed_header_fields(), initial, 24)?
	let ignored_response_headers_frames: () = check_production_headers_frames(production_response_header_fields(), initial, 5)?
	check_production_push_promise_frames(initial)
end

fn require_production_inbound_field(headers: HpackProductionHeaderList, index: Int, expected_name: String, expected_value: String) -> Result<(), String>
	match hpack_fixture::production_header_list_name_at(headers, index)
		Some(name) => match hpack_fixture::production_header_list_value_at(headers, index)
			Some(value) => match name == expected_name and value == expected_value
				true => Ok(())
				false => Err("unexpected production inbound HPACK field")
			end
			None => Err("missing production inbound HPACK field value")
		end
		None => Err("missing production inbound HPACK field")
	end
end

fn require_production_inbound_octets(headers: HpackProductionHeaderList, index: Int, expected_name: String, expected_value: String) -> Result<(), String>
	match hpack_fixture::production_header_list_name_at(headers, index)
		Some(name) => match hpack_fixture::production_header_list_value_octets_at(headers, index)
			Some(value) => match name == expected_name and byte_chunks_equal(value, byte_chunk_from_hex(expected_value)?)?
				true => Ok(())
				false => Err("unexpected production inbound HPACK octets")
			end
			None => Err("missing production inbound HPACK octets")
		end
		None => Err("missing production inbound HPACK octet field")
	end
end

fn require_production_state_octets(state: HpackFixtureState, index: Int, expected_value: String) -> Result<(), String>
	match hpack_fixture::state_dynamic_header_value_octets_at(state, index)
		Some(value) => match true and byte_chunks_equal(value, byte_chunk_from_hex(expected_value)?)?
			true => Ok(())
			false => Err("production inbound HPACK state changed value octets")
		end
		None => Err("production inbound HPACK state lost value octets")
	end
end

fn require_production_inbound_transition(result: Result<HpackProductionDecodeTransition, HpackFixtureFailure>) -> Result<HpackProductionDecodeTransition, String>
	match result
		Ok(transition) => Ok(transition)
		Err(_) => Err("expected production inbound HPACK decode")
	end
end

fn require_production_inbound_failure(result: Result<HpackProductionDecodeTransition, HpackFixtureFailure>, expected_fixture: String, expected_offset: Int, expected_preview: String) -> Result<(), String>
	match result
		Ok(_) => Err("expected production inbound HPACK failure")
		Err(failure) => match hpack_fixture::hpack_failure_expected_fixture(failure) == expected_fixture and hpack_fixture::hpack_failure_offset(failure) == expected_offset and byte_chunks_equal(hpack_fixture::hpack_failure_preview(failure), byte_chunk_from_hex(expected_preview)?)?
			true => Ok(())
			false => Err("unexpected production inbound HPACK failure")
		end
	end
end

fn production_route_failure_preview(failure: Http2ProtocolFailure) -> ByteChunk
	match failure
		HeaderTableSizeExceeded(_, _, _, _, _, _, preview_chunk) => preview_chunk
		HpackFixtureDecodeFailed(_, _, _, _, _, _, _, preview_chunk) => preview_chunk
		HpackTableSizeUpdateNotAtStart(_, _, _, _, _, _, _, _, _, preview_chunk) => preview_chunk
		_ => byte_chunk([])
	end
end

fn require_production_route_failure(label: String, step: Http2Step, expected_id: String, expected_offset: Int, expected_preview: String, input_state: HpackFixtureState) -> Result<(), String>
	match step
		Failed(failed_state, failure) => match failure_id(failure) == expected_id and failure_offset(failure) == expected_offset and byte_chunks_equal(production_route_failure_preview(failure), byte_chunk_from_hex(expected_preview)?)?
			true => require_hpack_states_equal(label, state_hpack_fixture_state(failed_state), input_state)
			false => Err(label)
		end
		_ => Err(label)
	end
end

fn check_production_inbound_header_fields() -> Result<(), String>
	let initial: HpackFixtureState = hpack_fixture::initial_state()
	let mixed_block: ByteChunk = byte_chunk_from_hex("8287844001780161be")?
	let mixed: HpackProductionDecodeTransition = require_production_inbound_transition(hpack_fixture::decode_production_header_block(mixed_block, initial, 160, 0))?
	let mixed_headers: HpackProductionHeaderList = hpack_fixture::production_transition_headers(mixed)
	let ignored_shape: () = match hpack_fixture::production_header_list_count(mixed_headers) == 5 and hpack_fixture::production_header_list_wire_size(mixed_headers) == 9
		false => Err("unexpected production inbound HPACK header-list shape")?
		true => ()
	end
	let ignored_method: () = require_production_inbound_field(mixed_headers, 0, ":method", "GET")?
	let ignored_literal: () = require_production_inbound_field(mixed_headers, 3, "x", "a")?
	let ignored_dynamic: () = require_production_inbound_field(mixed_headers, 4, "x", "a")?
	let mixed_state: HpackFixtureState = hpack_fixture::production_transition_state(mixed)
	let ignored_state: () = match hpack_fixture::state_dynamic_table_entry_count(mixed_state) == 1 and hpack_fixture::state_decode_count(mixed_state) == 5
		false => Err("unexpected production inbound HPACK carried state")?
		true => ()
	end
	let resized: HpackProductionDecodeTransition = require_production_inbound_transition(hpack_fixture::decode_production_header_block(byte_chunk_from_hex("3f218287844001780161be")?, initial, 160, 0))?
	let ignored_resized: () = match hpack_fixture::state_table_size(hpack_fixture::production_transition_state(resized)) == 64 and hpack_fixture::production_header_list_wire_size(hpack_fixture::production_transition_headers(resized)) == 11
		true => ()
		false => Err("unexpected production inbound HPACK leading table-size update")?
	end
	let two_updates: HpackProductionDecodeTransition = require_production_inbound_transition(hpack_fixture::decode_production_header_block(byte_chunk_from_hex("3f213f0d82")?, initial, 160, 11))?
	let ignored_two_updates: () = match hpack_fixture::state_table_size(hpack_fixture::production_transition_state(two_updates)) == 44 and hpack_fixture::production_header_list_count(hpack_fixture::production_transition_headers(two_updates)) == 1
		true => require_production_inbound_field(hpack_fixture::production_transition_headers(two_updates), 0, ":method", "GET")?
		false => Err("unexpected production inbound HPACK two-update sequence")?
	end
	let many_updates: HpackProductionDecodeTransition = require_production_inbound_transition(hpack_fixture::decode_production_header_block(byte_chunk_from_hex("3f213f0d3e3f0182")?, initial, 160, 16))?
	let ignored_many_updates: () = match hpack_fixture::state_table_size(hpack_fixture::production_transition_state(many_updates)) == 32 and hpack_fixture::production_header_list_count(hpack_fixture::production_transition_headers(many_updates)) == 1
		true => require_production_inbound_field(hpack_fixture::production_transition_headers(many_updates), 0, ":method", "GET")?
		false => Err("unexpected production inbound HPACK general update sequence")?
	end
	let ignored_malformed_sequence: () = require_production_inbound_failure(hpack_fixture::decode_production_header_block(byte_chunk_from_hex("3f013f023f80")?, initial, 160, 40), "fixture HPACK malformed table-size update integer", 44, "3f80")?
	let ignored_excessive_sequence: () = require_production_inbound_failure(hpack_fixture::decode_production_header_block(byte_chunk_from_hex("3f013f023f820282")?, initial, 160, 60), "production inbound HPACK table-size update", 64, "3f820282")?
	let ignored_misplaced_update: () = require_production_inbound_failure(hpack_fixture::decode_production_header_block(byte_chunk_from_hex("3f013f02823e")?, initial, 160, 50), "fixture HPACK table-size update at header block start", 55, "3e")?
	let reused: HpackProductionDecodeTransition = require_production_inbound_transition(hpack_fixture::decode_production_header_block(byte_chunk_from_hex("be")?, mixed_state, 160, 9))?
	let ignored_reused: () = require_production_inbound_field(hpack_fixture::production_transition_headers(reused), 0, "x", "a")?
	let raw_octets: HpackProductionDecodeTransition = require_production_inbound_transition(hpack_fixture::decode_production_header_block(byte_chunk_from_hex("0001780200ff")?, initial, 160, 0))?
	let ignored_raw_octets: () = require_production_inbound_octets(hpack_fixture::production_transition_headers(raw_octets), 0, "x", "00ff")?
	let never_indexed_octets: HpackProductionDecodeTransition = require_production_inbound_transition(hpack_fixture::decode_production_header_block(byte_chunk_from_hex("1001780200ff")?, initial, 160, 0))?
	let ignored_never_indexed_octets: () = require_production_inbound_octets(hpack_fixture::production_transition_headers(never_indexed_octets), 0, "x", "00ff")?
	let static_name_octets: HpackProductionDecodeTransition = require_production_inbound_transition(hpack_fixture::decode_production_header_block(byte_chunk_from_hex("0f270200ff")?, initial, 160, 0))?
	let ignored_static_name_octets: () = require_production_inbound_octets(hpack_fixture::production_transition_headers(static_name_octets), 0, "server", "00ff")?
	let huffman_octets: HpackProductionDecodeTransition = require_production_inbound_transition(hpack_fixture::decode_production_header_block(byte_chunk_from_hex("40017885ffc7ffffdd")?, initial, 160, 0))?
	let huffman_octet_state: HpackFixtureState = hpack_fixture::production_transition_state(huffman_octets)
	let ignored_huffman_octets: () = require_production_inbound_octets(hpack_fixture::production_transition_headers(huffman_octets), 0, "x", "00ff")?
	let ignored_huffman_state_octets: () = require_production_state_octets(huffman_octet_state, 0, "00ff")?
	let dynamic_name_octets: HpackProductionDecodeTransition = require_production_inbound_transition(hpack_fixture::decode_production_header_block(byte_chunk_from_hex("0f2f0200ff")?, huffman_octet_state, 160, 0))?
	let ignored_dynamic_name_octets: () = require_production_inbound_octets(hpack_fixture::production_transition_headers(dynamic_name_octets), 0, "x", "00ff")?
	let reused_huffman_octets: HpackProductionDecodeTransition = require_production_inbound_transition(hpack_fixture::decode_production_header_block(byte_chunk_from_hex("be")?, huffman_octet_state, 160, 0))?
	let ignored_reused_huffman_octets: () = require_production_inbound_octets(hpack_fixture::production_transition_headers(reused_huffman_octets), 0, "x", "00ff")?
	let exact_octet_accounting: HpackProductionDecodeTransition = require_production_inbound_transition(hpack_fixture::decode_production_header_block(byte_chunk_from_hex("3f044001780200ff")?, initial, 160, 0))?
	let ignored_exact_octet_accounting: () = match hpack_fixture::state_table_size(hpack_fixture::production_transition_state(exact_octet_accounting)) == 35 and hpack_fixture::state_dynamic_table_entry_count(hpack_fixture::production_transition_state(exact_octet_accounting)) == 1
		true => require_production_state_octets(hpack_fixture::production_transition_state(exact_octet_accounting), 0, "00ff")?
		false => Err("production inbound HPACK did not account for exact octet entry size")?
	end
	let over_octet_accounting: HpackProductionDecodeTransition = require_production_inbound_transition(hpack_fixture::decode_production_header_block(byte_chunk_from_hex("3f034001780200ff")?, initial, 160, 0))?
	let ignored_over_octet_accounting: () = match hpack_fixture::state_table_size(hpack_fixture::production_transition_state(over_octet_accounting)) == 34 and hpack_fixture::state_dynamic_table_entry_count(hpack_fixture::production_transition_state(over_octet_accounting)) == 0
		true => ()
		false => Err("production inbound HPACK retained an oversized octet entry")?
	end
	let evicted: HpackProductionDecodeTransition = require_production_inbound_transition(hpack_fixture::decode_production_header_block(byte_chunk_from_hex("3f01")?, mixed_state, 160, 10))?
	let ignored_evicted: () = match hpack_fixture::state_table_size(hpack_fixture::production_transition_state(evicted)) == 32 and hpack_fixture::state_dynamic_table_entry_count(hpack_fixture::production_transition_state(evicted)) == 0
		true => ()
		false => Err("production inbound HPACK table-size update did not evict by byte size")?
	end
	let failed_block: ByteChunk = byte_chunk_from_hex("4001780161bf")?
	match hpack_fixture::decode_production_header_block(failed_block, initial, 160, 0)
		Ok(_) => Err("expected late production inbound HPACK failure")
		Err(_) => match hpack_fixture::decode_production_header_block(byte_chunk_from_hex("82")?, initial, 160, 0)
			Ok(retry) => match hpack_fixture::state_decode_count(hpack_fixture::production_transition_state(retry)) == 1 and hpack_fixture::state_dynamic_table_entry_count(hpack_fixture::production_transition_state(retry)) == 0
				true => Ok(())
				false => Err("production inbound HPACK failure committed state")
			end
			Err(_) => Err("production inbound HPACK input state was not reusable")
		end
	end
	let late_malformed_octet_block: ByteChunk = byte_chunk_from_hex("4001780200ff00017902aa")?
	match hpack_fixture::decode_production_header_block(late_malformed_octet_block, initial, 160, 0)
		Ok(_) => Err("expected late production inbound HPACK octet-value failure")
		Err(_) => match hpack_fixture::decode_production_header_block(byte_chunk_from_hex("82")?, initial, 160, 0)
			Ok(retry) => match hpack_fixture::state_decode_count(hpack_fixture::production_transition_state(retry)) == 1 and hpack_fixture::state_dynamic_table_entry_count(hpack_fixture::production_transition_state(retry)) == 0
				true => Ok(())
				false => Err("production inbound HPACK octet-value failure committed state")
			end
			Err(_) => Err("production inbound HPACK octet-value failure changed reusable input state")
		end
	end
end

fn require_production_update_route(label: String, kind: Int, block: ByteChunk) -> Result<(), String>
	match decode_completed_header_list(30, kind, 4, 1, block, hpack_fixture::initial_state())
		HeaderListDecodeOk(_, state, headers) => match hpack_fixture::state_table_size(state) == 32 and hpack_fixture::production_header_list_count(headers) == 1
			true => require_production_inbound_field(headers, 0, ":method", "GET")
			false => Err(label)
		end
		HeaderListDecodeFailed(_) => Err(label)
	end
end

fn check_production_inbound_http2_routes() -> Result<(), String>
	let request_block: ByteChunk = byte_chunk_from_hex("8287844001780161be")?
	let ignored_request: () = match decode_completed_header_list(0, 1, 4, 1, request_block, hpack_fixture::initial_state())
		HeaderListDecodeOk(size, state, headers) => match size == 9 and hpack_fixture::production_header_list_is_request(headers) and hpack_fixture::state_dynamic_table_entry_count(state) == 1
			true => ()
			false => Err("unexpected production inbound request HEADERS decode")?
		end
		HeaderListDecodeFailed(_) => Err("expected production inbound request HEADERS decode")?
	end
	let raw_octet_request: ByteChunk = byte_chunk_from_hex("8287840001780200ff")?
	let ignored_raw_octet_headers: () = match decode_completed_header_list(0, 1, 4, 1, raw_octet_request, hpack_fixture::initial_state())
		HeaderListDecodeOk(_, _, headers) => require_production_inbound_octets(headers, 3, "x", "00ff")?
		HeaderListDecodeFailed(_) => Err("production raw octets did not route through HEADERS")?
	end
	let huffman_octet_request: ByteChunk = byte_chunk_from_hex("82878440017885ffc7ffffdd")?
	let huffman_octet_request_state: HpackFixtureState = match decode_completed_header_list(0, 1, 4, 1, huffman_octet_request, hpack_fixture::initial_state())
		HeaderListDecodeOk(_, next_state, headers) => match require_production_inbound_octets(headers, 3, "x", "00ff")
			Ok(_) => next_state
			Err(message) => Err(message)?
		end
		HeaderListDecodeFailed(_) => Err("production Huffman octets did not route through HEADERS")?
	end
	let ignored_huffman_octet_reuse: () = match decode_completed_header_list(0, 1, 4, 3, byte_chunk_from_hex("828784be")?, huffman_octet_request_state)
		HeaderListDecodeOk(_, _, headers) => require_production_inbound_octets(headers, 3, "x", "00ff")?
		HeaderListDecodeFailed(_) => Err("production Huffman octets did not survive dynamic-indexed reuse")?
	end
	let octet_continuation_start: Http2Step = receive(InputChunk(byte_chunk_from_hex("0000050100000000018287840001")?), frame_state())?
	let octet_continuation_done: Http2Step = receive(InputChunk(byte_chunk_from_hex("000004090400000001780200ff")?), step_state(octet_continuation_start))?
	let ignored_octet_continuation: () = match decode_completed_header_list(9, 9, 4, 1, step_completed_header_block(octet_continuation_done), hpack_fixture::initial_state())
		HeaderListDecodeOk(_, _, headers) => require_production_inbound_octets(headers, 3, "x", "00ff")?
		HeaderListDecodeFailed(_) => Err("production raw octets did not route through final CONTINUATION")?
	end
	let invalid_huffman_after_octet_insert: Http2Step = receive(InputChunk(byte_chunk_from_hex("00000e0104000000018287844001780200ff00017981ff")?), frame_state())?
	let ignored_invalid_huffman_atomicity: () = match invalid_huffman_after_octet_insert
		Failed(failed_state, _) => require_hpack_states_equal("production invalid Huffman value committed an earlier octet insertion", state_hpack_fixture_state(failed_state), hpack_fixture::initial_state())?
		_ => Err("production invalid Huffman value was accepted")?
	end
	let octet_header_list_too_large: Http2Step = receive(InputChunk(byte_chunk_from_hex("00000e0104000000018287844001780761626364656667")?), frame_state())?
	let ignored_octet_header_list_limit: () = require_failure_with_id("production octet header-list limit was not enforced", octet_header_list_too_large, "http2.peer_limit.header_list_size_exceeded")?
	let ignored_octet_header_list_atomicity: () = match octet_header_list_too_large
		Failed(failed_state, _) => require_hpack_states_equal("production octet header-list limit committed an indexed value", state_hpack_fixture_state(failed_state), hpack_fixture::initial_state())?
		_ => Err("production octet header-list limit did not fail")?
	end
	let non_ascii_scheme: Http2Step = receive(InputChunk(byte_chunk_from_hex("00000d0104000000018240073a736368656d65010084")?), frame_state())?
	let ignored_non_ascii_scheme_fact: () = require_request_header_failure_detail("production non-ASCII scheme bypassed value validation", non_ascii_scheme, "scheme_value_not_http_or_https", ":scheme", "rfc9113_request_scheme")?
	let ignored_non_ascii_scheme_atomicity: () = match non_ascii_scheme
		Failed(failed_state, _) => require_hpack_states_equal("production non-ASCII scheme validation committed an indexed value", state_hpack_fixture_state(failed_state), hpack_fixture::initial_state())?
		_ => Err("production non-ASCII scheme validation did not fail")?
	end
	let general_updates: ByteChunk = byte_chunk_from_hex("3f213f0d3e3f0182")?
	let ignored_general_headers: () = require_production_update_route("production update sequence did not reach HEADERS", 1, general_updates)?
	let ignored_general_push_promise: () = require_production_update_route("production update sequence did not reach PUSH_PROMISE", 5, general_updates)?
	let continuation_start: Http2Step = receive(InputChunk(byte_chunk_from_hex("0000050100000000018287844001")?), frame_state())?
	let continuation_done: Http2Step = receive(InputChunk(byte_chunk_from_hex("000004090400000001780161be")?), step_state(continuation_start))?
	let ignored_continuation_frame: () = match continuation_done
		FrameDecoded(_, _, _, _, _, _, _, _) => ()
		Waiting(_) => Err("production inbound CONTINUATION remained incomplete")?
		Failed(_, failure) => Err(failure_id(failure))?
	end
	let ignored_continuation: () = match byte_count_to_int(byte_chunk_count(step_completed_header_block(continuation_done))) == 9 and hpack_fixture::state_dynamic_table_entry_count(state_hpack_fixture_state(step_state(continuation_done))) == 1
		true => ()
		false => Err("unexpected production inbound CONTINUATION assembly")?
	end
	let response_continuation_start: Http2Step = receive(InputChunk(byte_chunk_from_hex("00000101000000000188")?), frame_state())?
	let response_continuation_done: Http2Step = receive(InputChunk(byte_chunk_from_hex("0000010904000000019f")?), step_state(response_continuation_start))?
	let ignored_response_continuation: () = match response_continuation_done
		FrameDecoded(_, _, _, _, _, _, _, _) => match decode_completed_header_list(9, 9, 4, 1, step_completed_header_block(response_continuation_done), hpack_fixture::initial_state())
			HeaderListDecodeOk(_, _, headers) => match byte_count_to_int(byte_chunk_count(step_completed_header_block(response_continuation_done))) == 2 and hpack_fixture::production_header_list_count(headers) == 2
				true => require_production_inbound_field(headers, 1, "content-type", "")?
				false => Err("production response CONTINUATION did not decode every field")?
			end
			HeaderListDecodeFailed(_) => Err("production response CONTINUATION did not expose its decoded fields")?
		end
		Waiting(_) => Err("production response CONTINUATION remained incomplete")?
		Failed(_, failure) => Err(failure_id(failure))?
	end
	let update_continuation_start: Http2Step = receive(InputChunk(byte_chunk_from_hex("0000040100000000013f213f0d")?), frame_state())?
	let update_continuation_done: Http2Step = receive(InputChunk(byte_chunk_from_hex("0000060904000000013e3f01828784")?), step_state(update_continuation_start))?
	let ignored_update_continuation: () = match update_continuation_done
		FrameDecoded(_, _, _, _, _, _, _, _) => match hpack_fixture::state_table_size(state_hpack_fixture_state(step_state(update_continuation_done))) == 32
			true => ()
			false => Err("production update sequence lost final CONTINUATION capacity")?
		end
		Waiting(_) => Err("production update sequence CONTINUATION remained incomplete")?
		Failed(_, failure) => Err(failure_id(failure))?
	end
	let excessive_updates: Http2Step = receive(InputChunk(byte_chunk_from_hex("0000080104000000013f013f023f820282")?), frame_state())?
	let ignored_excessive_updates: () = require_production_route_failure("production late update limit failure", excessive_updates, "http2.peer_limit.header_table_size_exceeded", 4, "3f820282", hpack_fixture::initial_state())?
	let malformed_updates: Http2Step = receive(InputChunk(byte_chunk_from_hex("0000060104000000013f013f023f80")?), frame_state())?
	let ignored_malformed_updates: () = require_production_route_failure("production late update malformed failure", malformed_updates, "hpack.fixture.table_size_update_malformed", 4, "3f80", hpack_fixture::initial_state())?
	let misplaced_update: Http2Step = receive(InputChunk(byte_chunk_from_hex("0000060104000000013f013f02823e")?), frame_state())?
	let ignored_misplaced_update: () = require_production_route_failure("production post-field update failure", misplaced_update, "hpack.fixture.table_size_update_not_at_start", 5, "3e", hpack_fixture::initial_state())?
	let push_malformed_updates: Http2Step = receive(InputChunk(byte_chunk_from_hex("00000a050400000001000000023f013f023f80")?), client_push_receive_state(65535, 1, 65535))?
	let ignored_push_malformed_updates: () = require_production_route_failure("production PUSH_PROMISE late update malformed failure", push_malformed_updates, "hpack.fixture.table_size_update_malformed", 4, "3f80", hpack_fixture::initial_state())?
	let excessive_continuation_start: Http2Step = receive(InputChunk(byte_chunk_from_hex("0000040100000000013f013f02")?), frame_state())?
	let excessive_continuation_done: Http2Step = receive(InputChunk(byte_chunk_from_hex("0000040904000000013f820282")?), step_state(excessive_continuation_start))?
	let ignored_excessive_continuation: () = require_production_route_failure("production final CONTINUATION late update limit failure", excessive_continuation_done, "http2.peer_limit.header_table_size_exceeded", 17, "3f820282", hpack_fixture::initial_state())?
	let ignored_initial_reuse: () = match hpack_fixture::decode_production_header_block(byte_chunk_from_hex("82")?, hpack_fixture::initial_state(), 160, 0)
		Ok(retry) => match hpack_fixture::state_decode_count(hpack_fixture::production_transition_state(retry)) == 1
			true => ()
			false => Err("production update failure changed reusable input state")?
