	match state
		State(_, _, _, _, _, _, PeerSettings(NoPeerMaxFrameSize, _, _, _, _, _, _), _, _) => 0
		State(_, _, _, _, _, _, PeerSettings(PeerMaxFrameSize(_, item_offset), _, _, _, _, _, _), _, _) => item_offset
	end
end

