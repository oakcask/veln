	match state
		State(_, _, _, _, _, _, PeerSettings(_, _, NoPeerEnablePush, _, _, _, _), _, _, _) => 0
		State(_, _, _, _, _, _, PeerSettings(_, _, PeerEnablePush(_, item_offset), _, _, _, _), _, _, _) => item_offset
		State(_, _, _, _, _, _, PeerSettings(_, _, PeerEnableConnectProtocol(_, _), _, _, _, _), _, _, _) => 0
		State(_, _, _, _, _, _, PeerSettings(_, _, PeerEnablePushAndConnectProtocol(_, item_offset, _, _), _, _, _, _), _, _, _) => item_offset
	end
end

