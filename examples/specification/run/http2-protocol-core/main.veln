fn require_request_header_failure_fact(label: String, step: Http2Step, expected_fact: String) -> Result<(), String>
	match step
		FrameDecoded(_, _, _, _, _, _, _, _) => Err(label)
		Waiting(_) => Err(label)
		Failed(_, failure) => match failure
			InvalidRequestHeaderList(_, _, _, failed_header_fact, _, _, _) => match failed_header_fact == expected_fact
				true => Ok(())
				false => Err(label)
			end
			_ => Err(label)
		end
	end
end

fn require_response_header_failure_fact(label: String, step: Http2Step, expected_fact: String) -> Result<(), String>
	match step
		FrameDecoded(_, _, _, _, _, _, _, _) => Err(label)
		Waiting(_) => Err(label)
		Failed(_, failure) => match failure
			InvalidResponseHeaderList(_, _, _, failed_header_fact, _, _, _, _) => match failed_header_fact == expected_fact
				true => Ok(())
				false => Err(label)
			end
			_ => Err(label)
		end
	end
end

fn require_hpack_states_equal(label: String, left: HpackFixtureState, right: HpackFixtureState) -> Result<(), String>
	match hpack_fixture::state_table_size(left) == hpack_fixture::state_table_size(right) and hpack_fixture::state_decode_count(left) == hpack_fixture::state_decode_count(right) and hpack_fixture::state_dynamic_table_entry_count(left) == hpack_fixture::state_dynamic_table_entry_count(right)
		false => Err(label)
		true => match hpack_fixture::state_dynamic_header_name_at(left, 0)
			Some(left_name) => match hpack_fixture::state_dynamic_header_name_at(right, 0)
				Some(right_name) => match hpack_fixture::state_dynamic_header_value_octets_at(left, 0)
					Some(left_value) => match hpack_fixture::state_dynamic_header_value_octets_at(right, 0)
						Some(right_value) => match left_name == right_name and byte_chunks_equal(left_value, right_value)?
							true => Ok(())
							false => Err(label)
						end
						None => Err(label)
					end
					None => Err(label)
				end
				None => Err(label)
			end
			None => match hpack_fixture::state_dynamic_header_name_at(right, 0)
				None => Ok(())
				Some(_) => Err(label)
			end
		end
	end
end

fn require_request_header_failure_detail(label: String, step: Http2Step, expected_fact: String, expected_header_name: String, expected_rule: String) -> Result<(), String>
	match step
		FrameDecoded(_, _, _, _, _, _, _, _) => Err(label)
		Waiting(_) => Err(label)
		Failed(_, failure) => match failure
			InvalidRequestHeaderList(_, _, _, failed_header_fact, header_name, _, _) => match failed_header_fact == expected_fact and header_name == expected_header_name and request_header_rule_provenance(failed_header_fact) == expected_rule
				true => Ok(())
				false => Err(label)
			end
			_ => Err(label)
		end
	end
end

fn require_outbound_settings_accepted(label: String, decision: OutboundSettingsDecision, expected_identifier: Int, expected_value: Int) -> Result<(), String>
	match decision
		OutboundSettingsAccepted(identifier, value, _, chunk) => match identifier == expected_identifier and value == expected_value and byte_count_to_int(byte_chunk_count(chunk)) == 15
			true => Ok(())
			false => Err(label)
		end
		OutboundSettingsRejected(_) => Err(label)
		OutboundSettingsEncodeFailed(_) => Err(label)
	end
end

fn require_outbound_settings_rejected_for_role(label: String, decision: OutboundSettingsDecision, expected_role: String) -> Result<(), String>
	match decision
		OutboundSettingsAccepted(_, _, _, _) => Err(label)
		OutboundSettingsEncodeFailed(_) => Err(label)
		OutboundSettingsRejected(failure) => match failure
			SettingsNotAllowedForEndpoint(_, 8, "SETTINGS_ENABLE_CONNECT_PROTOCOL", endpoint_role, _, _, _, _) => match endpoint_role == expected_role
				true => Ok(())
				false => Err(label)
			end
			_ => Err(label)
		end
	end
end

fn require_extended_connect_negotiation_cases() -> Result<(), String>
	let server_setting: OutboundSettingsDecision = send_local_enable_connect_protocol_setting(1, ServerEndpoint, connection_state(frame_state()))?
	let ignored_server_setting: () = require_outbound_settings_accepted("server extended CONNECT setting was not accepted", server_setting, 8, 1)?
	let negotiated_state: Http2DecodeState = connection_decode_state(outbound_settings_connection(server_setting))
	let accepted: Http2Step = receive(InputChunk(byte_chunk_from_hex("000003010400000001767778")?), negotiated_state)?
	let ignored_accepted: () = require_frame_decoded("negotiated extended CONNECT was rejected", accepted)?
	let continuation_start: Http2Step = receive(InputChunk(byte_chunk_from_hex("00000101000000000176")?), negotiated_state)?
	let continuation_done: Http2Step = receive(InputChunk(byte_chunk_from_hex("0000020904000000017778")?), step_state(continuation_start))?
	let ignored_continuation: () = require_frame_decoded("negotiated extended CONNECT continuation was rejected", continuation_done)?
	let unnegotiated: Http2Step = receive(InputChunk(byte_chunk_from_hex("000003010400000001767778")?), frame_state())?
	let ignored_unnegotiated: () = require_request_header_failure_detail("unnegotiated extended CONNECT was accepted", unnegotiated, "extended_connect_not_negotiated", ":protocol", "rfc8441_extended_connect_negotiation")?
	let ignored_unnegotiated_atomicity: () = require_peer_stream_failure_preserves_connection_state("unnegotiated extended CONNECT changed connection state", frame_state(), step_state(unnegotiated))?
	let unnegotiated_continuation_start: Http2Step = receive(InputChunk(byte_chunk_from_hex("00000101000000000176")?), frame_state())?
	let unnegotiated_continuation_done: Http2Step = receive(InputChunk(byte_chunk_from_hex("0000020904000000017778")?), step_state(unnegotiated_continuation_start))?
	let ignored_unnegotiated_continuation: () = require_request_header_failure_detail("unnegotiated extended CONNECT continuation was accepted", unnegotiated_continuation_done, "extended_connect_not_negotiated", ":protocol", "rfc8441_extended_connect_negotiation")?
	let ignored_unnegotiated_continuation_atomicity: () = require_peer_stream_failure_preserves_connection_state("unnegotiated extended CONNECT continuation changed connection state", step_state(unnegotiated_continuation_start), step_state(unnegotiated_continuation_done))?
	let setting_ack: Http2ConnectionStep = receive_connection(InputChunk(byte_chunk_from_hex("000000040100000000")?), outbound_settings_connection(server_setting))?
	let ignored_setting_ack: () = require_frame_decoded("extended CONNECT setting ACK was rejected", connection_step_decode_step(setting_ack))?
	let accepted_after_ack: Http2Step = receive(InputChunk(byte_chunk_from_hex("000003010400000001767778")?), connection_decode_state(connection_step_state(setting_ack)))?
	let ignored_accepted_after_ack: () = require_frame_decoded("extended CONNECT capability was lost after SETTINGS ACK", accepted_after_ack)?
	let disabled_setting: OutboundSettingsDecision = send_local_enable_connect_protocol_setting(0, ServerEndpoint, connection_state(frame_state()))?
	let disabled_request: Http2Step = receive(InputChunk(byte_chunk_from_hex("000003010400000001767778")?), connection_decode_state(outbound_settings_connection(disabled_setting)))?
	let ignored_disabled_request: () = require_request_header_failure_fact("disabled extended CONNECT setting allowed a request", disabled_request, "extended_connect_not_negotiated")?
	let ordered_items: List<OutboundLocalSettingsItem> = Cons(OutboundSettingsMaxFrameSize(32768), Cons(OutboundSettingsEnableConnectProtocol(1), Cons(OutboundSettingsMaxHeaderListSize(8192), Nil)))
	let ordered_setting: OutboundSettingsDecision = send_local_settings_batch_for_role(ordered_items, ServerEndpoint, connection_state(frame_state()))?
	let ordered_request: Http2Step = receive(InputChunk(byte_chunk_from_hex("000003010400000001767778")?), connection_decode_state(outbound_settings_connection(ordered_setting)))?
	let ignored_ordered_request: () = require_frame_decoded("ordered local setting batch lost extended CONNECT capability", ordered_request)?
	let empty_protocol: Http2Step = receive(InputChunk(byte_chunk_from_hex("00000401040000000176777879")?), negotiated_state)?
	let ignored_empty_protocol: () = require_request_header_failure_fact("empty extended CONNECT protocol was accepted", empty_protocol, "protocol_value_empty")?
	let duplicate_protocol: Http2Step = receive(InputChunk(byte_chunk_from_hex("000005010400000001767778797a")?), negotiated_state)?
	let ignored_duplicate_protocol: () = require_request_header_failure_fact("duplicate extended CONNECT protocol was accepted", duplicate_protocol, "duplicate_protocol_pseudo_header")?
	let missing_scheme: Http2Step = receive(InputChunk(byte_chunk_from_hex("000006010400000001767778797a7b")?), negotiated_state)?
	let ignored_missing_scheme: () = require_request_header_failure_fact("extended CONNECT without scheme was accepted", missing_scheme, "extended_connect_scheme_missing")?
	let missing_path: Http2Step = receive(InputChunk(byte_chunk_from_hex("000007010400000001767778797a7b7c")?), negotiated_state)?
	let ignored_missing_path: () = require_request_header_failure_fact("extended CONNECT without path was accepted", missing_path, "extended_connect_path_missing")?
	let missing_authority: Http2Step = receive(InputChunk(byte_chunk_from_hex("000008010400000001767778797a7b7c7d")?), negotiated_state)?
	let ignored_missing_authority: () = require_request_header_failure_fact("extended CONNECT without authority was accepted", missing_authority, "extended_connect_authority_missing")?
	let non_connect_protocol: Http2Step = receive(InputChunk(byte_chunk_from_hex("000009010400000001767778797a7b7c7d7e")?), negotiated_state)?
	let ignored_non_connect: () = require_request_header_failure_fact(":protocol on non-CONNECT was accepted", non_connect_protocol, "protocol_on_non_connect_request")?
	let ordinary_connect: Http2Step = receive(InputChunk(byte_chunk_from_hex("000003010400000001656667")?), frame_state())?
	let ignored_ordinary_connect: () = require_frame_decoded("ordinary CONNECT changed under extended negotiation", ordinary_connect)?
	let client_received_setting: Http2Step = receive_client(InputChunk(byte_chunk_from_hex("000006040000000000000800000001")?), frame_state())?
	let ignored_client_received_setting: () = require_frame_decoded("client rejected server extended CONNECT setting", client_received_setting)?
	let ignored_peer_setting_value: () = require_equal_int("client did not retain peer extended CONNECT setting value", peer_enable_connect_protocol_value(state_peer_settings(step_state(client_received_setting))), 1)?
	let ignored_peer_setting_offset: () = require_equal_int("client did not retain peer extended CONNECT setting offset", peer_enable_connect_protocol_offset(state_peer_settings(step_state(client_received_setting))), 9)?
	let server_received_setting: Http2Step = receive(InputChunk(byte_chunk_from_hex("000006040000000000000800000001")?), frame_state())?
	let ignored_server_received_setting: () = require_failure_with_id("server accepted client extended CONNECT setting", server_received_setting, "http2.protocol.settings_not_allowed_for_endpoint")?
	let invalid_received_setting: Http2Step = receive_client(InputChunk(byte_chunk_from_hex("000006040000000000000800000002")?), frame_state())?
	let ignored_invalid_received_setting: () = require_failure_with_id("client accepted invalid extended CONNECT setting value", invalid_received_setting, "http2.peer_limit.settings_value_out_of_range")?
	let invalid_local_setting: OutboundSettingsDecision = send_local_enable_connect_protocol_setting(2, ServerEndpoint, connection_state(frame_state()))?
	let invalid_local_setting_check: Result<(), String> = match invalid_local_setting
		OutboundSettingsRejected(SettingsValueOutOfRange(_, 8, "SETTINGS_ENABLE_CONNECT_PROTOCOL", 2, 0, 1, _, _)) => Ok(())
		_ => Err("server accepted invalid local extended CONNECT setting value")
	end
	let ignored_invalid_local_setting: () = invalid_local_setting_check?
	let ignored_invalid_local_setting_bytes: () = require_equal_int("invalid local extended CONNECT setting emitted bytes", byte_count_to_int(byte_chunk_count(outbound_settings_chunk(invalid_local_setting))), 0)?
	let client_local_setting: OutboundSettingsDecision = send_local_enable_connect_protocol_setting(1, ClientEndpoint, connection_state(frame_state()))?
	let ignored_client_local_setting: () = require_outbound_settings_rejected_for_role("client advertised extended CONNECT setting", client_local_setting, "client")?
	require_equal_int("client extended CONNECT setting rejection emitted bytes", byte_count_to_int(byte_chunk_count(outbound_settings_chunk(client_local_setting))), 0)
end

fn require_hpack_static_request_scheme_validation(state: Http2DecodeState) -> Result<(), String>
	let scheme_http: Http2Step = receive(InputChunk(byte_chunk_from_hex("0000080104000000018206046874747084")?), state)?
	let ignored_scheme_http: () = require_frame_decoded("hpack-static-request-scheme-http", scheme_http)?
	let scheme_https: Http2Step = receive(InputChunk(byte_chunk_from_hex("000009010400000001820605687474707384")?), state)?
	let ignored_scheme_https: () = require_frame_decoded("hpack-static-request-scheme-https", scheme_https)?
	let scheme_indexed_https: Http2Step = receive(InputChunk(byte_chunk_from_hex("000009010400000001824605687474707384")?), state)?
	let ignored_scheme_indexed_https: () = require_frame_decoded("hpack-static-request-scheme-indexed-https", scheme_indexed_https)?
	let scheme_never_indexed_http: Http2Step = receive(InputChunk(byte_chunk_from_hex("0000080104000000018216046874747084")?), state)?
	let ignored_scheme_never_indexed_http: () = require_frame_decoded("hpack-static-request-scheme-never-indexed-http", scheme_never_indexed_http)?
	let scheme_invalid: Http2Step = receive(InputChunk(byte_chunk_from_hex("00000701040000000182060366747084")?), state)?
	let ignored_scheme_invalid: () = require_request_header_failure_detail("hpack-static-request-scheme-invalid", scheme_invalid, "scheme_value_not_http_or_https", ":scheme", "rfc9113_request_scheme")?
	let scheme_indexed_invalid: Http2Step = receive(InputChunk(byte_chunk_from_hex("00000701040000000182460366747084")?), state)?
	let ignored_scheme_indexed_invalid: () = require_request_header_failure_detail("hpack-static-request-scheme-indexed-invalid", scheme_indexed_invalid, "scheme_value_not_http_or_https", ":scheme", "rfc9113_request_scheme")?
	let scheme_never_indexed_invalid: Http2Step = receive(InputChunk(byte_chunk_from_hex("00000701040000000182160366747084")?), state)?
	let ignored_scheme_never_indexed_invalid: () = require_request_header_failure_detail("hpack-static-request-scheme-never-indexed-invalid", scheme_never_indexed_invalid, "scheme_value_not_http_or_https", ":scheme", "rfc9113_request_scheme")?
	let scheme_continuation_start: Http2Step = receive(InputChunk(byte_chunk_from_hex("00000401000000000182060366")?), state)?
	let scheme_continuation_done: Http2Step = receive(InputChunk(byte_chunk_from_hex("000003090400000001747084")?), step_state(scheme_continuation_start))?
	let ignored_scheme_continuation_invalid: () = require_request_header_failure_detail("hpack-static-request-scheme-continuation-invalid", scheme_continuation_done, "scheme_value_not_http_or_https", ":scheme", "rfc9113_request_scheme")?
	let scheme_continuation_accepted_start: Http2Step = receive(InputChunk(byte_chunk_from_hex("0000050100000000018206056874")?), state)?
	let scheme_continuation_accepted_done: Http2Step = receive(InputChunk(byte_chunk_from_hex("00000409040000000174707384")?), step_state(scheme_continuation_accepted_start))?
	require_frame_decoded("hpack-static-request-scheme-continuation-https", scheme_continuation_accepted_done)
end

fn require_hpack_static_request_authority_validation(state: Http2DecodeState) -> Result<(), String>
	let authority_accepted: Http2Step = receive(InputChunk(byte_chunk_from_hex("00000d010400000001828701086162632e7465737484")?), state)?
	let ignored_authority_accepted: () = require_frame_decoded("hpack-static-request-authority-accepted", authority_accepted)?
	let authority_indexed_accepted: Http2Step = receive(InputChunk(byte_chunk_from_hex("00000d010400000001828741086162632e7465737484")?), state)?
	let ignored_authority_indexed_accepted: () = require_frame_decoded("hpack-static-request-authority-indexed-accepted", authority_indexed_accepted)?
	let authority_never_indexed_accepted: Http2Step = receive(InputChunk(byte_chunk_from_hex("00000d010400000001828711086162632e7465737484")?), state)?
	let ignored_authority_never_indexed_accepted: () = require_frame_decoded("hpack-static-request-authority-never-indexed-accepted", authority_never_indexed_accepted)?
	let authority_invalid: Http2Step = receive(InputChunk(byte_chunk_from_hex("000009010400000001828701046261644084")?), state)?
	let ignored_authority_invalid: () = require_request_header_failure_detail("hpack-static-request-authority-invalid", authority_invalid, "authority_value_invalid", ":authority", "rfc9113_request_authority")?
	let authority_indexed_invalid: Http2Step = receive(InputChunk(byte_chunk_from_hex("000009010400000001828741046261644084")?), state)?
	let ignored_authority_indexed_invalid: () = require_request_header_failure_detail("hpack-static-request-authority-indexed-invalid", authority_indexed_invalid, "authority_value_invalid", ":authority", "rfc9113_request_authority")?
	let authority_never_indexed_invalid: Http2Step = receive(InputChunk(byte_chunk_from_hex("000009010400000001828711046261644084")?), state)?
	let ignored_authority_never_indexed_invalid: () = require_request_header_failure_detail("hpack-static-request-authority-never-indexed-invalid", authority_never_indexed_invalid, "authority_value_invalid", ":authority", "rfc9113_request_authority")?
	let authority_continuation_start: Http2Step = receive(InputChunk(byte_chunk_from_hex("000006010000000001828701046261")?), state)?
	let authority_continuation_done: Http2Step = receive(InputChunk(byte_chunk_from_hex("000003090400000001644084")?), step_state(authority_continuation_start))?
	let ignored_authority_continuation_invalid: () = require_request_header_failure_detail("hpack-static-request-authority-continuation-invalid", authority_continuation_done, "authority_value_invalid", ":authority", "rfc9113_request_authority")?
	let authority_continuation_accepted_start: Http2Step = receive(InputChunk(byte_chunk_from_hex("000006010000000001828701086162")?), state)?
	let authority_continuation_accepted_done: Http2Step = receive(InputChunk(byte_chunk_from_hex("000007090400000001632e7465737484")?), step_state(authority_continuation_accepted_start))?
	require_frame_decoded("hpack-static-request-authority-continuation-accepted", authority_continuation_accepted_done)
end

fn require_production_request_content_length_validation(state: Http2DecodeState) -> Result<(), String>
	let production_single: Http2Step = receive(InputChunk(byte_chunk_from_hex("0000040104000000016768696a")?), state)?
	let ignored_production_single_decoded: () = require_frame_decoded("production-single", production_single)?
	let production_repeated: Http2Step = receive(InputChunk(byte_chunk_from_hex("00000401040000000168696a6b")?), state)?
	let ignored_production_repeated_decoded: () = require_frame_decoded("production-repeated", production_repeated)?
	let production_mismatch: Http2Step = receive(InputChunk(byte_chunk_from_hex("000004010400000001696a6b6c")?), state)?
	let ignored_production_mismatch: () = require_request_header_failure_fact("production-mismatch", production_mismatch, "content_length_mismatch")?
	let production_empty: Http2Step = receive(InputChunk(byte_chunk_from_hex("0000040104000000016a6b6c6d")?), state)?
	let ignored_production_empty: () = require_request_header_failure_fact("production-empty", production_empty, "content_length_invalid")?
	let production_non_decimal: Http2Step = receive(InputChunk(byte_chunk_from_hex("0000040104000000016b6c6d6e")?), state)?
	let ignored_production_non_decimal: () = require_request_header_failure_fact("production-non-decimal", production_non_decimal, "content_length_invalid")?
	let production_sign: Http2Step = receive(InputChunk(byte_chunk_from_hex("0000040104000000016c6d6e6f")?), state)?
	let ignored_production_sign: () = require_request_header_failure_fact("production-sign", production_sign, "content_length_invalid")?
	let production_whitespace: Http2Step = receive(InputChunk(byte_chunk_from_hex("0000040104000000016d6e6f70")?), state)?
	let ignored_production_whitespace: () = require_request_header_failure_fact("production-whitespace", production_whitespace, "content_length_invalid")?
	let production_negative: Http2Step = receive(InputChunk(byte_chunk_from_hex("0000040104000000016e6f7071")?), state)?
	let ignored_production_negative: () = require_request_header_failure_fact("production-negative", production_negative, "content_length_invalid")?
	let production_continuation_start: Http2Step = receive(InputChunk(byte_chunk_from_hex("0000020100000000016768")?), state)?
	let production_continuation_done: Http2Step = receive(InputChunk(byte_chunk_from_hex("000002090400000001696a")?), step_state(production_continuation_start))?
	let ignored_production_continuation_decoded: () = require_frame_decoded("production-continuation", production_continuation_done)?
	let production_continuation_mismatch_start: Http2Step = receive(InputChunk(byte_chunk_from_hex("000002010000000001696a")?), state)?
	let production_continuation_mismatch_done: Http2Step = receive(InputChunk(byte_chunk_from_hex("0000020904000000016b6c")?), step_state(production_continuation_mismatch_start))?
	require_request_header_failure_fact("production-continuation-mismatch", production_continuation_mismatch_done, "content_length_mismatch")
end

fn require_hpack_fixture_failure(step: Http2Step) -> Result<(), String>
	match step
		FrameDecoded(_, _, _, _, _, _, _, _) => Err("expected HTTP/2 HPACK fixture failure")
		Waiting(_) => Err("expected HTTP/2 HPACK fixture failure")
		Failed(_, failure) => match failure_id(failure) == "hpack.fixture.unsupported_header_block" or failure_id(failure) == "hpack.fixture.unsupported_static_index" or failure_id(failure) == "hpack.fixture.malformed_string_length" or failure_id(failure) == "hpack.fixture.malformed_raw_string_value" or failure_id(failure) == "hpack.fixture.malformed_huffman_padding" or failure_id(failure) == "hpack.fixture.huffman_eos_symbol" or failure_id(failure) == "hpack.fixture.huffman_non_visible_value" or failure_id(failure) == "hpack.fixture.dynamic_index_out_of_range" or failure_id(failure) == "hpack.fixture.dynamic_name_continuation_missing" or failure_id(failure) == "hpack.fixture.dynamic_name_continuation_malformed" or failure_id(failure) == "hpack.fixture.dynamic_name_continuation_out_of_range" or failure_id(failure) == "hpack.fixture.table_size_update_not_at_start" or failure_id(failure) == "hpack.fixture.table_size_update_trailing_bytes" or failure_id(failure) == "hpack.fixture.table_size_update_malformed"
			true => Ok(())
			false => Err("expected HTTP/2 HPACK fixture failure")
		end
	end
end

fn project_hpack_fixture_decode_failure(failure: Http2ProtocolFailure) -> Result<(), String>
	match failure
		HpackFixtureDecodeFailed(offset, observed_size, observed_first_byte, requested_dynamic_index, dynamic_table_entry_count, expected_fixture, codec_module, preview_chunk) => match hpack_fixture_failure_id(expected_fixture) == "hpack.fixture.dynamic_name_continuation_missing"
			true => accept_runtime_diagnostic(hpack_fixture_dynamic_name_continuation_missing(offset, observed_size, observed_first_byte, requested_dynamic_index, dynamic_table_entry_count, expected_fixture, codec_module, byte_view(preview_chunk, byte_offset(0)?, byte_chunk_count(preview_chunk))?))
			false => match hpack_fixture_failure_id(expected_fixture) == "hpack.fixture.dynamic_index_out_of_range"
				true => accept_runtime_diagnostic(hpack_fixture_dynamic_index_out_of_range(offset, observed_size, observed_first_byte, requested_dynamic_index, dynamic_table_entry_count, expected_fixture, codec_module, byte_view(preview_chunk, byte_offset(0)?, byte_chunk_count(preview_chunk))?))
				false => match hpack_fixture_failure_id(expected_fixture) == "hpack.fixture.dynamic_name_continuation_malformed"
						true => accept_runtime_diagnostic(hpack_fixture_dynamic_name_continuation_malformed(offset, observed_size, observed_first_byte, requested_dynamic_index, dynamic_table_entry_count, expected_fixture, codec_module, byte_view(preview_chunk, byte_offset(0)?, byte_chunk_count(preview_chunk))?))
						false => match hpack_fixture_failure_id(expected_fixture) == "hpack.fixture.dynamic_name_continuation_out_of_range"
							true => accept_runtime_diagnostic(hpack_fixture_dynamic_name_continuation_out_of_range(offset, observed_size, observed_first_byte, requested_dynamic_index, dynamic_table_entry_count, expected_fixture, codec_module, byte_view(preview_chunk, byte_offset(0)?, byte_chunk_count(preview_chunk))?))
							false => match hpack_fixture_failure_id(expected_fixture) == "hpack.fixture.malformed_huffman_padding"
								true => accept_runtime_diagnostic(hpack_fixture_malformed_huffman_padding(offset, observed_size, observed_first_byte, expected_fixture, codec_module, byte_view(preview_chunk, byte_offset(0)?, byte_chunk_count(preview_chunk))?))
								false => match hpack_fixture_failure_id(expected_fixture) == "hpack.fixture.huffman_eos_symbol"
									true => accept_runtime_diagnostic(hpack_fixture_huffman_eos_symbol(offset, observed_size, observed_first_byte, expected_fixture, codec_module, byte_view(preview_chunk, byte_offset(0)?, byte_chunk_count(preview_chunk))?))
									false => match hpack_fixture_failure_id(expected_fixture) == "hpack.fixture.huffman_non_visible_value"
										true => accept_runtime_diagnostic(hpack_fixture_huffman_non_visible_value(offset, observed_size, observed_first_byte, expected_fixture, codec_module, byte_view(preview_chunk, byte_offset(0)?, byte_chunk_count(preview_chunk))?))
										false => Err("expected projected HPACK dynamic fixture failure")
									end
								end
							end
						end
					end
				end
			end
		_ => Err("expected projected HPACK fixture failure")
	end
end

fn require_projected_hpack_fixture_failure(step: Http2Step) -> Result<(), String>
	let ignored_failure: () = require_hpack_fixture_failure(step)?
	project_hpack_fixture_decode_failure(step_failure(step))
end

fn require_hpack_dynamic_core_index_failure(step: Http2Step, requested_dynamic_index: Int, dynamic_table_entry_count: Int) -> Result<(), String>
	match step
		FrameDecoded(_, _, _, _, _, _, _, _) => Err("expected source-visible HPACK dynamic-core failure")
		Waiting(_) => Err("expected source-visible HPACK dynamic-core failure")
		Failed(_, failure) => match failure
			HpackFixtureDecodeFailed(_, _, _, requested, entry_count, expected_fixture, codec_module, _) => match requested == requested_dynamic_index and entry_count == dynamic_table_entry_count and expected_fixture == "source-visible dynamic indexed header" and codec_module == "hpack_dynamic_core"
				true => Ok(())
				false => Err("unexpected source-visible HPACK dynamic-core failure")
			end
			_ => Err("expected source-visible HPACK dynamic-core failure")
		end
	end
end

fn continue_http2_deep_dynamic_path_state(inserted: Http2Step, state: Http2DecodeState, remaining: Int) -> Result<Http2DecodeState, String>
	let ignored_inserted: () = require_hpack_transition_header(inserted, state, ":path", "/a")?
	build_http2_deep_dynamic_path_state(remaining - 1, hpack_carry_only_state(step_state(inserted)))
end

fn build_http2_deep_dynamic_path_state(remaining: Int, state: Http2DecodeState) -> Result<Http2DecodeState, String>
	match remaining
		0 => Ok(state)
		_ => continue_http2_deep_dynamic_path_state(receive(InputChunk(byte_chunk_from_hex("00000401040000000144022f61")?), state)?, state, remaining)
	end
end

fn print_hpack_wide_dynamic_name_cases() -> Result<(), String> effects [stdio]
	let deep_state: Http2DecodeState = build_http2_deep_dynamic_path_state(66, frame_state())?
	let retained_older: Http2Step = receive(InputChunk(byte_chunk_from_hex("000001010400000001ff")?), deep_state)?
	print_step("hpack-stateful-dynamic-name-wide-retained-older-path", retained_older)
	print_hpack_transition_from_state("hpack-stateful-dynamic-name-wide-retained-older-path", retained_older, deep_state)
	let ignored_retained_older: () = require_hpack_transition_header(retained_older, deep_state, ":path", "/a")?
	let retained_older_continuation: Http2Step = receive(InputChunk(byte_chunk_from_hex("000002010400000001ff00")?), deep_state)?
	print_step("hpack-stateful-dynamic-indexed-wide-continuation-retained-older-path", retained_older_continuation)
	let ignored_retained_older_continuation_chunk: () = emit_header_block("http2-hpack-stateful-dynamic-indexed-wide-continuation-retained-older-path", retained_older_continuation, "ff00")?
	print_hpack_transition_from_state("hpack-stateful-dynamic-indexed-wide-continuation-retained-older-path", retained_older_continuation, deep_state)
	let ignored_retained_older_continuation: () = require_hpack_transition_header(retained_older_continuation, deep_state, ":path", "/a")?
	let retained_older_multi_continuation: Http2Step = receive(InputChunk(byte_chunk_from_hex("000003010400000001ff8000")?), deep_state)?
	print_step("hpack-stateful-dynamic-indexed-multi-continuation-retained-older-path", retained_older_multi_continuation)
	let ignored_retained_older_multi_continuation_chunk: () = emit_header_block("http2-hpack-stateful-dynamic-indexed-multi-continuation-retained-older-path", retained_older_multi_continuation, "ff8000")?
	print_hpack_transition_from_state("hpack-stateful-dynamic-indexed-multi-continuation-retained-older-path", retained_older_multi_continuation, deep_state)
	let ignored_retained_older_multi_continuation: () = require_hpack_transition_header(retained_older_multi_continuation, deep_state, ":path", "/a")?
	let multi_continuation_out_of_range: Http2Step = receive(InputChunk(byte_chunk_from_hex("000003010400000001ff8001")?), deep_state)?
	print_failure("hpack-stateful-dynamic-indexed-multi-continuation-out-of-range", multi_continuation_out_of_range)
	let ignored_multi_continuation_out_of_range: () = require_hpack_dynamic_core_index_failure(multi_continuation_out_of_range, 193, 66)?
	let literal_indexed_wide: Http2Step = receive(InputChunk(byte_chunk_from_hex("0000080104000000037f40052f64656570")?), deep_state)?
	print_step("hpack-stateful-dynamic-name-wide-indexed", literal_indexed_wide)
	let ignored_literal_indexed_wide: () = emit_header_block("http2-hpack-stateful-dynamic-name-wide-indexed", literal_indexed_wide, "7f40052f64656570")?
	print_hpack_transition_from_state("hpack-stateful-dynamic-name-wide-indexed", literal_indexed_wide, deep_state)
	let ignored_literal_indexed_wide_header: () = require_hpack_transition_header(literal_indexed_wide, deep_state, ":path", "/deep")?
	let literal_indexed_wide_state: Http2DecodeState = hpack_carry_only_state(step_state(literal_indexed_wide))
	let dynamic_newest: Http2Step = receive(InputChunk(byte_chunk_from_hex("000001010400000005be")?), literal_indexed_wide_state)?
	print_step("hpack-stateful-dynamic-name-wide-newest", dynamic_newest)
	print_hpack_transition_from_state("hpack-stateful-dynamic-name-wide-newest", dynamic_newest, literal_indexed_wide_state)
	let ignored_dynamic_newest: () = require_hpack_transition_header(dynamic_newest, literal_indexed_wide_state, ":path", "/deep")?
	let literal_without_indexing_wide: Http2Step = receive(InputChunk(byte_chunk_from_hex("0000080104000000050f70052f736b6970")?), deep_state)?
	print_step("hpack-stateful-dynamic-name-wide-without-indexing", literal_without_indexing_wide)
	let ignored_literal_without_indexing_wide: () = emit_header_block("http2-hpack-stateful-dynamic-name-wide-without-indexing", literal_without_indexing_wide, "0f70052f736b6970")?
