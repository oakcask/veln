	print_peer_settings("enable-push-settings-ack", step_state(enable_push_settings_ack))
	let peer_max_concurrent_streams: Http2Step = receive(InputChunk(byte_chunk_from_hex("000006040000000000000300000002")?), frame_state())?
	print_step("peer-max-concurrent-streams", peer_max_concurrent_streams)
