fn print_peer_stream_id_monotonicity_cases() -> Result<(), String>
	let increasing_one: Http2Step = receive(InputChunk(byte_chunk_from_hex("000000010400000001")?), frame_state())?
	let increasing_three: Http2Step = receive(InputChunk(byte_chunk_from_hex("000000010400000003")?), step_state(increasing_one))?
	let increasing_five: Http2Step = receive(InputChunk(byte_chunk_from_hex("000000010400000005")?), step_state(increasing_three))?
	print_step("peer-stream-id-increasing-one", increasing_one)
	print_step("peer-stream-id-increasing-three", increasing_three)
	print_step("peer-stream-id-increasing-five", increasing_five)
	print_peer_stream_admission_state("peer-stream-id-increasing", step_state(increasing_five))

	let higher_five: Http2Step = receive(InputChunk(byte_chunk_from_hex("000000010400000005")?), frame_state())?
	let lower_three: Http2Step = receive(InputChunk(byte_chunk_from_hex("000000010400000003")?), step_state(higher_five))?
	print_stream_id_failure("peer-stream-id-lower", lower_three)
	print_peer_stream_admission_state("peer-stream-id-lower-preserved", step_state(lower_three))

	let closed_five: Http2Step = receive(InputChunk(byte_chunk_from_hex("000000010500000005")?), frame_state())?
	let lower_after_closed: Http2Step = receive(InputChunk(byte_chunk_from_hex("000000010400000003")?), step_state(closed_five))?
	print_stream_id_failure("peer-stream-id-lower-after-closed", lower_after_closed)
	print_peer_stream_admission_state("peer-stream-id-lower-after-closed-preserved", step_state(lower_after_closed))

	let open_five: Http2Step = receive(InputChunk(byte_chunk_from_hex("000000010400000005")?), frame_state())?
	let reset_five: Http2Step = receive(InputChunk(byte_chunk_from_hex("00000403000000000500000008")?), step_state(open_five))?
	let lower_after_reset: Http2Step = receive(InputChunk(byte_chunk_from_hex("000000010400000003")?), step_state(reset_five))?
	print_stream_id_failure("peer-stream-id-lower-after-reset", lower_after_reset)
	print_peer_stream_admission_state("peer-stream-id-lower-after-reset-preserved", step_state(lower_after_reset))

	let reuse_one: Http2Step = receive(InputChunk(byte_chunk_from_hex("000000010400000001")?), frame_state())?
	let reuse_three: Http2Step = receive(InputChunk(byte_chunk_from_hex("000000010400000003")?), step_state(reuse_one))?
	let reuse_five: Http2Step = receive(InputChunk(byte_chunk_from_hex("000000010400000005")?), step_state(reuse_three))?
	let reset_one: Http2Step = receive(InputChunk(byte_chunk_from_hex("00000403000000000100000008")?), step_state(reuse_five))?
	let reused_three: Http2Step = receive(InputChunk(byte_chunk_from_hex("000000010400000003")?), step_state(reset_one))?
	print_stream_id_failure("peer-stream-id-reused", reused_three)
	print_peer_stream_admission_state("peer-stream-id-reused-preserved", step_state(reused_three))
	Ok(())
end

fn verify_flow_control_domain_cases() -> Result<(), String>
	let accepted_connection: () = match connection_window_credit(0)
		Ok(_) => ()
		Err(_) => Err("expected zero connection window credit to be accepted")?
	end
	let rejected_connection: () = match connection_window_credit(-1)
		Ok(_) => Err("expected negative connection window credit to be rejected")?
		Err(_) => ()
	end
	let accepted_negative_stream: () = match stream_window_credit(-1)
		Ok(_) => ()
		Err(_) => Err("expected negative stream window credit to be accepted")?
	end
	let rejected_stream: () = match stream_window_credit(-2147483648)
		Ok(_) => Err("expected stream window credit below the lower bound to be rejected")?
		Err(_) => ()
	end
	let accepted_initial_size: () = match initial_window_size(max_flow_control_value())
		Ok(_) => ()
		Err(_) => Err("expected maximum initial window size to be accepted")?
	end
	let rejected_initial_size: () = match initial_window_size(2147483648)
		Ok(_) => Err("expected oversized initial window size to be rejected")?
		Err(_) => ()
	end
	let accepted_increment: () = match window_update_increment_value(1)
		Ok(_) => ()
		Err(_) => Err("expected minimum window update increment to be accepted")?
	end
	let rejected_increment: () = match window_update_increment_value(0)
		Ok(_) => Err("expected zero window update increment to be rejected")?
		Err(_) => ()
	end
	Ok(())
end

pub fn main() -> Result<(), String> effects [stdio]
	let verified_production_inbound_header_fields: () = check_production_inbound_header_fields()?
	let verified_production_inbound_http2_routes: () = check_production_inbound_http2_routes()?
	let ignored_extended_connect_negotiation_cases: () = require_extended_connect_negotiation_cases()?
	let verified_flow_control_domains: () = verify_flow_control_domain_cases()?
	let verified_outbound_multi_stream_flow_control: () = verify_outbound_multi_stream_flow_control()?
	let preface_valid: Http2Step = receive(InputChunk(byte_chunk_from_hex("505249202a20485454502f322e300d0a0d0a534d0d0a0d0a000000040000000000")?), empty_state())?
	print_step("preface-valid", preface_valid)
	let preface_unknown: Http2Step = receive(InputChunk(byte_chunk_from_hex("505249202a20485454502f322e300d0a0d0a534d0d0a0d0a0000030a2300000000aabbcc")?), empty_state())?
	let preface_unknown_result: () = print_unknown_frame("preface-unknown", preface_unknown)?
