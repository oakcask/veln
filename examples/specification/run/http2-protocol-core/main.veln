fn outbound_send_credit_update_status(decision: OutboundSendCreditUpdateDecision) -> String
	match decision
		OutboundSendCreditUpdated(_) => "updated"
		OutboundSendCreditUnchanged(_) => "unchanged"
		OutboundSendCreditUpdateRejected(_) => "rejected"
	end
end

fn outbound_send_credit_update_reason(decision: OutboundSendCreditUpdateDecision) -> String
	match decision
		OutboundSendCreditUpdated(_) => "none"
		OutboundSendCreditUnchanged(_) => "not_window_update"
		OutboundSendCreditUpdateRejected(error) => failure_rule_provenance(error)
	end
end

fn outbound_send_credit_update_connection_window(decision: OutboundSendCreditUpdateDecision) -> Int
	match decision
		OutboundSendCreditUpdated(send_credit) => outbound_send_connection_window(send_credit)
		OutboundSendCreditUnchanged(send_credit) => outbound_send_connection_window(send_credit)
		OutboundSendCreditUpdateRejected(_) => 0
	end
end

fn outbound_send_credit_update_open_stream(decision: OutboundSendCreditUpdateDecision) -> Int
	match decision
		OutboundSendCreditUpdated(send_credit) => outbound_send_open_stream_id(send_credit)
		OutboundSendCreditUnchanged(send_credit) => outbound_send_open_stream_id(send_credit)
		OutboundSendCreditUpdateRejected(_) => 0
	end
end

fn outbound_send_credit_update_stream_window(decision: OutboundSendCreditUpdateDecision) -> Int
	match decision
		OutboundSendCreditUpdated(send_credit) => outbound_send_stream_window(send_credit)
		OutboundSendCreditUnchanged(send_credit) => outbound_send_stream_window(send_credit)
		OutboundSendCreditUpdateRejected(_) => 0
	end
end

fn outbound_send_credit_update_active_state(decision: OutboundSendCreditUpdateDecision) -> String
	match decision
		OutboundSendCreditUpdated(_) => "none"
		OutboundSendCreditUnchanged(_) => "none"
		OutboundSendCreditUpdateRejected(error) => failure_active_state(error)
	end
end

fn outbound_send_credit_update_credit(decision: OutboundSendCreditUpdateDecision) -> OutboundSendCredit
	match decision
		OutboundSendCreditUpdated(send_credit) => send_credit
		OutboundSendCreditUnchanged(send_credit) => send_credit
		OutboundSendCreditUpdateRejected(_) => outbound_send_credit_without_stream(0)
	end
end

