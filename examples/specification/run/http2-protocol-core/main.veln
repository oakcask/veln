		Ok(transition) => print_checked_outbound_hpack_encode_transition(label, transition, expected_hex)
		Err(_) => Err("expected outbound HPACK fixture header-list encoding")
	end
end

fn print_outbound_hpack_encode_expected_failure(label: String, result: Result<HpackEncodeTransition, HpackFixtureFailure>) -> Result<(), String> effects [stdio]
