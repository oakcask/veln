# A pure HTTP/2 core consumes frame headers from explicit input events and emits encoded headers.
use hpack_fixture
use hpack_static
use hpack_dynamic_core
use stream_domain
use stdio

schema Http2FrameHeaderWire
	format binary

	length: UInt24be
	kind: UInt8
	flags: UInt8
	stream_reserved: ReservedBits(1, 0)
	stream_id: UInt31be
end

fn decode_http2_frame_header(view: ByteView, base_offset: ByteOffset) -> Result<{length: Int, kind: Int, flags: Int, stream_id: Int}, String>
	match decode Http2FrameHeaderWire from view at base_offset
		Decoded(header, _) => Ok(header)
		NeedMore(_) => Err("unexpected incomplete HTTP/2 frame header")
		Invalid(_) => Err("unexpected invalid HTTP/2 frame header")
	end
end

schema Http2RstStreamPayloadWire
	format binary

	error_code: UInt32be
end

schema Http2WindowUpdatePayloadWire
	format binary

	increment_reserved: ReservedBits(1, 0)
	increment: UInt31be
end

schema Http2GoawayPayloadWire
	format binary

	last_stream_reserved: ReservedBits(1, 0)
	last_stream_id: UInt31be
	error_code: UInt32be
end

schema Http2PriorityDependencyPayloadWire
	format binary

	dependency_reserved: ReservedBits(1, 0)
	dependency_stream_id: UInt31be
end

schema Http2PriorityWeightPayloadWire
	format binary

	weight: UInt8
end

schema Http2PushPromisePayloadWire
	format binary

	promised_stream_reserved: ReservedBits(1, 0)
	promised_stream_id: UInt31be
end

