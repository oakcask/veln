fn encode_local_max_header_list_size_intent(value: Int, decode_state: Http2DecodeState, outstanding_settings: OutstandingLocalSettings, pending_ack: PendingPeerSettingsAck) -> Result<OutboundSettingsDecision, String>
	let payload: ByteChunk = byte_append(byte_write_u16_be(6)?, byte_write_u32_be(value)?)
	let encoded_header: Result<ByteChunk, EncodeError> = encode_frame_header({length: 6, kind: 4, flags: 0, stream_id: 0})
	match encoded_header
		Ok(header) => Ok(OutboundSettingsAccepted(6, value, ConnectionState(decode_state, add_outstanding_settings(outstanding_settings, 6, 1), pending_ack), byte_append(header, payload)))
		Err(error) => Ok(OutboundSettingsEncodeFailed(error))
	end
