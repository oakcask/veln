fn outbound_goaway_reason(decision: OutboundGoawayDecision) -> String
	match decision
		OutboundGoawayAccepted(_, _, _, _) => "none"
		OutboundGoawayEncodeFailed(_, _, error) => encode_error_id(error)
	end
end

fn outbound_goaway_last_stream_id(decision: OutboundGoawayDecision) -> Int
	match decision
		OutboundGoawayAccepted(last_stream_id, _, _, _) => last_stream_id
		OutboundGoawayEncodeFailed(last_stream_id, _, _) => last_stream_id
	end
end

fn outbound_goaway_error_code(decision: OutboundGoawayDecision) -> Int
	match decision
		OutboundGoawayAccepted(_, error_code, _, _) => error_code
		OutboundGoawayEncodeFailed(_, error_code, _) => error_code
	end
end

fn outbound_goaway_state(decision: OutboundGoawayDecision) -> Http2DecodeState
	match decision
		OutboundGoawayAccepted(_, _, state, _) => state
		OutboundGoawayEncodeFailed(_, _, _) => frame_state()
	end
end

fn outbound_goaway_shutdown_label(decision: OutboundGoawayDecision) -> String
	match decision
		OutboundGoawayAccepted(_, _, state, _) => state_shutdown_label(state)
		OutboundGoawayEncodeFailed(_, _, _) => "none"
	end
end

fn outbound_goaway_chunk(decision: OutboundGoawayDecision) -> ByteChunk
	match decision
		OutboundGoawayAccepted(_, _, _, chunk) => chunk
		OutboundGoawayEncodeFailed(_, _, _) => byte_chunk([])
	end
end

fn outbound_goaway_encode_path(decision: OutboundGoawayDecision) -> String
	match decision
		OutboundGoawayAccepted(_, _, _, _) => "none"
		OutboundGoawayEncodeFailed(_, _, error) => encode_error_path(error)
	end
end

fn outbound_goaway_encode_detail(decision: OutboundGoawayDecision) -> String
	match decision
		OutboundGoawayAccepted(_, _, _, _) => "none"
		OutboundGoawayEncodeFailed(_, _, error) => encode_error_reason(error)
	end
end

fn outbound_ping_ack_status(decision: OutboundPingAckDecision) -> String
	match decision
		OutboundPingAckAccepted(_) => "accepted"
		OutboundPingAckNoResponse => "no_response"
		OutboundPingAckEncodeFailed(_) => "encode_error"
	end
end

fn outbound_ping_ack_reason(decision: OutboundPingAckDecision) -> String
	match decision
		OutboundPingAckAccepted(_) => "none"
		OutboundPingAckNoResponse => "ack_received"
		OutboundPingAckEncodeFailed(error) => encode_error_id(error)
	end
end

fn outbound_ping_ack_chunk(decision: OutboundPingAckDecision) -> ByteChunk
	match decision
		OutboundPingAckAccepted(chunk) => chunk
		OutboundPingAckNoResponse => byte_chunk([])
		OutboundPingAckEncodeFailed(_) => byte_chunk([])
	end
end

fn outbound_ping_ack_encode_path(decision: OutboundPingAckDecision) -> String
	match decision
		OutboundPingAckAccepted(_) => "none"
		OutboundPingAckNoResponse => "none"
		OutboundPingAckEncodeFailed(error) => encode_error_path(error)
	end
end

fn outbound_ping_ack_encode_detail(decision: OutboundPingAckDecision) -> String
	match decision
		OutboundPingAckAccepted(_) => "none"
		OutboundPingAckNoResponse => "none"
		OutboundPingAckEncodeFailed(error) => encode_error_reason(error)
	end
end

fn outbound_settings_status(decision: OutboundSettingsDecision) -> String
	match decision
		OutboundSettingsAccepted(_, _, _, _) => "accepted"
		OutboundSettingsRejected(_) => "rejected"
		OutboundSettingsEncodeFailed(_) => "encode_error"
	end
end

fn outbound_settings_identifier(decision: OutboundSettingsDecision) -> Int
	match decision
		OutboundSettingsAccepted(identifier, _, _, _) => identifier
		OutboundSettingsRejected(failure) => failure_setting_identifier(failure)
		OutboundSettingsEncodeFailed(_) => 0
	end
end

fn outbound_settings_value(decision: OutboundSettingsDecision) -> Int
	match decision
		OutboundSettingsAccepted(_, value, _, _) => value
		OutboundSettingsRejected(failure) => failure_observed_value(failure)
		OutboundSettingsEncodeFailed(_) => 0
	end
end

fn outbound_settings_connection(decision: OutboundSettingsDecision) -> Http2ConnectionState
	match decision
		OutboundSettingsAccepted(_, _, connection, _) => connection
		OutboundSettingsRejected(_) => connection_state(frame_state())
		OutboundSettingsEncodeFailed(_) => connection_state(frame_state())
	end
end

fn outbound_settings_chunk(decision: OutboundSettingsDecision) -> ByteChunk
	match decision
		OutboundSettingsAccepted(_, _, _, chunk) => chunk
		OutboundSettingsRejected(_) => byte_chunk([])
		OutboundSettingsEncodeFailed(_) => byte_chunk([])
	end
end

fn outbound_settings_failure(decision: OutboundSettingsDecision) -> Http2ProtocolFailure
	match decision
		OutboundSettingsAccepted(_, _, _, _) => ClosedWithPending(0, 0, byte_chunk([]))
		OutboundSettingsRejected(failure) => failure
		OutboundSettingsEncodeFailed(_) => ClosedWithPending(0, 0, byte_chunk([]))
	end
end

fn outbound_receive_reset_stream_id(receive_credit: OutboundReceiveCredit) -> Int
	match receive_credit
		OutboundReceiveCredit(_, NoOutboundReceiveCreditStream) => 0
		OutboundReceiveCredit(_, OutboundReceiveCreditOpenStream(_, _)) => 0
		OutboundReceiveCredit(_, OutboundReceiveCreditClosedStream(_)) => 0
		OutboundReceiveCredit(_, OutboundReceiveCreditResetStream(stream_id, _)) => stream_id
	end
end

fn failure_id(failure: Http2ProtocolFailure) -> String
	match failure
		ClosedWithPending(_, _, _) => "http2.protocol.closed_with_pending"
		ClosedWithPartialPreface(_, _) => "http2.protocol.partial_preface"
		InvalidPreface(_, _, _, _) => "http2.protocol.invalid_preface"
		ContinuationExpected(offset, actual_kind, actual_stream, expected_stream, started_kind, started_offset, preview_chunk) => "http2.protocol.continuation_expected"
		InvalidFrameKind(offset, actual_kind, stream_id, expected_kind, active_state, rule_provenance) => "http2.protocol.invalid_frame_kind"
			InvalidStreamId(offset, frame_kind, stream_id, required_domain, endpoint_role, active_state, rule_provenance) => "http2.protocol.invalid_stream_id"
			InvalidPayloadLength(offset, frame_kind, stream_id, observed_length, expected_length, active_state, rule_provenance, preview) => "http2.protocol.invalid_payload_length"
			InvalidWindowUpdateIncrement(offset, stream_id, observed_increment, accepted_min_increment, accepted_max_increment, active_state, rule_provenance, preview) => "http2.protocol.invalid_window_update_increment"
			InvalidDataPadding(offset, stream_id, pad_length, remaining_payload_length, active_state, rule_provenance, preview) => "http2.protocol.invalid_data_padding"
			ContentLengthMismatch(offset, frame_kind, stream_id, expected_length, observed_length, active_state, rule_provenance, preview) => "http2.protocol.content_length_mismatch"
			InvalidRequestHeaderList(offset, frame_kind, stream_id, failed_header_fact, header_name, decoded_header_names, preview_chunk) => "http2.protocol.invalid_request_header_list"
			InvalidResponseHeaderList(offset, frame_kind, stream_id, failed_header_fact, header_name, decoded_header_names, active_state, preview_chunk) => "http2.protocol.invalid_response_header_list"
			UnexpectedSettingsAck(_, _, _, _) => "http2.protocol.unexpected_settings_ack"
		InvalidPriorityDependency(offset, stream_id, dependency_stream_id, active_state, rule_provenance, preview) => "http2.protocol.invalid_priority_dependency"
		StreamAfterGoaway(offset, stream_id, last_stream_id, shutdown_state, endpoint_role, rule_provenance, preview_chunk) => "http2.protocol.stream_after_goaway"
		FrameSizeExceeded(offset, observed_length, receive_limit, frame_kind, stream_id) => "http2.peer_limit.frame_size_exceeded"
		FlowControlWindowExceeded(offset, frame_kind, stream_id, observed_length, allowed_window_credit, active_state, rule_provenance, preview_chunk) => "http2.peer_limit.flow_control_window_exceeded"
		ConcurrentStreamsExceeded(offset, stream_id, attempted_count, allowed_count, endpoint_role, active_state, receive_limit_provenance, rule_provenance, preview_chunk) => "http2.peer_limit.concurrent_streams_exceeded"
		HeaderListSizeExceeded(offset, observed_size, receive_limit, frame_kind, stream_id, rule_provenance, preview_chunk) => "http2.peer_limit.header_list_size_exceeded"
		HeaderTableSizeExceeded(offset, observed_size, receive_limit, frame_kind, stream_id, rule_provenance, preview_chunk) => "http2.peer_limit.header_table_size_exceeded"
		SettingsValueOutOfRange(offset, setting_identifier, setting_name, observed_value, accepted_min_value, accepted_max_value, peer_limit_provenance, preview) => "http2.peer_limit.settings_value_out_of_range"
		HpackFixtureDecodeFailed(offset, observed_size, observed_first_byte, requested_dynamic_index, dynamic_table_entry_count, expected_fixture, codec_module, preview_chunk) => match expected_fixture == "HPACK static indexed header" and codec_module == "hpack_static"
			true => "hpack.static.unsupported_index"
			false => hpack_fixture_failure_id(expected_fixture)
		end
		HpackTableSizeUpdateNotAtStart(offset, observed_size, observed_first_byte, observed_update_size, frame_kind, stream_id, active_state, expected_fixture, codec_module, preview_chunk) => match expected_fixture == "fixture HPACK table-size update without trailing bytes"
			true => "hpack.fixture.table_size_update_trailing_bytes"
			false => "hpack.fixture.table_size_update_not_at_start"
		end
	end
end

fn hpack_fixture_failure_id(expected_fixture: String) -> String
	match expected_fixture
		"fixture HPACK string length" => "hpack.fixture.malformed_string_length"
		"fixture HPACK static indexed header" => "hpack.fixture.unsupported_static_index"
		"fixture HPACK raw string value" => "hpack.fixture.malformed_raw_string_value"
		"fixture HPACK Huffman padding" => "hpack.fixture.malformed_huffman_padding"
		"fixture HPACK Huffman data symbol instead of EOS" => "hpack.fixture.huffman_eos_symbol"
		"fixture HPACK Huffman checked header value" => "hpack.fixture.huffman_non_visible_value"
		"fixture HPACK table-size update at header block start" => "hpack.fixture.table_size_update_not_at_start"
		"fixture HPACK malformed table-size update integer" => "hpack.fixture.table_size_update_malformed"
		"fixture HPACK table-size update without trailing bytes" => "hpack.fixture.table_size_update_trailing_bytes"
		"fixture dynamic indexed header" => "hpack.fixture.dynamic_index_out_of_range"
		"fixture dynamic-name continuation entry" => "hpack.fixture.dynamic_name_continuation_missing"
		"fixture dynamic-name continuation integer" => "hpack.fixture.dynamic_name_continuation_malformed"
		"fixture dynamic-name continuation range" => "hpack.fixture.dynamic_name_continuation_out_of_range"
		_ => "hpack.fixture.unsupported_header_block"
	end
end

fn failure_offset(failure: Http2ProtocolFailure) -> Int
	match failure
		ClosedWithPending(offset, _, _) => offset
		ClosedWithPartialPreface(offset, _) => offset
		InvalidPreface(offset, _, _, _) => offset
		ContinuationExpected(offset, actual_kind, actual_stream, expected_stream, started_kind, started_offset, preview_chunk) => offset
		InvalidFrameKind(offset, actual_kind, stream_id, expected_kind, active_state, rule_provenance) => offset
		InvalidStreamId(offset, frame_kind, stream_id, required_domain, endpoint_role, active_state, rule_provenance) => offset
		InvalidPayloadLength(offset, frame_kind, stream_id, observed_length, expected_length, active_state, rule_provenance, preview) => offset
		InvalidWindowUpdateIncrement(offset, stream_id, observed_increment, accepted_min_increment, accepted_max_increment, active_state, rule_provenance, preview) => offset
		InvalidDataPadding(offset, stream_id, pad_length, remaining_payload_length, active_state, rule_provenance, preview) => offset
		ContentLengthMismatch(offset, frame_kind, stream_id, expected_length, observed_length, active_state, rule_provenance, preview) => offset
		InvalidRequestHeaderList(offset, frame_kind, stream_id, failed_header_fact, header_name, decoded_header_names, preview_chunk) => offset
		InvalidResponseHeaderList(offset, frame_kind, stream_id, failed_header_fact, header_name, decoded_header_names, active_state, preview_chunk) => offset
		UnexpectedSettingsAck(offset, _, _, _) => offset
		InvalidPriorityDependency(offset, stream_id, dependency_stream_id, active_state, rule_provenance, preview) => offset
		StreamAfterGoaway(offset, stream_id, last_stream_id, shutdown_state, endpoint_role, rule_provenance, preview_chunk) => offset
		FrameSizeExceeded(offset, observed_length, receive_limit, frame_kind, stream_id) => offset
		FlowControlWindowExceeded(offset, frame_kind, stream_id, observed_length, allowed_window_credit, active_state, rule_provenance, preview_chunk) => offset
		ConcurrentStreamsExceeded(offset, stream_id, attempted_count, allowed_count, endpoint_role, active_state, receive_limit_provenance, rule_provenance, preview_chunk) => offset
		HeaderListSizeExceeded(offset, observed_size, receive_limit, frame_kind, stream_id, rule_provenance, preview_chunk) => offset
		HeaderTableSizeExceeded(offset, observed_size, receive_limit, frame_kind, stream_id, rule_provenance, preview_chunk) => offset
		SettingsValueOutOfRange(offset, setting_identifier, setting_name, observed_value, accepted_min_value, accepted_max_value, peer_limit_provenance, preview) => offset
		HpackFixtureDecodeFailed(offset, observed_size, observed_first_byte, requested_dynamic_index, dynamic_table_entry_count, expected_fixture, codec_module, preview_chunk) => offset
		HpackTableSizeUpdateNotAtStart(offset, observed_size, observed_first_byte, observed_update_size, frame_kind, stream_id, active_state, expected_fixture, codec_module, preview_chunk) => offset
	end
end

