fn context_expected_stream(failure: Http2ProtocolFailure, state: Http2DecodeState) -> Int
	match failure_expected_stream(failure)
		0 => state_continuation_stream(state)
		_ => failure_expected_stream(failure)
	end
end

fn context_expected_kind(failure: Http2ProtocolFailure, state: Http2DecodeState) -> Int
	match failure_expected_kind(failure)
		0 => match state_continuation_label(state) == "active"
			true => 9
			false => 0
		end
		_ => failure_expected_kind(failure)
	end
end

fn context_started_kind(failure: Http2ProtocolFailure, state: Http2DecodeState) -> Int
	match failure_started_kind(failure)
		0 => state_continuation_started_kind(state)
		_ => failure_started_kind(failure)
	end
end

fn context_started_offset(failure: Http2ProtocolFailure, state: Http2DecodeState) -> Int
	match failure_started_offset(failure)
		0 => state_continuation_started_offset(state)
		_ => failure_started_offset(failure)
	end
end

fn context_active_state(failure: Http2ProtocolFailure, state: Http2DecodeState) -> String
	match failure_active_state(failure)
		"none" => match state_continuation_label(state) == "active"
			true => "headers"
			false => "none"
		end
		_ => failure_active_state(failure)
	end
end

fn context_rule_provenance(failure: Http2ProtocolFailure, state: Http2DecodeState) -> String
	match failure_rule_provenance(failure)
		"none" => match state_continuation_label(state) == "active"
			true => "rfc9113_continuation_sequence"
			false => "none"
		end
		_ => failure_rule_provenance(failure)
	end
end

fn diagnostic_context_state(context: Http2DiagnosticContext) -> Http2DecodeState
	match context
		DiagnosticContext(state) => state
	end
end

fn diagnostic_context_pending_view(context: Http2DiagnosticContext) -> Result<ByteView, String>
	let pending: ByteChunk = state_pending_chunk(diagnostic_context_state(context))
	byte_chunk_view(pending)
end

fn byte_chunk_view(bytes: ByteChunk) -> Result<ByteView, String>
	byte_view(bytes, byte_offset(0)?, byte_chunk_count(bytes))
end

fn closed_runtime_payload(offset: Int, pending_count: Int, active_continuation: String, preview_chunk: ByteChunk) -> RuntimeDiagnostic
	RuntimeDiagnostic(
		"http2.protocol.closed_with_pending",
		"HTTP/2 input ended with pending bytes",
		RuntimeHttp2ProtocolClosedWithPendingDiagnostic(offset, pending_count, active_continuation, preview_chunk)
	)
end

fn continuation_runtime_payload(offset: Int, actual_kind: Int, actual_stream: Int, expected_stream: Int, started_kind: Int, started_offset: Int, active_continuation: String, preview_chunk: ByteChunk) -> RuntimeDiagnostic
	RuntimeDiagnostic(
		"http2.protocol.continuation_expected",
		"HTTP/2 expected CONTINUATION frame",
		RuntimeHttp2ProtocolContinuationExpectedDiagnostic(offset, actual_kind, actual_stream, expected_stream, started_kind, started_offset, active_continuation, preview_chunk)
	)
end

fn flow_control_window_runtime_payload(offset: Int, observed_length: Int, allowed_window_credit: Int, frame_kind: Int, stream_id: Int, active_state: String, rule_provenance: String, preview_chunk: ByteChunk) -> RuntimeDiagnostic
	RuntimeDiagnostic(
		"http2.peer_limit.flow_control_window_exceeded",
		"HTTP/2 flow-control window exceeded at byte offset 0",
		RuntimeHttp2PeerLimitFlowControlWindowDiagnostic(offset, observed_length, allowed_window_credit, frame_kind, stream_id, active_state, rule_provenance, preview_chunk)
	)
end

fn invalid_data_padding_runtime_payload(offset: Int, stream_id: Int, pad_length: Int, remaining_payload_length: Int, active_state: String, rule_provenance: String, preview_chunk: ByteChunk) -> RuntimeDiagnostic
	RuntimeDiagnostic(
		"http2.protocol.invalid_data_padding",
		"HTTP/2 invalid DATA padding at byte offset 9",
		RuntimeHttp2ProtocolInvalidDataPaddingDiagnostic(offset, stream_id, pad_length, remaining_payload_length, active_state, rule_provenance, preview_chunk)
	)
end

fn content_length_mismatch_runtime_payload(offset: Int, frame_kind: Int, stream_id: Int, expected_length: Int, observed_length: Int, active_state: String, rule_provenance: String, preview_chunk: ByteChunk) -> RuntimeDiagnostic
	RuntimeDiagnostic(
		"http2.protocol.content_length_mismatch",
		"HTTP/2 content-length body length mismatch at byte offset 9",
		RuntimeHttp2ProtocolContentLengthMismatchDiagnostic(offset, frame_kind, stream_id, expected_length, observed_length, active_state, rule_provenance, preview_chunk)
	)
end

fn priority_dependency_runtime_payload(offset: Int, stream_id: Int, dependency_stream_id: Int, active_state: String, rule_provenance: String, preview_chunk: ByteChunk) -> RuntimeDiagnostic
	RuntimeDiagnostic(
		"http2.protocol.invalid_priority_dependency",
		"HTTP/2 invalid PRIORITY dependency at byte offset 0",
		RuntimeHttp2ProtocolPriorityDependencyDiagnostic(offset, stream_id, dependency_stream_id, active_state, rule_provenance, preview_chunk)
	)
end

fn project_closed_with_pending_payload(offset: Int, pending_count: Int, active_continuation: String, preview_chunk: ByteChunk) -> Result<(), RuntimeDiagnostic>
	Err(closed_runtime_payload(offset, pending_count, active_continuation, preview_chunk))
end

