fn print_priority_frame_value(label: String, frame: Http2Frame) -> Result<(), String> effects [stdio]
	match frame
		PriorityFrame(flags, stream_id, dependency_stream_id, exclusive, weight) => print_priority_payload(label, flags, stream_id, dependency_stream_id, exclusive, weight)
		KnownFrame(_, _, _, _) => Err("expected priority frame")
		UnknownFrame(_, _, _, _) => Err("expected priority frame")
	end
end

