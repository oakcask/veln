fn unexpected_frame_header_encode_failure() -> Result<(), String> effects [stdio]
	stdio::println("unexpected frame header encode failure")
	Ok(())
end

fn print_encoded_header(name: String, encoded: Result<ByteChunk, EncodeError>, expected_hex: String) -> Result<(), String> effects [stdio]
	match encoded
		Ok(bytes) => emit_encoded_header(name, bytes, expected_hex)
		Err(_) => unexpected_frame_header_encode_failure()
	end
end

fn encode_error_id(error: EncodeError) -> String
	match error
		EncodeError(id, _, _) => id
	end
end

fn encode_error_path(error: EncodeError) -> String
	match error
		EncodeError(_, field_path, _) => field_path
	end
end

fn encode_error_reason(error: EncodeError) -> String
	match error
		EncodeError(_, _, reason) => reason
	end
end

fn print_encode_error_detail(label: String, error: EncodeError) -> () effects [stdio]
	stdio::print(label)
	stdio::print(" encode_error ")
	stdio::print(encode_error_id(error))
	stdio::print(" ")
	stdio::print(encode_error_path(error))
	stdio::print(" ")
	stdio::println(encode_error_reason(error))
end

fn print_encode_error(label: String, encoded: Result<ByteChunk, EncodeError>) -> () effects [stdio]
	match encoded
		Ok(_) => stdio::println("unexpected frame header encode success")
		Err(error) => print_encode_error_detail(label, error)
	end
end

fn print_initial_window_update_cases() -> Result<(), String> effects [stdio]
	let initial_window_open: Http2Step = receive(InputChunk(byte_chunk_from_hex("000000010400000001")?), frame_state())?
	let initial_window_adjust: Http2Step = receive(InputChunk(byte_chunk_from_hex("000006040000000000000400000003")?), step_state(initial_window_open))?
	print_step("initial-window-adjust", initial_window_adjust)
	print_peer_settings("initial-window-adjust", step_state(initial_window_adjust))
	print_receive_windows("initial-window-adjust", step_state(initial_window_adjust))
	let initial_window_data: Http2Step = receive(InputChunk(byte_chunk_from_hex("000003000000000001010203")?), step_state(initial_window_adjust))?
	print_step("initial-window-data", initial_window_data)
	print_receive_windows("initial-window-data", step_state(initial_window_data))
	let initial_window_after_data: Http2Step = receive(InputChunk(byte_chunk_from_hex("00000400000000000101020304")?), step_state(initial_window_open))?
	let initial_window_negative: Http2Step = receive(InputChunk(byte_chunk_from_hex("000006040000000000000400000003")?), step_state(initial_window_after_data))?
	print_step("initial-window-negative", initial_window_negative)
	print_receive_windows("initial-window-negative", step_state(initial_window_negative))
	let initial_window_negative_data: Http2Step = receive(InputChunk(byte_chunk_from_hex("000001000000000001ff")?), step_state(initial_window_negative))?
	print_failure("initial-window-negative-data", initial_window_negative_data)
	let initial_window_restore: Http2Step = receive(InputChunk(byte_chunk_from_hex("00000408000000000100000002")?), step_state(initial_window_negative))?
	print_step("initial-window-restore", initial_window_restore)
	print_receive_windows("initial-window-restore", step_state(initial_window_restore))
	let initial_window_restored_data: Http2Step = receive(InputChunk(byte_chunk_from_hex("000001000000000001ff")?), step_state(initial_window_restore))?
	print_step("initial-window-restored-data", initial_window_restored_data)
	print_receive_windows("initial-window-restored-data", step_state(initial_window_restored_data))
	Ok(())
end

fn print_data_end_stream_cases() -> Result<(), String> effects [stdio]
	let data_end_stream_headers: Http2Step = receive(InputChunk(byte_chunk_from_hex("000000010400000001")?), frame_state())?
	let data_end_stream: Http2Step = receive(InputChunk(byte_chunk_from_hex("00000400010000000101020304")?), step_state(data_end_stream_headers))?
