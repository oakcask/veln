fn state_peer_header_table_size(state: Http2DecodeState) -> Int
	match state
		State(_, _, _, _, _, _, PeerSettings(_, _, _, _, NoPeerHeaderTableSize, _), _, _) => 0
		State(_, _, _, _, _, _, PeerSettings(_, _, _, _, PeerHeaderTableSize(value, _), _), _, _) => value
	end
end

fn state_peer_header_table_size_offset(state: Http2DecodeState) -> Int
	match state
		State(_, _, _, _, _, _, PeerSettings(_, _, _, _, NoPeerHeaderTableSize, _), _, _) => 0
		State(_, _, _, _, _, _, PeerSettings(_, _, _, _, PeerHeaderTableSize(_, item_offset), _), _, _) => item_offset
	end
end

fn state_peer_max_header_list_size(state: Http2DecodeState) -> Int
	match state
		State(_, _, _, _, _, _, PeerSettings(_, _, _, _, _, NoPeerMaxHeaderListSize), _, _) => 0
		State(_, _, _, _, _, _, PeerSettings(_, _, _, _, _, PeerMaxHeaderListSize(value, _)), _, _) => value
	end
end

fn state_peer_max_header_list_size_offset(state: Http2DecodeState) -> Int
	match state
		State(_, _, _, _, _, _, PeerSettings(_, _, _, _, _, NoPeerMaxHeaderListSize), _, _) => 0
		State(_, _, _, _, _, _, PeerSettings(_, _, _, _, _, PeerMaxHeaderListSize(_, item_offset)), _, _) => item_offset
	end
