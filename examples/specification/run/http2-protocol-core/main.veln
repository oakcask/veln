# A pure HTTP/2 core consumes frame headers from explicit input events and emits encoded headers.
use hpack_fixture
use hpack_static
use stdio

schema Http2FrameHeaderWire
	format binary

	length: UInt24be
	kind: UInt8
	flags: UInt8
	stream_reserved: ReservedBits(1, 0)
	stream_id: UInt31be
end

schema Http2RstStreamPayloadWire
	format binary

	error_code: UInt32be
end

schema Http2WindowUpdatePayloadWire
	format binary

	increment_reserved: ReservedBits(1, 0)
	increment: UInt31be
end

schema Http2GoawayPayloadWire
	format binary

	last_stream_reserved: ReservedBits(1, 0)
	last_stream_id: UInt31be
	error_code: UInt32be
end

schema Http2PriorityDependencyPayloadWire
	format binary

	dependency_reserved: ReservedBits(1, 0)
	dependency_stream_id: UInt31be
end

schema Http2PriorityWeightPayloadWire
	format binary

	weight: UInt8
end

schema Http2PushPromisePayloadWire
	format binary

	promised_stream_reserved: ReservedBits(1, 0)
	promised_stream_id: UInt31be
end

type PendingContinuation
	NoContinuation
	Continuation(Int, Int, Int, Int, Bool, Int, ByteChunk)
end

type ContinuationDecision
	Decision(PendingContinuation, ByteChunk, Bool, Bool, Int)
end

type ReceiveLimitProvenance
	ProtocolDefault
	LocalConfiguration
	LocalSettingsItem(Int)
end

type ReceiveLimitEntry
	ReceiveLimit(Int, ReceiveLimitProvenance)
end

type PeerAdvertisedMaxFrameSize
	NoPeerMaxFrameSize
	PeerMaxFrameSize(Int, Int)
end

type PeerAdvertisedInitialWindowSize
	NoPeerInitialWindowSize
	PeerInitialWindowSize(Int, Int)
end

type PeerAdvertisedEnablePush
	NoPeerEnablePush
	PeerEnablePush(Int, Int)
end

type LocalSentEnablePush
	NoLocalSentEnablePush
	LocalSentEnablePush(Int, Int)
end

type PeerAdvertisedMaxConcurrentStreams
	NoPeerMaxConcurrentStreams
	PeerMaxConcurrentStreams(Int, Int)
end

type PeerAdvertisedHeaderTableSize
	NoPeerHeaderTableSize
	PeerHeaderTableSize(Int, Int)
end

type PeerAdvertisedMaxHeaderListSize
	NoPeerMaxHeaderListSize
	PeerMaxHeaderListSize(Int, Int)
end

type PeerSettingsState
	PeerSettings(PeerAdvertisedMaxFrameSize, PeerAdvertisedInitialWindowSize, PeerAdvertisedEnablePush, PeerAdvertisedMaxConcurrentStreams, PeerAdvertisedHeaderTableSize, PeerAdvertisedMaxHeaderListSize, LocalSentEnablePush)
end

type OutstandingLocalSettingsBatch
	LocalSettingsBatch(Int, Int)
end

type OutstandingLocalSettings
	NoOutstandingLocalSettings
	OutstandingLocalSettings(List<OutstandingLocalSettingsBatch>)
end

type OutboundLocalSettingsItem
	OutboundSettingsHeaderTableSize(Int)
	OutboundSettingsEnablePush(Int)
	OutboundSettingsInitialWindowSize(Int)
	OutboundSettingsMaxConcurrentStreams(Int)
	OutboundSettingsMaxFrameSize(Int)
	OutboundSettingsMaxHeaderListSize(Int)
end

type PendingPeerSettingsAck
	NoPendingPeerSettingsAck
	PendingPeerSettingsAck
end

type Http2ConnectionState
	ConnectionState(Http2DecodeState, OutstandingLocalSettings, PendingPeerSettingsAck)
end

type ConnectionShutdownState
	OpenConnection
	GracefulShutdown(Int, Int)
end

type StreamPriorityState
	NoStreamPriority
	StreamPriority(Int, Bool, Int)
	ExpectedContentLength(Int, Int, StreamPriorityState)
	ResponseHeaderStream(StreamPriorityState)
end

type OpenStreamReceiveWindow
	NoOpenStreamReceiveWindow
	OpenStreamReceiveWindow(Int, Int, StreamPriorityState)
	TwoOpenStreamReceiveWindows(Int, Int, StreamPriorityState, Int, Int, StreamPriorityState)
	ClientPushAssociatedStreamReceiveWindow(Int, Int, StreamPriorityState, Int)
	HalfClosedLocalStreamReceiveWindow(Int, Int, StreamPriorityState)
	ClosedByPeerStreamReceiveWindow(Int, Int)
	ResetStreamReceiveWindow(Int, Int)
end

type ReceiveFlowControl
	ReceiveFlowControl(Int, OpenStreamReceiveWindow)
end

type OutboundReceiveCreditStream
	NoOutboundReceiveCreditStream
	OutboundReceiveCreditOpenStream(Int, Int)
	OutboundReceiveCreditOpenStreamContentLength(Int, Int, Int, Int)
	OutboundReceiveCreditClosedStream(Int)
	OutboundReceiveCreditResetStream(Int, Int)
end

type OutboundReceiveCredit
	OutboundReceiveCredit(Int, OutboundReceiveCreditStream)
end

type OutboundSendCredit
	OutboundSendCredit(Int, OutboundReceiveCreditStream)
end

type PrefaceState
	ExpectPreface
	AfterPreface
end

type Http2DecodeState
	State(ByteChunk, Int, PrefaceState, PendingContinuation, HpackFixtureState, ReceiveLimitEntry, PeerSettingsState, ConnectionShutdownState, ReceiveFlowControl)
end

type Http2Input
	InputChunk(ByteChunk)
	InputEnd
end

type Http2Frame
	KnownFrame(Int, Int, Int, ByteView)
	PriorityFrame(Int, Int, Int, Bool, Int)
	UnknownFrame(Int, Int, Int, ByteView)
end

type Http2ProtocolFailure
	ClosedWithPending(Int, Int, ByteChunk)
	ClosedWithPartialPreface(Int, Int)
	InvalidPreface(Int, Int, Int, Int)
	ContinuationExpected {offset: Int, actual_kind: Int, actual_stream: Int, expected_stream: Int, started_kind: Int, started_offset: Int, preview_chunk: ByteChunk}
	InvalidFrameKind {offset: Int, actual_kind: Int, stream_id: Int, expected_kind: Int, active_state: String, rule_provenance: String}
	InvalidStreamId {offset: Int, frame_kind: Int, stream_id: Int, required_domain: String, endpoint_role: String, active_state: String, rule_provenance: String}
	InvalidPayloadLength {offset: Int, frame_kind: Int, stream_id: Int, observed_length: Int, expected_length: Int, active_state: String, rule_provenance: String, preview: ByteView}
	InvalidWindowUpdateIncrement {offset: Int, stream_id: Int, observed_increment: Int, accepted_min_increment: Int, accepted_max_increment: Int, active_state: String, rule_provenance: String, preview: ByteView}
	InvalidDataPadding {offset: Int, stream_id: Int, pad_length: Int, remaining_payload_length: Int, active_state: String, rule_provenance: String, preview: ByteView}
	ContentLengthMismatch {offset: Int, frame_kind: Int, stream_id: Int, expected_length: Int, observed_length: Int, active_state: String, rule_provenance: String, preview: ByteView}
	InvalidRequestHeaderList {offset: Int, frame_kind: Int, stream_id: Int, failed_header_fact: String, header_name: String, decoded_header_names: String, preview_chunk: ByteChunk}
	InvalidResponseHeaderList {offset: Int, frame_kind: Int, stream_id: Int, failed_header_fact: String, header_name: String, decoded_header_names: String, active_state: String, preview_chunk: ByteChunk}
	UnexpectedSettingsAck(Int, String, String, ByteView)
	InvalidPriorityDependency {offset: Int, stream_id: Int, dependency_stream_id: Int, active_state: String, rule_provenance: String, preview: ByteView}
	StreamAfterGoaway {offset: Int, stream_id: Int, last_stream_id: Int, shutdown_state: String, endpoint_role: String, rule_provenance: String, preview_chunk: ByteChunk}
	FrameSizeExceeded {offset: Int, observed_length: Int, receive_limit: ReceiveLimitEntry, frame_kind: Int, stream_id: Int}
	FlowControlWindowExceeded {offset: Int, frame_kind: Int, stream_id: Int, observed_length: Int, allowed_window_credit: Int, active_state: String, rule_provenance: String, preview_chunk: ByteChunk}
	ConcurrentStreamsExceeded {offset: Int, stream_id: Int, attempted_count: Int, allowed_count: Int, endpoint_role: String, active_state: String, receive_limit_provenance: String, rule_provenance: String, preview_chunk: ByteChunk}
	HeaderListSizeExceeded {offset: Int, observed_size: Int, receive_limit: ReceiveLimitEntry, frame_kind: Int, stream_id: Int, rule_provenance: String, preview_chunk: ByteChunk}
	HeaderTableSizeExceeded {offset: Int, observed_size: Int, receive_limit: ReceiveLimitEntry, frame_kind: Int, stream_id: Int, rule_provenance: String, preview_chunk: ByteChunk}
	SettingsValueOutOfRange {offset: Int, setting_identifier: Int, setting_name: String, observed_value: Int, accepted_min_value: Int, accepted_max_value: Int, peer_limit_provenance: String, preview: ByteView}
	HpackFixtureDecodeFailed {offset: Int, observed_size: Int, observed_first_byte: Int, requested_dynamic_index: Int, dynamic_table_entry_count: Int, expected_fixture: String, codec_module: String, preview_chunk: ByteChunk}
	HpackTableSizeUpdateNotAtStart {offset: Int, observed_size: Int, observed_first_byte: Int, observed_update_size: Int, frame_kind: Int, stream_id: Int, active_state: String, expected_fixture: String, codec_module: String, preview_chunk: ByteChunk}
end

