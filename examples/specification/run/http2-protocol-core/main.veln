fn state_peer_settings(state: Http2DecodeState) -> PeerSettingsState
	match state
		State(_, _, _, _, _, _, peer_settings, _, _) => peer_settings
	end
end

fn state_hpack_fixture_state(state: Http2DecodeState) -> HpackFixtureState
	match state
		State(_, _, _, _, hpack_state, _, _, _, _) => hpack_state
	end
end

fn hpack_carry_only_state(state: Http2DecodeState) -> Http2DecodeState
	match state
		State(_, next_offset, preface_state, continuation, hpack_state, receive_limit, peer_settings, shutdown_state, ReceiveFlowControl(connection_window, _)) => State(byte_chunk([]), next_offset, preface_state, continuation, hpack_state, receive_limit, peer_settings, shutdown_state, ReceiveFlowControl(connection_window, NoOpenStreamReceiveWindow))
	end
end

fn connection_decode_state(connection: Http2ConnectionState) -> Http2DecodeState
	match connection
		ConnectionState(decode_state, _) => decode_state
	end
end

fn connection_outstanding_settings(connection: Http2ConnectionState) -> OutstandingLocalSettings
	match connection
		ConnectionState(_, outstanding_settings) => outstanding_settings
	end
end

fn connection_step_state(step: Http2ConnectionStep) -> Http2ConnectionState
	match step
		ConnectionFrameDecoded(state, _) => state
		ConnectionWaiting(state) => state
		ConnectionFailed(state, _) => state
	end
end

fn connection_step_decode_step(step: Http2ConnectionStep) -> Http2Step
	match step
		ConnectionFrameDecoded(_, decode_step) => decode_step
		ConnectionWaiting(state) => Waiting(connection_decode_state(state))
		ConnectionFailed(state, failure) => Failed(connection_decode_state(state), failure)
	end
end

fn connection_step_failure(step: Http2ConnectionStep) -> Http2ProtocolFailure
	match step
		ConnectionFrameDecoded(_, _) => ClosedWithPending(0, 0)
		ConnectionWaiting(_) => ClosedWithPending(0, 0)
		ConnectionFailed(_, failure) => failure
	end
end

fn outstanding_settings_label(outstanding_settings: OutstandingLocalSettings) -> String
	match outstanding_settings
		NoOutstandingLocalSettings => "none"
		OutstandingLocalSettings(_, _) => "active"
	end
end

fn outstanding_settings_identifier(outstanding_settings: OutstandingLocalSettings) -> Int
	match outstanding_settings
		NoOutstandingLocalSettings => 0
		OutstandingLocalSettings(identifier, _) => identifier
	end
end

fn outstanding_settings_count(outstanding_settings: OutstandingLocalSettings) -> Int
	match outstanding_settings
		NoOutstandingLocalSettings => 0
		OutstandingLocalSettings(_, count) => count
	end
end

fn state_shutdown_state_value(state: Http2DecodeState) -> ConnectionShutdownState
	match state
		State(_, _, _, _, _, _, _, shutdown_state, _) => shutdown_state
	end
end

fn state_receive_flow_control(state: Http2DecodeState) -> ReceiveFlowControl
	match state
		State(_, _, _, _, _, _, _, _, receive_flow_control) => receive_flow_control
	end
end

fn state_shutdown_label(state: Http2DecodeState) -> String
	match state
		State(_, _, _, _, _, _, _, OpenConnection, _) => "open"
		State(_, _, _, _, _, _, _, GracefulShutdown(_, _), _) => "graceful_shutdown"
	end
end

fn state_shutdown_last_stream_id(state: Http2DecodeState) -> Int
	match state
		State(_, _, _, _, _, _, _, OpenConnection, _) => 0
		State(_, _, _, _, _, _, _, GracefulShutdown(last_stream_id, _), _) => last_stream_id
	end
end

fn state_shutdown_error_code(state: Http2DecodeState) -> Int
	match state
		State(_, _, _, _, _, _, _, OpenConnection, _) => 0
		State(_, _, _, _, _, _, _, GracefulShutdown(_, error_code), _) => error_code
	end
end

fn state_connection_window(state: Http2DecodeState) -> Int
	match state
		State(_, _, _, _, _, _, _, _, ReceiveFlowControl(connection_window, _)) => connection_window
	end
end

fn state_stream_window(state: Http2DecodeState) -> Int
	match state
		State(_, _, _, _, _, _, _, _, ReceiveFlowControl(_, NoOpenStreamReceiveWindow)) => 0
		State(_, _, _, _, _, _, _, _, ReceiveFlowControl(_, OpenStreamReceiveWindow(_, stream_window, _))) => stream_window
		State(_, _, _, _, _, _, _, _, ReceiveFlowControl(_, HalfClosedLocalStreamReceiveWindow(_, stream_window, _))) => stream_window
		State(_, _, _, _, _, _, _, _, ReceiveFlowControl(_, ClosedByPeerStreamReceiveWindow(_, stream_window))) => stream_window
		State(_, _, _, _, _, _, _, _, ReceiveFlowControl(_, ResetStreamReceiveWindow(_, _))) => 0
	end
end

fn state_open_stream_id(state: Http2DecodeState) -> Int
	match state
		State(_, _, _, _, _, _, _, _, ReceiveFlowControl(_, NoOpenStreamReceiveWindow)) => 0
		State(_, _, _, _, _, _, _, _, ReceiveFlowControl(_, OpenStreamReceiveWindow(stream_id, _, _))) => stream_id
		State(_, _, _, _, _, _, _, _, ReceiveFlowControl(_, HalfClosedLocalStreamReceiveWindow(_, _, _))) => 0
		State(_, _, _, _, _, _, _, _, ReceiveFlowControl(_, ClosedByPeerStreamReceiveWindow(_, _))) => 0
		State(_, _, _, _, _, _, _, _, ReceiveFlowControl(_, ResetStreamReceiveWindow(_, _))) => 0
	end
end

fn state_open_stream_count(state: Http2DecodeState) -> Int
	match state
		State(_, _, _, _, _, _, _, _, ReceiveFlowControl(_, NoOpenStreamReceiveWindow)) => 0
		State(_, _, _, _, _, _, _, _, ReceiveFlowControl(_, OpenStreamReceiveWindow(_, _, _))) => 1
		State(_, _, _, _, _, _, _, _, ReceiveFlowControl(_, HalfClosedLocalStreamReceiveWindow(_, _, _))) => 0
		State(_, _, _, _, _, _, _, _, ReceiveFlowControl(_, ClosedByPeerStreamReceiveWindow(_, _))) => 0
		State(_, _, _, _, _, _, _, _, ReceiveFlowControl(_, ResetStreamReceiveWindow(_, _))) => 0
	end
end

fn state_half_closed_local_stream_id(state: Http2DecodeState) -> Int
	match state
		State(_, _, _, _, _, _, _, _, ReceiveFlowControl(_, NoOpenStreamReceiveWindow)) => 0
		State(_, _, _, _, _, _, _, _, ReceiveFlowControl(_, OpenStreamReceiveWindow(_, _, _))) => 0
		State(_, _, _, _, _, _, _, _, ReceiveFlowControl(_, HalfClosedLocalStreamReceiveWindow(stream_id, _, _))) => stream_id
		State(_, _, _, _, _, _, _, _, ReceiveFlowControl(_, ClosedByPeerStreamReceiveWindow(_, _))) => 0
		State(_, _, _, _, _, _, _, _, ReceiveFlowControl(_, ResetStreamReceiveWindow(_, _))) => 0
	end
end

fn state_closed_by_peer_stream_id(state: Http2DecodeState) -> Int
	match state
		State(_, _, _, _, _, _, _, _, ReceiveFlowControl(_, NoOpenStreamReceiveWindow)) => 0
		State(_, _, _, _, _, _, _, _, ReceiveFlowControl(_, OpenStreamReceiveWindow(_, _, _))) => 0
		State(_, _, _, _, _, _, _, _, ReceiveFlowControl(_, HalfClosedLocalStreamReceiveWindow(_, _, _))) => 0
		State(_, _, _, _, _, _, _, _, ReceiveFlowControl(_, ClosedByPeerStreamReceiveWindow(stream_id, _))) => stream_id
		State(_, _, _, _, _, _, _, _, ReceiveFlowControl(_, ResetStreamReceiveWindow(_, _))) => 0
	end
end

fn state_reset_stream_id(state: Http2DecodeState) -> Int
	match state
		State(_, _, _, _, _, _, _, _, ReceiveFlowControl(_, NoOpenStreamReceiveWindow)) => 0
		State(_, _, _, _, _, _, _, _, ReceiveFlowControl(_, OpenStreamReceiveWindow(_, _, _))) => 0
		State(_, _, _, _, _, _, _, _, ReceiveFlowControl(_, HalfClosedLocalStreamReceiveWindow(_, _, _))) => 0
		State(_, _, _, _, _, _, _, _, ReceiveFlowControl(_, ClosedByPeerStreamReceiveWindow(_, _))) => 0
		State(_, _, _, _, _, _, _, _, ReceiveFlowControl(_, ResetStreamReceiveWindow(stream_id, _))) => stream_id
	end
end

fn state_reset_error_code(state: Http2DecodeState) -> Int
	match state
		State(_, _, _, _, _, _, _, _, ReceiveFlowControl(_, NoOpenStreamReceiveWindow)) => 0
		State(_, _, _, _, _, _, _, _, ReceiveFlowControl(_, OpenStreamReceiveWindow(_, _, _))) => 0
		State(_, _, _, _, _, _, _, _, ReceiveFlowControl(_, HalfClosedLocalStreamReceiveWindow(_, _, _))) => 0
		State(_, _, _, _, _, _, _, _, ReceiveFlowControl(_, ClosedByPeerStreamReceiveWindow(_, _))) => 0
		State(_, _, _, _, _, _, _, _, ReceiveFlowControl(_, ResetStreamReceiveWindow(_, error_code))) => error_code
	end
end

fn state_priority_label(state: Http2DecodeState) -> String
	match state
		State(_, _, _, _, _, _, _, _, ReceiveFlowControl(_, OpenStreamReceiveWindow(_, _, StreamPriority(_, _, _)))) => "tracked"
		State(_, _, _, _, _, _, _, _, ReceiveFlowControl(_, HalfClosedLocalStreamReceiveWindow(_, _, StreamPriority(_, _, _)))) => "tracked"
		State(_, _, _, _, _, _, _, _, ReceiveFlowControl(_, NoOpenStreamReceiveWindow)) => "none"
		State(_, _, _, _, _, _, _, _, ReceiveFlowControl(_, OpenStreamReceiveWindow(_, _, NoStreamPriority))) => "none"
		State(_, _, _, _, _, _, _, _, ReceiveFlowControl(_, HalfClosedLocalStreamReceiveWindow(_, _, NoStreamPriority))) => "none"
		State(_, _, _, _, _, _, _, _, ReceiveFlowControl(_, ClosedByPeerStreamReceiveWindow(_, _))) => "none"
		State(_, _, _, _, _, _, _, _, ReceiveFlowControl(_, ResetStreamReceiveWindow(_, _))) => "none"
	end
end

fn state_priority_dependency_stream_id(state: Http2DecodeState) -> Int
	match state
		State(_, _, _, _, _, _, _, _, ReceiveFlowControl(_, OpenStreamReceiveWindow(_, _, StreamPriority(dependency_stream_id, _, _)))) => dependency_stream_id
		State(_, _, _, _, _, _, _, _, ReceiveFlowControl(_, HalfClosedLocalStreamReceiveWindow(_, _, StreamPriority(dependency_stream_id, _, _)))) => dependency_stream_id
		State(_, _, _, _, _, _, _, _, ReceiveFlowControl(_, NoOpenStreamReceiveWindow)) => 0
		State(_, _, _, _, _, _, _, _, ReceiveFlowControl(_, OpenStreamReceiveWindow(_, _, NoStreamPriority))) => 0
		State(_, _, _, _, _, _, _, _, ReceiveFlowControl(_, HalfClosedLocalStreamReceiveWindow(_, _, NoStreamPriority))) => 0
		State(_, _, _, _, _, _, _, _, ReceiveFlowControl(_, ClosedByPeerStreamReceiveWindow(_, _))) => 0
		State(_, _, _, _, _, _, _, _, ReceiveFlowControl(_, ResetStreamReceiveWindow(_, _))) => 0
	end
end

fn state_priority_exclusive(state: Http2DecodeState) -> Bool
	match state
		State(_, _, _, _, _, _, _, _, ReceiveFlowControl(_, OpenStreamReceiveWindow(_, _, StreamPriority(_, exclusive, _)))) => exclusive
		State(_, _, _, _, _, _, _, _, ReceiveFlowControl(_, HalfClosedLocalStreamReceiveWindow(_, _, StreamPriority(_, exclusive, _)))) => exclusive
		State(_, _, _, _, _, _, _, _, ReceiveFlowControl(_, NoOpenStreamReceiveWindow)) => false
		State(_, _, _, _, _, _, _, _, ReceiveFlowControl(_, OpenStreamReceiveWindow(_, _, NoStreamPriority))) => false
		State(_, _, _, _, _, _, _, _, ReceiveFlowControl(_, HalfClosedLocalStreamReceiveWindow(_, _, NoStreamPriority))) => false
		State(_, _, _, _, _, _, _, _, ReceiveFlowControl(_, ClosedByPeerStreamReceiveWindow(_, _))) => false
		State(_, _, _, _, _, _, _, _, ReceiveFlowControl(_, ResetStreamReceiveWindow(_, _))) => false
	end
end

fn state_priority_weight(state: Http2DecodeState) -> Int
	match state
		State(_, _, _, _, _, _, _, _, ReceiveFlowControl(_, OpenStreamReceiveWindow(_, _, StreamPriority(_, _, weight)))) => weight
		State(_, _, _, _, _, _, _, _, ReceiveFlowControl(_, HalfClosedLocalStreamReceiveWindow(_, _, StreamPriority(_, _, weight)))) => weight
		State(_, _, _, _, _, _, _, _, ReceiveFlowControl(_, NoOpenStreamReceiveWindow)) => 0
		State(_, _, _, _, _, _, _, _, ReceiveFlowControl(_, OpenStreamReceiveWindow(_, _, NoStreamPriority))) => 0
		State(_, _, _, _, _, _, _, _, ReceiveFlowControl(_, HalfClosedLocalStreamReceiveWindow(_, _, NoStreamPriority))) => 0
		State(_, _, _, _, _, _, _, _, ReceiveFlowControl(_, ClosedByPeerStreamReceiveWindow(_, _))) => 0
		State(_, _, _, _, _, _, _, _, ReceiveFlowControl(_, ResetStreamReceiveWindow(_, _))) => 0
	end
end

fn outbound_data_status(decision: OutboundDataDecision) -> String
	match decision
		OutboundDataAccepted(_, _, _, _, _) => "accepted"
		OutboundDataRejected(_, _, _, _) => "rejected"
		OutboundDataEncodeFailed(_, _, _, _) => "encode_error"
	end
end

fn outbound_data_reason(decision: OutboundDataDecision) -> String
	match decision
		OutboundDataAccepted(_, _, _, _, _) => "none"
		OutboundDataRejected(_, _, _, error) => outbound_data_failure_reason(error)
		OutboundDataEncodeFailed(_, _, _, error) => encode_error_id(error)
	end
end

fn outbound_data_failure_reason(error: Http2ProtocolFailure) -> String
	match error
		FrameSizeExceeded(_, _, _, _, _) => "peer_max_frame_size"
		ClosedWithPending(_, _) => failure_rule_provenance(error)
		ClosedWithPartialPreface(_, _) => failure_rule_provenance(error)
		InvalidPreface(_, _, _, _) => failure_rule_provenance(error)
		ContinuationExpected(_, _, _, _, _, _) => failure_rule_provenance(error)
		InvalidFrameKind(_, _, _, _, _, _) => failure_rule_provenance(error)
		InvalidStreamId(_, _, _, _, _, _, _) => failure_rule_provenance(error)
		InvalidPayloadLength(_, _, _, _, _, _, _, _) => failure_rule_provenance(error)
		InvalidDataPadding(_, _, _, _, _, _, _) => failure_rule_provenance(error)
		UnexpectedSettingsAck(_, _, _) => failure_rule_provenance(error)
		InvalidPriorityDependency(_, _, _, _, _, _) => failure_rule_provenance(error)
		StreamAfterGoaway(_, _, _, _, _, _) => failure_rule_provenance(error)
		FlowControlWindowExceeded(_, _, _, _, _, _, _) => failure_rule_provenance(error)
		ConcurrentStreamsExceeded(_, _, _, _, _, _, _) => failure_rule_provenance(error)
		HeaderListSizeExceeded(_, _, _, _, _, _) => failure_rule_provenance(error)
		SettingsValueOutOfRange(_, _, _, _, _, _, _) => failure_rule_provenance(error)
		HpackFixtureDecodeFailed(_, _, _, _, _) => failure_rule_provenance(error)
	end
end

