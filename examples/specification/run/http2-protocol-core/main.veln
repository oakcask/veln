fn outbound_headers_result_decision(result: Result<OutboundHeadersDecision, HpackFixtureFailure>) -> OutboundHeadersDecision
	match result
		Ok(decision) => decision
		Err(_) => OutboundHeadersRejected(0, 0, false, HpackFixtureDecodeFailed(0, 0, -1, 0, 0, "fixture header list encoding", "hpack_fixture", byte_chunk([])))
	end
end

fn outbound_headers_reason(decision: OutboundHeadersDecision) -> String
	match decision
		OutboundHeadersAccepted(_, _, _, _, _) => "none"
		OutboundHeadersRejected(_, _, _, error) => outbound_headers_failure_reason(error)
		OutboundHeadersEncodeFailed(_, _, _, error) => encode_error_id(error)
	end
end

fn outbound_headers_failure_reason(error: Http2ProtocolFailure) -> String
	match error
		FrameSizeExceeded(offset, observed_length, receive_limit, frame_kind, stream_id) => "peer_max_frame_size"
		ClosedWithPending(_, _, _) => failure_rule_provenance(error)
		ClosedWithPartialPreface(_, _) => failure_rule_provenance(error)
		InvalidPreface(_, _, _, _) => failure_rule_provenance(error)
		ContinuationExpected(offset, actual_kind, actual_stream, expected_stream, started_kind, started_offset, preview_chunk) => failure_rule_provenance(error)
		InvalidFrameKind(offset, actual_kind, stream_id, expected_kind, active_state, rule_provenance) => failure_rule_provenance(error)
		InvalidStreamId(offset, frame_kind, stream_id, required_domain, endpoint_role, active_state, rule_provenance) => failure_rule_provenance(error)
		InvalidPayloadLength(offset, frame_kind, stream_id, observed_length, expected_length, active_state, rule_provenance, preview) => failure_rule_provenance(error)
		InvalidWindowUpdateIncrement(offset, stream_id, observed_increment, accepted_min_increment, accepted_max_increment, active_state, rule_provenance, preview) => failure_rule_provenance(error)
		InvalidDataPadding(offset, stream_id, pad_length, remaining_payload_length, active_state, rule_provenance, preview) => failure_rule_provenance(error)
		ContentLengthMismatch(offset, frame_kind, stream_id, expected_length, observed_length, active_state, rule_provenance, preview) => failure_rule_provenance(error)
		InvalidRequestHeaderList(offset, frame_kind, stream_id, failed_header_fact, header_name, decoded_header_names, preview_chunk) => failure_rule_provenance(error)
		InvalidResponseHeaderList(offset, frame_kind, stream_id, failed_header_fact, header_name, decoded_header_names, active_state, preview_chunk) => failure_rule_provenance(error)
		UnexpectedSettingsAck(_, _, _, _) => failure_rule_provenance(error)
		InvalidPriorityDependency(offset, stream_id, dependency_stream_id, active_state, rule_provenance, preview) => failure_rule_provenance(error)
		StreamAfterGoaway(offset, stream_id, last_stream_id, shutdown_state, endpoint_role, rule_provenance, preview_chunk) => failure_rule_provenance(error)
		FlowControlWindowExceeded(offset, frame_kind, stream_id, observed_length, allowed_window_credit, active_state, rule_provenance, preview_chunk) => failure_rule_provenance(error)
		ConcurrentStreamsExceeded(offset, stream_id, attempted_count, allowed_count, endpoint_role, active_state, receive_limit_provenance, rule_provenance, preview_chunk) => failure_rule_provenance(error)
		HeaderListSizeExceeded(offset, observed_size, receive_limit, frame_kind, stream_id, rule_provenance, preview_chunk) => failure_rule_provenance(error)
		HeaderTableSizeExceeded(offset, observed_size, receive_limit, frame_kind, stream_id, rule_provenance, preview_chunk) => failure_rule_provenance(error)
		SettingsValueOutOfRange(offset, setting_identifier, setting_name, observed_value, accepted_min_value, accepted_max_value, peer_limit_provenance, preview) => failure_rule_provenance(error)
		HpackFixtureDecodeFailed(offset, observed_size, observed_first_byte, requested_dynamic_index, dynamic_table_entry_count, expected_fixture, codec_module, preview_chunk) => failure_rule_provenance(error)
		HpackTableSizeUpdateNotAtStart(offset, observed_size, observed_first_byte, observed_update_size, frame_kind, stream_id, active_state, expected_fixture, codec_module, preview_chunk) => failure_rule_provenance(error)
	end
end

