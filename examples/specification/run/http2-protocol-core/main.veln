type Http2Step
	FrameDecoded(Http2DecodeState, Int, Int, Int, Int, Int, ByteChunk, Http2Frame)
	Waiting(Http2DecodeState)
	Failed(Http2DecodeState, Http2ProtocolFailure)
end

type Http2ConnectionStep
	ConnectionFrameDecoded(Http2ConnectionState, Http2Step)
	ConnectionWaiting(Http2ConnectionState)
	ConnectionFailed(Http2ConnectionState, Http2ProtocolFailure)
end

fn empty_state() -> Http2DecodeState
	State(byte_chunk([]), 0, ExpectPreface, NoContinuation, hpack_fixture::initial_state(), protocol_default_frame_size_limit(), empty_peer_settings(), OpenConnection, default_receive_flow_control())
end

fn frame_state() -> Http2DecodeState
	State(byte_chunk([]), 0, AfterPreface, NoContinuation, hpack_fixture::initial_state(), protocol_default_frame_size_limit(), empty_peer_settings(), OpenConnection, default_receive_flow_control())
end

fn local_config_state(max_frame_size: Int) -> Http2DecodeState
	State(byte_chunk([]), 0, AfterPreface, NoContinuation, hpack_fixture::initial_state(), ReceiveLimit(max_frame_size, LocalConfiguration), empty_peer_settings(), OpenConnection, default_receive_flow_control())
end

fn local_settings_state(max_frame_size: Int, item_offset: Int) -> Http2DecodeState
	State(byte_chunk([]), 0, AfterPreface, NoContinuation, hpack_fixture::initial_state(), ReceiveLimit(max_frame_size, LocalSettingsItem(item_offset)), empty_peer_settings(), OpenConnection, default_receive_flow_control())
end

fn receive_window_state(connection_window: Int, stream_id: Int, stream_window: Int) -> Http2DecodeState
	State(byte_chunk([]), 0, AfterPreface, NoContinuation, hpack_fixture::initial_state(), protocol_default_frame_size_limit(), empty_peer_settings(), OpenConnection, ReceiveFlowControl(connection_window, OpenStreamReceiveWindow(stream_id, stream_window, NoStreamPriority)))
end

fn client_push_receive_state(connection_window: Int, stream_id: Int, stream_window: Int) -> Http2DecodeState
	State(byte_chunk([]), 0, AfterPreface, NoContinuation, hpack_fixture::initial_state(), protocol_default_frame_size_limit(), empty_peer_settings(), OpenConnection, ReceiveFlowControl(connection_window, ClientPushAssociatedStreamReceiveWindow(stream_id, stream_window, NoStreamPriority, 0)))
end

fn encode_frame_header(header: {length: Int, kind: Int, flags: Int, stream_id: Int}) -> Result<ByteChunk, EncodeError>
	byte_encode_http2_frame_header_wire(header)
end

fn encode_rst_stream_payload(payload: {error_code: Int}) -> Result<ByteChunk, EncodeError>
	byte_encode_http2_rst_stream_payload_wire(payload)
end

fn encode_window_update_payload(payload: {increment: Int}) -> Result<ByteChunk, EncodeError>
	byte_encode_http2_window_update_payload_wire(payload)
end

fn encode_goaway_payload(payload: {last_stream_id: Int, error_code: Int}) -> Result<ByteChunk, EncodeError>
	byte_encode_http2_goaway_payload_wire(payload)
end

fn encode_priority_dependency_payload(payload: {dependency_stream_id: Int}) -> Result<ByteChunk, EncodeError>
	byte_encode_http2_priority_dependency_payload_wire(payload)
end

fn encode_priority_weight_payload(payload: {weight: Int}) -> Result<ByteChunk, EncodeError>
	byte_encode_http2_priority_weight_payload_wire(payload)
end

fn encode_push_promise_payload(payload: {promised_stream_id: Int}) -> Result<ByteChunk, EncodeError>
	byte_encode_http2_push_promise_payload_wire(payload)
end

fn receive(input: Http2Input, state: Http2DecodeState) -> Result<Http2Step, String>
	match input
		InputChunk(bytes) => receive_chunk(bytes, state)
		InputEnd => receive_end(state)
	end
end

fn receive_chunk(bytes: ByteChunk, state: Http2DecodeState) -> Result<Http2Step, String>
	match state
		State(pending, next_offset, preface_state, continuation, hpack_state, receive_limit, peer_settings, shutdown_state, receive_flow_control) => receive_available(byte_append(pending, bytes), next_offset, preface_state, continuation, hpack_state, receive_limit, peer_settings, shutdown_state, receive_flow_control)
	end
end

fn receive_end(state: Http2DecodeState) -> Result<Http2Step, String>
	match state
		State(pending, next_offset, preface_state, continuation, hpack_state, receive_limit, peer_settings, shutdown_state, receive_flow_control) => end_pending(pending, next_offset, preface_state, continuation, hpack_state, receive_limit, peer_settings, shutdown_state, receive_flow_control)
	end
end

fn end_pending(pending: ByteChunk, next_offset: Int, preface_state: PrefaceState, continuation: PendingContinuation, hpack_state: HpackFixtureState, receive_limit: ReceiveLimitEntry, peer_settings: PeerSettingsState, shutdown_state: ConnectionShutdownState, receive_flow_control: ReceiveFlowControl) -> Result<Http2Step, String>
	let available: Int = byte_count_to_int(byte_chunk_count(pending))
	match available
		0 => match continuation
			NoContinuation => Ok(Waiting(State(pending, next_offset, preface_state, continuation, hpack_state, receive_limit, peer_settings, shutdown_state, receive_flow_control)))
			Continuation(_, _, _, _, _, _, _) => Ok(Failed(State(pending, next_offset, preface_state, continuation, hpack_state, receive_limit, peer_settings, shutdown_state, receive_flow_control), ClosedWithPending(next_offset, available, pending)))
		end
		_ => match preface_state
			ExpectPreface => Ok(Failed(State(pending, next_offset, preface_state, continuation, hpack_state, receive_limit, peer_settings, shutdown_state, receive_flow_control), ClosedWithPartialPreface(next_offset, available)))
			AfterPreface => Ok(Failed(State(pending, next_offset, preface_state, continuation, hpack_state, receive_limit, peer_settings, shutdown_state, receive_flow_control), ClosedWithPending(next_offset, available, pending)))
		end
	end
end

fn receive_available(pending: ByteChunk, next_offset: Int, preface_state: PrefaceState, continuation: PendingContinuation, hpack_state: HpackFixtureState, receive_limit: ReceiveLimitEntry, peer_settings: PeerSettingsState, shutdown_state: ConnectionShutdownState, receive_flow_control: ReceiveFlowControl) -> Result<Http2Step, String>
	match preface_state
		ExpectPreface => validate_preface(pending, next_offset, continuation, hpack_state, receive_limit, peer_settings, shutdown_state, receive_flow_control)
		AfterPreface => decode_available(pending, next_offset, continuation, hpack_state, receive_limit, peer_settings, shutdown_state, receive_flow_control)
	end
end

fn client_connection_preface_count() -> Int
	24
end

fn validate_preface(pending: ByteChunk, next_offset: Int, continuation: PendingContinuation, hpack_state: HpackFixtureState, receive_limit: ReceiveLimitEntry, peer_settings: PeerSettingsState, shutdown_state: ConnectionShutdownState, receive_flow_control: ReceiveFlowControl) -> Result<Http2Step, String>
	let available: Int = byte_count_to_int(byte_chunk_count(pending))
	let matched: Int = matched_preface_count(pending, available, 0)?
	match matched < available
		true => match matched < client_connection_preface_count()
			true => Ok(Failed(State(pending, next_offset, ExpectPreface, continuation, hpack_state, receive_limit, peer_settings, shutdown_state, receive_flow_control), InvalidPreface(next_offset + matched, expected_preface_byte(matched), read_byte(pending, matched)?, matched)))
			false => consume_preface(pending, next_offset, continuation, hpack_state, receive_limit, peer_settings, shutdown_state, receive_flow_control)
		end
		false => match available < client_connection_preface_count()
			true => Ok(Waiting(State(pending, next_offset, ExpectPreface, continuation, hpack_state, receive_limit, peer_settings, shutdown_state, receive_flow_control)))
			false => consume_preface(pending, next_offset, continuation, hpack_state, receive_limit, peer_settings, shutdown_state, receive_flow_control)
		end
	end
end

fn consume_preface(pending: ByteChunk, next_offset: Int, continuation: PendingContinuation, hpack_state: HpackFixtureState, receive_limit: ReceiveLimitEntry, peer_settings: PeerSettingsState, shutdown_state: ConnectionShutdownState, receive_flow_control: ReceiveFlowControl) -> Result<Http2Step, String>
	let preface_count: ByteCount = byte_count(client_connection_preface_count())?
	let suffix: ByteChunk = byte_drop(pending, preface_count)?
	decode_available(suffix, next_offset + client_connection_preface_count(), continuation, hpack_state, receive_limit, peer_settings, shutdown_state, receive_flow_control)
end

fn matched_preface_count(pending: ByteChunk, available: Int, index: Int) -> Result<Int, String>
	match index < available
		false => Ok(index)
		true => match index < client_connection_preface_count()
			false => Ok(index)
			true => match read_byte(pending, index)? == expected_preface_byte(index)
				true => matched_preface_count(pending, available, index + 1)
				false => Ok(index)
			end
		end
	end
end

fn read_byte(pending: ByteChunk, index: Int) -> Result<Int, String>
	byte_read_u8_be(byte_view(pending, byte_offset(index)?, byte_count(1)?)?)
end

fn expected_preface_byte(index: Int) -> Int
	match index
		0 => 80
		1 => 82
		2 => 73
		3 => 32
		4 => 42
		5 => 32
		6 => 72
		7 => 84
		8 => 84
		9 => 80
		10 => 47
		11 => 50
		12 => 46
		13 => 48
		14 => 13
		15 => 10
		16 => 13
		17 => 10
		18 => 83
		19 => 77
		20 => 13
		21 => 10
		22 => 13
		23 => 10
		_ => 0
	end
end

fn decode_available(pending: ByteChunk, next_offset: Int, continuation: PendingContinuation, hpack_state: HpackFixtureState, receive_limit: ReceiveLimitEntry, peer_settings: PeerSettingsState, shutdown_state: ConnectionShutdownState, receive_flow_control: ReceiveFlowControl) -> Result<Http2Step, String>
	let available: Int = byte_count_to_int(byte_chunk_count(pending))
	match available < 9
		true => Ok(Waiting(State(pending, next_offset, AfterPreface, continuation, hpack_state, receive_limit, peer_settings, shutdown_state, receive_flow_control)))
		false => decode_header(pending, next_offset, continuation, hpack_state, receive_limit, peer_settings, shutdown_state, receive_flow_control)
	end
end

fn decode_header(pending: ByteChunk, next_offset: Int, continuation: PendingContinuation, hpack_state: HpackFixtureState, receive_limit: ReceiveLimitEntry, peer_settings: PeerSettingsState, shutdown_state: ConnectionShutdownState, receive_flow_control: ReceiveFlowControl) -> Result<Http2Step, String>
	let available: Int = byte_count_to_int(byte_chunk_count(pending))
	let zero: ByteOffset = byte_offset(0)?
	let header_count: ByteCount = byte_count(9)?
	let view: ByteView = byte_view(pending, zero, header_count)?
	let header: {length: Int, kind: Int, flags: Int, stream_id: Int} = byte_decode_http2_frame_header_wire(view)?
	let max_frame_size: Int = receive_limit_value(receive_limit)
	match header.length > max_frame_size
		true => Ok(Failed(State(pending, next_offset, AfterPreface, continuation, hpack_state, receive_limit, peer_settings, shutdown_state, receive_flow_control), FrameSizeExceeded(next_offset, header.length, receive_limit, header.kind, header.stream_id)))
		false => decode_sized_frame(pending, next_offset, continuation, hpack_state, receive_limit, peer_settings, shutdown_state, receive_flow_control, available, header.length, header.kind, header.flags, header.stream_id, byte_view_to_chunk(view))
	end
end

fn protocol_default_frame_size_limit() -> ReceiveLimitEntry
	ReceiveLimit(16384, ProtocolDefault)
end

fn empty_peer_settings() -> PeerSettingsState
	PeerSettings(NoPeerMaxFrameSize, NoPeerInitialWindowSize, NoPeerEnablePush, NoPeerMaxConcurrentStreams, NoPeerHeaderTableSize, NoPeerMaxHeaderListSize, NoLocalSentEnablePush)
end

fn default_receive_flow_control() -> ReceiveFlowControl
	ReceiveFlowControl(65535, NoOpenStreamReceiveWindow)
end

fn concurrent_stream_receive_limit() -> Int
	1
end

fn concurrent_stream_receive_limit_provenance() -> String
	"local_configuration"
end

fn receive_limit_value(receive_limit: ReceiveLimitEntry) -> Int
	match receive_limit
		ReceiveLimit(value, _) => value
	end
end

fn receive_limit_provenance_label(receive_limit: ReceiveLimitEntry) -> String
	match receive_limit
		ReceiveLimit(_, ProtocolDefault) => "protocol_default"
		ReceiveLimit(_, LocalConfiguration) => "local_configuration"
		ReceiveLimit(_, LocalSettingsItem(_)) => "local_settings_item"
	end
end

fn header_list_receive_limit() -> ReceiveLimitEntry
	ReceiveLimit(13, LocalConfiguration)
end

fn header_table_receive_limit() -> ReceiveLimitEntry
	ReceiveLimit(160, LocalConfiguration)
end

fn decode_sized_frame(pending: ByteChunk, next_offset: Int, continuation: PendingContinuation, hpack_state: HpackFixtureState, receive_limit: ReceiveLimitEntry, peer_settings: PeerSettingsState, shutdown_state: ConnectionShutdownState, receive_flow_control: ReceiveFlowControl, available: Int, length: Int, kind: Int, flags: Int, stream_id: Int, header_preview: ByteChunk) -> Result<Http2Step, String>
	let frame_count_int: Int = 9 + length
	match available < frame_count_int
		true => Ok(Waiting(State(pending, next_offset, AfterPreface, continuation, hpack_state, receive_limit, peer_settings, shutdown_state, receive_flow_control)))
		false => decode_complete_frame(pending, next_offset, continuation, hpack_state, receive_limit, peer_settings, shutdown_state, receive_flow_control, length, kind, flags, stream_id, frame_count_int, header_preview)
	end
end

fn decode_complete_frame(pending: ByteChunk, next_offset: Int, continuation: PendingContinuation, hpack_state: HpackFixtureState, receive_limit: ReceiveLimitEntry, peer_settings: PeerSettingsState, shutdown_state: ConnectionShutdownState, receive_flow_control: ReceiveFlowControl, length: Int, kind: Int, flags: Int, stream_id: Int, frame_count_int: Int, header_preview: ByteChunk) -> Result<Http2Step, String>
	let frame_count: ByteCount = byte_count(frame_count_int)?
	let suffix: ByteChunk = byte_drop(pending, frame_count)?
	let payload: ByteChunk = frame_payload_chunk(pending, length)?
	let consumed_state: Http2DecodeState = State(suffix, next_offset + frame_count_int, AfterPreface, continuation, hpack_state, receive_limit, peer_settings, shutdown_state, receive_flow_control)
	let stream_id_decision: ProtocolStreamIdDecision = validate_stream_id_domain(next_offset, kind, stream_id, receive_flow_control)
	match stream_id_decision
		ProtocolStreamIdOk => decode_complete_frame_after_stream_id(pending, suffix, payload, next_offset, frame_count_int, continuation, hpack_state, receive_limit, peer_settings, shutdown_state, receive_flow_control, length, kind, flags, stream_id, consumed_state, header_preview)
		ProtocolStreamIdFailed(error) => Ok(Failed(consumed_state, error))
	end
end

fn decode_complete_frame_after_stream_id(pending: ByteChunk, suffix: ByteChunk, payload: ByteChunk, next_offset: Int, frame_count_int: Int, continuation: PendingContinuation, hpack_state: HpackFixtureState, receive_limit: ReceiveLimitEntry, peer_settings: PeerSettingsState, shutdown_state: ConnectionShutdownState, receive_flow_control: ReceiveFlowControl, length: Int, kind: Int, flags: Int, stream_id: Int, consumed_state: Http2DecodeState, header_preview: ByteChunk) -> Result<Http2Step, String>
	let settings_decision: SettingsRangeDecision = validate_settings_value(pending, next_offset, length, kind, flags)?
	let priority_decision: PriorityDependencyDecision = validate_priority_dependency(next_offset, payload, length, kind, flags, stream_id)?
	let payload_decision: ProtocolPayloadDecision = validate_protocol_payload(next_offset, payload, length, kind, flags, stream_id)?
	match settings_decision
		SettingsValueOk => match payload_decision
			ProtocolPayloadOk => match priority_decision
				PriorityDependencyOk => match validate_continuation(continuation, next_offset, continuation_payload_chunk(payload, kind, flags)?, kind, flags, stream_id, frame_promised_stream_id(payload, kind)?, peer_settings, receive_flow_control, header_preview)
					Ok(Decision(next_continuation, completed_header_block, completed_end_stream, completed_is_trailer, completed_promised_stream_id)) => complete_after_data_padding(pending, suffix, next_offset, frame_count_int, next_continuation, hpack_state, receive_limit, peer_settings, shutdown_state, receive_flow_control, length, kind, flags, stream_id, completed_header_block, completed_end_stream, completed_is_trailer, completed_promised_stream_id, consumed_state, payload)
					Err(error) => Ok(Failed(consumed_state, error))
				end
				PriorityDependencyFailed(error) => Ok(Failed(consumed_state, error))
			end
			ProtocolPayloadFailed(error) => Ok(Failed(consumed_state, error))
		end
		SettingsValueFailed(error) => Ok(Failed(consumed_state, error))
	end
end

fn complete_after_data_padding(pending: ByteChunk, suffix: ByteChunk, next_offset: Int, frame_count_int: Int, next_continuation: PendingContinuation, hpack_state: HpackFixtureState, receive_limit: ReceiveLimitEntry, peer_settings: PeerSettingsState, shutdown_state: ConnectionShutdownState, receive_flow_control: ReceiveFlowControl, length: Int, kind: Int, flags: Int, stream_id: Int, completed_header_block: ByteChunk, completed_end_stream: Bool, completed_is_trailer: Bool, completed_promised_stream_id: Int, consumed_state: Http2DecodeState, payload: ByteChunk) -> Result<Http2Step, String>
	let padding_decision: PaddingDecision = validate_data_padding(next_offset, payload, length, kind, flags, stream_id, receive_flow_control)?
	match padding_decision
		PaddingOk => complete_receive_flow_control_update(pending, suffix, next_offset, frame_count_int, next_continuation, hpack_state, receive_limit, peer_settings, shutdown_state, receive_flow_control, length, kind, flags, stream_id, completed_header_block, completed_end_stream, completed_is_trailer, completed_promised_stream_id, consumed_state)
		PaddingFailed(error) => Ok(Failed(consumed_state, error))
	end
end

fn validate_priority_dependency(offset: Int, payload: ByteChunk, length: Int, kind: Int, flags: Int, stream_id: Int) -> Result<PriorityDependencyDecision, String>
	match kind
		2 => match length == 5
			true => validate_priority_dependency_payload(offset, payload, stream_id)
			false => Ok(PriorityDependencyOk)
		end
		_ => match headers_priority_set(kind, flags)
			true => match length >= 5
				true => validate_priority_dependency_payload(offset, payload, stream_id)
				false => Ok(PriorityDependencyOk)
			end
			false => Ok(PriorityDependencyOk)
		end
	end
end

fn validate_priority_dependency_payload(offset: Int, payload: ByteChunk, stream_id: Int) -> Result<PriorityDependencyDecision, String>
	let payload_view: ByteView = byte_view(payload, byte_offset(0)?, byte_count(5)?)?
	let dependency_stream_id: Int = priority_dependency_stream_id(payload_view)?
	match dependency_stream_id == stream_id
		true => Ok(PriorityDependencyFailed(InvalidPriorityDependency(offset, stream_id, dependency_stream_id, "stream-control", "rfc9113_priority_dependency", payload_view)))
		false => Ok(PriorityDependencyOk)
	end
end

fn frame_payload_chunk(frame: ByteChunk, length: Int) -> Result<ByteChunk, String>
	let payload_offset: ByteOffset = byte_offset(9)?
	let payload_count: ByteCount = byte_count(length)?
	Ok(byte_view_to_chunk(byte_view(frame, payload_offset, payload_count)?))
end

fn validate_stream_id_domain(offset: Int, kind: Int, stream_id: Int, receive_flow_control: ReceiveFlowControl) -> ProtocolStreamIdDecision
	match kind
		4 => require_connection_stream_id(offset, kind, stream_id)
		6 => require_connection_stream_id(offset, kind, stream_id)
		7 => require_connection_stream_id(offset, kind, stream_id)
		0 => require_peer_stream_id(offset, kind, stream_id, receive_flow_control)
		1 => require_peer_stream_id(offset, kind, stream_id, receive_flow_control)
		3 => require_peer_stream_id(offset, kind, stream_id, receive_flow_control)
		9 => require_peer_stream_id(offset, kind, stream_id, receive_flow_control)
		8 => validate_window_update_stream_id(offset, kind, stream_id, receive_flow_control)
		2 => require_peer_stream_id(offset, kind, stream_id, receive_flow_control)
		5 => require_client_stream_id(offset, kind, stream_id)
		_ => ProtocolStreamIdOk
	end
end

fn validate_window_update_stream_id(offset: Int, kind: Int, stream_id: Int, receive_flow_control: ReceiveFlowControl) -> ProtocolStreamIdDecision
	match stream_id
		0 => ProtocolStreamIdOk
		_ => require_peer_stream_id(offset, kind, stream_id, receive_flow_control)
	end
end

fn require_peer_stream_id(offset: Int, kind: Int, stream_id: Int, receive_flow_control: ReceiveFlowControl) -> ProtocolStreamIdDecision
	match stream_id_is_reserved_by_peer(stream_id, receive_flow_control)
		true => ProtocolStreamIdOk
		false => require_client_stream_id(offset, kind, stream_id)
	end
end

fn stream_id_is_reserved_by_peer(stream_id: Int, receive_flow_control: ReceiveFlowControl) -> Bool
	match receive_flow_control
		ReceiveFlowControl(_, TwoOpenStreamReceiveWindows(_, _, _, promised_stream_id, _, _)) => stream_id == promised_stream_id
		ReceiveFlowControl(_, ClientPushAssociatedStreamReceiveWindow(_, _, _, promised_stream_id)) => stream_id == promised_stream_id
		ReceiveFlowControl(_, _) => false
	end
end

fn require_connection_stream_id(offset: Int, kind: Int, stream_id: Int) -> ProtocolStreamIdDecision
	match stream_id
		0 => ProtocolStreamIdOk
		_ => ProtocolStreamIdFailed(InvalidStreamId(offset, kind, stream_id, "connection stream id zero", "server", "stream-id-domain", "connection_frames_require_stream_zero"))
	end
end

fn require_client_stream_id(offset: Int, kind: Int, stream_id: Int) -> ProtocolStreamIdDecision
	match stream_id
		0 => ProtocolStreamIdFailed(InvalidStreamId(offset, kind, stream_id, "nonzero client-initiated stream id", "server", "stream-id-domain", "server_receives_client_initiated_streams"))
		_ => match stream_id_is_client_initiated(stream_id)
			true => ProtocolStreamIdOk
			false => ProtocolStreamIdFailed(InvalidStreamId(offset, kind, stream_id, "nonzero client-initiated stream id", "server", "stream-id-domain", "server_receives_client_initiated_streams"))
		end
	end
end

fn stream_id_is_client_initiated(stream_id: Int) -> Bool
	(stream_id / 2) * 2 != stream_id
end

fn complete_receive_flow_control_update(pending: ByteChunk, suffix: ByteChunk, next_offset: Int, frame_count_int: Int, next_continuation: PendingContinuation, hpack_state: HpackFixtureState, receive_limit: ReceiveLimitEntry, peer_settings: PeerSettingsState, shutdown_state: ConnectionShutdownState, receive_flow_control: ReceiveFlowControl, length: Int, kind: Int, flags: Int, stream_id: Int, completed_header_block: ByteChunk, completed_end_stream: Bool, completed_is_trailer: Bool, completed_promised_stream_id: Int, consumed_state: Http2DecodeState) -> Result<Http2Step, String>
	match decode_completed_header_list(next_offset, kind, flags, stream_id, completed_header_block, hpack_state)
		HeaderListDecodeOk(decoded_header_list_size, next_hpack_state, headers) => match validate_header_table_size_update(next_offset, kind, flags, stream_id, completed_header_block, headers, next_hpack_state)
			HeaderTableSizeOk => match validate_header_list_size(next_offset, kind, flags, stream_id, decoded_header_list_size, completed_header_block)
				HeaderListSizeOk => match validate_trailer_end_stream(next_offset, kind, stream_id, headers, completed_is_trailer, state_receive_flow_control(consumed_state))
					TrailerEndStreamOk => match validate_trailer_header_list(next_offset, kind, flags, stream_id, headers, completed_header_block, completed_is_trailer, state_receive_flow_control(consumed_state))
						TrailerHeaderListOk => match completed_is_trailer
							true => complete_after_header_list_size(pending, next_continuation, next_hpack_state, length, kind, flags, stream_id, completed_header_block, completed_end_stream, completed_promised_stream_id, headers, completed_is_trailer, consumed_state)
							false => match validate_request_header_list(next_offset, kind, flags, stream_id, headers, completed_header_block)
								RequestHeaderListOk => match validate_response_header_list(next_offset, kind, flags, stream_id, headers, completed_header_block)
									ResponseHeaderListOk => complete_after_header_list_size(pending, next_continuation, next_hpack_state, length, kind, flags, stream_id, completed_header_block, completed_end_stream, completed_promised_stream_id, headers, completed_is_trailer, consumed_state)
									ResponseHeaderListFailed(error) => Ok(Failed(consumed_state, error))
								end
								RequestHeaderListFailed(error) => Ok(Failed(consumed_state, error))
							end
						end
						TrailerHeaderListFailed(error) => Ok(Failed(consumed_state, error))
					end
					TrailerEndStreamFailed(error) => Ok(Failed(consumed_state, error))
				end
				HeaderListSizeFailed(error) => Ok(Failed(consumed_state, error))
			end
			HeaderTableSizeFailed(error) => Ok(Failed(consumed_state, error))
		end
		HeaderListDecodeFailed(error) => Ok(Failed(consumed_state, error))
	end
end

fn complete_after_header_list_size(pending: ByteChunk, next_continuation: PendingContinuation, next_hpack_state: HpackFixtureState, length: Int, kind: Int, flags: Int, stream_id: Int, completed_header_block: ByteChunk, completed_end_stream: Bool, completed_promised_stream_id: Int, headers: HpackHeaderList, completed_is_trailer: Bool, consumed_state: Http2DecodeState) -> Result<Http2Step, String>
	let frame_offset: Int = state_next_offset(consumed_state) - (9 + length)
	let flow_control_decision: ReceiveFlowControlDecision = update_receive_flow_control(pending, frame_offset, length, kind, flags, stream_id, completed_end_stream, completed_promised_stream_id, accepted_content_length_for_stream(headers, completed_is_trailer), headers, completed_is_trailer, state_shutdown_state_value(consumed_state), state_receive_flow_control(consumed_state))?
	match flow_control_decision
		ReceiveFlowControlOk(next_receive_flow_control) => match update_shutdown_state(pending, frame_offset, length, kind, state_shutdown_state_value(consumed_state))?
			ShutdownStateOk(next_shutdown_state) => Ok(FrameDecoded(State(state_pending_chunk(consumed_state), state_next_offset(consumed_state), AfterPreface, next_continuation, next_hpack_state, state_receive_limit(consumed_state), update_peer_settings(pending, frame_offset, length, kind, flags, state_peer_settings(consumed_state))?, next_shutdown_state, update_initial_window_receive_credit(pending, frame_offset, length, kind, flags, state_peer_settings(consumed_state), next_receive_flow_control)?), frame_offset, length, kind, flags, stream_id, completed_header_block, frame_value(pending, length, kind, flags, stream_id)?))
			ShutdownStateFailed(error) => Ok(Failed(consumed_state, error))
		end
		ReceiveFlowControlFailed(error) => Ok(Failed(consumed_state, error))
	end
end

fn decode_completed_header_list(offset: Int, kind: Int, flags: Int, stream_id: Int, completed_header_block: ByteChunk, hpack_state: HpackFixtureState) -> HeaderListDecodeDecision
	match header_list_boundary_reached(kind, flags)
		true => decode_completed_static_or_fixture_header_list(offset, kind, stream_id, completed_header_block, hpack_state)
		false => HeaderListDecodeOk(byte_count_to_int(byte_chunk_count(completed_header_block)), hpack_state, hpack_fixture::incomplete_header_list())
	end
end

fn decode_completed_static_or_fixture_header_list(offset: Int, kind: Int, stream_id: Int, completed_header_block: ByteChunk, hpack_state: HpackFixtureState) -> HeaderListDecodeDecision
	match hpack_block_updates_fixture_dynamic_table(completed_header_block)
		true => decode_completed_fixture_header_list(offset, kind, stream_id, completed_header_block, hpack_state)
		false => match hpack_static::decode_header_block(completed_header_block, offset)
			Ok(headers) => HeaderListDecodeOk(hpack_fixture::header_list_wire_size(headers), hpack_state, headers)
			Err(static_failure) => match hpack_static::hpack_static_failure_is_not_static(static_failure)
				true => decode_completed_fixture_header_list(offset, kind, stream_id, completed_header_block, hpack_state)
				false => HeaderListDecodeFailed(HpackFixtureDecodeFailed(hpack_static::hpack_static_failure_offset(static_failure), hpack_static::hpack_static_failure_observed_size(static_failure), hpack_static::hpack_static_failure_observed_first_byte(static_failure), 0, 0, hpack_static::hpack_static_failure_expected_header(static_failure), hpack_static::hpack_static_failure_decoder_module(static_failure), hpack_static::hpack_static_failure_preview(static_failure)))
			end
		end
	end
end

fn hpack_block_first_byte_or_missing(block: ByteChunk) -> Int
	match read_byte(block, 0)
		Ok(value) => value
		Err(_) => -1
	end
end

fn hpack_block_updates_fixture_dynamic_table(block: ByteChunk) -> Bool
	let first_byte: Int = hpack_block_first_byte_or_missing(block)
	first_byte >= 64 and first_byte < 128
end

fn decode_completed_fixture_header_list(offset: Int, kind: Int, stream_id: Int, completed_header_block: ByteChunk, hpack_state: HpackFixtureState) -> HeaderListDecodeDecision
	match hpack_fixture::decode_header_block(completed_header_block, hpack_state, offset)
		Ok(transition) => HeaderListDecodeOk(hpack_fixture::header_list_wire_size(hpack_fixture::transition_headers(transition)), hpack_fixture::transition_state(transition), hpack_fixture::transition_headers(transition))
		Err(failure) => match hpack_fixture::hpack_failure_expected_fixture(failure) == "fixture HPACK table-size update at header block start" or hpack_fixture::hpack_failure_expected_fixture(failure) == "fixture HPACK table-size update without trailing bytes"
			true => HeaderListDecodeFailed(HpackTableSizeUpdateNotAtStart(hpack_fixture::hpack_failure_offset(failure), hpack_fixture::hpack_failure_observed_size(failure), hpack_fixture::hpack_failure_observed_first_byte(failure), hpack_fixture::hpack_failure_observed_update_size(failure), kind, stream_id, "hpack-fixture", hpack_fixture::hpack_failure_expected_fixture(failure), hpack_fixture::hpack_failure_codec_module(failure), hpack_fixture::hpack_failure_preview(failure)))
			false => HeaderListDecodeFailed(HpackFixtureDecodeFailed(hpack_fixture::hpack_failure_offset(failure), hpack_fixture::hpack_failure_observed_size(failure), hpack_fixture::hpack_failure_observed_first_byte(failure), hpack_fixture::hpack_failure_requested_dynamic_index(failure), hpack_fixture::hpack_failure_dynamic_table_entry_count(failure), hpack_fixture::hpack_failure_expected_fixture(failure), hpack_fixture::hpack_failure_codec_module(failure), hpack_fixture::hpack_failure_preview(failure)))
		end
	end
end

fn validate_header_list_size(offset: Int, kind: Int, flags: Int, stream_id: Int, decoded_header_list_size: Int, completed_header_block: ByteChunk) -> HeaderListSizeDecision
	match header_list_boundary_reached(kind, flags)
		true => validate_completed_header_list_size(offset, kind, stream_id, decoded_header_list_size, header_list_receive_limit(), completed_header_block)
		false => HeaderListSizeOk
	end
end

fn validate_header_table_size_update(offset: Int, kind: Int, flags: Int, stream_id: Int, completed_header_block: ByteChunk, headers: HpackHeaderList, next_hpack_state: HpackFixtureState) -> HeaderTableSizeDecision
	match header_list_boundary_reached(kind, flags) and hpack_fixture::header_list_is_table_size_update(headers)
		true => validate_completed_header_table_size_update(offset, kind, stream_id, hpack_fixture::state_table_size(next_hpack_state), header_table_receive_limit(), completed_header_block)
		false => HeaderTableSizeOk
	end
end

fn header_list_boundary_reached(kind: Int, flags: Int) -> Bool
	match kind
		1 => end_headers_set(flags)
		9 => end_headers_set(flags)
		5 => end_headers_set(flags)
		_ => false
	end
end

fn accepted_content_length_for_stream(headers: HpackHeaderList, completed_is_trailer: Bool) -> Int
	match completed_is_trailer
		true => -1
		false => hpack_fixture::header_list_accepted_content_length(headers)
	end
end

fn validate_completed_header_list_size(offset: Int, kind: Int, stream_id: Int, observed_size: Int, receive_limit: ReceiveLimitEntry, completed_header_block: ByteChunk) -> HeaderListSizeDecision
	let allowed_size: Int = receive_limit_value(receive_limit)
	match observed_size > allowed_size
		true => HeaderListSizeFailed(HeaderListSizeExceeded(offset, observed_size, receive_limit, kind, stream_id, "header_list_receive_limit", completed_header_block))
		false => HeaderListSizeOk
	end
end

fn validate_completed_header_table_size_update(offset: Int, kind: Int, stream_id: Int, observed_size: Int, receive_limit: ReceiveLimitEntry, completed_header_block: ByteChunk) -> HeaderTableSizeDecision
	let allowed_size: Int = receive_limit_value(receive_limit)
	match observed_size > allowed_size
		true => HeaderTableSizeFailed(HeaderTableSizeExceeded(offset, observed_size, receive_limit, kind, stream_id, "hpack_dynamic_table_size_update", completed_header_block))
		false => HeaderTableSizeOk
	end
end

fn validate_request_header_list(offset: Int, kind: Int, flags: Int, stream_id: Int, headers: HpackHeaderList, completed_header_block: ByteChunk) -> RequestHeaderListDecision
	match header_list_boundary_reached(kind, flags) and hpack_fixture::header_list_is_request(headers)
		false => RequestHeaderListOk
		true => validate_completed_request_header_list(offset, kind, stream_id, headers, completed_header_block)
	end
end

fn validate_completed_request_header_list(offset: Int, kind: Int, stream_id: Int, headers: HpackHeaderList, completed_header_block: ByteChunk) -> RequestHeaderListDecision
	match hpack_fixture::header_list_has_duplicate_pseudo_header(headers)
		true => RequestHeaderListFailed(InvalidRequestHeaderList(offset, kind, stream_id, "duplicate_pseudo_header", ":method", hpack_fixture::header_list_decoded_names(headers), completed_header_block))
		false => match hpack_fixture::header_list_has_pseudo_header_after_regular(headers)
			true => RequestHeaderListFailed(InvalidRequestHeaderList(offset, kind, stream_id, "pseudo_header_after_regular_header", ":method", hpack_fixture::header_list_decoded_names(headers), completed_header_block))
			false => match hpack_fixture::header_list_has_status(headers)
				true => RequestHeaderListFailed(InvalidRequestHeaderList(offset, kind, stream_id, "response_only_pseudo_header", ":status", hpack_fixture::header_list_decoded_names(headers), completed_header_block))
				false => match hpack_fixture::header_list_has_method(headers)
					false => RequestHeaderListFailed(InvalidRequestHeaderList(offset, kind, stream_id, "missing_required_pseudo_header", ":method", hpack_fixture::header_list_decoded_names(headers), completed_header_block))
					true => match hpack_fixture::header_list_has_scheme(headers)
						false => RequestHeaderListFailed(InvalidRequestHeaderList(offset, kind, stream_id, "missing_required_pseudo_header", ":scheme", hpack_fixture::header_list_decoded_names(headers), completed_header_block))
						true => match hpack_fixture::header_list_has_path(headers)
							false => RequestHeaderListFailed(InvalidRequestHeaderList(offset, kind, stream_id, "missing_required_pseudo_header", ":path", hpack_fixture::header_list_decoded_names(headers), completed_header_block))
							true => match hpack_fixture::header_list_has_empty_method_value(headers)
								true => RequestHeaderListFailed(InvalidRequestHeaderList(offset, kind, stream_id, "method_value_empty", ":method", hpack_fixture::header_list_decoded_names(headers), completed_header_block))
								false => match hpack_fixture::header_list_has_empty_path_value(headers)
									true => RequestHeaderListFailed(InvalidRequestHeaderList(offset, kind, stream_id, "path_value_empty", ":path", hpack_fixture::header_list_decoded_names(headers), completed_header_block))
									false => match hpack_fixture::header_list_has_invalid_scheme_value(headers)
										true => RequestHeaderListFailed(InvalidRequestHeaderList(offset, kind, stream_id, "scheme_value_not_http_or_https", ":scheme", hpack_fixture::header_list_decoded_names(headers), completed_header_block))
										false => match hpack_fixture::header_list_has_invalid_authority_value(headers)
											true => RequestHeaderListFailed(InvalidRequestHeaderList(offset, kind, stream_id, "authority_value_invalid", ":authority", hpack_fixture::header_list_decoded_names(headers), completed_header_block))
											false => match hpack_fixture::header_list_has_uppercase_ordinary_header(headers)
												true => RequestHeaderListFailed(InvalidRequestHeaderList(offset, kind, stream_id, "ordinary_header_name_not_lowercase", hpack_fixture::header_list_invalid_ordinary_header_name(headers), hpack_fixture::header_list_decoded_names(headers), completed_header_block))
												false => match hpack_fixture::header_list_has_invalid_token_ordinary_header(headers)
													true => RequestHeaderListFailed(InvalidRequestHeaderList(offset, kind, stream_id, "ordinary_header_name_invalid_token", hpack_fixture::header_list_invalid_ordinary_header_name(headers), hpack_fixture::header_list_decoded_names(headers), completed_header_block))
													false => match hpack_fixture::header_list_has_connection_specific_header(headers)
														true => RequestHeaderListFailed(InvalidRequestHeaderList(offset, kind, stream_id, "connection_specific_header", hpack_fixture::header_list_connection_specific_header_name(headers), hpack_fixture::header_list_decoded_names(headers), completed_header_block))
														false => match hpack_fixture::header_list_has_invalid_te_header_value(headers)
															true => RequestHeaderListFailed(InvalidRequestHeaderList(offset, kind, stream_id, "te_header_value_not_trailers", "te", hpack_fixture::header_list_decoded_names(headers), completed_header_block))
															false => match hpack_fixture::request_header_list_has_invalid_content_length(headers)
																true => RequestHeaderListFailed(InvalidRequestHeaderList(offset, kind, stream_id, "content_length_invalid", "content-length", hpack_fixture::header_list_decoded_names(headers), completed_header_block))
																false => match hpack_fixture::request_header_list_has_mismatched_content_length(headers)
																	true => RequestHeaderListFailed(InvalidRequestHeaderList(offset, kind, stream_id, "content_length_mismatch", "content-length", hpack_fixture::header_list_decoded_names(headers), completed_header_block))
																	false => RequestHeaderListOk
																end
															end
														end
													end
												end
											end
										end
									end
							end
						end
					end
				end
			end
		end
		end
	end
end

fn validate_response_header_list(offset: Int, kind: Int, flags: Int, stream_id: Int, headers: HpackHeaderList, completed_header_block: ByteChunk) -> ResponseHeaderListDecision
	match header_list_boundary_reached(kind, flags) and hpack_fixture::header_list_is_response(headers)
		false => ResponseHeaderListOk
		true => validate_completed_response_header_list(offset, kind, stream_id, headers, completed_header_block)
	end
end

fn validate_trailer_end_stream(offset: Int, kind: Int, stream_id: Int, headers: HpackHeaderList, completed_is_trailer: Bool, receive_flow_control: ReceiveFlowControl) -> TrailerEndStreamDecision
	match hpack_fixture::header_list_is_trailer(headers) and not completed_is_trailer
		true => TrailerEndStreamFailed(InvalidFrameKind(offset, kind, stream_id, 1, trailer_active_state(stream_id, receive_flow_control), trailer_end_stream_rule(stream_id, receive_flow_control)))
		false => TrailerEndStreamOk
	end
end

fn trailer_active_state(stream_id: Int, receive_flow_control: ReceiveFlowControl) -> String
	match stream_is_response_for_trailers(stream_id, receive_flow_control)
		true => "response-trailers"
		false => "request-trailers"
	end
end

fn trailer_end_stream_rule(stream_id: Int, receive_flow_control: ReceiveFlowControl) -> String
	match stream_is_response_for_trailers(stream_id, receive_flow_control)
		true => "response_trailers_require_end_stream"
		false => "request_trailers_require_end_stream"
	end
end

fn stream_is_response_for_trailers(stream_id: Int, receive_flow_control: ReceiveFlowControl) -> Bool
	match receive_flow_control
		ReceiveFlowControl(_, OpenStreamReceiveWindow(open_stream_id, _, priority)) => stream_id == open_stream_id and stream_priority_is_response(priority)
		ReceiveFlowControl(_, TwoOpenStreamReceiveWindows(first_stream_id, _, first_priority, second_stream_id, _, second_priority)) => match stream_id == first_stream_id
			true => stream_priority_is_response(first_priority)
			false => stream_id == second_stream_id and stream_priority_is_response(second_priority)
		end
		ReceiveFlowControl(_, ClientPushAssociatedStreamReceiveWindow(open_stream_id, _, priority, _)) => stream_id == open_stream_id and stream_priority_is_response(priority)
		ReceiveFlowControl(_, HalfClosedLocalStreamReceiveWindow(open_stream_id, _, priority)) => stream_id == open_stream_id and stream_priority_is_response(priority)
		ReceiveFlowControl(_, _) => false
	end
end

fn stream_priority_is_response(priority: StreamPriorityState) -> Bool
	match priority
		ResponseHeaderStream(_) => true
		ExpectedContentLength(_, _, inner) => stream_priority_is_response(inner)
		_ => false
	end
end

fn validate_completed_response_header_list(offset: Int, kind: Int, stream_id: Int, headers: HpackHeaderList, completed_header_block: ByteChunk) -> ResponseHeaderListDecision
	match hpack_fixture::header_list_has_duplicate_status(headers)
		true => ResponseHeaderListFailed(InvalidResponseHeaderList(offset, kind, stream_id, "duplicate_pseudo_header", ":status", hpack_fixture::header_list_decoded_names(headers), "response-headers", completed_header_block))
		false => match hpack_fixture::header_list_has_pseudo_header_after_regular(headers)
			true => ResponseHeaderListFailed(InvalidResponseHeaderList(offset, kind, stream_id, "pseudo_header_after_regular_header", ":status", hpack_fixture::header_list_decoded_names(headers), "response-headers", completed_header_block))
			false => match hpack_fixture::header_list_has_authority(headers)
				true => ResponseHeaderListFailed(InvalidResponseHeaderList(offset, kind, stream_id, "request_only_pseudo_header", ":authority", hpack_fixture::header_list_decoded_names(headers), "response-headers", completed_header_block))
				false => match hpack_fixture::header_list_has_method(headers)
					true => ResponseHeaderListFailed(InvalidResponseHeaderList(offset, kind, stream_id, "request_only_pseudo_header", ":method", hpack_fixture::header_list_decoded_names(headers), "response-headers", completed_header_block))
					false => match hpack_fixture::header_list_has_scheme(headers)
						true => ResponseHeaderListFailed(InvalidResponseHeaderList(offset, kind, stream_id, "request_only_pseudo_header", ":scheme", hpack_fixture::header_list_decoded_names(headers), "response-headers", completed_header_block))
						false => match hpack_fixture::header_list_has_path(headers)
							true => ResponseHeaderListFailed(InvalidResponseHeaderList(offset, kind, stream_id, "request_only_pseudo_header", ":path", hpack_fixture::header_list_decoded_names(headers), "response-headers", completed_header_block))
							false => match hpack_fixture::header_list_has_status(headers)
								false => ResponseHeaderListFailed(InvalidResponseHeaderList(offset, kind, stream_id, "missing_required_pseudo_header", ":status", hpack_fixture::header_list_decoded_names(headers), "response-headers", completed_header_block))
								true => match hpack_fixture::header_list_has_uppercase_ordinary_header(headers)
									true => ResponseHeaderListFailed(InvalidResponseHeaderList(offset, kind, stream_id, "ordinary_header_name_not_lowercase", hpack_fixture::header_list_invalid_ordinary_header_name(headers), hpack_fixture::header_list_decoded_names(headers), "response-headers", completed_header_block))
									false => match hpack_fixture::header_list_has_invalid_token_ordinary_header(headers)
										true => ResponseHeaderListFailed(InvalidResponseHeaderList(offset, kind, stream_id, "ordinary_header_name_invalid_token", hpack_fixture::header_list_invalid_ordinary_header_name(headers), hpack_fixture::header_list_decoded_names(headers), "response-headers", completed_header_block))
										false => match hpack_fixture::header_list_has_invalid_te_header_value(headers)
											true => ResponseHeaderListFailed(InvalidResponseHeaderList(offset, kind, stream_id, "te_header_value_not_trailers", "te", hpack_fixture::header_list_decoded_names(headers), "response-headers", completed_header_block))
											false => match hpack_fixture::header_list_has_invalid_content_length(headers)
												true => ResponseHeaderListFailed(InvalidResponseHeaderList(offset, kind, stream_id, "content_length_invalid", "content-length", hpack_fixture::header_list_decoded_names(headers), "response-headers", completed_header_block))
												false => match hpack_fixture::header_list_has_mismatched_content_length(headers)
													true => ResponseHeaderListFailed(InvalidResponseHeaderList(offset, kind, stream_id, "content_length_mismatch", "content-length", hpack_fixture::header_list_decoded_names(headers), "response-headers", completed_header_block))
													false => ResponseHeaderListOk
												end
											end
										end
									end
								end
							end
						end
					end
				end
			end
		end
	end
end

fn validate_trailer_header_list(offset: Int, kind: Int, flags: Int, stream_id: Int, headers: HpackHeaderList, completed_header_block: ByteChunk, completed_is_trailer: Bool, receive_flow_control: ReceiveFlowControl) -> TrailerHeaderListDecision
	match header_list_boundary_reached(kind, flags) and completed_is_trailer
		false => TrailerHeaderListOk
		true => match stream_is_response_for_trailers(stream_id, receive_flow_control)
			true => validate_completed_response_trailer_header_list(offset, kind, stream_id, headers, completed_header_block)
			false => validate_completed_request_trailer_header_list(offset, kind, stream_id, headers, completed_header_block)
		end
	end
end

fn validate_completed_request_trailer_header_list(offset: Int, kind: Int, stream_id: Int, headers: HpackHeaderList, completed_header_block: ByteChunk) -> TrailerHeaderListDecision
	match hpack_fixture::header_list_has_pseudo_header(headers)
		true => TrailerHeaderListFailed(InvalidRequestHeaderList(offset, kind, stream_id, "trailer_pseudo_header", hpack_fixture::header_list_first_pseudo_header_name(headers), hpack_fixture::header_list_decoded_names(headers), completed_header_block))
		false => match hpack_fixture::header_list_has_uppercase_ordinary_header(headers)
			true => TrailerHeaderListFailed(InvalidRequestHeaderList(offset, kind, stream_id, "ordinary_header_name_not_lowercase", hpack_fixture::header_list_invalid_ordinary_header_name(headers), hpack_fixture::header_list_decoded_names(headers), completed_header_block))
			false => match hpack_fixture::header_list_has_invalid_token_ordinary_header(headers)
				true => TrailerHeaderListFailed(InvalidRequestHeaderList(offset, kind, stream_id, "ordinary_header_name_invalid_token", hpack_fixture::header_list_invalid_ordinary_header_name(headers), hpack_fixture::header_list_decoded_names(headers), completed_header_block))
				false => match hpack_fixture::header_list_has_connection_specific_header(headers)
					true => TrailerHeaderListFailed(InvalidRequestHeaderList(offset, kind, stream_id, "connection_specific_header", hpack_fixture::header_list_connection_specific_header_name(headers), hpack_fixture::header_list_decoded_names(headers), completed_header_block))
					false => match hpack_fixture::header_list_has_invalid_te_header_value(headers)
						true => TrailerHeaderListFailed(InvalidRequestHeaderList(offset, kind, stream_id, "te_header_value_not_trailers", "te", hpack_fixture::header_list_decoded_names(headers), completed_header_block))
						false => TrailerHeaderListOk
					end
				end
			end
		end
	end
end

fn validate_completed_response_trailer_header_list(offset: Int, kind: Int, stream_id: Int, headers: HpackHeaderList, completed_header_block: ByteChunk) -> TrailerHeaderListDecision
	match hpack_fixture::header_list_has_pseudo_header(headers)
		true => TrailerHeaderListFailed(InvalidResponseHeaderList(offset, kind, stream_id, "trailer_pseudo_header", hpack_fixture::header_list_first_pseudo_header_name(headers), hpack_fixture::header_list_decoded_names(headers), "response-trailers", completed_header_block))
		false => match hpack_fixture::header_list_has_uppercase_ordinary_header(headers)
			true => TrailerHeaderListFailed(InvalidResponseHeaderList(offset, kind, stream_id, "ordinary_header_name_not_lowercase", hpack_fixture::header_list_invalid_ordinary_header_name(headers), hpack_fixture::header_list_decoded_names(headers), "response-trailers", completed_header_block))
			false => match hpack_fixture::header_list_has_invalid_token_ordinary_header(headers)
				true => TrailerHeaderListFailed(InvalidResponseHeaderList(offset, kind, stream_id, "ordinary_header_name_invalid_token", hpack_fixture::header_list_invalid_ordinary_header_name(headers), hpack_fixture::header_list_decoded_names(headers), "response-trailers", completed_header_block))
				false => match hpack_fixture::header_list_has_connection_specific_header(headers)
					true => TrailerHeaderListFailed(InvalidResponseHeaderList(offset, kind, stream_id, "connection_specific_header", hpack_fixture::header_list_connection_specific_header_name(headers), hpack_fixture::header_list_decoded_names(headers), "response-trailers", completed_header_block))
					false => match hpack_fixture::header_list_has_invalid_te_header_value(headers)
						true => TrailerHeaderListFailed(InvalidResponseHeaderList(offset, kind, stream_id, "te_header_value_not_trailers", "te", hpack_fixture::header_list_decoded_names(headers), "response-trailers", completed_header_block))
						false => TrailerHeaderListOk
					end
				end
			end
		end
	end
end

fn frame_value(pending: ByteChunk, length: Int, kind: Int, flags: Int, stream_id: Int) -> Result<Http2Frame, String>
	let payload_chunk: ByteChunk = frame_payload_chunk(pending, length)?
	let payload: ByteView = data_content_view(payload_chunk, length, kind, flags)?
	match kind
		2 => Ok(PriorityFrame(flags, stream_id, priority_dependency_stream_id(payload)?, priority_exclusive(payload)?, priority_weight(payload)?))
		_ => match is_known_frame_kind(kind)
			true => Ok(KnownFrame(kind, flags, stream_id, payload))
			false => Ok(UnknownFrame(kind, flags, stream_id, payload))
		end
	end
end

fn priority_dependency_stream_id(payload: ByteView) -> Result<Int, String>
	let payload_chunk: ByteChunk = byte_view_to_chunk(payload)
	let first_byte: Int = byte_read_u8_be(byte_view(payload_chunk, byte_offset(0)?, byte_count(1)?)?)?
	let second_byte: Int = byte_read_u8_be(byte_view(payload_chunk, byte_offset(1)?, byte_count(1)?)?)?
	let third_byte: Int = byte_read_u8_be(byte_view(payload_chunk, byte_offset(2)?, byte_count(1)?)?)?
	let fourth_byte: Int = byte_read_u8_be(byte_view(payload_chunk, byte_offset(3)?, byte_count(1)?)?)?
	Ok((first_byte - (first_byte / 128) * 128) * 16777216 + second_byte * 65536 + third_byte * 256 + fourth_byte)
end

fn priority_exclusive(payload: ByteView) -> Result<Bool, String>
	let first_byte: Int = byte_read_u8_be(byte_view(byte_view_to_chunk(payload), byte_offset(0)?, byte_count(1)?)?)?
	Ok(first_byte >= 128)
end

fn priority_weight(payload: ByteView) -> Result<Int, String>
	let encoded_weight: Int = byte_read_u8_be(byte_view(byte_view_to_chunk(payload), byte_offset(4)?, byte_count(1)?)?)?
	Ok(encoded_weight + 1)
end

fn is_known_frame_kind(kind: Int) -> Bool
	match kind
		0 => true
		1 => true
		3 => true
		4 => true
		6 => true
		7 => true
		8 => true
		9 => true
		2 => true
		5 => true
		_ => false
	end
end

fn is_unknown_frame_kind(kind: Int) -> Bool
	match is_known_frame_kind(kind)
		true => false
		false => true
	end
end

fn validate_protocol_payload(offset: Int, payload: ByteChunk, length: Int, kind: Int, flags: Int, stream_id: Int) -> Result<ProtocolPayloadDecision, String>
	match kind
		6 => validate_fixed_payload_length(offset, payload, length, kind, stream_id, 8, "connection-control", "rfc9113_ping_payload_length")
		7 => validate_fixed_payload_length(offset, payload, length, kind, stream_id, 8, "connection-control", "rfc9113_goaway_payload_length")
		8 => validate_fixed_payload_length(offset, payload, length, kind, stream_id, 4, "flow-control", "rfc9113_window_update_payload_length")
		4 => validate_settings_ack_payload_length(offset, payload, length, flags, stream_id)
		3 => validate_fixed_payload_length(offset, payload, length, kind, stream_id, 4, "stream-control", "rfc9113_rst_stream_payload_length")
		2 => validate_fixed_payload_length(offset, payload, length, kind, stream_id, 5, "stream-control", "rfc9113_priority_payload_length")
		1 => validate_headers_payload_length(offset, payload, length, kind, flags, stream_id)
		5 => validate_push_promise_payload_length(offset, payload, length, kind, stream_id)
		_ => Ok(ProtocolPayloadOk)
	end
end

fn validate_headers_payload_length(offset: Int, payload: ByteChunk, length: Int, kind: Int, flags: Int, stream_id: Int) -> Result<ProtocolPayloadDecision, String>
	match headers_priority_set(kind, flags) and length < 5
		true => Ok(ProtocolPayloadFailed(InvalidPayloadLength(offset, kind, stream_id, length, 5, "stream-control", "rfc9113_headers_priority_payload_length", byte_view(payload, byte_offset(0)?, byte_count(length)?)?)))
		false => Ok(ProtocolPayloadOk)
	end
end

fn validate_push_promise_payload_length(offset: Int, payload: ByteChunk, length: Int, kind: Int, stream_id: Int) -> Result<ProtocolPayloadDecision, String>
	match length < 4
		true => Ok(ProtocolPayloadFailed(InvalidPayloadLength(offset, kind, stream_id, length, 4, "stream-control", "rfc9113_push_promise_payload_length", byte_view(payload, byte_offset(0)?, byte_count(length)?)?)))
		false => Ok(ProtocolPayloadOk)
	end
end

fn validate_data_padding(offset: Int, payload: ByteChunk, length: Int, kind: Int, flags: Int, stream_id: Int, receive_flow_control: ReceiveFlowControl) -> Result<PaddingDecision, String>
	match kind
		0 => match data_padded_set(flags)
			false => Ok(PaddingOk)
			true => validate_padded_data_payload(offset, payload, length, stream_id, receive_flow_control)
		end
		_ => Ok(PaddingOk)
	end
end

fn validate_padded_data_payload(offset: Int, payload: ByteChunk, length: Int, stream_id: Int, receive_flow_control: ReceiveFlowControl) -> Result<PaddingDecision, String>
	let active_state: String = data_padding_active_state(stream_id, receive_flow_control)
	match length
		0 => Ok(PaddingFailed(InvalidDataPadding(offset, stream_id, 0, -1, active_state, "rfc9113_data_padding", byte_view(payload, byte_offset(0)?, byte_count(length)?)?)))
		_ => match data_pad_length(payload)? > length - 1
			true => Ok(PaddingFailed(InvalidDataPadding(offset + 9, stream_id, data_pad_length(payload)?, length - 1, active_state, "rfc9113_data_padding", byte_view(payload, byte_offset(0)?, byte_count(length)?)?)))
			false => Ok(PaddingOk)
		end
	end
end

fn data_padding_active_state(stream_id: Int, receive_flow_control: ReceiveFlowControl) -> String
	match receive_flow_control
		ReceiveFlowControl(_, TwoOpenStreamReceiveWindows(first_stream_id, _, _, second_stream_id, _, _)) => match stream_id == first_stream_id
			true => "open-stream"
			false => match stream_id == second_stream_id
				true => "open-stream"
				false => "idle-stream"
			end
		end
		ReceiveFlowControl(_, HalfClosedLocalStreamReceiveWindow(open_stream_id, _, _)) => match stream_id == open_stream_id
			true => "half-closed-local-stream"
			false => "open-stream"
		end
		ReceiveFlowControl(_, _) => "open-stream"
	end
end

fn data_content_view(payload: ByteChunk, length: Int, kind: Int, flags: Int) -> Result<ByteView, String>
	match kind
		0 => match data_padded_set(flags)
			false => byte_view(payload, byte_offset(0)?, byte_count(length)?)
			true => padded_data_content_view(payload, length)
		end
		_ => byte_view(payload, byte_offset(0)?, byte_count(length)?)
	end
end

fn data_application_length(payload: ByteChunk, length: Int, flags: Int) -> Result<Int, String>
	Ok(byte_count_to_int(byte_view_count(data_content_view(payload, length, 0, flags)?)))
end

fn padded_data_content_view(payload: ByteChunk, length: Int) -> Result<ByteView, String>
	let pad_length: Int = data_pad_length(payload)?
	byte_view(payload, byte_offset(1)?, byte_count(length - 1 - pad_length)?)
end

fn data_pad_length(payload: ByteChunk) -> Result<Int, String>
	byte_read_u8_be(byte_view(payload, byte_offset(0)?, byte_count(1)?)?)
end

fn settings_ack_set(flags: Int) -> Bool
	(flags / 2) * 2 != flags
end

fn ping_ack_set(flags: Int) -> Bool
	(flags / 2) * 2 != flags
end

fn validate_settings_ack_payload_length(offset: Int, payload: ByteChunk, length: Int, flags: Int, stream_id: Int) -> Result<ProtocolPayloadDecision, String>
	match settings_ack_set(flags)
		true => validate_fixed_payload_length(offset, payload, length, 4, stream_id, 0, "connection-control", "rfc9113_settings_ack_payload_length")
		false => Ok(ProtocolPayloadOk)
	end
end

fn validate_fixed_payload_length(offset: Int, payload: ByteChunk, length: Int, kind: Int, stream_id: Int, expected_length: Int, active_state: String, rule_provenance: String) -> Result<ProtocolPayloadDecision, String>
	match length == expected_length
		true => Ok(ProtocolPayloadOk)
		false => Ok(ProtocolPayloadFailed(InvalidPayloadLength(offset, kind, stream_id, length, expected_length, active_state, rule_provenance, byte_view(payload, byte_offset(0)?, byte_count(length)?)?)))
	end
end

fn validate_settings_value(pending: ByteChunk, next_offset: Int, length: Int, kind: Int, flags: Int) -> Result<SettingsRangeDecision, String>
	match kind
		4 => match settings_ack_set(flags)
			true => Ok(SettingsValueOk)
			false => match settings_payload_has_complete_items(length)
				true => validate_settings_items(pending, next_offset, 9, 9 + length)
				false => Ok(SettingsValueOk)
			end
		end
		_ => Ok(SettingsValueOk)
	end
end

fn settings_payload_has_complete_items(length: Int) -> Bool
	match length > 0
		true => (length / 6) * 6 == length
		false => false
	end
end

fn validate_settings_items(pending: ByteChunk, next_offset: Int, item_wire_offset: Int, payload_end_offset: Int) -> Result<SettingsRangeDecision, String>
	match item_wire_offset == payload_end_offset
		true => Ok(SettingsValueOk)
		false => match validate_single_settings_value(pending, next_offset, item_wire_offset)?
			SettingsValueOk => validate_settings_items(pending, next_offset, item_wire_offset + 6, payload_end_offset)
			SettingsValueFailed(error) => Ok(SettingsValueFailed(error))
		end
	end
end

fn validate_single_settings_value(pending: ByteChunk, next_offset: Int, item_wire_offset: Int) -> Result<SettingsRangeDecision, String>
	let item_offset: ByteOffset = byte_offset(item_wire_offset)?
	let item_count: ByteCount = byte_count(6)?
	let item: ByteView = byte_view(pending, item_offset, item_count)?
	let identifier_count: ByteCount = byte_count(2)?
	let value_offset: ByteOffset = byte_offset(2)?
	let value_count: ByteCount = byte_count(4)?
	let identifier: Int = byte_read_u16_be(byte_view(byte_view_to_chunk(item), byte_offset(0)?, identifier_count)?)?
	let value: Int = byte_read_u32_be(byte_view(byte_view_to_chunk(item), value_offset, value_count)?)?
	match identifier
		5 => validate_max_frame_size_setting(next_offset + item_wire_offset, value, item)
		4 => validate_initial_window_size_setting(next_offset + item_wire_offset, value, item)
		2 => validate_enable_push_setting(next_offset + item_wire_offset, value, item)
		_ => Ok(SettingsValueOk)
	end
end

fn validate_max_frame_size_setting(item_offset: Int, value: Int, preview: ByteView) -> Result<SettingsRangeDecision, String>
	match value < 16384
		true => Ok(SettingsValueFailed(SettingsValueOutOfRange(item_offset, 5, "SETTINGS_MAX_FRAME_SIZE", value, 16384, 16777215, "peer_settings", preview)))
		false => match value > 16777215
			true => Ok(SettingsValueFailed(SettingsValueOutOfRange(item_offset, 5, "SETTINGS_MAX_FRAME_SIZE", value, 16384, 16777215, "peer_settings", preview)))
			false => Ok(SettingsValueOk)
		end
	end
end

fn validate_initial_window_size_setting(item_offset: Int, value: Int, preview: ByteView) -> Result<SettingsRangeDecision, String>
	match value > 2147483647
		true => Ok(SettingsValueFailed(SettingsValueOutOfRange(item_offset, 4, "SETTINGS_INITIAL_WINDOW_SIZE", value, 0, 2147483647, "peer_settings", preview)))
		false => Ok(SettingsValueOk)
	end
end

fn validate_enable_push_setting(item_offset: Int, value: Int, preview: ByteView) -> Result<SettingsRangeDecision, String>
	match value > 1
		true => Ok(SettingsValueFailed(SettingsValueOutOfRange(item_offset, 2, "SETTINGS_ENABLE_PUSH", value, 0, 1, "peer_settings", preview)))
		false => Ok(SettingsValueOk)
	end
end

fn update_peer_settings(pending: ByteChunk, next_offset: Int, length: Int, kind: Int, flags: Int, peer_settings: PeerSettingsState) -> Result<PeerSettingsState, String>
	match kind
		4 => match settings_ack_set(flags)
			true => Ok(peer_settings)
			false => update_settings_frame(pending, next_offset, length, peer_settings)
		end
		_ => Ok(peer_settings)
	end
end

fn update_settings_frame(pending: ByteChunk, next_offset: Int, length: Int, peer_settings: PeerSettingsState) -> Result<PeerSettingsState, String>
	match settings_payload_has_complete_items(length)
		true => update_settings_items(pending, next_offset, 9, 9 + length, peer_settings)
		false => Ok(peer_settings)
	end
end

fn update_settings_items(pending: ByteChunk, next_offset: Int, item_wire_offset: Int, payload_end_offset: Int, peer_settings: PeerSettingsState) -> Result<PeerSettingsState, String>
	match item_wire_offset == payload_end_offset
		true => Ok(peer_settings)
		false => update_settings_items(pending, next_offset, item_wire_offset + 6, payload_end_offset, update_single_settings_item(pending, next_offset, item_wire_offset, peer_settings)?)
	end
end

fn update_single_settings_item(pending: ByteChunk, next_offset: Int, item_wire_offset: Int, peer_settings: PeerSettingsState) -> Result<PeerSettingsState, String>
	let item_offset: ByteOffset = byte_offset(item_wire_offset)?
	let item_count: ByteCount = byte_count(6)?
	let item: ByteView = byte_view(pending, item_offset, item_count)?
	let identifier_count: ByteCount = byte_count(2)?
	let value_offset: ByteOffset = byte_offset(2)?
	let value_count: ByteCount = byte_count(4)?
	let identifier: Int = byte_read_u16_be(byte_view(byte_view_to_chunk(item), byte_offset(0)?, identifier_count)?)?
	let value: Int = byte_read_u32_be(byte_view(byte_view_to_chunk(item), value_offset, value_count)?)?
	match peer_settings
		PeerSettings(max_frame_size, initial_window_size, enable_push, max_concurrent_streams, header_table_size, max_header_list_size, local_enable_push) => match identifier
			5 => Ok(PeerSettings(PeerMaxFrameSize(value, next_offset + item_wire_offset), initial_window_size, enable_push, max_concurrent_streams, header_table_size, max_header_list_size, local_enable_push))
			4 => Ok(PeerSettings(max_frame_size, PeerInitialWindowSize(value, next_offset + item_wire_offset), enable_push, max_concurrent_streams, header_table_size, max_header_list_size, local_enable_push))
			2 => Ok(PeerSettings(max_frame_size, initial_window_size, PeerEnablePush(value, next_offset + item_wire_offset), max_concurrent_streams, header_table_size, max_header_list_size, local_enable_push))
			3 => Ok(PeerSettings(max_frame_size, initial_window_size, enable_push, PeerMaxConcurrentStreams(value, next_offset + item_wire_offset), header_table_size, max_header_list_size, local_enable_push))
			1 => Ok(PeerSettings(max_frame_size, initial_window_size, enable_push, max_concurrent_streams, PeerHeaderTableSize(value, next_offset + item_wire_offset), max_header_list_size, local_enable_push))
			6 => Ok(PeerSettings(max_frame_size, initial_window_size, enable_push, max_concurrent_streams, header_table_size, PeerMaxHeaderListSize(value, next_offset + item_wire_offset), local_enable_push))
			_ => Ok(peer_settings)
		end
	end
end

fn update_initial_window_receive_credit(pending: ByteChunk, next_offset: Int, length: Int, kind: Int, flags: Int, peer_settings: PeerSettingsState, receive_flow_control: ReceiveFlowControl) -> Result<ReceiveFlowControl, String>
	match kind
		4 => match settings_ack_set(flags)
			true => Ok(receive_flow_control)
			false => match settings_payload_has_complete_items(length)
				true => update_initial_window_receive_credit_items(pending, next_offset, 9, 9 + length, peer_settings, receive_flow_control)
				false => Ok(receive_flow_control)
			end
		end
		_ => Ok(receive_flow_control)
	end
end

fn update_initial_window_receive_credit_items(pending: ByteChunk, next_offset: Int, item_wire_offset: Int, payload_end_offset: Int, peer_settings: PeerSettingsState, receive_flow_control: ReceiveFlowControl) -> Result<ReceiveFlowControl, String>
	match item_wire_offset == payload_end_offset
		true => Ok(receive_flow_control)
		false => update_initial_window_receive_credit_items(pending, next_offset, item_wire_offset + 6, payload_end_offset, update_single_settings_item(pending, next_offset, item_wire_offset, peer_settings)?, update_single_initial_window_receive_credit(pending, next_offset, item_wire_offset, peer_settings, receive_flow_control)?)
	end
end

fn update_single_initial_window_receive_credit(pending: ByteChunk, next_offset: Int, item_wire_offset: Int, peer_settings: PeerSettingsState, receive_flow_control: ReceiveFlowControl) -> Result<ReceiveFlowControl, String>
	let item_offset: ByteOffset = byte_offset(item_wire_offset)?
	let item_count: ByteCount = byte_count(6)?
	let item: ByteView = byte_view(pending, item_offset, item_count)?
	let identifier_count: ByteCount = byte_count(2)?
	let value_offset: ByteOffset = byte_offset(2)?
	let value_count: ByteCount = byte_count(4)?
	let identifier: Int = byte_read_u16_be(byte_view(byte_view_to_chunk(item), byte_offset(0)?, identifier_count)?)?
	let value: Int = byte_read_u32_be(byte_view(byte_view_to_chunk(item), value_offset, value_count)?)?
	match identifier
		4 => Ok(apply_initial_window_delta(value - active_peer_initial_window_size(peer_settings), receive_flow_control))
		_ => Ok(receive_flow_control)
	end
end

fn active_peer_initial_window_size(peer_settings: PeerSettingsState) -> Int
	match peer_settings
		PeerSettings(_, NoPeerInitialWindowSize, _, _, _, _, _) => 65535
		PeerSettings(_, PeerInitialWindowSize(value, _), _, _, _, _, _) => value
	end
end

fn active_peer_max_frame_size(peer_settings: PeerSettingsState) -> Int
	match peer_settings
		PeerSettings(NoPeerMaxFrameSize, _, _, _, _, _, _) => 16384
		PeerSettings(PeerMaxFrameSize(value, _), _, _, _, _, _, _) => value
	end
end

fn active_peer_header_table_size(peer_settings: PeerSettingsState) -> Int
	match peer_settings
		PeerSettings(_, _, _, _, NoPeerHeaderTableSize, _, _) => 4096
		PeerSettings(_, _, _, _, PeerHeaderTableSize(value, _), _, _) => value
	end
end

fn peer_enable_push_disabled(peer_settings: PeerSettingsState) -> Bool
	match peer_settings
		PeerSettings(_, _, PeerEnablePush(value, _), _, _, _, _) => value == 0
		PeerSettings(_, _, NoPeerEnablePush, _, _, _, _) => false
	end
end

fn local_enable_push_disabled(peer_settings: PeerSettingsState) -> Bool
	match peer_settings
		PeerSettings(_, _, _, _, _, _, LocalSentEnablePush(value, _)) => value == 0
		PeerSettings(_, _, _, _, _, _, NoLocalSentEnablePush) => false
	end
end

fn local_enable_push_value(peer_settings: PeerSettingsState) -> Int
	match peer_settings
		PeerSettings(_, _, _, _, _, _, LocalSentEnablePush(value, _)) => value
		PeerSettings(_, _, _, _, _, _, NoLocalSentEnablePush) => 0
	end
end

fn local_enable_push_offset(peer_settings: PeerSettingsState) -> Int
	match peer_settings
		PeerSettings(_, _, _, _, _, _, LocalSentEnablePush(_, item_offset)) => item_offset
		PeerSettings(_, _, _, _, _, _, NoLocalSentEnablePush) => 0
	end
end

fn with_local_enable_push(peer_settings: PeerSettingsState, value: Int, item_offset: Int) -> PeerSettingsState
	match peer_settings
		PeerSettings(max_frame_size, initial_window_size, enable_push, max_concurrent_streams, header_table_size, max_header_list_size, _) => PeerSettings(max_frame_size, initial_window_size, enable_push, max_concurrent_streams, header_table_size, max_header_list_size, LocalSentEnablePush(value, item_offset))
	end
end

fn update_local_enable_push_state(state: Http2DecodeState, value: Int, item_offset: Int) -> Http2DecodeState
	match state
		State(pending, next_offset, preface_state, continuation, hpack_state, receive_limit, peer_settings, shutdown_state, receive_flow_control) => State(pending, next_offset, preface_state, continuation, hpack_state, receive_limit, with_local_enable_push(peer_settings, value, item_offset), shutdown_state, receive_flow_control)
	end
end

fn outbound_receive_credit_with_open_stream(connection_window: Int, stream_id: Int, stream_window: Int) -> OutboundReceiveCredit
	OutboundReceiveCredit(connection_window, OutboundReceiveCreditOpenStream(stream_id, stream_window))
end

fn outbound_receive_credit_without_stream(connection_window: Int) -> OutboundReceiveCredit
	OutboundReceiveCredit(connection_window, NoOutboundReceiveCreditStream)
end

fn outbound_receive_credit_with_closed_stream(connection_window: Int, stream_id: Int) -> OutboundReceiveCredit
	OutboundReceiveCredit(connection_window, OutboundReceiveCreditClosedStream(stream_id))
end

fn outbound_receive_credit_with_reset_stream(connection_window: Int, stream_id: Int, error_code: Int) -> OutboundReceiveCredit
	OutboundReceiveCredit(connection_window, OutboundReceiveCreditResetStream(stream_id, error_code))
end

fn outbound_send_credit_with_open_stream(connection_window: Int, stream_id: Int, stream_window: Int) -> OutboundSendCredit
	OutboundSendCredit(connection_window, OutboundReceiveCreditOpenStream(stream_id, stream_window))
end

fn outbound_send_credit_with_content_length(connection_window: Int, stream_id: Int, stream_window: Int, expected_length: Int, observed_length: Int) -> OutboundSendCredit
	OutboundSendCredit(connection_window, OutboundReceiveCreditOpenStreamContentLength(stream_id, stream_window, expected_length, observed_length))
end

fn outbound_send_credit_without_stream(connection_window: Int) -> OutboundSendCredit
	OutboundSendCredit(connection_window, NoOutboundReceiveCreditStream)
end

fn outbound_send_credit_with_closed_stream(connection_window: Int, stream_id: Int) -> OutboundSendCredit
	OutboundSendCredit(connection_window, OutboundReceiveCreditClosedStream(stream_id))
end

fn outbound_send_credit_with_reset_stream(connection_window: Int, stream_id: Int, error_code: Int) -> OutboundSendCredit
	OutboundSendCredit(connection_window, OutboundReceiveCreditResetStream(stream_id, error_code))
end

fn outbound_send_credit_for_closed_by_peer_stream(state: Http2DecodeState) -> OutboundSendCredit
	match state
		State(_, _, _, _, _, _, peer_settings, _, ReceiveFlowControl(_, ClosedByPeerStreamReceiveWindow(stream_id, _))) => outbound_send_credit_with_open_stream(65535, stream_id, active_peer_initial_window_size(peer_settings))
		State(_, _, _, _, _, _, _, _, _) => outbound_send_credit_without_stream(0)
	end
end

fn outbound_send_credit_from_headers(headers: HpackHeaderList, decision: OutboundHeadersDecision) -> OutboundSendCredit
	match decision
		OutboundHeadersAccepted(stream_id, _, end_stream, receive_credit, _) => match end_stream
			true => outbound_send_credit_with_closed_stream(outbound_receive_connection_window(receive_credit), stream_id)
			false => match hpack_fixture::header_list_accepted_content_length(headers) < 0
				true => outbound_send_credit_with_open_stream(outbound_receive_connection_window(receive_credit), stream_id, outbound_receive_stream_window(receive_credit))
				false => outbound_send_credit_with_content_length(outbound_receive_connection_window(receive_credit), stream_id, outbound_receive_stream_window(receive_credit), hpack_fixture::header_list_accepted_content_length(headers), 0)
			end
		end
		OutboundHeadersRejected(_, _, _, _) => outbound_send_credit_without_stream(0)
		OutboundHeadersEncodeFailed(_, _, _, _) => outbound_send_credit_without_stream(0)
	end
end

fn send_data(stream_id: Int, payload: ByteChunk, end_stream: Bool, peer_settings: PeerSettingsState, send_credit: OutboundSendCredit) -> Result<OutboundDataDecision, String>
	let length: Int = byte_count_to_int(byte_chunk_count(payload))
	let max_frame_size: Int = active_peer_max_frame_size(peer_settings)
	match max_frame_size < 1
		true => Ok(OutboundDataRejected(stream_id, length, end_stream, FrameSizeExceeded(0, length, ReceiveLimit(max_frame_size, LocalConfiguration), 0, stream_id)))
		false => consume_outbound_data_window(stream_id, payload, length, end_stream, max_frame_size, OpenConnection, send_credit)
	end
end

fn send_data_with_shutdown(stream_id: Int, payload: ByteChunk, end_stream: Bool, peer_settings: PeerSettingsState, shutdown_state: ConnectionShutdownState, send_credit: OutboundSendCredit) -> Result<OutboundDataDecision, String>
	let length: Int = byte_count_to_int(byte_chunk_count(payload))
	let max_frame_size: Int = active_peer_max_frame_size(peer_settings)
	consume_outbound_data_window(stream_id, payload, length, end_stream, max_frame_size, shutdown_state, send_credit)
end

fn send_padded_data(stream_id: Int, payload: ByteChunk, padding_length: Int, end_stream: Bool, peer_settings: PeerSettingsState, send_credit: OutboundSendCredit) -> Result<OutboundDataDecision, String>
	let application_length: Int = byte_count_to_int(byte_chunk_count(payload))
	let max_frame_size: Int = active_peer_max_frame_size(peer_settings)
	match padding_length < 0
		true => Ok(OutboundDataRejected(stream_id, application_length, end_stream, InvalidDataPadding(0, stream_id, padding_length, 0, "open-stream", "outbound_data_padding", empty_byte_preview()?)))
		false => match padding_length > 255
			true => Ok(OutboundDataRejected(stream_id, application_length, end_stream, InvalidDataPadding(0, stream_id, padding_length, 255, "open-stream", "outbound_data_padding", empty_byte_preview()?)))
			false => send_nonnegative_padded_data(stream_id, payload, application_length, padding_length, end_stream, max_frame_size, send_credit)
		end
	end
end

fn empty_byte_preview() -> Result<ByteView, String>
	byte_view(byte_chunk([]), byte_offset(0)?, byte_count(0)?)
end

fn frame_header_preview(length: Int, kind: Int, flags: Int, stream_id: Int) -> Result<ByteView, String>
	match encode_frame_header({length: length, kind: kind, flags: flags, stream_id: stream_id})
		Ok(header) => byte_view(header, byte_offset(0)?, byte_count(9)?)
		Err(_) => Err("unexpected frame header encode failure")
	end
end

fn send_nonnegative_padded_data(stream_id: Int, payload: ByteChunk, application_length: Int, padding_length: Int, end_stream: Bool, max_frame_size: Int, send_credit: OutboundSendCredit) -> Result<OutboundDataDecision, String>
	match application_length > 0
		true => match max_frame_size < padding_length + 2
			true => Ok(OutboundDataRejected(stream_id, padding_length + 2, end_stream, FrameSizeExceeded(0, padding_length + 2, ReceiveLimit(max_frame_size, LocalConfiguration), 0, stream_id)))
			false => send_valid_padded_data(stream_id, payload, application_length, padding_length, end_stream, max_frame_size, send_credit)
		end
		false => match max_frame_size < padding_length + 1
			true => Ok(OutboundDataRejected(stream_id, padding_length + 1, end_stream, FrameSizeExceeded(0, padding_length + 1, ReceiveLimit(max_frame_size, LocalConfiguration), 0, stream_id)))
			false => send_valid_padded_data(stream_id, payload, application_length, padding_length, end_stream, max_frame_size, send_credit)
		end
	end
end

fn send_valid_padded_data(stream_id: Int, payload: ByteChunk, application_length: Int, padding_length: Int, end_stream: Bool, max_frame_size: Int, send_credit: OutboundSendCredit) -> Result<OutboundDataDecision, String>
	let max_application_frame_payload: Int = max_padded_application_frame_payload(max_frame_size, padding_length)
	let encoded_length: Int = padded_data_encoded_length(application_length, padding_length, max_application_frame_payload)
	consume_outbound_padded_data_window(stream_id, payload, encoded_length, padding_length, end_stream, max_frame_size, send_credit)
end

fn max_padded_application_frame_payload(max_frame_size: Int, padding_length: Int) -> Int
	max_frame_size - padding_length - 1
end

fn padded_data_encoded_length(application_length: Int, padding_length: Int, max_application_frame_payload: Int) -> Int
	padded_data_encoded_length_remaining(application_length, padding_length, max_application_frame_payload, 0)
end

fn padded_data_encoded_length_remaining(remaining_length: Int, padding_length: Int, max_application_frame_payload: Int, total: Int) -> Int
	match remaining_length > max_application_frame_payload
		true => padded_data_encoded_length_remaining(remaining_length - max_application_frame_payload, padding_length, max_application_frame_payload, total + max_application_frame_payload + padding_length + 1)
		false => total + remaining_length + padding_length + 1
	end
end

fn send_settings_ack() -> Result<ByteChunk, EncodeError>
	encode_frame_header({length: 0, kind: 4, flags: 1, stream_id: 0})
end

fn connection_state(decode_state: Http2DecodeState) -> Http2ConnectionState
	ConnectionState(decode_state, NoOutstandingLocalSettings, NoPendingPeerSettingsAck)
end

fn append_outstanding_settings_batch(batches: List<OutstandingLocalSettingsBatch>, batch: OutstandingLocalSettingsBatch) -> List<OutstandingLocalSettingsBatch>
	match batches
		Nil => Cons(batch, Nil)
		Cons(head, tail) => Cons(head, append_outstanding_settings_batch(tail, batch))
	end
end

fn add_outstanding_settings(outstanding_settings: OutstandingLocalSettings, identifier: Int, count: Int) -> OutstandingLocalSettings
	let batch: OutstandingLocalSettingsBatch = LocalSettingsBatch(identifier, count)
	match outstanding_settings
		NoOutstandingLocalSettings => OutstandingLocalSettings(Cons(batch, Nil))
		OutstandingLocalSettings(batches) => OutstandingLocalSettings(append_outstanding_settings_batch(batches, batch))
	end
end

fn acknowledge_outstanding_settings(outstanding_settings: OutstandingLocalSettings) -> OutstandingLocalSettings
	match outstanding_settings
		NoOutstandingLocalSettings => NoOutstandingLocalSettings
		OutstandingLocalSettings(batches) => match batches
			Nil => NoOutstandingLocalSettings
			Cons(_, Nil) => NoOutstandingLocalSettings
			Cons(_, tail) => OutstandingLocalSettings(tail)
		end
	end
end

fn receive_connection(input: Http2Input, connection: Http2ConnectionState) -> Result<Http2ConnectionStep, String>
	match connection
		ConnectionState(decode_state, outstanding_settings, pending_ack) => update_connection_after_receive(receive(input, decode_state)?, outstanding_settings, pending_ack)
	end
end

fn update_connection_after_receive(step: Http2Step, outstanding_settings: OutstandingLocalSettings, pending_ack: PendingPeerSettingsAck) -> Result<Http2ConnectionStep, String>
	match step
		FrameDecoded(decode_state, offset, length, kind, flags, stream_id, _, _) => match settings_ack_frame(kind, flags)
			true => receive_settings_ack(offset, decode_state, outstanding_settings, pending_ack, step, frame_header_preview(length, kind, flags, stream_id)?)
			false => Ok(ConnectionFrameDecoded(ConnectionState(decode_state, outstanding_settings, peer_settings_ack_after_frame(kind, flags, length, pending_ack)), step))
		end
		Waiting(decode_state) => Ok(ConnectionWaiting(ConnectionState(decode_state, outstanding_settings, pending_ack)))
		Failed(decode_state, failure) => Ok(ConnectionFailed(ConnectionState(decode_state, outstanding_settings, pending_ack), failure))
	end
end

fn peer_settings_ack_after_frame(kind: Int, flags: Int, length: Int, pending_ack: PendingPeerSettingsAck) -> PendingPeerSettingsAck
	match kind == 4 and not settings_ack_set(flags) and length > 0
		true => PendingPeerSettingsAck
		false => pending_ack
	end
end

fn settings_ack_frame(kind: Int, flags: Int) -> Bool
	match kind
		4 => settings_ack_set(flags)
		_ => false
	end
end

fn receive_settings_ack(offset: Int, decode_state: Http2DecodeState, outstanding_settings: OutstandingLocalSettings, pending_ack: PendingPeerSettingsAck, step: Http2Step, preview: ByteView) -> Result<Http2ConnectionStep, String>
	match outstanding_settings
		NoOutstandingLocalSettings => Ok(ConnectionFailed(ConnectionState(decode_state, NoOutstandingLocalSettings, pending_ack), UnexpectedSettingsAck(offset, "connection-control", "rfc9113_settings_ack_requires_outstanding_local_settings", preview)))
		OutstandingLocalSettings(Nil) => Ok(ConnectionFailed(ConnectionState(decode_state, NoOutstandingLocalSettings, pending_ack), UnexpectedSettingsAck(offset, "connection-control", "rfc9113_settings_ack_requires_outstanding_local_settings", preview)))
		OutstandingLocalSettings(_) => Ok(ConnectionFrameDecoded(ConnectionState(decode_state, acknowledge_outstanding_settings(outstanding_settings), pending_ack), step))
	end
end

fn send_pending_settings_ack(connection: Http2ConnectionState) -> Result<OutboundSettingsAckDecision, String>
	match connection
		ConnectionState(decode_state, outstanding_settings, NoPendingPeerSettingsAck) => Ok(OutboundSettingsAckNoPending(connection))
		ConnectionState(decode_state, outstanding_settings, PendingPeerSettingsAck) => match send_settings_ack()
			Ok(header) => Ok(OutboundSettingsAckAccepted(ConnectionState(decode_state, outstanding_settings, NoPendingPeerSettingsAck), header))
			Err(error) => Ok(OutboundSettingsAckEncodeFailed(connection, error))
		end
	end
end

fn send_local_max_frame_size_setting(value: Int, connection: Http2ConnectionState) -> Result<OutboundSettingsDecision, String>
	match validate_local_max_frame_size_setting(0, value)?
		SettingsValueOk => match connection
			ConnectionState(decode_state, outstanding_settings, pending_ack) => encode_local_settings_intent(value, decode_state, outstanding_settings, pending_ack)
		end
		SettingsValueFailed(error) => Ok(OutboundSettingsRejected(error))
	end
end

fn send_local_max_frame_size_and_enable_push_settings(max_frame_size_value: Int, enable_push_value: Int, connection: Http2ConnectionState) -> Result<OutboundSettingsDecision, String>
	let items: List<OutboundLocalSettingsItem> = Cons(OutboundSettingsMaxFrameSize(max_frame_size_value), Cons(OutboundSettingsEnablePush(enable_push_value), Nil))
	send_local_settings_batch(items, connection)
end

fn send_local_settings_batch(items: List<OutboundLocalSettingsItem>, connection: Http2ConnectionState) -> Result<OutboundSettingsDecision, String>
	match validate_local_settings_batch_items(items, 0)?
		SettingsValueOk => match connection
			ConnectionState(decode_state, outstanding_settings, pending_ack) => encode_local_settings_batch_intent(items, decode_state, outstanding_settings, pending_ack)
		end
		SettingsValueFailed(error) => Ok(OutboundSettingsRejected(error))
	end
end

fn validate_local_settings_batch_items(items: List<OutboundLocalSettingsItem>, item_offset: Int) -> Result<SettingsRangeDecision, String>
	match items
		Nil => Ok(SettingsValueOk)
		Cons(item, tail) => match validate_local_settings_batch_item(item, item_offset)?
			SettingsValueOk => validate_local_settings_batch_items(tail, item_offset + 6)
			SettingsValueFailed(error) => Ok(SettingsValueFailed(error))
		end
	end
end

fn validate_local_settings_batch_item(item: OutboundLocalSettingsItem, item_offset: Int) -> Result<SettingsRangeDecision, String>
	match item
		OutboundSettingsHeaderTableSize(_) => Ok(SettingsValueOk)
		OutboundSettingsEnablePush(value) => validate_local_enable_push_setting(item_offset, value)
		OutboundSettingsInitialWindowSize(value) => validate_local_initial_window_size_setting(item_offset, value)
		OutboundSettingsMaxConcurrentStreams(_) => Ok(SettingsValueOk)
		OutboundSettingsMaxFrameSize(value) => validate_local_max_frame_size_setting(item_offset, value)
		OutboundSettingsMaxHeaderListSize(_) => Ok(SettingsValueOk)
	end
end

fn encode_local_settings_batch_intent(items: List<OutboundLocalSettingsItem>, decode_state: Http2DecodeState, outstanding_settings: OutstandingLocalSettings, pending_ack: PendingPeerSettingsAck) -> Result<OutboundSettingsDecision, String>
	let payload: ByteChunk = encode_local_settings_batch_payload(items)?
	let item_count: Int = local_settings_batch_item_count(items)
	let encoded_header: Result<ByteChunk, EncodeError> = encode_frame_header({length: 6 * item_count, kind: 4, flags: 0, stream_id: 0})
	match encoded_header
		Ok(header) => Ok(OutboundSettingsAccepted(local_settings_batch_first_identifier(items), local_settings_batch_first_value(items), ConnectionState(apply_local_settings_batch_to_state(items, 0, decode_state), add_outstanding_settings(outstanding_settings, local_settings_batch_first_identifier(items), item_count), pending_ack), byte_append(header, payload)))
		Err(error) => Ok(OutboundSettingsEncodeFailed(error))
	end
end

fn encode_local_settings_batch_payload(items: List<OutboundLocalSettingsItem>) -> Result<ByteChunk, String>
	match items
		Nil => Ok(byte_chunk([]))
		Cons(item, tail) => Ok(byte_append(encode_local_settings_batch_item(item)?, encode_local_settings_batch_payload(tail)?))
	end
end

fn encode_local_settings_batch_item(item: OutboundLocalSettingsItem) -> Result<ByteChunk, String>
	Ok(byte_append(byte_write_u16_be(local_settings_item_identifier(item))?, byte_write_u32_be(local_settings_item_value(item))?))
end

fn apply_local_settings_batch_to_state(items: List<OutboundLocalSettingsItem>, item_offset: Int, decode_state: Http2DecodeState) -> Http2DecodeState
	match items
		Nil => decode_state
		Cons(item, tail) => apply_local_settings_batch_to_state(tail, item_offset + 6, apply_local_settings_item_to_state(item, item_offset, decode_state))
	end
end

fn apply_local_settings_item_to_state(item: OutboundLocalSettingsItem, item_offset: Int, decode_state: Http2DecodeState) -> Http2DecodeState
	match item
		OutboundSettingsEnablePush(value) => update_local_enable_push_state(decode_state, value, item_offset)
		_ => decode_state
	end
end

fn local_settings_batch_item_count(items: List<OutboundLocalSettingsItem>) -> Int
	match items
		Nil => 0
		Cons(_, tail) => 1 + local_settings_batch_item_count(tail)
	end
end

fn local_settings_batch_first_identifier(items: List<OutboundLocalSettingsItem>) -> Int
	match items
		Nil => 0
		Cons(item, _) => local_settings_item_identifier(item)
	end
end

fn local_settings_batch_first_value(items: List<OutboundLocalSettingsItem>) -> Int
	match items
		Nil => 0
		Cons(item, _) => local_settings_item_value(item)
	end
end

fn local_settings_item_identifier(item: OutboundLocalSettingsItem) -> Int
	match item
		OutboundSettingsHeaderTableSize(_) => 1
		OutboundSettingsEnablePush(_) => 2
		OutboundSettingsInitialWindowSize(_) => 4
		OutboundSettingsMaxConcurrentStreams(_) => 3
		OutboundSettingsMaxFrameSize(_) => 5
		OutboundSettingsMaxHeaderListSize(_) => 6
	end
end

fn local_settings_item_value(item: OutboundLocalSettingsItem) -> Int
	match item
		OutboundSettingsHeaderTableSize(value) => value
		OutboundSettingsEnablePush(value) => value
		OutboundSettingsInitialWindowSize(value) => value
		OutboundSettingsMaxConcurrentStreams(value) => value
		OutboundSettingsMaxFrameSize(value) => value
		OutboundSettingsMaxHeaderListSize(value) => value
	end
end

fn encode_local_settings_intent(value: Int, decode_state: Http2DecodeState, outstanding_settings: OutstandingLocalSettings, pending_ack: PendingPeerSettingsAck) -> Result<OutboundSettingsDecision, String>
	let payload: ByteChunk = byte_append(byte_write_u16_be(5)?, byte_write_u32_be(value)?)
	let encoded_header: Result<ByteChunk, EncodeError> = encode_frame_header({length: 6, kind: 4, flags: 0, stream_id: 0})
	match encoded_header
		Ok(header) => Ok(OutboundSettingsAccepted(5, value, ConnectionState(decode_state, add_outstanding_settings(outstanding_settings, 5, 1), pending_ack), byte_append(header, payload)))
		Err(error) => Ok(OutboundSettingsEncodeFailed(error))
	end
end

fn send_local_initial_window_size_setting(value: Int, connection: Http2ConnectionState) -> Result<OutboundSettingsDecision, String>
	match validate_local_initial_window_size_setting(0, value)?
		SettingsValueOk => match connection
			ConnectionState(decode_state, outstanding_settings, pending_ack) => encode_local_initial_window_size_intent(value, decode_state, outstanding_settings, pending_ack)
		end
		SettingsValueFailed(error) => Ok(OutboundSettingsRejected(error))
	end
end

fn encode_local_initial_window_size_intent(value: Int, decode_state: Http2DecodeState, outstanding_settings: OutstandingLocalSettings, pending_ack: PendingPeerSettingsAck) -> Result<OutboundSettingsDecision, String>
	let payload: ByteChunk = byte_append(byte_write_u16_be(4)?, byte_write_u32_be(value)?)
	let encoded_header: Result<ByteChunk, EncodeError> = encode_frame_header({length: 6, kind: 4, flags: 0, stream_id: 0})
	match encoded_header
		Ok(header) => Ok(OutboundSettingsAccepted(4, value, ConnectionState(decode_state, add_outstanding_settings(outstanding_settings, 4, 1), pending_ack), byte_append(header, payload)))
		Err(error) => Ok(OutboundSettingsEncodeFailed(error))
	end
end

fn send_local_max_concurrent_streams_setting(value: Int, connection: Http2ConnectionState) -> Result<OutboundSettingsDecision, String>
	match connection
		ConnectionState(decode_state, outstanding_settings, pending_ack) => encode_local_max_concurrent_streams_intent(value, decode_state, outstanding_settings, pending_ack)
	end
end

