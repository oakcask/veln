fn outbound_receive_connection_window(receive_credit: OutboundReceiveCredit) -> Int
	match receive_credit
		OutboundReceiveCredit(connection_window, _) => connection_window
	end
end

fn outbound_receive_open_stream_id(receive_credit: OutboundReceiveCredit) -> Int
	match receive_credit
		OutboundReceiveCredit(_, NoOutboundReceiveCreditStream) => 0
		OutboundReceiveCredit(_, OutboundReceiveCreditOpenStream(stream_id, _)) => stream_id
		OutboundReceiveCredit(_, OutboundReceiveCreditClosedStream(_)) => 0
		OutboundReceiveCredit(_, OutboundReceiveCreditResetStream(_, _)) => 0
	end
end

fn outbound_receive_stream_window(receive_credit: OutboundReceiveCredit) -> Int
	match receive_credit
		OutboundReceiveCredit(_, NoOutboundReceiveCreditStream) => 0
		OutboundReceiveCredit(_, OutboundReceiveCreditOpenStream(_, stream_window)) => stream_window
		OutboundReceiveCredit(_, OutboundReceiveCreditClosedStream(_)) => 0
		OutboundReceiveCredit(_, OutboundReceiveCreditResetStream(_, _)) => 0
	end
end

fn outbound_receive_closed_stream_id(receive_credit: OutboundReceiveCredit) -> Int
	match receive_credit
		OutboundReceiveCredit(_, NoOutboundReceiveCreditStream) => 0
		OutboundReceiveCredit(_, OutboundReceiveCreditOpenStream(_, _)) => 0
		OutboundReceiveCredit(_, OutboundReceiveCreditClosedStream(stream_id)) => stream_id
		OutboundReceiveCredit(_, OutboundReceiveCreditResetStream(_, _)) => 0
	end
end

fn bool_to_int(value: Bool) -> Int
	match value
		true => 1
		false => 0
	end
end

