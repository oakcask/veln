fn verify_outbound_push_promise_ordering_cases() -> Result<(), String>
	let initial_state: OutboundPushPromiseConnectionState = initial_outbound_push_promise_connection_state(empty_peer_settings(), OpenConnection, outbound_receive_credit_with_open_stream(10, 1, 20))
	let first: OutboundPushPromiseConnectionTransition = send_push_promise_on_connection(1, 2, byte_chunk_from_hex("82")?, initial_state)?
	let ignored_first: () = require_outbound_push_promise_accepted("first outbound promised stream id was rejected", first, 2)?
	let first_state: OutboundPushPromiseConnectionState = outbound_push_promise_connection_state(first)
	let ignored_first_high_water: () = require_client_push_equal_int("first outbound promised stream id did not advance high-water", outbound_push_promise_connection_high_water(first_state), 2)?
	let ignored_first_lifecycle: () = require_client_push_equal_string("first outbound promised stream was not reserved", outbound_promised_stream_state_label(outbound_push_promise_connection_promised_state(first_state)), "reserved")?
	let increasing: OutboundPushPromiseConnectionTransition = send_push_promise_on_connection(1, 4, byte_chunk_from_hex("84")?, first_state)?
	let ignored_increasing: () = require_outbound_push_promise_accepted("increasing outbound promised stream id was rejected", increasing, 4)?
	let increasing_state: OutboundPushPromiseConnectionState = outbound_push_promise_connection_state(increasing)
	let repeated: OutboundPushPromiseConnectionTransition = send_push_promise_on_connection(1, 4, byte_chunk_from_hex("86")?, increasing_state)?
	let ignored_repeated: () = require_outbound_push_promise_failure("repeated outbound promised stream id was accepted", repeated, "http2.protocol.peer_stream_id_not_increasing")?
	let ignored_repeated_chunk: String = checked_hex_label(outbound_push_promise_chunk(outbound_push_promise_connection_decision(repeated)), "")?
	let ignored_repeated_state: () = require_outbound_push_promise_state_preserved("repeated outbound promised stream id changed connection state", increasing_state, outbound_push_promise_connection_state(repeated))?
	let lower: OutboundPushPromiseConnectionTransition = send_push_promise_on_connection(1, 2, byte_chunk_from_hex("86")?, increasing_state)?
	let ignored_lower: () = require_outbound_push_promise_failure("lower outbound promised stream id was accepted", lower, "http2.protocol.peer_stream_id_not_increasing")?
	let ignored_lower_state: () = require_outbound_push_promise_state_preserved("lower outbound promised stream id changed connection state", increasing_state, outbound_push_promise_connection_state(lower))?
	let closed_state: OutboundPushPromiseConnectionState = with_outbound_push_promise_connection_lifecycle(increasing_state, ClosedOutboundPromisedStream(4))
	let lower_after_close: OutboundPushPromiseConnectionTransition = send_push_promise_on_connection(1, 2, byte_chunk_from_hex("82")?, closed_state)?
	let ignored_lower_after_close: () = require_outbound_push_promise_failure("closed promised-stream lifecycle lost ordering high-water", lower_after_close, "http2.protocol.peer_stream_id_not_increasing")?
	let ignored_lower_after_close_state: () = require_outbound_push_promise_state_preserved("ordering rejection changed closed promised-stream lifecycle", closed_state, outbound_push_promise_connection_state(lower_after_close))?
	let reset_state: OutboundPushPromiseConnectionState = with_outbound_push_promise_connection_lifecycle(increasing_state, ResetOutboundPromisedStream(4, 8))
	let lower_after_reset: OutboundPushPromiseConnectionTransition = send_push_promise_on_connection(1, 2, byte_chunk_from_hex("82")?, reset_state)?
	let ignored_lower_after_reset: () = require_outbound_push_promise_failure("reset promised-stream lifecycle lost ordering high-water", lower_after_reset, "http2.protocol.peer_stream_id_not_increasing")?
	let ignored_lower_after_reset_state: () = require_outbound_push_promise_state_preserved("ordering rejection changed reset promised-stream lifecycle", reset_state, outbound_push_promise_connection_state(lower_after_reset))?
	let parity_failure: OutboundPushPromiseConnectionTransition = send_push_promise_on_connection(1, 3, byte_chunk_from_hex("82")?, increasing_state)?
	let ignored_parity_failure: () = require_outbound_push_promise_failure("promised stream parity must precede ordering", parity_failure, "http2.protocol.invalid_stream_id")?
	let disabled_state: OutboundPushPromiseConnectionState = with_outbound_push_promise_connection_peer_settings(increasing_state, peer_enable_push_settings(0))
	let disabled_failure: OutboundPushPromiseConnectionTransition = send_push_promise_on_connection(1, 2, byte_chunk_from_hex("82")?, disabled_state)?
	let ignored_disabled_failure: () = require_outbound_push_promise_failure("SETTINGS_ENABLE_PUSH must precede ordering", disabled_failure, "http2.protocol.invalid_frame_kind")?
	let ignored_disabled_state: () = require_outbound_push_promise_state_preserved("SETTINGS_ENABLE_PUSH rejection changed ordering state", disabled_state, outbound_push_promise_connection_state(disabled_failure))?
	let goaway_state: OutboundPushPromiseConnectionState = with_outbound_push_promise_connection_shutdown(increasing_state, GracefulShutdown(0, 11))
	let goaway_failure: OutboundPushPromiseConnectionTransition = send_push_promise_on_connection(1, 2, byte_chunk_from_hex("82")?, goaway_state)?
	let ignored_goaway_failure: () = require_outbound_push_promise_failure("GOAWAY must precede ordering", goaway_failure, "http2.protocol.stream_after_goaway")?
	let ignored_goaway_state: () = require_outbound_push_promise_state_preserved("GOAWAY rejection changed ordering state", goaway_state, outbound_push_promise_connection_state(goaway_failure))?
	let frame_size_state: OutboundPushPromiseConnectionState = with_outbound_push_promise_connection_peer_settings(increasing_state, small_peer_max_frame_size_settings(3))
	let frame_size_failure: OutboundPushPromiseConnectionTransition = send_push_promise_on_connection(1, 6, byte_chunk_from_hex("828486")?, frame_size_state)?
	let ignored_frame_size_failure: () = require_outbound_push_promise_failure("frame-size validation must precede ordering", frame_size_failure, "http2.peer_limit.frame_size_exceeded")?
	let ignored_frame_size_state: () = require_outbound_push_promise_state_preserved("rejected higher promised id changed ordering state", frame_size_state, outbound_push_promise_connection_state(frame_size_failure))?
	let retry_state: OutboundPushPromiseConnectionState = with_outbound_push_promise_connection_peer_settings(outbound_push_promise_connection_state(frame_size_failure), small_peer_max_frame_size_settings(5))
	let retry: OutboundPushPromiseConnectionTransition = send_push_promise_on_connection(1, 6, byte_chunk_from_hex("828486")?, retry_state)?
	let ignored_retry: () = require_outbound_push_promise_accepted("rejected higher promised id was not eligible for retry", retry, 6)?
	let ignored_retry_chunk: String = checked_hex_label(outbound_push_promise_chunk(outbound_push_promise_connection_decision(retry)), "00000505000000000100000006820000020904000000018486")?
	let hpack_initial: OutboundPushPromiseConnectionState = initial_outbound_push_promise_connection_state(empty_peer_settings(), OpenConnection, outbound_receive_credit_with_open_stream(10, 1, 20))
	let hpack_first_result: Result<OutboundPushPromiseConnectionTransition, HpackFixtureFailure> = send_push_promise_header_list_on_connection(1, 2, hpack_fixture::outbound_literal_indexed_path_target_headers(), hpack_initial)?
	let hpack_first: OutboundPushPromiseConnectionTransition = require_outbound_push_promise_hpack_connection_transition(hpack_first_result)?
	let ignored_hpack_first: () = require_outbound_push_promise_accepted("stateful HPACK promised stream was rejected", hpack_first, 2)?
	let hpack_first_state: OutboundPushPromiseConnectionState = outbound_push_promise_connection_state(hpack_first)
	let hpack_repeated_result: Result<OutboundPushPromiseConnectionTransition, HpackFixtureFailure> = send_push_promise_header_list_on_connection(1, 2, hpack_fixture::outbound_literal_indexed_path_target_headers(), hpack_first_state)?
	let hpack_repeated: OutboundPushPromiseConnectionTransition = require_outbound_push_promise_hpack_connection_transition(hpack_repeated_result)?
	let ignored_hpack_repeated: () = require_outbound_push_promise_failure("stateful HPACK repeated promised id was accepted", hpack_repeated, "http2.protocol.peer_stream_id_not_increasing")?
	let ignored_hpack_repeated_state: () = require_outbound_push_promise_state_preserved("ordering rejection committed HPACK state", hpack_first_state, outbound_push_promise_connection_state(hpack_repeated))?
	let hpack_invalid: Result<OutboundPushPromiseConnectionTransition, HpackFixtureFailure> = send_push_promise_header_list_on_connection(1, 4, hpack_fixture::outbound_unsupported_static_headers(), hpack_first_state)?
	match hpack_invalid
		Ok(_) => Err("HPACK validation must precede outbound promised stream ordering")
		Err(_) => match send_push_promise_on_connection(1, 4, byte_chunk_from_hex("88")?, hpack_first_state)
			Err(error) => Err(error)
			Ok(hpack_retry) => require_outbound_push_promise_accepted("HPACK-rejected promised id was not eligible for retry", hpack_retry, 4)
		end
	end
end

fn print_outbound_goaway_cases() -> Result<(), String> effects [stdio]
	let outbound_goaway_accepted: OutboundGoawayDecision = send_goaway(5, 11, frame_state())?
	print_outbound_goaway("outbound-goaway-accepted", outbound_goaway_accepted)
	let ignored_goaway_chunk: () = print_outbound_goaway_chunk("http2-goaway", outbound_goaway_accepted, "000008070000000000000000050000000b")?
	print_shutdown_state("outbound-goaway-state", outbound_goaway_state(outbound_goaway_accepted))
	let outbound_goaway_late_headers: Http2Step = receive(InputChunk(byte_chunk_from_hex("000000010400000007")?), outbound_goaway_state(outbound_goaway_accepted))?
	print_goaway_stream_failure("outbound-goaway-late-headers", outbound_goaway_late_headers)
	let outbound_goaway_open_headers: Http2Step = receive(InputChunk(byte_chunk_from_hex("000000010400000005")?), frame_state())?
	let outbound_goaway_open: OutboundGoawayDecision = send_goaway(5, 11, step_state(outbound_goaway_open_headers))?
	print_outbound_goaway("outbound-goaway-open", outbound_goaway_open)
	print_shutdown_state("outbound-goaway-open-state", outbound_goaway_state(outbound_goaway_open))
	let outbound_goaway_combined_headers: Http2Step = receive(InputChunk(byte_chunk_from_hex("000000010400000005")?), frame_state())?
	let outbound_goaway_combined_received: Http2Step = receive(InputChunk(byte_chunk_from_hex("000008070000000000000000050000000b")?), step_state(outbound_goaway_combined_headers))?
	print_shutdown_state("outbound-goaway-combined-received-state", step_state(outbound_goaway_combined_received))
	let outbound_goaway_combined_narrow: OutboundGoawayDecision = send_goaway(3, 22, step_state(outbound_goaway_combined_received))?
	print_outbound_goaway("outbound-goaway-combined-narrow", outbound_goaway_combined_narrow)
	let ignored_outbound_goaway_combined_narrow_chunk: () = print_outbound_goaway_chunk("http2-goaway-combined-narrow", outbound_goaway_combined_narrow, "0000080700000000000000000300000016")?
	print_shutdown_state("outbound-goaway-combined-narrow-drain", outbound_goaway_state(outbound_goaway_combined_narrow))
	let outbound_goaway_data_end_stream: OutboundDataDecision = send_data_with_shutdown(5, byte_chunk_from_hex("0102")?, true, empty_peer_settings(), state_shutdown_state_value(outbound_goaway_state(outbound_goaway_open)), outbound_send_credit_with_open_stream(10, 5, 20))?
	print_outbound_data("outbound-goaway-data-end-stream", outbound_goaway_data_end_stream)
	let ignored_outbound_goaway_data_end_stream_chunk: () = print_outbound_data_chunk("http2-goaway-data-end-stream", outbound_goaway_data_end_stream, "0000020001000000050102")?
	print_shutdown_value("outbound-goaway-data-end-stream-drain", complete_shutdown_drain_after_outbound_send(state_shutdown_state_value(outbound_goaway_state(outbound_goaway_open)), outbound_data_send_credit(outbound_goaway_data_end_stream)))
	let outbound_goaway_headers_end_stream: OutboundHeadersDecision = send_headers_with_shutdown(5, byte_chunk_from_hex("82")?, true, empty_peer_settings(), state_shutdown_state_value(outbound_goaway_state(outbound_goaway_open)), outbound_receive_credit_with_open_stream(10, 5, 20))?
	print_outbound_headers("outbound-goaway-headers-end-stream", outbound_goaway_headers_end_stream)
	let ignored_outbound_goaway_headers_end_stream_chunk: () = print_outbound_headers_chunk("http2-goaway-headers-end-stream", outbound_goaway_headers_end_stream, "00000101050000000582")?
	print_shutdown_value("outbound-goaway-headers-end-stream-drain", complete_shutdown_drain_after_outbound_receive(state_shutdown_state_value(outbound_goaway_state(outbound_goaway_open)), outbound_headers_receive_credit(outbound_goaway_headers_end_stream)))
	let outbound_goaway_narrow: OutboundGoawayDecision = send_goaway(3, 22, outbound_goaway_state(outbound_goaway_accepted))?
	print_outbound_goaway("outbound-goaway-narrow", outbound_goaway_narrow)
	let ignored_goaway_narrow_chunk: () = print_outbound_goaway_chunk("http2-goaway-narrow", outbound_goaway_narrow, "0000080700000000000000000300000016")?
	print_shutdown_state("outbound-goaway-narrow-state", outbound_goaway_state(outbound_goaway_narrow))
	let outbound_goaway_same: OutboundGoawayDecision = send_goaway(5, 13, outbound_goaway_state(outbound_goaway_accepted))?
	print_outbound_goaway("outbound-goaway-same", outbound_goaway_same)
	let ignored_goaway_same_chunk: () = print_outbound_goaway_chunk("http2-goaway-same", outbound_goaway_same, "000008070000000000000000050000000d")?
	print_shutdown_state("outbound-goaway-same-state", outbound_goaway_state(outbound_goaway_same))
	let outbound_goaway_widen: OutboundGoawayDecision = send_goaway(7, 22, outbound_goaway_state(outbound_goaway_accepted))?
	print_outbound_goaway("outbound-goaway-widen", outbound_goaway_widen)
	let ignored_goaway_widen_chunk: () = print_outbound_goaway_chunk("http2-goaway-widen", outbound_goaway_widen, "")?
	print_goaway_stream_failure("outbound-goaway-widen", Failed(frame_state(), outbound_goaway_failure(outbound_goaway_widen)))
	let outbound_goaway_after_narrow_late_headers: Http2Step = receive(InputChunk(byte_chunk_from_hex("000000010400000005")?), outbound_goaway_state(outbound_goaway_narrow))?
	print_goaway_stream_failure("outbound-goaway-after-narrow-late-headers", outbound_goaway_after_narrow_late_headers)
	let outbound_data_after_narrow_late: OutboundDataDecision = send_data_with_shutdown(5, byte_chunk_from_hex("0102")?, false, empty_peer_settings(), state_shutdown_state_value(outbound_goaway_state(outbound_goaway_narrow)), outbound_send_credit_with_open_stream(10, 5, 20))?
	print_outbound_data("outbound-data-after-narrow-local-goaway-late", outbound_data_after_narrow_late)
	let ignored_data_after_narrow_late_chunk: () = print_outbound_data_chunk("http2-data-after-narrow-local-goaway-late", outbound_data_after_narrow_late, "")?
