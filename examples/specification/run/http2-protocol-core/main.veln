fn require_hpack_multiple_table_size_cases(state: Http2DecodeState) -> Result<(), String>
	let headers: Http2Step = receive(InputChunk(byte_chunk_from_hex("0000050105000000033f81013e82")?), state)?
	let ignored_headers_decode: () = require_completed_header_list_decode(headers, state, ":method", "GET", 8)?
	let ignored_headers_size: () = require_hpack_state_table_size(step_state(headers), 30)?
	let continuation_start: Http2Step = receive(InputChunk(byte_chunk_from_hex("0000020101000000053e3f")?), state)?
	let continuation_done: Http2Step = receive(InputChunk(byte_chunk_from_hex("0000020904000000050182")?), step_state(continuation_start))?
	let ignored_continuation_decode: () = require_completed_header_list_decode(continuation_done, state, ":method", "GET", 8)?
	let ignored_continuation_size: () = require_hpack_state_table_size(step_state(continuation_done), 32)?
	let seed: Http2Step = receive(InputChunk(byte_chunk_from_hex("00000901040000000144072f746172676574")?), state)?
	let seed_state: Http2DecodeState = hpack_carry_only_state(step_state(seed))
	let retained_headers: Http2Step = receive(InputChunk(byte_chunk_from_hex("0000060105000000033f81013f0dbe")?), seed_state)?
	let ignored_retained_headers_decode: () = require_completed_header_list_decode(retained_headers, seed_state, ":path", "/target", 9)?
	let ignored_retained_headers_size: () = require_hpack_state_table_size(step_state(retained_headers), 44)?
	let ignored_retained_headers_entry: () = require_hpack_state_dynamic_entry_count(step_state(retained_headers), 1)?
	let retained_continuation_start: Http2Step = receive(InputChunk(byte_chunk_from_hex("0000030101000000053f8101")?), seed_state)?
	let retained_continuation_done: Http2Step = receive(InputChunk(byte_chunk_from_hex("0000030904000000053f0dbe")?), step_state(retained_continuation_start))?
	let ignored_retained_continuation_decode: () = require_completed_header_list_decode(retained_continuation_done, seed_state, ":path", "/target", 9)?
	let ignored_retained_continuation_size: () = require_hpack_state_table_size(step_state(retained_continuation_done), 44)?
	let ignored_retained_continuation_entry: () = require_hpack_state_dynamic_entry_count(step_state(retained_continuation_done), 1)?
	let evicted_lookup: Http2Step = receive(InputChunk(byte_chunk_from_hex("0000050105000000073e3f8101be")?), seed_state)?
	let ignored_evicted_lookup: () = require_failure_with_id("hpack-multiple-table-size-updates-wire-order-eviction", evicted_lookup, "hpack.fixture.dynamic_index_out_of_range")?
	let ignored_evicted_lookup_size: () = require_hpack_state_table_size(step_state(evicted_lookup), 4096)?
	let ignored_evicted_lookup_entry: () = require_hpack_state_dynamic_entry_count(step_state(evicted_lookup), 1)?
	let over_limit_first: Http2Step = receive(InputChunk(byte_chunk_from_hex("0000050105000000073f82023e82")?), state)?
	let ignored_over_limit_first: () = require_failure_with_id("hpack-multiple-table-size-updates-first-over-limit", over_limit_first, "http2.peer_limit.header_table_size_exceeded")?
	let ignored_over_limit_first_size: () = require_hpack_state_table_size(step_state(over_limit_first), 4096)?
	let over_limit: Http2Step = receive(InputChunk(byte_chunk_from_hex("0000060105000000073e3f82023e82")?), state)?
	let ignored_over_limit: () = require_failure_with_id("hpack-multiple-table-size-updates-over-limit", over_limit, "http2.peer_limit.header_table_size_exceeded")?
	let ignored_over_limit_state: () = require_hpack_state_table_size(step_state(over_limit), 4096)?
	let malformed: Http2Step = receive(InputChunk(byte_chunk_from_hex("0000030105000000093e3f80")?), state)?
	let ignored_malformed: () = require_failure_with_id("hpack-multiple-table-size-updates-malformed-middle", malformed, "hpack.fixture.table_size_update_malformed")?
	let ignored_malformed_state: () = require_hpack_state_table_size(step_state(malformed), 4096)?
	let after_field: Http2Step = receive(InputChunk(byte_chunk_from_hex("00000401050000000b3e823f01")?), state)?
	let ignored_after_field: () = require_failure_with_id("hpack-multiple-table-size-update-after-field", after_field, "hpack.fixture.table_size_update_not_at_start")?
	let ignored_after_field_state: () = require_hpack_state_table_size(step_state(after_field), 4096)?
	let third_update: Http2Step = receive(InputChunk(byte_chunk_from_hex("00000801050000000d3e3f013f02828784")?), state)?
	let ignored_third_update: () = require_completed_header_list_decode(third_update, state, ":method", "GET", 8)?
	let ignored_third_update_state: () = require_hpack_state_table_size(step_state(third_update), 33)?
	let failure_continuation_start: Http2Step = receive(InputChunk(byte_chunk_from_hex("00000301010000000d3e3f82")?), state)?
	let failure_continuation_done: Http2Step = receive(InputChunk(byte_chunk_from_hex("00000309040000000d023e82")?), step_state(failure_continuation_start))?
	let ignored_failure_continuation: () = require_failure_with_id("hpack-multiple-table-size-updates-failure-continuation-done", failure_continuation_done, "http2.peer_limit.header_table_size_exceeded")?
	let ignored_failure_continuation_size: () = require_hpack_state_table_size(step_state(failure_continuation_done), 4096)?
	let malformed_continuation_start: Http2Step = receive(InputChunk(byte_chunk_from_hex("00000201010000000f3e3f")?), seed_state)?
	let malformed_continuation_done: Http2Step = receive(InputChunk(byte_chunk_from_hex("00000109040000000f80")?), step_state(malformed_continuation_start))?
	let ignored_malformed_continuation: () = require_failure_with_id("hpack-multiple-table-size-updates-malformed-continuation-done", malformed_continuation_done, "hpack.fixture.table_size_update_malformed")?
	let ignored_malformed_continuation_size: () = require_hpack_state_table_size(step_state(malformed_continuation_done), 4096)?
	let ignored_malformed_continuation_entry: () = require_hpack_state_dynamic_entry_count(step_state(malformed_continuation_done), 1)?
	let third_continuation_start: Http2Step = receive(InputChunk(byte_chunk_from_hex("0000030101000000113e3f01")?), state)?
	let third_continuation_done: Http2Step = receive(InputChunk(byte_chunk_from_hex("0000050904000000113f02828784")?), step_state(third_continuation_start))?
	let ignored_third_continuation: () = require_completed_header_list_decode(third_continuation_done, state, ":method", "GET", 8)?
	let ignored_third_continuation_size: () = require_hpack_state_table_size(step_state(third_continuation_done), 33)?
	require_hpack_state_dynamic_entry_count(step_state(third_continuation_done), 0)
end

