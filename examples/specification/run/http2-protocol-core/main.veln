fn send_local_max_header_list_size_setting(value: Int, connection: Http2ConnectionState) -> Result<OutboundSettingsDecision, String>
	match connection
		ConnectionState(decode_state, outstanding_settings, pending_ack) => encode_local_max_header_list_size_intent(value, decode_state, outstanding_settings, pending_ack)
	end
