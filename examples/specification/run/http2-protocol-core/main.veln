fn state_highest_peer_created_stream_id(state: Http2DecodeState) -> Int
	highest_peer_created_stream_id(state_peer_settings(state))
end

fn state_promised_stream_id(state: Http2DecodeState) -> Int
	match state
		State(_, _, _, _, _, _, _, _, ReceiveFlowControl(_, ClientPushAssociatedStreamReceiveWindow(_, _, _, promised_stream_id)), _) => promised_stream_id
		State(_, _, _, _, _, _, _, _, _, _) => 0
	end
end

fn state_hpack_fixture_state(state: Http2DecodeState) -> HpackFixtureState
	match state
		State(_, _, _, _, hpack_state, _, _, _, _, _) => hpack_state
	end
end

fn hpack_carry_only_state(state: Http2DecodeState) -> Http2DecodeState
	match state
		State(_, next_offset, preface_state, continuation, hpack_state, receive_limit, peer_settings, shutdown_state, ReceiveFlowControl(connection_window, _), _) => State(byte_chunk([]), next_offset, preface_state, continuation, hpack_state, receive_limit, with_highest_peer_created_stream_id(peer_settings, 0), shutdown_state, ReceiveFlowControl(connection_window, NoOpenStreamReceiveWindow), NoPeerStreamAdmitted)
	end
end

fn connection_decode_state(connection: Http2ConnectionState) -> Http2DecodeState
	match connection
		ConnectionState(decode_state, _, _) => decode_state
	end
end

fn connection_outstanding_settings(connection: Http2ConnectionState) -> OutstandingLocalSettings
	match connection
		ConnectionState(_, outstanding_settings, _) => outstanding_settings
	end
end

fn connection_pending_settings_ack(connection: Http2ConnectionState) -> PendingPeerSettingsAck
	match connection
		ConnectionState(_, _, pending_ack) => pending_ack
	end
end

fn connection_step_state(step: Http2ConnectionStep) -> Http2ConnectionState
	match step
		ConnectionFrameDecoded(state, _) => state
		ConnectionWaiting(state) => state
		ConnectionFailed(state, _) => state
	end
end

fn connection_step_decode_step(step: Http2ConnectionStep) -> Http2Step
	match step
		ConnectionFrameDecoded(_, decode_step) => decode_step
		ConnectionWaiting(state) => Waiting(connection_decode_state(state))
		ConnectionFailed(state, failure) => Failed(connection_decode_state(state), failure)
	end
end

fn connection_step_failure(step: Http2ConnectionStep) -> Http2ProtocolFailure
	match step
		ConnectionFrameDecoded(_, _) => ClosedWithPending(0, 0, byte_chunk([]))
		ConnectionWaiting(_) => ClosedWithPending(0, 0, byte_chunk([]))
		ConnectionFailed(_, failure) => failure
	end
end

fn outstanding_settings_label(outstanding_settings: OutstandingLocalSettings) -> String
	match outstanding_settings
		NoOutstandingLocalSettings => "none"
		OutstandingLocalSettings(Nil) => "none"
		OutstandingLocalSettings(_) => "active"
	end
end

fn outstanding_settings_identifier(outstanding_settings: OutstandingLocalSettings) -> Int
	match outstanding_settings
		NoOutstandingLocalSettings => 0
		OutstandingLocalSettings(batches) => match batches
			Nil => 0
			Cons(LocalSettingsBatch(identifier, _), _) => identifier
		end
	end
end

fn outstanding_settings_count(outstanding_settings: OutstandingLocalSettings) -> Int
	match outstanding_settings
		NoOutstandingLocalSettings => 0
		OutstandingLocalSettings(batches) => match batches
			Nil => 0
			Cons(LocalSettingsBatch(_, count), _) => count
		end
	end
end

fn outstanding_settings_batch_count_value(batches: List<OutstandingLocalSettingsBatch>) -> Int
	match batches
		Nil => 0
		Cons(_, tail) => 1 + outstanding_settings_batch_count_value(tail)
	end
end

fn outstanding_settings_batch_count(outstanding_settings: OutstandingLocalSettings) -> Int
	match outstanding_settings
		NoOutstandingLocalSettings => 0
		OutstandingLocalSettings(batches) => outstanding_settings_batch_count_value(batches)
	end
end

fn pending_settings_ack_label(pending_ack: PendingPeerSettingsAck) -> String
	match pending_ack
		NoPendingPeerSettingsAck => "none"
		PendingPeerSettingsAck => "active"
	end
end

fn state_shutdown_state_value(state: Http2DecodeState) -> ConnectionShutdownState
	match state
		State(_, _, _, _, _, _, _, shutdown_state, _, _) => shutdown_state
	end
end

fn state_receive_flow_control(state: Http2DecodeState) -> ReceiveFlowControl
	match state
		State(_, _, _, _, _, _, _, _, receive_flow_control, _) => receive_flow_control
	end
end

fn state_highest_peer_stream_id(state: Http2DecodeState) -> Int
	match state
		State(_, _, _, _, _, _, _, _, _, NoPeerStreamAdmitted) => 0
		State(_, _, _, _, _, _, _, _, _, HighestPeerStreamId(stream_id)) => stream_id
	end
end

fn state_shutdown_label(state: Http2DecodeState) -> String
	match state
		State(_, _, _, _, _, _, _, OpenConnection, _, _) => "open"
		State(_, _, _, _, _, _, _, GracefulShutdown(_, _), _, _) => "graceful_shutdown"
		State(_, _, _, _, _, _, _, DrainedShutdown(_, _), _, _) => "drained_shutdown"
	end
end

fn shutdown_label(shutdown_state: ConnectionShutdownState) -> String
	match shutdown_state
		OpenConnection => "open"
		GracefulShutdown(_, _) => "graceful_shutdown"
		DrainedShutdown(_, _) => "drained_shutdown"
	end
end

fn state_shutdown_last_stream_id(state: Http2DecodeState) -> Int
	match state
		State(_, _, _, _, _, _, _, OpenConnection, _, _) => 0
		State(_, _, _, _, _, _, _, GracefulShutdown(last_stream_id, _), _, _) => last_stream_id
		State(_, _, _, _, _, _, _, DrainedShutdown(last_stream_id, _), _, _) => last_stream_id
	end
end

fn shutdown_last_stream_id(shutdown_state: ConnectionShutdownState) -> Int
	match shutdown_state
		OpenConnection => 0
		GracefulShutdown(last_stream_id, _) => last_stream_id
		DrainedShutdown(last_stream_id, _) => last_stream_id
	end
end

fn state_shutdown_error_code(state: Http2DecodeState) -> Int
	match state
		State(_, _, _, _, _, _, _, OpenConnection, _, _) => 0
		State(_, _, _, _, _, _, _, GracefulShutdown(_, error_code), _, _) => error_code
		State(_, _, _, _, _, _, _, DrainedShutdown(_, error_code), _, _) => error_code
	end
end

fn shutdown_error_code(shutdown_state: ConnectionShutdownState) -> Int
	match shutdown_state
		OpenConnection => 0
		GracefulShutdown(_, error_code) => error_code
		DrainedShutdown(_, error_code) => error_code
	end
end

fn state_connection_window(state: Http2DecodeState) -> Int
	match state
		State(_, _, _, _, _, _, _, _, ReceiveFlowControl(connection_window, _), _) => connection_window
	end
end

fn state_stream_window(state: Http2DecodeState) -> Int
	match state
		State(_, _, _, _, _, _, _, _, ReceiveFlowControl(_, NoOpenStreamReceiveWindow), _) => 0
		State(_, _, _, _, _, _, _, _, ReceiveFlowControl(_, OpenStreamReceiveWindow(_, stream_window, _)), _) => stream_window
		State(_, _, _, _, _, _, _, _, ReceiveFlowControl(_, TwoOpenStreamReceiveWindows(_, stream_window, _, _, _, _)), _) => stream_window
		State(_, _, _, _, _, _, _, _, ReceiveFlowControl(_, ThreeOpenStreamReceiveWindows(_, stream_window, _, _, _, _, _, _, _)), _) => stream_window
		State(_, _, _, _, _, _, _, _, ReceiveFlowControl(_, ClientPushAssociatedStreamReceiveWindow(_, stream_window, _, _)), _) => stream_window
		State(_, _, _, _, _, _, _, _, ReceiveFlowControl(_, HalfClosedLocalStreamReceiveWindow(_, stream_window, _)), _) => stream_window
		State(_, _, _, _, _, _, _, _, ReceiveFlowControl(_, ClosedByPeerStreamReceiveWindow(_, stream_window)), _) => stream_window
		State(_, _, _, _, _, _, _, _, ReceiveFlowControl(_, ResetStreamReceiveWindow(_, _)), _) => 0
	end
end

fn state_content_length_expected(state: Http2DecodeState) -> Int
	match state
		State(_, _, _, _, _, _, _, _, ReceiveFlowControl(_, OpenStreamReceiveWindow(_, _, priority)), _) => stream_priority_content_length_expected(priority)
		State(_, _, _, _, _, _, _, _, ReceiveFlowControl(_, TwoOpenStreamReceiveWindows(_, _, first_priority, _, _, _)), _) => stream_priority_content_length_expected(first_priority)
		State(_, _, _, _, _, _, _, _, ReceiveFlowControl(_, ThreeOpenStreamReceiveWindows(_, _, first_priority, _, _, _, _, _, _)), _) => stream_priority_content_length_expected(first_priority)
		State(_, _, _, _, _, _, _, _, ReceiveFlowControl(_, ClientPushAssociatedStreamReceiveWindow(_, _, priority, _)), _) => stream_priority_content_length_expected(priority)
		State(_, _, _, _, _, _, _, _, ReceiveFlowControl(_, HalfClosedLocalStreamReceiveWindow(_, _, priority)), _) => stream_priority_content_length_expected(priority)
		State(_, _, _, _, _, _, _, _, _, _) => -1
	end
end

fn state_content_length_observed(state: Http2DecodeState) -> Int
	match state
		State(_, _, _, _, _, _, _, _, ReceiveFlowControl(_, OpenStreamReceiveWindow(_, _, priority)), _) => stream_priority_content_length_observed(priority)
		State(_, _, _, _, _, _, _, _, ReceiveFlowControl(_, TwoOpenStreamReceiveWindows(_, _, first_priority, _, _, _)), _) => stream_priority_content_length_observed(first_priority)
		State(_, _, _, _, _, _, _, _, ReceiveFlowControl(_, ThreeOpenStreamReceiveWindows(_, _, first_priority, _, _, _, _, _, _)), _) => stream_priority_content_length_observed(first_priority)
		State(_, _, _, _, _, _, _, _, ReceiveFlowControl(_, ClientPushAssociatedStreamReceiveWindow(_, _, priority, _)), _) => stream_priority_content_length_observed(priority)
		State(_, _, _, _, _, _, _, _, ReceiveFlowControl(_, HalfClosedLocalStreamReceiveWindow(_, _, priority)), _) => stream_priority_content_length_observed(priority)
		State(_, _, _, _, _, _, _, _, _, _) => 0
	end
end

fn state_open_stream_id(state: Http2DecodeState) -> Int
	match state
		State(_, _, _, _, _, _, _, _, ReceiveFlowControl(_, NoOpenStreamReceiveWindow), _) => 0
		State(_, _, _, _, _, _, _, _, ReceiveFlowControl(_, OpenStreamReceiveWindow(stream_id, _, _)), _) => stream_id
		State(_, _, _, _, _, _, _, _, ReceiveFlowControl(_, TwoOpenStreamReceiveWindows(stream_id, _, _, _, _, _)), _) => stream_id
		State(_, _, _, _, _, _, _, _, ReceiveFlowControl(_, ThreeOpenStreamReceiveWindows(stream_id, _, _, _, _, _, _, _, _)), _) => stream_id
		State(_, _, _, _, _, _, _, _, ReceiveFlowControl(_, ClientPushAssociatedStreamReceiveWindow(stream_id, _, _, _)), _) => stream_id
		State(_, _, _, _, _, _, _, _, ReceiveFlowControl(_, HalfClosedLocalStreamReceiveWindow(_, _, _)), _) => 0
		State(_, _, _, _, _, _, _, _, ReceiveFlowControl(_, ClosedByPeerStreamReceiveWindow(_, _)), _) => 0
		State(_, _, _, _, _, _, _, _, ReceiveFlowControl(_, ResetStreamReceiveWindow(_, _)), _) => 0
	end
end

fn state_second_open_stream_id(state: Http2DecodeState) -> Int
	match state
		State(_, _, _, _, _, _, _, _, ReceiveFlowControl(_, TwoOpenStreamReceiveWindows(_, _, _, stream_id, _, _)), _) => stream_id
		State(_, _, _, _, _, _, _, _, ReceiveFlowControl(_, ThreeOpenStreamReceiveWindows(_, _, _, stream_id, _, _, _, _, _)), _) => stream_id
		State(_, _, _, _, _, _, _, _, _, _) => 0
	end
end

fn state_third_open_stream_id(state: Http2DecodeState) -> Int
	match state
		State(_, _, _, _, _, _, _, _, ReceiveFlowControl(_, ThreeOpenStreamReceiveWindows(_, _, _, _, _, _, stream_id, _, _)), _) => stream_id
		State(_, _, _, _, _, _, _, _, _, _) => 0
	end
end

fn state_reserved_by_peer_stream_id(state: Http2DecodeState) -> Int
	match state
		State(_, _, _, _, _, _, _, _, ReceiveFlowControl(_, ClientPushAssociatedStreamReceiveWindow(_, _, _, promised_stream_id)), _) => promised_stream_id
		State(_, _, _, _, _, _, _, _, _, _) => 0
	end
end

fn state_second_stream_window(state: Http2DecodeState) -> Int
	match state
		State(_, _, _, _, _, _, _, _, ReceiveFlowControl(_, TwoOpenStreamReceiveWindows(_, _, _, _, stream_window, _)), _) => stream_window
		State(_, _, _, _, _, _, _, _, ReceiveFlowControl(_, ThreeOpenStreamReceiveWindows(_, _, _, _, stream_window, _, _, _, _)), _) => stream_window
		State(_, _, _, _, _, _, _, _, _, _) => 0
	end
end

fn state_third_stream_window(state: Http2DecodeState) -> Int
	match state
		State(_, _, _, _, _, _, _, _, ReceiveFlowControl(_, ThreeOpenStreamReceiveWindows(_, _, _, _, _, _, _, stream_window, _)), _) => stream_window
		State(_, _, _, _, _, _, _, _, _, _) => 0
	end
end

fn state_open_stream_count(state: Http2DecodeState) -> Int
	match state
		State(_, _, _, _, _, _, _, _, ReceiveFlowControl(_, NoOpenStreamReceiveWindow), _) => 0
		State(_, _, _, _, _, _, _, _, ReceiveFlowControl(_, OpenStreamReceiveWindow(_, _, _)), _) => 1
		State(_, _, _, _, _, _, _, _, ReceiveFlowControl(_, TwoOpenStreamReceiveWindows(_, _, _, _, _, _)), _) => 2
		State(_, _, _, _, _, _, _, _, ReceiveFlowControl(_, ThreeOpenStreamReceiveWindows(_, _, _, _, _, _, _, _, _)), _) => 3
		State(_, _, _, _, _, _, _, _, ReceiveFlowControl(_, ClientPushAssociatedStreamReceiveWindow(_, _, _, _)), _) => 1
		State(_, _, _, _, _, _, _, _, ReceiveFlowControl(_, HalfClosedLocalStreamReceiveWindow(_, _, _)), _) => 0
		State(_, _, _, _, _, _, _, _, ReceiveFlowControl(_, ClosedByPeerStreamReceiveWindow(_, _)), _) => 0
		State(_, _, _, _, _, _, _, _, ReceiveFlowControl(_, ResetStreamReceiveWindow(_, _)), _) => 0
	end
end

fn state_half_closed_local_stream_id(state: Http2DecodeState) -> Int
	match state
		State(_, _, _, _, _, _, _, _, ReceiveFlowControl(_, NoOpenStreamReceiveWindow), _) => 0
		State(_, _, _, _, _, _, _, _, ReceiveFlowControl(_, OpenStreamReceiveWindow(_, _, _)), _) => 0
		State(_, _, _, _, _, _, _, _, ReceiveFlowControl(_, TwoOpenStreamReceiveWindows(_, _, _, _, _, _)), _) => 0
		State(_, _, _, _, _, _, _, _, ReceiveFlowControl(_, ThreeOpenStreamReceiveWindows(_, _, _, _, _, _, _, _, _)), _) => 0
		State(_, _, _, _, _, _, _, _, ReceiveFlowControl(_, ClientPushAssociatedStreamReceiveWindow(_, _, _, _)), _) => 0
		State(_, _, _, _, _, _, _, _, ReceiveFlowControl(_, HalfClosedLocalStreamReceiveWindow(stream_id, _, _)), _) => stream_id
		State(_, _, _, _, _, _, _, _, ReceiveFlowControl(_, ClosedByPeerStreamReceiveWindow(_, _)), _) => 0
		State(_, _, _, _, _, _, _, _, ReceiveFlowControl(_, ResetStreamReceiveWindow(_, _)), _) => 0
	end
end

fn state_closed_by_peer_stream_id(state: Http2DecodeState) -> Int
	match state
		State(_, _, _, _, _, _, _, _, ReceiveFlowControl(_, NoOpenStreamReceiveWindow), _) => 0
		State(_, _, _, _, _, _, _, _, ReceiveFlowControl(_, OpenStreamReceiveWindow(_, _, _)), _) => 0
		State(_, _, _, _, _, _, _, _, ReceiveFlowControl(_, TwoOpenStreamReceiveWindows(_, _, _, _, _, _)), _) => 0
		State(_, _, _, _, _, _, _, _, ReceiveFlowControl(_, ThreeOpenStreamReceiveWindows(_, _, _, _, _, _, _, _, _)), _) => 0
		State(_, _, _, _, _, _, _, _, ReceiveFlowControl(_, ClientPushAssociatedStreamReceiveWindow(_, _, _, _)), _) => 0
		State(_, _, _, _, _, _, _, _, ReceiveFlowControl(_, HalfClosedLocalStreamReceiveWindow(_, _, _)), _) => 0
		State(_, _, _, _, _, _, _, _, ReceiveFlowControl(_, ClosedByPeerStreamReceiveWindow(stream_id, _)), _) => stream_id
		State(_, _, _, _, _, _, _, _, ReceiveFlowControl(_, ResetStreamReceiveWindow(_, _)), _) => 0
	end
end

fn state_reset_stream_id(state: Http2DecodeState) -> Int
	match state
		State(_, _, _, _, _, _, _, _, ReceiveFlowControl(_, NoOpenStreamReceiveWindow), _) => 0
		State(_, _, _, _, _, _, _, _, ReceiveFlowControl(_, OpenStreamReceiveWindow(_, _, _)), _) => 0
		State(_, _, _, _, _, _, _, _, ReceiveFlowControl(_, TwoOpenStreamReceiveWindows(_, _, _, _, _, _)), _) => 0
		State(_, _, _, _, _, _, _, _, ReceiveFlowControl(_, ThreeOpenStreamReceiveWindows(_, _, _, _, _, _, _, _, _)), _) => 0
		State(_, _, _, _, _, _, _, _, ReceiveFlowControl(_, ClientPushAssociatedStreamReceiveWindow(_, _, _, _)), _) => 0
		State(_, _, _, _, _, _, _, _, ReceiveFlowControl(_, HalfClosedLocalStreamReceiveWindow(_, _, _)), _) => 0
		State(_, _, _, _, _, _, _, _, ReceiveFlowControl(_, ClosedByPeerStreamReceiveWindow(_, _)), _) => 0
		State(_, _, _, _, _, _, _, _, ReceiveFlowControl(_, ResetStreamReceiveWindow(stream_id, _)), _) => stream_id
	end
end

fn state_reset_error_code(state: Http2DecodeState) -> Int
	match state
		State(_, _, _, _, _, _, _, _, ReceiveFlowControl(_, NoOpenStreamReceiveWindow), _) => 0
		State(_, _, _, _, _, _, _, _, ReceiveFlowControl(_, OpenStreamReceiveWindow(_, _, _)), _) => 0
		State(_, _, _, _, _, _, _, _, ReceiveFlowControl(_, TwoOpenStreamReceiveWindows(_, _, _, _, _, _)), _) => 0
		State(_, _, _, _, _, _, _, _, ReceiveFlowControl(_, ThreeOpenStreamReceiveWindows(_, _, _, _, _, _, _, _, _)), _) => 0
		State(_, _, _, _, _, _, _, _, ReceiveFlowControl(_, HalfClosedLocalStreamReceiveWindow(_, _, _)), _) => 0
		State(_, _, _, _, _, _, _, _, ReceiveFlowControl(_, ClosedByPeerStreamReceiveWindow(_, _)), _) => 0
		State(_, _, _, _, _, _, _, _, ReceiveFlowControl(_, ResetStreamReceiveWindow(_, error_code)), _) => error_code
	end
end

fn state_priority_label(state: Http2DecodeState) -> String
	match state
		State(_, _, _, _, _, _, _, _, ReceiveFlowControl(_, OpenStreamReceiveWindow(_, _, priority)), _) => stream_priority_label(priority)
		State(_, _, _, _, _, _, _, _, ReceiveFlowControl(_, TwoOpenStreamReceiveWindows(_, _, first_priority, _, _, second_priority)), _) => first_tracked_priority_label(first_priority, second_priority)
		State(_, _, _, _, _, _, _, _, ReceiveFlowControl(_, ThreeOpenStreamReceiveWindows(_, _, first_priority, _, _, second_priority, _, _, third_priority)), _) => first_tracked_priority_label(first_tracked_priority(first_priority, second_priority), third_priority)
		State(_, _, _, _, _, _, _, _, ReceiveFlowControl(_, ClientPushAssociatedStreamReceiveWindow(_, _, priority, _)), _) => stream_priority_label(priority)
		State(_, _, _, _, _, _, _, _, ReceiveFlowControl(_, HalfClosedLocalStreamReceiveWindow(_, _, priority)), _) => stream_priority_label(priority)
		State(_, _, _, _, _, _, _, _, ReceiveFlowControl(_, NoOpenStreamReceiveWindow), _) => "none"
		State(_, _, _, _, _, _, _, _, ReceiveFlowControl(_, ClosedByPeerStreamReceiveWindow(_, _)), _) => "none"
		State(_, _, _, _, _, _, _, _, ReceiveFlowControl(_, ResetStreamReceiveWindow(_, _)), _) => "none"
	end
end

fn first_tracked_priority_label(first_priority: StreamPriorityState, second_priority: StreamPriorityState) -> String
	match stream_priority_label(first_priority)
		"tracked" => "tracked"
		_ => stream_priority_label(second_priority)
	end
end

fn first_tracked_priority(first_priority: StreamPriorityState, second_priority: StreamPriorityState) -> StreamPriorityState
	match stream_priority_label(first_priority)
		"tracked" => first_priority
		_ => second_priority
	end
end

fn stream_priority_label(priority: StreamPriorityState) -> String
	match priority
		StreamPriority(_, _, _) => "tracked"
		ExpectedContentLength(_, _, inner) => stream_priority_label(inner)
		ResponseHeaderStream(inner) => stream_priority_label(inner)
		NoStreamPriority => "none"
	end
end

fn state_priority_dependency_stream_id(state: Http2DecodeState) -> Int
	match state
		State(_, _, _, _, _, _, _, _, ReceiveFlowControl(_, OpenStreamReceiveWindow(_, _, priority)), _) => stream_priority_dependency_stream_id(priority)
		State(_, _, _, _, _, _, _, _, ReceiveFlowControl(_, TwoOpenStreamReceiveWindows(_, _, first_priority, _, _, second_priority)), _) => first_tracked_priority_dependency_stream_id(first_priority, second_priority)
		State(_, _, _, _, _, _, _, _, ReceiveFlowControl(_, ThreeOpenStreamReceiveWindows(_, _, first_priority, _, _, second_priority, _, _, third_priority)), _) => first_tracked_priority_dependency_stream_id(first_tracked_priority(first_priority, second_priority), third_priority)
		State(_, _, _, _, _, _, _, _, ReceiveFlowControl(_, ClientPushAssociatedStreamReceiveWindow(_, _, priority, _)), _) => stream_priority_dependency_stream_id(priority)
		State(_, _, _, _, _, _, _, _, ReceiveFlowControl(_, HalfClosedLocalStreamReceiveWindow(_, _, priority)), _) => stream_priority_dependency_stream_id(priority)
		State(_, _, _, _, _, _, _, _, ReceiveFlowControl(_, NoOpenStreamReceiveWindow), _) => 0
		State(_, _, _, _, _, _, _, _, ReceiveFlowControl(_, ClosedByPeerStreamReceiveWindow(_, _)), _) => 0
		State(_, _, _, _, _, _, _, _, ReceiveFlowControl(_, ResetStreamReceiveWindow(_, _)), _) => 0
	end
end

fn first_tracked_priority_dependency_stream_id(first_priority: StreamPriorityState, second_priority: StreamPriorityState) -> Int
	match stream_priority_label(first_priority)
		"tracked" => stream_priority_dependency_stream_id(first_priority)
		_ => stream_priority_dependency_stream_id(second_priority)
	end
end

fn stream_priority_dependency_stream_id(priority: StreamPriorityState) -> Int
	match priority
		StreamPriority(dependency_stream_id, _, _) => dependency_stream_id
		ExpectedContentLength(_, _, inner) => stream_priority_dependency_stream_id(inner)
		ResponseHeaderStream(inner) => stream_priority_dependency_stream_id(inner)
		NoStreamPriority => 0
	end
end

fn state_priority_exclusive(state: Http2DecodeState) -> Bool
	match state
		State(_, _, _, _, _, _, _, _, ReceiveFlowControl(_, OpenStreamReceiveWindow(_, _, priority)), _) => stream_priority_exclusive(priority)
		State(_, _, _, _, _, _, _, _, ReceiveFlowControl(_, TwoOpenStreamReceiveWindows(_, _, first_priority, _, _, second_priority)), _) => first_tracked_priority_exclusive(first_priority, second_priority)
		State(_, _, _, _, _, _, _, _, ReceiveFlowControl(_, ThreeOpenStreamReceiveWindows(_, _, first_priority, _, _, second_priority, _, _, third_priority)), _) => first_tracked_priority_exclusive(first_tracked_priority(first_priority, second_priority), third_priority)
		State(_, _, _, _, _, _, _, _, ReceiveFlowControl(_, ClientPushAssociatedStreamReceiveWindow(_, _, priority, _)), _) => stream_priority_exclusive(priority)
		State(_, _, _, _, _, _, _, _, ReceiveFlowControl(_, HalfClosedLocalStreamReceiveWindow(_, _, priority)), _) => stream_priority_exclusive(priority)
		State(_, _, _, _, _, _, _, _, ReceiveFlowControl(_, NoOpenStreamReceiveWindow), _) => false
		State(_, _, _, _, _, _, _, _, ReceiveFlowControl(_, ClosedByPeerStreamReceiveWindow(_, _)), _) => false
		State(_, _, _, _, _, _, _, _, ReceiveFlowControl(_, ResetStreamReceiveWindow(_, _)), _) => false
	end
end

fn first_tracked_priority_exclusive(first_priority: StreamPriorityState, second_priority: StreamPriorityState) -> Bool
	match stream_priority_label(first_priority)
		"tracked" => stream_priority_exclusive(first_priority)
		_ => stream_priority_exclusive(second_priority)
	end
end

fn stream_priority_exclusive(priority: StreamPriorityState) -> Bool
	match priority
		StreamPriority(_, exclusive, _) => exclusive
		ExpectedContentLength(_, _, inner) => stream_priority_exclusive(inner)
		ResponseHeaderStream(inner) => stream_priority_exclusive(inner)
		NoStreamPriority => false
	end
end

fn state_priority_weight(state: Http2DecodeState) -> Int
	match state
		State(_, _, _, _, _, _, _, _, ReceiveFlowControl(_, OpenStreamReceiveWindow(_, _, priority)), _) => stream_priority_weight(priority)
		State(_, _, _, _, _, _, _, _, ReceiveFlowControl(_, TwoOpenStreamReceiveWindows(_, _, first_priority, _, _, second_priority)), _) => first_tracked_priority_weight(first_priority, second_priority)
		State(_, _, _, _, _, _, _, _, ReceiveFlowControl(_, ThreeOpenStreamReceiveWindows(_, _, first_priority, _, _, second_priority, _, _, third_priority)), _) => first_tracked_priority_weight(first_tracked_priority(first_priority, second_priority), third_priority)
		State(_, _, _, _, _, _, _, _, ReceiveFlowControl(_, ClientPushAssociatedStreamReceiveWindow(_, _, priority, _)), _) => stream_priority_weight(priority)
		State(_, _, _, _, _, _, _, _, ReceiveFlowControl(_, HalfClosedLocalStreamReceiveWindow(_, _, priority)), _) => stream_priority_weight(priority)
		State(_, _, _, _, _, _, _, _, ReceiveFlowControl(_, NoOpenStreamReceiveWindow), _) => 0
		State(_, _, _, _, _, _, _, _, ReceiveFlowControl(_, ClosedByPeerStreamReceiveWindow(_, _)), _) => 0
		State(_, _, _, _, _, _, _, _, ReceiveFlowControl(_, ResetStreamReceiveWindow(_, _)), _) => 0
	end
end

fn first_tracked_priority_weight(first_priority: StreamPriorityState, second_priority: StreamPriorityState) -> Int
	match stream_priority_label(first_priority)
		"tracked" => stream_priority_weight(first_priority)
		_ => stream_priority_weight(second_priority)
	end
end

fn stream_priority_weight(priority: StreamPriorityState) -> Int
	match priority
		StreamPriority(_, _, weight) => weight
		ExpectedContentLength(_, _, inner) => stream_priority_weight(inner)
		ResponseHeaderStream(inner) => stream_priority_weight(inner)
		NoStreamPriority => 0
	end
end

fn outbound_data_status(decision: OutboundDataDecision) -> String
	match decision
		OutboundDataAccepted(_, _, _, _, _) => "accepted"
		OutboundDataRejected(_, _, _, _) => "rejected"
		OutboundDataEncodeFailed(_, _, _, _) => "encode_error"
	end
end

fn outbound_data_reason(decision: OutboundDataDecision) -> String
	match decision
		OutboundDataAccepted(_, _, _, _, _) => "none"
		OutboundDataRejected(_, _, _, error) => outbound_data_failure_reason(error)
		OutboundDataEncodeFailed(_, _, _, error) => encode_error_id(error)
	end
end

fn outbound_data_failure_reason(error: Http2ProtocolFailure) -> String
	match error
		FrameSizeExceeded(offset, observed_length, receive_limit, frame_kind, stream_id) => "peer_max_frame_size"
		ClosedWithPending(_, _, _) => failure_rule_provenance(error)
		ClosedWithPartialPreface(_, _) => failure_rule_provenance(error)
		InvalidPreface(_, _, _, _) => failure_rule_provenance(error)
		ContinuationExpected(offset, actual_kind, actual_stream, expected_stream, started_kind, started_offset, preview_chunk) => failure_rule_provenance(error)
		InvalidFrameKind(offset, actual_kind, stream_id, expected_kind, active_state, rule_provenance) => failure_rule_provenance(error)
		InvalidStreamId(offset, frame_kind, stream_id, required_domain, endpoint_role, active_state, rule_provenance) => failure_rule_provenance(error)
		PeerStreamIdNotIncreasing(offset, stream_id, previous_stream_id, endpoint_role, active_state, rule_provenance, preview_chunk) => failure_rule_provenance(error)
		InvalidPayloadLength(offset, frame_kind, stream_id, observed_length, expected_length, active_state, rule_provenance, preview) => failure_rule_provenance(error)
		InvalidWindowUpdateIncrement(offset, stream_id, observed_increment, accepted_min_increment, accepted_max_increment, active_state, rule_provenance, preview) => failure_rule_provenance(error)
		InvalidDataPadding(offset, stream_id, pad_length, remaining_payload_length, active_state, rule_provenance, preview) => failure_rule_provenance(error)
		ContentLengthMismatch(offset, frame_kind, stream_id, expected_length, observed_length, active_state, rule_provenance, preview) => failure_rule_provenance(error)
		InvalidRequestHeaderList(offset, frame_kind, stream_id, failed_header_fact, header_name, decoded_header_names, preview_chunk) => failure_rule_provenance(error)
		InvalidResponseHeaderList(offset, frame_kind, stream_id, failed_header_fact, header_name, decoded_header_names, active_state, preview_chunk) => failure_rule_provenance(error)
		UnexpectedSettingsAck(_, _, _, _) => failure_rule_provenance(error)
		SettingsNotAllowedForEndpoint(_, _, _, _, _, _, _, _) => failure_rule_provenance(error)
		InvalidPriorityDependency(offset, stream_id, dependency_stream_id, active_state, rule_provenance, preview) => failure_rule_provenance(error)
		StreamAfterGoaway(offset, stream_id, last_stream_id, shutdown_state, endpoint_role, rule_provenance, preview_chunk) => failure_rule_provenance(error)
		FlowControlWindowExceeded(offset, frame_kind, stream_id, observed_length, allowed_window_credit, active_state, rule_provenance, preview_chunk) => failure_rule_provenance(error)
		ConcurrentStreamsExceeded(offset, stream_id, attempted_count, allowed_count, endpoint_role, active_state, receive_limit_provenance, rule_provenance, preview_chunk) => failure_rule_provenance(error)
		HeaderListSizeExceeded(offset, observed_size, receive_limit, frame_kind, stream_id, rule_provenance, preview_chunk) => failure_rule_provenance(error)
		HeaderTableSizeExceeded(offset, observed_size, receive_limit, frame_kind, stream_id, rule_provenance, preview_chunk) => failure_rule_provenance(error)
		SettingsValueOutOfRange(offset, setting_identifier, setting_name, observed_value, accepted_min_value, accepted_max_value, peer_limit_provenance, preview) => failure_rule_provenance(error)
		HpackFixtureDecodeFailed(offset, observed_size, observed_first_byte, requested_dynamic_index, dynamic_table_entry_count, expected_fixture, codec_module, preview_chunk) => failure_rule_provenance(error)
		HpackTableSizeUpdateNotAtStart(offset, observed_size, observed_first_byte, observed_update_size, frame_kind, stream_id, active_state, expected_fixture, codec_module, preview_chunk) => failure_rule_provenance(error)
	end
end

fn outbound_data_stream(decision: OutboundDataDecision) -> Int
	match decision
		OutboundDataAccepted(stream_id, _, _, _, _) => stream_id
		OutboundDataRejected(stream_id, _, _, _) => stream_id
		OutboundDataEncodeFailed(stream_id, _, _, _) => stream_id
	end
end

fn outbound_data_payload_length(decision: OutboundDataDecision) -> Int
	match decision
		OutboundDataAccepted(_, payload_length, _, _, _) => payload_length
		OutboundDataRejected(_, payload_length, _, _) => payload_length
		OutboundDataEncodeFailed(_, payload_length, _, _) => payload_length
	end
end

fn outbound_data_allowed_length(decision: OutboundDataDecision) -> Int
	match decision
		OutboundDataAccepted(_, _, _, _, _) => 0
		OutboundDataRejected(_, _, _, error) => failure_allowed_length(error)
		OutboundDataEncodeFailed(_, _, _, _) => 0
	end
end

fn outbound_data_end_stream(decision: OutboundDataDecision) -> Int
	match decision
		OutboundDataAccepted(_, _, end_stream, _, _) => bool_to_int(end_stream)
		OutboundDataRejected(_, _, end_stream, _) => bool_to_int(end_stream)
		OutboundDataEncodeFailed(_, _, end_stream, _) => bool_to_int(end_stream)
	end
end

fn outbound_data_connection_window(decision: OutboundDataDecision) -> Int
	match decision
		OutboundDataAccepted(_, _, _, send_credit, _) => outbound_send_connection_window(send_credit)
		OutboundDataRejected(_, _, _, _) => 0
		OutboundDataEncodeFailed(_, _, _, _) => 0
	end
end

fn outbound_data_open_stream(decision: OutboundDataDecision) -> Int
	match decision
		OutboundDataAccepted(_, _, _, send_credit, _) => outbound_send_open_stream_id(send_credit)
		OutboundDataRejected(_, _, _, _) => 0
		OutboundDataEncodeFailed(_, _, _, _) => 0
	end
end

fn outbound_data_closed_stream(decision: OutboundDataDecision) -> Int
	match decision
		OutboundDataAccepted(_, _, _, send_credit, _) => outbound_send_closed_stream_id(send_credit)
		OutboundDataRejected(_, _, _, _) => 0
		OutboundDataEncodeFailed(_, _, _, _) => 0
	end
end

fn outbound_data_stream_window(decision: OutboundDataDecision) -> Int
	match decision
		OutboundDataAccepted(_, _, _, send_credit, _) => outbound_send_stream_window(send_credit)
		OutboundDataRejected(_, _, _, _) => 0
		OutboundDataEncodeFailed(_, _, _, _) => 0
	end
end

fn outbound_data_active_state(decision: OutboundDataDecision) -> String
	match decision
		OutboundDataAccepted(_, _, _, _, _) => "none"
		OutboundDataRejected(_, _, _, error) => failure_active_state(error)
		OutboundDataEncodeFailed(_, _, _, _) => "codec"
	end
end

fn outbound_data_chunk(decision: OutboundDataDecision) -> ByteChunk
	match decision
		OutboundDataAccepted(_, _, _, _, chunk) => chunk
		OutboundDataRejected(_, _, _, _) => byte_chunk([])
		OutboundDataEncodeFailed(_, _, _, _) => byte_chunk([])
	end
end

fn outbound_data_send_credit(decision: OutboundDataDecision) -> OutboundSendCredit
	match decision
		OutboundDataAccepted(_, _, _, send_credit, _) => send_credit
		OutboundDataRejected(_, _, _, _) => outbound_send_credit_without_stream(0)
		OutboundDataEncodeFailed(_, _, _, _) => outbound_send_credit_without_stream(0)
	end
end

fn outbound_data_stream_state_credit(decision: OutboundDataDecision) -> OutboundReceiveCredit
	send_credit_as_receive_credit(outbound_data_send_credit(decision))
end

fn send_credit_as_receive_credit(send_credit: OutboundSendCredit) -> OutboundReceiveCredit
	match send_credit
		OutboundSendCredit(connection_window, Nil) => OutboundReceiveCredit(connection_window, NoOutboundReceiveCreditStream)
		OutboundSendCredit(connection_window, Cons(NoOutboundReceiveCreditStream, _)) => OutboundReceiveCredit(connection_window, NoOutboundReceiveCreditStream)
		OutboundSendCredit(connection_window, Cons(OutboundReceiveCreditOpenStream(stream_id, stream_window), _)) => OutboundReceiveCredit(connection_window, OutboundReceiveCreditOpenStream(stream_id, stream_window))
		OutboundSendCredit(connection_window, Cons(OutboundReceiveCreditOpenStreamContentLength(stream_id, stream_window, _, _), _)) => OutboundReceiveCredit(connection_window, OutboundReceiveCreditOpenStream(stream_id, stream_window))
		OutboundSendCredit(connection_window, Cons(OutboundReceiveCreditClosedStream(stream_id), _)) => OutboundReceiveCredit(connection_window, OutboundReceiveCreditClosedStream(stream_id))
		OutboundSendCredit(connection_window, Cons(OutboundReceiveCreditResetStream(stream_id, error_code), _)) => OutboundReceiveCredit(connection_window, OutboundReceiveCreditResetStream(stream_id, error_code))
	end
end

fn outbound_data_failure(decision: OutboundDataDecision) -> Http2ProtocolFailure
	match decision
		OutboundDataAccepted(_, _, _, _, _) => ClosedWithPending(0, 0, byte_chunk([]))
		OutboundDataRejected(_, _, _, failure) => failure
		OutboundDataEncodeFailed(_, _, _, _) => ClosedWithPending(0, 0, byte_chunk([]))
	end
end

fn outbound_data_encode_path(decision: OutboundDataDecision) -> String
	match decision
		OutboundDataAccepted(_, _, _, _, _) => "none"
		OutboundDataRejected(_, _, _, _) => "none"
		OutboundDataEncodeFailed(_, _, _, error) => encode_error_path(error)
	end
end

fn outbound_data_encode_detail(decision: OutboundDataDecision) -> String
	match decision
		OutboundDataAccepted(_, _, _, _, _) => "none"
		OutboundDataRejected(_, _, _, _) => "none"
		OutboundDataEncodeFailed(_, _, _, error) => encode_error_reason(error)
	end
end

fn outbound_receive_connection_window(receive_credit: OutboundReceiveCredit) -> Int
	match receive_credit
		OutboundReceiveCredit(connection_window, _) => connection_window
	end
end

fn outbound_send_connection_window(send_credit: OutboundSendCredit) -> Int
	match send_credit
		OutboundSendCredit(connection_window, _) => connection_window
	end
end

fn outbound_receive_open_stream_id(receive_credit: OutboundReceiveCredit) -> Int
	match receive_credit
		OutboundReceiveCredit(_, NoOutboundReceiveCreditStream) => 0
		OutboundReceiveCredit(_, OutboundReceiveCreditOpenStream(stream_id, _)) => stream_id
		OutboundReceiveCredit(_, OutboundReceiveCreditOpenStreamContentLength(stream_id, _, _, _)) => stream_id
		OutboundReceiveCredit(_, OutboundReceiveCreditClosedStream(_)) => 0
		OutboundReceiveCredit(_, OutboundReceiveCreditResetStream(_, _)) => 0
	end
end

fn outbound_send_open_stream_id(send_credit: OutboundSendCredit) -> Int
	match send_credit
		OutboundSendCredit(_, streams) => first_outbound_open_stream_id(streams)
	end
end

fn first_outbound_open_stream_id(streams: List<OutboundReceiveCreditStream>) -> Int
	match streams
		Nil => 0
		Cons(NoOutboundReceiveCreditStream, tail) => first_outbound_open_stream_id(tail)
		Cons(OutboundReceiveCreditOpenStream(stream_id, _), _) => stream_id
		Cons(OutboundReceiveCreditOpenStreamContentLength(stream_id, _, _, _), _) => stream_id
		Cons(OutboundReceiveCreditClosedStream(_), tail) => first_outbound_open_stream_id(tail)
		Cons(OutboundReceiveCreditResetStream(_, _), tail) => first_outbound_open_stream_id(tail)
	end
end

fn outbound_receive_stream_window(receive_credit: OutboundReceiveCredit) -> Int
	match receive_credit
		OutboundReceiveCredit(_, NoOutboundReceiveCreditStream) => 0
		OutboundReceiveCredit(_, OutboundReceiveCreditOpenStream(_, stream_window)) => stream_window
		OutboundReceiveCredit(_, OutboundReceiveCreditOpenStreamContentLength(_, stream_window, _, _)) => stream_window
		OutboundReceiveCredit(_, OutboundReceiveCreditClosedStream(_)) => 0
		OutboundReceiveCredit(_, OutboundReceiveCreditResetStream(_, _)) => 0
	end
end

fn outbound_send_stream_window(send_credit: OutboundSendCredit) -> Int
	match send_credit
		OutboundSendCredit(_, streams) => first_outbound_stream_window(streams)
	end
end

fn first_outbound_stream_window(streams: List<OutboundReceiveCreditStream>) -> Int
	match streams
		Nil => 0
		Cons(NoOutboundReceiveCreditStream, tail) => first_outbound_stream_window(tail)
		Cons(OutboundReceiveCreditOpenStream(_, stream_window), _) => stream_window
		Cons(OutboundReceiveCreditOpenStreamContentLength(_, stream_window, _, _), _) => stream_window
		Cons(OutboundReceiveCreditClosedStream(_), tail) => first_outbound_stream_window(tail)
		Cons(OutboundReceiveCreditResetStream(_, _), tail) => first_outbound_stream_window(tail)
	end
end

fn outbound_receive_closed_stream_id(receive_credit: OutboundReceiveCredit) -> Int
	match receive_credit
		OutboundReceiveCredit(_, NoOutboundReceiveCreditStream) => 0
		OutboundReceiveCredit(_, OutboundReceiveCreditOpenStream(_, _)) => 0
		OutboundReceiveCredit(_, OutboundReceiveCreditOpenStreamContentLength(_, _, _, _)) => 0
		OutboundReceiveCredit(_, OutboundReceiveCreditClosedStream(stream_id)) => stream_id
		OutboundReceiveCredit(_, OutboundReceiveCreditResetStream(_, _)) => 0
	end
end

fn outbound_send_closed_stream_id(send_credit: OutboundSendCredit) -> Int
	match send_credit
		OutboundSendCredit(_, streams) => first_outbound_closed_stream_id(streams)
	end
end

fn first_outbound_closed_stream_id(streams: List<OutboundReceiveCreditStream>) -> Int
	match streams
		Nil => 0
		Cons(OutboundReceiveCreditClosedStream(stream_id), _) => stream_id
		Cons(_, tail) => first_outbound_closed_stream_id(tail)
	end
end

fn outbound_send_stream_window_for(send_credit: OutboundSendCredit, stream_id: Int) -> Int
	match send_credit
		OutboundSendCredit(_, streams) => outbound_stream_window_for(streams, stream_id)
	end
end

fn outbound_stream_window_for(streams: List<OutboundReceiveCreditStream>, stream_id: Int) -> Int
	match streams
		Nil => 0
		Cons(OutboundReceiveCreditOpenStream(candidate, stream_window), tail) => match candidate == stream_id
			true => stream_window
			false => outbound_stream_window_for(tail, stream_id)
		end
		Cons(OutboundReceiveCreditOpenStreamContentLength(candidate, stream_window, _, _), tail) => match candidate == stream_id
			true => stream_window
			false => outbound_stream_window_for(tail, stream_id)
		end
		Cons(_, tail) => outbound_stream_window_for(tail, stream_id)
	end
end

fn outbound_send_observed_length_for(send_credit: OutboundSendCredit, stream_id: Int) -> Int
	match send_credit
		OutboundSendCredit(_, streams) => outbound_observed_length_for(streams, stream_id)
	end
end

fn outbound_observed_length_for(streams: List<OutboundReceiveCreditStream>, stream_id: Int) -> Int
	match streams
		Nil => -1
		Cons(OutboundReceiveCreditOpenStreamContentLength(candidate, _, _, observed_length), tail) => match candidate == stream_id
			true => observed_length
			false => outbound_observed_length_for(tail, stream_id)
		end
		Cons(_, tail) => outbound_observed_length_for(tail, stream_id)
	end
end

fn bool_to_int(value: Bool) -> Int
	match value
		true => 1
		false => 0
	end
end

