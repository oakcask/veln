	print_step("server-settings-enable-push-accepted", server_enable_push)
	print_peer_settings("server-settings-enable-push-accepted", step_state(server_enable_push))
	let client_enable_push: Http2Step = receive_client(InputChunk(byte_chunk_from_hex("00000c040000000000000500008000000200000001")?), frame_state())?
	print_settings_role_failure("client-settings-enable-push-rejected", client_enable_push)
	print_peer_settings("client-settings-enable-push-rejected", step_state(client_enable_push))
	let ignored_client_enable_push_diagnostic: () = http2_protocol_diagnostic(step_failure(client_enable_push), DiagnosticContext(step_state(client_enable_push)))?
	let enable_push_settings_ack: Http2Step = receive(InputChunk(byte_chunk_from_hex("000000040100000000")?), step_state(peer_enable_push))?
