		true => state_continuation_stream(state)
		false => failure_expected_stream(failure)
	end
end

fn context_expected_kind(failure: Http2ProtocolFailure, state: Http2DecodeState) -> Int
	match failure_expected_kind(failure) == 0
		true => match state_continuation_label(state) == "active"
			true => 9
			false => 0
		end
		false => failure_expected_kind(failure)
	end
end

