fn failure_active_state(failure: Http2ProtocolFailure) -> String
	match failure
		ClosedWithPending(_, _) => "none"
		ClosedWithPartialPreface(_, _) => "connection-preface"
		InvalidPreface(_, _, _, _) => "connection-preface"
		ContinuationExpected(_, _, _, _, _, _) => "headers"
		InvalidFrameKind(_, _, _, _, active_state, _) => active_state
		InvalidStreamId(_, _, _, _, _, active_state, _) => active_state
		InvalidPayloadLength(_, _, _, _, _, active_state, _, _) => active_state
		InvalidDataPadding(_, _, _, _, active_state, _, _) => active_state
		UnexpectedSettingsAck(_, active_state, _) => active_state
		InvalidPriorityDependency(_, _, _, active_state, _, _) => active_state
		StreamAfterGoaway(_, _, _, shutdown_state, _, _) => shutdown_state
		FrameSizeExceeded(_, _, _, _, _) => "none"
		FlowControlWindowExceeded(_, _, _, _, _, active_state, _) => active_state
		ConcurrentStreamsExceeded(_, _, _, _, active_state, _, _) => active_state
		HeaderListSizeExceeded(_, _, _, _, _, _) => "header-list"
		SettingsValueOutOfRange(_, _, _, _, _, _, _) => "connection-control"
		HpackFixtureDecodeFailed(_, _, _, _, _) => "hpack-fixture"
	end
end

fn failure_rule_provenance(failure: Http2ProtocolFailure) -> String
	match failure
		ClosedWithPending(_, _) => "none"
		ClosedWithPartialPreface(_, _) => "rfc9113_client_connection_preface"
		InvalidPreface(_, _, _, _) => "rfc9113_client_connection_preface"
		ContinuationExpected(_, _, _, _, _, _) => "rfc9113_continuation_sequence"
		InvalidFrameKind(_, _, _, _, _, rule_provenance) => rule_provenance
		InvalidStreamId(_, _, _, _, _, _, rule_provenance) => rule_provenance
		InvalidPayloadLength(_, _, _, _, _, _, rule_provenance, _) => rule_provenance
		InvalidDataPadding(_, _, _, _, _, rule_provenance, _) => rule_provenance
		UnexpectedSettingsAck(_, _, rule_provenance) => rule_provenance
		InvalidPriorityDependency(_, _, _, _, rule_provenance, _) => rule_provenance
		StreamAfterGoaway(_, _, _, _, _, rule_provenance) => rule_provenance
		FrameSizeExceeded(_, _, _, _, _) => "none"
		FlowControlWindowExceeded(_, _, _, _, _, _, rule_provenance) => rule_provenance
		ConcurrentStreamsExceeded(_, _, _, _, _, _, rule_provenance) => rule_provenance
		HeaderListSizeExceeded(_, _, _, _, _, rule_provenance) => rule_provenance
		SettingsValueOutOfRange(_, _, _, _, _, _, _) => "http2_settings_value_range"
		HpackFixtureDecodeFailed(_, _, _, _, _) => "hpack_fixture_decode"
	end
end

