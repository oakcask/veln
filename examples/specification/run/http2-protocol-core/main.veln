	emit_output_chunk(name, 0, step_completed_header_block(step), expected_hex)
end

fn emit_frame_payload(name: String, step: Http2Step, expected_hex: String) -> Result<(), String> effects [stdio]
	emit_output_chunk_list_header(name, 1)
	emit_output_chunk(name, 0, step_frame_payload_chunk(step), expected_hex)
end

fn print_hpack_decoded(label: String, transition: HpackDecodeTransition) -> () effects [stdio]
	let headers: HpackHeaderList = hpack_fixture::transition_headers(transition)
	stdio::print(label)
	stdio::print(" hpack decoded ")
	stdio::print(hpack_fixture::header_list_first_name(headers))
	stdio::print(" ")
	stdio::print(hpack_fixture::header_list_first_value(headers))
	stdio::print(" wire_size ")
	stdio::print(int_to_string(hpack_fixture::header_list_wire_size(headers)))
	stdio::print(" next_decode_count ")
	stdio::println(int_to_string(hpack_fixture::state_decode_count(hpack_fixture::transition_state(transition))))
end

fn print_hpack_failed(label: String, failure: HpackFixtureFailure) -> () effects [stdio]
	stdio::print(label)
	stdio::print(" hpack failed ")
	stdio::println(hpack_fixture::hpack_failure_expected_fixture(failure))
end

fn print_hpack_state(label: String, state: Http2DecodeState) -> () effects [stdio]
	let hpack_state: HpackFixtureState = state_hpack_fixture_state(state)
	stdio::print(label)
	stdio::print(" hpack_state table_size ")
	stdio::print(int_to_string(hpack_fixture::state_table_size(hpack_state)))
	stdio::print(" decode_count ")
	stdio::println(int_to_string(hpack_fixture::state_decode_count(hpack_state)))
end

fn print_hpack_transition(label: String, step: Http2Step) -> () effects [stdio]
	match hpack_fixture::decode_header_block(step_completed_header_block(step), hpack_fixture::initial_state(), step_offset(step))
		Ok(transition) => print_hpack_decoded(label, transition)
		Err(failure) => print_hpack_failed(label, failure)
	end
end

fn print_hpack_transition_from_state(label: String, step: Http2Step, previous_state: Http2DecodeState) -> () effects [stdio]
	match hpack_fixture::decode_header_block(step_completed_header_block(step), state_hpack_fixture_state(previous_state), step_offset(step))
		Ok(transition) => print_hpack_decoded(label, transition)
		Err(failure) => print_hpack_failed(label, failure)
	end
end

fn hpack_decoded_next_state(label: String, transition: HpackDecodeTransition) -> HpackFixtureState effects [stdio]
	print_hpack_decoded(label, transition)
	hpack_fixture::transition_state(transition)
end

fn hpack_failed_same_state(label: String, failure: HpackFixtureFailure, state: HpackFixtureState) -> HpackFixtureState effects [stdio]
	print_hpack_failed(label, failure)
	state
end

fn print_hpack_boundary_with_state(label: String, block: ByteChunk, state: HpackFixtureState, offset: Int) -> HpackFixtureState effects [stdio]
	match hpack_fixture::decode_header_block(block, state, offset)
		Ok(transition) => hpack_decoded_next_state(label, transition)
		Err(failure) => hpack_failed_same_state(label, failure, state)
	end
end

fn print_hpack_stateful_replacement_cases(after_path: Http2Step) -> Result<(), String> effects [stdio]
	let base_state: Http2DecodeState = hpack_carry_only_state(step_state(after_path))
	let literal_method: Http2Step = receive(InputChunk(byte_chunk_from_hex("0000050104000000034203505554")?), base_state)?
	print_step("hpack-stateful-literal-indexed-method-put", literal_method)
	let ignored_literal_method: () = emit_header_block("http2-hpack-stateful-literal-indexed-method-put", literal_method, "4203505554")?
	print_hpack_transition_from_state("hpack-stateful-literal-indexed-method-put", literal_method, base_state)
	let method_state: Http2DecodeState = hpack_carry_only_state(step_state(literal_method))
	let dynamic_method: Http2Step = receive(InputChunk(byte_chunk_from_hex("000001010400000005be")?), method_state)?
	print_step("hpack-stateful-dynamic-indexed-method-put", dynamic_method)
	let ignored_dynamic_method: () = emit_header_block("http2-hpack-stateful-dynamic-indexed-method-put", dynamic_method, "be")?
	print_hpack_transition_from_state("hpack-stateful-dynamic-indexed-method-put", dynamic_method, method_state)
	let older_path: Http2Step = receive(InputChunk(byte_chunk_from_hex("000001010400000007bf")?), method_state)?
	print_step("hpack-stateful-dynamic-indexed-older-path", older_path)
	let ignored_older_path: () = emit_header_block("http2-hpack-stateful-dynamic-indexed-older-path", older_path, "bf")?
	print_hpack_transition_from_state("hpack-stateful-dynamic-indexed-older-path", older_path, method_state)
	let reduced_table_size: Http2Step = receive(InputChunk(byte_chunk_from_hex("0000010104000000093e")?), method_state)?
	print_step("hpack-stateful-table-size-eviction", reduced_table_size)
	let ignored_reduced_table_size: () = emit_header_block("http2-hpack-stateful-table-size-eviction", reduced_table_size, "3e")?
	print_hpack_transition_from_state("hpack-stateful-table-size-eviction", reduced_table_size, method_state)
	print_hpack_state("hpack-stateful-table-size-eviction", step_state(reduced_table_size))
	let evicted_newest: Http2Step = receive(InputChunk(byte_chunk_from_hex("00000101040000000bbe")?), hpack_carry_only_state(step_state(reduced_table_size)))?
	print_failure("hpack-stateful-after-table-size-eviction", evicted_newest)
	let continuation_start: Http2Step = receive(InputChunk(byte_chunk_from_hex("0000020100000000094203")?), hpack_carry_only_state(step_state(after_path)))?
	print_step("hpack-continuation-replacement-start", continuation_start)
	let continuation_done: Http2Step = receive(InputChunk(byte_chunk_from_hex("000003090400000009505554")?), step_state(continuation_start))?
	print_step("hpack-continuation-replacement-done", continuation_done)
	let ignored_continuation: () = emit_header_block("http2-hpack-continuation-replacement", continuation_done, "4203505554")?
	print_hpack_transition_from_state("hpack-continuation-replacement-done", continuation_done, step_state(continuation_start))
	let continuation_state: Http2DecodeState = hpack_carry_only_state(step_state(continuation_done))
	let after_continuation: Http2Step = receive(InputChunk(byte_chunk_from_hex("00000101040000000bbe")?), continuation_state)?
	print_step("hpack-after-continuation-replacement", after_continuation)
	print_hpack_transition_from_state("hpack-after-continuation-replacement", after_continuation, continuation_state)
	let continuation_older_path: Http2Step = receive(InputChunk(byte_chunk_from_hex("00000101040000000dbf")?), continuation_state)?
	print_step("hpack-continuation-older-path", continuation_older_path)
	let ignored_continuation_older_path: () = emit_header_block("http2-hpack-continuation-older-path", continuation_older_path, "bf")?
	print_hpack_transition_from_state("hpack-continuation-older-path", continuation_older_path, continuation_state)
	Ok(())
end

fn print_hpack_dynamic_table_cases() -> Result<(), String> effects [stdio]
	let first_state: HpackFixtureState = hpack_fixture::initial_state()
	let inserted_block: ByteChunk = byte_chunk_from_hex("44072f746172676574")?
	emit_output_chunk_list_header("http2-hpack-literal-indexed-path-target", 1)
	let ignored_inserted_block: () = emit_output_chunk("http2-hpack-literal-indexed-path-target", 0, inserted_block, "44072f746172676574")?
	let second_state: HpackFixtureState = print_hpack_boundary_with_state("hpack-literal-indexed-path-target", inserted_block, first_state, 0)
	let referenced_block: ByteChunk = byte_chunk_from_hex("be")?
	emit_output_chunk_list_header("http2-hpack-dynamic-indexed-path-target", 1)
	let ignored_referenced_block: () = emit_output_chunk("http2-hpack-dynamic-indexed-path-target", 0, referenced_block, "be")?
	let third_state: HpackFixtureState = print_hpack_boundary_with_state("hpack-dynamic-indexed-path-target", referenced_block, second_state, 9)
	let replacement_block: ByteChunk = byte_chunk_from_hex("4203505554")?
	emit_output_chunk_list_header("http2-hpack-literal-indexed-method-put", 1)
	let ignored_replacement_block: () = emit_output_chunk("http2-hpack-literal-indexed-method-put", 0, replacement_block, "4203505554")?
	let replaced_state: HpackFixtureState = print_hpack_boundary_with_state("hpack-literal-indexed-method-put", replacement_block, third_state, 10)
	let ignored_replaced_dynamic_state: HpackFixtureState = print_hpack_boundary_with_state("hpack-dynamic-indexed-method-put", referenced_block, replaced_state, 15)
	let evicted_block: ByteChunk = byte_chunk_from_hex("bf")?
	emit_output_chunk_list_header("http2-hpack-dynamic-indexed-older-path", 1)
	let ignored_older_block: () = emit_output_chunk("http2-hpack-dynamic-indexed-older-path", 0, evicted_block, "bf")?
	let ignored_older_state: HpackFixtureState = print_hpack_boundary_with_state("hpack-dynamic-indexed-older-path", evicted_block, replaced_state, 16)
	let reduced_block: ByteChunk = byte_chunk_from_hex("3e")?
	emit_output_chunk_list_header("http2-hpack-dynamic-table-size-eviction", 1)
	let ignored_reduced_block: () = emit_output_chunk("http2-hpack-dynamic-table-size-eviction", 0, reduced_block, "3e")?
	let reduced_state: HpackFixtureState = print_hpack_boundary_with_state("hpack-dynamic-table-size-eviction", reduced_block, replaced_state, 17)
	let ignored_evicted_state: HpackFixtureState = print_hpack_boundary_with_state("hpack-dynamic-indexed-after-size-eviction", referenced_block, reduced_state, 18)
	let ignored_state: HpackFixtureState = print_hpack_boundary_with_state("hpack-dynamic-indexed-missing", referenced_block, hpack_fixture::initial_state(), 10)
	Ok(())
end

