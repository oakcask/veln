	match failure
		ClosedWithPending(_, _, _) => 0
		ClosedWithPartialPreface(_, _) => 0
		InvalidPreface(_, _, actual_byte, _) => actual_byte
		ContinuationExpected(offset, actual_kind, actual_stream, expected_stream, started_kind, started_offset, preview_chunk) => actual_kind
		InvalidFrameKind(offset, actual_kind, stream_id, expected_kind, active_state, rule_provenance) => actual_kind
		InvalidStreamId(offset, frame_kind, stream_id, required_domain, endpoint_role, active_state, rule_provenance) => frame_kind
		InvalidPayloadLength(offset, frame_kind, stream_id, observed_length, expected_length, active_state, rule_provenance, preview) => frame_kind
		InvalidWindowUpdateIncrement(offset, stream_id, observed_increment, accepted_min_increment, accepted_max_increment, active_state, rule_provenance, preview) => 8
