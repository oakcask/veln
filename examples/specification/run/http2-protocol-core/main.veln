fn state_peer_settings(state: Http2DecodeState) -> PeerSettingsState
	match state
		State(_, _, _, _, _, peer_settings, _, _) => peer_settings
	end
end

fn connection_decode_state(connection: Http2ConnectionState) -> Http2DecodeState
	match connection
		ConnectionState(decode_state, _) => decode_state
	end
end

fn connection_outstanding_settings(connection: Http2ConnectionState) -> OutstandingLocalSettings
	match connection
		ConnectionState(_, outstanding_settings) => outstanding_settings
	end
end

fn connection_step_state(step: Http2ConnectionStep) -> Http2ConnectionState
	match step
		ConnectionFrameDecoded(state, _) => state
		ConnectionWaiting(state) => state
		ConnectionFailed(state, _) => state
	end
end

fn connection_step_decode_step(step: Http2ConnectionStep) -> Http2Step
	match step
		ConnectionFrameDecoded(_, decode_step) => decode_step
		ConnectionWaiting(state) => Waiting(connection_decode_state(state))
		ConnectionFailed(state, failure) => Failed(connection_decode_state(state), failure)
	end
end

fn connection_step_failure(step: Http2ConnectionStep) -> Http2ProtocolFailure
	match step
		ConnectionFrameDecoded(_, _) => ClosedWithPending(0, 0)
		ConnectionWaiting(_) => ClosedWithPending(0, 0)
		ConnectionFailed(_, failure) => failure
	end
end

fn outstanding_settings_label(outstanding_settings: OutstandingLocalSettings) -> String
	match outstanding_settings
		NoOutstandingLocalSettings => "none"
		OutstandingLocalSettings(_, _) => "active"
	end
end

fn outstanding_settings_identifier(outstanding_settings: OutstandingLocalSettings) -> Int
	match outstanding_settings
		NoOutstandingLocalSettings => 0
		OutstandingLocalSettings(identifier, _) => identifier
	end
end

fn outstanding_settings_count(outstanding_settings: OutstandingLocalSettings) -> Int
	match outstanding_settings
		NoOutstandingLocalSettings => 0
		OutstandingLocalSettings(_, count) => count
	end
end

fn state_shutdown_state_value(state: Http2DecodeState) -> ConnectionShutdownState
	match state
		State(_, _, _, _, _, _, shutdown_state, _) => shutdown_state
	end
end

fn state_receive_flow_control(state: Http2DecodeState) -> ReceiveFlowControl
	match state
		State(_, _, _, _, _, _, _, receive_flow_control) => receive_flow_control
	end
end

fn state_shutdown_label(state: Http2DecodeState) -> String
	match state
		State(_, _, _, _, _, _, OpenConnection, _) => "open"
		State(_, _, _, _, _, _, GracefulShutdown(_, _), _) => "graceful_shutdown"
	end
end

fn state_shutdown_last_stream_id(state: Http2DecodeState) -> Int
	match state
		State(_, _, _, _, _, _, OpenConnection, _) => 0
		State(_, _, _, _, _, _, GracefulShutdown(last_stream_id, _), _) => last_stream_id
	end
end

fn state_shutdown_error_code(state: Http2DecodeState) -> Int
	match state
		State(_, _, _, _, _, _, OpenConnection, _) => 0
		State(_, _, _, _, _, _, GracefulShutdown(_, error_code), _) => error_code
	end
end

fn state_connection_window(state: Http2DecodeState) -> Int
	match state
		State(_, _, _, _, _, _, _, ReceiveFlowControl(connection_window, _)) => connection_window
	end
end

fn state_stream_window(state: Http2DecodeState) -> Int
	match state
		State(_, _, _, _, _, _, _, ReceiveFlowControl(_, NoOpenStreamReceiveWindow)) => 0
		State(_, _, _, _, _, _, _, ReceiveFlowControl(_, OpenStreamReceiveWindow(_, stream_window))) => stream_window
		State(_, _, _, _, _, _, _, ReceiveFlowControl(_, ClosedByPeerStreamReceiveWindow(_, stream_window))) => stream_window
		State(_, _, _, _, _, _, _, ReceiveFlowControl(_, ResetStreamReceiveWindow(_, _))) => 0
	end
end

fn state_open_stream_id(state: Http2DecodeState) -> Int
	match state
		State(_, _, _, _, _, _, _, ReceiveFlowControl(_, NoOpenStreamReceiveWindow)) => 0
		State(_, _, _, _, _, _, _, ReceiveFlowControl(_, OpenStreamReceiveWindow(stream_id, _))) => stream_id
		State(_, _, _, _, _, _, _, ReceiveFlowControl(_, ClosedByPeerStreamReceiveWindow(_, _))) => 0
		State(_, _, _, _, _, _, _, ReceiveFlowControl(_, ResetStreamReceiveWindow(_, _))) => 0
	end
end

fn state_open_stream_count(state: Http2DecodeState) -> Int
	match state
		State(_, _, _, _, _, _, _, ReceiveFlowControl(_, NoOpenStreamReceiveWindow)) => 0
		State(_, _, _, _, _, _, _, ReceiveFlowControl(_, OpenStreamReceiveWindow(_, _))) => 1
		State(_, _, _, _, _, _, _, ReceiveFlowControl(_, ClosedByPeerStreamReceiveWindow(_, _))) => 0
		State(_, _, _, _, _, _, _, ReceiveFlowControl(_, ResetStreamReceiveWindow(_, _))) => 0
	end
end

fn state_closed_by_peer_stream_id(state: Http2DecodeState) -> Int
	match state
		State(_, _, _, _, _, _, _, ReceiveFlowControl(_, NoOpenStreamReceiveWindow)) => 0
		State(_, _, _, _, _, _, _, ReceiveFlowControl(_, OpenStreamReceiveWindow(_, _))) => 0
		State(_, _, _, _, _, _, _, ReceiveFlowControl(_, ClosedByPeerStreamReceiveWindow(stream_id, _))) => stream_id
		State(_, _, _, _, _, _, _, ReceiveFlowControl(_, ResetStreamReceiveWindow(_, _))) => 0
	end
end

fn state_reset_stream_id(state: Http2DecodeState) -> Int
	match state
		State(_, _, _, _, _, _, _, ReceiveFlowControl(_, NoOpenStreamReceiveWindow)) => 0
		State(_, _, _, _, _, _, _, ReceiveFlowControl(_, OpenStreamReceiveWindow(_, _))) => 0
		State(_, _, _, _, _, _, _, ReceiveFlowControl(_, ClosedByPeerStreamReceiveWindow(_, _))) => 0
		State(_, _, _, _, _, _, _, ReceiveFlowControl(_, ResetStreamReceiveWindow(stream_id, _))) => stream_id
	end
end

fn state_reset_error_code(state: Http2DecodeState) -> Int
	match state
		State(_, _, _, _, _, _, _, ReceiveFlowControl(_, NoOpenStreamReceiveWindow)) => 0
		State(_, _, _, _, _, _, _, ReceiveFlowControl(_, OpenStreamReceiveWindow(_, _))) => 0
		State(_, _, _, _, _, _, _, ReceiveFlowControl(_, ClosedByPeerStreamReceiveWindow(_, _))) => 0
		State(_, _, _, _, _, _, _, ReceiveFlowControl(_, ResetStreamReceiveWindow(_, error_code))) => error_code
	end
end

fn outbound_data_status(decision: OutboundDataDecision) -> String
	match decision
		OutboundDataAccepted(_) => "accepted"
		OutboundDataFrameSizeRejected(_, _) => "rejected"
		OutboundDataConnectionWindowRejected(_, _, _) => "rejected"
		OutboundDataStreamWindowRejected(_, _, _) => "rejected"
	end
end

fn outbound_data_reason(decision: OutboundDataDecision) -> String
	match decision
		OutboundDataAccepted(_) => "none"
		OutboundDataFrameSizeRejected(_, _) => "peer_max_frame_size"
		OutboundDataConnectionWindowRejected(_, _, _) => "outbound_connection_window"
		OutboundDataStreamWindowRejected(_, _, _) => "outbound_stream_window"
	end
end

fn outbound_data_stream(decision: OutboundDataDecision) -> Int
	match decision
		OutboundDataAccepted(flow_control) => outbound_open_stream_id(flow_control)
		OutboundDataFrameSizeRejected(_, _) => 0
		OutboundDataConnectionWindowRejected(stream_id, _, _) => stream_id
		OutboundDataStreamWindowRejected(stream_id, _, _) => stream_id
	end
end

fn outbound_data_observed_length(decision: OutboundDataDecision) -> Int
	match decision
		OutboundDataAccepted(_) => 0
		OutboundDataFrameSizeRejected(observed_length, _) => observed_length
		OutboundDataConnectionWindowRejected(_, observed_length, _) => observed_length
		OutboundDataStreamWindowRejected(_, observed_length, _) => observed_length
	end
end

fn outbound_data_allowed_length(decision: OutboundDataDecision) -> Int
	match decision
		OutboundDataAccepted(_) => 0
		OutboundDataFrameSizeRejected(_, allowed_length) => allowed_length
		OutboundDataConnectionWindowRejected(_, _, allowed_length) => allowed_length
		OutboundDataStreamWindowRejected(_, _, allowed_length) => allowed_length
	end
end

fn outbound_data_connection_window(decision: OutboundDataDecision) -> Int
	match decision
		OutboundDataAccepted(flow_control) => outbound_connection_window(flow_control)
		OutboundDataFrameSizeRejected(_, _) => 0
		OutboundDataConnectionWindowRejected(_, _, _) => 0
		OutboundDataStreamWindowRejected(_, _, _) => 0
	end
end

fn outbound_data_stream_window(decision: OutboundDataDecision) -> Int
	match decision
		OutboundDataAccepted(flow_control) => outbound_stream_window(flow_control)
		OutboundDataFrameSizeRejected(_, _) => 0
		OutboundDataConnectionWindowRejected(_, _, _) => 0
		OutboundDataStreamWindowRejected(_, _, _) => 0
	end
end

fn outbound_connection_window(flow_control: OutboundFlowControl) -> Int
	match flow_control
		OutboundFlowControl(connection_window, _) => connection_window
	end
end

fn outbound_open_stream_id(flow_control: OutboundFlowControl) -> Int
	match flow_control
		OutboundFlowControl(_, NoOutboundOpenStreamWindow) => 0
		OutboundFlowControl(_, OutboundOpenStreamWindow(stream_id, _)) => stream_id
	end
