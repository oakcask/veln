fn print_ping_cases() -> Result<(), String> effects [stdio]
	let ping_data: Http2Step = receive(InputChunk(byte_chunk_from_hex("0000080600000000000102030405060708")?), frame_state())?
	print_ping("ping-data", ping_data)
	let ping_ack_intent: OutboundPingAckDecision = send_ping_ack_for_received(ping_data)?
	print_outbound_ping_ack("outbound-ping-ack", ping_ack_intent)
	let ignored_ping_ack_chunk: () = print_outbound_ping_ack_chunks("http2-ping-ack", ping_ack_intent, "0000080601000000000102030405060708")?
	let ping_ack: Http2Step = receive(InputChunk(byte_chunk_from_hex("0000080601000000000102030405060708")?), frame_state())?
	print_ping("ping-ack", ping_ack)
	let ping_ack_no_response: OutboundPingAckDecision = send_ping_ack_for_received(ping_ack)?
	print_outbound_ping_ack("outbound-ping-ack-received", ping_ack_no_response)
	let ignored_ping_ack_no_response: () = print_outbound_ping_ack_chunks("http2-ping-ack-received", ping_ack_no_response, "")?
	let ping_bad_length: Http2Step = receive(InputChunk(byte_chunk_from_hex("00000706000000000001020304050607")?), frame_state())?
	print_failure("ping-length", ping_bad_length)
	let ping_bad_stream: Http2Step = receive(InputChunk(byte_chunk_from_hex("0000080600000000010102030405060708")?), frame_state())?
	print_failure("ping-stream", ping_bad_stream)
	Ok(())
end

