	print_settings_failure("settings-range", peer_settings_too_low)
	print_peer_settings("settings-range", step_state(peer_settings_too_low))
	let peer_settings_too_high: Http2Step = receive(InputChunk(byte_chunk_from_hex("000006040000000000000501000000")?), frame_state())?
	print_settings_failure("settings-range-high", peer_settings_too_high)
	print_peer_settings("settings-range-high", step_state(peer_settings_too_high))
	let peer_advertised_too_large: Http2Step = receive(InputChunk(byte_chunk_from_hex("004001000000000003")?), step_state(peer_settings))?
	print_failure("frame-size-peer-advertised", peer_advertised_too_large)
	print_peer_settings("frame-size-peer-advertised", step_state(peer_advertised_too_large))
	let peer_initial_window: Http2Step = receive(InputChunk(byte_chunk_from_hex("000006040000000000000400000003")?), frame_state())?
	print_step("peer-initial-window", peer_initial_window)
	print_peer_settings("peer-initial-window", step_state(peer_initial_window))
	let peer_initial_window_high: Http2Step = receive(InputChunk(byte_chunk_from_hex("000006040000000000000480000000")?), frame_state())?
	print_settings_failure("settings-initial-window-high", peer_initial_window_high)
	print_peer_settings("settings-initial-window-high", step_state(peer_initial_window_high))
	let peer_enable_push_high: Http2Step = receive(InputChunk(byte_chunk_from_hex("000006040000000000000200000002")?), frame_state())?
	print_settings_failure("settings-enable-push-high", peer_enable_push_high)
	print_peer_settings("settings-enable-push-high", step_state(peer_enable_push_high))
	let peer_initial_window_headers: Http2Step = receive(InputChunk(byte_chunk_from_hex("000000010400000001")?), step_state(peer_initial_window))?
	let peer_initial_window_data: Http2Step = receive(InputChunk(byte_chunk_from_hex("00000400000000000101020304")?), step_state(peer_initial_window_headers))?
	print_step("peer-initial-window-data", peer_initial_window_data)
	print_peer_settings("peer-initial-window-data", step_state(peer_initial_window_data))
	print_receive_windows("peer-initial-window-data", step_state(peer_initial_window_data))
	let ignored_outbound_send_intent_cases: () = print_outbound_send_intent_cases()?
	let ignored_initial_window_update_cases: () = print_initial_window_update_cases()?
	let ignored_stream_id_domain_cases: () = print_stream_id_domain_cases(header_start)?
	let ignored_data_receive_cases: () = print_data_receive_cases()?
	let window_update_connection: Http2Step = receive(InputChunk(byte_chunk_from_hex("00000408000000000000000005")?), receive_window_state(10, 1, 20))?
	print_step("window-update-connection", window_update_connection)
	print_receive_windows("window-update-connection", step_state(window_update_connection))
	let window_update_stream: Http2Step = receive(InputChunk(byte_chunk_from_hex("00000408000000000100000007")?), receive_window_state(10, 1, 20))?
	print_step("window-update-stream", window_update_stream)
	print_receive_windows("window-update-stream", step_state(window_update_stream))
	let window_update_bad_length: Http2Step = receive(InputChunk(byte_chunk_from_hex("000003080000000000000001")?), receive_window_state(10, 1, 20))?
	print_failure("window-update-length", window_update_bad_length)
	let window_update_idle_stream: Http2Step = receive(InputChunk(byte_chunk_from_hex("00000408000000000300000001")?), frame_state())?
	print_failure("window-update-idle", window_update_idle_stream)
	let window_update_zero: Http2Step = receive(InputChunk(byte_chunk_from_hex("00000408000000000000000000")?), receive_window_state(10, 1, 20))?
	print_failure("window-update-zero", window_update_zero)
	let window_update_connection_overflow: Http2Step = receive(InputChunk(byte_chunk_from_hex("00000408000000000000000008")?), receive_window_state(2147483640, 1, 20))?
	print_failure("window-update-connection-overflow", window_update_connection_overflow)
	let window_update_stream_overflow: Http2Step = receive(InputChunk(byte_chunk_from_hex("00000408000000000100000008")?), receive_window_state(20, 1, 2147483640))?
	print_failure("window-update-stream-overflow", window_update_stream_overflow)
	let ignored_ping_cases: () = print_ping_cases()?
	let ignored_priority_cases: () = print_priority_cases()?
	let encoded_settings_header: Result<ByteChunk, EncodeError> = match print_goaway_receive_cases()
		Ok(_) => encode_frame_header({length: 0, kind: 4, flags: 0, stream_id: 0})
		Err(error) => Err(error)?
	end
	let ignored_settings_header: () = print_encoded_header("http2-settings-header", encoded_settings_header, "000000040000000000")?
	let encoded_data_header: Result<ByteChunk, EncodeError> = encode_frame_header({length: 5, kind: 0, flags: 1, stream_id: 1})
	let ignored_data_header: () = print_encoded_header("http2-data-header", encoded_data_header, "000005000100000001")?
	let encoded_max_stream_header: Result<ByteChunk, EncodeError> = encode_frame_header({length: 0, kind: 8, flags: 0, stream_id: 2147483647})
	let ignored_max_stream_header: () = print_encoded_header("http2-max-stream-header", encoded_max_stream_header, "00000008007fffffff")?
	let invalid_stream_header: Result<ByteChunk, EncodeError> = encode_frame_header({length: 0, kind: 0, flags: 0, stream_id: 2147483648})
	print_encode_error("http2-stream-id-range", invalid_stream_header)
	Ok(())
end
