		State(_, _, _, _, _, _, PeerSettings(_, _, NoPeerEnablePush, _, _, _, _), _, _, _) => 0
		State(_, _, _, _, _, _, PeerSettings(_, _, PeerEnablePush(value, _), _, _, _, _), _, _, _) => value
		State(_, _, _, _, _, _, PeerSettings(_, _, PeerEnableConnectProtocol(_, _), _, _, _, _), _, _, _) => 0
		State(_, _, _, _, _, _, PeerSettings(_, _, PeerEnablePushAndConnectProtocol(value, _, _, _), _, _, _, _), _, _, _) => value
	end
