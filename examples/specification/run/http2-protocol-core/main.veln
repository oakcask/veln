fn print_local_initial_window_size_settings_case() -> Result<(), String> effects [stdio]
	let sent: OutboundSettingsDecision = send_local_initial_window_size_setting(65535, connection_state(frame_state()))?
	print_outbound_settings("local-initial-window-size-settings-sent", sent)
	let ignored_chunk: () = emit_encoded_header("http2-local-initial-window-size-settings", outbound_settings_chunk(sent), "00000604000000000000040000ffff")?
	print_outstanding_settings("local-initial-window-size-settings-sent", outbound_settings_connection(sent))
	let ack: Http2ConnectionStep = receive_connection(InputChunk(byte_chunk_from_hex("000000040100000000")?), outbound_settings_connection(sent))?
	print_step("local-initial-window-size-settings-ack", connection_step_decode_step(ack))
	print_outstanding_settings("local-initial-window-size-settings-ack", connection_step_state(ack))
	let ignored_max_concurrent_streams_case: () = print_local_max_concurrent_streams_settings_case()?
	Ok(())
end

fn print_local_max_concurrent_streams_settings_case() -> Result<(), String> effects [stdio]
	let sent: OutboundSettingsDecision = send_local_max_concurrent_streams_setting(100, connection_state(frame_state()))?
	print_outbound_settings("local-max-concurrent-streams-settings-sent", sent)
	let ignored_chunk: () = emit_encoded_header("http2-local-max-concurrent-streams-settings", outbound_settings_chunk(sent), "000006040000000000000300000064")?
	print_outstanding_settings("local-max-concurrent-streams-settings-sent", outbound_settings_connection(sent))
	let ack: Http2ConnectionStep = receive_connection(InputChunk(byte_chunk_from_hex("000000040100000000")?), outbound_settings_connection(sent))?
	print_step("local-max-concurrent-streams-settings-ack", connection_step_decode_step(ack))
	print_outstanding_settings("local-max-concurrent-streams-settings-ack", connection_step_state(ack))
	Ok(())
end

