	print_step("trailers-continuation-start", trailer_continuation_start)
	let trailer_continuation_done: Http2Step = receive(InputChunk(byte_chunk_from_hex("0000020904000000012324")?), step_state(trailer_continuation_start))?
	print_step("trailers-continuation-done", trailer_continuation_done)
	let ignored_trailers_continuation: () = emit_header_block("http2-trailers-continuation", trailer_continuation_done, "21222324")?
