fn empty_state() -> Http2DecodeState
	State(byte_chunk([]), 0, ExpectPreface, NoContinuation, hpack_fixture::initial_state(), protocol_default_frame_size_limit(), empty_peer_settings(), OpenConnection, default_receive_flow_control(), NoPeerStreamAdmitted)
end

fn frame_state() -> Http2DecodeState
	State(byte_chunk([]), 0, AfterPreface, NoContinuation, hpack_fixture::initial_state(), protocol_default_frame_size_limit(), empty_peer_settings(), OpenConnection, default_receive_flow_control(), NoPeerStreamAdmitted)
end

fn local_config_state(max_frame_size: Int) -> Http2DecodeState
	State(byte_chunk([]), 0, AfterPreface, NoContinuation, hpack_fixture::initial_state(), ReceiveLimit(max_frame_size, LocalConfiguration), empty_peer_settings(), OpenConnection, default_receive_flow_control(), NoPeerStreamAdmitted)
end

fn local_settings_state(max_frame_size: Int, item_offset: Int) -> Http2DecodeState
	State(byte_chunk([]), 0, AfterPreface, NoContinuation, hpack_fixture::initial_state(), ReceiveLimit(max_frame_size, LocalSettingsItem(item_offset)), empty_peer_settings(), OpenConnection, default_receive_flow_control(), NoPeerStreamAdmitted)
end

fn receive_window_state(connection_window: Int, stream_id: Int, stream_window: Int) -> Http2DecodeState
	State(byte_chunk([]), 0, AfterPreface, NoContinuation, hpack_fixture::initial_state(), protocol_default_frame_size_limit(), empty_peer_settings(), OpenConnection, ReceiveFlowControl(connection_window, OpenStreamReceiveWindow(stream_id, stream_window, NoStreamPriority)), HighestPeerStreamId(stream_id))
end

fn client_push_receive_state(connection_window: Int, stream_id: Int, stream_window: Int) -> Http2DecodeState
	State(byte_chunk([]), 0, AfterPreface, NoContinuation, hpack_fixture::initial_state(), protocol_default_frame_size_limit(), empty_peer_settings(), OpenConnection, ReceiveFlowControl(connection_window, ClientPushAssociatedStreamReceiveWindow(stream_id, stream_window, NoStreamPriority, 0)), NoPeerStreamAdmitted)
end

fn encode_frame_header(header: {length: Int, kind: Int, flags: Int, stream_id: Int}) -> Result<ByteChunk, EncodeError>
	byte_encode_http2_frame_header_wire(header)
end

fn encode_rst_stream_payload(payload: {error_code: Int}) -> Result<ByteChunk, EncodeError>
	byte_encode_http2_rst_stream_payload_wire(payload)
end

fn encode_window_update_payload(payload: {increment: Int}) -> Result<ByteChunk, EncodeError>
	byte_encode_http2_window_update_payload_wire(payload)
end

fn encode_goaway_payload(payload: {last_stream_id: Int, error_code: Int}) -> Result<ByteChunk, EncodeError>
	byte_encode_http2_goaway_payload_wire(payload)
end

fn encode_priority_dependency_payload(payload: {dependency_stream_id: Int}) -> Result<ByteChunk, EncodeError>
	byte_encode_http2_priority_dependency_payload_wire(payload)
end

fn encode_priority_weight_payload(payload: {weight: Int}) -> Result<ByteChunk, EncodeError>
	byte_encode_http2_priority_weight_payload_wire(payload)
end

fn encode_push_promise_payload(payload: {promised_stream_id: Int}) -> Result<ByteChunk, EncodeError>
	byte_encode_http2_push_promise_payload_wire(payload)
end

fn receive(input: Http2Input, state: Http2DecodeState) -> Result<Http2Step, String>
	receive_for_role(input, state, ServerEndpoint)
end

fn receive_client(input: Http2Input, state: Http2DecodeState) -> Result<Http2Step, String>
	receive_for_role(input, state, ClientEndpoint)
end

fn receive_for_role(input: Http2Input, state: Http2DecodeState, endpoint_role: Http2EndpointRole) -> Result<Http2Step, String>
	match input
		InputChunk(bytes) => receive_chunk(bytes, state, endpoint_role)
		InputEnd => receive_end(state)
	end
end

fn receive_chunk(bytes: ByteChunk, state: Http2DecodeState, endpoint_role: Http2EndpointRole) -> Result<Http2Step, String>
	match state
		State(pending, next_offset, preface_state, continuation, hpack_state, receive_limit, peer_settings, shutdown_state, receive_flow_control, peer_stream_admission) => receive_available(byte_append(pending, bytes), next_offset, preface_state, continuation, hpack_state, receive_limit, peer_settings, shutdown_state, receive_flow_control, peer_stream_admission, endpoint_role)
	end
end

fn receive_end(state: Http2DecodeState) -> Result<Http2Step, String>
	match state
		State(pending, next_offset, preface_state, continuation, hpack_state, receive_limit, peer_settings, shutdown_state, receive_flow_control, peer_stream_admission) => end_pending(pending, next_offset, preface_state, continuation, hpack_state, receive_limit, peer_settings, shutdown_state, receive_flow_control, peer_stream_admission)
	end
end

fn end_pending(pending: ByteChunk, next_offset: Int, preface_state: PrefaceState, continuation: PendingContinuation, hpack_state: HpackFixtureState, receive_limit: ReceiveLimitEntry, peer_settings: PeerSettingsState, shutdown_state: ConnectionShutdownState, receive_flow_control: ReceiveFlowControl, peer_stream_admission: PeerStreamAdmissionState) -> Result<Http2Step, String>
	let available: Int = byte_count_to_int(byte_chunk_count(pending))
	match available
		0 => match continuation
			NoContinuation => Ok(Waiting(State(pending, next_offset, preface_state, continuation, hpack_state, receive_limit, peer_settings, shutdown_state, receive_flow_control, peer_stream_admission)))
			Continuation(_, _, _, _, _, _, _) => Ok(Failed(State(pending, next_offset, preface_state, continuation, hpack_state, receive_limit, peer_settings, shutdown_state, receive_flow_control, peer_stream_admission), ClosedWithPending(next_offset, available, pending)))
		end
		_ => match preface_state
			ExpectPreface => Ok(Failed(State(pending, next_offset, preface_state, continuation, hpack_state, receive_limit, peer_settings, shutdown_state, receive_flow_control, peer_stream_admission), ClosedWithPartialPreface(next_offset, available)))
			AfterPreface => Ok(Failed(State(pending, next_offset, preface_state, continuation, hpack_state, receive_limit, peer_settings, shutdown_state, receive_flow_control, peer_stream_admission), ClosedWithPending(next_offset, available, pending)))
		end
	end
end

fn receive_available(pending: ByteChunk, next_offset: Int, preface_state: PrefaceState, continuation: PendingContinuation, hpack_state: HpackFixtureState, receive_limit: ReceiveLimitEntry, peer_settings: PeerSettingsState, shutdown_state: ConnectionShutdownState, receive_flow_control: ReceiveFlowControl, peer_stream_admission: PeerStreamAdmissionState, endpoint_role: Http2EndpointRole) -> Result<Http2Step, String>
	match preface_state
		ExpectPreface => validate_preface(pending, next_offset, continuation, hpack_state, receive_limit, peer_settings, shutdown_state, receive_flow_control, peer_stream_admission, endpoint_role)
		AfterPreface => decode_available(pending, next_offset, continuation, hpack_state, receive_limit, peer_settings, shutdown_state, receive_flow_control, peer_stream_admission, endpoint_role)
	end
end

fn client_connection_preface_count() -> Int
	24
end

fn validate_preface(pending: ByteChunk, next_offset: Int, continuation: PendingContinuation, hpack_state: HpackFixtureState, receive_limit: ReceiveLimitEntry, peer_settings: PeerSettingsState, shutdown_state: ConnectionShutdownState, receive_flow_control: ReceiveFlowControl, peer_stream_admission: PeerStreamAdmissionState, endpoint_role: Http2EndpointRole) -> Result<Http2Step, String>
	let available: Int = byte_count_to_int(byte_chunk_count(pending))
	let matched: Int = matched_preface_count(pending, available, 0)?
	match matched < available
		true => match matched < client_connection_preface_count()
			true => Ok(Failed(State(pending, next_offset, ExpectPreface, continuation, hpack_state, receive_limit, peer_settings, shutdown_state, receive_flow_control, peer_stream_admission), InvalidPreface(next_offset + matched, expected_preface_byte(matched), read_byte(pending, matched)?, matched)))
			false => consume_preface(pending, next_offset, continuation, hpack_state, receive_limit, peer_settings, shutdown_state, receive_flow_control, peer_stream_admission, endpoint_role)
		end
		false => match available < client_connection_preface_count()
			true => Ok(Waiting(State(pending, next_offset, ExpectPreface, continuation, hpack_state, receive_limit, peer_settings, shutdown_state, receive_flow_control, peer_stream_admission)))
			false => consume_preface(pending, next_offset, continuation, hpack_state, receive_limit, peer_settings, shutdown_state, receive_flow_control, peer_stream_admission, endpoint_role)
		end
	end
end

fn consume_preface(pending: ByteChunk, next_offset: Int, continuation: PendingContinuation, hpack_state: HpackFixtureState, receive_limit: ReceiveLimitEntry, peer_settings: PeerSettingsState, shutdown_state: ConnectionShutdownState, receive_flow_control: ReceiveFlowControl, peer_stream_admission: PeerStreamAdmissionState, endpoint_role: Http2EndpointRole) -> Result<Http2Step, String>
	let preface_count: ByteCount = byte_count(client_connection_preface_count())?
	let suffix: ByteChunk = byte_drop(pending, preface_count)?
	decode_available(suffix, next_offset + client_connection_preface_count(), continuation, hpack_state, receive_limit, peer_settings, shutdown_state, receive_flow_control, peer_stream_admission, endpoint_role)
end

fn matched_preface_count(pending: ByteChunk, available: Int, index: Int) -> Result<Int, String>
	match index < available
		false => Ok(index)
		true => match index < client_connection_preface_count()
			false => Ok(index)
			true => match read_byte(pending, index)? == expected_preface_byte(index)
				true => matched_preface_count(pending, available, index + 1)
				false => Ok(index)
			end
		end
	end
end

fn read_byte(pending: ByteChunk, index: Int) -> Result<Int, String>
	byte_read_u8_be(byte_view(pending, byte_offset(index)?, byte_count(1)?)?)
end

fn expected_preface_byte(index: Int) -> Int
	match index
		0 => 80
		1 => 82
		2 => 73
		3 => 32
		4 => 42
		5 => 32
		6 => 72
		7 => 84
		8 => 84
		9 => 80
		10 => 47
		11 => 50
		12 => 46
		13 => 48
		14 => 13
		15 => 10
		16 => 13
		17 => 10
		18 => 83
		19 => 77
		20 => 13
		21 => 10
		22 => 13
		23 => 10
		_ => 0
	end
end

fn decode_available(pending: ByteChunk, next_offset: Int, continuation: PendingContinuation, hpack_state: HpackFixtureState, receive_limit: ReceiveLimitEntry, peer_settings: PeerSettingsState, shutdown_state: ConnectionShutdownState, receive_flow_control: ReceiveFlowControl, peer_stream_admission: PeerStreamAdmissionState, endpoint_role: Http2EndpointRole) -> Result<Http2Step, String>
	let available: Int = byte_count_to_int(byte_chunk_count(pending))
	match available < 9
		true => Ok(Waiting(State(pending, next_offset, AfterPreface, continuation, hpack_state, receive_limit, peer_settings, shutdown_state, receive_flow_control, peer_stream_admission)))
		false => decode_header(pending, next_offset, continuation, hpack_state, receive_limit, peer_settings, shutdown_state, receive_flow_control, peer_stream_admission, endpoint_role)
	end
end

fn decode_header(pending: ByteChunk, next_offset: Int, continuation: PendingContinuation, hpack_state: HpackFixtureState, receive_limit: ReceiveLimitEntry, peer_settings: PeerSettingsState, shutdown_state: ConnectionShutdownState, receive_flow_control: ReceiveFlowControl, peer_stream_admission: PeerStreamAdmissionState, endpoint_role: Http2EndpointRole) -> Result<Http2Step, String>
	let available: Int = byte_count_to_int(byte_chunk_count(pending))
	let zero: ByteOffset = byte_offset(0)?
	let base_offset: ByteOffset = byte_offset(next_offset)?
	let header_count: ByteCount = byte_count(9)?
	let view: ByteView = byte_view(pending, zero, header_count)?
	let header: {length: Int, kind: Int, flags: Int, stream_id: Int} = decode_http2_frame_header(view, base_offset)?
	let max_frame_size: Int = receive_limit_value(receive_limit)
	match header.length > max_frame_size
		true => Ok(Failed(State(pending, next_offset, AfterPreface, continuation, hpack_state, receive_limit, peer_settings, shutdown_state, receive_flow_control, peer_stream_admission), FrameSizeExceeded(next_offset, header.length, receive_limit, header.kind, header.stream_id)))
		false => decode_sized_frame(pending, next_offset, continuation, hpack_state, receive_limit, peer_settings, shutdown_state, receive_flow_control, peer_stream_admission, available, header.length, header.kind, header.flags, header.stream_id, byte_view_to_chunk(view), endpoint_role)
	end
end

fn protocol_default_frame_size_limit() -> ReceiveLimitEntry
	ReceiveLimit(16384, ProtocolDefault)
end

fn empty_peer_settings() -> PeerSettingsState
	PeerSettings(NoPeerMaxFrameSize, NoPeerInitialWindowSize, NoPeerEnablePush, NoPeerMaxConcurrentStreams, NoPeerHeaderTableSize, NoPeerMaxHeaderListSize, NoLocalSentEnablePush, 0)
end

fn default_receive_flow_control() -> ReceiveFlowControl
	ReceiveFlowControl(65535, NoOpenStreamReceiveWindow)
end

fn max_flow_control_value() -> Int
	2147483647
end

fn min_stream_window_credit() -> Int
	-2147483647
end

fn connection_window_credit(value: Int) -> Result<ConnectionWindowCredit, FlowControlDomainError>
	match value < 0
		true => Err(FlowControlDomainOutOfRange("connection_window_credit", value, 0, max_flow_control_value()))
		false => match value > max_flow_control_value()
			true => Err(FlowControlDomainOutOfRange("connection_window_credit", value, 0, max_flow_control_value()))
			false => Ok(ConnectionWindowCredit(value))
		end
	end
end

fn stream_window_credit(value: Int) -> Result<StreamWindowCredit, FlowControlDomainError>
	match value < min_stream_window_credit()
		true => Err(FlowControlDomainOutOfRange("stream_window_credit", value, min_stream_window_credit(), max_flow_control_value()))
		false => match value > max_flow_control_value()
			true => Err(FlowControlDomainOutOfRange("stream_window_credit", value, min_stream_window_credit(), max_flow_control_value()))
			false => Ok(StreamWindowCredit(value))
		end
	end
end

fn initial_window_size(value: Int) -> Result<InitialWindowSize, FlowControlDomainError>
	match value < 0
		true => Err(FlowControlDomainOutOfRange("initial_window_size", value, 0, max_flow_control_value()))
		false => match value > max_flow_control_value()
			true => Err(FlowControlDomainOutOfRange("initial_window_size", value, 0, max_flow_control_value()))
			false => Ok(InitialWindowSize(value))
		end
	end
end

fn window_update_increment_value(value: Int) -> Result<WindowUpdateIncrement, FlowControlDomainError>
	match value < 1
		true => Err(FlowControlDomainOutOfRange("window_update_increment", value, 1, max_flow_control_value()))
		false => match value > max_flow_control_value()
			true => Err(FlowControlDomainOutOfRange("window_update_increment", value, 1, max_flow_control_value()))
			false => Ok(WindowUpdateIncrement(value))
		end
	end
end

fn connection_window_credit_value(credit: ConnectionWindowCredit) -> Int
	match credit
		ConnectionWindowCredit(value) => value
	end
end

fn stream_window_credit_value(credit: StreamWindowCredit) -> Int
	match credit
		StreamWindowCredit(value) => value
	end
end

fn initial_window_size_value(size: InitialWindowSize) -> Int
	match size
		InitialWindowSize(value) => value
	end
end

fn window_update_increment_int(increment: WindowUpdateIncrement) -> Int
	match increment
		WindowUpdateIncrement(value) => value
	end
end

fn checked_stream_window_credit_value(value: Int) -> Result<Int, String>
	match stream_window_credit(value)
		Ok(credit) => Ok(stream_window_credit_value(credit))
		Err(_) => Err("stream window credit is outside the HTTP/2 domain")
	end
end

fn data_exceeds_connection_window(length: Int, value: Int) -> Bool
	match connection_window_credit(value)
		Ok(credit) => length > connection_window_credit_value(credit)
		Err(_) => true
	end
end

fn data_exceeds_stream_window(length: Int, value: Int) -> Bool
	match stream_window_credit(value)
		Ok(credit) => length > stream_window_credit_value(credit)
		Err(_) => true
	end
end

fn debit_connection_window(value: Int, length: Int) -> Result<Int, String>
	match connection_window_credit(value - length)
		Ok(credit) => Ok(connection_window_credit_value(credit))
		Err(_) => Err("DATA debit would leave connection window credit outside the HTTP/2 domain")
	end
end

fn debit_stream_window(value: Int, length: Int) -> Result<Int, String>
	checked_stream_window_credit_value(value - length)
end

fn window_update_increment_is_invalid(value: Int) -> Bool
	match window_update_increment_value(value)
		Ok(_) => false
		Err(_) => true
	end
end

fn connection_window_refill_overflows(value: Int, increment: Int) -> Bool
	match connection_window_credit(value + increment)
		Ok(_) => false
		Err(_) => true
	end
end

fn stream_window_refill_overflows(value: Int, increment: Int) -> Bool
	match stream_window_credit(value + increment)
		Ok(_) => false
		Err(_) => true
	end
end

fn refilled_connection_window(value: Int, increment: Int) -> Int
	match connection_window_credit(value + increment)
		Ok(credit) => connection_window_credit_value(credit)
		Err(_) => value
	end
end

fn refilled_stream_window(value: Int, increment: Int) -> Int
	match stream_window_credit(value + increment)
		Ok(credit) => stream_window_credit_value(credit)
		Err(_) => value
	end
end

fn concurrent_stream_receive_limit() -> Int
	3
end

fn concurrent_stream_receive_limit_provenance() -> String
	"local_configuration"
end

fn receive_limit_value(receive_limit: ReceiveLimitEntry) -> Int
	match receive_limit
		ReceiveLimit(value, _) => value
	end
end

fn receive_limit_provenance_label(receive_limit: ReceiveLimitEntry) -> String
	match receive_limit
		ReceiveLimit(_, ProtocolDefault) => "protocol_default"
		ReceiveLimit(_, LocalConfiguration) => "local_configuration"
		ReceiveLimit(_, LocalSettingsItem(_)) => "local_settings_item"
	end
end

fn header_list_receive_limit() -> ReceiveLimitEntry
	ReceiveLimit(13, LocalConfiguration)
end

fn header_table_receive_limit() -> ReceiveLimitEntry
	ReceiveLimit(160, LocalConfiguration)
end

fn decode_sized_frame(pending: ByteChunk, next_offset: Int, continuation: PendingContinuation, hpack_state: HpackFixtureState, receive_limit: ReceiveLimitEntry, peer_settings: PeerSettingsState, shutdown_state: ConnectionShutdownState, receive_flow_control: ReceiveFlowControl, peer_stream_admission: PeerStreamAdmissionState, available: Int, length: Int, kind: Int, flags: Int, stream_id: Int, header_preview: ByteChunk, endpoint_role: Http2EndpointRole) -> Result<Http2Step, String>
	let frame_count_int: Int = 9 + length
	match available < frame_count_int
		true => Ok(Waiting(State(pending, next_offset, AfterPreface, continuation, hpack_state, receive_limit, peer_settings, shutdown_state, receive_flow_control, peer_stream_admission)))
		false => decode_complete_frame(pending, next_offset, continuation, hpack_state, receive_limit, peer_settings, shutdown_state, receive_flow_control, peer_stream_admission, length, kind, flags, stream_id, frame_count_int, header_preview, endpoint_role)
	end
end

fn decode_complete_frame(pending: ByteChunk, next_offset: Int, continuation: PendingContinuation, hpack_state: HpackFixtureState, receive_limit: ReceiveLimitEntry, peer_settings: PeerSettingsState, shutdown_state: ConnectionShutdownState, receive_flow_control: ReceiveFlowControl, peer_stream_admission: PeerStreamAdmissionState, length: Int, kind: Int, flags: Int, stream_id: Int, frame_count_int: Int, header_preview: ByteChunk, endpoint_role: Http2EndpointRole) -> Result<Http2Step, String>
	let frame_count: ByteCount = byte_count(frame_count_int)?
	let suffix: ByteChunk = byte_drop(pending, frame_count)?
	let payload: ByteChunk = frame_payload_chunk(pending, length)?
	let consumed_state: Http2DecodeState = State(suffix, next_offset + frame_count_int, AfterPreface, continuation, hpack_state, receive_limit, peer_settings, shutdown_state, receive_flow_control, peer_stream_admission)
	let stream_id_decision: ProtocolStreamIdDecision = validate_stream_id_domain(next_offset, kind, stream_id, receive_flow_control)
	match stream_id_decision
		ProtocolStreamIdOk => decode_complete_frame_after_stream_id(pending, suffix, payload, next_offset, frame_count_int, continuation, hpack_state, receive_limit, peer_settings, shutdown_state, receive_flow_control, peer_stream_admission, length, kind, flags, stream_id, consumed_state, header_preview, endpoint_role)
		ProtocolStreamIdFailed(error) => Ok(Failed(consumed_state, error))
	end
end

fn decode_complete_frame_after_stream_id(pending: ByteChunk, suffix: ByteChunk, payload: ByteChunk, next_offset: Int, frame_count_int: Int, continuation: PendingContinuation, hpack_state: HpackFixtureState, receive_limit: ReceiveLimitEntry, peer_settings: PeerSettingsState, shutdown_state: ConnectionShutdownState, receive_flow_control: ReceiveFlowControl, peer_stream_admission: PeerStreamAdmissionState, length: Int, kind: Int, flags: Int, stream_id: Int, consumed_state: Http2DecodeState, header_preview: ByteChunk, endpoint_role: Http2EndpointRole) -> Result<Http2Step, String>
	let settings_decision: SettingsRangeDecision = validate_settings_value(pending, next_offset, length, kind, flags, endpoint_role)?
	let priority_decision: PriorityDependencyDecision = validate_priority_dependency(next_offset, payload, length, kind, flags, stream_id)?
	let payload_decision: ProtocolPayloadDecision = validate_protocol_payload(next_offset, payload, length, kind, flags, stream_id)?
	match settings_decision
		SettingsValueOk => match payload_decision
			ProtocolPayloadOk => match priority_decision
				PriorityDependencyOk => match validate_continuation(continuation, next_offset, continuation_payload_chunk(payload, kind, flags)?, kind, flags, stream_id, frame_promised_stream_id(payload, kind)?, peer_settings, receive_flow_control, header_preview)
					Ok(Decision(next_continuation, completed_header_block, completed_end_stream, completed_is_trailer, completed_promised_stream_id)) => complete_after_data_padding(pending, suffix, next_offset, frame_count_int, next_continuation, hpack_state, receive_limit, peer_settings, shutdown_state, receive_flow_control, peer_stream_admission, length, kind, flags, stream_id, completed_header_block, completed_end_stream, completed_is_trailer, completed_promised_stream_id, consumed_state, payload)
					Err(error) => Ok(Failed(consumed_state, error))
				end
				PriorityDependencyFailed(error) => Ok(Failed(consumed_state, error))
			end
			ProtocolPayloadFailed(error) => Ok(Failed(consumed_state, error))
		end
		SettingsValueFailed(error) => Ok(Failed(consumed_state, error))
	end
end

fn complete_after_data_padding(pending: ByteChunk, suffix: ByteChunk, next_offset: Int, frame_count_int: Int, next_continuation: PendingContinuation, hpack_state: HpackFixtureState, receive_limit: ReceiveLimitEntry, peer_settings: PeerSettingsState, shutdown_state: ConnectionShutdownState, receive_flow_control: ReceiveFlowControl, peer_stream_admission: PeerStreamAdmissionState, length: Int, kind: Int, flags: Int, stream_id: Int, completed_header_block: ByteChunk, completed_end_stream: Bool, completed_is_trailer: Bool, completed_promised_stream_id: Int, consumed_state: Http2DecodeState, payload: ByteChunk) -> Result<Http2Step, String>
	let padding_decision: PaddingDecision = validate_data_padding(next_offset, payload, length, kind, flags, stream_id, receive_flow_control)?
	match padding_decision
		PaddingOk => complete_receive_flow_control_update(pending, suffix, next_offset, frame_count_int, next_continuation, hpack_state, receive_limit, peer_settings, shutdown_state, receive_flow_control, peer_stream_admission, length, kind, flags, stream_id, completed_header_block, completed_end_stream, completed_is_trailer, completed_promised_stream_id, consumed_state)
		PaddingFailed(error) => Ok(Failed(consumed_state, error))
	end
end

fn validate_priority_dependency(offset: Int, payload: ByteChunk, length: Int, kind: Int, flags: Int, stream_id: Int) -> Result<PriorityDependencyDecision, String>
	match kind
		2 => match length == 5
			true => validate_priority_dependency_payload(offset, payload, stream_id)
			false => Ok(PriorityDependencyOk)
		end
		_ => match headers_priority_set(kind, flags)
			true => match length >= 5
				true => validate_priority_dependency_payload(offset, payload, stream_id)
				false => Ok(PriorityDependencyOk)
			end
			false => Ok(PriorityDependencyOk)
		end
	end
end

fn validate_priority_dependency_payload(offset: Int, payload: ByteChunk, stream_id: Int) -> Result<PriorityDependencyDecision, String>
	let payload_view: ByteView = byte_view(payload, byte_offset(0)?, byte_count(5)?)?
	let dependency_stream_id: Int = priority_dependency_stream_id(payload_view)?
	match dependency_stream_id == stream_id
		true => Ok(PriorityDependencyFailed(InvalidPriorityDependency(offset, stream_id, dependency_stream_id, "stream-control", "rfc9113_priority_dependency", payload_view)))
		false => Ok(PriorityDependencyOk)
	end
end

fn frame_payload_chunk(frame: ByteChunk, length: Int) -> Result<ByteChunk, String>
	let payload_offset: ByteOffset = byte_offset(9)?
	let payload_count: ByteCount = byte_count(length)?
	Ok(byte_view_to_chunk(byte_view(frame, payload_offset, payload_count)?))
end

fn validate_stream_id_domain(offset: Int, kind: Int, stream_id: Int, receive_flow_control: ReceiveFlowControl) -> ProtocolStreamIdDecision
	match kind
		4 => require_connection_stream_id(offset, kind, stream_id)
		6 => require_connection_stream_id(offset, kind, stream_id)
		7 => require_connection_stream_id(offset, kind, stream_id)
		0 => require_peer_stream_id(offset, kind, stream_id, receive_flow_control)
		1 => require_peer_stream_id(offset, kind, stream_id, receive_flow_control)
		3 => require_peer_stream_id(offset, kind, stream_id, receive_flow_control)
		9 => require_peer_stream_id(offset, kind, stream_id, receive_flow_control)
		8 => validate_window_update_stream_id(offset, kind, stream_id, receive_flow_control)
		2 => require_peer_stream_id(offset, kind, stream_id, receive_flow_control)
		5 => require_client_stream_id(offset, kind, stream_id)
		_ => ProtocolStreamIdOk
	end
end

fn validate_window_update_stream_id(offset: Int, kind: Int, stream_id: Int, receive_flow_control: ReceiveFlowControl) -> ProtocolStreamIdDecision
	match stream_id
		0 => ProtocolStreamIdOk
		_ => require_peer_stream_id(offset, kind, stream_id, receive_flow_control)
	end
end

fn require_peer_stream_id(offset: Int, kind: Int, stream_id: Int, receive_flow_control: ReceiveFlowControl) -> ProtocolStreamIdDecision
	match stream_id_is_reserved_by_peer(stream_id, receive_flow_control)
		true => require_server_stream_id(offset, kind, stream_id)
		false => require_client_stream_id(offset, kind, stream_id)
	end
end

fn stream_id_is_reserved_by_peer(stream_id: Int, receive_flow_control: ReceiveFlowControl) -> Bool
	match receive_flow_control
		ReceiveFlowControl(_, TwoOpenStreamReceiveWindows(_, _, _, promised_stream_id, _, _)) => stream_id == promised_stream_id
		ReceiveFlowControl(_, ClientPushAssociatedStreamReceiveWindow(_, _, _, promised_stream_id)) => stream_id == promised_stream_id
		ReceiveFlowControl(_, _) => false
	end
end

fn require_connection_stream_id(offset: Int, kind: Int, stream_id: Int) -> ProtocolStreamIdDecision
	match stream_id
		0 => match stream_domain::stream_ref_is_connection(stream_domain::connection_stream_ref())
			true => ProtocolStreamIdOk
			false => ProtocolStreamIdFailed(InvalidStreamId(offset, kind, stream_id, "connection stream id zero", "server", "stream-id-domain", "connection_frames_require_stream_zero"))
		end
		_ => ProtocolStreamIdFailed(InvalidStreamId(offset, kind, stream_id, "connection stream id zero", "server", "stream-id-domain", "connection_frames_require_stream_zero"))
	end
end

fn require_client_stream_id(offset: Int, kind: Int, stream_id: Int) -> ProtocolStreamIdDecision
	match stream_domain::client_stream_id(stream_id)
		Ok(value) => match stream_domain::stream_ref_is_real(stream_domain::real_stream_ref(value))
			true => ProtocolStreamIdOk
			false => ProtocolStreamIdFailed(InvalidStreamId(offset, kind, stream_id, "nonzero client-initiated stream id", "server", "stream-id-domain", "server_receives_client_initiated_streams"))
		end
		Err(_) => ProtocolStreamIdFailed(InvalidStreamId(offset, kind, stream_id, "nonzero client-initiated stream id", "server", "stream-id-domain", "server_receives_client_initiated_streams"))
	end
end

fn require_server_stream_id(offset: Int, kind: Int, stream_id: Int) -> ProtocolStreamIdDecision
	match stream_domain::server_stream_id(stream_id)
		Ok(value) => match stream_domain::stream_ref_is_real(stream_domain::real_stream_ref(value))
			true => ProtocolStreamIdOk
			false => ProtocolStreamIdFailed(InvalidStreamId(offset, kind, stream_id, "nonzero server-initiated stream id", "client", "stream-id-domain", "client_push_promise_requires_server_stream"))
		end
		Err(_) => ProtocolStreamIdFailed(InvalidStreamId(offset, kind, stream_id, "nonzero server-initiated stream id", "client", "stream-id-domain", "client_push_promise_requires_server_stream"))
	end
end

fn require_server_promised_stream_id(offset: Int, kind: Int, stream_id: Int) -> ProtocolStreamIdDecision
	match stream_domain::server_stream_id(stream_id)
		Ok(value) => match stream_domain::stream_ref_is_real(stream_domain::real_stream_ref(value))
			true => ProtocolStreamIdOk
			false => ProtocolStreamIdFailed(InvalidStreamId(offset, kind, stream_id, "nonzero server-initiated promised stream id", "client", "stream-id-domain", "client_push_promise_requires_server_stream"))
		end
		Err(_) => ProtocolStreamIdFailed(InvalidStreamId(offset, kind, stream_id, "nonzero server-initiated promised stream id", "client", "stream-id-domain", "client_push_promise_requires_server_stream"))
	end
end

fn stream_id_is_client_initiated(stream_id: Int) -> Bool
	(stream_id / 2) * 2 != stream_id
end

fn complete_receive_flow_control_update(pending: ByteChunk, suffix: ByteChunk, next_offset: Int, frame_count_int: Int, next_continuation: PendingContinuation, hpack_state: HpackFixtureState, receive_limit: ReceiveLimitEntry, peer_settings: PeerSettingsState, shutdown_state: ConnectionShutdownState, receive_flow_control: ReceiveFlowControl, peer_stream_admission: PeerStreamAdmissionState, length: Int, kind: Int, flags: Int, stream_id: Int, completed_header_block: ByteChunk, completed_end_stream: Bool, completed_is_trailer: Bool, completed_promised_stream_id: Int, consumed_state: Http2DecodeState) -> Result<Http2Step, String>
	complete_receive_flow_control_update_after_table_size_check(pending, suffix, next_offset, frame_count_int, next_continuation, hpack_state, receive_limit, peer_settings, shutdown_state, receive_flow_control, peer_stream_admission, length, kind, flags, stream_id, completed_header_block, completed_end_stream, completed_is_trailer, completed_promised_stream_id, consumed_state)
end

fn complete_receive_flow_control_update_after_table_size_check(pending: ByteChunk, suffix: ByteChunk, next_offset: Int, frame_count_int: Int, next_continuation: PendingContinuation, hpack_state: HpackFixtureState, receive_limit: ReceiveLimitEntry, peer_settings: PeerSettingsState, shutdown_state: ConnectionShutdownState, receive_flow_control: ReceiveFlowControl, peer_stream_admission: PeerStreamAdmissionState, length: Int, kind: Int, flags: Int, stream_id: Int, completed_header_block: ByteChunk, completed_end_stream: Bool, completed_is_trailer: Bool, completed_promised_stream_id: Int, consumed_state: Http2DecodeState) -> Result<Http2Step, String>
	match decode_completed_header_list(next_offset, kind, flags, stream_id, completed_header_block, hpack_state)
		HeaderListDecodeOk(decoded_header_list_size, next_hpack_state, headers) => match validate_header_table_size_update(next_offset, kind, flags, stream_id, completed_header_block, headers, next_hpack_state)
			HeaderTableSizeOk => match validate_header_list_size(next_offset, kind, flags, stream_id, decoded_header_list_size, completed_header_block)
				HeaderListSizeOk => match validate_trailer_end_stream(next_offset, kind, stream_id, headers, completed_is_trailer, state_receive_flow_control(consumed_state))
					TrailerEndStreamOk => match validate_trailer_header_list(next_offset, kind, flags, stream_id, headers, completed_header_block, completed_is_trailer, state_receive_flow_control(consumed_state))
						TrailerHeaderListOk => match completed_is_trailer
							true => complete_after_header_list_size(pending, next_continuation, next_hpack_state, length, kind, flags, stream_id, completed_header_block, completed_end_stream, completed_promised_stream_id, headers, completed_is_trailer, peer_stream_admission, consumed_state)
							false => match validate_request_header_list(next_offset, kind, flags, stream_id, headers, completed_header_block, peer_settings)
								RequestHeaderListOk => match validate_response_header_list(next_offset, kind, flags, stream_id, headers, completed_header_block)
									ResponseHeaderListOk => complete_after_header_list_size(pending, next_continuation, next_hpack_state, length, kind, flags, stream_id, completed_header_block, completed_end_stream, completed_promised_stream_id, headers, completed_is_trailer, peer_stream_admission, consumed_state)
									ResponseHeaderListFailed(error) => Ok(Failed(consumed_state, error))
								end
								RequestHeaderListFailed(error) => Ok(Failed(consumed_state, error))
							end
						end
						TrailerHeaderListFailed(error) => Ok(Failed(consumed_state, error))
					end
					TrailerEndStreamFailed(error) => Ok(Failed(consumed_state, error))
				end
				HeaderListSizeFailed(error) => Ok(Failed(consumed_state, error))
			end
			HeaderTableSizeFailed(error) => Ok(Failed(consumed_state, error))
		end
		HeaderListDecodeFailed(error) => Ok(Failed(consumed_state, error))
	end
end

fn complete_after_header_list_size(pending: ByteChunk, next_continuation: PendingContinuation, next_hpack_state: HpackFixtureState, length: Int, kind: Int, flags: Int, stream_id: Int, completed_header_block: ByteChunk, completed_end_stream: Bool, completed_promised_stream_id: Int, headers: HpackProductionHeaderList, completed_is_trailer: Bool, peer_stream_admission: PeerStreamAdmissionState, consumed_state: Http2DecodeState) -> Result<Http2Step, String>
	let frame_offset: Int = state_next_offset(consumed_state) - (9 + length)
	match validate_peer_stream_id_order(frame_offset, length, kind, flags, stream_id, completed_promised_stream_id, state_peer_settings(consumed_state), state_receive_flow_control(consumed_state))?
		PeerStreamOrderingOk => match update_receive_flow_control(pending, frame_offset, length, kind, flags, stream_id, completed_end_stream, completed_promised_stream_id, accepted_content_length_for_stream(headers, completed_is_trailer), headers, completed_is_trailer, state_shutdown_state_value(consumed_state), state_receive_flow_control(consumed_state), peer_stream_admission)?
			ReceiveFlowControlOk(next_receive_flow_control) => match update_shutdown_state(pending, frame_offset, length, kind, state_shutdown_state_value(consumed_state), next_receive_flow_control)?
				ShutdownStateOk(next_shutdown_state) => Ok(FrameDecoded(State(state_pending_chunk(consumed_state), state_next_offset(consumed_state), AfterPreface, next_continuation, next_hpack_state, state_receive_limit(consumed_state), record_peer_created_stream_id(kind, stream_id, completed_promised_stream_id, state_receive_flow_control(consumed_state), update_peer_settings(pending, frame_offset, length, kind, flags, state_peer_settings(consumed_state))?), next_shutdown_state, update_initial_window_receive_credit(pending, frame_offset, length, kind, flags, state_peer_settings(consumed_state), next_receive_flow_control)?, update_peer_stream_admission(kind, stream_id, completed_is_trailer, state_receive_flow_control(consumed_state), peer_stream_admission)), frame_offset, length, kind, flags, stream_id, completed_header_block, frame_value(pending, length, kind, flags, stream_id)?))
				ShutdownStateFailed(error) => Ok(Failed(consumed_state, error))
			end
			ReceiveFlowControlFailed(error) => match error
				InvalidStreamId(_, _, _, _, _, _, rule_provenance) => match rule_provenance == "peer_created_stream_ids_increase"
					true => Ok(Failed(peer_stream_admission_rejected_state(pending, frame_offset, consumed_state, peer_stream_admission), error))
					false => Ok(Failed(consumed_state, error))
				end
				_ => Ok(Failed(consumed_state, error))
			end
		end
		PeerStreamOrderingFailed(error) => Ok(Failed(consumed_state, error))
	end
end

fn validate_peer_stream_id_order(offset: Int, length: Int, kind: Int, flags: Int, stream_id: Int, promised_stream_id: Int, peer_settings: PeerSettingsState, receive_flow_control: ReceiveFlowControl) -> Result<PeerStreamOrderingDecision, String>
	match kind == 1 and stream_id_is_client_initiated(stream_id) and not receive_flow_control_tracks_stream(stream_id, receive_flow_control)
		false => validate_promised_stream_id_order(offset, length, kind, flags, stream_id, promised_stream_id, peer_settings, receive_flow_control)
		true => match stream_id <= highest_peer_created_stream_id(peer_settings)
			false => Ok(PeerStreamOrderingOk)
			true => Ok(PeerStreamOrderingFailed(PeerStreamIdNotIncreasing(offset, stream_id, highest_peer_created_stream_id(peer_settings), "server", "idle-stream", "rfc9113_peer_stream_ids_increase", byte_view_to_chunk(frame_header_preview(length, kind, flags, stream_id)?))))
		end
	end
end

fn peer_stream_admission_rejected_state(pending: ByteChunk, frame_offset: Int, consumed_state: Http2DecodeState, peer_stream_admission: PeerStreamAdmissionState) -> Http2DecodeState
	match consumed_state
		State(_, _, preface_state, continuation, hpack_state, receive_limit, peer_settings, shutdown_state, receive_flow_control, _) => State(pending, frame_offset, preface_state, continuation, hpack_state, receive_limit, peer_settings, shutdown_state, receive_flow_control, peer_stream_admission)
	end
end

fn validate_promised_stream_id_order(offset: Int, length: Int, kind: Int, flags: Int, stream_id: Int, promised_stream_id: Int, peer_settings: PeerSettingsState, receive_flow_control: ReceiveFlowControl) -> Result<PeerStreamOrderingDecision, String>
	match promised_stream_id > 0 and not receive_flow_control_tracks_stream(promised_stream_id, receive_flow_control)
		false => Ok(PeerStreamOrderingOk)
		true => match promised_stream_id <= highest_peer_created_stream_id(peer_settings)
			false => Ok(PeerStreamOrderingOk)
			true => Ok(PeerStreamOrderingFailed(PeerStreamIdNotIncreasing(offset, promised_stream_id, highest_peer_created_stream_id(peer_settings), "client", "idle-stream", "rfc9113_peer_stream_ids_increase", byte_view_to_chunk(frame_header_preview(length, kind, flags, stream_id)?))))
		end
	end
end

fn receive_flow_control_tracks_stream(stream_id: Int, receive_flow_control: ReceiveFlowControl) -> Bool
	match receive_flow_control
		ReceiveFlowControl(_, NoOpenStreamReceiveWindow) => false
		ReceiveFlowControl(_, OpenStreamReceiveWindow(open_stream_id, _, _)) => stream_id == open_stream_id
		ReceiveFlowControl(_, TwoOpenStreamReceiveWindows(first_stream_id, _, _, second_stream_id, _, _)) => stream_id == first_stream_id or stream_id == second_stream_id
		ReceiveFlowControl(_, ThreeOpenStreamReceiveWindows(first_stream_id, _, _, second_stream_id, _, _, third_stream_id, _, _)) => stream_id == first_stream_id or stream_id == second_stream_id or stream_id == third_stream_id
		ReceiveFlowControl(_, ClientPushAssociatedStreamReceiveWindow(open_stream_id, _, _, promised_stream_id)) => stream_id == open_stream_id or stream_id == promised_stream_id
		ReceiveFlowControl(_, HalfClosedLocalStreamReceiveWindow(open_stream_id, _, _)) => stream_id == open_stream_id
		ReceiveFlowControl(_, ClosedByPeerStreamReceiveWindow(closed_stream_id, _)) => stream_id == closed_stream_id
		ReceiveFlowControl(_, ResetStreamReceiveWindow(reset_stream_id, _)) => stream_id == reset_stream_id
	end
end

fn highest_peer_created_stream_id(peer_settings: PeerSettingsState) -> Int
	match peer_settings
		PeerSettings(_, _, _, _, _, _, _, stream_id) => stream_id
	end
end

fn record_peer_created_stream_id(kind: Int, stream_id: Int, promised_stream_id: Int, previous_receive_flow_control: ReceiveFlowControl, peer_settings: PeerSettingsState) -> PeerSettingsState
	match kind == 1 and stream_id_is_client_initiated(stream_id) and not receive_flow_control_tracks_stream(stream_id, previous_receive_flow_control)
		false => record_promised_stream_id(promised_stream_id, previous_receive_flow_control, peer_settings)
		true => with_highest_peer_created_stream_id(peer_settings, stream_id)
	end
end

fn record_promised_stream_id(promised_stream_id: Int, previous_receive_flow_control: ReceiveFlowControl, peer_settings: PeerSettingsState) -> PeerSettingsState
	match promised_stream_id > 0 and not receive_flow_control_tracks_stream(promised_stream_id, previous_receive_flow_control)
		false => peer_settings
		true => with_highest_peer_created_stream_id(peer_settings, promised_stream_id)
	end
end

fn with_highest_peer_created_stream_id(peer_settings: PeerSettingsState, stream_id: Int) -> PeerSettingsState
	match peer_settings
		PeerSettings(max_frame_size, initial_window_size, enable_push, max_concurrent_streams, header_table_size, max_header_list_size, local_enable_push, _) => PeerSettings(max_frame_size, initial_window_size, enable_push, max_concurrent_streams, header_table_size, max_header_list_size, local_enable_push, stream_id)
	end
end

fn decode_completed_header_list(offset: Int, kind: Int, flags: Int, stream_id: Int, completed_header_block: ByteChunk, hpack_state: HpackFixtureState) -> HeaderListDecodeDecision
	match header_list_boundary_reached(kind, flags)
		true => decode_completed_static_or_fixture_header_list(offset, kind, stream_id, completed_header_block, hpack_state)
		false => HeaderListDecodeOk(byte_count_to_int(byte_chunk_count(completed_header_block)), hpack_state, hpack_fixture::production_header_list_from_fixture(hpack_fixture::incomplete_header_list()))
	end
end

fn decode_completed_static_or_fixture_header_list(offset: Int, kind: Int, stream_id: Int, completed_header_block: ByteChunk, hpack_state: HpackFixtureState) -> HeaderListDecodeDecision
	match hpack_static::decode_header_block(completed_header_block, offset)
		Ok(headers) => HeaderListDecodeOk(hpack_fixture::header_list_wire_size(headers), hpack_static_next_hpack_state(headers, hpack_state), hpack_fixture::production_header_list_from_fixture(headers))
		Err(static_failure) => match hpack_static::hpack_static_failure_is_not_static(static_failure)
			true => decode_completed_dynamic_core_raw_or_fixture_header_list(offset, kind, stream_id, completed_header_block, hpack_state)
			false => HeaderListDecodeFailed(HpackFixtureDecodeFailed(hpack_static::hpack_static_failure_offset(static_failure), hpack_static::hpack_static_failure_observed_size(static_failure), hpack_static::hpack_static_failure_observed_first_byte(static_failure), 0, 0, hpack_static::hpack_static_failure_expected_header(static_failure), hpack_static::hpack_static_failure_decoder_module(static_failure), hpack_static::hpack_static_failure_preview(static_failure)))
		end
	end
end

fn hpack_static_next_hpack_state(headers: HpackHeaderList, hpack_state: HpackFixtureState) -> HpackFixtureState
	match hpack_fixture::header_list_second_name(headers) == ":fixture" and hpack_fixture::header_list_second_value(headers) == "literal-with-indexing"
		true => hpack_fixture::state_with_indexed_literal_entry(hpack_state, hpack_fixture::header_list_first_name(headers), hpack_fixture::header_list_first_value(headers))
		false => hpack_state
	end
end

fn dynamic_core_state_from_hpack_state(hpack_state: HpackFixtureState) -> HpackDynamicCoreState
	dynamic_core_state_from_hpack_entries(hpack_state, hpack_fixture::state_dynamic_table_entry_count(hpack_state), hpack_dynamic_core::empty_dynamic_core_state(hpack_fixture::state_table_size(hpack_state), hpack_fixture::state_decode_count(hpack_state)))
end

fn dynamic_core_state_from_hpack_entries(hpack_state: HpackFixtureState, remaining: Int, dynamic_core_state: HpackDynamicCoreState) -> HpackDynamicCoreState
	match remaining
		0 => dynamic_core_state
		_ => match hpack_fixture::state_dynamic_header_name_at(hpack_state, remaining - 1)
			Some(name) => match hpack_fixture::state_dynamic_header_value_at(hpack_state, remaining - 1)
				Some(value) => dynamic_core_state_from_hpack_entries(hpack_state, remaining - 1, hpack_dynamic_core::prepend_carried_dynamic_entry_state(dynamic_core_state, name, value))
				None => dynamic_core_state
			end
			None => dynamic_core_state
		end
	end
end

fn header_block_byte_at(block: ByteChunk, index: Int) -> Result<Int, String>
	let view: ByteView = byte_view(block, byte_offset(index)?, byte_count(1)?)?
	byte_read_u8_be(view)
end

fn header_block_byte_at_or_missing(block: ByteChunk, index: Int) -> Int
	match header_block_byte_at(block, index)
		Ok(value) => value
		Err(_) => -1
	end
end

fn decode_completed_dynamic_core_raw_or_fixture_header_list(offset: Int, kind: Int, stream_id: Int, completed_header_block: ByteChunk, hpack_state: HpackFixtureState) -> HeaderListDecodeDecision
	match hpack_dynamic_core::decode_raw_literal_name_header_field(completed_header_block, hpack_dynamic_core::initial_dynamic_core_state(), offset)
		Ok(transition) => match hpack_dynamic_core::dynamic_core_transition_headers(transition)
			headers => HeaderListDecodeOk(hpack_dynamic_core::dynamic_core_header_list_wire_size(headers), hpack_dynamic_core_next_hpack_state(headers, hpack_state), hpack_fixture::production_header_list_from_fixture(dynamic_core_header_list_to_hpack_header_list(headers)))
		end
		Err(_) => decode_completed_dynamic_core_indexed_or_fixture_header_list(offset, kind, stream_id, completed_header_block, hpack_state)
	end
end

fn decode_completed_dynamic_core_indexed_or_fixture_header_list(offset: Int, kind: Int, stream_id: Int, completed_header_block: ByteChunk, hpack_state: HpackFixtureState) -> HeaderListDecodeDecision
	match hpack_dynamic_core::decode_indexed_header_field(completed_header_block, dynamic_core_state_from_hpack_state(hpack_state), offset)
		Ok(transition) => match hpack_dynamic_core::dynamic_core_transition_headers(transition)
			headers => HeaderListDecodeOk(hpack_dynamic_core::dynamic_core_header_list_wire_size(headers), hpack_fixture::state_after_literal_read(hpack_state), hpack_fixture::production_header_list_from_fixture(dynamic_core_header_list_to_hpack_header_list(headers)))
		end
		Err(failure) => match hpack_dynamic_core::dynamic_core_failure_diagnostic_id(failure) == "hpack.fixture.dynamic_index_out_of_range"
			true => HeaderListDecodeFailed(HpackFixtureDecodeFailed(hpack_dynamic_core::dynamic_core_failure_offset(failure), byte_count_to_int(byte_chunk_count(completed_header_block)), header_block_byte_at_or_missing(completed_header_block, 0), hpack_dynamic_core::dynamic_core_failure_requested_dynamic_index(failure), hpack_dynamic_core::dynamic_core_failure_dynamic_table_entry_count(failure), "source-visible dynamic indexed header", hpack_dynamic_core::dynamic_core_failure_decoder_module(failure), completed_header_block))
			false => decode_completed_fixture_header_list(offset, kind, stream_id, completed_header_block, hpack_state)
		end
	end
end

fn dynamic_core_header_list_to_hpack_header_list(headers: HpackDynamicCoreHeaderList) -> HpackHeaderList
	hpack_fixture::hpack_header_list(hpack_fixture::hpack_header(hpack_dynamic_core::dynamic_core_header_list_first_name(headers), hpack_dynamic_core::dynamic_core_header_list_first_value(headers)), hpack_fixture::hpack_header(hpack_dynamic_core::dynamic_core_header_list_second_name(headers), hpack_dynamic_core::dynamic_core_header_list_second_value(headers)), hpack_dynamic_core::dynamic_core_header_list_wire_size(headers))
end

fn hpack_dynamic_core_next_hpack_state(headers: HpackDynamicCoreHeaderList, hpack_state: HpackFixtureState) -> HpackFixtureState
	match hpack_dynamic_core::dynamic_core_header_list_second_name(headers) == ":fixture" and hpack_dynamic_core::dynamic_core_header_list_second_value(headers) == "literal-with-indexing"
		true => hpack_fixture::state_with_indexed_literal_entry(hpack_state, hpack_dynamic_core::dynamic_core_header_list_first_name(headers), hpack_dynamic_core::dynamic_core_header_list_first_value(headers))
		false => hpack_fixture::state_after_literal_read(hpack_state)
	end
end

fn decode_completed_fixture_header_list(offset: Int, kind: Int, stream_id: Int, completed_header_block: ByteChunk, hpack_state: HpackFixtureState) -> HeaderListDecodeDecision
	match header_block_byte_at_or_missing(completed_header_block, 0) == 62 or header_block_byte_at_or_missing(completed_header_block, 0) == 63
		true => match hpack_fixture::decode_header_block(completed_header_block, hpack_state, offset)
			Ok(fixture_transition) => match hpack_fixture::decode_production_header_block(completed_header_block, hpack_state, receive_limit_value(header_table_receive_limit()), offset)
				Ok(_) => completed_fixture_header_list_transition(fixture_transition)
				Err(production_failure) => match hpack_fixture::hpack_failure_expected_fixture(production_failure) == "production inbound HPACK table-size update"
					true => completed_production_header_list_failure(kind, stream_id, production_failure)
					false => completed_fixture_header_list_transition(fixture_transition)
				end
			end
			Err(fixture_failure) => match hpack_fixture::decode_production_header_block(completed_header_block, hpack_state, receive_limit_value(header_table_receive_limit()), offset)
				Ok(transition) => completed_production_header_list_transition(transition)
				Err(production_failure) => match hpack_fixture::hpack_failure_expected_fixture(fixture_failure) == "fixture HPACK table-size update without trailing bytes"
					true => completed_fixture_header_list_failure(kind, stream_id, fixture_failure)
					false => completed_production_header_list_failure(kind, stream_id, production_failure)
				end
			end
		end
		false => match hpack_fixture::decode_header_block(completed_header_block, hpack_state, offset)
			Ok(transition) => completed_fixture_header_list_transition(transition)
			Err(fixture_failure) => match hpack_fixture::decode_production_header_block(completed_header_block, hpack_state, receive_limit_value(header_table_receive_limit()), offset)
				Ok(transition) => completed_production_header_list_transition(transition)
				Err(_) => completed_fixture_header_list_failure(kind, stream_id, fixture_failure)
			end
		end
	end
end

fn completed_fixture_header_list_transition(transition: HpackDecodeTransition) -> HeaderListDecodeDecision
	HeaderListDecodeOk(hpack_fixture::header_list_wire_size(hpack_fixture::transition_headers(transition)), hpack_fixture::transition_state(transition), hpack_fixture::production_header_list_from_fixture(hpack_fixture::transition_headers(transition)))
end

fn completed_production_header_list_transition(transition: HpackProductionDecodeTransition) -> HeaderListDecodeDecision
	match hpack_fixture::production_transition_headers(transition)
		headers => HeaderListDecodeOk(hpack_fixture::production_header_list_wire_size(headers), hpack_fixture::production_transition_state(transition), headers)
	end
end

fn completed_production_header_list_failure(kind: Int, stream_id: Int, failure: HpackFixtureFailure) -> HeaderListDecodeDecision
	match hpack_fixture::hpack_failure_expected_fixture(failure) == "production inbound HPACK table-size update"
		true => HeaderListDecodeFailed(HeaderTableSizeExceeded(hpack_fixture::hpack_failure_offset(failure), hpack_fixture::hpack_failure_observed_size(failure), header_table_receive_limit(), kind, stream_id, "hpack_dynamic_table_size_update", hpack_fixture::hpack_failure_preview(failure)))
		false => completed_fixture_header_list_failure(kind, stream_id, failure)
	end
end

fn completed_fixture_header_list_failure(kind: Int, stream_id: Int, failure: HpackFixtureFailure) -> HeaderListDecodeDecision
	match hpack_fixture::hpack_failure_expected_fixture(failure) == "fixture HPACK table-size update at header block start" or hpack_fixture::hpack_failure_expected_fixture(failure) == "fixture HPACK table-size update without trailing bytes"
		true => HeaderListDecodeFailed(HpackTableSizeUpdateNotAtStart(hpack_fixture::hpack_failure_offset(failure), hpack_fixture::hpack_failure_observed_size(failure), hpack_fixture::hpack_failure_observed_first_byte(failure), hpack_fixture::hpack_failure_observed_update_size(failure), kind, stream_id, "hpack-fixture", hpack_fixture::hpack_failure_expected_fixture(failure), hpack_fixture::hpack_failure_codec_module(failure), hpack_fixture::hpack_failure_preview(failure)))
		false => HeaderListDecodeFailed(HpackFixtureDecodeFailed(hpack_fixture::hpack_failure_offset(failure), hpack_fixture::hpack_failure_observed_size(failure), hpack_fixture::hpack_failure_observed_first_byte(failure), hpack_fixture::hpack_failure_requested_dynamic_index(failure), hpack_fixture::hpack_failure_dynamic_table_entry_count(failure), hpack_fixture::hpack_failure_expected_fixture(failure), hpack_fixture::hpack_failure_codec_module(failure), hpack_fixture::hpack_failure_preview(failure)))
	end
end

fn validate_header_list_size(offset: Int, kind: Int, flags: Int, stream_id: Int, decoded_header_list_size: Int, completed_header_block: ByteChunk) -> HeaderListSizeDecision
	match header_list_boundary_reached(kind, flags)
		true => validate_completed_header_list_size(offset, kind, stream_id, decoded_header_list_size, header_list_receive_limit(), completed_header_block)
		false => HeaderListSizeOk
	end
end

fn validate_header_table_size_update(offset: Int, kind: Int, flags: Int, stream_id: Int, completed_header_block: ByteChunk, headers: HpackProductionHeaderList, next_hpack_state: HpackFixtureState) -> HeaderTableSizeDecision
	match header_list_boundary_reached(kind, flags) and hpack_fixture::production_header_list_is_table_size_update(headers)
		true => validate_completed_header_table_size_update(offset, kind, stream_id, hpack_fixture::state_table_size(next_hpack_state), header_table_receive_limit(), completed_header_block)
		false => HeaderTableSizeOk
	end
end

fn header_list_boundary_reached(kind: Int, flags: Int) -> Bool
	match kind
		1 => end_headers_set(flags)
		9 => end_headers_set(flags)
		5 => end_headers_set(flags)
		_ => false
	end
end

fn accepted_content_length_for_stream(headers: HpackProductionHeaderList, completed_is_trailer: Bool) -> Int
	match completed_is_trailer
		true => -1
		false => hpack_fixture::production_header_list_accepted_content_length(headers)
	end
end

fn validate_completed_header_list_size(offset: Int, kind: Int, stream_id: Int, observed_size: Int, receive_limit: ReceiveLimitEntry, completed_header_block: ByteChunk) -> HeaderListSizeDecision
	let allowed_size: Int = receive_limit_value(receive_limit)
	match observed_size > allowed_size
		true => HeaderListSizeFailed(HeaderListSizeExceeded(offset, observed_size, receive_limit, kind, stream_id, "header_list_receive_limit", completed_header_block))
		false => HeaderListSizeOk
	end
end

fn validate_completed_header_table_size_update(offset: Int, kind: Int, stream_id: Int, observed_size: Int, receive_limit: ReceiveLimitEntry, completed_header_block: ByteChunk) -> HeaderTableSizeDecision
	let allowed_size: Int = receive_limit_value(receive_limit)
	match observed_size > allowed_size
		true => HeaderTableSizeFailed(HeaderTableSizeExceeded(offset, observed_size, receive_limit, kind, stream_id, "hpack_dynamic_table_size_update", completed_header_block))
		false => HeaderTableSizeOk
	end
end

fn validate_request_header_list(offset: Int, kind: Int, flags: Int, stream_id: Int, headers: HpackProductionHeaderList, completed_header_block: ByteChunk, peer_settings: PeerSettingsState) -> RequestHeaderListDecision
	match header_list_boundary_reached(kind, flags) and hpack_fixture::production_header_list_is_request(headers)
		false => RequestHeaderListOk
		true => validate_completed_request_header_list(offset, kind, stream_id, headers, completed_header_block, peer_settings)
	end
end

fn validate_completed_request_header_list(offset: Int, kind: Int, stream_id: Int, headers: HpackProductionHeaderList, completed_header_block: ByteChunk, peer_settings: PeerSettingsState) -> RequestHeaderListDecision
	match hpack_fixture::production_header_list_has_duplicate_pseudo_header(headers)
		true => RequestHeaderListFailed(InvalidRequestHeaderList(offset, kind, stream_id, "duplicate_pseudo_header", ":method", hpack_fixture::production_header_list_decoded_names(headers), completed_header_block))
		false => match hpack_fixture::production_header_list_has_pseudo_header_after_regular(headers)
			true => RequestHeaderListFailed(InvalidRequestHeaderList(offset, kind, stream_id, "pseudo_header_after_regular_header", ":method", hpack_fixture::production_header_list_decoded_names(headers), completed_header_block))
			false => match hpack_fixture::production_header_list_has_status(headers)
				true => RequestHeaderListFailed(InvalidRequestHeaderList(offset, kind, stream_id, "response_only_pseudo_header", ":status", hpack_fixture::production_header_list_decoded_names(headers), completed_header_block))
				false => match hpack_fixture::production_header_list_has_protocol(headers) and not hpack_fixture::production_header_list_is_connect_request(headers)
					true => RequestHeaderListFailed(InvalidRequestHeaderList(offset, kind, stream_id, "protocol_on_non_connect_request", ":protocol", hpack_fixture::production_header_list_decoded_names(headers), completed_header_block))
					false => match hpack_fixture::production_header_list_is_connect_request(headers)
					true => validate_completed_connect_request_header_list(offset, kind, stream_id, headers, completed_header_block, peer_settings)
					false => match hpack_fixture::production_header_list_has_method(headers)
					false => RequestHeaderListFailed(InvalidRequestHeaderList(offset, kind, stream_id, "missing_required_pseudo_header", ":method", hpack_fixture::production_header_list_decoded_names(headers), completed_header_block))
					true => match hpack_fixture::production_header_list_has_scheme(headers)
						false => RequestHeaderListFailed(InvalidRequestHeaderList(offset, kind, stream_id, "missing_required_pseudo_header", ":scheme", hpack_fixture::production_header_list_decoded_names(headers), completed_header_block))
						true => match hpack_fixture::production_header_list_has_path(headers)
							false => RequestHeaderListFailed(InvalidRequestHeaderList(offset, kind, stream_id, "missing_required_pseudo_header", ":path", hpack_fixture::production_header_list_decoded_names(headers), completed_header_block))
							true => match hpack_fixture::production_header_list_has_empty_method_value(headers)
								true => RequestHeaderListFailed(InvalidRequestHeaderList(offset, kind, stream_id, "method_value_empty", ":method", hpack_fixture::production_header_list_decoded_names(headers), completed_header_block))
								false => match hpack_fixture::production_header_list_has_empty_path_value(headers)
									true => RequestHeaderListFailed(InvalidRequestHeaderList(offset, kind, stream_id, "path_value_empty", ":path", hpack_fixture::production_header_list_decoded_names(headers), completed_header_block))
									false => match hpack_fixture::production_header_list_has_invalid_scheme_value(headers)
										true => RequestHeaderListFailed(InvalidRequestHeaderList(offset, kind, stream_id, "scheme_value_not_http_or_https", ":scheme", hpack_fixture::production_header_list_decoded_names(headers), completed_header_block))
										false => match hpack_fixture::production_header_list_has_invalid_authority_value(headers)
											true => RequestHeaderListFailed(InvalidRequestHeaderList(offset, kind, stream_id, "authority_value_invalid", ":authority", hpack_fixture::production_header_list_decoded_names(headers), completed_header_block))
											false => match hpack_fixture::production_header_list_has_uppercase_ordinary_header(headers)
												true => RequestHeaderListFailed(InvalidRequestHeaderList(offset, kind, stream_id, "ordinary_header_name_not_lowercase", hpack_fixture::production_header_list_invalid_ordinary_header_name(headers), hpack_fixture::production_header_list_decoded_names(headers), completed_header_block))
												false => match hpack_fixture::production_header_list_has_invalid_token_ordinary_header(headers)
													true => RequestHeaderListFailed(InvalidRequestHeaderList(offset, kind, stream_id, "ordinary_header_name_invalid_token", hpack_fixture::production_header_list_invalid_ordinary_header_name(headers), hpack_fixture::production_header_list_decoded_names(headers), completed_header_block))
													false => match hpack_fixture::production_header_list_has_connection_specific_header(headers)
														true => RequestHeaderListFailed(InvalidRequestHeaderList(offset, kind, stream_id, "connection_specific_header", hpack_fixture::production_header_list_connection_specific_header_name(headers), hpack_fixture::production_header_list_decoded_names(headers), completed_header_block))
														false => match hpack_fixture::production_header_list_has_invalid_te_header_value(headers)
															true => RequestHeaderListFailed(InvalidRequestHeaderList(offset, kind, stream_id, "te_header_value_not_trailers", "te", hpack_fixture::production_header_list_decoded_names(headers), completed_header_block))
															false => match hpack_fixture::production_request_header_list_has_invalid_content_length(headers)
																true => RequestHeaderListFailed(InvalidRequestHeaderList(offset, kind, stream_id, "content_length_invalid", "content-length", hpack_fixture::production_header_list_decoded_names(headers), completed_header_block))
																false => match hpack_fixture::production_request_header_list_has_mismatched_content_length(headers)
																	true => RequestHeaderListFailed(InvalidRequestHeaderList(offset, kind, stream_id, "content_length_mismatch", "content-length", hpack_fixture::production_header_list_decoded_names(headers), completed_header_block))
																	false => RequestHeaderListOk
																end
															end
														end
													end
												end
											end
										end
									end
							end
						end
					end
				end
				end
				end
			end
		end
		end
	end
end

fn validate_completed_connect_request_header_list(offset: Int, kind: Int, stream_id: Int, headers: HpackProductionHeaderList, completed_header_block: ByteChunk, peer_settings: PeerSettingsState) -> RequestHeaderListDecision
	match hpack_fixture::production_header_list_has_protocol(headers)
		true => validate_completed_extended_connect_request_header_list(offset, kind, stream_id, headers, completed_header_block, peer_settings)
		false => validate_completed_ordinary_connect_request_header_list(offset, kind, stream_id, headers, completed_header_block)
	end
end

fn validate_completed_ordinary_connect_request_header_list(offset: Int, kind: Int, stream_id: Int, headers: HpackProductionHeaderList, completed_header_block: ByteChunk) -> RequestHeaderListDecision
	match hpack_fixture::production_connect_request_has_authority(headers)
		false => RequestHeaderListFailed(InvalidRequestHeaderList(offset, kind, stream_id, "connect_authority_missing", ":authority", hpack_fixture::production_header_list_decoded_names(headers), completed_header_block))
		true => match hpack_fixture::production_connect_request_has_empty_authority(headers)
			true => RequestHeaderListFailed(InvalidRequestHeaderList(offset, kind, stream_id, "connect_authority_empty", ":authority", hpack_fixture::production_header_list_decoded_names(headers), completed_header_block))
			false => match hpack_fixture::production_connect_request_has_scheme(headers)
				true => RequestHeaderListFailed(InvalidRequestHeaderList(offset, kind, stream_id, "connect_scheme_present", ":scheme", hpack_fixture::production_header_list_decoded_names(headers), completed_header_block))
				false => match hpack_fixture::production_connect_request_has_path(headers)
					true => RequestHeaderListFailed(InvalidRequestHeaderList(offset, kind, stream_id, "connect_path_present", ":path", hpack_fixture::production_header_list_decoded_names(headers), completed_header_block))
					false => RequestHeaderListOk
				end
			end
		end
	end
end

fn validate_completed_extended_connect_request_header_list(offset: Int, kind: Int, stream_id: Int, headers: HpackProductionHeaderList, completed_header_block: ByteChunk, peer_settings: PeerSettingsState) -> RequestHeaderListDecision
	match hpack_fixture::production_header_list_has_duplicate_protocol(headers)
		true => RequestHeaderListFailed(InvalidRequestHeaderList(offset, kind, stream_id, "duplicate_protocol_pseudo_header", ":protocol", hpack_fixture::production_header_list_decoded_names(headers), completed_header_block))
		false => match hpack_fixture::production_header_list_has_empty_protocol(headers)
			true => RequestHeaderListFailed(InvalidRequestHeaderList(offset, kind, stream_id, "protocol_value_empty", ":protocol", hpack_fixture::production_header_list_decoded_names(headers), completed_header_block))
			false => match hpack_fixture::production_connect_request_has_scheme(headers)
				false => RequestHeaderListFailed(InvalidRequestHeaderList(offset, kind, stream_id, "extended_connect_scheme_missing", ":scheme", hpack_fixture::production_header_list_decoded_names(headers), completed_header_block))
				true => match hpack_fixture::production_connect_request_has_path(headers)
					false => RequestHeaderListFailed(InvalidRequestHeaderList(offset, kind, stream_id, "extended_connect_path_missing", ":path", hpack_fixture::production_header_list_decoded_names(headers), completed_header_block))
					true => match hpack_fixture::production_connect_request_has_authority(headers)
						false => RequestHeaderListFailed(InvalidRequestHeaderList(offset, kind, stream_id, "extended_connect_authority_missing", ":authority", hpack_fixture::production_header_list_decoded_names(headers), completed_header_block))
						true => match local_enable_connect_protocol_enabled(peer_settings)
							false => RequestHeaderListFailed(InvalidRequestHeaderList(offset, kind, stream_id, "extended_connect_not_negotiated", ":protocol", hpack_fixture::production_header_list_decoded_names(headers), completed_header_block))
							true => RequestHeaderListOk
						end
					end
				end
			end
		end
	end
end

fn validate_response_header_list(offset: Int, kind: Int, flags: Int, stream_id: Int, headers: HpackProductionHeaderList, completed_header_block: ByteChunk) -> ResponseHeaderListDecision
	match header_list_boundary_reached(kind, flags) and hpack_fixture::production_header_list_is_response(headers)
		false => ResponseHeaderListOk
		true => validate_completed_response_header_list(offset, kind, stream_id, headers, completed_header_block)
	end
end

fn validate_trailer_end_stream(offset: Int, kind: Int, stream_id: Int, headers: HpackProductionHeaderList, completed_is_trailer: Bool, receive_flow_control: ReceiveFlowControl) -> TrailerEndStreamDecision
	match hpack_fixture::production_header_list_is_trailer(headers) and not completed_is_trailer
		true => TrailerEndStreamFailed(InvalidFrameKind(offset, kind, stream_id, 1, trailer_active_state(stream_id, receive_flow_control), trailer_end_stream_rule(stream_id, receive_flow_control)))
		false => TrailerEndStreamOk
	end
end

fn trailer_active_state(stream_id: Int, receive_flow_control: ReceiveFlowControl) -> String
	match stream_is_response_for_trailers(stream_id, receive_flow_control)
		true => "response-trailers"
		false => "request-trailers"
	end
end

fn trailer_end_stream_rule(stream_id: Int, receive_flow_control: ReceiveFlowControl) -> String
	match stream_is_response_for_trailers(stream_id, receive_flow_control)
		true => "response_trailers_require_end_stream"
		false => "request_trailers_require_end_stream"
	end
end

fn stream_is_response_for_trailers(stream_id: Int, receive_flow_control: ReceiveFlowControl) -> Bool
	match receive_flow_control
		ReceiveFlowControl(_, OpenStreamReceiveWindow(open_stream_id, _, priority)) => stream_id == open_stream_id and stream_priority_is_response(priority)
		ReceiveFlowControl(_, TwoOpenStreamReceiveWindows(first_stream_id, _, first_priority, second_stream_id, _, second_priority)) => match stream_id == first_stream_id
			true => stream_priority_is_response(first_priority)
			false => stream_id == second_stream_id and stream_priority_is_response(second_priority)
		end
		ReceiveFlowControl(_, ThreeOpenStreamReceiveWindows(first_stream_id, _, first_priority, second_stream_id, _, second_priority, third_stream_id, _, third_priority)) => match stream_id == first_stream_id
			true => stream_priority_is_response(first_priority)
			false => match stream_id == second_stream_id
				true => stream_priority_is_response(second_priority)
				false => stream_id == third_stream_id and stream_priority_is_response(third_priority)
			end
		end
		ReceiveFlowControl(_, ClientPushAssociatedStreamReceiveWindow(open_stream_id, _, priority, _)) => stream_id == open_stream_id and stream_priority_is_response(priority)
		ReceiveFlowControl(_, HalfClosedLocalStreamReceiveWindow(open_stream_id, _, priority)) => stream_id == open_stream_id and stream_priority_is_response(priority)
		ReceiveFlowControl(_, _) => false
	end
end

fn stream_priority_is_response(priority: StreamPriorityState) -> Bool
	match priority
		ResponseHeaderStream(_) => true
		ExpectedContentLength(_, _, inner) => stream_priority_is_response(inner)
		_ => false
	end
end

fn validate_completed_response_header_list(offset: Int, kind: Int, stream_id: Int, headers: HpackProductionHeaderList, completed_header_block: ByteChunk) -> ResponseHeaderListDecision
	match hpack_fixture::production_header_list_has_duplicate_status(headers)
		true => ResponseHeaderListFailed(InvalidResponseHeaderList(offset, kind, stream_id, "duplicate_pseudo_header", ":status", hpack_fixture::production_header_list_decoded_names(headers), "response-headers", completed_header_block))
		false => match hpack_fixture::production_header_list_has_pseudo_header_after_regular(headers)
			true => ResponseHeaderListFailed(InvalidResponseHeaderList(offset, kind, stream_id, "pseudo_header_after_regular_header", ":status", hpack_fixture::production_header_list_decoded_names(headers), "response-headers", completed_header_block))
			false => match hpack_fixture::production_header_list_has_authority(headers)
				true => ResponseHeaderListFailed(InvalidResponseHeaderList(offset, kind, stream_id, "request_only_pseudo_header", ":authority", hpack_fixture::production_header_list_decoded_names(headers), "response-headers", completed_header_block))
				false => match hpack_fixture::production_header_list_has_method(headers)
					true => ResponseHeaderListFailed(InvalidResponseHeaderList(offset, kind, stream_id, "request_only_pseudo_header", ":method", hpack_fixture::production_header_list_decoded_names(headers), "response-headers", completed_header_block))
					false => match hpack_fixture::production_header_list_has_scheme(headers)
						true => ResponseHeaderListFailed(InvalidResponseHeaderList(offset, kind, stream_id, "request_only_pseudo_header", ":scheme", hpack_fixture::production_header_list_decoded_names(headers), "response-headers", completed_header_block))
						false => match hpack_fixture::production_header_list_has_path(headers)
							true => ResponseHeaderListFailed(InvalidResponseHeaderList(offset, kind, stream_id, "request_only_pseudo_header", ":path", hpack_fixture::production_header_list_decoded_names(headers), "response-headers", completed_header_block))
							false => match hpack_fixture::production_header_list_has_status(headers)
								false => ResponseHeaderListFailed(InvalidResponseHeaderList(offset, kind, stream_id, "missing_required_pseudo_header", ":status", hpack_fixture::production_header_list_decoded_names(headers), "response-headers", completed_header_block))
								true => match hpack_fixture::production_header_list_has_invalid_status_value(headers)
									true => ResponseHeaderListFailed(InvalidResponseHeaderList(offset, kind, stream_id, "status_value_invalid", ":status", hpack_fixture::production_header_list_decoded_names(headers), "response-headers", completed_header_block))
									false => match hpack_fixture::production_header_list_has_uppercase_ordinary_header(headers)
										true => ResponseHeaderListFailed(InvalidResponseHeaderList(offset, kind, stream_id, "ordinary_header_name_not_lowercase", hpack_fixture::production_header_list_invalid_ordinary_header_name(headers), hpack_fixture::production_header_list_decoded_names(headers), "response-headers", completed_header_block))
										false => match hpack_fixture::production_header_list_has_invalid_token_ordinary_header(headers)
											true => ResponseHeaderListFailed(InvalidResponseHeaderList(offset, kind, stream_id, "ordinary_header_name_invalid_token", hpack_fixture::production_header_list_invalid_ordinary_header_name(headers), hpack_fixture::production_header_list_decoded_names(headers), "response-headers", completed_header_block))
											false => match hpack_fixture::production_header_list_has_invalid_te_header_value(headers)
												true => ResponseHeaderListFailed(InvalidResponseHeaderList(offset, kind, stream_id, "te_header_value_not_trailers", "te", hpack_fixture::production_header_list_decoded_names(headers), "response-headers", completed_header_block))
												false => match hpack_fixture::production_header_list_has_invalid_content_length(headers)
													true => ResponseHeaderListFailed(InvalidResponseHeaderList(offset, kind, stream_id, "content_length_invalid", "content-length", hpack_fixture::production_header_list_decoded_names(headers), "response-headers", completed_header_block))
													false => match hpack_fixture::production_header_list_has_mismatched_content_length(headers)
														true => ResponseHeaderListFailed(InvalidResponseHeaderList(offset, kind, stream_id, "content_length_mismatch", "content-length", hpack_fixture::production_header_list_decoded_names(headers), "response-headers", completed_header_block))
														false => ResponseHeaderListOk
													end
												end
											end
										end
									end
								end
							end
						end
					end
				end
			end
		end
	end
end

fn validate_trailer_header_list(offset: Int, kind: Int, flags: Int, stream_id: Int, headers: HpackProductionHeaderList, completed_header_block: ByteChunk, completed_is_trailer: Bool, receive_flow_control: ReceiveFlowControl) -> TrailerHeaderListDecision
	match header_list_boundary_reached(kind, flags) and completed_is_trailer
		false => TrailerHeaderListOk
		true => match stream_is_response_for_trailers(stream_id, receive_flow_control)
			true => validate_completed_response_trailer_header_list(offset, kind, stream_id, headers, completed_header_block)
			false => validate_completed_request_trailer_header_list(offset, kind, stream_id, headers, completed_header_block)
		end
	end
end

fn validate_completed_request_trailer_header_list(offset: Int, kind: Int, stream_id: Int, headers: HpackProductionHeaderList, completed_header_block: ByteChunk) -> TrailerHeaderListDecision
	match hpack_fixture::production_header_list_has_pseudo_header(headers)
		true => TrailerHeaderListFailed(InvalidRequestHeaderList(offset, kind, stream_id, "trailer_pseudo_header", hpack_fixture::production_header_list_first_pseudo_header_name(headers), hpack_fixture::production_header_list_decoded_names(headers), completed_header_block))
		false => match hpack_fixture::production_header_list_has_uppercase_ordinary_header(headers)
			true => TrailerHeaderListFailed(InvalidRequestHeaderList(offset, kind, stream_id, "ordinary_header_name_not_lowercase", hpack_fixture::production_header_list_invalid_ordinary_header_name(headers), hpack_fixture::production_header_list_decoded_names(headers), completed_header_block))
			false => match hpack_fixture::production_header_list_has_invalid_token_ordinary_header(headers)
				true => TrailerHeaderListFailed(InvalidRequestHeaderList(offset, kind, stream_id, "ordinary_header_name_invalid_token", hpack_fixture::production_header_list_invalid_ordinary_header_name(headers), hpack_fixture::production_header_list_decoded_names(headers), completed_header_block))
				false => match hpack_fixture::production_header_list_has_connection_specific_header(headers)
					true => TrailerHeaderListFailed(InvalidRequestHeaderList(offset, kind, stream_id, "connection_specific_header", hpack_fixture::production_header_list_connection_specific_header_name(headers), hpack_fixture::production_header_list_decoded_names(headers), completed_header_block))
					false => match hpack_fixture::production_header_list_has_invalid_te_header_value(headers)
						true => TrailerHeaderListFailed(InvalidRequestHeaderList(offset, kind, stream_id, "te_header_value_not_trailers", "te", hpack_fixture::production_header_list_decoded_names(headers), completed_header_block))
						false => TrailerHeaderListOk
					end
				end
			end
		end
	end
end

fn validate_completed_response_trailer_header_list(offset: Int, kind: Int, stream_id: Int, headers: HpackProductionHeaderList, completed_header_block: ByteChunk) -> TrailerHeaderListDecision
	match hpack_fixture::production_header_list_has_pseudo_header(headers)
		true => TrailerHeaderListFailed(InvalidResponseHeaderList(offset, kind, stream_id, "trailer_pseudo_header", hpack_fixture::production_header_list_first_pseudo_header_name(headers), hpack_fixture::production_header_list_decoded_names(headers), "response-trailers", completed_header_block))
		false => match hpack_fixture::production_header_list_has_uppercase_ordinary_header(headers)
			true => TrailerHeaderListFailed(InvalidResponseHeaderList(offset, kind, stream_id, "ordinary_header_name_not_lowercase", hpack_fixture::production_header_list_invalid_ordinary_header_name(headers), hpack_fixture::production_header_list_decoded_names(headers), "response-trailers", completed_header_block))
			false => match hpack_fixture::production_header_list_has_invalid_token_ordinary_header(headers)
				true => TrailerHeaderListFailed(InvalidResponseHeaderList(offset, kind, stream_id, "ordinary_header_name_invalid_token", hpack_fixture::production_header_list_invalid_ordinary_header_name(headers), hpack_fixture::production_header_list_decoded_names(headers), "response-trailers", completed_header_block))
				false => match hpack_fixture::production_header_list_has_connection_specific_header(headers)
					true => TrailerHeaderListFailed(InvalidResponseHeaderList(offset, kind, stream_id, "connection_specific_header", hpack_fixture::production_header_list_connection_specific_header_name(headers), hpack_fixture::production_header_list_decoded_names(headers), "response-trailers", completed_header_block))
					false => match hpack_fixture::production_header_list_has_invalid_te_header_value(headers)
						true => TrailerHeaderListFailed(InvalidResponseHeaderList(offset, kind, stream_id, "te_header_value_not_trailers", "te", hpack_fixture::production_header_list_decoded_names(headers), "response-trailers", completed_header_block))
						false => TrailerHeaderListOk
					end
				end
			end
		end
	end
end
fn frame_value(pending: ByteChunk, length: Int, kind: Int, flags: Int, stream_id: Int) -> Result<Http2Frame, String>
	let payload_chunk: ByteChunk = frame_payload_chunk(pending, length)?
	let payload: ByteView = data_content_view(payload_chunk, length, kind, flags)?
	match kind
		2 => Ok(PriorityFrame(flags, stream_id, priority_dependency_stream_id(payload)?, priority_exclusive(payload)?, priority_weight(payload)?))
		_ => match is_known_frame_kind(kind)
			true => Ok(KnownFrame(kind, flags, stream_id, payload))
			false => Ok(UnknownFrame(kind, flags, stream_id, payload))
		end
	end
end

fn priority_dependency_stream_id(payload: ByteView) -> Result<Int, String>
	let payload_chunk: ByteChunk = byte_view_to_chunk(payload)
	let first_byte: Int = byte_read_u8_be(byte_view(payload_chunk, byte_offset(0)?, byte_count(1)?)?)?
	let second_byte: Int = byte_read_u8_be(byte_view(payload_chunk, byte_offset(1)?, byte_count(1)?)?)?
	let third_byte: Int = byte_read_u8_be(byte_view(payload_chunk, byte_offset(2)?, byte_count(1)?)?)?
	let fourth_byte: Int = byte_read_u8_be(byte_view(payload_chunk, byte_offset(3)?, byte_count(1)?)?)?
	Ok((first_byte - (first_byte / 128) * 128) * 16777216 + second_byte * 65536 + third_byte * 256 + fourth_byte)
end

fn priority_exclusive(payload: ByteView) -> Result<Bool, String>
	let first_byte: Int = byte_read_u8_be(byte_view(byte_view_to_chunk(payload), byte_offset(0)?, byte_count(1)?)?)?
	Ok(first_byte >= 128)
end

fn priority_weight(payload: ByteView) -> Result<Int, String>
	let encoded_weight: Int = byte_read_u8_be(byte_view(byte_view_to_chunk(payload), byte_offset(4)?, byte_count(1)?)?)?
	Ok(encoded_weight + 1)
end

fn is_known_frame_kind(kind: Int) -> Bool
	match kind
		0 => true
		1 => true
		3 => true
		4 => true
		6 => true
		7 => true
		8 => true
		9 => true
		2 => true
		5 => true
		_ => false
	end
end

fn is_unknown_frame_kind(kind: Int) -> Bool
	match is_known_frame_kind(kind)
		true => false
		false => true
	end
end

fn validate_protocol_payload(offset: Int, payload: ByteChunk, length: Int, kind: Int, flags: Int, stream_id: Int) -> Result<ProtocolPayloadDecision, String>
	match kind
		6 => validate_fixed_payload_length(offset, payload, length, kind, stream_id, 8, "connection-control", "rfc9113_ping_payload_length")
		7 => validate_fixed_payload_length(offset, payload, length, kind, stream_id, 8, "connection-control", "rfc9113_goaway_payload_length")
		8 => validate_fixed_payload_length(offset, payload, length, kind, stream_id, 4, "flow-control", "rfc9113_window_update_payload_length")
		4 => validate_settings_ack_payload_length(offset, payload, length, flags, stream_id)
		3 => validate_fixed_payload_length(offset, payload, length, kind, stream_id, 4, "stream-control", "rfc9113_rst_stream_payload_length")
		2 => validate_fixed_payload_length(offset, payload, length, kind, stream_id, 5, "stream-control", "rfc9113_priority_payload_length")
		1 => validate_headers_payload_length(offset, payload, length, kind, flags, stream_id)
		5 => validate_push_promise_payload_length(offset, payload, length, kind, stream_id)
		_ => Ok(ProtocolPayloadOk)
	end
end

fn validate_headers_payload_length(offset: Int, payload: ByteChunk, length: Int, kind: Int, flags: Int, stream_id: Int) -> Result<ProtocolPayloadDecision, String>
	match headers_priority_set(kind, flags) and length < 5
		true => Ok(ProtocolPayloadFailed(InvalidPayloadLength(offset, kind, stream_id, length, 5, "stream-control", "rfc9113_headers_priority_payload_length", byte_view(payload, byte_offset(0)?, byte_count(length)?)?)))
		false => Ok(ProtocolPayloadOk)
	end
end

fn validate_push_promise_payload_length(offset: Int, payload: ByteChunk, length: Int, kind: Int, stream_id: Int) -> Result<ProtocolPayloadDecision, String>
	match length < 4
		true => Ok(ProtocolPayloadFailed(InvalidPayloadLength(offset, kind, stream_id, length, 4, "stream-control", "rfc9113_push_promise_payload_length", byte_view(payload, byte_offset(0)?, byte_count(length)?)?)))
		false => Ok(ProtocolPayloadOk)
	end
end

fn validate_data_padding(offset: Int, payload: ByteChunk, length: Int, kind: Int, flags: Int, stream_id: Int, receive_flow_control: ReceiveFlowControl) -> Result<PaddingDecision, String>
	match kind
		0 => match data_padded_set(flags)
			false => Ok(PaddingOk)
			true => validate_padded_data_payload(offset, payload, length, stream_id, receive_flow_control)
		end
		_ => Ok(PaddingOk)
	end
end

fn validate_padded_data_payload(offset: Int, payload: ByteChunk, length: Int, stream_id: Int, receive_flow_control: ReceiveFlowControl) -> Result<PaddingDecision, String>
	let active_state: String = data_padding_active_state(stream_id, receive_flow_control)
	match length
		0 => Ok(PaddingFailed(InvalidDataPadding(offset, stream_id, 0, -1, active_state, "rfc9113_data_padding", byte_view(payload, byte_offset(0)?, byte_count(length)?)?)))
		_ => match data_pad_length(payload)? > length - 1
			true => Ok(PaddingFailed(InvalidDataPadding(offset + 9, stream_id, data_pad_length(payload)?, length - 1, active_state, "rfc9113_data_padding", byte_view(payload, byte_offset(0)?, byte_count(length)?)?)))
			false => Ok(PaddingOk)
		end
	end
end

fn data_padding_active_state(stream_id: Int, receive_flow_control: ReceiveFlowControl) -> String
	match receive_flow_control
		ReceiveFlowControl(_, TwoOpenStreamReceiveWindows(first_stream_id, _, _, second_stream_id, _, _)) => match stream_id == first_stream_id
			true => "open-stream"
			false => match stream_id == second_stream_id
				true => "open-stream"
				false => "idle-stream"
			end
		end
		ReceiveFlowControl(_, ThreeOpenStreamReceiveWindows(first_stream_id, _, _, second_stream_id, _, _, third_stream_id, _, _)) => match stream_id == first_stream_id
			true => "open-stream"
			false => match stream_id == second_stream_id
				true => "open-stream"
				false => match stream_id == third_stream_id
					true => "open-stream"
					false => "idle-stream"
				end
			end
		end
		ReceiveFlowControl(_, HalfClosedLocalStreamReceiveWindow(open_stream_id, _, _)) => match stream_id == open_stream_id
			true => "half-closed-local-stream"
			false => "open-stream"
		end
		ReceiveFlowControl(_, _) => "open-stream"
	end
end

fn data_content_view(payload: ByteChunk, length: Int, kind: Int, flags: Int) -> Result<ByteView, String>
	match kind
		0 => match data_padded_set(flags)
			false => byte_view(payload, byte_offset(0)?, byte_count(length)?)
			true => padded_data_content_view(payload, length)
		end
		_ => byte_view(payload, byte_offset(0)?, byte_count(length)?)
	end
end

fn data_application_length(payload: ByteChunk, length: Int, flags: Int) -> Result<Int, String>
	Ok(byte_count_to_int(byte_view_count(data_content_view(payload, length, 0, flags)?)))
end

fn padded_data_content_view(payload: ByteChunk, length: Int) -> Result<ByteView, String>
	let pad_length: Int = data_pad_length(payload)?
	byte_view(payload, byte_offset(1)?, byte_count(length - 1 - pad_length)?)
end

fn data_pad_length(payload: ByteChunk) -> Result<Int, String>
	byte_read_u8_be(byte_view(payload, byte_offset(0)?, byte_count(1)?)?)
end

fn settings_ack_set(flags: Int) -> Bool
	(flags / 2) * 2 != flags
end

fn ping_ack_set(flags: Int) -> Bool
	(flags / 2) * 2 != flags
end

fn validate_settings_ack_payload_length(offset: Int, payload: ByteChunk, length: Int, flags: Int, stream_id: Int) -> Result<ProtocolPayloadDecision, String>
	match settings_ack_set(flags)
		true => validate_fixed_payload_length(offset, payload, length, 4, stream_id, 0, "connection-control", "rfc9113_settings_ack_payload_length")
		false => validate_settings_item_payload_length(offset, payload, length, stream_id)
	end
end

fn validate_settings_item_payload_length(offset: Int, payload: ByteChunk, length: Int, stream_id: Int) -> Result<ProtocolPayloadDecision, String>
	match settings_payload_has_partial_item(length)
		true => Ok(ProtocolPayloadFailed(InvalidPayloadLength(offset, 4, stream_id, length, 6, "connection-control", "rfc9113_settings_payload_item_length", byte_view(payload, byte_offset(0)?, byte_count(length)?)?)))
		false => Ok(ProtocolPayloadOk)
	end
end

fn validate_fixed_payload_length(offset: Int, payload: ByteChunk, length: Int, kind: Int, stream_id: Int, expected_length: Int, active_state: String, rule_provenance: String) -> Result<ProtocolPayloadDecision, String>
	match length == expected_length
		true => Ok(ProtocolPayloadOk)
		false => Ok(ProtocolPayloadFailed(InvalidPayloadLength(offset, kind, stream_id, length, expected_length, active_state, rule_provenance, byte_view(payload, byte_offset(0)?, byte_count(length)?)?)))
	end
end

fn validate_settings_value(pending: ByteChunk, next_offset: Int, length: Int, kind: Int, flags: Int, endpoint_role: Http2EndpointRole) -> Result<SettingsRangeDecision, String>
	match kind
		4 => match settings_ack_set(flags)
			true => Ok(SettingsValueOk)
			false => match settings_payload_has_complete_items(length)
				true => validate_settings_items(pending, next_offset, 9, 9 + length, endpoint_role)
				false => Ok(SettingsValueOk)
			end
		end
		_ => Ok(SettingsValueOk)
	end
end

fn settings_payload_has_complete_items(length: Int) -> Bool
	match length > 0
		true => (length / 6) * 6 == length
		false => false
	end
end

fn settings_payload_has_partial_item(length: Int) -> Bool
	match length > 0
		true => (length / 6) * 6 != length
		false => false
	end
end

fn validate_settings_items(pending: ByteChunk, next_offset: Int, item_wire_offset: Int, payload_end_offset: Int, endpoint_role: Http2EndpointRole) -> Result<SettingsRangeDecision, String>
	match item_wire_offset == payload_end_offset
		true => Ok(SettingsValueOk)
		false => match validate_single_settings_value(pending, next_offset, item_wire_offset, endpoint_role)?
			SettingsValueOk => validate_settings_items(pending, next_offset, item_wire_offset + 6, payload_end_offset, endpoint_role)
			SettingsValueFailed(error) => Ok(SettingsValueFailed(error))
		end
	end
end

fn validate_single_settings_value(pending: ByteChunk, next_offset: Int, item_wire_offset: Int, endpoint_role: Http2EndpointRole) -> Result<SettingsRangeDecision, String>
	let item_offset: ByteOffset = byte_offset(item_wire_offset)?
	let item_count: ByteCount = byte_count(6)?
	let item: ByteView = byte_view(pending, item_offset, item_count)?
	let identifier_count: ByteCount = byte_count(2)?
	let value_offset: ByteOffset = byte_offset(2)?
	let value_count: ByteCount = byte_count(4)?
	let identifier: Int = byte_read_u16_be(byte_view(byte_view_to_chunk(item), byte_offset(0)?, identifier_count)?)?
	let value: Int = byte_read_u32_be(byte_view(byte_view_to_chunk(item), value_offset, value_count)?)?
	match identifier
		5 => validate_max_frame_size_setting(next_offset + item_wire_offset, value, item)
		4 => validate_initial_window_size_setting(next_offset + item_wire_offset, value, item)
		2 => validate_enable_push_setting_for_role(next_offset + item_wire_offset, value, item, endpoint_role)
		8 => validate_enable_connect_protocol_setting_for_role(next_offset + item_wire_offset, value, item, endpoint_role)
		_ => Ok(SettingsValueOk)
	end
end

fn validate_enable_connect_protocol_setting_for_role(item_offset: Int, value: Int, preview: ByteView, endpoint_role: Http2EndpointRole) -> Result<SettingsRangeDecision, String>
	match endpoint_role
		ServerEndpoint => Ok(SettingsValueFailed(SettingsNotAllowedForEndpoint(item_offset, 8, "SETTINGS_ENABLE_CONNECT_PROTOCOL", "server", 4, "peer-settings", "rfc8441_client_must_not_send_settings_enable_connect_protocol", preview)))
		ClientEndpoint => validate_enable_connect_protocol_setting(item_offset, value, preview, "peer_settings")
	end
end

fn validate_enable_push_setting_for_role(item_offset: Int, value: Int, preview: ByteView, endpoint_role: Http2EndpointRole) -> Result<SettingsRangeDecision, String>
	match endpoint_role
		ClientEndpoint => Ok(SettingsValueFailed(SettingsNotAllowedForEndpoint(item_offset, 2, "SETTINGS_ENABLE_PUSH", "client", 4, "peer-settings", "rfc9113_client_must_not_receive_settings_enable_push", preview)))
		ServerEndpoint => validate_enable_push_setting(item_offset, value, preview)
	end
end

fn validate_max_frame_size_setting(item_offset: Int, value: Int, preview: ByteView) -> Result<SettingsRangeDecision, String>
	match value < 16384
		true => Ok(SettingsValueFailed(SettingsValueOutOfRange(item_offset, 5, "SETTINGS_MAX_FRAME_SIZE", value, 16384, 16777215, "peer_settings", preview)))
		false => match value > 16777215
			true => Ok(SettingsValueFailed(SettingsValueOutOfRange(item_offset, 5, "SETTINGS_MAX_FRAME_SIZE", value, 16384, 16777215, "peer_settings", preview)))
			false => Ok(SettingsValueOk)
		end
	end
end

fn validate_initial_window_size_setting(item_offset: Int, value: Int, preview: ByteView) -> Result<SettingsRangeDecision, String>
	match initial_window_size(value)
		Ok(_) => Ok(SettingsValueOk)
		Err(_) => Ok(SettingsValueFailed(SettingsValueOutOfRange(item_offset, 4, "SETTINGS_INITIAL_WINDOW_SIZE", value, 0, max_flow_control_value(), "peer_settings", preview)))
	end
end

fn validate_enable_push_setting(item_offset: Int, value: Int, preview: ByteView) -> Result<SettingsRangeDecision, String>
	match value > 1
		true => Ok(SettingsValueFailed(SettingsValueOutOfRange(item_offset, 2, "SETTINGS_ENABLE_PUSH", value, 0, 1, "peer_settings", preview)))
		false => Ok(SettingsValueOk)
	end
end

fn validate_enable_connect_protocol_setting(item_offset: Int, value: Int, preview: ByteView, provenance: String) -> Result<SettingsRangeDecision, String>
	match value < 0
		true => Ok(SettingsValueFailed(SettingsValueOutOfRange(item_offset, 8, "SETTINGS_ENABLE_CONNECT_PROTOCOL", value, 0, 1, provenance, preview)))
		false => match value > 1
			true => Ok(SettingsValueFailed(SettingsValueOutOfRange(item_offset, 8, "SETTINGS_ENABLE_CONNECT_PROTOCOL", value, 0, 1, provenance, preview)))
			false => Ok(SettingsValueOk)
		end
	end
end

fn update_peer_settings(pending: ByteChunk, next_offset: Int, length: Int, kind: Int, flags: Int, peer_settings: PeerSettingsState) -> Result<PeerSettingsState, String>
	match kind
		4 => match settings_ack_set(flags)
			true => Ok(peer_settings)
			false => update_settings_frame(pending, next_offset, length, peer_settings)
		end
		_ => Ok(peer_settings)
	end
end

fn update_settings_frame(pending: ByteChunk, next_offset: Int, length: Int, peer_settings: PeerSettingsState) -> Result<PeerSettingsState, String>
	match settings_payload_has_complete_items(length)
		true => update_settings_items(pending, next_offset, 9, 9 + length, peer_settings)
		false => Ok(peer_settings)
	end
end

fn update_settings_items(pending: ByteChunk, next_offset: Int, item_wire_offset: Int, payload_end_offset: Int, peer_settings: PeerSettingsState) -> Result<PeerSettingsState, String>
	match item_wire_offset == payload_end_offset
		true => Ok(peer_settings)
		false => update_settings_items(pending, next_offset, item_wire_offset + 6, payload_end_offset, update_single_settings_item(pending, next_offset, item_wire_offset, peer_settings)?)
	end
end

fn update_single_settings_item(pending: ByteChunk, next_offset: Int, item_wire_offset: Int, peer_settings: PeerSettingsState) -> Result<PeerSettingsState, String>
	let item_offset: ByteOffset = byte_offset(item_wire_offset)?
	let item_count: ByteCount = byte_count(6)?
	let item: ByteView = byte_view(pending, item_offset, item_count)?
	let identifier_count: ByteCount = byte_count(2)?
	let value_offset: ByteOffset = byte_offset(2)?
	let value_count: ByteCount = byte_count(4)?
	let identifier: Int = byte_read_u16_be(byte_view(byte_view_to_chunk(item), byte_offset(0)?, identifier_count)?)?
	let value: Int = byte_read_u32_be(byte_view(byte_view_to_chunk(item), value_offset, value_count)?)?
	match peer_settings
		PeerSettings(max_frame_size, initial_window_size, enable_push, max_concurrent_streams, header_table_size, max_header_list_size, local_enable_push, highest_peer_stream_id) => match identifier
			5 => Ok(PeerSettings(PeerMaxFrameSize(value, next_offset + item_wire_offset), initial_window_size, enable_push, max_concurrent_streams, header_table_size, max_header_list_size, local_enable_push, highest_peer_stream_id))
			4 => Ok(PeerSettings(max_frame_size, PeerInitialWindowSize(value, next_offset + item_wire_offset), enable_push, max_concurrent_streams, header_table_size, max_header_list_size, local_enable_push, highest_peer_stream_id))
			2 => Ok(PeerSettings(max_frame_size, initial_window_size, with_peer_enable_push(enable_push, value, next_offset + item_wire_offset), max_concurrent_streams, header_table_size, max_header_list_size, local_enable_push, highest_peer_stream_id))
			3 => Ok(PeerSettings(max_frame_size, initial_window_size, enable_push, PeerMaxConcurrentStreams(value, next_offset + item_wire_offset), header_table_size, max_header_list_size, local_enable_push, highest_peer_stream_id))
			1 => Ok(PeerSettings(max_frame_size, initial_window_size, enable_push, max_concurrent_streams, PeerHeaderTableSize(value, next_offset + item_wire_offset), max_header_list_size, local_enable_push, highest_peer_stream_id))
			6 => Ok(PeerSettings(max_frame_size, initial_window_size, enable_push, max_concurrent_streams, header_table_size, PeerMaxHeaderListSize(value, next_offset + item_wire_offset), local_enable_push, highest_peer_stream_id))
			8 => Ok(PeerSettings(max_frame_size, initial_window_size, with_peer_enable_connect_protocol(enable_push, value, next_offset + item_wire_offset), max_concurrent_streams, header_table_size, max_header_list_size, local_enable_push, highest_peer_stream_id))
			_ => Ok(peer_settings)
		end
	end
end

fn with_peer_enable_push(state: PeerAdvertisedEnablePush, value: Int, item_offset: Int) -> PeerAdvertisedEnablePush
	match state
		NoPeerEnablePush => PeerEnablePush(value, item_offset)
		PeerEnablePush(_, _) => PeerEnablePush(value, item_offset)
		PeerEnableConnectProtocol(connect_value, connect_offset) => PeerEnablePushAndConnectProtocol(value, item_offset, connect_value, connect_offset)
		PeerEnablePushAndConnectProtocol(_, _, connect_value, connect_offset) => PeerEnablePushAndConnectProtocol(value, item_offset, connect_value, connect_offset)
	end
end

fn with_peer_enable_connect_protocol(state: PeerAdvertisedEnablePush, value: Int, item_offset: Int) -> PeerAdvertisedEnablePush
	match state
		NoPeerEnablePush => PeerEnableConnectProtocol(value, item_offset)
		PeerEnablePush(push_value, push_offset) => PeerEnablePushAndConnectProtocol(push_value, push_offset, value, item_offset)
		PeerEnableConnectProtocol(_, _) => PeerEnableConnectProtocol(value, item_offset)
		PeerEnablePushAndConnectProtocol(push_value, push_offset, _, _) => PeerEnablePushAndConnectProtocol(push_value, push_offset, value, item_offset)
	end
end

fn update_initial_window_receive_credit(pending: ByteChunk, next_offset: Int, length: Int, kind: Int, flags: Int, peer_settings: PeerSettingsState, receive_flow_control: ReceiveFlowControl) -> Result<ReceiveFlowControl, String>
	match kind
		4 => match settings_ack_set(flags)
			true => Ok(receive_flow_control)
			false => match settings_payload_has_complete_items(length)
				true => update_initial_window_receive_credit_items(pending, next_offset, 9, 9 + length, peer_settings, receive_flow_control)
				false => Ok(receive_flow_control)
			end
		end
		_ => Ok(receive_flow_control)
	end
end

fn update_initial_window_receive_credit_items(pending: ByteChunk, next_offset: Int, item_wire_offset: Int, payload_end_offset: Int, peer_settings: PeerSettingsState, receive_flow_control: ReceiveFlowControl) -> Result<ReceiveFlowControl, String>
	match item_wire_offset == payload_end_offset
		true => Ok(receive_flow_control)
		false => update_initial_window_receive_credit_items(pending, next_offset, item_wire_offset + 6, payload_end_offset, update_single_settings_item(pending, next_offset, item_wire_offset, peer_settings)?, update_single_initial_window_receive_credit(pending, next_offset, item_wire_offset, peer_settings, receive_flow_control)?)
	end
end

fn update_single_initial_window_receive_credit(pending: ByteChunk, next_offset: Int, item_wire_offset: Int, peer_settings: PeerSettingsState, receive_flow_control: ReceiveFlowControl) -> Result<ReceiveFlowControl, String>
	let item_offset: ByteOffset = byte_offset(item_wire_offset)?
	let item_count: ByteCount = byte_count(6)?
	let item: ByteView = byte_view(pending, item_offset, item_count)?
	let identifier_count: ByteCount = byte_count(2)?
	let value_offset: ByteOffset = byte_offset(2)?
	let value_count: ByteCount = byte_count(4)?
	let identifier: Int = byte_read_u16_be(byte_view(byte_view_to_chunk(item), byte_offset(0)?, identifier_count)?)?
	let value: Int = byte_read_u32_be(byte_view(byte_view_to_chunk(item), value_offset, value_count)?)?
	match identifier
		4 => apply_initial_window_delta(initial_window_size_value(match initial_window_size(value)
			Ok(size) => size
			Err(_) => Err("validated initial window size is outside the HTTP/2 domain")?
		end) - active_peer_initial_window_size(peer_settings), receive_flow_control)
		_ => Ok(receive_flow_control)
	end
end

fn active_peer_initial_window_size(peer_settings: PeerSettingsState) -> Int
	match peer_settings
		PeerSettings(_, NoPeerInitialWindowSize, _, _, _, _, _, _) => 65535
		PeerSettings(_, PeerInitialWindowSize(value, _), _, _, _, _, _, _) => value
	end
end

fn active_peer_max_frame_size(peer_settings: PeerSettingsState) -> Int
	match peer_settings
		PeerSettings(NoPeerMaxFrameSize, _, _, _, _, _, _, _) => 16384
		PeerSettings(PeerMaxFrameSize(value, _), _, _, _, _, _, _, _) => value
	end
end

fn active_peer_max_concurrent_streams(peer_settings: PeerSettingsState) -> Int
	match peer_settings
		PeerSettings(_, _, _, NoPeerMaxConcurrentStreams, _, _, _, _) => 2147483647
		PeerSettings(_, _, _, PeerMaxConcurrentStreams(value, _), _, _, _, _) => value
	end
end

fn active_peer_header_table_size(peer_settings: PeerSettingsState) -> Int
	match peer_settings
		PeerSettings(_, _, _, _, NoPeerHeaderTableSize, _, _, _) => 4096
		PeerSettings(_, _, _, _, PeerHeaderTableSize(value, _), _, _, _) => value
	end
end

fn peer_enable_push_disabled(peer_settings: PeerSettingsState) -> Bool
	match peer_settings
		PeerSettings(_, _, PeerEnablePush(value, _), _, _, _, _, _) => value == 0
		PeerSettings(_, _, PeerEnablePushAndConnectProtocol(value, _, _, _), _, _, _, _, _) => value == 0
		PeerSettings(_, _, PeerEnableConnectProtocol(_, _), _, _, _, _, _) => false
		PeerSettings(_, _, NoPeerEnablePush, _, _, _, _, _) => false
	end
end

fn local_enable_push_disabled(peer_settings: PeerSettingsState) -> Bool
	match peer_settings
		PeerSettings(_, _, _, _, _, _, LocalSentEnablePush(value, _), _) => value == 0
		PeerSettings(_, _, _, _, _, _, LocalSentEnablePushAndConnectProtocol(value, _, _, _), _) => value == 0
		PeerSettings(_, _, _, _, _, _, LocalSentEnableConnectProtocol(_, _), _) => false
		PeerSettings(_, _, _, _, _, _, NoLocalSentEnablePush, _) => false
	end
end

fn local_enable_push_value(peer_settings: PeerSettingsState) -> Int
	match peer_settings
		PeerSettings(_, _, _, _, _, _, LocalSentEnablePush(value, _), _) => value
		PeerSettings(_, _, _, _, _, _, LocalSentEnablePushAndConnectProtocol(value, _, _, _), _) => value
		PeerSettings(_, _, _, _, _, _, LocalSentEnableConnectProtocol(_, _), _) => 0
		PeerSettings(_, _, _, _, _, _, NoLocalSentEnablePush, _) => 0
	end
end

fn local_enable_push_offset(peer_settings: PeerSettingsState) -> Int
	match peer_settings
		PeerSettings(_, _, _, _, _, _, LocalSentEnablePush(_, item_offset), _) => item_offset
		PeerSettings(_, _, _, _, _, _, LocalSentEnablePushAndConnectProtocol(_, item_offset, _, _), _) => item_offset
		PeerSettings(_, _, _, _, _, _, LocalSentEnableConnectProtocol(_, _), _) => 0
		PeerSettings(_, _, _, _, _, _, NoLocalSentEnablePush, _) => 0
	end
end

fn with_local_enable_push(peer_settings: PeerSettingsState, value: Int, item_offset: Int) -> PeerSettingsState
	match peer_settings
		PeerSettings(max_frame_size, initial_window_size, enable_push, max_concurrent_streams, header_table_size, max_header_list_size, local_enable_push, highest_peer_stream_id) => PeerSettings(max_frame_size, initial_window_size, enable_push, max_concurrent_streams, header_table_size, max_header_list_size, local_settings_with_enable_push(local_enable_push, value, item_offset), highest_peer_stream_id)
	end
end

fn local_settings_with_enable_push(state: LocalSentEnablePush, value: Int, item_offset: Int) -> LocalSentEnablePush
	match state
		NoLocalSentEnablePush => LocalSentEnablePush(value, item_offset)
		LocalSentEnablePush(_, _) => LocalSentEnablePush(value, item_offset)
		LocalSentEnableConnectProtocol(connect_value, connect_offset) => LocalSentEnablePushAndConnectProtocol(value, item_offset, connect_value, connect_offset)
		LocalSentEnablePushAndConnectProtocol(_, _, connect_value, connect_offset) => LocalSentEnablePushAndConnectProtocol(value, item_offset, connect_value, connect_offset)
	end
end

fn local_enable_connect_protocol_enabled(peer_settings: PeerSettingsState) -> Bool
	match peer_settings
		PeerSettings(_, _, _, _, _, _, LocalSentEnableConnectProtocol(value, _), _) => value == 1
		PeerSettings(_, _, _, _, _, _, LocalSentEnablePushAndConnectProtocol(_, _, value, _), _) => value == 1
		PeerSettings(_, _, _, _, _, _, _, _) => false
	end
end

fn peer_enable_connect_protocol_value(peer_settings: PeerSettingsState) -> Int
	match peer_settings
		PeerSettings(_, _, PeerEnableConnectProtocol(value, _), _, _, _, _, _) => value
		PeerSettings(_, _, PeerEnablePushAndConnectProtocol(_, _, value, _), _, _, _, _, _) => value
		PeerSettings(_, _, _, _, _, _, _, _) => 0
	end
end

fn peer_enable_connect_protocol_offset(peer_settings: PeerSettingsState) -> Int
	match peer_settings
		PeerSettings(_, _, PeerEnableConnectProtocol(_, item_offset), _, _, _, _, _) => item_offset
		PeerSettings(_, _, PeerEnablePushAndConnectProtocol(_, _, _, item_offset), _, _, _, _, _) => item_offset
		PeerSettings(_, _, _, _, _, _, _, _) => 0
	end
end

fn with_local_enable_connect_protocol(peer_settings: PeerSettingsState, value: Int, item_offset: Int) -> PeerSettingsState
	match peer_settings
		PeerSettings(max_frame_size, initial_window_size, enable_push, max_concurrent_streams, header_table_size, max_header_list_size, local_enable_push, highest_peer_stream_id) => PeerSettings(max_frame_size, initial_window_size, enable_push, max_concurrent_streams, header_table_size, max_header_list_size, local_settings_with_enable_connect_protocol(local_enable_push, value, item_offset), highest_peer_stream_id)
	end
end

fn local_settings_with_enable_connect_protocol(state: LocalSentEnablePush, value: Int, item_offset: Int) -> LocalSentEnablePush
	match state
		NoLocalSentEnablePush => LocalSentEnableConnectProtocol(value, item_offset)
		LocalSentEnablePush(push_value, push_offset) => LocalSentEnablePushAndConnectProtocol(push_value, push_offset, value, item_offset)
		LocalSentEnableConnectProtocol(_, _) => LocalSentEnableConnectProtocol(value, item_offset)
		LocalSentEnablePushAndConnectProtocol(push_value, push_offset, _, _) => LocalSentEnablePushAndConnectProtocol(push_value, push_offset, value, item_offset)
	end
end

fn update_local_enable_push_state(state: Http2DecodeState, value: Int, item_offset: Int) -> Http2DecodeState
	match state
		State(pending, next_offset, preface_state, continuation, hpack_state, receive_limit, peer_settings, shutdown_state, receive_flow_control, peer_stream_admission) => State(pending, next_offset, preface_state, continuation, hpack_state, receive_limit, with_local_enable_push(peer_settings, value, item_offset), shutdown_state, receive_flow_control, peer_stream_admission)
	end
end

fn outbound_receive_credit_with_open_stream(connection_window: Int, stream_id: Int, stream_window: Int) -> OutboundReceiveCredit
	OutboundReceiveCredit(connection_window, OutboundReceiveCreditOpenStream(stream_id, stream_window))
end

fn outbound_receive_credit_without_stream(connection_window: Int) -> OutboundReceiveCredit
	OutboundReceiveCredit(connection_window, NoOutboundReceiveCreditStream)
end

fn outbound_receive_credit_with_closed_stream(connection_window: Int, stream_id: Int) -> OutboundReceiveCredit
	OutboundReceiveCredit(connection_window, OutboundReceiveCreditClosedStream(stream_id))
end

fn outbound_receive_credit_with_reset_stream(connection_window: Int, stream_id: Int, error_code: Int) -> OutboundReceiveCredit
	OutboundReceiveCredit(connection_window, OutboundReceiveCreditResetStream(stream_id, error_code))
end

fn outbound_send_credit_with_open_stream(connection_window: Int, stream_id: Int, stream_window: Int) -> OutboundSendCredit
	OutboundSendCredit(connection_window, Cons(OutboundReceiveCreditOpenStream(stream_id, stream_window), Nil))
end

fn outbound_send_credit_with_content_length(connection_window: Int, stream_id: Int, stream_window: Int, expected_length: Int, observed_length: Int) -> OutboundSendCredit
	OutboundSendCredit(connection_window, Cons(OutboundReceiveCreditOpenStreamContentLength(stream_id, stream_window, expected_length, observed_length), Nil))
end

fn outbound_send_credit_without_stream(connection_window: Int) -> OutboundSendCredit
	OutboundSendCredit(connection_window, Nil)
end

fn outbound_send_credit_with_closed_stream(connection_window: Int, stream_id: Int) -> OutboundSendCredit
	OutboundSendCredit(connection_window, Cons(OutboundReceiveCreditClosedStream(stream_id), Nil))
end

fn outbound_send_credit_with_reset_stream(connection_window: Int, stream_id: Int, error_code: Int) -> OutboundSendCredit
	OutboundSendCredit(connection_window, Cons(OutboundReceiveCreditResetStream(stream_id, error_code), Nil))
end

fn add_outbound_open_stream(send_credit: OutboundSendCredit, stream_id: Int, stream_window: Int) -> OutboundSendCredit
	match send_credit
		OutboundSendCredit(connection_window, streams) => OutboundSendCredit(connection_window, Cons(OutboundReceiveCreditOpenStream(stream_id, stream_window), streams))
	end
end

fn add_outbound_content_length_stream(send_credit: OutboundSendCredit, stream_id: Int, stream_window: Int, expected_length: Int, observed_length: Int) -> OutboundSendCredit
	match send_credit
		OutboundSendCredit(connection_window, streams) => OutboundSendCredit(connection_window, Cons(OutboundReceiveCreditOpenStreamContentLength(stream_id, stream_window, expected_length, observed_length), streams))
	end
end

fn add_outbound_closed_stream(send_credit: OutboundSendCredit, stream_id: Int) -> OutboundSendCredit
	match send_credit
		OutboundSendCredit(connection_window, streams) => OutboundSendCredit(connection_window, Cons(OutboundReceiveCreditClosedStream(stream_id), streams))
	end
end

fn add_outbound_reset_stream(send_credit: OutboundSendCredit, stream_id: Int, error_code: Int) -> OutboundSendCredit
	match send_credit
		OutboundSendCredit(connection_window, streams) => OutboundSendCredit(connection_window, Cons(OutboundReceiveCreditResetStream(stream_id, error_code), streams))
	end
end

fn outbound_send_credit_for_closed_by_peer_stream(state: Http2DecodeState) -> OutboundSendCredit
	match state
		State(_, _, _, _, _, _, peer_settings, _, ReceiveFlowControl(_, ClosedByPeerStreamReceiveWindow(stream_id, _)), _) => outbound_send_credit_with_open_stream(65535, stream_id, active_peer_initial_window_size(peer_settings))
		State(_, _, _, _, _, _, _, _, _, _) => outbound_send_credit_without_stream(0)
	end
end

fn outbound_send_credit_from_headers(headers: HpackHeaderList, decision: OutboundHeadersDecision) -> OutboundSendCredit
	match decision
		OutboundHeadersAccepted(stream_id, _, end_stream, receive_credit, _) => match end_stream
			true => outbound_send_credit_with_closed_stream(outbound_receive_connection_window(receive_credit), stream_id)
			false => match hpack_fixture::header_list_accepted_content_length(headers) < 0
				true => outbound_send_credit_with_open_stream(outbound_receive_connection_window(receive_credit), stream_id, outbound_receive_stream_window(receive_credit))
				false => outbound_send_credit_with_content_length(outbound_receive_connection_window(receive_credit), stream_id, outbound_receive_stream_window(receive_credit), hpack_fixture::header_list_accepted_content_length(headers), 0)
			end
		end
		OutboundHeadersRejected(_, _, _, _) => outbound_send_credit_without_stream(0)
		OutboundHeadersEncodeFailed(_, _, _, _) => outbound_send_credit_without_stream(0)
	end
end

fn send_data(stream_id: Int, payload: ByteChunk, end_stream: Bool, peer_settings: PeerSettingsState, send_credit: OutboundSendCredit) -> Result<OutboundDataDecision, String>
	let length: Int = byte_count_to_int(byte_chunk_count(payload))
	let max_frame_size: Int = active_peer_max_frame_size(peer_settings)
	match max_frame_size < 1
		true => Ok(OutboundDataRejected(stream_id, length, end_stream, FrameSizeExceeded(0, length, ReceiveLimit(max_frame_size, LocalConfiguration), 0, stream_id)))
		false => consume_outbound_data_window(stream_id, payload, length, end_stream, max_frame_size, OpenConnection, send_credit)
	end
end

fn send_data_with_shutdown(stream_id: Int, payload: ByteChunk, end_stream: Bool, peer_settings: PeerSettingsState, shutdown_state: ConnectionShutdownState, send_credit: OutboundSendCredit) -> Result<OutboundDataDecision, String>
	let length: Int = byte_count_to_int(byte_chunk_count(payload))
	let max_frame_size: Int = active_peer_max_frame_size(peer_settings)
	consume_outbound_data_window(stream_id, payload, length, end_stream, max_frame_size, shutdown_state, send_credit)
end

fn send_padded_data(stream_id: Int, payload: ByteChunk, padding_length: Int, end_stream: Bool, peer_settings: PeerSettingsState, send_credit: OutboundSendCredit) -> Result<OutboundDataDecision, String>
	let application_length: Int = byte_count_to_int(byte_chunk_count(payload))
	let max_frame_size: Int = active_peer_max_frame_size(peer_settings)
	match padding_length < 0
		true => Ok(OutboundDataRejected(stream_id, application_length, end_stream, InvalidDataPadding(0, stream_id, padding_length, 0, "open-stream", "outbound_data_padding", empty_byte_preview()?)))
		false => match padding_length > 255
			true => Ok(OutboundDataRejected(stream_id, application_length, end_stream, InvalidDataPadding(0, stream_id, padding_length, 255, "open-stream", "outbound_data_padding", empty_byte_preview()?)))
			false => send_nonnegative_padded_data(stream_id, payload, application_length, padding_length, end_stream, max_frame_size, send_credit)
		end
	end
end

fn empty_byte_preview() -> Result<ByteView, String>
	byte_view(byte_chunk([]), byte_offset(0)?, byte_count(0)?)
end

fn frame_header_preview(length: Int, kind: Int, flags: Int, stream_id: Int) -> Result<ByteView, String>
	match encode_frame_header({length: length, kind: kind, flags: flags, stream_id: stream_id})
		Ok(header) => byte_view(header, byte_offset(0)?, byte_count(9)?)
		Err(_) => Err("unexpected frame header encode failure")
	end
end

fn send_nonnegative_padded_data(stream_id: Int, payload: ByteChunk, application_length: Int, padding_length: Int, end_stream: Bool, max_frame_size: Int, send_credit: OutboundSendCredit) -> Result<OutboundDataDecision, String>
	match application_length > 0
		true => match max_frame_size < padding_length + 2
			true => Ok(OutboundDataRejected(stream_id, padding_length + 2, end_stream, FrameSizeExceeded(0, padding_length + 2, ReceiveLimit(max_frame_size, LocalConfiguration), 0, stream_id)))
			false => send_valid_padded_data(stream_id, payload, application_length, padding_length, end_stream, max_frame_size, send_credit)
		end
		false => match max_frame_size < padding_length + 1
			true => Ok(OutboundDataRejected(stream_id, padding_length + 1, end_stream, FrameSizeExceeded(0, padding_length + 1, ReceiveLimit(max_frame_size, LocalConfiguration), 0, stream_id)))
			false => send_valid_padded_data(stream_id, payload, application_length, padding_length, end_stream, max_frame_size, send_credit)
		end
	end
end

fn send_valid_padded_data(stream_id: Int, payload: ByteChunk, application_length: Int, padding_length: Int, end_stream: Bool, max_frame_size: Int, send_credit: OutboundSendCredit) -> Result<OutboundDataDecision, String>
	let max_application_frame_payload: Int = max_padded_application_frame_payload(max_frame_size, padding_length)
	let encoded_length: Int = padded_data_encoded_length(application_length, padding_length, max_application_frame_payload)
	consume_outbound_padded_data_window(stream_id, payload, encoded_length, padding_length, end_stream, max_frame_size, send_credit)
end

fn max_padded_application_frame_payload(max_frame_size: Int, padding_length: Int) -> Int
	max_frame_size - padding_length - 1
end

fn padded_data_encoded_length(application_length: Int, padding_length: Int, max_application_frame_payload: Int) -> Int
	padded_data_encoded_length_remaining(application_length, padding_length, max_application_frame_payload, 0)
end

fn padded_data_encoded_length_remaining(remaining_length: Int, padding_length: Int, max_application_frame_payload: Int, total: Int) -> Int
	match remaining_length > max_application_frame_payload
		true => padded_data_encoded_length_remaining(remaining_length - max_application_frame_payload, padding_length, max_application_frame_payload, total + max_application_frame_payload + padding_length + 1)
		false => total + remaining_length + padding_length + 1
	end
end

fn send_settings_ack() -> Result<ByteChunk, EncodeError>
	encode_frame_header({length: 0, kind: 4, flags: 1, stream_id: 0})
end

fn connection_state(decode_state: Http2DecodeState) -> Http2ConnectionState
	ConnectionState(decode_state, NoOutstandingLocalSettings, NoPendingPeerSettingsAck)
end

fn append_outstanding_settings_batch(batches: List<OutstandingLocalSettingsBatch>, batch: OutstandingLocalSettingsBatch) -> List<OutstandingLocalSettingsBatch>
	match batches
		Nil => Cons(batch, Nil)
		Cons(head, tail) => Cons(head, append_outstanding_settings_batch(tail, batch))
	end
end

fn add_outstanding_settings(outstanding_settings: OutstandingLocalSettings, identifier: Int, count: Int) -> OutstandingLocalSettings
	let batch: OutstandingLocalSettingsBatch = LocalSettingsBatch(identifier, count)
	match outstanding_settings
		NoOutstandingLocalSettings => OutstandingLocalSettings(Cons(batch, Nil))
		OutstandingLocalSettings(batches) => OutstandingLocalSettings(append_outstanding_settings_batch(batches, batch))
	end
end

fn acknowledge_outstanding_settings(outstanding_settings: OutstandingLocalSettings) -> OutstandingLocalSettings
	match outstanding_settings
		NoOutstandingLocalSettings => NoOutstandingLocalSettings
		OutstandingLocalSettings(batches) => match batches
			Nil => NoOutstandingLocalSettings
			Cons(_, Nil) => NoOutstandingLocalSettings
			Cons(_, tail) => OutstandingLocalSettings(tail)
		end
	end
end

fn receive_connection(input: Http2Input, connection: Http2ConnectionState) -> Result<Http2ConnectionStep, String>
	match connection
		ConnectionState(decode_state, outstanding_settings, pending_ack) => update_connection_after_receive(receive(input, decode_state)?, outstanding_settings, pending_ack)
	end
end

fn update_connection_after_receive(step: Http2Step, outstanding_settings: OutstandingLocalSettings, pending_ack: PendingPeerSettingsAck) -> Result<Http2ConnectionStep, String>
	match step
		FrameDecoded(decode_state, offset, length, kind, flags, stream_id, _, _) => match settings_ack_frame(kind, flags)
			true => receive_settings_ack(offset, decode_state, outstanding_settings, pending_ack, step, frame_header_preview(length, kind, flags, stream_id)?)
			false => Ok(ConnectionFrameDecoded(ConnectionState(decode_state, outstanding_settings, peer_settings_ack_after_frame(kind, flags, length, pending_ack)), step))
		end
		Waiting(decode_state) => Ok(ConnectionWaiting(ConnectionState(decode_state, outstanding_settings, pending_ack)))
		Failed(decode_state, failure) => Ok(ConnectionFailed(ConnectionState(decode_state, outstanding_settings, pending_ack), failure))
	end
end

fn peer_settings_ack_after_frame(kind: Int, flags: Int, length: Int, pending_ack: PendingPeerSettingsAck) -> PendingPeerSettingsAck
	match kind == 4 and not settings_ack_set(flags) and length > 0
		true => PendingPeerSettingsAck
		false => pending_ack
	end
end

fn settings_ack_frame(kind: Int, flags: Int) -> Bool
	match kind
		4 => settings_ack_set(flags)
		_ => false
	end
end

fn receive_settings_ack(offset: Int, decode_state: Http2DecodeState, outstanding_settings: OutstandingLocalSettings, pending_ack: PendingPeerSettingsAck, step: Http2Step, preview: ByteView) -> Result<Http2ConnectionStep, String>
	match outstanding_settings
		NoOutstandingLocalSettings => Ok(ConnectionFailed(ConnectionState(decode_state, NoOutstandingLocalSettings, pending_ack), UnexpectedSettingsAck(offset, "connection-control", "rfc9113_settings_ack_requires_outstanding_local_settings", preview)))
		OutstandingLocalSettings(Nil) => Ok(ConnectionFailed(ConnectionState(decode_state, NoOutstandingLocalSettings, pending_ack), UnexpectedSettingsAck(offset, "connection-control", "rfc9113_settings_ack_requires_outstanding_local_settings", preview)))
		OutstandingLocalSettings(_) => Ok(ConnectionFrameDecoded(ConnectionState(decode_state, acknowledge_outstanding_settings(outstanding_settings), pending_ack), step))
	end
end

fn send_pending_settings_ack(connection: Http2ConnectionState) -> Result<OutboundSettingsAckDecision, String>
	match connection
		ConnectionState(decode_state, outstanding_settings, NoPendingPeerSettingsAck) => Ok(OutboundSettingsAckNoPending(connection))
		ConnectionState(decode_state, outstanding_settings, PendingPeerSettingsAck) => match send_settings_ack()
			Ok(header) => Ok(OutboundSettingsAckAccepted(ConnectionState(decode_state, outstanding_settings, NoPendingPeerSettingsAck), header))
			Err(error) => Ok(OutboundSettingsAckEncodeFailed(connection, error))
		end
	end
end

fn send_local_max_frame_size_setting(value: Int, connection: Http2ConnectionState) -> Result<OutboundSettingsDecision, String>
	match validate_local_max_frame_size_setting(0, value)?
		SettingsValueOk => match connection
			ConnectionState(decode_state, outstanding_settings, pending_ack) => encode_local_settings_intent(value, decode_state, outstanding_settings, pending_ack)
		end
		SettingsValueFailed(error) => Ok(OutboundSettingsRejected(error))
	end
end

fn send_local_max_frame_size_and_enable_push_settings(max_frame_size_value: Int, enable_push_value: Int, connection: Http2ConnectionState) -> Result<OutboundSettingsDecision, String>
	let items: List<OutboundLocalSettingsItem> = Cons(OutboundSettingsMaxFrameSize(max_frame_size_value), Cons(OutboundSettingsEnablePush(enable_push_value), Nil))
	send_local_settings_batch(items, connection)
end

fn send_local_settings_batch(items: List<OutboundLocalSettingsItem>, connection: Http2ConnectionState) -> Result<OutboundSettingsDecision, String>
	send_local_settings_batch_for_role(items, ServerEndpoint, connection)
end

fn send_local_settings_batch_for_role(items: List<OutboundLocalSettingsItem>, endpoint_role: Http2EndpointRole, connection: Http2ConnectionState) -> Result<OutboundSettingsDecision, String>
	match validate_local_settings_batch_items_for_role(items, 0, endpoint_role)?
		SettingsValueOk => match connection
			ConnectionState(decode_state, outstanding_settings, pending_ack) => encode_local_settings_batch_intent(items, decode_state, outstanding_settings, pending_ack)
		end
		SettingsValueFailed(error) => Ok(OutboundSettingsRejected(error))
	end
end

fn validate_local_settings_batch_items(items: List<OutboundLocalSettingsItem>, item_offset: Int) -> Result<SettingsRangeDecision, String>
	validate_local_settings_batch_items_for_role(items, item_offset, ServerEndpoint)
end

fn validate_local_settings_batch_items_for_role(items: List<OutboundLocalSettingsItem>, item_offset: Int, endpoint_role: Http2EndpointRole) -> Result<SettingsRangeDecision, String>
	match items
		Nil => Ok(SettingsValueOk)
		Cons(item, tail) => match validate_local_settings_batch_item_for_role(item, item_offset, endpoint_role)?
			SettingsValueOk => validate_local_settings_batch_items_for_role(tail, item_offset + 6, endpoint_role)
			SettingsValueFailed(error) => Ok(SettingsValueFailed(error))
		end
	end
end

fn validate_local_settings_batch_item(item: OutboundLocalSettingsItem, item_offset: Int) -> Result<SettingsRangeDecision, String>
	validate_local_settings_batch_item_for_role(item, item_offset, ServerEndpoint)
end

fn validate_local_settings_batch_item_for_role(item: OutboundLocalSettingsItem, item_offset: Int, endpoint_role: Http2EndpointRole) -> Result<SettingsRangeDecision, String>
	match item
		OutboundSettingsHeaderTableSize(value) => validate_local_u32_setting(item_offset, 1, "SETTINGS_HEADER_TABLE_SIZE", value)
		OutboundSettingsEnablePush(value) => validate_local_enable_push_setting(item_offset, value)
		OutboundSettingsInitialWindowSize(value) => validate_local_initial_window_size_setting(item_offset, value)
		OutboundSettingsMaxConcurrentStreams(value) => validate_local_u32_setting(item_offset, 3, "SETTINGS_MAX_CONCURRENT_STREAMS", value)
		OutboundSettingsMaxFrameSize(value) => validate_local_max_frame_size_setting(item_offset, value)
		OutboundSettingsMaxHeaderListSize(value) => validate_local_u32_setting(item_offset, 6, "SETTINGS_MAX_HEADER_LIST_SIZE", value)
		OutboundSettingsEnableConnectProtocol(value) => match endpoint_role
			ServerEndpoint => validate_enable_connect_protocol_setting(item_offset, value, empty_byte_preview()?, "local_settings")
			ClientEndpoint => Ok(SettingsValueFailed(SettingsNotAllowedForEndpoint(item_offset, 8, "SETTINGS_ENABLE_CONNECT_PROTOCOL", "client", 4, "local-settings", "rfc8441_only_servers_send_settings_enable_connect_protocol", empty_byte_preview()?)))
		end
	end
end

fn encode_local_settings_batch_intent(items: List<OutboundLocalSettingsItem>, decode_state: Http2DecodeState, outstanding_settings: OutstandingLocalSettings, pending_ack: PendingPeerSettingsAck) -> Result<OutboundSettingsDecision, String>
	let payload: ByteChunk = encode_local_settings_batch_payload(items)?
	let item_count: Int = local_settings_batch_item_count(items)
	let encoded_header: Result<ByteChunk, EncodeError> = encode_frame_header({length: 6 * item_count, kind: 4, flags: 0, stream_id: 0})
	match encoded_header
		Ok(header) => Ok(OutboundSettingsAccepted(local_settings_batch_first_identifier(items), local_settings_batch_first_value(items), ConnectionState(apply_local_settings_batch_to_state(items, 0, decode_state), add_outstanding_settings(outstanding_settings, local_settings_batch_first_identifier(items), item_count), pending_ack), byte_append(header, payload)))
		Err(error) => Ok(OutboundSettingsEncodeFailed(error))
	end
end

fn encode_local_settings_batch_payload(items: List<OutboundLocalSettingsItem>) -> Result<ByteChunk, String>
	match items
		Nil => Ok(byte_chunk([]))
		Cons(item, tail) => Ok(byte_append(encode_local_settings_batch_item(item)?, encode_local_settings_batch_payload(tail)?))
	end
end

fn encode_local_settings_batch_item(item: OutboundLocalSettingsItem) -> Result<ByteChunk, String>
	Ok(byte_append(byte_write_u16_be(local_settings_item_identifier(item))?, byte_write_u32_be(local_settings_item_value(item))?))
end

fn apply_local_settings_batch_to_state(items: List<OutboundLocalSettingsItem>, item_offset: Int, decode_state: Http2DecodeState) -> Http2DecodeState
	match items
		Nil => decode_state
		Cons(item, tail) => apply_local_settings_batch_to_state(tail, item_offset + 6, apply_local_settings_item_to_state(item, item_offset, decode_state))
	end
end

fn apply_local_settings_item_to_state(item: OutboundLocalSettingsItem, item_offset: Int, decode_state: Http2DecodeState) -> Http2DecodeState
	match item
		OutboundSettingsEnablePush(value) => update_local_enable_push_state(decode_state, value, item_offset)
		OutboundSettingsEnableConnectProtocol(value) => update_local_enable_connect_protocol_state(decode_state, value, item_offset)
		_ => decode_state
	end
end

fn local_settings_batch_item_count(items: List<OutboundLocalSettingsItem>) -> Int
	match items
		Nil => 0
		Cons(_, tail) => 1 + local_settings_batch_item_count(tail)
	end
end

fn local_settings_batch_first_identifier(items: List<OutboundLocalSettingsItem>) -> Int
	match items
		Nil => 0
		Cons(item, _) => local_settings_item_identifier(item)
	end
end

fn local_settings_batch_first_value(items: List<OutboundLocalSettingsItem>) -> Int
	match items
		Nil => 0
		Cons(item, _) => local_settings_item_value(item)
	end
end

fn local_settings_item_identifier(item: OutboundLocalSettingsItem) -> Int
	match item
		OutboundSettingsHeaderTableSize(_) => 1
		OutboundSettingsEnablePush(_) => 2
		OutboundSettingsInitialWindowSize(_) => 4
		OutboundSettingsMaxConcurrentStreams(_) => 3
		OutboundSettingsMaxFrameSize(_) => 5
		OutboundSettingsMaxHeaderListSize(_) => 6
		OutboundSettingsEnableConnectProtocol(_) => 8
	end
end

fn local_settings_item_value(item: OutboundLocalSettingsItem) -> Int
	match item
		OutboundSettingsHeaderTableSize(value) => value
		OutboundSettingsEnablePush(value) => value
		OutboundSettingsInitialWindowSize(value) => value
		OutboundSettingsMaxConcurrentStreams(value) => value
		OutboundSettingsMaxFrameSize(value) => value
		OutboundSettingsMaxHeaderListSize(value) => value
		OutboundSettingsEnableConnectProtocol(value) => value
	end
end

fn update_local_enable_connect_protocol_state(state: Http2DecodeState, value: Int, item_offset: Int) -> Http2DecodeState
	match state
		State(pending, next_offset, preface_state, continuation, hpack_state, receive_limit, peer_settings, shutdown_state, receive_flow_control, peer_stream_admission) => State(pending, next_offset, preface_state, continuation, hpack_state, receive_limit, with_local_enable_connect_protocol(peer_settings, value, item_offset), shutdown_state, receive_flow_control, peer_stream_admission)
	end
end

fn send_local_enable_connect_protocol_setting(value: Int, endpoint_role: Http2EndpointRole, connection: Http2ConnectionState) -> Result<OutboundSettingsDecision, String>
	let items: List<OutboundLocalSettingsItem> = Cons(OutboundSettingsEnableConnectProtocol(value), Nil)
	send_local_settings_batch_for_role(items, endpoint_role, connection)
end

fn encode_local_settings_intent(value: Int, decode_state: Http2DecodeState, outstanding_settings: OutstandingLocalSettings, pending_ack: PendingPeerSettingsAck) -> Result<OutboundSettingsDecision, String>
	let payload: ByteChunk = byte_append(byte_write_u16_be(5)?, byte_write_u32_be(value)?)
	let encoded_header: Result<ByteChunk, EncodeError> = encode_frame_header({length: 6, kind: 4, flags: 0, stream_id: 0})
	match encoded_header
		Ok(header) => Ok(OutboundSettingsAccepted(5, value, ConnectionState(decode_state, add_outstanding_settings(outstanding_settings, 5, 1), pending_ack), byte_append(header, payload)))
		Err(error) => Ok(OutboundSettingsEncodeFailed(error))
	end
end

fn send_local_initial_window_size_setting(value: Int, connection: Http2ConnectionState) -> Result<OutboundSettingsDecision, String>
	match validate_local_initial_window_size_setting(0, value)?
		SettingsValueOk => match connection
			ConnectionState(decode_state, outstanding_settings, pending_ack) => encode_local_initial_window_size_intent(value, decode_state, outstanding_settings, pending_ack)
		end
		SettingsValueFailed(error) => Ok(OutboundSettingsRejected(error))
	end
end

fn encode_local_initial_window_size_intent(value: Int, decode_state: Http2DecodeState, outstanding_settings: OutstandingLocalSettings, pending_ack: PendingPeerSettingsAck) -> Result<OutboundSettingsDecision, String>
	let payload: ByteChunk = byte_append(byte_write_u16_be(4)?, byte_write_u32_be(value)?)
	let encoded_header: Result<ByteChunk, EncodeError> = encode_frame_header({length: 6, kind: 4, flags: 0, stream_id: 0})
	match encoded_header
		Ok(header) => Ok(OutboundSettingsAccepted(4, value, ConnectionState(decode_state, add_outstanding_settings(outstanding_settings, 4, 1), pending_ack), byte_append(header, payload)))
		Err(error) => Ok(OutboundSettingsEncodeFailed(error))
	end
end

fn send_local_max_concurrent_streams_setting(value: Int, connection: Http2ConnectionState) -> Result<OutboundSettingsDecision, String>
	match validate_local_u32_setting(0, 3, "SETTINGS_MAX_CONCURRENT_STREAMS", value)?
		SettingsValueOk => match connection
			ConnectionState(decode_state, outstanding_settings, pending_ack) => encode_local_max_concurrent_streams_intent(value, decode_state, outstanding_settings, pending_ack)
		end
		SettingsValueFailed(error) => Ok(OutboundSettingsRejected(error))
	end
end

fn encode_local_max_concurrent_streams_intent(value: Int, decode_state: Http2DecodeState, outstanding_settings: OutstandingLocalSettings, pending_ack: PendingPeerSettingsAck) -> Result<OutboundSettingsDecision, String>
	let payload: ByteChunk = byte_append(byte_write_u16_be(3)?, byte_write_u32_be(value)?)
	let encoded_header: Result<ByteChunk, EncodeError> = encode_frame_header({length: 6, kind: 4, flags: 0, stream_id: 0})
	match encoded_header
		Ok(header) => Ok(OutboundSettingsAccepted(3, value, ConnectionState(decode_state, add_outstanding_settings(outstanding_settings, 3, 1), pending_ack), byte_append(header, payload)))
		Err(error) => Ok(OutboundSettingsEncodeFailed(error))
	end
end

fn send_local_enable_push_setting(value: Int, connection: Http2ConnectionState) -> Result<OutboundSettingsDecision, String>
	match validate_local_enable_push_setting(0, value)?
		SettingsValueOk => match connection
			ConnectionState(decode_state, outstanding_settings, pending_ack) => encode_local_enable_push_intent(value, decode_state, outstanding_settings, pending_ack)
		end
		SettingsValueFailed(error) => Ok(OutboundSettingsRejected(error))
	end
end

fn validate_local_max_frame_size_setting(offset: Int, value: Int) -> Result<SettingsRangeDecision, String>
	match value < 16384
		true => Ok(SettingsValueFailed(SettingsValueOutOfRange(offset, 5, "SETTINGS_MAX_FRAME_SIZE", value, 16384, 16777215, "local_settings", empty_byte_preview()?)))
		false => match value > 16777215
			true => Ok(SettingsValueFailed(SettingsValueOutOfRange(offset, 5, "SETTINGS_MAX_FRAME_SIZE", value, 16384, 16777215, "local_settings", empty_byte_preview()?)))
			false => Ok(SettingsValueOk)
		end
	end
end

fn validate_local_initial_window_size_setting(offset: Int, value: Int) -> Result<SettingsRangeDecision, String>
	match value < 0
		true => Ok(SettingsValueFailed(SettingsValueOutOfRange(offset, 4, "SETTINGS_INITIAL_WINDOW_SIZE", value, 0, 2147483647, "local_settings", empty_byte_preview()?)))
		false => match value > 2147483647
			true => Ok(SettingsValueFailed(SettingsValueOutOfRange(offset, 4, "SETTINGS_INITIAL_WINDOW_SIZE", value, 0, 2147483647, "local_settings", empty_byte_preview()?)))
			false => Ok(SettingsValueOk)
		end
	end
end

fn validate_local_enable_push_setting(offset: Int, value: Int) -> Result<SettingsRangeDecision, String>
	match value < 0
		true => Ok(SettingsValueFailed(SettingsValueOutOfRange(offset, 2, "SETTINGS_ENABLE_PUSH", value, 0, 1, "local_settings", empty_byte_preview()?)))
		false => match value > 1
			true => Ok(SettingsValueFailed(SettingsValueOutOfRange(offset, 2, "SETTINGS_ENABLE_PUSH", value, 0, 1, "local_settings", empty_byte_preview()?)))
			false => Ok(SettingsValueOk)
		end
	end
end

fn validate_local_u32_setting(offset: Int, identifier: Int, setting_name: String, value: Int) -> Result<SettingsRangeDecision, String>
	match value < 0
		true => Ok(SettingsValueFailed(SettingsValueOutOfRange(offset, identifier, setting_name, value, 0, 4294967295, "local_settings", empty_byte_preview()?)))
		false => match value > 4294967295
			true => Ok(SettingsValueFailed(SettingsValueOutOfRange(offset, identifier, setting_name, value, 0, 4294967295, "local_settings", empty_byte_preview()?)))
			false => Ok(SettingsValueOk)
		end
	end
end

fn encode_local_enable_push_intent(value: Int, decode_state: Http2DecodeState, outstanding_settings: OutstandingLocalSettings, pending_ack: PendingPeerSettingsAck) -> Result<OutboundSettingsDecision, String>
	let payload: ByteChunk = byte_append(byte_write_u16_be(2)?, byte_write_u32_be(value)?)
	let encoded_header: Result<ByteChunk, EncodeError> = encode_frame_header({length: 6, kind: 4, flags: 0, stream_id: 0})
	match encoded_header
		Ok(header) => Ok(OutboundSettingsAccepted(2, value, ConnectionState(update_local_enable_push_state(decode_state, value, 0), add_outstanding_settings(outstanding_settings, 2, 1), pending_ack), byte_append(header, payload)))
		Err(error) => Ok(OutboundSettingsEncodeFailed(error))
	end
end

fn send_local_header_table_size_setting(value: Int, connection: Http2ConnectionState) -> Result<OutboundSettingsDecision, String>
	match validate_local_u32_setting(0, 1, "SETTINGS_HEADER_TABLE_SIZE", value)?
		SettingsValueOk => match connection
			ConnectionState(decode_state, outstanding_settings, pending_ack) => encode_local_header_table_size_intent(value, decode_state, outstanding_settings, pending_ack)
		end
		SettingsValueFailed(error) => Ok(OutboundSettingsRejected(error))
	end
end

fn encode_local_header_table_size_intent(value: Int, decode_state: Http2DecodeState, outstanding_settings: OutstandingLocalSettings, pending_ack: PendingPeerSettingsAck) -> Result<OutboundSettingsDecision, String>
	let payload: ByteChunk = byte_append(byte_write_u16_be(1)?, byte_write_u32_be(value)?)
	let encoded_header: Result<ByteChunk, EncodeError> = encode_frame_header({length: 6, kind: 4, flags: 0, stream_id: 0})
	match encoded_header
		Ok(header) => Ok(OutboundSettingsAccepted(1, value, ConnectionState(decode_state, add_outstanding_settings(outstanding_settings, 1, 1), pending_ack), byte_append(header, payload)))
		Err(error) => Ok(OutboundSettingsEncodeFailed(error))
	end
end

fn send_local_max_header_list_size_setting(value: Int, connection: Http2ConnectionState) -> Result<OutboundSettingsDecision, String>
	match validate_local_u32_setting(0, 6, "SETTINGS_MAX_HEADER_LIST_SIZE", value)?
		SettingsValueOk => match connection
			ConnectionState(decode_state, outstanding_settings, pending_ack) => encode_local_max_header_list_size_intent(value, decode_state, outstanding_settings, pending_ack)
		end
		SettingsValueFailed(error) => Ok(OutboundSettingsRejected(error))
	end
end

fn encode_local_max_header_list_size_intent(value: Int, decode_state: Http2DecodeState, outstanding_settings: OutstandingLocalSettings, pending_ack: PendingPeerSettingsAck) -> Result<OutboundSettingsDecision, String>
	let payload: ByteChunk = byte_append(byte_write_u16_be(6)?, byte_write_u32_be(value)?)
	let encoded_header: Result<ByteChunk, EncodeError> = encode_frame_header({length: 6, kind: 4, flags: 0, stream_id: 0})
	match encoded_header
		Ok(header) => Ok(OutboundSettingsAccepted(6, value, ConnectionState(decode_state, add_outstanding_settings(outstanding_settings, 6, 1), pending_ack), byte_append(header, payload)))
		Err(error) => Ok(OutboundSettingsEncodeFailed(error))
	end
end

fn send_ping_ack_for_received(step: Http2Step) -> Result<OutboundPingAckDecision, String>
	match step
		FrameDecoded(_, _, _, kind, flags, _, _, frame) => match kind == 6
			true => match ping_ack_set(flags)
				true => Ok(OutboundPingAckNoResponse)
				false => encode_ping_ack_intent(frame)
			end
			false => Ok(OutboundPingAckNoResponse)
		end
		Waiting(_) => Ok(OutboundPingAckNoResponse)
		Failed(_, _) => Ok(OutboundPingAckNoResponse)
	end
end

fn encode_ping_ack_intent(frame: Http2Frame) -> Result<OutboundPingAckDecision, String>
	match frame
		KnownFrame(_, _, _, payload) => encode_ping_ack_payload(byte_view_to_chunk(payload))
		PriorityFrame(_, _, _, _, _) => Ok(OutboundPingAckNoResponse)
		UnknownFrame(_, _, _, _) => Ok(OutboundPingAckNoResponse)
	end
end

fn encode_ping_ack_payload(payload: ByteChunk) -> Result<OutboundPingAckDecision, String>
	let encoded_header: Result<ByteChunk, EncodeError> = encode_frame_header({length: 8, kind: 6, flags: 1, stream_id: 0})
	match encoded_header
		Ok(header) => Ok(OutboundPingAckAccepted(byte_append(header, payload)))
		Err(error) => Ok(OutboundPingAckEncodeFailed(error))
	end
end

fn send_ping(payload: ByteChunk) -> Result<OutboundPingDecision, String>
	let payload_length: Int = byte_count_to_int(byte_chunk_count(payload))
	match payload_length == 8
		true => encode_ping_intent(payload, payload_length)
		false => Ok(OutboundPingRejected(payload_length, InvalidPayloadLength(0, 6, 0, payload_length, 8, "connection-control", "outbound_ping_payload_length", byte_view(payload, byte_offset(0)?, byte_count(payload_length)?)?)))
	end
end

fn encode_ping_intent(payload: ByteChunk, payload_length: Int) -> Result<OutboundPingDecision, String>
	let encoded_header: Result<ByteChunk, EncodeError> = encode_frame_header({length: 8, kind: 6, flags: 0, stream_id: 0})
	match encoded_header
		Ok(header) => Ok(OutboundPingAccepted(payload_length, byte_append(header, payload)))
		Err(error) => Ok(OutboundPingEncodeFailed(payload_length, error))
	end
end

fn send_goaway(last_stream_id: Int, error_code: Int, state: Http2DecodeState) -> Result<OutboundGoawayDecision, String>
	let encoded_payload: Result<ByteChunk, EncodeError> = encode_goaway_payload({last_stream_id: last_stream_id, error_code: error_code})
	match encoded_payload
		Ok(payload) => validate_goaway_send_boundary(last_stream_id, error_code, state, payload)
		Err(error) => Ok(OutboundGoawayEncodeFailed(last_stream_id, error_code, error))
	end
end

fn validate_goaway_send_boundary(last_stream_id: Int, error_code: Int, state: Http2DecodeState, payload: ByteChunk) -> Result<OutboundGoawayDecision, String>
	match state_shutdown_state_value(state)
		OpenConnection => encode_goaway_intent(last_stream_id, error_code, state, payload)
		GracefulShutdown(current_last_stream_id, _) => match last_stream_id > current_last_stream_id
			true => Ok(OutboundGoawayRejected(last_stream_id, error_code, StreamAfterGoaway(0, last_stream_id, current_last_stream_id, "graceful_shutdown", "local", "goaway_last_stream_id", empty_header_block())))
			false => encode_goaway_intent(last_stream_id, error_code, state, payload)
		end
		DrainedShutdown(current_last_stream_id, _) => match last_stream_id > current_last_stream_id
			true => Ok(OutboundGoawayRejected(last_stream_id, error_code, StreamAfterGoaway(0, last_stream_id, current_last_stream_id, "drained_shutdown", "local", "goaway_last_stream_id", empty_header_block())))
			false => encode_goaway_intent(last_stream_id, error_code, state, payload)
		end
	end
end

fn encode_goaway_intent(last_stream_id: Int, error_code: Int, state: Http2DecodeState, payload: ByteChunk) -> Result<OutboundGoawayDecision, String>
	let encoded_header: Result<ByteChunk, EncodeError> = encode_frame_header({length: 8, kind: 7, flags: 0, stream_id: 0})
	match encoded_header
		Ok(header) => Ok(OutboundGoawayAccepted(last_stream_id, error_code, goaway_sent_state(last_stream_id, error_code, state), byte_append(header, payload)))
		Err(error) => Ok(OutboundGoawayEncodeFailed(last_stream_id, error_code, error))
	end
end

fn goaway_sent_state(last_stream_id: Int, error_code: Int, state: Http2DecodeState) -> Http2DecodeState
	match state
		State(pending, next_offset, preface_state, continuation, hpack_state, receive_limit, peer_settings, _, receive_flow_control, peer_stream_admission) => State(pending, next_offset, preface_state, continuation, hpack_state, receive_limit, peer_settings, complete_shutdown_drain(GracefulShutdown(last_stream_id, error_code), receive_flow_control), receive_flow_control, peer_stream_admission)
	end
end

fn send_rst_stream(stream_id: Int, error_code: Int, receive_credit: OutboundReceiveCredit) -> Result<OutboundRstStreamDecision, String>
	match stream_id
		0 => Ok(OutboundRstStreamRejected(stream_id, error_code, InvalidStreamId(0, 3, stream_id, "nonzero open stream id", "local", "stream-id-domain", "outbound_rst_stream_requires_open_stream")))
		_ => send_nonzero_rst_stream(stream_id, error_code, receive_credit)
	end
end

fn send_nonzero_rst_stream(stream_id: Int, error_code: Int, receive_credit: OutboundReceiveCredit) -> Result<OutboundRstStreamDecision, String>
	match receive_credit
		OutboundReceiveCredit(connection_window, NoOutboundReceiveCreditStream) => Ok(OutboundRstStreamRejected(stream_id, error_code, InvalidFrameKind(0, 3, stream_id, 1, "idle-stream", "idle_streams_require_headers")))
		OutboundReceiveCredit(connection_window, OutboundReceiveCreditOpenStream(open_stream_id, _)) => match stream_id == open_stream_id
			true => encode_rst_stream_intent(stream_id, error_code, connection_window)
			false => Ok(OutboundRstStreamRejected(stream_id, error_code, InvalidFrameKind(0, 3, stream_id, 1, "idle-stream", "idle_streams_require_headers")))
		end
		OutboundReceiveCredit(connection_window, OutboundReceiveCreditOpenStreamContentLength(open_stream_id, _, _, _)) => match stream_id == open_stream_id
			true => encode_rst_stream_intent(stream_id, error_code, connection_window)
			false => Ok(OutboundRstStreamRejected(stream_id, error_code, InvalidFrameKind(0, 3, stream_id, 1, "idle-stream", "idle_streams_require_headers")))
		end
		OutboundReceiveCredit(connection_window, OutboundReceiveCreditClosedStream(closed_stream_id)) => match stream_id == closed_stream_id
			true => Ok(OutboundRstStreamRejected(stream_id, error_code, InvalidFrameKind(0, 3, stream_id, 1, "closed-stream", "closed_stream_rejects_later_frames")))
			false => Ok(OutboundRstStreamRejected(stream_id, error_code, InvalidFrameKind(0, 3, stream_id, 1, "idle-stream", "idle_streams_require_headers")))
		end
		OutboundReceiveCredit(connection_window, OutboundReceiveCreditResetStream(reset_stream_id, _)) => match stream_id == reset_stream_id
			true => Ok(OutboundRstStreamRejected(stream_id, error_code, InvalidFrameKind(0, 3, stream_id, 1, "reset-stream", "reset_stream_rejects_later_frames")))
			false => Ok(OutboundRstStreamRejected(stream_id, error_code, InvalidFrameKind(0, 3, stream_id, 1, "idle-stream", "idle_streams_require_headers")))
		end
	end
end

fn encode_rst_stream_intent(stream_id: Int, error_code: Int, connection_window: Int) -> Result<OutboundRstStreamDecision, String>
	let encoded_header: Result<ByteChunk, EncodeError> = encode_frame_header({length: 4, kind: 3, flags: 0, stream_id: stream_id})
	match encoded_header
		Ok(header) => encode_rst_stream_payload_intent(stream_id, error_code, connection_window, header)
		Err(error) => Ok(OutboundRstStreamEncodeFailed(stream_id, error_code, error))
	end
end

fn encode_rst_stream_payload_intent(stream_id: Int, error_code: Int, connection_window: Int, header: ByteChunk) -> Result<OutboundRstStreamDecision, String>
	let encoded_payload: Result<ByteChunk, EncodeError> = encode_rst_stream_payload({error_code: error_code})
	match encoded_payload
		Ok(payload) => Ok(OutboundRstStreamAccepted(stream_id, error_code, OutboundReceiveCredit(connection_window, OutboundReceiveCreditResetStream(stream_id, error_code)), byte_append(header, payload)))
		Err(error) => Ok(OutboundRstStreamEncodeFailed(stream_id, error_code, error))
	end
end

fn send_priority(stream_id: Int, dependency_stream_id: Int, exclusive: Bool, weight: Int, receive_credit: OutboundReceiveCredit) -> Result<OutboundPriorityDecision, String>
	send_priority_with_shutdown(stream_id, dependency_stream_id, exclusive, weight, OpenConnection, receive_credit)
end

fn send_priority_with_shutdown(stream_id: Int, dependency_stream_id: Int, exclusive: Bool, weight: Int, shutdown_state: ConnectionShutdownState, receive_credit: OutboundReceiveCredit) -> Result<OutboundPriorityDecision, String>
	match stream_id
		0 => Ok(OutboundPriorityRejected(stream_id, dependency_stream_id, exclusive, weight, InvalidStreamId(0, 2, stream_id, "nonzero open stream id", "local", "stream-id-domain", "outbound_priority_requires_open_stream")))
		_ => send_nonzero_priority(stream_id, dependency_stream_id, exclusive, weight, shutdown_state, receive_credit)
	end
end

fn send_nonzero_priority(stream_id: Int, dependency_stream_id: Int, exclusive: Bool, weight: Int, shutdown_state: ConnectionShutdownState, receive_credit: OutboundReceiveCredit) -> Result<OutboundPriorityDecision, String>
	match receive_credit
		OutboundReceiveCredit(connection_window, NoOutboundReceiveCreditStream) => Ok(OutboundPriorityRejected(stream_id, dependency_stream_id, exclusive, weight, InvalidFrameKind(0, 2, stream_id, 1, "idle-stream", "idle_streams_require_headers")))
		OutboundReceiveCredit(connection_window, OutboundReceiveCreditOpenStream(open_stream_id, stream_window)) => match stream_id == open_stream_id
			true => validate_outbound_priority_dependency(stream_id, dependency_stream_id, exclusive, weight, shutdown_state, connection_window, stream_window)
			false => Ok(OutboundPriorityRejected(stream_id, dependency_stream_id, exclusive, weight, InvalidFrameKind(0, 2, stream_id, 1, "idle-stream", "idle_streams_require_headers")))
		end
		OutboundReceiveCredit(connection_window, OutboundReceiveCreditOpenStreamContentLength(open_stream_id, stream_window, _, _)) => match stream_id == open_stream_id
			true => validate_outbound_priority_dependency(stream_id, dependency_stream_id, exclusive, weight, shutdown_state, connection_window, stream_window)
			false => Ok(OutboundPriorityRejected(stream_id, dependency_stream_id, exclusive, weight, InvalidFrameKind(0, 2, stream_id, 1, "idle-stream", "idle_streams_require_headers")))
		end
		OutboundReceiveCredit(connection_window, OutboundReceiveCreditClosedStream(closed_stream_id)) => match stream_id == closed_stream_id
			true => Ok(OutboundPriorityRejected(stream_id, dependency_stream_id, exclusive, weight, InvalidFrameKind(0, 2, stream_id, 1, "closed-stream", "closed_stream_rejects_later_frames")))
			false => Ok(OutboundPriorityRejected(stream_id, dependency_stream_id, exclusive, weight, InvalidFrameKind(0, 2, stream_id, 1, "idle-stream", "idle_streams_require_headers")))
		end
		OutboundReceiveCredit(connection_window, OutboundReceiveCreditResetStream(reset_stream_id, _)) => match stream_id == reset_stream_id
			true => Ok(OutboundPriorityRejected(stream_id, dependency_stream_id, exclusive, weight, InvalidFrameKind(0, 2, stream_id, 1, "reset-stream", "reset_stream_rejects_later_frames")))
			false => Ok(OutboundPriorityRejected(stream_id, dependency_stream_id, exclusive, weight, InvalidFrameKind(0, 2, stream_id, 1, "idle-stream", "idle_streams_require_headers")))
		end
	end
end

fn validate_outbound_priority_dependency(stream_id: Int, dependency_stream_id: Int, exclusive: Bool, weight: Int, shutdown_state: ConnectionShutdownState, connection_window: Int, stream_window: Int) -> Result<OutboundPriorityDecision, String>
	match stream_id == dependency_stream_id
		true => Ok(OutboundPriorityRejected(stream_id, dependency_stream_id, exclusive, weight, InvalidPriorityDependency(0, stream_id, dependency_stream_id, "stream-control", "rfc9113_priority_dependency", empty_byte_preview()?)))
		false => validate_outbound_priority_after_goaway(stream_id, dependency_stream_id, exclusive, weight, shutdown_state, connection_window, stream_window)
	end
end

fn validate_outbound_priority_after_goaway(stream_id: Int, dependency_stream_id: Int, exclusive: Bool, weight: Int, shutdown_state: ConnectionShutdownState, connection_window: Int, stream_window: Int) -> Result<OutboundPriorityDecision, String>
	match shutdown_state
		OpenConnection => encode_priority_intent(stream_id, dependency_stream_id, exclusive, weight, connection_window, stream_window)
		GracefulShutdown(last_stream_id, _) => match stream_id > last_stream_id
			true => Ok(OutboundPriorityRejected(stream_id, dependency_stream_id, exclusive, weight, StreamAfterGoaway(0, stream_id, last_stream_id, "graceful_shutdown", "local", "goaway_last_stream_id", empty_header_block())))
			false => encode_priority_intent(stream_id, dependency_stream_id, exclusive, weight, connection_window, stream_window)
		end
		DrainedShutdown(last_stream_id, _) => match stream_id > last_stream_id
			true => Ok(OutboundPriorityRejected(stream_id, dependency_stream_id, exclusive, weight, StreamAfterGoaway(0, stream_id, last_stream_id, "drained_shutdown", "local", "goaway_last_stream_id", empty_header_block())))
			false => encode_priority_intent(stream_id, dependency_stream_id, exclusive, weight, connection_window, stream_window)
		end
	end
end

fn encode_priority_intent(stream_id: Int, dependency_stream_id: Int, exclusive: Bool, weight: Int, connection_window: Int, stream_window: Int) -> Result<OutboundPriorityDecision, String>
	let encoded_header: Result<ByteChunk, EncodeError> = encode_frame_header({length: 5, kind: 2, flags: 0, stream_id: stream_id})
	match encoded_header
		Ok(header) => encode_priority_payload_intent(stream_id, dependency_stream_id, exclusive, weight, connection_window, stream_window, header)
		Err(error) => Ok(OutboundPriorityEncodeFailed(stream_id, dependency_stream_id, exclusive, weight, error))
	end
end

fn encode_priority_payload_intent(stream_id: Int, dependency_stream_id: Int, exclusive: Bool, weight: Int, connection_window: Int, stream_window: Int, header: ByteChunk) -> Result<OutboundPriorityDecision, String>
	let encoded_dependency: Result<ByteChunk, EncodeError> = encode_priority_dependency_payload({dependency_stream_id: dependency_stream_id})
	match encoded_dependency
		Ok(dependency_payload) => encode_priority_weight_payload_intent(stream_id, dependency_stream_id, exclusive, weight, connection_window, stream_window, header, dependency_payload)
		Err(error) => Ok(OutboundPriorityEncodeFailed(stream_id, dependency_stream_id, exclusive, weight, error))
	end
end

fn encode_priority_weight_payload_intent(stream_id: Int, dependency_stream_id: Int, exclusive: Bool, weight: Int, connection_window: Int, stream_window: Int, header: ByteChunk, dependency_payload: ByteChunk) -> Result<OutboundPriorityDecision, String>
	let encoded_weight: Result<ByteChunk, EncodeError> = encode_priority_weight_payload({weight: weight - 1})
	match encoded_weight
		Ok(weight_payload) => Ok(OutboundPriorityAccepted(stream_id, dependency_stream_id, exclusive, weight, OutboundReceiveCredit(connection_window, OutboundReceiveCreditOpenStream(stream_id, stream_window)), byte_append(header, byte_append(priority_dependency_payload_with_exclusive(dependency_payload, exclusive)?, weight_payload))))
		Err(error) => Ok(OutboundPriorityEncodeFailed(stream_id, dependency_stream_id, exclusive, weight, error))
	end
end

fn priority_dependency_payload_with_exclusive(payload: ByteChunk, exclusive: Bool) -> Result<ByteChunk, String>
	let first: Int = read_byte(payload, 0)?
	let encoded_first: Int = first + exclusive_bit_value(exclusive)
	let second: Int = read_byte(payload, 1)?
	let third: Int = read_byte(payload, 2)?
	let fourth: Int = read_byte(payload, 3)?
	Ok(byte_append(byte_append(byte_append(byte_write_u8_be(encoded_first)?, byte_write_u8_be(second)?), byte_write_u8_be(third)?), byte_write_u8_be(fourth)?))
end

fn exclusive_bit_value(exclusive: Bool) -> Int
	match exclusive
		true => 128
		false => 0
	end
end

fn initial_outbound_headers_connection_state(endpoint_role: Http2EndpointRole, peer_settings: PeerSettingsState, shutdown_state: ConnectionShutdownState, receive_credit: OutboundReceiveCredit) -> OutboundHeadersConnectionState
	OutboundHeadersConnectionState(endpoint_role, 0, NoOutboundLocalStream, peer_settings, shutdown_state, receive_credit, hpack_fixture::initial_encode_state())
end

fn outbound_headers_connection_role(state: OutboundHeadersConnectionState) -> Http2EndpointRole
	match state
		OutboundHeadersConnectionState(endpoint_role, _, _, _, _, _, _) => endpoint_role
	end
end

fn outbound_headers_connection_high_water(state: OutboundHeadersConnectionState) -> Int
	match state
		OutboundHeadersConnectionState(_, high_water, _, _, _, _, _) => high_water
	end
end

fn outbound_headers_connection_lifecycle(state: OutboundHeadersConnectionState) -> OutboundLocalStreamState
	match state
		OutboundHeadersConnectionState(_, _, lifecycle, _, _, _, _) => lifecycle
	end
end

fn outbound_headers_connection_peer_settings(state: OutboundHeadersConnectionState) -> PeerSettingsState
	match state
		OutboundHeadersConnectionState(_, _, _, peer_settings, _, _, _) => peer_settings
	end
end

fn outbound_headers_connection_shutdown(state: OutboundHeadersConnectionState) -> ConnectionShutdownState
	match state
		OutboundHeadersConnectionState(_, _, _, _, shutdown_state, _, _) => shutdown_state
	end
end

fn outbound_headers_connection_shutdown_last_stream(state: OutboundHeadersConnectionState) -> Int
	match outbound_headers_connection_shutdown(state)
		OpenConnection => 0
		GracefulShutdown(last_stream_id, _) => last_stream_id
		DrainedShutdown(last_stream_id, _) => last_stream_id
	end
end

fn outbound_headers_connection_shutdown_error(state: OutboundHeadersConnectionState) -> Int
	match outbound_headers_connection_shutdown(state)
		OpenConnection => 0
		GracefulShutdown(_, error_code) => error_code
		DrainedShutdown(_, error_code) => error_code
	end
end

fn outbound_headers_connection_receive_credit(state: OutboundHeadersConnectionState) -> OutboundReceiveCredit
	match state
		OutboundHeadersConnectionState(_, _, _, _, _, receive_credit, _) => receive_credit
	end
end

fn outbound_headers_connection_hpack(state: OutboundHeadersConnectionState) -> HpackFixtureState
	match state
		OutboundHeadersConnectionState(_, _, _, _, _, _, hpack_state) => hpack_state
	end
end

fn with_outbound_headers_connection_lifecycle(state: OutboundHeadersConnectionState, lifecycle: OutboundLocalStreamState, receive_credit: OutboundReceiveCredit) -> OutboundHeadersConnectionState
	match state
		OutboundHeadersConnectionState(endpoint_role, high_water, _, peer_settings, shutdown_state, _, hpack_state) => OutboundHeadersConnectionState(endpoint_role, high_water, lifecycle, peer_settings, shutdown_state, receive_credit, hpack_state)
	end
end

fn with_outbound_headers_connection_peer_settings(state: OutboundHeadersConnectionState, peer_settings: PeerSettingsState) -> OutboundHeadersConnectionState
	match state
		OutboundHeadersConnectionState(endpoint_role, high_water, lifecycle, _, shutdown_state, receive_credit, hpack_state) => OutboundHeadersConnectionState(endpoint_role, high_water, lifecycle, peer_settings, shutdown_state, receive_credit, hpack_state)
	end
end

fn with_outbound_headers_connection_shutdown(state: OutboundHeadersConnectionState, shutdown_state: ConnectionShutdownState) -> OutboundHeadersConnectionState
	match state
		OutboundHeadersConnectionState(endpoint_role, high_water, lifecycle, peer_settings, _, receive_credit, hpack_state) => OutboundHeadersConnectionState(endpoint_role, high_water, lifecycle, peer_settings, shutdown_state, receive_credit, hpack_state)
	end
end

fn outbound_headers_endpoint_role_label(endpoint_role: Http2EndpointRole) -> String
	match endpoint_role
		ClientEndpoint => "client"
		ServerEndpoint => "server"
	end
end

fn outbound_local_stream_is_open(stream_id: Int, lifecycle: OutboundLocalStreamState) -> Bool
	match lifecycle
		OpenOutboundLocalStream(open_stream_id) => stream_id == open_stream_id
		NoOutboundLocalStream => false
		ClosedOutboundLocalStream(_) => false
		ResetOutboundLocalStream(_, _) => false
	end
end

fn outbound_local_open_stream_count(lifecycle: OutboundLocalStreamState) -> Int
	match lifecycle
		OpenOutboundLocalStream(_) => 1
		NoOutboundLocalStream => 0
		ClosedOutboundLocalStream(_) => 0
		ResetOutboundLocalStream(_, _) => 0
	end
end

fn outbound_headers_preflight(stream_id: Int, payload_length: Int, end_stream: Bool, state: OutboundHeadersConnectionState) -> OutboundHeadersPreflight
	match outbound_local_stream_is_open(stream_id, outbound_headers_connection_lifecycle(state))
		true => OutboundHeadersExistingStream
		false => outbound_new_headers_stream_domain_preflight(stream_id, payload_length, end_stream, state)
	end
end

fn outbound_new_headers_stream_domain_preflight(stream_id: Int, payload_length: Int, end_stream: Bool, state: OutboundHeadersConnectionState) -> OutboundHeadersPreflight
	match stream_id
		0 => OutboundHeadersPreflightRejected(OutboundHeadersRejected(stream_id, payload_length, end_stream, InvalidStreamId(0, 1, stream_id, "nonzero client-initiated stream id", outbound_headers_endpoint_role_label(outbound_headers_connection_role(state)), "stream-id-domain", "outbound_headers_new_stream_requires_client_stream")))
		_ => match stream_id_is_representable(stream_id)
			false => OutboundHeadersPreflightRejected(OutboundHeadersRejected(stream_id, payload_length, end_stream, InvalidStreamId(0, 1, stream_id, "nonzero client-initiated stream id", outbound_headers_endpoint_role_label(outbound_headers_connection_role(state)), "stream-id-domain", "outbound_headers_new_stream_requires_client_stream")))
			true => match stream_id_is_client_initiated(stream_id)
				false => OutboundHeadersPreflightRejected(OutboundHeadersRejected(stream_id, payload_length, end_stream, InvalidStreamId(0, 1, stream_id, "nonzero client-initiated stream id", outbound_headers_endpoint_role_label(outbound_headers_connection_role(state)), "stream-id-domain", "outbound_headers_new_stream_requires_client_stream")))
				true => outbound_new_headers_stream_role_preflight(stream_id, payload_length, end_stream, state)
			end
		end
	end
end

fn outbound_new_headers_stream_role_preflight(stream_id: Int, payload_length: Int, end_stream: Bool, state: OutboundHeadersConnectionState) -> OutboundHeadersPreflight
	match outbound_headers_connection_role(state)
		ServerEndpoint => OutboundHeadersPreflightRejected(OutboundHeadersRejected(stream_id, payload_length, end_stream, InvalidFrameKind(0, 1, stream_id, 1, "server-endpoint", "server_endpoint_cannot_start_regular_stream")))
		ClientEndpoint => outbound_new_headers_stream_goaway_preflight(stream_id, payload_length, end_stream, state)
	end
end

fn outbound_new_headers_stream_goaway_preflight(stream_id: Int, payload_length: Int, end_stream: Bool, state: OutboundHeadersConnectionState) -> OutboundHeadersPreflight
	match outbound_headers_connection_shutdown(state)
		OpenConnection => outbound_new_headers_stream_limit_preflight(stream_id, payload_length, end_stream, state)
		GracefulShutdown(last_stream_id, _) => match stream_id > last_stream_id
			true => OutboundHeadersPreflightRejected(OutboundHeadersRejected(stream_id, payload_length, end_stream, StreamAfterGoaway(0, stream_id, last_stream_id, "graceful_shutdown", "client", "goaway_last_stream_id", empty_header_block())))
			false => outbound_new_headers_stream_limit_preflight(stream_id, payload_length, end_stream, state)
		end
		DrainedShutdown(last_stream_id, _) => match stream_id > last_stream_id
			true => OutboundHeadersPreflightRejected(OutboundHeadersRejected(stream_id, payload_length, end_stream, StreamAfterGoaway(0, stream_id, last_stream_id, "drained_shutdown", "client", "goaway_last_stream_id", empty_header_block())))
			false => outbound_new_headers_stream_limit_preflight(stream_id, payload_length, end_stream, state)
		end
	end
end

fn outbound_new_headers_stream_limit_preflight(stream_id: Int, payload_length: Int, end_stream: Bool, state: OutboundHeadersConnectionState) -> OutboundHeadersPreflight
	let allowed_count: Int = active_peer_max_concurrent_streams(outbound_headers_connection_peer_settings(state))
	let attempted_count: Int = outbound_local_open_stream_count(outbound_headers_connection_lifecycle(state)) + 1
	match attempted_count > allowed_count
		true => OutboundHeadersPreflightRejected(OutboundHeadersRejected(stream_id, payload_length, end_stream, ConcurrentStreamsExceeded(0, stream_id, attempted_count, allowed_count, "client", "idle-stream", "peer_settings", "peer_settings_max_concurrent_streams", empty_header_block())))
		false => OutboundHeadersNewStream
	end
end

fn new_outbound_headers_receive_credit(stream_id: Int, state: OutboundHeadersConnectionState) -> OutboundReceiveCredit
	outbound_receive_credit_with_open_stream(outbound_receive_connection_window(outbound_headers_connection_receive_credit(state)), stream_id, active_peer_initial_window_size(outbound_headers_connection_peer_settings(state)))
end

fn send_headers_on_connection(stream_id: Int, header_block: ByteChunk, end_stream: Bool, state: OutboundHeadersConnectionState) -> Result<OutboundHeadersConnectionTransition, String>
	let payload_length: Int = byte_count_to_int(byte_chunk_count(header_block))
	match outbound_headers_preflight(stream_id, payload_length, end_stream, state)
		OutboundHeadersPreflightRejected(decision) => Ok(OutboundHeadersConnectionTransition(decision, state))
		OutboundHeadersExistingStream => match send_headers_with_shutdown(stream_id, header_block, end_stream, outbound_headers_connection_peer_settings(state), outbound_headers_connection_shutdown(state), outbound_headers_connection_receive_credit(state))
			Ok(decision) => apply_outbound_existing_headers(decision, state, outbound_headers_connection_hpack(state))
			Err(error) => Err(error)
		end
		OutboundHeadersNewStream => match send_headers_with_shutdown(stream_id, header_block, end_stream, outbound_headers_connection_peer_settings(state), outbound_headers_connection_shutdown(state), new_outbound_headers_receive_credit(stream_id, state))
			Ok(decision) => apply_outbound_new_headers_ordering(decision, state, outbound_headers_connection_hpack(state))
			Err(error) => Err(error)
		end
	end
end

fn send_headers_header_list_on_connection(stream_id: Int, headers: HpackHeaderList, end_stream: Bool, state: OutboundHeadersConnectionState) -> Result<Result<OutboundHeadersConnectionTransition, HpackFixtureFailure>, String>
	let payload_length: Int = hpack_fixture::header_list_wire_size(headers)
	match outbound_headers_preflight(stream_id, payload_length, end_stream, state)
		OutboundHeadersPreflightRejected(decision) => Ok(Ok(OutboundHeadersConnectionTransition(decision, state)))
		OutboundHeadersExistingStream => send_headers_header_list_after_preflight(stream_id, headers, end_stream, false, state)
		OutboundHeadersNewStream => send_headers_header_list_after_preflight(stream_id, headers, end_stream, true, state)
	end
end

fn send_headers_header_list_after_preflight(stream_id: Int, headers: HpackHeaderList, end_stream: Bool, is_new_stream: Bool, state: OutboundHeadersConnectionState) -> Result<Result<OutboundHeadersConnectionTransition, HpackFixtureFailure>, String>
	match hpack_fixture::encode_header_list_with_state(headers, outbound_headers_connection_hpack(state), 0)
		Err(failure) => Ok(Err(failure))
		Ok(hpack_transition) => match is_new_stream
			false => match send_headers_with_shutdown(stream_id, hpack_fixture::encode_transition_bytes(hpack_transition), end_stream, outbound_headers_connection_peer_settings(state), outbound_headers_connection_shutdown(state), outbound_headers_connection_receive_credit(state))
				Err(error) => Err(error)
				Ok(decision) => match apply_outbound_existing_headers(decision, state, hpack_fixture::encode_transition_state(hpack_transition))
					Ok(transition) => Ok(Ok(transition))
					Err(error) => Err(error)
				end
			end
			true => match send_headers_with_shutdown(stream_id, hpack_fixture::encode_transition_bytes(hpack_transition), end_stream, outbound_headers_connection_peer_settings(state), outbound_headers_connection_shutdown(state), new_outbound_headers_receive_credit(stream_id, state))
				Err(error) => Err(error)
				Ok(decision) => match apply_outbound_new_headers_ordering(decision, state, hpack_fixture::encode_transition_state(hpack_transition))
					Ok(transition) => Ok(Ok(transition))
					Err(error) => Err(error)
				end
			end
		end
	end
end

fn apply_outbound_existing_headers(decision: OutboundHeadersDecision, state: OutboundHeadersConnectionState, accepted_hpack_state: HpackFixtureState) -> Result<OutboundHeadersConnectionTransition, String>
	match decision
		OutboundHeadersAccepted(stream_id, _, end_stream, receive_credit, _) => match state
			OutboundHeadersConnectionState(endpoint_role, high_water, _, peer_settings, shutdown_state, _, _) => match end_stream
				true => Ok(OutboundHeadersConnectionTransition(decision, OutboundHeadersConnectionState(endpoint_role, high_water, ClosedOutboundLocalStream(stream_id), peer_settings, shutdown_state, receive_credit, accepted_hpack_state)))
				false => Ok(OutboundHeadersConnectionTransition(decision, OutboundHeadersConnectionState(endpoint_role, high_water, OpenOutboundLocalStream(stream_id), peer_settings, shutdown_state, receive_credit, accepted_hpack_state)))
			end
		end
		OutboundHeadersRejected(_, _, _, _) => Ok(OutboundHeadersConnectionTransition(decision, state))
		OutboundHeadersEncodeFailed(_, _, _, _) => Ok(OutboundHeadersConnectionTransition(decision, state))
	end
end

fn apply_outbound_new_headers_ordering(decision: OutboundHeadersDecision, state: OutboundHeadersConnectionState, accepted_hpack_state: HpackFixtureState) -> Result<OutboundHeadersConnectionTransition, String>
	match decision
		OutboundHeadersAccepted(stream_id, payload_length, end_stream, receive_credit, chunk) => match stream_id <= outbound_headers_connection_high_water(state)
			true => Ok(OutboundHeadersConnectionTransition(OutboundHeadersRejected(stream_id, payload_length, end_stream, PeerStreamIdNotIncreasing(0, stream_id, outbound_headers_connection_high_water(state), "client", "idle-stream", "rfc9113_outbound_local_stream_ids_increase", empty_header_block())), state))
			false => match state
				OutboundHeadersConnectionState(endpoint_role, _, _, peer_settings, shutdown_state, _, _) => match end_stream
					true => Ok(OutboundHeadersConnectionTransition(OutboundHeadersAccepted(stream_id, payload_length, end_stream, receive_credit, chunk), OutboundHeadersConnectionState(endpoint_role, stream_id, ClosedOutboundLocalStream(stream_id), peer_settings, shutdown_state, receive_credit, accepted_hpack_state)))
					false => Ok(OutboundHeadersConnectionTransition(OutboundHeadersAccepted(stream_id, payload_length, end_stream, receive_credit, chunk), OutboundHeadersConnectionState(endpoint_role, stream_id, OpenOutboundLocalStream(stream_id), peer_settings, shutdown_state, receive_credit, accepted_hpack_state)))
				end
			end
		end
		OutboundHeadersRejected(_, _, _, _) => Ok(OutboundHeadersConnectionTransition(decision, state))
		OutboundHeadersEncodeFailed(_, _, _, _) => Ok(OutboundHeadersConnectionTransition(decision, state))
	end
end

fn outbound_headers_connection_decision(transition: OutboundHeadersConnectionTransition) -> OutboundHeadersDecision
	match transition
		OutboundHeadersConnectionTransition(decision, _) => decision
	end
end

fn outbound_headers_connection_state(transition: OutboundHeadersConnectionTransition) -> OutboundHeadersConnectionState
	match transition
		OutboundHeadersConnectionTransition(_, state) => state
	end
end

fn send_headers(stream_id: Int, header_block: ByteChunk, end_stream: Bool, peer_settings: PeerSettingsState, receive_credit: OutboundReceiveCredit) -> Result<OutboundHeadersDecision, String>
	send_headers_with_shutdown(stream_id, header_block, end_stream, peer_settings, OpenConnection, receive_credit)
end

fn send_headers_with_shutdown(stream_id: Int, header_block: ByteChunk, end_stream: Bool, peer_settings: PeerSettingsState, shutdown_state: ConnectionShutdownState, receive_credit: OutboundReceiveCredit) -> Result<OutboundHeadersDecision, String>
	let payload_length: Int = byte_count_to_int(byte_chunk_count(header_block))
	match stream_id
		0 => Ok(OutboundHeadersRejected(stream_id, payload_length, end_stream, InvalidStreamId(0, 1, stream_id, "nonzero open stream id", "local", "stream-id-domain", "outbound_headers_requires_open_stream")))
		_ => send_nonzero_headers(stream_id, payload_length, header_block, end_stream, active_peer_max_frame_size(peer_settings), shutdown_state, receive_credit)
	end
end

fn send_headers_from_header_list(stream_id: Int, headers: HpackHeaderList, end_stream: Bool, peer_settings: PeerSettingsState, receive_credit: OutboundReceiveCredit) -> Result<Result<OutboundHeadersDecision, HpackFixtureFailure>, String>
	match hpack_fixture::encode_header_list_with_state(headers, hpack_fixture::initial_encode_state(), 0)
		Ok(transition) => match send_headers(stream_id, hpack_fixture::encode_transition_bytes(transition), end_stream, peer_settings, receive_credit)
			Ok(decision) => Ok(Ok(decision))
			Err(error) => Err(error)
		end
		Err(failure) => Ok(Err(failure))
	end
end

fn send_headers_from_selected_header_list_with_state(stream_id: Int, headers: HpackHeaderList, state: HpackFixtureState, active_capacity: Int, end_stream: Bool, peer_settings: PeerSettingsState, receive_credit: OutboundReceiveCredit) -> Result<Result<OutboundHeadersHpackTransition, HpackFixtureFailure>, String>
	match hpack_fixture::encode_selected_header_list_with_state(headers, state, active_capacity, 0)
		Ok(transition) => send_headers_from_selected_transition(stream_id, transition, end_stream, peer_settings, receive_credit)
		Err(_) => match hpack_fixture::encode_header_list_with_state(headers, state, 0)
			Ok(fallback_transition) => send_headers_from_selected_transition(stream_id, fallback_transition, end_stream, peer_settings, receive_credit)
			Err(failure) => Ok(Err(failure))
		end
	end
end

fn send_headers_from_header_fields_with_state(stream_id: Int, headers: HpackHeaderFields, state: HpackFixtureState, end_stream: Bool, peer_settings: PeerSettingsState, receive_credit: OutboundReceiveCredit) -> Result<Result<OutboundHeadersHpackTransition, HpackFixtureFailure>, String>
	match hpack_fixture::encode_header_fields_with_state(headers, state, active_peer_header_table_size(peer_settings), 0)
		Ok(transition) => send_headers_from_selected_transition(stream_id, transition, end_stream, peer_settings, receive_credit)
		Err(failure) => Ok(Err(failure))
	end
end

fn send_headers_from_selected_transition(stream_id: Int, transition: HpackEncodeTransition, end_stream: Bool, peer_settings: PeerSettingsState, receive_credit: OutboundReceiveCredit) -> Result<Result<OutboundHeadersHpackTransition, HpackFixtureFailure>, String>
	match send_headers(stream_id, hpack_fixture::encode_transition_bytes(transition), end_stream, peer_settings, receive_credit)
		Ok(decision) => Ok(Ok(OutboundHeadersHpackTransition(decision, transition)))
		Err(error) => Err(error)
	end
end

fn encode_hpack_table_size_update(table_size: Int, peer_settings: PeerSettingsState, state: HpackFixtureState) -> Result<HpackEncodeTransition, HpackFixtureFailure>
	hpack_fixture::encode_table_size_update_with_state(table_size, active_peer_header_table_size(peer_settings), state, 0)
end

fn send_headers_from_hpack_table_size_update(stream_id: Int, table_size: Int, end_stream: Bool, peer_settings: PeerSettingsState, state: HpackFixtureState, receive_credit: OutboundReceiveCredit) -> Result<Result<OutboundHeadersDecision, HpackFixtureFailure>, String>
	match encode_hpack_table_size_update(table_size, peer_settings, state)
		Ok(transition) => match send_headers(stream_id, hpack_fixture::encode_transition_bytes(transition), end_stream, peer_settings, receive_credit)
			Ok(decision) => Ok(Ok(decision))
			Err(error) => Err(error)
		end
		Err(failure) => Ok(Err(failure))
	end
end

fn send_nonzero_headers(stream_id: Int, payload_length: Int, header_block: ByteChunk, end_stream: Bool, max_frame_size: Int, shutdown_state: ConnectionShutdownState, receive_credit: OutboundReceiveCredit) -> Result<OutboundHeadersDecision, String>
	match receive_credit
		OutboundReceiveCredit(connection_window, NoOutboundReceiveCreditStream) => Ok(OutboundHeadersRejected(stream_id, payload_length, end_stream, InvalidFrameKind(0, 1, stream_id, 1, "idle-stream", "idle_streams_require_headers")))
		OutboundReceiveCredit(connection_window, OutboundReceiveCreditOpenStream(open_stream_id, stream_window)) => match stream_id == open_stream_id
			true => validate_outbound_headers_after_goaway(stream_id, payload_length, header_block, end_stream, max_frame_size, shutdown_state, connection_window, stream_window)
			false => Ok(OutboundHeadersRejected(stream_id, payload_length, end_stream, InvalidFrameKind(0, 1, stream_id, 1, "idle-stream", "idle_streams_require_headers")))
		end
		OutboundReceiveCredit(connection_window, OutboundReceiveCreditOpenStreamContentLength(open_stream_id, stream_window, _, _)) => match stream_id == open_stream_id
			true => validate_outbound_headers_after_goaway(stream_id, payload_length, header_block, end_stream, max_frame_size, shutdown_state, connection_window, stream_window)
			false => Ok(OutboundHeadersRejected(stream_id, payload_length, end_stream, InvalidFrameKind(0, 1, stream_id, 1, "idle-stream", "idle_streams_require_headers")))
		end
		OutboundReceiveCredit(connection_window, OutboundReceiveCreditClosedStream(closed_stream_id)) => match stream_id == closed_stream_id
			true => Ok(OutboundHeadersRejected(stream_id, payload_length, end_stream, InvalidFrameKind(0, 1, stream_id, 1, "closed-stream", "closed_stream_rejects_later_frames")))
			false => Ok(OutboundHeadersRejected(stream_id, payload_length, end_stream, InvalidFrameKind(0, 1, stream_id, 1, "idle-stream", "idle_streams_require_headers")))
		end
		OutboundReceiveCredit(connection_window, OutboundReceiveCreditResetStream(reset_stream_id, _)) => match stream_id == reset_stream_id
			true => Ok(OutboundHeadersRejected(stream_id, payload_length, end_stream, InvalidFrameKind(0, 1, stream_id, 1, "reset-stream", "reset_stream_rejects_later_frames")))
			false => Ok(OutboundHeadersRejected(stream_id, payload_length, end_stream, InvalidFrameKind(0, 1, stream_id, 1, "idle-stream", "idle_streams_require_headers")))
		end
	end
end

fn validate_outbound_headers_after_goaway(stream_id: Int, payload_length: Int, header_block: ByteChunk, end_stream: Bool, max_frame_size: Int, shutdown_state: ConnectionShutdownState, connection_window: Int, stream_window: Int) -> Result<OutboundHeadersDecision, String>
	match shutdown_state
		OpenConnection => validate_headers_frame_size(stream_id, payload_length, header_block, end_stream, max_frame_size, connection_window, stream_window)
		GracefulShutdown(last_stream_id, _) => match stream_id > last_stream_id
			true => Ok(OutboundHeadersRejected(stream_id, payload_length, end_stream, StreamAfterGoaway(0, stream_id, last_stream_id, "graceful_shutdown", "local", "goaway_last_stream_id", empty_header_block())))
			false => validate_headers_frame_size(stream_id, payload_length, header_block, end_stream, max_frame_size, connection_window, stream_window)
		end
		DrainedShutdown(last_stream_id, _) => match stream_id > last_stream_id
			true => Ok(OutboundHeadersRejected(stream_id, payload_length, end_stream, StreamAfterGoaway(0, stream_id, last_stream_id, "drained_shutdown", "local", "goaway_last_stream_id", empty_header_block())))
			false => validate_headers_frame_size(stream_id, payload_length, header_block, end_stream, max_frame_size, connection_window, stream_window)
		end
	end
end

fn validate_headers_frame_size(stream_id: Int, payload_length: Int, header_block: ByteChunk, end_stream: Bool, max_frame_size: Int, connection_window: Int, stream_window: Int) -> Result<OutboundHeadersDecision, String>
	encode_headers_intent(stream_id, payload_length, header_block, end_stream, max_frame_size, connection_window, stream_window)
end

fn encode_headers_intent(stream_id: Int, payload_length: Int, header_block: ByteChunk, end_stream: Bool, max_frame_size: Int, connection_window: Int, stream_window: Int) -> Result<OutboundHeadersDecision, String>
	match max_frame_size < 1
		true => Ok(OutboundHeadersRejected(stream_id, payload_length, end_stream, FrameSizeExceeded(0, payload_length, ReceiveLimit(max_frame_size, LocalConfiguration), 1, stream_id)))
		false => match payload_length > max_frame_size
			true => encode_split_headers_intent(stream_id, payload_length, header_block, end_stream, max_frame_size, connection_window, stream_window)
			false => encode_single_headers_intent(stream_id, payload_length, header_block, end_stream, connection_window, stream_window)
		end
	end
end

fn encode_single_headers_intent(stream_id: Int, payload_length: Int, header_block: ByteChunk, end_stream: Bool, connection_window: Int, stream_window: Int) -> Result<OutboundHeadersDecision, String>
	let flags: Int = headers_flags(end_stream)
	let encoded_header: Result<ByteChunk, EncodeError> = encode_frame_header({length: payload_length, kind: 1, flags: flags, stream_id: stream_id})
	match encoded_header
		Ok(header) => Ok(OutboundHeadersAccepted(stream_id, payload_length, end_stream, headers_sent_receive_credit(stream_id, end_stream, connection_window, stream_window), byte_append(header, header_block)))
		Err(error) => Ok(OutboundHeadersEncodeFailed(stream_id, payload_length, end_stream, error))
	end
end

fn encode_split_headers_intent(stream_id: Int, payload_length: Int, header_block: ByteChunk, end_stream: Bool, max_frame_size: Int, connection_window: Int, stream_window: Int) -> Result<OutboundHeadersDecision, String>
	let chunk_count: ByteCount = byte_count(max_frame_size)?
	let first_payload: ByteChunk = byte_take(header_block, chunk_count)?
	let remaining: ByteChunk = byte_drop(header_block, chunk_count)?
	let encoded_header: Result<ByteChunk, EncodeError> = encode_frame_header({length: max_frame_size, kind: 1, flags: first_headers_flags(end_stream), stream_id: stream_id})
	match encoded_header
		Ok(header) => encode_continuation_headers_intent(stream_id, payload_length, end_stream, max_frame_size, connection_window, stream_window, remaining, byte_append(header, first_payload))
		Err(error) => Ok(OutboundHeadersEncodeFailed(stream_id, payload_length, end_stream, error))
	end
end

fn encode_continuation_headers_intent(stream_id: Int, payload_length: Int, end_stream: Bool, max_frame_size: Int, connection_window: Int, stream_window: Int, remaining: ByteChunk, encoded: ByteChunk) -> Result<OutboundHeadersDecision, String>
	let remaining_length: Int = byte_count_to_int(byte_chunk_count(remaining))
	match remaining_length > max_frame_size
		true => encode_nonfinal_continuation_header(stream_id, payload_length, end_stream, max_frame_size, connection_window, stream_window, remaining, encoded)
		false => encode_final_continuation_header(stream_id, payload_length, end_stream, remaining_length, connection_window, stream_window, remaining, encoded)
	end
end

fn encode_nonfinal_continuation_header(stream_id: Int, payload_length: Int, end_stream: Bool, max_frame_size: Int, connection_window: Int, stream_window: Int, remaining: ByteChunk, encoded: ByteChunk) -> Result<OutboundHeadersDecision, String>
	let chunk_count: ByteCount = byte_count(max_frame_size)?
	let payload: ByteChunk = byte_take(remaining, chunk_count)?
	let next_remaining: ByteChunk = byte_drop(remaining, chunk_count)?
	let encoded_header: Result<ByteChunk, EncodeError> = encode_frame_header({length: max_frame_size, kind: 9, flags: 0, stream_id: stream_id})
	match encoded_header
		Ok(header) => encode_continuation_headers_intent(stream_id, payload_length, end_stream, max_frame_size, connection_window, stream_window, next_remaining, byte_append(byte_append(encoded, header), payload))
		Err(error) => Ok(OutboundHeadersEncodeFailed(stream_id, payload_length, end_stream, error))
	end
end

fn encode_final_continuation_header(stream_id: Int, payload_length: Int, end_stream: Bool, final_length: Int, connection_window: Int, stream_window: Int, remaining: ByteChunk, encoded: ByteChunk) -> Result<OutboundHeadersDecision, String>
	let encoded_header: Result<ByteChunk, EncodeError> = encode_frame_header({length: final_length, kind: 9, flags: 4, stream_id: stream_id})
	match encoded_header
		Ok(header) => Ok(OutboundHeadersAccepted(stream_id, payload_length, end_stream, headers_sent_receive_credit(stream_id, end_stream, connection_window, stream_window), byte_append(byte_append(encoded, header), remaining)))
		Err(error) => Ok(OutboundHeadersEncodeFailed(stream_id, payload_length, end_stream, error))
	end
end

fn headers_flags(end_stream: Bool) -> Int
	match end_stream
		true => 5
		false => 4
	end
end

fn first_headers_flags(end_stream: Bool) -> Int
	match end_stream
		true => 1
		false => 0
	end
end

fn headers_sent_receive_credit(stream_id: Int, end_stream: Bool, connection_window: Int, stream_window: Int) -> OutboundReceiveCredit
	match end_stream
		true => OutboundReceiveCredit(connection_window, OutboundReceiveCreditClosedStream(stream_id))
		false => OutboundReceiveCredit(connection_window, OutboundReceiveCreditOpenStream(stream_id, stream_window))
	end
end

fn send_push_promise(stream_id: Int, promised_stream_id: Int, header_block: ByteChunk, peer_settings: PeerSettingsState, receive_credit: OutboundReceiveCredit) -> Result<OutboundPushPromiseDecision, String>
	send_push_promise_with_shutdown(stream_id, promised_stream_id, header_block, peer_settings, OpenConnection, receive_credit)
end

fn initial_outbound_push_promise_connection_state(peer_settings: PeerSettingsState, shutdown_state: ConnectionShutdownState, receive_credit: OutboundReceiveCredit) -> OutboundPushPromiseConnectionState
	OutboundPushPromiseConnectionState(0, NoOutboundPromisedStream, peer_settings, shutdown_state, receive_credit, hpack_fixture::initial_encode_state())
end

fn outbound_push_promise_connection_high_water(state: OutboundPushPromiseConnectionState) -> Int
	match state
		OutboundPushPromiseConnectionState(high_water, _, _, _, _, _) => high_water
	end
end

fn outbound_push_promise_connection_promised_state(state: OutboundPushPromiseConnectionState) -> OutboundPromisedStreamState
	match state
		OutboundPushPromiseConnectionState(_, promised_state, _, _, _, _) => promised_state
	end
end

fn outbound_push_promise_connection_peer_settings(state: OutboundPushPromiseConnectionState) -> PeerSettingsState
	match state
		OutboundPushPromiseConnectionState(_, _, peer_settings, _, _, _) => peer_settings
	end
end

fn outbound_push_promise_connection_shutdown(state: OutboundPushPromiseConnectionState) -> ConnectionShutdownState
	match state
		OutboundPushPromiseConnectionState(_, _, _, shutdown_state, _, _) => shutdown_state
	end
end

fn outbound_push_promise_connection_receive_credit(state: OutboundPushPromiseConnectionState) -> OutboundReceiveCredit
	match state
		OutboundPushPromiseConnectionState(_, _, _, _, receive_credit, _) => receive_credit
	end
end

fn outbound_push_promise_connection_hpack(state: OutboundPushPromiseConnectionState) -> HpackFixtureState
	match state
		OutboundPushPromiseConnectionState(_, _, _, _, _, hpack_state) => hpack_state
	end
end

fn with_outbound_push_promise_connection_lifecycle(state: OutboundPushPromiseConnectionState, promised_state: OutboundPromisedStreamState) -> OutboundPushPromiseConnectionState
	match state
		OutboundPushPromiseConnectionState(high_water, _, peer_settings, shutdown_state, receive_credit, hpack_state) => OutboundPushPromiseConnectionState(high_water, promised_state, peer_settings, shutdown_state, receive_credit, hpack_state)
	end
end

fn with_outbound_push_promise_connection_shutdown(state: OutboundPushPromiseConnectionState, shutdown_state: ConnectionShutdownState) -> OutboundPushPromiseConnectionState
	match state
		OutboundPushPromiseConnectionState(high_water, promised_state, peer_settings, _, receive_credit, hpack_state) => OutboundPushPromiseConnectionState(high_water, promised_state, peer_settings, shutdown_state, receive_credit, hpack_state)
	end
end

fn with_outbound_push_promise_connection_peer_settings(state: OutboundPushPromiseConnectionState, peer_settings: PeerSettingsState) -> OutboundPushPromiseConnectionState
	match state
		OutboundPushPromiseConnectionState(high_water, promised_state, _, shutdown_state, receive_credit, hpack_state) => OutboundPushPromiseConnectionState(high_water, promised_state, peer_settings, shutdown_state, receive_credit, hpack_state)
	end
end

fn send_push_promise_on_connection(stream_id: Int, promised_stream_id: Int, header_block: ByteChunk, state: OutboundPushPromiseConnectionState) -> Result<OutboundPushPromiseConnectionTransition, String>
	let decision: OutboundPushPromiseDecision = send_push_promise_with_shutdown(stream_id, promised_stream_id, header_block, outbound_push_promise_connection_peer_settings(state), outbound_push_promise_connection_shutdown(state), outbound_push_promise_connection_receive_credit(state))?
	apply_outbound_push_promise_ordering(decision, state, outbound_push_promise_connection_hpack(state))
end

fn send_push_promise_header_list_on_connection(stream_id: Int, promised_stream_id: Int, headers: HpackHeaderList, state: OutboundPushPromiseConnectionState) -> Result<Result<OutboundPushPromiseConnectionTransition, HpackFixtureFailure>, String>
	let payload_length: Int = hpack_fixture::header_list_wire_size(headers) + 4
	match outbound_push_promise_preflight(stream_id, promised_stream_id, payload_length, outbound_push_promise_connection_peer_settings(state), outbound_push_promise_connection_shutdown(state), outbound_push_promise_connection_receive_credit(state))
		OutboundPushPromisePreflightRejected(decision) => Ok(Ok(OutboundPushPromiseConnectionTransition(decision, state)))
		OutboundPushPromiseReady => match hpack_fixture::encode_header_list_with_state(headers, outbound_push_promise_connection_hpack(state), 0)
			Err(failure) => Ok(Err(failure))
			Ok(hpack_transition) => match send_push_promise_with_shutdown(stream_id, promised_stream_id, hpack_fixture::encode_transition_bytes(hpack_transition), outbound_push_promise_connection_peer_settings(state), outbound_push_promise_connection_shutdown(state), outbound_push_promise_connection_receive_credit(state))
				Err(error) => Err(error)
				Ok(decision) => match apply_outbound_push_promise_ordering(decision, state, hpack_fixture::encode_transition_state(hpack_transition))
					Ok(transition) => Ok(Ok(transition))
					Err(error) => Err(error)
				end
			end
		end
	end
end

fn apply_outbound_push_promise_ordering(decision: OutboundPushPromiseDecision, state: OutboundPushPromiseConnectionState, accepted_hpack_state: HpackFixtureState) -> Result<OutboundPushPromiseConnectionTransition, String>
	match decision
		OutboundPushPromiseAccepted(stream_id, promised_stream_id, payload_length, receive_credit, chunk) => match promised_stream_id <= outbound_push_promise_connection_high_water(state)
			true => Ok(OutboundPushPromiseConnectionTransition(OutboundPushPromiseRejected(stream_id, promised_stream_id, payload_length, PeerStreamIdNotIncreasing(0, promised_stream_id, outbound_push_promise_connection_high_water(state), "server", "idle-stream", "rfc9113_outbound_promised_stream_ids_increase", empty_header_block())), state))
			false => match state
				OutboundPushPromiseConnectionState(_, _, peer_settings, shutdown_state, _, _) => Ok(OutboundPushPromiseConnectionTransition(OutboundPushPromiseAccepted(stream_id, promised_stream_id, payload_length, receive_credit, chunk), OutboundPushPromiseConnectionState(promised_stream_id, ReservedOutboundPromisedStream(promised_stream_id), peer_settings, shutdown_state, receive_credit, accepted_hpack_state)))
			end
		end
		OutboundPushPromiseRejected(_, _, _, _) => Ok(OutboundPushPromiseConnectionTransition(decision, state))
		OutboundPushPromiseEncodeFailed(_, _, _, _) => Ok(OutboundPushPromiseConnectionTransition(decision, state))
	end
end

fn outbound_push_promise_connection_decision(transition: OutboundPushPromiseConnectionTransition) -> OutboundPushPromiseDecision
	match transition
		OutboundPushPromiseConnectionTransition(decision, _) => decision
	end
end

fn outbound_push_promise_connection_state(transition: OutboundPushPromiseConnectionTransition) -> OutboundPushPromiseConnectionState
	match transition
		OutboundPushPromiseConnectionTransition(_, state) => state
	end
end

fn outbound_promised_stream_state_label(state: OutboundPromisedStreamState) -> String
	match state
		NoOutboundPromisedStream => "none"
		ReservedOutboundPromisedStream(_) => "reserved"
		OpenOutboundPromisedStream(_) => "open"
		ClosedOutboundPromisedStream(_) => "closed"
		ResetOutboundPromisedStream(_, _) => "reset"
	end
end

fn outbound_promised_stream_state_id(state: OutboundPromisedStreamState) -> Int
	match state
		NoOutboundPromisedStream => 0
		ReservedOutboundPromisedStream(stream_id) => stream_id
		OpenOutboundPromisedStream(stream_id) => stream_id
		ClosedOutboundPromisedStream(stream_id) => stream_id
		ResetOutboundPromisedStream(stream_id, _) => stream_id
	end
end

fn outbound_promised_stream_reset_code(state: OutboundPromisedStreamState) -> Int
	match state
		NoOutboundPromisedStream => 0
		ReservedOutboundPromisedStream(_) => 0
		OpenOutboundPromisedStream(_) => 0
		ClosedOutboundPromisedStream(_) => 0
		ResetOutboundPromisedStream(_, error_code) => error_code
	end
end

fn outbound_push_promise_connection_shutdown_label(state: OutboundPushPromiseConnectionState) -> String
	match outbound_push_promise_connection_shutdown(state)
		OpenConnection => "open"
		GracefulShutdown(_, _) => "graceful_shutdown"
		DrainedShutdown(_, _) => "drained_shutdown"
	end
end

fn outbound_push_promise_connection_shutdown_last_stream(state: OutboundPushPromiseConnectionState) -> Int
	match outbound_push_promise_connection_shutdown(state)
		OpenConnection => 0
		GracefulShutdown(last_stream_id, _) => last_stream_id
		DrainedShutdown(last_stream_id, _) => last_stream_id
	end
end

fn outbound_push_promise_connection_shutdown_error(state: OutboundPushPromiseConnectionState) -> Int
	match outbound_push_promise_connection_shutdown(state)
		OpenConnection => 0
		GracefulShutdown(_, error_code) => error_code
		DrainedShutdown(_, error_code) => error_code
	end
end

fn send_push_promise_with_shutdown(stream_id: Int, promised_stream_id: Int, header_block: ByteChunk, peer_settings: PeerSettingsState, shutdown_state: ConnectionShutdownState, receive_credit: OutboundReceiveCredit) -> Result<OutboundPushPromiseDecision, String>
	let header_block_length: Int = byte_count_to_int(byte_chunk_count(header_block))
	let payload_length: Int = header_block_length + 4
	match stream_id
		0 => Ok(OutboundPushPromiseRejected(stream_id, promised_stream_id, payload_length, InvalidStreamId(0, 5, stream_id, "nonzero open client-created stream id", "local", "stream-id-domain", "outbound_push_promise_requires_open_stream")))
		_ => match stream_id_is_client_initiated(stream_id)
			true => match peer_enable_push_disabled(peer_settings)
				true => Ok(OutboundPushPromiseRejected(stream_id, promised_stream_id, payload_length, InvalidFrameKind(0, 5, stream_id, 5, "peer-settings", "settings_enable_push_disabled")))
				false => send_nonzero_push_promise(stream_id, promised_stream_id, payload_length, header_block, active_peer_max_frame_size(peer_settings), shutdown_state, receive_credit)
			end
			false => Ok(OutboundPushPromiseRejected(stream_id, promised_stream_id, payload_length, InvalidStreamId(0, 5, stream_id, "nonzero open client-created stream id", "local", "stream-id-domain", "outbound_push_promise_requires_open_stream")))
		end
	end
end

fn send_push_promise_from_header_list(stream_id: Int, promised_stream_id: Int, headers: HpackHeaderList, peer_settings: PeerSettingsState, receive_credit: OutboundReceiveCredit) -> Result<Result<OutboundPushPromiseDecision, HpackFixtureFailure>, String>
	match hpack_fixture::encode_header_list_with_state(headers, hpack_fixture::initial_encode_state(), 0)
		Ok(transition) => match send_push_promise(stream_id, promised_stream_id, hpack_fixture::encode_transition_bytes(transition), peer_settings, receive_credit)
			Ok(decision) => Ok(Ok(decision))
			Err(error) => Err(error)
		end
		Err(failure) => Ok(Err(failure))
	end
end

fn send_push_promise_from_header_list_with_shutdown(stream_id: Int, promised_stream_id: Int, headers: HpackHeaderList, peer_settings: PeerSettingsState, shutdown_state: ConnectionShutdownState, receive_credit: OutboundReceiveCredit) -> Result<Result<OutboundPushPromiseDecision, HpackFixtureFailure>, String>
	match shutdown_state
		OpenConnection => send_push_promise_from_header_list(stream_id, promised_stream_id, headers, peer_settings, receive_credit)
		GracefulShutdown(_, _) => match outbound_push_promise_preflight(stream_id, promised_stream_id, hpack_fixture::header_list_wire_size(headers) + 4, peer_settings, shutdown_state, receive_credit)
			OutboundPushPromisePreflightRejected(decision) => Ok(Ok(decision))
			OutboundPushPromiseReady => match hpack_fixture::encode_header_list_with_state(headers, hpack_fixture::initial_encode_state(), 0)
				Ok(transition) => match send_push_promise_with_shutdown(stream_id, promised_stream_id, hpack_fixture::encode_transition_bytes(transition), peer_settings, shutdown_state, receive_credit)
					Ok(decision) => Ok(Ok(decision))
					Err(error) => Err(error)
				end
				Err(failure) => Ok(Err(failure))
			end
		end
		DrainedShutdown(_, _) => match outbound_push_promise_preflight(stream_id, promised_stream_id, hpack_fixture::header_list_wire_size(headers) + 4, peer_settings, shutdown_state, receive_credit)
			OutboundPushPromisePreflightRejected(decision) => Ok(Ok(decision))
			OutboundPushPromiseReady => match hpack_fixture::encode_header_list_with_state(headers, hpack_fixture::initial_encode_state(), 0)
				Ok(transition) => match send_push_promise_with_shutdown(stream_id, promised_stream_id, hpack_fixture::encode_transition_bytes(transition), peer_settings, shutdown_state, receive_credit)
					Ok(decision) => Ok(Ok(decision))
					Err(error) => Err(error)
				end
				Err(failure) => Ok(Err(failure))
			end
		end
	end
end

fn outbound_push_promise_preflight(stream_id: Int, promised_stream_id: Int, payload_length: Int, peer_settings: PeerSettingsState, shutdown_state: ConnectionShutdownState, receive_credit: OutboundReceiveCredit) -> OutboundPushPromisePreflight
	match stream_id
		0 => OutboundPushPromisePreflightRejected(OutboundPushPromiseRejected(stream_id, promised_stream_id, payload_length, InvalidStreamId(0, 5, stream_id, "nonzero open client-created stream id", "local", "stream-id-domain", "outbound_push_promise_requires_open_stream")))
		_ => match stream_id_is_client_initiated(stream_id)
			true => match peer_enable_push_disabled(peer_settings)
				true => OutboundPushPromisePreflightRejected(OutboundPushPromiseRejected(stream_id, promised_stream_id, payload_length, InvalidFrameKind(0, 5, stream_id, 5, "peer-settings", "settings_enable_push_disabled")))
				false => outbound_nonzero_push_promise_preflight(stream_id, promised_stream_id, payload_length, shutdown_state, receive_credit)
			end
			false => OutboundPushPromisePreflightRejected(OutboundPushPromiseRejected(stream_id, promised_stream_id, payload_length, InvalidStreamId(0, 5, stream_id, "nonzero open client-created stream id", "local", "stream-id-domain", "outbound_push_promise_requires_open_stream")))
		end
	end
end

fn outbound_nonzero_push_promise_preflight(stream_id: Int, promised_stream_id: Int, payload_length: Int, shutdown_state: ConnectionShutdownState, receive_credit: OutboundReceiveCredit) -> OutboundPushPromisePreflight
	match receive_credit
		OutboundReceiveCredit(connection_window, NoOutboundReceiveCreditStream) => OutboundPushPromisePreflightRejected(OutboundPushPromiseRejected(stream_id, promised_stream_id, payload_length, InvalidFrameKind(0, 5, stream_id, 1, "idle-stream", "idle_streams_require_headers")))
		OutboundReceiveCredit(connection_window, OutboundReceiveCreditOpenStream(open_stream_id, stream_window)) => match stream_id == open_stream_id
			true => validate_push_promise_preflight_promised_stream(stream_id, promised_stream_id, payload_length, shutdown_state)
			false => OutboundPushPromisePreflightRejected(OutboundPushPromiseRejected(stream_id, promised_stream_id, payload_length, InvalidFrameKind(0, 5, stream_id, 1, "idle-stream", "idle_streams_require_headers")))
		end
		OutboundReceiveCredit(connection_window, OutboundReceiveCreditOpenStreamContentLength(open_stream_id, stream_window, _, _)) => match stream_id == open_stream_id
			true => validate_push_promise_preflight_promised_stream(stream_id, promised_stream_id, payload_length, shutdown_state)
			false => OutboundPushPromisePreflightRejected(OutboundPushPromiseRejected(stream_id, promised_stream_id, payload_length, InvalidFrameKind(0, 5, stream_id, 1, "idle-stream", "idle_streams_require_headers")))
		end
		OutboundReceiveCredit(connection_window, OutboundReceiveCreditClosedStream(closed_stream_id)) => match stream_id == closed_stream_id
			true => OutboundPushPromisePreflightRejected(OutboundPushPromiseRejected(stream_id, promised_stream_id, payload_length, InvalidFrameKind(0, 5, stream_id, 1, "closed-stream", "closed_stream_rejects_later_frames")))
			false => OutboundPushPromisePreflightRejected(OutboundPushPromiseRejected(stream_id, promised_stream_id, payload_length, InvalidFrameKind(0, 5, stream_id, 1, "idle-stream", "idle_streams_require_headers")))
		end
		OutboundReceiveCredit(connection_window, OutboundReceiveCreditResetStream(reset_stream_id, _)) => match stream_id == reset_stream_id
			true => OutboundPushPromisePreflightRejected(OutboundPushPromiseRejected(stream_id, promised_stream_id, payload_length, InvalidFrameKind(0, 5, stream_id, 1, "reset-stream", "reset_stream_rejects_later_frames")))
			false => OutboundPushPromisePreflightRejected(OutboundPushPromiseRejected(stream_id, promised_stream_id, payload_length, InvalidFrameKind(0, 5, stream_id, 1, "idle-stream", "idle_streams_require_headers")))
		end
	end
end

fn validate_push_promise_preflight_promised_stream(stream_id: Int, promised_stream_id: Int, payload_length: Int, shutdown_state: ConnectionShutdownState) -> OutboundPushPromisePreflight
	match promised_stream_id
		0 => OutboundPushPromisePreflightRejected(OutboundPushPromiseRejected(stream_id, promised_stream_id, payload_length, InvalidStreamId(0, 5, promised_stream_id, "nonzero server-initiated promised stream id", "local", "stream-id-domain", "outbound_push_promise_requires_server_stream")))
		_ => match stream_id_is_server_initiated(promised_stream_id)
			true => validate_push_promise_preflight_goaway(stream_id, promised_stream_id, payload_length, shutdown_state)
			false => match stream_id_is_representable(promised_stream_id)
				true => OutboundPushPromisePreflightRejected(OutboundPushPromiseRejected(stream_id, promised_stream_id, payload_length, InvalidStreamId(0, 5, promised_stream_id, "nonzero server-initiated promised stream id", "local", "stream-id-domain", "outbound_push_promise_requires_server_stream")))
				false => validate_push_promise_preflight_goaway(stream_id, promised_stream_id, payload_length, shutdown_state)
			end
		end
	end
end

fn validate_push_promise_preflight_goaway(stream_id: Int, promised_stream_id: Int, payload_length: Int, shutdown_state: ConnectionShutdownState) -> OutboundPushPromisePreflight
	match shutdown_state
		OpenConnection => OutboundPushPromiseReady
		GracefulShutdown(last_stream_id, _) => match stream_id > last_stream_id
			true => OutboundPushPromisePreflightRejected(OutboundPushPromiseRejected(stream_id, promised_stream_id, payload_length, StreamAfterGoaway(0, stream_id, last_stream_id, "graceful_shutdown", "local", "goaway_last_stream_id", empty_header_block())))
			false => OutboundPushPromiseReady
		end
		DrainedShutdown(last_stream_id, _) => match stream_id > last_stream_id
			true => OutboundPushPromisePreflightRejected(OutboundPushPromiseRejected(stream_id, promised_stream_id, payload_length, StreamAfterGoaway(0, stream_id, last_stream_id, "drained_shutdown", "local", "goaway_last_stream_id", empty_header_block())))
			false => OutboundPushPromiseReady
		end
	end
end

fn send_push_promise_from_header_list_with_state(stream_id: Int, promised_stream_id: Int, headers: HpackHeaderList, state: HpackFixtureState, peer_settings: PeerSettingsState, receive_credit: OutboundReceiveCredit) -> Result<Result<OutboundPushPromiseHpackTransition, HpackFixtureFailure>, String>
	match hpack_fixture::encode_header_list_with_state(headers, state, 0)
		Ok(transition) => match send_push_promise(stream_id, promised_stream_id, hpack_fixture::encode_transition_bytes(transition), peer_settings, receive_credit)
			Ok(decision) => Ok(Ok(OutboundPushPromiseHpackTransition(decision, hpack_fixture::encode_transition_state(transition))))
			Err(error) => Err(error)
		end
		Err(failure) => Ok(Err(failure))
	end
end

fn send_push_promise_from_header_fields_with_state(stream_id: Int, promised_stream_id: Int, headers: HpackHeaderFields, state: HpackFixtureState, peer_settings: PeerSettingsState, receive_credit: OutboundReceiveCredit) -> Result<Result<OutboundPushPromiseHpackTransition, HpackFixtureFailure>, String>
	match hpack_fixture::encode_header_fields_with_state(headers, state, active_peer_header_table_size(peer_settings), 0)
		Ok(transition) => match send_push_promise(stream_id, promised_stream_id, hpack_fixture::encode_transition_bytes(transition), peer_settings, receive_credit)
			Ok(decision) => Ok(Ok(OutboundPushPromiseHpackTransition(decision, hpack_fixture::encode_transition_state(transition))))
			Err(error) => Err(error)
		end
		Err(failure) => Ok(Err(failure))
	end
end

fn send_nonzero_push_promise(stream_id: Int, promised_stream_id: Int, payload_length: Int, header_block: ByteChunk, max_frame_size: Int, shutdown_state: ConnectionShutdownState, receive_credit: OutboundReceiveCredit) -> Result<OutboundPushPromiseDecision, String>
	match receive_credit
		OutboundReceiveCredit(connection_window, NoOutboundReceiveCreditStream) => Ok(OutboundPushPromiseRejected(stream_id, promised_stream_id, payload_length, InvalidFrameKind(0, 5, stream_id, 1, "idle-stream", "idle_streams_require_headers")))
		OutboundReceiveCredit(connection_window, OutboundReceiveCreditOpenStream(open_stream_id, stream_window)) => match stream_id == open_stream_id
			true => validate_promised_stream_id(stream_id, promised_stream_id, payload_length, header_block, max_frame_size, shutdown_state, connection_window, stream_window)
			false => Ok(OutboundPushPromiseRejected(stream_id, promised_stream_id, payload_length, InvalidFrameKind(0, 5, stream_id, 1, "idle-stream", "idle_streams_require_headers")))
		end
		OutboundReceiveCredit(connection_window, OutboundReceiveCreditOpenStreamContentLength(open_stream_id, stream_window, _, _)) => match stream_id == open_stream_id
			true => validate_promised_stream_id(stream_id, promised_stream_id, payload_length, header_block, max_frame_size, shutdown_state, connection_window, stream_window)
			false => Ok(OutboundPushPromiseRejected(stream_id, promised_stream_id, payload_length, InvalidFrameKind(0, 5, stream_id, 1, "idle-stream", "idle_streams_require_headers")))
		end
		OutboundReceiveCredit(connection_window, OutboundReceiveCreditClosedStream(closed_stream_id)) => match stream_id == closed_stream_id
			true => Ok(OutboundPushPromiseRejected(stream_id, promised_stream_id, payload_length, InvalidFrameKind(0, 5, stream_id, 1, "closed-stream", "closed_stream_rejects_later_frames")))
			false => Ok(OutboundPushPromiseRejected(stream_id, promised_stream_id, payload_length, InvalidFrameKind(0, 5, stream_id, 1, "idle-stream", "idle_streams_require_headers")))
		end
		OutboundReceiveCredit(connection_window, OutboundReceiveCreditResetStream(reset_stream_id, _)) => match stream_id == reset_stream_id
			true => Ok(OutboundPushPromiseRejected(stream_id, promised_stream_id, payload_length, InvalidFrameKind(0, 5, stream_id, 1, "reset-stream", "reset_stream_rejects_later_frames")))
			false => Ok(OutboundPushPromiseRejected(stream_id, promised_stream_id, payload_length, InvalidFrameKind(0, 5, stream_id, 1, "idle-stream", "idle_streams_require_headers")))
		end
	end
end

fn validate_promised_stream_id(stream_id: Int, promised_stream_id: Int, payload_length: Int, header_block: ByteChunk, max_frame_size: Int, shutdown_state: ConnectionShutdownState, connection_window: Int, stream_window: Int) -> Result<OutboundPushPromiseDecision, String>
	match promised_stream_id
		0 => Ok(OutboundPushPromiseRejected(stream_id, promised_stream_id, payload_length, InvalidStreamId(0, 5, promised_stream_id, "nonzero server-initiated promised stream id", "local", "stream-id-domain", "outbound_push_promise_requires_server_stream")))
		_ => match stream_id_is_server_initiated(promised_stream_id)
			true => validate_outbound_push_promise_after_goaway(stream_id, promised_stream_id, payload_length, header_block, max_frame_size, shutdown_state, connection_window, stream_window)
			false => match stream_id_is_representable(promised_stream_id)
				true => Ok(OutboundPushPromiseRejected(stream_id, promised_stream_id, payload_length, InvalidStreamId(0, 5, promised_stream_id, "nonzero server-initiated promised stream id", "local", "stream-id-domain", "outbound_push_promise_requires_server_stream")))
				false => validate_outbound_push_promise_after_goaway(stream_id, promised_stream_id, payload_length, header_block, max_frame_size, shutdown_state, connection_window, stream_window)
			end
		end
	end
end

fn stream_id_is_server_initiated(stream_id: Int) -> Bool
	(stream_id / 2) * 2 == stream_id
end

fn stream_id_is_representable(stream_id: Int) -> Bool
	stream_id > 0 and stream_id <= 2147483647
end

fn validate_outbound_push_promise_after_goaway(stream_id: Int, promised_stream_id: Int, payload_length: Int, header_block: ByteChunk, max_frame_size: Int, shutdown_state: ConnectionShutdownState, connection_window: Int, stream_window: Int) -> Result<OutboundPushPromiseDecision, String>
	match shutdown_state
		OpenConnection => encode_push_promise_intent(stream_id, promised_stream_id, payload_length, header_block, max_frame_size, connection_window, stream_window)
		GracefulShutdown(last_stream_id, _) => match stream_id > last_stream_id
			true => Ok(OutboundPushPromiseRejected(stream_id, promised_stream_id, payload_length, StreamAfterGoaway(0, stream_id, last_stream_id, "graceful_shutdown", "local", "goaway_last_stream_id", empty_header_block())))
			false => encode_push_promise_intent(stream_id, promised_stream_id, payload_length, header_block, max_frame_size, connection_window, stream_window)
		end
		DrainedShutdown(last_stream_id, _) => match stream_id > last_stream_id
			true => Ok(OutboundPushPromiseRejected(stream_id, promised_stream_id, payload_length, StreamAfterGoaway(0, stream_id, last_stream_id, "drained_shutdown", "local", "goaway_last_stream_id", empty_header_block())))
			false => encode_push_promise_intent(stream_id, promised_stream_id, payload_length, header_block, max_frame_size, connection_window, stream_window)
		end
	end
end

fn encode_push_promise_intent(stream_id: Int, promised_stream_id: Int, payload_length: Int, header_block: ByteChunk, max_frame_size: Int, connection_window: Int, stream_window: Int) -> Result<OutboundPushPromiseDecision, String>
	match max_frame_size < 4
		true => Ok(OutboundPushPromiseRejected(stream_id, promised_stream_id, payload_length, FrameSizeExceeded(0, 4, ReceiveLimit(max_frame_size, LocalConfiguration), 5, stream_id)))
		false => encode_representable_push_promise_intent(stream_id, promised_stream_id, payload_length, header_block, max_frame_size, connection_window, stream_window)
	end
end

fn encode_representable_push_promise_intent(stream_id: Int, promised_stream_id: Int, payload_length: Int, header_block: ByteChunk, max_frame_size: Int, connection_window: Int, stream_window: Int) -> Result<OutboundPushPromiseDecision, String>
	let encoded_payload: Result<ByteChunk, EncodeError> = encode_push_promise_payload({promised_stream_id: promised_stream_id})
	match encoded_payload
		Ok(promised_payload) => match stream_id_is_server_initiated(promised_stream_id)
			true => match payload_length > max_frame_size
				true => encode_split_push_promise_intent(stream_id, promised_stream_id, payload_length, promised_payload, header_block, max_frame_size, connection_window, stream_window)
				false => encode_single_push_promise_intent(stream_id, promised_stream_id, payload_length, promised_payload, header_block, connection_window, stream_window)
			end
			false => Ok(OutboundPushPromiseRejected(stream_id, promised_stream_id, payload_length, InvalidStreamId(0, 5, promised_stream_id, "nonzero server-initiated promised stream id", "local", "stream-id-domain", "outbound_push_promise_requires_server_stream")))
		end
		Err(error) => Ok(OutboundPushPromiseEncodeFailed(stream_id, promised_stream_id, payload_length, error))
	end
end

fn encode_single_push_promise_intent(stream_id: Int, promised_stream_id: Int, payload_length: Int, promised_payload: ByteChunk, header_block: ByteChunk, connection_window: Int, stream_window: Int) -> Result<OutboundPushPromiseDecision, String>
	let encoded_header: Result<ByteChunk, EncodeError> = encode_frame_header({length: payload_length, kind: 5, flags: 4, stream_id: stream_id})
	match encoded_header
		Ok(header) => Ok(OutboundPushPromiseAccepted(stream_id, promised_stream_id, payload_length, OutboundReceiveCredit(connection_window, OutboundReceiveCreditOpenStream(stream_id, stream_window)), byte_append(byte_append(header, promised_payload), header_block)))
		Err(error) => Ok(OutboundPushPromiseEncodeFailed(stream_id, promised_stream_id, payload_length, error))
	end
end

fn encode_split_push_promise_intent(stream_id: Int, promised_stream_id: Int, payload_length: Int, promised_payload: ByteChunk, header_block: ByteChunk, max_frame_size: Int, connection_window: Int, stream_window: Int) -> Result<OutboundPushPromiseDecision, String>
	let first_header_block_count: ByteCount = byte_count(max_frame_size - 4)?
	let first_header_block: ByteChunk = byte_take(header_block, first_header_block_count)?
	let remaining: ByteChunk = byte_drop(header_block, first_header_block_count)?
	let encoded_header: Result<ByteChunk, EncodeError> = encode_frame_header({length: max_frame_size, kind: 5, flags: 0, stream_id: stream_id})
	match encoded_header
		Ok(header) => encode_continuation_push_promise_intent(stream_id, promised_stream_id, payload_length, max_frame_size, connection_window, stream_window, remaining, byte_append(byte_append(header, promised_payload), first_header_block))
		Err(error) => Ok(OutboundPushPromiseEncodeFailed(stream_id, promised_stream_id, payload_length, error))
	end
end

fn encode_continuation_push_promise_intent(stream_id: Int, promised_stream_id: Int, payload_length: Int, max_frame_size: Int, connection_window: Int, stream_window: Int, remaining: ByteChunk, encoded: ByteChunk) -> Result<OutboundPushPromiseDecision, String>
	let remaining_length: Int = byte_count_to_int(byte_chunk_count(remaining))
	match remaining_length > max_frame_size
		true => encode_nonfinal_push_promise_continuation(stream_id, promised_stream_id, payload_length, max_frame_size, connection_window, stream_window, remaining, encoded)
		false => encode_final_push_promise_continuation(stream_id, promised_stream_id, payload_length, remaining_length, connection_window, stream_window, remaining, encoded)
	end
end

fn encode_nonfinal_push_promise_continuation(stream_id: Int, promised_stream_id: Int, payload_length: Int, max_frame_size: Int, connection_window: Int, stream_window: Int, remaining: ByteChunk, encoded: ByteChunk) -> Result<OutboundPushPromiseDecision, String>
	let chunk_count: ByteCount = byte_count(max_frame_size)?
	let payload: ByteChunk = byte_take(remaining, chunk_count)?
	let next_remaining: ByteChunk = byte_drop(remaining, chunk_count)?
	let encoded_header: Result<ByteChunk, EncodeError> = encode_frame_header({length: max_frame_size, kind: 9, flags: 0, stream_id: stream_id})
	match encoded_header
		Ok(header) => encode_continuation_push_promise_intent(stream_id, promised_stream_id, payload_length, max_frame_size, connection_window, stream_window, next_remaining, byte_append(byte_append(encoded, header), payload))
		Err(error) => Ok(OutboundPushPromiseEncodeFailed(stream_id, promised_stream_id, payload_length, error))
	end
end

fn encode_final_push_promise_continuation(stream_id: Int, promised_stream_id: Int, payload_length: Int, final_length: Int, connection_window: Int, stream_window: Int, remaining: ByteChunk, encoded: ByteChunk) -> Result<OutboundPushPromiseDecision, String>
	let encoded_header: Result<ByteChunk, EncodeError> = encode_frame_header({length: final_length, kind: 9, flags: 4, stream_id: stream_id})
	match encoded_header
		Ok(header) => Ok(OutboundPushPromiseAccepted(stream_id, promised_stream_id, payload_length, OutboundReceiveCredit(connection_window, OutboundReceiveCreditOpenStream(stream_id, stream_window)), byte_append(byte_append(encoded, header), remaining)))
		Err(error) => Ok(OutboundPushPromiseEncodeFailed(stream_id, promised_stream_id, payload_length, error))
	end
end

fn consume_outbound_data_window(stream_id: Int, payload: ByteChunk, length: Int, end_stream: Bool, max_frame_size: Int, shutdown_state: ConnectionShutdownState, send_credit: OutboundSendCredit) -> Result<OutboundDataDecision, String>
	match send_credit
		OutboundSendCredit(connection_window, streams) => consume_outbound_data_streams(stream_id, payload, length, end_stream, max_frame_size, shutdown_state, connection_window, streams, streams)
	end
end

fn consume_outbound_data_streams(stream_id: Int, payload: ByteChunk, length: Int, end_stream: Bool, max_frame_size: Int, shutdown_state: ConnectionShutdownState, connection_window: Int, remaining: List<OutboundReceiveCreditStream>, all_streams: List<OutboundReceiveCreditStream>) -> Result<OutboundDataDecision, String>
	match remaining
		Nil => Ok(OutboundDataRejected(stream_id, length, end_stream, FlowControlWindowExceeded(0, 0, stream_id, length, 0, "open-stream", "outbound_stream_window", empty_header_block())))
		Cons(stream, tail) => match stream
			NoOutboundReceiveCreditStream => consume_outbound_data_streams(stream_id, payload, length, end_stream, max_frame_size, shutdown_state, connection_window, tail, all_streams)
			OutboundReceiveCreditOpenStream(open_stream_id, stream_window) => match stream_id == open_stream_id
				true => preserve_outbound_data_streams(stream_id, all_streams, validate_open_stream_outbound_data_window(stream_id, open_stream_id, payload, length, end_stream, max_frame_size, shutdown_state, connection_window, stream_window)?)
				false => consume_outbound_data_streams(stream_id, payload, length, end_stream, max_frame_size, shutdown_state, connection_window, tail, all_streams)
			end
			OutboundReceiveCreditOpenStreamContentLength(open_stream_id, stream_window, expected_length, observed_length) => match stream_id == open_stream_id
				true => preserve_outbound_data_streams(stream_id, all_streams, validate_open_stream_outbound_data_window_with_content_length(stream_id, open_stream_id, payload, length, length, end_stream, max_frame_size, shutdown_state, connection_window, stream_window, expected_length, observed_length)?)
				false => consume_outbound_data_streams(stream_id, payload, length, end_stream, max_frame_size, shutdown_state, connection_window, tail, all_streams)
			end
			OutboundReceiveCreditClosedStream(closed_stream_id) => match stream_id == closed_stream_id
				true => Ok(OutboundDataRejected(stream_id, length, end_stream, InvalidFrameKind(0, 0, stream_id, 1, "closed-stream", "closed_stream_rejects_later_frames")))
				false => consume_outbound_data_streams(stream_id, payload, length, end_stream, max_frame_size, shutdown_state, connection_window, tail, all_streams)
			end
			OutboundReceiveCreditResetStream(reset_stream_id, _) => match stream_id == reset_stream_id
				true => Ok(OutboundDataRejected(stream_id, length, end_stream, InvalidFrameKind(0, 0, stream_id, 1, "reset-stream", "reset_stream_rejects_later_frames")))
				false => consume_outbound_data_streams(stream_id, payload, length, end_stream, max_frame_size, shutdown_state, connection_window, tail, all_streams)
			end
		end
	end
end

fn preserve_outbound_data_streams(stream_id: Int, streams: List<OutboundReceiveCreditStream>, decision: OutboundDataDecision) -> Result<OutboundDataDecision, String>
	match decision
		OutboundDataAccepted(accepted_stream_id, length, end_stream, OutboundSendCredit(connection_window, Cons(updated_stream, _)), chunk) => Ok(OutboundDataAccepted(accepted_stream_id, length, end_stream, OutboundSendCredit(connection_window, replace_outbound_stream(stream_id, updated_stream, streams)), chunk))
		OutboundDataAccepted(_, _, _, OutboundSendCredit(_, Nil), _) => Err("accepted outbound DATA must preserve its stream credit")
		OutboundDataRejected(_, _, _, _) => Ok(decision)
		OutboundDataEncodeFailed(_, _, _, _) => Ok(decision)
	end
end

fn replace_outbound_stream(stream_id: Int, replacement: OutboundReceiveCreditStream, streams: List<OutboundReceiveCreditStream>) -> List<OutboundReceiveCreditStream>
	match streams
		Nil => Nil
		Cons(stream, tail) => match outbound_credit_stream_matches(stream_id, stream)
			true => Cons(replacement, tail)
			false => Cons(stream, replace_outbound_stream(stream_id, replacement, tail))
		end
	end
end

fn outbound_credit_stream_matches(stream_id: Int, stream: OutboundReceiveCreditStream) -> Bool
	match stream
		NoOutboundReceiveCreditStream => false
		OutboundReceiveCreditOpenStream(candidate, _) => stream_id == candidate
		OutboundReceiveCreditOpenStreamContentLength(candidate, _, _, _) => stream_id == candidate
		OutboundReceiveCreditClosedStream(candidate) => stream_id == candidate
		OutboundReceiveCreditResetStream(candidate, _) => stream_id == candidate
	end
end

fn validate_open_stream_outbound_data_window(stream_id: Int, open_stream_id: Int, payload: ByteChunk, length: Int, end_stream: Bool, max_frame_size: Int, shutdown_state: ConnectionShutdownState, connection_window: Int, stream_window: Int) -> Result<OutboundDataDecision, String>
	match shutdown_state
		OpenConnection => validate_open_connection_outbound_data_window(stream_id, open_stream_id, payload, length, end_stream, max_frame_size, connection_window, stream_window)
		GracefulShutdown(_, _) => match stream_id == open_stream_id
			false => Ok(OutboundDataRejected(stream_id, length, end_stream, FlowControlWindowExceeded(0, 0, stream_id, length, 0, "open-stream", "outbound_stream_window", empty_header_block())))
			true => validate_outbound_data_after_goaway(stream_id, payload, length, end_stream, max_frame_size, shutdown_state, connection_window, stream_window)
		end
		DrainedShutdown(_, _) => match stream_id == open_stream_id
			false => Ok(OutboundDataRejected(stream_id, length, end_stream, FlowControlWindowExceeded(0, 0, stream_id, length, 0, "open-stream", "outbound_stream_window", empty_header_block())))
			true => validate_outbound_data_after_goaway(stream_id, payload, length, end_stream, max_frame_size, shutdown_state, connection_window, stream_window)
		end
	end
end

fn validate_open_stream_outbound_data_window_with_content_length(stream_id: Int, open_stream_id: Int, payload: ByteChunk, encoded_length: Int, application_length: Int, end_stream: Bool, max_frame_size: Int, shutdown_state: ConnectionShutdownState, connection_window: Int, stream_window: Int, expected_length: Int, observed_length: Int) -> Result<OutboundDataDecision, String>
	match shutdown_state
		OpenConnection => validate_open_connection_outbound_data_window_with_content_length(stream_id, open_stream_id, payload, encoded_length, application_length, end_stream, max_frame_size, connection_window, stream_window, expected_length, observed_length)
		GracefulShutdown(_, _) => match stream_id == open_stream_id
			false => Ok(OutboundDataRejected(stream_id, encoded_length, end_stream, FlowControlWindowExceeded(0, 0, stream_id, encoded_length, 0, "open-stream", "outbound_stream_window", empty_header_block())))
			true => validate_outbound_data_after_goaway_with_content_length(stream_id, payload, encoded_length, application_length, end_stream, max_frame_size, shutdown_state, connection_window, stream_window, expected_length, observed_length)
		end
		DrainedShutdown(_, _) => match stream_id == open_stream_id
			false => Ok(OutboundDataRejected(stream_id, encoded_length, end_stream, FlowControlWindowExceeded(0, 0, stream_id, encoded_length, 0, "open-stream", "outbound_stream_window", empty_header_block())))
			true => validate_outbound_data_after_goaway_with_content_length(stream_id, payload, encoded_length, application_length, end_stream, max_frame_size, shutdown_state, connection_window, stream_window, expected_length, observed_length)
		end
	end
end

fn validate_open_connection_outbound_data_window(stream_id: Int, open_stream_id: Int, payload: ByteChunk, length: Int, end_stream: Bool, max_frame_size: Int, connection_window: Int, stream_window: Int) -> Result<OutboundDataDecision, String>
	match data_exceeds_connection_window(length, connection_window)
		true => Ok(OutboundDataRejected(stream_id, length, end_stream, FlowControlWindowExceeded(0, 0, stream_id, length, connection_window, "connection-flow-control", "outbound_connection_window", empty_header_block())))
		false => match stream_id == open_stream_id
			false => Ok(OutboundDataRejected(stream_id, length, end_stream, FlowControlWindowExceeded(0, 0, stream_id, length, 0, "open-stream", "outbound_stream_window", empty_header_block())))
			true => match data_exceeds_stream_window(length, stream_window)
				true => Ok(OutboundDataRejected(stream_id, length, end_stream, FlowControlWindowExceeded(0, 0, stream_id, length, stream_window, "open-stream", "outbound_stream_window", empty_header_block())))
				false => encode_data_intent(stream_id, payload, length, end_stream, max_frame_size, connection_window, stream_window)
			end
		end
	end
end

fn validate_open_connection_outbound_data_window_with_content_length(stream_id: Int, open_stream_id: Int, payload: ByteChunk, encoded_length: Int, application_length: Int, end_stream: Bool, max_frame_size: Int, connection_window: Int, stream_window: Int, expected_length: Int, observed_length: Int) -> Result<OutboundDataDecision, String>
	match data_exceeds_connection_window(encoded_length, connection_window)
		true => Ok(OutboundDataRejected(stream_id, encoded_length, end_stream, FlowControlWindowExceeded(0, 0, stream_id, encoded_length, connection_window, "connection-flow-control", "outbound_connection_window", empty_header_block())))
		false => match stream_id == open_stream_id
			false => Ok(OutboundDataRejected(stream_id, encoded_length, end_stream, FlowControlWindowExceeded(0, 0, stream_id, encoded_length, 0, "open-stream", "outbound_stream_window", empty_header_block())))
			true => match data_exceeds_stream_window(encoded_length, stream_window)
				true => Ok(OutboundDataRejected(stream_id, encoded_length, end_stream, FlowControlWindowExceeded(0, 0, stream_id, encoded_length, stream_window, "open-stream", "outbound_stream_window", empty_header_block())))
				false => validate_data_frame_size_with_content_length(stream_id, payload, encoded_length, application_length, end_stream, max_frame_size, connection_window, stream_window, expected_length, observed_length)
			end
		end
	end
end

fn validate_outbound_data_after_goaway(stream_id: Int, payload: ByteChunk, length: Int, end_stream: Bool, max_frame_size: Int, shutdown_state: ConnectionShutdownState, connection_window: Int, stream_window: Int) -> Result<OutboundDataDecision, String>
	match shutdown_state
		OpenConnection => validate_outbound_data_windows(stream_id, payload, length, end_stream, max_frame_size, connection_window, stream_window)
		GracefulShutdown(last_stream_id, _) => match stream_id > last_stream_id
			true => Ok(OutboundDataRejected(stream_id, length, end_stream, StreamAfterGoaway(0, stream_id, last_stream_id, "graceful_shutdown", "local", "goaway_last_stream_id", empty_header_block())))
			false => validate_outbound_data_windows(stream_id, payload, length, end_stream, max_frame_size, connection_window, stream_window)
		end
		DrainedShutdown(last_stream_id, _) => match stream_id > last_stream_id
			true => Ok(OutboundDataRejected(stream_id, length, end_stream, StreamAfterGoaway(0, stream_id, last_stream_id, "drained_shutdown", "local", "goaway_last_stream_id", empty_header_block())))
			false => validate_outbound_data_windows(stream_id, payload, length, end_stream, max_frame_size, connection_window, stream_window)
		end
	end
end

fn validate_outbound_data_after_goaway_with_content_length(stream_id: Int, payload: ByteChunk, encoded_length: Int, application_length: Int, end_stream: Bool, max_frame_size: Int, shutdown_state: ConnectionShutdownState, connection_window: Int, stream_window: Int, expected_length: Int, observed_length: Int) -> Result<OutboundDataDecision, String>
	match shutdown_state
		OpenConnection => validate_outbound_data_windows_with_content_length(stream_id, payload, encoded_length, application_length, end_stream, max_frame_size, connection_window, stream_window, expected_length, observed_length)
		GracefulShutdown(last_stream_id, _) => match stream_id > last_stream_id
			true => Ok(OutboundDataRejected(stream_id, encoded_length, end_stream, StreamAfterGoaway(0, stream_id, last_stream_id, "graceful_shutdown", "local", "goaway_last_stream_id", empty_header_block())))
			false => validate_outbound_data_windows_with_content_length(stream_id, payload, encoded_length, application_length, end_stream, max_frame_size, connection_window, stream_window, expected_length, observed_length)
		end
		DrainedShutdown(last_stream_id, _) => match stream_id > last_stream_id
			true => Ok(OutboundDataRejected(stream_id, encoded_length, end_stream, StreamAfterGoaway(0, stream_id, last_stream_id, "drained_shutdown", "local", "goaway_last_stream_id", empty_header_block())))
			false => validate_outbound_data_windows_with_content_length(stream_id, payload, encoded_length, application_length, end_stream, max_frame_size, connection_window, stream_window, expected_length, observed_length)
		end
	end
end

fn validate_outbound_data_windows(stream_id: Int, payload: ByteChunk, length: Int, end_stream: Bool, max_frame_size: Int, connection_window: Int, stream_window: Int) -> Result<OutboundDataDecision, String>
	match data_exceeds_connection_window(length, connection_window)
		true => Ok(OutboundDataRejected(stream_id, length, end_stream, FlowControlWindowExceeded(0, 0, stream_id, length, connection_window, "connection-flow-control", "outbound_connection_window", empty_header_block())))
		false => match data_exceeds_stream_window(length, stream_window)
			true => Ok(OutboundDataRejected(stream_id, length, end_stream, FlowControlWindowExceeded(0, 0, stream_id, length, stream_window, "open-stream", "outbound_stream_window", empty_header_block())))
			false => validate_data_frame_size(stream_id, payload, length, end_stream, max_frame_size, connection_window, stream_window)
		end
	end
end

fn validate_outbound_data_windows_with_content_length(stream_id: Int, payload: ByteChunk, encoded_length: Int, application_length: Int, end_stream: Bool, max_frame_size: Int, connection_window: Int, stream_window: Int, expected_length: Int, observed_length: Int) -> Result<OutboundDataDecision, String>
	match data_exceeds_connection_window(encoded_length, connection_window)
		true => Ok(OutboundDataRejected(stream_id, encoded_length, end_stream, FlowControlWindowExceeded(0, 0, stream_id, encoded_length, connection_window, "connection-flow-control", "outbound_connection_window", empty_header_block())))
		false => match data_exceeds_stream_window(encoded_length, stream_window)
			true => Ok(OutboundDataRejected(stream_id, encoded_length, end_stream, FlowControlWindowExceeded(0, 0, stream_id, encoded_length, stream_window, "open-stream", "outbound_stream_window", empty_header_block())))
			false => validate_data_frame_size_with_content_length(stream_id, payload, encoded_length, application_length, end_stream, max_frame_size, connection_window, stream_window, expected_length, observed_length)
		end
	end
end

fn validate_data_frame_size(stream_id: Int, payload: ByteChunk, length: Int, end_stream: Bool, max_frame_size: Int, connection_window: Int, stream_window: Int) -> Result<OutboundDataDecision, String>
	match max_frame_size < 1
		true => Ok(OutboundDataRejected(stream_id, length, end_stream, FrameSizeExceeded(0, length, ReceiveLimit(max_frame_size, LocalConfiguration), 0, stream_id)))
		false => encode_data_intent(stream_id, payload, length, end_stream, max_frame_size, connection_window, stream_window)
	end
end

fn validate_data_frame_size_with_content_length(stream_id: Int, payload: ByteChunk, encoded_length: Int, application_length: Int, end_stream: Bool, max_frame_size: Int, connection_window: Int, stream_window: Int, expected_length: Int, observed_length: Int) -> Result<OutboundDataDecision, String>
	match max_frame_size < 1
		true => Ok(OutboundDataRejected(stream_id, encoded_length, end_stream, FrameSizeExceeded(0, encoded_length, ReceiveLimit(max_frame_size, LocalConfiguration), 0, stream_id)))
		false => validate_outbound_content_length(stream_id, payload, encoded_length, application_length, end_stream, max_frame_size, connection_window, stream_window, expected_length, observed_length)
	end
end

fn validate_outbound_content_length(stream_id: Int, payload: ByteChunk, encoded_length: Int, application_length: Int, end_stream: Bool, max_frame_size: Int, connection_window: Int, stream_window: Int, expected_length: Int, observed_length: Int) -> Result<OutboundDataDecision, String>
	let next_observed_length: Int = observed_length + application_length
	match next_observed_length > expected_length
		true => Ok(OutboundDataRejected(stream_id, encoded_length, end_stream, ContentLengthMismatch(0, 0, stream_id, expected_length, next_observed_length, "open-stream", "rfc9113_content_length_body", byte_chunk_view(payload)?)))
		false => match end_stream and next_observed_length < expected_length
			true => Ok(OutboundDataRejected(stream_id, encoded_length, end_stream, ContentLengthMismatch(0, 0, stream_id, expected_length, next_observed_length, "open-stream", "rfc9113_content_length_body", byte_chunk_view(payload)?)))
			false => encode_data_intent_with_content_length(stream_id, payload, encoded_length, end_stream, max_frame_size, connection_window, stream_window, expected_length, next_observed_length)
		end
	end
end

fn consume_outbound_padded_data_window(stream_id: Int, payload: ByteChunk, encoded_length: Int, padding_length: Int, end_stream: Bool, max_frame_size: Int, send_credit: OutboundSendCredit) -> Result<OutboundDataDecision, String>
	match send_credit
		OutboundSendCredit(connection_window, streams) => consume_outbound_padded_data_streams(stream_id, payload, encoded_length, padding_length, end_stream, max_frame_size, connection_window, streams, streams)
	end
end

fn consume_outbound_padded_data_streams(stream_id: Int, payload: ByteChunk, encoded_length: Int, padding_length: Int, end_stream: Bool, max_frame_size: Int, connection_window: Int, remaining: List<OutboundReceiveCreditStream>, all_streams: List<OutboundReceiveCreditStream>) -> Result<OutboundDataDecision, String>
	match remaining
		Nil => Ok(OutboundDataRejected(stream_id, encoded_length, end_stream, FlowControlWindowExceeded(0, 0, stream_id, encoded_length, 0, "open-stream", "outbound_stream_window", empty_header_block())))
		Cons(stream, tail) => match stream
			NoOutboundReceiveCreditStream => consume_outbound_padded_data_streams(stream_id, payload, encoded_length, padding_length, end_stream, max_frame_size, connection_window, tail, all_streams)
			OutboundReceiveCreditOpenStream(open_stream_id, stream_window) => match stream_id == open_stream_id
				false => consume_outbound_padded_data_streams(stream_id, payload, encoded_length, padding_length, end_stream, max_frame_size, connection_window, tail, all_streams)
				true => match data_exceeds_connection_window(encoded_length, connection_window)
					true => Ok(OutboundDataRejected(stream_id, encoded_length, end_stream, FlowControlWindowExceeded(0, 0, stream_id, encoded_length, connection_window, "connection-flow-control", "outbound_connection_window", empty_header_block())))
					false => match data_exceeds_stream_window(encoded_length, stream_window)
						true => Ok(OutboundDataRejected(stream_id, encoded_length, end_stream, FlowControlWindowExceeded(0, 0, stream_id, encoded_length, stream_window, "open-stream", "outbound_stream_window", empty_header_block())))
						false => preserve_outbound_data_streams(stream_id, all_streams, encode_padded_data_intent(stream_id, payload, encoded_length, padding_length, end_stream, max_frame_size, connection_window, stream_window)?)
					end
				end
			end
			OutboundReceiveCreditOpenStreamContentLength(open_stream_id, stream_window, expected_length, observed_length) => match stream_id == open_stream_id
				false => consume_outbound_padded_data_streams(stream_id, payload, encoded_length, padding_length, end_stream, max_frame_size, connection_window, tail, all_streams)
				true => match data_exceeds_connection_window(encoded_length, connection_window)
					true => Ok(OutboundDataRejected(stream_id, encoded_length, end_stream, FlowControlWindowExceeded(0, 0, stream_id, encoded_length, connection_window, "connection-flow-control", "outbound_connection_window", empty_header_block())))
					false => match data_exceeds_stream_window(encoded_length, stream_window)
						true => Ok(OutboundDataRejected(stream_id, encoded_length, end_stream, FlowControlWindowExceeded(0, 0, stream_id, encoded_length, stream_window, "open-stream", "outbound_stream_window", empty_header_block())))
						false => preserve_outbound_data_streams(stream_id, all_streams, validate_outbound_padded_content_length(stream_id, payload, encoded_length, padding_length, end_stream, max_frame_size, connection_window, stream_window, expected_length, observed_length)?)
					end
				end
			end
			OutboundReceiveCreditClosedStream(closed_stream_id) => match stream_id == closed_stream_id
				true => Ok(OutboundDataRejected(stream_id, encoded_length, end_stream, InvalidFrameKind(0, 0, stream_id, 1, "closed-stream", "closed_stream_rejects_later_frames")))
				false => consume_outbound_padded_data_streams(stream_id, payload, encoded_length, padding_length, end_stream, max_frame_size, connection_window, tail, all_streams)
			end
			OutboundReceiveCreditResetStream(reset_stream_id, _) => match stream_id == reset_stream_id
				true => Ok(OutboundDataRejected(stream_id, encoded_length, end_stream, InvalidFrameKind(0, 0, stream_id, 1, "reset-stream", "reset_stream_rejects_later_frames")))
				false => consume_outbound_padded_data_streams(stream_id, payload, encoded_length, padding_length, end_stream, max_frame_size, connection_window, tail, all_streams)
			end
		end
	end
end

fn validate_outbound_padded_content_length(stream_id: Int, payload: ByteChunk, encoded_length: Int, padding_length: Int, end_stream: Bool, max_frame_size: Int, connection_window: Int, stream_window: Int, expected_length: Int, observed_length: Int) -> Result<OutboundDataDecision, String>
	let application_length: Int = byte_count_to_int(byte_chunk_count(payload))
	let next_observed_length: Int = observed_length + application_length
	match next_observed_length > expected_length
		true => Ok(OutboundDataRejected(stream_id, encoded_length, end_stream, ContentLengthMismatch(0, 0, stream_id, expected_length, next_observed_length, "open-stream", "rfc9113_content_length_body", byte_chunk_view(payload)?)))
		false => match end_stream and next_observed_length < expected_length
			true => Ok(OutboundDataRejected(stream_id, encoded_length, end_stream, ContentLengthMismatch(0, 0, stream_id, expected_length, next_observed_length, "open-stream", "rfc9113_content_length_body", byte_chunk_view(payload)?)))
			false => encode_padded_data_intent_with_content_length(stream_id, payload, encoded_length, padding_length, end_stream, max_frame_size, connection_window, stream_window, expected_length, next_observed_length)
		end
	end
end

fn encode_data_intent(stream_id: Int, payload: ByteChunk, length: Int, end_stream: Bool, max_frame_size: Int, connection_window: Int, stream_window: Int) -> Result<OutboundDataDecision, String>
	match length > max_frame_size
		true => encode_split_data_intent(stream_id, payload, length, end_stream, max_frame_size, connection_window, stream_window)
		false => encode_single_data_intent(stream_id, payload, length, end_stream, connection_window, stream_window)
	end
end

fn encode_data_intent_with_content_length(stream_id: Int, payload: ByteChunk, length: Int, end_stream: Bool, max_frame_size: Int, connection_window: Int, stream_window: Int, expected_length: Int, observed_length: Int) -> Result<OutboundDataDecision, String>
	match encode_data_intent(stream_id, payload, length, end_stream, max_frame_size, connection_window, stream_window)
		Ok(OutboundDataAccepted(_, _, _, _, chunk)) => Ok(OutboundDataAccepted(stream_id, length, end_stream, data_sent_send_credit_with_content_length(stream_id, end_stream, debit_connection_window(connection_window, length)?, debit_stream_window(stream_window, length)?, expected_length, observed_length), chunk))
		Ok(OutboundDataRejected(_, _, _, error)) => Ok(OutboundDataRejected(stream_id, length, end_stream, error))
		Ok(OutboundDataEncodeFailed(_, _, _, error)) => Ok(OutboundDataEncodeFailed(stream_id, length, end_stream, error))
		Err(error) => Err(error)
	end
end

fn encode_single_data_intent(stream_id: Int, payload: ByteChunk, length: Int, end_stream: Bool, connection_window: Int, stream_window: Int) -> Result<OutboundDataDecision, String>
	let encoded_header: Result<ByteChunk, EncodeError> = encode_frame_header({length: length, kind: 0, flags: data_flags(end_stream), stream_id: stream_id})
	match encoded_header
		Ok(header) => Ok(OutboundDataAccepted(stream_id, length, end_stream, data_sent_send_credit(stream_id, end_stream, debit_connection_window(connection_window, length)?, debit_stream_window(stream_window, length)?), byte_append(header, payload)))
		Err(error) => Ok(OutboundDataEncodeFailed(stream_id, length, end_stream, error))
	end
end

fn encode_split_data_intent(stream_id: Int, payload: ByteChunk, length: Int, end_stream: Bool, max_frame_size: Int, connection_window: Int, stream_window: Int) -> Result<OutboundDataDecision, String>
	let chunk_count: ByteCount = byte_count(max_frame_size)?
	let first_payload: ByteChunk = byte_take(payload, chunk_count)?
	let remaining: ByteChunk = byte_drop(payload, chunk_count)?
	let encoded_header: Result<ByteChunk, EncodeError> = encode_frame_header({length: max_frame_size, kind: 0, flags: 0, stream_id: stream_id})
	match encoded_header
		Ok(header) => encode_remaining_data_frames(stream_id, length, end_stream, max_frame_size, connection_window, stream_window, remaining, byte_append(header, first_payload))
		Err(error) => Ok(OutboundDataEncodeFailed(stream_id, length, end_stream, error))
	end
end

fn encode_remaining_data_frames(stream_id: Int, length: Int, end_stream: Bool, max_frame_size: Int, connection_window: Int, stream_window: Int, remaining: ByteChunk, encoded: ByteChunk) -> Result<OutboundDataDecision, String>
	let remaining_length: Int = byte_count_to_int(byte_chunk_count(remaining))
	match remaining_length > max_frame_size
		true => encode_nonfinal_data_frame(stream_id, length, end_stream, max_frame_size, connection_window, stream_window, remaining, encoded)
		false => encode_final_data_frame(stream_id, length, end_stream, remaining_length, connection_window, stream_window, remaining, encoded)
	end
end

fn encode_nonfinal_data_frame(stream_id: Int, length: Int, end_stream: Bool, max_frame_size: Int, connection_window: Int, stream_window: Int, remaining: ByteChunk, encoded: ByteChunk) -> Result<OutboundDataDecision, String>
	let chunk_count: ByteCount = byte_count(max_frame_size)?
	let payload: ByteChunk = byte_take(remaining, chunk_count)?
	let next_remaining: ByteChunk = byte_drop(remaining, chunk_count)?
	let encoded_header: Result<ByteChunk, EncodeError> = encode_frame_header({length: max_frame_size, kind: 0, flags: 0, stream_id: stream_id})
	match encoded_header
		Ok(header) => encode_remaining_data_frames(stream_id, length, end_stream, max_frame_size, connection_window, stream_window, next_remaining, byte_append(byte_append(encoded, header), payload))
		Err(error) => Ok(OutboundDataEncodeFailed(stream_id, length, end_stream, error))
	end
end

fn encode_final_data_frame(stream_id: Int, length: Int, end_stream: Bool, final_length: Int, connection_window: Int, stream_window: Int, remaining: ByteChunk, encoded: ByteChunk) -> Result<OutboundDataDecision, String>
	let encoded_header: Result<ByteChunk, EncodeError> = encode_frame_header({length: final_length, kind: 0, flags: data_flags(end_stream), stream_id: stream_id})
	match encoded_header
		Ok(header) => Ok(OutboundDataAccepted(stream_id, length, end_stream, data_sent_send_credit(stream_id, end_stream, debit_connection_window(connection_window, length)?, debit_stream_window(stream_window, length)?), byte_append(byte_append(encoded, header), remaining)))
		Err(error) => Ok(OutboundDataEncodeFailed(stream_id, length, end_stream, error))
	end
end

fn encode_padded_data_intent(stream_id: Int, payload: ByteChunk, encoded_length: Int, padding_length: Int, end_stream: Bool, max_frame_size: Int, connection_window: Int, stream_window: Int) -> Result<OutboundDataDecision, String>
	let application_length: Int = byte_count_to_int(byte_chunk_count(payload))
	let max_application_frame_payload: Int = max_padded_application_frame_payload(max_frame_size, padding_length)
	match application_length > max_application_frame_payload
		true => encode_split_padded_data_intent(stream_id, payload, encoded_length, padding_length, end_stream, max_frame_size, max_application_frame_payload, connection_window, stream_window)
		false => encode_single_padded_data_intent(stream_id, payload, encoded_length, padding_length, end_stream, application_length + padding_length + 1, connection_window, stream_window)
	end
end

fn encode_padded_data_intent_with_content_length(stream_id: Int, payload: ByteChunk, encoded_length: Int, padding_length: Int, end_stream: Bool, max_frame_size: Int, connection_window: Int, stream_window: Int, expected_length: Int, observed_length: Int) -> Result<OutboundDataDecision, String>
	match encode_padded_data_intent(stream_id, payload, encoded_length, padding_length, end_stream, max_frame_size, connection_window, stream_window)
		Ok(OutboundDataAccepted(_, _, _, _, chunk)) => Ok(OutboundDataAccepted(stream_id, encoded_length, end_stream, data_sent_send_credit_with_content_length(stream_id, end_stream, debit_connection_window(connection_window, encoded_length)?, debit_stream_window(stream_window, encoded_length)?, expected_length, observed_length), chunk))
		Ok(OutboundDataRejected(_, _, _, error)) => Ok(OutboundDataRejected(stream_id, encoded_length, end_stream, error))
		Ok(OutboundDataEncodeFailed(_, _, _, error)) => Ok(OutboundDataEncodeFailed(stream_id, encoded_length, end_stream, error))
		Err(error) => Err(error)
	end
end

fn encode_single_padded_data_intent(stream_id: Int, payload: ByteChunk, encoded_length: Int, padding_length: Int, end_stream: Bool, frame_payload_length: Int, connection_window: Int, stream_window: Int) -> Result<OutboundDataDecision, String>
	let encoded_header: Result<ByteChunk, EncodeError> = encode_frame_header({length: frame_payload_length, kind: 0, flags: padded_data_flags(end_stream), stream_id: stream_id})
	match encoded_header
		Ok(header) => encode_single_padded_data_payload(stream_id, payload, encoded_length, padding_length, end_stream, connection_window, stream_window, header)
		Err(error) => Ok(OutboundDataEncodeFailed(stream_id, encoded_length, end_stream, error))
	end
end

fn encode_single_padded_data_payload(stream_id: Int, payload: ByteChunk, encoded_length: Int, padding_length: Int, end_stream: Bool, connection_window: Int, stream_window: Int, header: ByteChunk) -> Result<OutboundDataDecision, String>
	Ok(OutboundDataAccepted(stream_id, encoded_length, end_stream, data_sent_send_credit(stream_id, end_stream, debit_connection_window(connection_window, encoded_length)?, debit_stream_window(stream_window, encoded_length)?), byte_append(header, padded_data_payload(padding_length, payload)?)))
end

fn encode_split_padded_data_intent(stream_id: Int, payload: ByteChunk, encoded_length: Int, padding_length: Int, end_stream: Bool, max_frame_size: Int, max_application_frame_payload: Int, connection_window: Int, stream_window: Int) -> Result<OutboundDataDecision, String>
	let chunk_count: ByteCount = byte_count(max_application_frame_payload)?
	let first_payload: ByteChunk = byte_take(payload, chunk_count)?
	let remaining: ByteChunk = byte_drop(payload, chunk_count)?
	let encoded_header: Result<ByteChunk, EncodeError> = encode_frame_header({length: max_frame_size, kind: 0, flags: 8, stream_id: stream_id})
	match encoded_header
		Ok(header) => encode_remaining_padded_data_frames(stream_id, encoded_length, padding_length, end_stream, max_frame_size, max_application_frame_payload, connection_window, stream_window, remaining, byte_append(header, padded_data_payload(padding_length, first_payload)?))
		Err(error) => Ok(OutboundDataEncodeFailed(stream_id, encoded_length, end_stream, error))
	end
end

fn encode_remaining_padded_data_frames(stream_id: Int, encoded_length: Int, padding_length: Int, end_stream: Bool, max_frame_size: Int, max_application_frame_payload: Int, connection_window: Int, stream_window: Int, remaining: ByteChunk, encoded: ByteChunk) -> Result<OutboundDataDecision, String>
	let remaining_length: Int = byte_count_to_int(byte_chunk_count(remaining))
	match remaining_length > max_application_frame_payload
		true => encode_nonfinal_padded_data_frame(stream_id, encoded_length, padding_length, end_stream, max_frame_size, max_application_frame_payload, connection_window, stream_window, remaining, encoded)
		false => encode_final_padded_data_frame(stream_id, encoded_length, padding_length, end_stream, remaining_length, connection_window, stream_window, remaining, encoded)
	end
end

fn encode_nonfinal_padded_data_frame(stream_id: Int, encoded_length: Int, padding_length: Int, end_stream: Bool, max_frame_size: Int, max_application_frame_payload: Int, connection_window: Int, stream_window: Int, remaining: ByteChunk, encoded: ByteChunk) -> Result<OutboundDataDecision, String>
	let chunk_count: ByteCount = byte_count(max_application_frame_payload)?
	let payload: ByteChunk = byte_take(remaining, chunk_count)?
	let next_remaining: ByteChunk = byte_drop(remaining, chunk_count)?
	let encoded_header: Result<ByteChunk, EncodeError> = encode_frame_header({length: max_frame_size, kind: 0, flags: 8, stream_id: stream_id})
	match encoded_header
		Ok(header) => encode_remaining_padded_data_frames(stream_id, encoded_length, padding_length, end_stream, max_frame_size, max_application_frame_payload, connection_window, stream_window, next_remaining, byte_append(byte_append(encoded, header), padded_data_payload(padding_length, payload)?))
		Err(error) => Ok(OutboundDataEncodeFailed(stream_id, encoded_length, end_stream, error))
	end
end

fn encode_final_padded_data_frame(stream_id: Int, encoded_length: Int, padding_length: Int, end_stream: Bool, final_application_length: Int, connection_window: Int, stream_window: Int, remaining: ByteChunk, encoded: ByteChunk) -> Result<OutboundDataDecision, String>
	let encoded_header: Result<ByteChunk, EncodeError> = encode_frame_header({length: final_application_length + padding_length + 1, kind: 0, flags: padded_data_flags(end_stream), stream_id: stream_id})
	match encoded_header
		Ok(header) => Ok(OutboundDataAccepted(stream_id, encoded_length, end_stream, data_sent_send_credit(stream_id, end_stream, debit_connection_window(connection_window, encoded_length)?, debit_stream_window(stream_window, encoded_length)?), byte_append(byte_append(encoded, header), padded_data_payload(padding_length, remaining)?)))
		Err(error) => Ok(OutboundDataEncodeFailed(stream_id, encoded_length, end_stream, error))
	end
end

fn padded_data_payload(padding_length: Int, application_payload: ByteChunk) -> Result<ByteChunk, String>
	Ok(byte_append(byte_write_u8_be(padding_length)?, byte_append(application_payload, zero_padding_bytes(padding_length)?)))
end

fn zero_padding_bytes(length: Int) -> Result<ByteChunk, String>
	match length
		0 => Ok(byte_chunk([]))
		_ => Ok(byte_append(byte_write_u8_be(0)?, zero_padding_bytes(length - 1)?))
	end
end

fn data_flags(end_stream: Bool) -> Int
	match end_stream
		true => 1
		false => 0
	end
end

fn padded_data_flags(end_stream: Bool) -> Int
	data_flags(end_stream) + 8
end

fn data_sent_send_credit(stream_id: Int, end_stream: Bool, connection_window: Int, stream_window: Int) -> OutboundSendCredit
	match end_stream
		true => OutboundSendCredit(connection_window, Cons(OutboundReceiveCreditClosedStream(stream_id), Nil))
		false => OutboundSendCredit(connection_window, Cons(OutboundReceiveCreditOpenStream(stream_id, stream_window), Nil))
	end
end

fn data_sent_send_credit_with_content_length(stream_id: Int, end_stream: Bool, connection_window: Int, stream_window: Int, expected_length: Int, observed_length: Int) -> OutboundSendCredit
	match end_stream
		true => OutboundSendCredit(connection_window, Cons(OutboundReceiveCreditClosedStream(stream_id), Nil))
		false => OutboundSendCredit(connection_window, Cons(OutboundReceiveCreditOpenStreamContentLength(stream_id, stream_window, expected_length, observed_length), Nil))
	end
end

fn send_connection_window_update(increment: Int, receive_credit: OutboundReceiveCredit) -> Result<OutboundWindowUpdateDecision, String>
	match validate_outbound_window_update_increment(0, increment, "connection-flow-control")
		OutboundWindowUpdateIncrementOk => validate_connection_window_update_bound(increment, receive_credit)
		OutboundWindowUpdateIncrementFailed(error) => Ok(OutboundWindowUpdateRejected(error))
	end
end

fn send_stream_window_update(stream_id: Int, increment: Int, receive_credit: OutboundReceiveCredit) -> Result<OutboundWindowUpdateDecision, String>
	send_stream_window_update_with_shutdown(stream_id, increment, OpenConnection, receive_credit)
end

fn send_stream_window_update_with_shutdown(stream_id: Int, increment: Int, shutdown_state: ConnectionShutdownState, receive_credit: OutboundReceiveCredit) -> Result<OutboundWindowUpdateDecision, String>
	match stream_id
		0 => Ok(OutboundWindowUpdateRejected(InvalidStreamId(0, 8, stream_id, "nonzero open stream id", "local", "stream-id-domain", "outbound_window_update_requires_open_stream")))
		_ => match validate_outbound_window_update_increment(stream_id, increment, "open-stream")
			OutboundWindowUpdateIncrementOk => send_valid_stream_window_update(stream_id, increment, shutdown_state, receive_credit)
			OutboundWindowUpdateIncrementFailed(error) => Ok(OutboundWindowUpdateRejected(error))
		end
	end
end

fn validate_connection_window_update_bound(increment: Int, receive_credit: OutboundReceiveCredit) -> Result<OutboundWindowUpdateDecision, String>
	match receive_credit
		OutboundReceiveCredit(connection_window, stream_credit) => match connection_window_credit(connection_window + increment)
			Err(_) => Ok(OutboundWindowUpdateRejected(FlowControlWindowExceeded(0, 8, 0, increment, max_receive_flow_control_window() - connection_window, "connection-flow-control", "outbound_connection_receive_window", empty_header_block())))
			Ok(next_credit) => encode_window_update_intent(0, increment, OutboundReceiveCredit(connection_window_credit_value(next_credit), stream_credit))
		end
	end
end

fn send_valid_stream_window_update(stream_id: Int, increment: Int, shutdown_state: ConnectionShutdownState, receive_credit: OutboundReceiveCredit) -> Result<OutboundWindowUpdateDecision, String>
	match receive_credit
		OutboundReceiveCredit(connection_window, NoOutboundReceiveCreditStream) => Ok(OutboundWindowUpdateRejected(InvalidFrameKind(0, 8, stream_id, 1, "idle-stream", "idle_streams_require_headers")))
		OutboundReceiveCredit(connection_window, OutboundReceiveCreditOpenStream(open_stream_id, stream_window)) => match stream_id == open_stream_id
			true => validate_stream_window_update_after_goaway(stream_id, increment, shutdown_state, connection_window, open_stream_id, stream_window)
			false => Ok(OutboundWindowUpdateRejected(InvalidFrameKind(0, 8, stream_id, 1, "idle-stream", "idle_streams_require_headers")))
		end
		OutboundReceiveCredit(connection_window, OutboundReceiveCreditOpenStreamContentLength(open_stream_id, stream_window, _, _)) => match stream_id == open_stream_id
			true => validate_stream_window_update_after_goaway(stream_id, increment, shutdown_state, connection_window, open_stream_id, stream_window)
			false => Ok(OutboundWindowUpdateRejected(InvalidFrameKind(0, 8, stream_id, 1, "idle-stream", "idle_streams_require_headers")))
		end
		OutboundReceiveCredit(connection_window, OutboundReceiveCreditClosedStream(closed_stream_id)) => match stream_id == closed_stream_id
			true => Ok(OutboundWindowUpdateRejected(InvalidFrameKind(0, 8, stream_id, 1, "closed-stream", "closed_stream_rejects_later_frames")))
			false => Ok(OutboundWindowUpdateRejected(InvalidFrameKind(0, 8, stream_id, 1, "idle-stream", "idle_streams_require_headers")))
		end
		OutboundReceiveCredit(connection_window, OutboundReceiveCreditResetStream(reset_stream_id, _)) => match stream_id == reset_stream_id
			true => Ok(OutboundWindowUpdateRejected(InvalidFrameKind(0, 8, stream_id, 1, "reset-stream", "reset_stream_rejects_later_frames")))
			false => Ok(OutboundWindowUpdateRejected(InvalidFrameKind(0, 8, stream_id, 1, "idle-stream", "idle_streams_require_headers")))
		end
	end
end

fn validate_stream_window_update_after_goaway(stream_id: Int, increment: Int, shutdown_state: ConnectionShutdownState, connection_window: Int, open_stream_id: Int, stream_window: Int) -> Result<OutboundWindowUpdateDecision, String>
	match shutdown_state
		OpenConnection => validate_stream_window_update_bound(stream_id, increment, connection_window, open_stream_id, stream_window)
		GracefulShutdown(last_stream_id, _) => match stream_id > last_stream_id
			true => Ok(OutboundWindowUpdateRejected(StreamAfterGoaway(0, stream_id, last_stream_id, "graceful_shutdown", "local", "goaway_last_stream_id", empty_header_block())))
			false => validate_stream_window_update_bound(stream_id, increment, connection_window, open_stream_id, stream_window)
		end
		DrainedShutdown(last_stream_id, _) => match stream_id > last_stream_id
			true => Ok(OutboundWindowUpdateRejected(StreamAfterGoaway(0, stream_id, last_stream_id, "drained_shutdown", "local", "goaway_last_stream_id", empty_header_block())))
			false => validate_stream_window_update_bound(stream_id, increment, connection_window, open_stream_id, stream_window)
		end
	end
end

fn validate_stream_window_update_bound(stream_id: Int, increment: Int, connection_window: Int, open_stream_id: Int, stream_window: Int) -> Result<OutboundWindowUpdateDecision, String>
	match stream_window_credit(stream_window + increment)
		Err(_) => Ok(OutboundWindowUpdateRejected(FlowControlWindowExceeded(0, 8, stream_id, increment, max_receive_flow_control_window() - stream_window, "open-stream", "outbound_stream_receive_window", empty_header_block())))
		Ok(next_credit) => encode_window_update_intent(stream_id, increment, OutboundReceiveCredit(connection_window, OutboundReceiveCreditOpenStream(open_stream_id, stream_window_credit_value(next_credit))))
	end
end

fn validate_outbound_window_update_increment(stream_id: Int, increment: Int, active_state: String) -> OutboundWindowUpdateIncrementDecision
	match window_update_increment_value(increment)
		Ok(_) => OutboundWindowUpdateIncrementOk
		Err(_) => match increment == 0
			true => OutboundWindowUpdateIncrementFailed(FlowControlWindowExceeded(0, 8, stream_id, increment, 1, active_state, "window_update_increment_nonzero", empty_header_block()))
			false => match increment < 0
				true => OutboundWindowUpdateIncrementFailed(FlowControlWindowExceeded(0, 8, stream_id, increment, 1, active_state, "window_update_increment_range", empty_header_block()))
				false => OutboundWindowUpdateIncrementFailed(FlowControlWindowExceeded(0, 8, stream_id, increment, max_receive_flow_control_window(), active_state, "window_update_increment_range", empty_header_block()))
			end
		end
	end
end

fn encode_window_update_intent(stream_id: Int, increment: Int, receive_credit: OutboundReceiveCredit) -> Result<OutboundWindowUpdateDecision, String>
	let encoded_header: Result<ByteChunk, EncodeError> = encode_frame_header({length: 4, kind: 8, flags: 0, stream_id: stream_id})
	match encoded_header
		Ok(header) => encode_window_update_payload_intent(stream_id, increment, receive_credit, header)
		Err(error) => Ok(OutboundWindowUpdateEncodeFailed(error))
	end
end

fn encode_window_update_payload_intent(stream_id: Int, increment: Int, receive_credit: OutboundReceiveCredit, header: ByteChunk) -> Result<OutboundWindowUpdateDecision, String>
	let encoded_payload: Result<ByteChunk, EncodeError> = encode_window_update_payload({increment: increment})
	match encoded_payload
		Ok(payload) => Ok(OutboundWindowUpdateAccepted(stream_id, increment, receive_credit, byte_append(header, payload)))
		Err(error) => Ok(OutboundWindowUpdateEncodeFailed(error))
	end
end

fn refill_outbound_send_credit_from_received_window_update(step: Http2Step, send_credit: OutboundSendCredit) -> Result<OutboundSendCreditUpdateDecision, String>
	match step
		FrameDecoded(_, offset, length, kind, _, stream_id, _, KnownFrame(_, _, _, payload)) => match kind == 8
			true => match length == 4
				true => refill_outbound_send_credit(offset, stream_id, byte_read_u31_be(payload)?, byte_view_to_chunk(payload), send_credit)
				false => Ok(OutboundSendCreditUnchanged(send_credit))
			end
			false => Ok(OutboundSendCreditUnchanged(send_credit))
		end
		FrameDecoded(_, _, _, _, _, _, _, _) => Ok(OutboundSendCreditUnchanged(send_credit))
		Waiting(_) => Ok(OutboundSendCreditUnchanged(send_credit))
		Failed(_, _) => Ok(OutboundSendCreditUnchanged(send_credit))
	end
end

fn update_outbound_send_credit_from_received_settings(step: Http2Step, peer_settings: PeerSettingsState, send_credit: OutboundSendCredit) -> Result<OutboundSendCreditUpdateDecision, String>
	match step
		FrameDecoded(_, _, length, kind, flags, _, _, KnownFrame(_, _, _, payload)) => match kind == 4
			true => match settings_ack_set(flags)
				true => Ok(OutboundSendCreditUnchanged(send_credit))
				false => match settings_payload_has_complete_items(length)
					true => update_outbound_send_credit_from_settings_items(byte_view_to_chunk(payload), 0, length, peer_settings, OutboundSendCreditUnchanged(send_credit))
					false => Ok(OutboundSendCreditUnchanged(send_credit))
				end
			end
			false => Ok(OutboundSendCreditUnchanged(send_credit))
		end
		FrameDecoded(_, _, _, _, _, _, _, _) => Ok(OutboundSendCreditUnchanged(send_credit))
		Waiting(_) => Ok(OutboundSendCreditUnchanged(send_credit))
		Failed(_, _) => Ok(OutboundSendCreditUnchanged(send_credit))
	end
end

fn update_outbound_send_credit_from_settings_items(payload: ByteChunk, item_offset: Int, payload_end_offset: Int, peer_settings: PeerSettingsState, decision: OutboundSendCreditUpdateDecision) -> Result<OutboundSendCreditUpdateDecision, String>
	match item_offset == payload_end_offset
		true => Ok(decision)
		false => update_outbound_send_credit_from_settings_items(payload, item_offset + 6, payload_end_offset, update_single_settings_payload_item(payload, item_offset, peer_settings)?, update_single_initial_window_send_credit(payload, item_offset, peer_settings, decision)?)
	end
end

fn update_single_settings_payload_item(payload: ByteChunk, item_offset: Int, peer_settings: PeerSettingsState) -> Result<PeerSettingsState, String>
	let item: ByteView = byte_view(payload, byte_offset(item_offset)?, byte_count(6)?)?
	let identifier: Int = byte_read_u16_be(byte_view(byte_view_to_chunk(item), byte_offset(0)?, byte_count(2)?)?)?
	let value: Int = byte_read_u32_be(byte_view(byte_view_to_chunk(item), byte_offset(2)?, byte_count(4)?)?)?
	match peer_settings
		PeerSettings(max_frame_size, initial_window_size, enable_push, max_concurrent_streams, header_table_size, max_header_list_size, local_enable_push, highest_peer_stream_id) => match identifier
			5 => Ok(PeerSettings(PeerMaxFrameSize(value, item_offset), initial_window_size, enable_push, max_concurrent_streams, header_table_size, max_header_list_size, local_enable_push, highest_peer_stream_id))
			4 => Ok(PeerSettings(max_frame_size, PeerInitialWindowSize(value, item_offset), enable_push, max_concurrent_streams, header_table_size, max_header_list_size, local_enable_push, highest_peer_stream_id))
			2 => Ok(PeerSettings(max_frame_size, initial_window_size, with_peer_enable_push(enable_push, value, item_offset), max_concurrent_streams, header_table_size, max_header_list_size, local_enable_push, highest_peer_stream_id))
			3 => Ok(PeerSettings(max_frame_size, initial_window_size, enable_push, PeerMaxConcurrentStreams(value, item_offset), header_table_size, max_header_list_size, local_enable_push, highest_peer_stream_id))
			1 => Ok(PeerSettings(max_frame_size, initial_window_size, enable_push, max_concurrent_streams, PeerHeaderTableSize(value, item_offset), max_header_list_size, local_enable_push, highest_peer_stream_id))
			6 => Ok(PeerSettings(max_frame_size, initial_window_size, enable_push, max_concurrent_streams, header_table_size, PeerMaxHeaderListSize(value, item_offset), local_enable_push, highest_peer_stream_id))
			8 => Ok(PeerSettings(max_frame_size, initial_window_size, with_peer_enable_connect_protocol(enable_push, value, item_offset), max_concurrent_streams, header_table_size, max_header_list_size, local_enable_push, highest_peer_stream_id))
			_ => Ok(peer_settings)
		end
	end
end

fn update_single_initial_window_send_credit(payload: ByteChunk, item_offset: Int, peer_settings: PeerSettingsState, decision: OutboundSendCreditUpdateDecision) -> Result<OutboundSendCreditUpdateDecision, String>
	let item: ByteView = byte_view(payload, byte_offset(item_offset)?, byte_count(6)?)?
	let identifier: Int = byte_read_u16_be(byte_view(byte_view_to_chunk(item), byte_offset(0)?, byte_count(2)?)?)?
	let value: Int = byte_read_u32_be(byte_view(byte_view_to_chunk(item), byte_offset(2)?, byte_count(4)?)?)?
	match identifier
		4 => match initial_window_size(value)
			Ok(size) => Ok(OutboundSendCreditUpdated(apply_initial_window_delta_to_outbound_send_credit(initial_window_size_value(size) - active_peer_initial_window_size(peer_settings), outbound_send_credit_update_credit(decision))?))
			Err(_) => Err("validated initial window size is outside the HTTP/2 domain")
		end
		_ => Ok(decision)
	end
end

fn apply_initial_window_delta_to_outbound_send_credit(delta: Int, send_credit: OutboundSendCredit) -> Result<OutboundSendCredit, String>
	match send_credit
		OutboundSendCredit(connection_window, streams) => Ok(OutboundSendCredit(connection_window, apply_initial_window_delta_to_outbound_streams(delta, streams)?))
	end
end

fn apply_initial_window_delta_to_outbound_streams(delta: Int, streams: List<OutboundReceiveCreditStream>) -> Result<List<OutboundReceiveCreditStream>, String>
	match streams
		Nil => Ok(Nil)
		Cons(stream, tail) => match stream
			NoOutboundReceiveCreditStream => Ok(Cons(stream, apply_initial_window_delta_to_outbound_streams(delta, tail)?))
			OutboundReceiveCreditOpenStream(stream_id, stream_window) => Ok(Cons(OutboundReceiveCreditOpenStream(stream_id, checked_stream_window_credit_value(stream_window + delta)?), apply_initial_window_delta_to_outbound_streams(delta, tail)?))
			OutboundReceiveCreditOpenStreamContentLength(stream_id, stream_window, expected_length, observed_length) => Ok(Cons(OutboundReceiveCreditOpenStreamContentLength(stream_id, checked_stream_window_credit_value(stream_window + delta)?, expected_length, observed_length), apply_initial_window_delta_to_outbound_streams(delta, tail)?))
			OutboundReceiveCreditClosedStream(_) => Ok(Cons(stream, apply_initial_window_delta_to_outbound_streams(delta, tail)?))
			OutboundReceiveCreditResetStream(_, _) => Ok(Cons(stream, apply_initial_window_delta_to_outbound_streams(delta, tail)?))
		end
	end
end

fn refill_outbound_send_credit(offset: Int, stream_id: Int, increment: Int, preview: ByteChunk, send_credit: OutboundSendCredit) -> Result<OutboundSendCreditUpdateDecision, String>
	match stream_id
		0 => refill_outbound_connection_send_credit(offset, increment, preview, send_credit)
		_ => refill_outbound_stream_send_credit(offset, stream_id, increment, preview, send_credit)
	end
end

fn refill_outbound_connection_send_credit(offset: Int, increment: Int, preview: ByteChunk, send_credit: OutboundSendCredit) -> Result<OutboundSendCreditUpdateDecision, String>
	match send_credit
		OutboundSendCredit(connection_window, stream_credit) => match window_update_increment_is_invalid(increment)
			true => Ok(OutboundSendCreditUpdateRejected(InvalidWindowUpdateIncrement(offset, 0, increment, 1, max_receive_flow_control_window(), "connection-flow-control", "window_update_increment_nonzero", byte_chunk_view(preview)?)))
			false => match connection_window_refill_overflows(connection_window, increment)
				true => Ok(OutboundSendCreditUpdateRejected(FlowControlWindowExceeded(offset, 8, 0, increment, max_receive_flow_control_window() - connection_window, "connection-flow-control", "outbound_connection_window", preview)))
				false => Ok(OutboundSendCreditUpdated(OutboundSendCredit(refilled_connection_window(connection_window, increment), stream_credit)))
			end
		end
	end
end

fn refill_outbound_stream_send_credit(offset: Int, stream_id: Int, increment: Int, preview: ByteChunk, send_credit: OutboundSendCredit) -> Result<OutboundSendCreditUpdateDecision, String>
	match send_credit
		OutboundSendCredit(connection_window, streams) => refill_outbound_stream_send_credit_in_list(offset, stream_id, increment, preview, connection_window, streams)
	end
end

fn refill_outbound_stream_send_credit_in_list(offset: Int, stream_id: Int, increment: Int, preview: ByteChunk, connection_window: Int, streams: List<OutboundReceiveCreditStream>) -> Result<OutboundSendCreditUpdateDecision, String>
	match streams
		Nil => Ok(OutboundSendCreditUpdateRejected(InvalidFrameKind(offset, 8, stream_id, 1, "idle-stream", "idle_streams_require_headers")))
		Cons(stream, tail) => match stream
			NoOutboundReceiveCreditStream => prepend_outbound_stream_update(stream, refill_outbound_stream_send_credit_in_list(offset, stream_id, increment, preview, connection_window, tail)?)
			OutboundReceiveCreditOpenStream(open_stream_id, stream_window) => match stream_id == open_stream_id
				false => prepend_outbound_stream_update(stream, refill_outbound_stream_send_credit_in_list(offset, stream_id, increment, preview, connection_window, tail)?)
				true => match window_update_increment_is_invalid(increment)
					true => Ok(OutboundSendCreditUpdateRejected(InvalidWindowUpdateIncrement(offset, stream_id, increment, 1, max_receive_flow_control_window(), "open-stream", "window_update_increment_nonzero", byte_chunk_view(preview)?)))
					false => match stream_window_refill_overflows(stream_window, increment)
						true => Ok(OutboundSendCreditUpdateRejected(FlowControlWindowExceeded(offset, 8, stream_id, increment, max_receive_flow_control_window() - stream_window, "open-stream", "outbound_stream_window", preview)))
						false => Ok(OutboundSendCreditUpdated(OutboundSendCredit(connection_window, Cons(OutboundReceiveCreditOpenStream(open_stream_id, refilled_stream_window(stream_window, increment)), tail))))
					end
				end
			end
			OutboundReceiveCreditOpenStreamContentLength(open_stream_id, stream_window, expected_length, observed_length) => match stream_id == open_stream_id
				false => prepend_outbound_stream_update(stream, refill_outbound_stream_send_credit_in_list(offset, stream_id, increment, preview, connection_window, tail)?)
				true => match window_update_increment_is_invalid(increment)
					true => Ok(OutboundSendCreditUpdateRejected(InvalidWindowUpdateIncrement(offset, stream_id, increment, 1, max_receive_flow_control_window(), "open-stream", "window_update_increment_nonzero", byte_chunk_view(preview)?)))
					false => match stream_window_refill_overflows(stream_window, increment)
						true => Ok(OutboundSendCreditUpdateRejected(FlowControlWindowExceeded(offset, 8, stream_id, increment, max_receive_flow_control_window() - stream_window, "open-stream", "outbound_stream_window", preview)))
						false => Ok(OutboundSendCreditUpdated(OutboundSendCredit(connection_window, Cons(OutboundReceiveCreditOpenStreamContentLength(open_stream_id, refilled_stream_window(stream_window, increment), expected_length, observed_length), tail))))
					end
				end
			end
			OutboundReceiveCreditClosedStream(closed_stream_id) => match stream_id == closed_stream_id
				true => Ok(OutboundSendCreditUpdateRejected(InvalidFrameKind(offset, 8, stream_id, 1, "closed-stream", "closed_stream_rejects_later_frames")))
				false => prepend_outbound_stream_update(stream, refill_outbound_stream_send_credit_in_list(offset, stream_id, increment, preview, connection_window, tail)?)
			end
			OutboundReceiveCreditResetStream(reset_stream_id, _) => match stream_id == reset_stream_id
				true => Ok(OutboundSendCreditUpdateRejected(InvalidFrameKind(offset, 8, stream_id, 1, "reset-stream", "reset_stream_rejects_later_frames")))
				false => prepend_outbound_stream_update(stream, refill_outbound_stream_send_credit_in_list(offset, stream_id, increment, preview, connection_window, tail)?)
			end
		end
	end
end

fn prepend_outbound_stream_update(stream: OutboundReceiveCreditStream, decision: OutboundSendCreditUpdateDecision) -> Result<OutboundSendCreditUpdateDecision, String>
	match decision
		OutboundSendCreditUpdated(OutboundSendCredit(connection_window, streams)) => Ok(OutboundSendCreditUpdated(OutboundSendCredit(connection_window, Cons(stream, streams))))
		OutboundSendCreditUnchanged(OutboundSendCredit(connection_window, streams)) => Ok(OutboundSendCreditUnchanged(OutboundSendCredit(connection_window, Cons(stream, streams))))
		OutboundSendCreditUpdateRejected(_) => Ok(decision)
	end
end

fn apply_initial_window_delta(delta: Int, receive_flow_control: ReceiveFlowControl) -> Result<ReceiveFlowControl, String>
	match receive_flow_control
		ReceiveFlowControl(connection_window, NoOpenStreamReceiveWindow) => Ok(ReceiveFlowControl(connection_window, NoOpenStreamReceiveWindow))
		ReceiveFlowControl(connection_window, OpenStreamReceiveWindow(stream_id, stream_window, priority)) => Ok(ReceiveFlowControl(connection_window, OpenStreamReceiveWindow(stream_id, checked_stream_window_credit_value(stream_window + delta)?, priority)))
		ReceiveFlowControl(connection_window, TwoOpenStreamReceiveWindows(first_stream_id, first_stream_window, first_priority, second_stream_id, second_stream_window, second_priority)) => Ok(ReceiveFlowControl(connection_window, TwoOpenStreamReceiveWindows(first_stream_id, checked_stream_window_credit_value(first_stream_window + delta)?, first_priority, second_stream_id, checked_stream_window_credit_value(second_stream_window + delta)?, second_priority)))
		ReceiveFlowControl(connection_window, ThreeOpenStreamReceiveWindows(first_stream_id, first_stream_window, first_priority, second_stream_id, second_stream_window, second_priority, third_stream_id, third_stream_window, third_priority)) => Ok(ReceiveFlowControl(connection_window, ThreeOpenStreamReceiveWindows(first_stream_id, checked_stream_window_credit_value(first_stream_window + delta)?, first_priority, second_stream_id, checked_stream_window_credit_value(second_stream_window + delta)?, second_priority, third_stream_id, checked_stream_window_credit_value(third_stream_window + delta)?, third_priority)))
		ReceiveFlowControl(connection_window, ClientPushAssociatedStreamReceiveWindow(stream_id, stream_window, priority, promised_stream_id)) => Ok(ReceiveFlowControl(connection_window, ClientPushAssociatedStreamReceiveWindow(stream_id, checked_stream_window_credit_value(stream_window + delta)?, priority, promised_stream_id)))
		ReceiveFlowControl(connection_window, HalfClosedLocalStreamReceiveWindow(stream_id, stream_window, priority)) => Ok(ReceiveFlowControl(connection_window, HalfClosedLocalStreamReceiveWindow(stream_id, checked_stream_window_credit_value(stream_window + delta)?, priority)))
		ReceiveFlowControl(connection_window, ClosedByPeerStreamReceiveWindow(stream_id, stream_window)) => Ok(ReceiveFlowControl(connection_window, ClosedByPeerStreamReceiveWindow(stream_id, stream_window)))
		ReceiveFlowControl(connection_window, ResetStreamReceiveWindow(stream_id, error_code)) => Ok(ReceiveFlowControl(connection_window, ResetStreamReceiveWindow(stream_id, error_code)))
	end
end

fn record_local_end_stream(state: Http2DecodeState, stream_id: Int) -> Http2DecodeState
	match state
		State(pending, next_offset, preface_state, continuation, hpack_state, receive_limit, peer_settings, shutdown_state, ReceiveFlowControl(connection_window, OpenStreamReceiveWindow(open_stream_id, stream_window, priority)), peer_stream_admission) => match stream_id == open_stream_id
			true => State(pending, next_offset, preface_state, continuation, hpack_state, receive_limit, peer_settings, shutdown_state, ReceiveFlowControl(connection_window, HalfClosedLocalStreamReceiveWindow(open_stream_id, stream_window, priority)), peer_stream_admission)
			false => state
		end
		State(pending, next_offset, preface_state, continuation, hpack_state, receive_limit, peer_settings, shutdown_state, ReceiveFlowControl(connection_window, ClientPushAssociatedStreamReceiveWindow(open_stream_id, stream_window, priority, _)), peer_stream_admission) => match stream_id == open_stream_id
			true => State(pending, next_offset, preface_state, continuation, hpack_state, receive_limit, peer_settings, shutdown_state, ReceiveFlowControl(connection_window, HalfClosedLocalStreamReceiveWindow(open_stream_id, stream_window, priority)), peer_stream_admission)
			false => state
		end
		State(_, _, _, _, _, _, _, _, _, _) => state
	end
end

fn update_shutdown_state(pending: ByteChunk, offset: Int, length: Int, kind: Int, shutdown_state: ConnectionShutdownState, receive_flow_control: ReceiveFlowControl) -> Result<ShutdownStateDecision, String>
	match kind
		7 => match length == 8
			true => validate_goaway_shutdown_update(offset, decode_goaway_state(pending)?, shutdown_state, receive_flow_control, pending)
			false => Ok(ShutdownStateOk(complete_shutdown_drain(shutdown_state, receive_flow_control)))
		end
		_ => Ok(ShutdownStateOk(complete_shutdown_drain(shutdown_state, receive_flow_control)))
	end
end

fn validate_goaway_shutdown_update(offset: Int, decoded_shutdown: ConnectionShutdownState, shutdown_state: ConnectionShutdownState, receive_flow_control: ReceiveFlowControl, preview_chunk: ByteChunk) -> Result<ShutdownStateDecision, String>
	match decoded_shutdown
		OpenConnection => Ok(ShutdownStateOk(shutdown_state))
		GracefulShutdown(new_last_stream_id, new_error_code) => match shutdown_state
			OpenConnection => Ok(ShutdownStateOk(complete_shutdown_drain(GracefulShutdown(new_last_stream_id, new_error_code), receive_flow_control)))
			GracefulShutdown(current_last_stream_id, _) => match new_last_stream_id > current_last_stream_id
				true => Ok(ShutdownStateFailed(StreamAfterGoaway(offset, new_last_stream_id, current_last_stream_id, "graceful_shutdown", "server", "goaway_last_stream_id", preview_chunk)))
				false => Ok(ShutdownStateOk(complete_shutdown_drain(GracefulShutdown(new_last_stream_id, new_error_code), receive_flow_control)))
			end
			DrainedShutdown(current_last_stream_id, _) => match new_last_stream_id > current_last_stream_id
				true => Ok(ShutdownStateFailed(StreamAfterGoaway(offset, new_last_stream_id, current_last_stream_id, "drained_shutdown", "server", "goaway_last_stream_id", preview_chunk)))
				false => Ok(ShutdownStateOk(DrainedShutdown(new_last_stream_id, new_error_code)))
			end
		end
		DrainedShutdown(new_last_stream_id, new_error_code) => Ok(ShutdownStateOk(DrainedShutdown(new_last_stream_id, new_error_code)))
	end
end

fn decode_goaway_state(pending: ByteChunk) -> Result<ConnectionShutdownState, String>
	let last_stream_offset: ByteOffset = byte_offset(9)?
	let error_code_offset: ByteOffset = byte_offset(13)?
	let field_count: ByteCount = byte_count(4)?
	let last_stream_view: ByteView = byte_view(pending, last_stream_offset, field_count)?
	let error_code_view: ByteView = byte_view(pending, error_code_offset, field_count)?
	let last_stream_id: Int = byte_read_u31_be(last_stream_view)?
	let error_code: Int = byte_read_u32_be(error_code_view)?
	Ok(GracefulShutdown(last_stream_id, error_code))
end

fn complete_shutdown_drain(shutdown_state: ConnectionShutdownState, receive_flow_control: ReceiveFlowControl) -> ConnectionShutdownState
	match shutdown_state
		OpenConnection => OpenConnection
		GracefulShutdown(last_stream_id, error_code) => match receive_flow_control_has_active_in_boundary_stream(receive_flow_control, last_stream_id)
			true => GracefulShutdown(last_stream_id, error_code)
			false => DrainedShutdown(last_stream_id, error_code)
		end
		DrainedShutdown(last_stream_id, error_code) => DrainedShutdown(last_stream_id, error_code)
	end
end

fn receive_flow_control_has_active_in_boundary_stream(receive_flow_control: ReceiveFlowControl, last_stream_id: Int) -> Bool
	match receive_flow_control
		ReceiveFlowControl(_, NoOpenStreamReceiveWindow) => false
		ReceiveFlowControl(_, OpenStreamReceiveWindow(stream_id, _, _)) => stream_id <= last_stream_id
		ReceiveFlowControl(_, TwoOpenStreamReceiveWindows(first_stream_id, _, _, second_stream_id, _, _)) => first_stream_id <= last_stream_id or second_stream_id <= last_stream_id
		ReceiveFlowControl(_, ThreeOpenStreamReceiveWindows(first_stream_id, _, _, second_stream_id, _, _, third_stream_id, _, _)) => first_stream_id <= last_stream_id or second_stream_id <= last_stream_id or third_stream_id <= last_stream_id
		ReceiveFlowControl(_, ClientPushAssociatedStreamReceiveWindow(stream_id, _, _, promised_stream_id)) => stream_id <= last_stream_id or (promised_stream_id > 0 and promised_stream_id <= last_stream_id)
		ReceiveFlowControl(_, HalfClosedLocalStreamReceiveWindow(stream_id, _, _)) => stream_id <= last_stream_id
		ReceiveFlowControl(_, ClosedByPeerStreamReceiveWindow(_, _)) => false
		ReceiveFlowControl(_, ResetStreamReceiveWindow(_, _)) => false
	end
end

fn complete_shutdown_drain_after_outbound_send(shutdown_state: ConnectionShutdownState, send_credit: OutboundSendCredit) -> ConnectionShutdownState
	match send_credit
		OutboundSendCredit(_, streams) => complete_shutdown_drain_after_outbound_streams(shutdown_state, streams)
	end
end

fn complete_shutdown_drain_after_outbound_streams(shutdown_state: ConnectionShutdownState, streams: List<OutboundReceiveCreditStream>) -> ConnectionShutdownState
	match shutdown_state
		OpenConnection => OpenConnection
		GracefulShutdown(last_stream_id, error_code) => match outbound_streams_have_active_in_boundary_stream(streams, last_stream_id)
			true => GracefulShutdown(last_stream_id, error_code)
			false => DrainedShutdown(last_stream_id, error_code)
		end
		DrainedShutdown(last_stream_id, error_code) => DrainedShutdown(last_stream_id, error_code)
	end
end

fn outbound_streams_have_active_in_boundary_stream(streams: List<OutboundReceiveCreditStream>, last_stream_id: Int) -> Bool
	match streams
		Nil => false
		Cons(stream, tail) => outbound_stream_credit_has_active_in_boundary_stream(stream, last_stream_id) or outbound_streams_have_active_in_boundary_stream(tail, last_stream_id)
	end
end

fn complete_shutdown_drain_after_outbound_receive(shutdown_state: ConnectionShutdownState, receive_credit: OutboundReceiveCredit) -> ConnectionShutdownState
	match receive_credit
		OutboundReceiveCredit(_, stream_credit) => complete_shutdown_drain_after_outbound_stream_credit(shutdown_state, stream_credit)
	end
end

fn complete_shutdown_drain_after_outbound_stream_credit(shutdown_state: ConnectionShutdownState, stream_credit: OutboundReceiveCreditStream) -> ConnectionShutdownState
	match shutdown_state
		OpenConnection => OpenConnection
		GracefulShutdown(last_stream_id, error_code) => match outbound_stream_credit_has_active_in_boundary_stream(stream_credit, last_stream_id)
			true => GracefulShutdown(last_stream_id, error_code)
			false => DrainedShutdown(last_stream_id, error_code)
		end
		DrainedShutdown(last_stream_id, error_code) => DrainedShutdown(last_stream_id, error_code)
	end
end

fn outbound_stream_credit_has_active_in_boundary_stream(stream_credit: OutboundReceiveCreditStream, last_stream_id: Int) -> Bool
	match stream_credit
		NoOutboundReceiveCreditStream => false
		OutboundReceiveCreditOpenStream(stream_id, _) => stream_id <= last_stream_id
		OutboundReceiveCreditOpenStreamContentLength(stream_id, _, _, _) => stream_id <= last_stream_id
		OutboundReceiveCreditClosedStream(_) => false
		OutboundReceiveCreditResetStream(_, _) => false
	end
end

fn validate_continuation(continuation: PendingContinuation, offset: Int, payload: ByteChunk, kind: Int, flags: Int, stream_id: Int, promised_stream_id: Int, peer_settings: PeerSettingsState, receive_flow_control: ReceiveFlowControl, header_preview: ByteChunk) -> Result<ContinuationDecision, Http2ProtocolFailure>
	match continuation
		NoContinuation => validate_without_continuation(offset, payload, kind, flags, stream_id, promised_stream_id, peer_settings, receive_flow_control)
		Continuation(expected_stream, started_kind, started_offset, started_flags, started_is_trailer, pending_promised_stream_id, accumulated) => validate_with_continuation(expected_stream, started_kind, started_offset, started_flags, started_is_trailer, pending_promised_stream_id, accumulated, offset, payload, kind, flags, stream_id, header_preview)
	end
end

fn validate_without_continuation(offset: Int, payload: ByteChunk, kind: Int, flags: Int, stream_id: Int, promised_stream_id: Int, peer_settings: PeerSettingsState, receive_flow_control: ReceiveFlowControl) -> Result<ContinuationDecision, Http2ProtocolFailure>
	match kind
		1 => match end_headers_set(flags)
			true => Ok(Decision(NoContinuation, payload, data_end_stream_set(flags), completed_headers_are_trailers(flags, stream_id, receive_flow_control), 0))
			false => Ok(Decision(Continuation(stream_id, kind, offset, flags, completed_headers_are_trailers(flags, stream_id, receive_flow_control), 0, payload), empty_header_block(), false, false, 0))
		end
		5 => validate_push_promise_header_block(offset, payload, kind, flags, stream_id, promised_stream_id, peer_settings, receive_flow_control)
		_ => validate_connection_frame_kind(offset, kind, stream_id, receive_flow_control)
	end
end

fn validate_push_promise_header_block(offset: Int, payload: ByteChunk, kind: Int, flags: Int, stream_id: Int, promised_stream_id: Int, peer_settings: PeerSettingsState, receive_flow_control: ReceiveFlowControl) -> Result<ContinuationDecision, Http2ProtocolFailure>
	match validate_push_promise_stream_state(offset, kind, stream_id, receive_flow_control)
		Ok(_) => match local_enable_push_disabled(peer_settings)
			true => Err(InvalidFrameKind(offset, kind, stream_id, 1, "local-settings", "local_settings_enable_push_disabled"))
			false => match validate_received_push_promise_stream(offset, kind, stream_id, promised_stream_id, receive_flow_control)
				ProtocolStreamIdOk => match end_headers_set(flags)
					true => Ok(Decision(NoContinuation, payload, false, false, promised_stream_id))
					false => Ok(Decision(Continuation(stream_id, kind, offset, flags, false, promised_stream_id, payload), empty_header_block(), false, false, 0))
				end
				ProtocolStreamIdFailed(error) => Err(error)
			end
		end
		Err(error) => Err(error)
	end
end

fn frame_promised_stream_id(payload: ByteChunk, kind: Int) -> Result<Int, String>
	match kind
		5 => promised_stream_id_from_payload(payload)
		_ => Ok(0)
	end
end

fn promised_stream_id_from_payload(payload: ByteChunk) -> Result<Int, String>
	let decoded: {promised_stream_id: Int} = decoded_push_promise_payload(payload)?
	Ok(decoded.promised_stream_id)
end

fn decoded_push_promise_payload(payload: ByteChunk) -> Result<{promised_stream_id: Int}, String>
	byte_decode_http2_push_promise_payload_wire(byte_view(payload, byte_offset(0)?, byte_count(4)?)?)
end

fn continuation_payload_chunk(payload: ByteChunk, kind: Int, flags: Int) -> Result<ByteChunk, String>
	match kind
		5 => byte_drop(payload, byte_count(4)?)
		1 => headers_payload_chunk(payload, kind, flags)
		_ => Ok(payload)
	end
end

fn headers_payload_chunk(payload: ByteChunk, kind: Int, flags: Int) -> Result<ByteChunk, String>
	match headers_priority_set(kind, flags)
		true => byte_drop(payload, byte_count(5)?)
		false => Ok(payload)
	end
end

fn headers_priority_set(kind: Int, flags: Int) -> Bool
	match kind
		1 => ((flags / 32) * 32) != ((flags / 64) * 64)
		_ => false
	end
end

fn completed_headers_are_trailers(flags: Int, stream_id: Int, receive_flow_control: ReceiveFlowControl) -> Bool
	data_end_stream_set(flags) and stream_is_open_for_trailers(stream_id, receive_flow_control)
end

fn stream_is_open_for_trailers(stream_id: Int, receive_flow_control: ReceiveFlowControl) -> Bool
	match receive_flow_control
		ReceiveFlowControl(_, OpenStreamReceiveWindow(open_stream_id, _, _)) => stream_id == open_stream_id
		ReceiveFlowControl(_, TwoOpenStreamReceiveWindows(first_stream_id, _, _, second_stream_id, _, _)) => stream_id == first_stream_id or stream_id == second_stream_id
		ReceiveFlowControl(_, ThreeOpenStreamReceiveWindows(first_stream_id, _, _, second_stream_id, _, _, third_stream_id, _, _)) => stream_id == first_stream_id or stream_id == second_stream_id or stream_id == third_stream_id
		ReceiveFlowControl(_, ClientPushAssociatedStreamReceiveWindow(open_stream_id, _, _, _)) => stream_id == open_stream_id
		ReceiveFlowControl(_, _) => false
	end
end

fn end_headers_set(flags: Int) -> Bool
	let low_three_bits: Int = flags - (flags / 8) * 8
	match low_three_bits < 4
		true => false
		false => true
	end
end

fn data_end_stream_set(flags: Int) -> Bool
	(flags / 2) * 2 != flags
end

fn data_padded_set(flags: Int) -> Bool
	let low_four_bits: Int = flags - (flags / 16) * 16
	low_four_bits >= 8
end

fn empty_header_block() -> ByteChunk
	byte_chunk([])
end

fn validate_connection_frame_kind(offset: Int, kind: Int, stream_id: Int, receive_flow_control: ReceiveFlowControl) -> Result<ContinuationDecision, Http2ProtocolFailure>
	match stream_id
		0 => match kind
			4 => Ok(Decision(NoContinuation, empty_header_block(), false, false, 0))
			6 => Ok(Decision(NoContinuation, empty_header_block(), false, false, 0))
			7 => Ok(Decision(NoContinuation, empty_header_block(), false, false, 0))
			8 => Ok(Decision(NoContinuation, empty_header_block(), false, false, 0))
			_ => match is_unknown_frame_kind(kind)
				true => Ok(Decision(NoContinuation, empty_header_block(), false, false, 0))
				false => Err(InvalidFrameKind(offset, kind, stream_id, 4, "connection-control", "connection_frames_require_settings"))
			end
		end
		_ => validate_stream_frame_kind(offset, kind, stream_id, receive_flow_control)
	end
end

fn validate_stream_frame_kind(offset: Int, kind: Int, stream_id: Int, receive_flow_control: ReceiveFlowControl) -> Result<ContinuationDecision, Http2ProtocolFailure>
	match kind
		1 => Ok(Decision(NoContinuation, empty_header_block(), false, false, 0))
		0 => validate_data_stream_state(offset, kind, stream_id, receive_flow_control)
		3 => validate_data_stream_state(offset, kind, stream_id, receive_flow_control)
		8 => validate_data_stream_state(offset, kind, stream_id, receive_flow_control)
		2 => validate_priority_stream_state(offset, kind, stream_id, receive_flow_control)
		5 => validate_push_promise_stream_state(offset, kind, stream_id, receive_flow_control)
		_ => match is_unknown_frame_kind(kind)
			true => validate_unknown_stream_state(offset, kind, stream_id, receive_flow_control)
			false => Err(InvalidFrameKind(offset, kind, stream_id, 1, "idle-stream", "idle_streams_require_headers"))
		end
	end
end

fn validate_push_promise_stream_state(offset: Int, kind: Int, stream_id: Int, receive_flow_control: ReceiveFlowControl) -> Result<ContinuationDecision, Http2ProtocolFailure>
	match receive_flow_control
		ReceiveFlowControl(_, ClientPushAssociatedStreamReceiveWindow(open_stream_id, _, _, _)) => match stream_id == open_stream_id
			true => Ok(Decision(NoContinuation, empty_header_block(), false, false, 0))
			false => Err(InvalidFrameKind(offset, kind, stream_id, 1, "idle-stream", "idle_streams_require_headers"))
		end
		ReceiveFlowControl(_, _) => Err(InvalidFrameKind(offset, kind, stream_id, 1, "server-receive", "server_receives_no_push_promise"))
	end
end

fn validate_received_push_promise_stream(offset: Int, kind: Int, stream_id: Int, promised_stream_id: Int, receive_flow_control: ReceiveFlowControl) -> ProtocolStreamIdDecision
	match require_server_promised_stream_id(offset, kind, promised_stream_id)
		ProtocolStreamIdOk => validate_received_push_promise_associated_stream(offset, kind, stream_id, receive_flow_control)
		ProtocolStreamIdFailed(error) => ProtocolStreamIdFailed(error)
	end
end

fn validate_received_push_promise_associated_stream(offset: Int, kind: Int, stream_id: Int, receive_flow_control: ReceiveFlowControl) -> ProtocolStreamIdDecision
	match receive_flow_control
		ReceiveFlowControl(_, ClientPushAssociatedStreamReceiveWindow(open_stream_id, _, _, _)) => match stream_id == open_stream_id
			true => ProtocolStreamIdOk
			false => ProtocolStreamIdFailed(InvalidFrameKind(offset, kind, stream_id, 1, "idle-stream", "idle_streams_require_headers"))
		end
		ReceiveFlowControl(_, _) => ProtocolStreamIdFailed(InvalidFrameKind(offset, kind, stream_id, 1, "server-receive", "server_receives_no_push_promise"))
	end
end

fn validate_priority_stream_state(offset: Int, kind: Int, stream_id: Int, receive_flow_control: ReceiveFlowControl) -> Result<ContinuationDecision, Http2ProtocolFailure>
	match receive_flow_control
		ReceiveFlowControl(_, NoOpenStreamReceiveWindow) => Ok(Decision(NoContinuation, empty_header_block(), false, false, 0))
		ReceiveFlowControl(_, OpenStreamReceiveWindow(open_stream_id, _, _)) => match stream_id == open_stream_id
			true => Ok(Decision(NoContinuation, empty_header_block(), false, false, 0))
			false => Ok(Decision(NoContinuation, empty_header_block(), false, false, 0))
		end
		ReceiveFlowControl(_, TwoOpenStreamReceiveWindows(first_stream_id, _, _, second_stream_id, _, _)) => match stream_id == first_stream_id
			true => Ok(Decision(NoContinuation, empty_header_block(), false, false, 0))
			false => match stream_id == second_stream_id
				true => Ok(Decision(NoContinuation, empty_header_block(), false, false, 0))
				false => Err(InvalidFrameKind(offset, kind, stream_id, 1, "idle-stream", "idle_streams_require_headers"))
			end
		end
		ReceiveFlowControl(_, ThreeOpenStreamReceiveWindows(first_stream_id, _, _, second_stream_id, _, _, third_stream_id, _, _)) => match stream_id == first_stream_id
			true => Ok(Decision(NoContinuation, empty_header_block(), false, false, 0))
			false => match stream_id == second_stream_id
				true => Ok(Decision(NoContinuation, empty_header_block(), false, false, 0))
				false => match stream_id == third_stream_id
					true => Ok(Decision(NoContinuation, empty_header_block(), false, false, 0))
					false => Err(InvalidFrameKind(offset, kind, stream_id, 1, "idle-stream", "idle_streams_require_headers"))
				end
			end
		end
		ReceiveFlowControl(_, ClientPushAssociatedStreamReceiveWindow(open_stream_id, _, _, promised_stream_id)) => match stream_id == open_stream_id
			true => Ok(Decision(NoContinuation, empty_header_block(), false, false, 0))
			false => match stream_id == promised_stream_id
				true => Err(InvalidFrameKind(offset, kind, stream_id, 1, "reserved-by-peer-stream", "reserved_by_peer_requires_response_headers"))
				false => Err(InvalidFrameKind(offset, kind, stream_id, 1, "idle-stream", "idle_streams_require_headers"))
			end
		end
		ReceiveFlowControl(_, HalfClosedLocalStreamReceiveWindow(open_stream_id, _, _)) => match stream_id == open_stream_id
			true => Ok(Decision(NoContinuation, empty_header_block(), false, false, 0))
			false => Err(InvalidFrameKind(offset, kind, stream_id, 1, "idle-stream", "idle_streams_require_headers"))
		end
		ReceiveFlowControl(_, ClosedByPeerStreamReceiveWindow(closed_stream_id, _)) => match stream_id == closed_stream_id
			true => Err(InvalidFrameKind(offset, kind, stream_id, 1, "closed-by-peer-stream", "closed_by_peer_rejects_later_frames"))
			false => Err(InvalidFrameKind(offset, kind, stream_id, 1, "idle-stream", "idle_streams_require_headers"))
		end
		ReceiveFlowControl(_, ResetStreamReceiveWindow(reset_stream_id, _)) => match stream_id == reset_stream_id
			true => Err(InvalidFrameKind(offset, kind, stream_id, 1, "reset-stream", "reset_stream_rejects_later_frames"))
			false => Err(InvalidFrameKind(offset, kind, stream_id, 1, "idle-stream", "idle_streams_require_headers"))
		end
	end
end

fn validate_unknown_stream_state(offset: Int, kind: Int, stream_id: Int, receive_flow_control: ReceiveFlowControl) -> Result<ContinuationDecision, Http2ProtocolFailure>
	match receive_flow_control
		ReceiveFlowControl(_, NoOpenStreamReceiveWindow) => Err(InvalidFrameKind(offset, kind, stream_id, 1, "idle-stream", "idle_streams_require_headers"))
		ReceiveFlowControl(_, OpenStreamReceiveWindow(open_stream_id, _, _)) => match stream_id == open_stream_id
			true => Ok(Decision(NoContinuation, empty_header_block(), false, false, 0))
			false => Err(InvalidFrameKind(offset, kind, stream_id, 1, "idle-stream", "idle_streams_require_headers"))
		end
		ReceiveFlowControl(_, TwoOpenStreamReceiveWindows(first_stream_id, _, _, second_stream_id, _, _)) => match stream_id == first_stream_id
			true => Ok(Decision(NoContinuation, empty_header_block(), false, false, 0))
			false => match stream_id == second_stream_id
				true => Ok(Decision(NoContinuation, empty_header_block(), false, false, 0))
				false => Err(InvalidFrameKind(offset, kind, stream_id, 1, "idle-stream", "idle_streams_require_headers"))
			end
		end
		ReceiveFlowControl(_, ThreeOpenStreamReceiveWindows(first_stream_id, _, _, second_stream_id, _, _, third_stream_id, _, _)) => match stream_id == first_stream_id
			true => Ok(Decision(NoContinuation, empty_header_block(), false, false, 0))
			false => match stream_id == second_stream_id
				true => Ok(Decision(NoContinuation, empty_header_block(), false, false, 0))
				false => match stream_id == third_stream_id
					true => Ok(Decision(NoContinuation, empty_header_block(), false, false, 0))
					false => Err(InvalidFrameKind(offset, kind, stream_id, 1, "idle-stream", "idle_streams_require_headers"))
				end
			end
		end
		ReceiveFlowControl(_, ClientPushAssociatedStreamReceiveWindow(open_stream_id, _, _, promised_stream_id)) => match stream_id == open_stream_id
			true => Ok(Decision(NoContinuation, empty_header_block(), false, false, 0))
			false => match stream_id == promised_stream_id
				true => Err(InvalidFrameKind(offset, kind, stream_id, 1, "reserved-by-peer-stream", "reserved_by_peer_requires_response_headers"))
				false => Err(InvalidFrameKind(offset, kind, stream_id, 1, "idle-stream", "idle_streams_require_headers"))
			end
		end
		ReceiveFlowControl(_, HalfClosedLocalStreamReceiveWindow(open_stream_id, _, _)) => match stream_id == open_stream_id
			true => Ok(Decision(NoContinuation, empty_header_block(), false, false, 0))
			false => Err(InvalidFrameKind(offset, kind, stream_id, 1, "idle-stream", "idle_streams_require_headers"))
		end
		ReceiveFlowControl(_, ClosedByPeerStreamReceiveWindow(closed_stream_id, _)) => match stream_id == closed_stream_id
			true => Err(InvalidFrameKind(offset, kind, stream_id, 1, "closed-by-peer-stream", "closed_by_peer_rejects_later_frames"))
			false => Err(InvalidFrameKind(offset, kind, stream_id, 1, "idle-stream", "idle_streams_require_headers"))
		end
		ReceiveFlowControl(_, ResetStreamReceiveWindow(reset_stream_id, _)) => match stream_id == reset_stream_id
			true => Err(InvalidFrameKind(offset, kind, stream_id, 1, "reset-stream", "reset_stream_rejects_later_frames"))
			false => Err(InvalidFrameKind(offset, kind, stream_id, 1, "idle-stream", "idle_streams_require_headers"))
		end
	end
end

fn validate_data_stream_state(offset: Int, kind: Int, stream_id: Int, receive_flow_control: ReceiveFlowControl) -> Result<ContinuationDecision, Http2ProtocolFailure>
	match receive_flow_control
		ReceiveFlowControl(_, NoOpenStreamReceiveWindow) => Err(InvalidFrameKind(offset, kind, stream_id, 1, "idle-stream", "idle_streams_require_headers"))
		ReceiveFlowControl(_, OpenStreamReceiveWindow(open_stream_id, _, _)) => match stream_id == open_stream_id
			true => Ok(Decision(NoContinuation, empty_header_block(), false, false, 0))
			false => Err(InvalidFrameKind(offset, kind, stream_id, 1, "idle-stream", "idle_streams_require_headers"))
		end
		ReceiveFlowControl(_, TwoOpenStreamReceiveWindows(first_stream_id, _, _, second_stream_id, _, _)) => match stream_id == first_stream_id
			true => Ok(Decision(NoContinuation, empty_header_block(), false, false, 0))
			false => match stream_id == second_stream_id
				true => Ok(Decision(NoContinuation, empty_header_block(), false, false, 0))
				false => Err(InvalidFrameKind(offset, kind, stream_id, 1, "idle-stream", "idle_streams_require_headers"))
			end
		end
		ReceiveFlowControl(_, ThreeOpenStreamReceiveWindows(first_stream_id, _, _, second_stream_id, _, _, third_stream_id, _, _)) => match stream_id == first_stream_id
			true => Ok(Decision(NoContinuation, empty_header_block(), false, false, 0))
			false => match stream_id == second_stream_id
				true => Ok(Decision(NoContinuation, empty_header_block(), false, false, 0))
				false => match stream_id == third_stream_id
					true => Ok(Decision(NoContinuation, empty_header_block(), false, false, 0))
					false => Err(InvalidFrameKind(offset, kind, stream_id, 1, "idle-stream", "idle_streams_require_headers"))
				end
			end
		end
		ReceiveFlowControl(_, ClientPushAssociatedStreamReceiveWindow(open_stream_id, _, _, promised_stream_id)) => match stream_id == open_stream_id
			true => Ok(Decision(NoContinuation, empty_header_block(), false, false, 0))
			false => match stream_id == promised_stream_id
				true => Err(InvalidFrameKind(offset, kind, stream_id, 1, "reserved-by-peer-stream", "reserved_by_peer_requires_response_headers"))
				false => Err(InvalidFrameKind(offset, kind, stream_id, 1, "idle-stream", "idle_streams_require_headers"))
			end
		end
		ReceiveFlowControl(_, HalfClosedLocalStreamReceiveWindow(open_stream_id, _, _)) => match stream_id == open_stream_id
			true => Ok(Decision(NoContinuation, empty_header_block(), false, false, 0))
			false => Err(InvalidFrameKind(offset, kind, stream_id, 1, "idle-stream", "idle_streams_require_headers"))
		end
		ReceiveFlowControl(_, ClosedByPeerStreamReceiveWindow(closed_stream_id, _)) => match stream_id == closed_stream_id
			true => Err(InvalidFrameKind(offset, kind, stream_id, 1, "closed-by-peer-stream", "closed_by_peer_rejects_later_frames"))
			false => Err(InvalidFrameKind(offset, kind, stream_id, 1, "idle-stream", "idle_streams_require_headers"))
		end
		ReceiveFlowControl(_, ResetStreamReceiveWindow(reset_stream_id, _)) => match stream_id == reset_stream_id
			true => Err(InvalidFrameKind(offset, kind, stream_id, 1, "reset-stream", "reset_stream_rejects_later_frames"))
			false => Err(InvalidFrameKind(offset, kind, stream_id, 1, "idle-stream", "idle_streams_require_headers"))
		end
	end
end

fn validate_with_continuation(expected_stream: Int, started_kind: Int, started_offset: Int, started_flags: Int, started_is_trailer: Bool, promised_stream_id: Int, accumulated: ByteChunk, offset: Int, payload: ByteChunk, kind: Int, flags: Int, stream_id: Int, header_preview: ByteChunk) -> Result<ContinuationDecision, Http2ProtocolFailure>
	match kind
		9 => validate_continuation_stream(expected_stream, started_kind, started_offset, started_flags, started_is_trailer, promised_stream_id, accumulated, offset, payload, kind, flags, stream_id, header_preview)
		_ => Err(ContinuationExpected(offset, kind, stream_id, expected_stream, started_kind, started_offset, header_preview))
	end
end

fn validate_continuation_stream(expected_stream: Int, started_kind: Int, started_offset: Int, started_flags: Int, started_is_trailer: Bool, promised_stream_id: Int, accumulated: ByteChunk, offset: Int, payload: ByteChunk, kind: Int, flags: Int, stream_id: Int, header_preview: ByteChunk) -> Result<ContinuationDecision, Http2ProtocolFailure>
	match stream_id == expected_stream
		true => match end_headers_set(flags)
			true => Ok(Decision(NoContinuation, byte_append(accumulated, payload), data_end_stream_set(started_flags), started_is_trailer, promised_stream_id))
			false => Ok(Decision(Continuation(expected_stream, started_kind, started_offset, started_flags, started_is_trailer, promised_stream_id, byte_append(accumulated, payload)), empty_header_block(), false, false, 0))
		end
		false => Err(ContinuationExpected(offset, kind, stream_id, expected_stream, started_kind, started_offset, header_preview))
	end
end

fn update_receive_flow_control(pending: ByteChunk, offset: Int, length: Int, kind: Int, flags: Int, stream_id: Int, completed_end_stream: Bool, promised_stream_id: Int, accepted_content_length: Int, headers: HpackProductionHeaderList, completed_is_trailer: Bool, shutdown_state: ConnectionShutdownState, receive_flow_control: ReceiveFlowControl, peer_stream_admission: PeerStreamAdmissionState) -> Result<ReceiveFlowControlDecision, String>
	match kind
		1 => open_receive_stream(pending, offset, length, flags, stream_id, completed_end_stream, accepted_content_length, headers, completed_is_trailer, shutdown_state, receive_flow_control, peer_stream_admission)
		0 => consume_data_receive_window(offset, stream_id, length, data_application_length(frame_payload_chunk(pending, length)?, length, flags)?, data_end_stream_set(flags), frame_payload_chunk(pending, length)?, receive_flow_control)
		3 => reset_receive_stream(pending, offset, stream_id, receive_flow_control)
		8 => update_window_receive_credit(pending, offset, stream_id, receive_flow_control)
		9 => match promised_stream_id > 0
			true => reserve_push_promise_stream(offset, stream_id, promised_stream_id, receive_flow_control)
			false => complete_continuation_receive_stream(offset, stream_id, completed_end_stream, accepted_content_length, headers, completed_is_trailer, receive_flow_control)
		end
		2 => update_priority_receive_state(pending, offset, length, stream_id, receive_flow_control)
		5 => reserve_push_promise_stream(offset, stream_id, promised_stream_id, receive_flow_control)
		_ => Ok(ReceiveFlowControlOk(receive_flow_control))
	end
end

fn reserve_push_promise_stream(offset: Int, stream_id: Int, promised_stream_id: Int, receive_flow_control: ReceiveFlowControl) -> Result<ReceiveFlowControlDecision, String>
	match receive_flow_control
		ReceiveFlowControl(connection_window, ClientPushAssociatedStreamReceiveWindow(open_stream_id, stream_window, priority, current_promised_stream_id)) => match stream_id == open_stream_id
			true => match promised_stream_id == current_promised_stream_id and promised_stream_id > 0
				true => Ok(ReceiveFlowControlFailed(InvalidFrameKind(offset, 5, stream_id, 1, "reserved-by-peer-stream", "reserved_by_peer_rejects_repeated_push_promise")))
				false => Ok(ReceiveFlowControlOk(ReceiveFlowControl(connection_window, ClientPushAssociatedStreamReceiveWindow(open_stream_id, stream_window, priority, promised_stream_id))))
			end
			false => Ok(ReceiveFlowControlFailed(InvalidFrameKind(offset, 5, stream_id, 1, "idle-stream", "idle_streams_require_headers")))
		end
		ReceiveFlowControl(_, _) => Ok(ReceiveFlowControlFailed(InvalidFrameKind(offset, 5, stream_id, 1, "server-receive", "server_receives_no_push_promise")))
	end
end

fn open_receive_stream(pending: ByteChunk, offset: Int, length: Int, flags: Int, stream_id: Int, end_stream: Bool, accepted_content_length: Int, headers: HpackProductionHeaderList, completed_is_trailer: Bool, shutdown_state: ConnectionShutdownState, receive_flow_control: ReceiveFlowControl, peer_stream_admission: PeerStreamAdmissionState) -> Result<ReceiveFlowControlDecision, String>
	let headers_priority: StreamPriorityState = headers_priority_from_frame(pending, length, flags)?
	let preview_chunk: ByteChunk = byte_view_to_chunk(frame_header_preview(length, 1, flags, stream_id)?)
	let header_priority_state: StreamPriorityState = stream_priority_with_header_side(headers, completed_is_trailer, headers_priority)
	match receive_flow_control
		ReceiveFlowControl(connection_window, NoOpenStreamReceiveWindow) => match validate_new_peer_stream(offset, stream_id, shutdown_state, peer_stream_admission, preview_chunk)
			ReceiveFlowControlOk(_) => initial_receive_stream_window_decision(offset, connection_window, stream_id, header_priority_state, end_stream, accepted_content_length)
			ReceiveFlowControlFailed(error) => Ok(ReceiveFlowControlFailed(error))
		end
		ReceiveFlowControl(connection_window, OpenStreamReceiveWindow(open_stream_id, stream_window, priority)) => match stream_id == open_stream_id
			true => receive_stream_window_after_headers_decision(offset, connection_window, open_stream_id, stream_window, stream_priority_with_optional_priority(priority, header_priority_state), end_stream, accepted_content_length)
			false => match validate_new_peer_stream(offset, stream_id, shutdown_state, peer_stream_admission, preview_chunk)
				ReceiveFlowControlOk(_) => initial_second_receive_stream_window_decision(offset, connection_window, open_stream_id, stream_window, priority, stream_id, header_priority_state, end_stream, accepted_content_length)
				ReceiveFlowControlFailed(error) => Ok(ReceiveFlowControlFailed(error))
			end
		end
		ReceiveFlowControl(connection_window, TwoOpenStreamReceiveWindows(first_stream_id, first_stream_window, first_priority, second_stream_id, second_stream_window, second_priority)) => match stream_id == first_stream_id
			true => Ok(ReceiveFlowControlOk(receive_flow_control))
			false => match stream_id == second_stream_id
				true => Ok(ReceiveFlowControlOk(receive_flow_control))
				false => match validate_new_peer_stream(offset, stream_id, shutdown_state, peer_stream_admission, preview_chunk)
					ReceiveFlowControlOk(_) => initial_third_receive_stream_window_decision(offset, connection_window, first_stream_id, first_stream_window, first_priority, second_stream_id, second_stream_window, second_priority, stream_id, header_priority_state, end_stream, accepted_content_length)
					ReceiveFlowControlFailed(error) => Ok(ReceiveFlowControlFailed(error))
				end
			end
		end
		ReceiveFlowControl(_, ThreeOpenStreamReceiveWindows(first_stream_id, _, _, second_stream_id, _, _, third_stream_id, _, _)) => match stream_id == first_stream_id
			true => Ok(ReceiveFlowControlOk(receive_flow_control))
			false => match stream_id == second_stream_id
				true => Ok(ReceiveFlowControlOk(receive_flow_control))
				false => match stream_id == third_stream_id
					true => Ok(ReceiveFlowControlOk(receive_flow_control))
					false => match validate_new_stream_after_goaway(offset, stream_id, shutdown_state, preview_chunk)
						ReceiveFlowControlOk(_) => Ok(ReceiveFlowControlFailed(ConcurrentStreamsExceeded(offset, stream_id, 4, concurrent_stream_receive_limit(), "server", "open-stream", concurrent_stream_receive_limit_provenance(), "peer_created_stream_receive_limit", preview_chunk)))
						ReceiveFlowControlFailed(error) => Ok(ReceiveFlowControlFailed(error))
					end
				end
			end
		end
		ReceiveFlowControl(connection_window, ClientPushAssociatedStreamReceiveWindow(open_stream_id, stream_window, priority, promised_stream_id)) => match stream_id == open_stream_id
			true => receive_stream_window_after_headers_decision(offset, connection_window, open_stream_id, stream_window, stream_priority_with_optional_priority(priority, header_priority_state), end_stream, accepted_content_length)
			false => match stream_id == promised_stream_id
				true => receive_promised_stream_headers_decision(offset, connection_window, open_stream_id, stream_window, priority, promised_stream_id, header_priority_state, end_stream, accepted_content_length)
				false => match validate_new_peer_stream(offset, stream_id, shutdown_state, peer_stream_admission, preview_chunk)
					ReceiveFlowControlOk(_) => initial_second_receive_stream_window_decision(offset, connection_window, open_stream_id, stream_window, priority, stream_id, header_priority_state, end_stream, accepted_content_length)
					ReceiveFlowControlFailed(error) => Ok(ReceiveFlowControlFailed(error))
				end
			end
		end
		ReceiveFlowControl(_, HalfClosedLocalStreamReceiveWindow(open_stream_id, _, _)) => match stream_id == open_stream_id
			true => Ok(ReceiveFlowControlFailed(InvalidFrameKind(offset, 1, stream_id, 1, "half-closed-local-stream", "half_closed_local_data_only")))
			false => match validate_new_peer_stream(offset, stream_id, shutdown_state, peer_stream_admission, preview_chunk)
				ReceiveFlowControlOk(_) => Ok(ReceiveFlowControlFailed(ConcurrentStreamsExceeded(offset, stream_id, 2, concurrent_stream_receive_limit(), "server", "open-stream", concurrent_stream_receive_limit_provenance(), "peer_created_stream_receive_limit", preview_chunk)))
				ReceiveFlowControlFailed(error) => Ok(ReceiveFlowControlFailed(error))
			end
		end
		ReceiveFlowControl(_, ClosedByPeerStreamReceiveWindow(closed_stream_id, _)) => match stream_id == closed_stream_id
			true => Ok(ReceiveFlowControlFailed(InvalidFrameKind(offset, 1, stream_id, 1, "closed-by-peer-stream", "closed_by_peer_rejects_later_frames")))
			false => match validate_new_peer_stream(offset, stream_id, shutdown_state, peer_stream_admission, preview_chunk)
				ReceiveFlowControlOk(_) => Ok(ReceiveFlowControlFailed(ConcurrentStreamsExceeded(offset, stream_id, 2, concurrent_stream_receive_limit(), "server", "open-stream", concurrent_stream_receive_limit_provenance(), "peer_created_stream_receive_limit", preview_chunk)))
				ReceiveFlowControlFailed(error) => Ok(ReceiveFlowControlFailed(error))
			end
		end
		ReceiveFlowControl(_, ResetStreamReceiveWindow(reset_stream_id, _)) => match stream_id == reset_stream_id
			true => Ok(ReceiveFlowControlFailed(InvalidFrameKind(offset, 1, stream_id, 1, "reset-stream", "reset_stream_rejects_later_frames")))
			false => match validate_new_peer_stream(offset, stream_id, shutdown_state, peer_stream_admission, preview_chunk)
				ReceiveFlowControlOk(_) => Ok(ReceiveFlowControlFailed(ConcurrentStreamsExceeded(offset, stream_id, 2, concurrent_stream_receive_limit(), "server", "open-stream", concurrent_stream_receive_limit_provenance(), "peer_created_stream_receive_limit", preview_chunk)))
				ReceiveFlowControlFailed(error) => Ok(ReceiveFlowControlFailed(error))
			end
		end
	end
end

fn receive_promised_stream_headers_decision(offset: Int, connection_window: Int, associated_stream_id: Int, associated_stream_window: Int, associated_priority: StreamPriorityState, promised_stream_id: Int, headers_priority: StreamPriorityState, end_stream: Bool, accepted_content_length: Int) -> Result<ReceiveFlowControlDecision, String>
	let promised_priority: StreamPriorityState = stream_priority_with_accepted_content_length(headers_priority, accepted_content_length)
	match end_stream
		true => match stream_priority_content_length_expected(promised_priority) > 0
			true => Ok(ReceiveFlowControlFailed(ContentLengthMismatch(offset, 1, promised_stream_id, stream_priority_content_length_expected(promised_priority), stream_priority_content_length_observed(promised_priority), "open-stream", "rfc9113_content_length_body", empty_byte_preview()?)))
			false => Ok(ReceiveFlowControlOk(ReceiveFlowControl(connection_window, ClosedByPeerStreamReceiveWindow(promised_stream_id, 65535))))
		end
		false => Ok(ReceiveFlowControlOk(ReceiveFlowControl(connection_window, TwoOpenStreamReceiveWindows(associated_stream_id, associated_stream_window, associated_priority, promised_stream_id, 65535, promised_priority))))
	end
end

fn initial_receive_stream_window_decision(offset: Int, connection_window: Int, stream_id: Int, priority: StreamPriorityState, end_stream: Bool, accepted_content_length: Int) -> Result<ReceiveFlowControlDecision, String>
	receive_stream_window_after_headers_decision(offset, connection_window, stream_id, 65535, priority, end_stream, accepted_content_length)
end

fn initial_second_receive_stream_window_decision(offset: Int, connection_window: Int, first_stream_id: Int, first_stream_window: Int, first_priority: StreamPriorityState, stream_id: Int, priority: StreamPriorityState, end_stream: Bool, accepted_content_length: Int) -> Result<ReceiveFlowControlDecision, String>
	let next_priority: StreamPriorityState = stream_priority_with_accepted_content_length(priority, accepted_content_length)
	match end_stream
		true => match stream_priority_content_length_expected(next_priority) > 0
			true => Ok(ReceiveFlowControlFailed(ContentLengthMismatch(offset, 1, stream_id, stream_priority_content_length_expected(next_priority), stream_priority_content_length_observed(next_priority), "open-stream", "rfc9113_content_length_body", empty_byte_preview()?)))
			false => Ok(ReceiveFlowControlOk(ReceiveFlowControl(connection_window, ClosedByPeerStreamReceiveWindow(stream_id, 65535))))
		end
		false => Ok(ReceiveFlowControlOk(ReceiveFlowControl(connection_window, TwoOpenStreamReceiveWindows(first_stream_id, first_stream_window, first_priority, stream_id, 65535, next_priority))))
	end
end

fn initial_third_receive_stream_window_decision(offset: Int, connection_window: Int, first_stream_id: Int, first_stream_window: Int, first_priority: StreamPriorityState, second_stream_id: Int, second_stream_window: Int, second_priority: StreamPriorityState, stream_id: Int, priority: StreamPriorityState, end_stream: Bool, accepted_content_length: Int) -> Result<ReceiveFlowControlDecision, String>
	let next_priority: StreamPriorityState = stream_priority_with_accepted_content_length(priority, accepted_content_length)
	match end_stream
		true => match stream_priority_content_length_expected(next_priority) > 0
			true => Ok(ReceiveFlowControlFailed(ContentLengthMismatch(offset, 1, stream_id, stream_priority_content_length_expected(next_priority), stream_priority_content_length_observed(next_priority), "open-stream", "rfc9113_content_length_body", empty_byte_preview()?)))
			false => Ok(ReceiveFlowControlOk(ReceiveFlowControl(connection_window, ClosedByPeerStreamReceiveWindow(stream_id, 65535))))
		end
		false => Ok(ReceiveFlowControlOk(ReceiveFlowControl(connection_window, ThreeOpenStreamReceiveWindows(first_stream_id, first_stream_window, first_priority, second_stream_id, second_stream_window, second_priority, stream_id, 65535, next_priority))))
	end
end

fn headers_priority_from_frame(pending: ByteChunk, length: Int, flags: Int) -> Result<StreamPriorityState, String>
	match headers_priority_set(1, flags)
		true => headers_priority_from_payload(frame_payload_chunk(pending, length)?)
		false => Ok(NoStreamPriority)
	end
end

fn headers_priority_from_payload(payload: ByteChunk) -> Result<StreamPriorityState, String>
	let payload_view: ByteView = byte_view(payload, byte_offset(0)?, byte_count(5)?)?
	Ok(StreamPriority(priority_dependency_stream_id(payload_view)?, priority_exclusive(payload_view)?, priority_weight(payload_view)?))
end

fn receive_stream_window_after_headers_decision(offset: Int, connection_window: Int, stream_id: Int, stream_window: Int, priority: StreamPriorityState, end_stream: Bool, accepted_content_length: Int) -> Result<ReceiveFlowControlDecision, String>
	let next_priority: StreamPriorityState = stream_priority_with_accepted_content_length(priority, accepted_content_length)
	match end_stream
		true => match stream_priority_content_length_expected(next_priority) > 0
			true => Ok(ReceiveFlowControlFailed(ContentLengthMismatch(offset, 1, stream_id, stream_priority_content_length_expected(next_priority), stream_priority_content_length_observed(next_priority), "open-stream", "rfc9113_content_length_body", empty_byte_preview()?)))
			false => Ok(ReceiveFlowControlOk(ReceiveFlowControl(connection_window, ClosedByPeerStreamReceiveWindow(stream_id, stream_window))))
		end
		false => Ok(ReceiveFlowControlOk(ReceiveFlowControl(connection_window, OpenStreamReceiveWindow(stream_id, stream_window, next_priority))))
	end
end

fn stream_priority_with_accepted_content_length(priority: StreamPriorityState, accepted_content_length: Int) -> StreamPriorityState
	match accepted_content_length >= 0
		true => ExpectedContentLength(accepted_content_length, 0, stream_priority_without_content_length(priority))
		false => priority
	end
end

fn stream_priority_with_header_side(headers: HpackProductionHeaderList, completed_is_trailer: Bool, priority: StreamPriorityState) -> StreamPriorityState
	match completed_is_trailer
		true => priority
		false => match hpack_fixture::production_header_list_is_response(headers)
			true => ResponseHeaderStream(priority)
			false => priority
		end
	end
end

fn stream_priority_without_content_length(priority: StreamPriorityState) -> StreamPriorityState
	match priority
		ExpectedContentLength(_, _, inner) => stream_priority_without_content_length(inner)
		ResponseHeaderStream(inner) => ResponseHeaderStream(stream_priority_without_content_length(inner))
		_ => priority
	end
end

fn stream_priority_with_priority(priority: StreamPriorityState, next_priority: StreamPriorityState) -> StreamPriorityState
	match priority
		ExpectedContentLength(expected_length, observed_length, _) => ExpectedContentLength(expected_length, observed_length, next_priority)
		ResponseHeaderStream(inner) => ResponseHeaderStream(stream_priority_with_priority(inner, next_priority))
		_ => next_priority
	end
end

fn stream_priority_with_optional_priority(priority: StreamPriorityState, next_priority: StreamPriorityState) -> StreamPriorityState
	match next_priority
		NoStreamPriority => priority
		_ => stream_priority_with_priority(priority, next_priority)
	end
end

fn stream_priority_content_length_expected(priority: StreamPriorityState) -> Int
	match priority
		ExpectedContentLength(expected_length, _, _) => expected_length
		ResponseHeaderStream(inner) => stream_priority_content_length_expected(inner)
		_ => -1
	end
end

fn stream_priority_content_length_observed(priority: StreamPriorityState) -> Int
	match priority
		ExpectedContentLength(_, observed_length, _) => observed_length
		ResponseHeaderStream(inner) => stream_priority_content_length_observed(inner)
		_ => 0
	end
end

fn update_content_length_body(offset: Int, frame_kind: Int, stream_id: Int, application_length: Int, end_stream: Bool, active_state: String, preview: ByteChunk, priority: StreamPriorityState) -> Result<ContentLengthBodyDecision, String>
	match priority
		ExpectedContentLength(expected_length, observed_length, inner) => validate_content_length_body(offset, frame_kind, stream_id, expected_length, observed_length + application_length, end_stream, active_state, preview, inner)
		ResponseHeaderStream(inner) => match update_content_length_body(offset, frame_kind, stream_id, application_length, end_stream, active_state, preview, inner)?
			ContentLengthBodyOk(next_inner) => Ok(ContentLengthBodyOk(ResponseHeaderStream(next_inner)))
			ContentLengthBodyFailed(error) => Ok(ContentLengthBodyFailed(error))
		end
		_ => Ok(ContentLengthBodyOk(priority))
	end
end

fn validate_content_length_body(offset: Int, frame_kind: Int, stream_id: Int, expected_length: Int, observed_length: Int, end_stream: Bool, active_state: String, preview: ByteChunk, inner: StreamPriorityState) -> Result<ContentLengthBodyDecision, String>
	match observed_length > expected_length
		true => Ok(ContentLengthBodyFailed(ContentLengthMismatch(offset, frame_kind, stream_id, expected_length, observed_length, active_state, "rfc9113_content_length_body", byte_chunk_view(preview)?)))
		false => match end_stream and observed_length < expected_length
			true => Ok(ContentLengthBodyFailed(ContentLengthMismatch(offset, frame_kind, stream_id, expected_length, observed_length, active_state, "rfc9113_content_length_body", byte_chunk_view(preview)?)))
			false => Ok(ContentLengthBodyOk(ExpectedContentLength(expected_length, observed_length, inner)))
		end
	end
end

fn complete_continuation_receive_stream(offset: Int, stream_id: Int, end_stream: Bool, accepted_content_length: Int, headers: HpackProductionHeaderList, completed_is_trailer: Bool, receive_flow_control: ReceiveFlowControl) -> Result<ReceiveFlowControlDecision, String>
	match accepted_content_length >= 0
		true => complete_continuation_receive_stream_with_content_length(offset, stream_id, end_stream, accepted_content_length, headers, completed_is_trailer, receive_flow_control)
		false => match end_stream
			false => Ok(ReceiveFlowControlOk(receive_flow_control))
			true => Ok(close_continuation_receive_stream(offset, stream_id, receive_flow_control))
		end
	end
end

fn complete_continuation_receive_stream_with_content_length(offset: Int, stream_id: Int, end_stream: Bool, accepted_content_length: Int, headers: HpackProductionHeaderList, completed_is_trailer: Bool, receive_flow_control: ReceiveFlowControl) -> Result<ReceiveFlowControlDecision, String>
	let header_priority_state: StreamPriorityState = stream_priority_with_header_side(headers, completed_is_trailer, NoStreamPriority)
	match receive_flow_control
		ReceiveFlowControl(connection_window, OpenStreamReceiveWindow(open_stream_id, stream_window, priority)) => match stream_id == open_stream_id
			true => receive_stream_window_after_headers_decision(offset, connection_window, open_stream_id, stream_window, stream_priority_with_optional_priority(priority, header_priority_state), end_stream, accepted_content_length)
			false => Ok(ReceiveFlowControlFailed(InvalidFrameKind(offset, 9, stream_id, 1, "idle-stream", "idle_streams_require_headers")))
		end
		ReceiveFlowControl(connection_window, ClientPushAssociatedStreamReceiveWindow(open_stream_id, stream_window, priority, promised_stream_id)) => match stream_id == open_stream_id
			true => receive_stream_window_after_headers_decision(offset, connection_window, open_stream_id, stream_window, stream_priority_with_optional_priority(priority, header_priority_state), end_stream, accepted_content_length)
			false => match stream_id == promised_stream_id
				true => receive_promised_stream_headers_decision(offset, connection_window, open_stream_id, stream_window, priority, promised_stream_id, header_priority_state, end_stream, accepted_content_length)
				false => Ok(ReceiveFlowControlFailed(InvalidFrameKind(offset, 9, stream_id, 1, "idle-stream", "idle_streams_require_headers")))
			end
		end
		ReceiveFlowControl(connection_window, HalfClosedLocalStreamReceiveWindow(open_stream_id, stream_window, priority)) => match stream_id == open_stream_id
			true => receive_stream_window_after_headers_decision(offset, connection_window, open_stream_id, stream_window, stream_priority_with_optional_priority(priority, header_priority_state), end_stream, accepted_content_length)
			false => Ok(ReceiveFlowControlFailed(InvalidFrameKind(offset, 9, stream_id, 1, "idle-stream", "idle_streams_require_headers")))
		end
		_ => Ok(close_continuation_receive_stream(offset, stream_id, receive_flow_control))
	end
end
fn close_continuation_receive_stream(offset: Int, stream_id: Int, receive_flow_control: ReceiveFlowControl) -> ReceiveFlowControlDecision
	match receive_flow_control
		ReceiveFlowControl(connection_window, NoOpenStreamReceiveWindow) => ReceiveFlowControlFailed(InvalidFrameKind(offset, 9, stream_id, 1, "idle-stream", "idle_streams_require_headers"))
		ReceiveFlowControl(connection_window, OpenStreamReceiveWindow(open_stream_id, stream_window, _)) => match stream_id == open_stream_id
			true => ReceiveFlowControlOk(ReceiveFlowControl(connection_window, ClosedByPeerStreamReceiveWindow(open_stream_id, stream_window)))
			false => ReceiveFlowControlFailed(InvalidFrameKind(offset, 9, stream_id, 1, "idle-stream", "idle_streams_require_headers"))
		end
		ReceiveFlowControl(_, TwoOpenStreamReceiveWindows(first_stream_id, _, _, second_stream_id, _, _)) => match stream_id == first_stream_id
			true => ReceiveFlowControlOk(receive_flow_control)
			false => match stream_id == second_stream_id
				true => ReceiveFlowControlOk(receive_flow_control)
				false => ReceiveFlowControlFailed(InvalidFrameKind(offset, 9, stream_id, 1, "idle-stream", "idle_streams_require_headers"))
			end
		end
		ReceiveFlowControl(_, ThreeOpenStreamReceiveWindows(first_stream_id, _, _, second_stream_id, _, _, third_stream_id, _, _)) => match stream_id == first_stream_id
			true => ReceiveFlowControlOk(receive_flow_control)
			false => match stream_id == second_stream_id
				true => ReceiveFlowControlOk(receive_flow_control)
				false => match stream_id == third_stream_id
					true => ReceiveFlowControlOk(receive_flow_control)
					false => ReceiveFlowControlFailed(InvalidFrameKind(offset, 9, stream_id, 1, "idle-stream", "idle_streams_require_headers"))
				end
			end
		end
		ReceiveFlowControl(connection_window, ClientPushAssociatedStreamReceiveWindow(open_stream_id, stream_window, _, promised_stream_id)) => match stream_id == open_stream_id
			true => ReceiveFlowControlOk(ReceiveFlowControl(connection_window, ClosedByPeerStreamReceiveWindow(open_stream_id, stream_window)))
			false => match stream_id == promised_stream_id
				true => ReceiveFlowControlOk(ReceiveFlowControl(connection_window, ClosedByPeerStreamReceiveWindow(promised_stream_id, 65535)))
				false => ReceiveFlowControlFailed(InvalidFrameKind(offset, 9, stream_id, 1, "idle-stream", "idle_streams_require_headers"))
			end
		end
		ReceiveFlowControl(connection_window, HalfClosedLocalStreamReceiveWindow(open_stream_id, stream_window, _)) => match stream_id == open_stream_id
			true => ReceiveFlowControlOk(ReceiveFlowControl(connection_window, ClosedByPeerStreamReceiveWindow(open_stream_id, stream_window)))
			false => ReceiveFlowControlFailed(InvalidFrameKind(offset, 9, stream_id, 1, "idle-stream", "idle_streams_require_headers"))
		end
		ReceiveFlowControl(_, ClosedByPeerStreamReceiveWindow(closed_stream_id, _)) => match stream_id == closed_stream_id
			true => ReceiveFlowControlFailed(InvalidFrameKind(offset, 9, stream_id, 1, "closed-by-peer-stream", "closed_by_peer_rejects_later_frames"))
			false => ReceiveFlowControlFailed(InvalidFrameKind(offset, 9, stream_id, 1, "idle-stream", "idle_streams_require_headers"))
		end
		ReceiveFlowControl(_, ResetStreamReceiveWindow(reset_stream_id, _)) => match stream_id == reset_stream_id
			true => ReceiveFlowControlFailed(InvalidFrameKind(offset, 9, stream_id, 1, "reset-stream", "reset_stream_rejects_later_frames"))
			false => ReceiveFlowControlFailed(InvalidFrameKind(offset, 9, stream_id, 1, "idle-stream", "idle_streams_require_headers"))
		end
	end
end

fn validate_new_stream_after_goaway(offset: Int, stream_id: Int, shutdown_state: ConnectionShutdownState, preview_chunk: ByteChunk) -> ReceiveFlowControlDecision
	match shutdown_state
		OpenConnection => ReceiveFlowControlOk(default_receive_flow_control())
		GracefulShutdown(last_stream_id, _) => match stream_id > last_stream_id
			true => ReceiveFlowControlFailed(StreamAfterGoaway(offset, stream_id, last_stream_id, "graceful_shutdown", "server", "goaway_last_stream_id", preview_chunk))
			false => ReceiveFlowControlOk(default_receive_flow_control())
		end
		DrainedShutdown(last_stream_id, _) => ReceiveFlowControlFailed(StreamAfterGoaway(offset, stream_id, last_stream_id, "drained_shutdown", "server", "goaway_last_stream_id", preview_chunk))
	end
end

fn validate_new_peer_stream(offset: Int, stream_id: Int, shutdown_state: ConnectionShutdownState, peer_stream_admission: PeerStreamAdmissionState, preview_chunk: ByteChunk) -> ReceiveFlowControlDecision
	match validate_new_stream_after_goaway(offset, stream_id, shutdown_state, preview_chunk)
		ReceiveFlowControlFailed(error) => ReceiveFlowControlFailed(error)
		ReceiveFlowControlOk(_) => match peer_stream_admission
			NoPeerStreamAdmitted => ReceiveFlowControlOk(default_receive_flow_control())
			HighestPeerStreamId(highest_stream_id) => match stream_id > highest_stream_id
				true => ReceiveFlowControlOk(default_receive_flow_control())
				false => ReceiveFlowControlFailed(InvalidStreamId(offset, 1, stream_id, "peer-created stream id greater than every previously admitted peer-created stream id", "server", "idle-stream", "peer_created_stream_ids_increase"))
			end
		end
	end
end

fn update_peer_stream_admission(kind: Int, stream_id: Int, completed_is_trailer: Bool, receive_flow_control: ReceiveFlowControl, peer_stream_admission: PeerStreamAdmissionState) -> PeerStreamAdmissionState
	match kind == 1 and not completed_is_trailer and not peer_stream_is_known(stream_id, receive_flow_control)
		true => match peer_stream_admission
			NoPeerStreamAdmitted => HighestPeerStreamId(stream_id)
			HighestPeerStreamId(highest_stream_id) => match stream_id > highest_stream_id
				true => HighestPeerStreamId(stream_id)
				false => peer_stream_admission
			end
		end
		false => peer_stream_admission
	end
end

fn peer_stream_is_known(stream_id: Int, receive_flow_control: ReceiveFlowControl) -> Bool
	match receive_flow_control
		ReceiveFlowControl(_, NoOpenStreamReceiveWindow) => false
		ReceiveFlowControl(_, OpenStreamReceiveWindow(open_stream_id, _, _)) => stream_id == open_stream_id
		ReceiveFlowControl(_, TwoOpenStreamReceiveWindows(first_stream_id, _, _, second_stream_id, _, _)) => stream_id == first_stream_id or stream_id == second_stream_id
		ReceiveFlowControl(_, ThreeOpenStreamReceiveWindows(first_stream_id, _, _, second_stream_id, _, _, third_stream_id, _, _)) => stream_id == first_stream_id or stream_id == second_stream_id or stream_id == third_stream_id
		ReceiveFlowControl(_, ClientPushAssociatedStreamReceiveWindow(open_stream_id, _, _, promised_stream_id)) => stream_id == open_stream_id or stream_id == promised_stream_id
		ReceiveFlowControl(_, HalfClosedLocalStreamReceiveWindow(open_stream_id, _, _)) => stream_id == open_stream_id
		ReceiveFlowControl(_, ClosedByPeerStreamReceiveWindow(closed_stream_id, _)) => stream_id == closed_stream_id
		ReceiveFlowControl(_, ResetStreamReceiveWindow(reset_stream_id, _)) => stream_id == reset_stream_id
	end
end

fn consume_data_receive_window(offset: Int, stream_id: Int, length: Int, application_length: Int, end_stream: Bool, preview: ByteChunk, receive_flow_control: ReceiveFlowControl) -> Result<ReceiveFlowControlDecision, String>
	match receive_flow_control
		ReceiveFlowControl(connection_window, NoOpenStreamReceiveWindow) => Ok(ReceiveFlowControlFailed(InvalidFrameKind(offset, 0, stream_id, 1, "idle-stream", "idle_streams_require_headers")))
		ReceiveFlowControl(connection_window, OpenStreamReceiveWindow(open_stream_id, stream_window, priority)) => match data_exceeds_connection_window(length, connection_window)
			true => Ok(ReceiveFlowControlFailed(FlowControlWindowExceeded(offset, 0, stream_id, length, connection_window, "connection-flow-control", "connection_receive_window", preview)))
			false => match data_exceeds_stream_window(length, stream_window)
				true => Ok(ReceiveFlowControlFailed(FlowControlWindowExceeded(offset, 0, stream_id, length, stream_window, "open-stream", "stream_receive_window", preview)))
				false => receive_open_stream_data_after_windows(offset, stream_id, length, application_length, end_stream, preview, connection_window, open_stream_id, stream_window, priority)
			end
		end
		ReceiveFlowControl(connection_window, TwoOpenStreamReceiveWindows(first_stream_id, first_stream_window, first_priority, second_stream_id, second_stream_window, second_priority)) => match data_exceeds_connection_window(length, connection_window)
			true => Ok(ReceiveFlowControlFailed(FlowControlWindowExceeded(offset, 0, stream_id, length, connection_window, "connection-flow-control", "connection_receive_window", preview)))
			false => match stream_id == first_stream_id
				true => match data_exceeds_stream_window(length, first_stream_window)
					true => Ok(ReceiveFlowControlFailed(FlowControlWindowExceeded(offset, 0, stream_id, length, first_stream_window, "open-stream", "stream_receive_window", preview)))
					false => receive_first_open_stream_data_after_windows(offset, stream_id, length, application_length, end_stream, preview, connection_window, first_stream_id, first_stream_window, first_priority, second_stream_id, second_stream_window, second_priority)
				end
				false => match stream_id == second_stream_id
					true => match data_exceeds_stream_window(length, second_stream_window)
						true => Ok(ReceiveFlowControlFailed(FlowControlWindowExceeded(offset, 0, stream_id, length, second_stream_window, "open-stream", "stream_receive_window", preview)))
						false => receive_second_open_stream_data_after_windows(offset, stream_id, length, application_length, end_stream, preview, connection_window, first_stream_id, first_stream_window, first_priority, second_stream_id, second_stream_window, second_priority)
					end
					false => Ok(ReceiveFlowControlFailed(InvalidFrameKind(offset, 0, stream_id, 1, "idle-stream", "idle_streams_require_headers")))
				end
			end
		end
		ReceiveFlowControl(connection_window, ThreeOpenStreamReceiveWindows(first_stream_id, first_stream_window, first_priority, second_stream_id, second_stream_window, second_priority, third_stream_id, third_stream_window, third_priority)) => match data_exceeds_connection_window(length, connection_window)
			true => Ok(ReceiveFlowControlFailed(FlowControlWindowExceeded(offset, 0, stream_id, length, connection_window, "connection-flow-control", "connection_receive_window", preview)))
			false => match stream_id == first_stream_id
				true => match data_exceeds_stream_window(length, first_stream_window)
					true => Ok(ReceiveFlowControlFailed(FlowControlWindowExceeded(offset, 0, stream_id, length, first_stream_window, "open-stream", "stream_receive_window", preview)))
					false => receive_first_of_three_open_stream_data_after_windows(offset, stream_id, length, application_length, end_stream, preview, connection_window, first_stream_id, first_stream_window, first_priority, second_stream_id, second_stream_window, second_priority, third_stream_id, third_stream_window, third_priority)
				end
				false => match stream_id == second_stream_id
					true => match data_exceeds_stream_window(length, second_stream_window)
						true => Ok(ReceiveFlowControlFailed(FlowControlWindowExceeded(offset, 0, stream_id, length, second_stream_window, "open-stream", "stream_receive_window", preview)))
						false => receive_second_of_three_open_stream_data_after_windows(offset, stream_id, length, application_length, end_stream, preview, connection_window, first_stream_id, first_stream_window, first_priority, second_stream_id, second_stream_window, second_priority, third_stream_id, third_stream_window, third_priority)
					end
					false => match stream_id == third_stream_id
						true => match data_exceeds_stream_window(length, third_stream_window)
							true => Ok(ReceiveFlowControlFailed(FlowControlWindowExceeded(offset, 0, stream_id, length, third_stream_window, "open-stream", "stream_receive_window", preview)))
							false => receive_third_open_stream_data_after_windows(offset, stream_id, length, application_length, end_stream, preview, connection_window, first_stream_id, first_stream_window, first_priority, second_stream_id, second_stream_window, second_priority, third_stream_id, third_stream_window, third_priority)
						end
						false => Ok(ReceiveFlowControlFailed(InvalidFrameKind(offset, 0, stream_id, 1, "idle-stream", "idle_streams_require_headers")))
					end
				end
			end
		end
		ReceiveFlowControl(connection_window, ClientPushAssociatedStreamReceiveWindow(open_stream_id, stream_window, priority, promised_stream_id)) => match data_exceeds_connection_window(length, connection_window)
			true => Ok(ReceiveFlowControlFailed(FlowControlWindowExceeded(offset, 0, stream_id, length, connection_window, "connection-flow-control", "connection_receive_window", preview)))
			false => match stream_id == open_stream_id
				true => match data_exceeds_stream_window(length, stream_window)
					true => Ok(ReceiveFlowControlFailed(FlowControlWindowExceeded(offset, 0, stream_id, length, stream_window, "open-stream", "stream_receive_window", preview)))
					false => receive_client_push_associated_data_after_windows(offset, stream_id, length, application_length, end_stream, preview, connection_window, open_stream_id, stream_window, priority, promised_stream_id)
				end
				false => match stream_id == promised_stream_id
					true => Ok(ReceiveFlowControlFailed(InvalidFrameKind(offset, 0, stream_id, 1, "reserved-by-peer-stream", "reserved_by_peer_requires_response_headers")))
					false => Ok(ReceiveFlowControlFailed(InvalidFrameKind(offset, 0, stream_id, 1, "idle-stream", "idle_streams_require_headers")))
				end
			end
		end
		ReceiveFlowControl(connection_window, HalfClosedLocalStreamReceiveWindow(open_stream_id, stream_window, priority)) => match data_exceeds_connection_window(length, connection_window)
			true => Ok(ReceiveFlowControlFailed(FlowControlWindowExceeded(offset, 0, stream_id, length, connection_window, "connection-flow-control", "connection_receive_window", preview)))
			false => match data_exceeds_stream_window(length, stream_window)
				true => Ok(ReceiveFlowControlFailed(FlowControlWindowExceeded(offset, 0, stream_id, length, stream_window, "half-closed-local-stream", "stream_receive_window", preview)))
				false => receive_half_closed_local_stream_data_after_windows(offset, stream_id, length, application_length, end_stream, preview, connection_window, open_stream_id, stream_window, priority)
			end
		end
		ReceiveFlowControl(_, ClosedByPeerStreamReceiveWindow(closed_stream_id, _)) => match stream_id == closed_stream_id
			true => Ok(ReceiveFlowControlFailed(InvalidFrameKind(offset, 0, stream_id, 1, "closed-by-peer-stream", "closed_by_peer_rejects_later_frames")))
			false => Ok(ReceiveFlowControlFailed(InvalidFrameKind(offset, 0, stream_id, 1, "idle-stream", "idle_streams_require_headers")))
		end
		ReceiveFlowControl(_, ResetStreamReceiveWindow(reset_stream_id, _)) => match stream_id == reset_stream_id
			true => Ok(ReceiveFlowControlFailed(InvalidFrameKind(offset, 0, stream_id, 1, "reset-stream", "reset_stream_rejects_later_frames")))
			false => Ok(ReceiveFlowControlFailed(InvalidFrameKind(offset, 0, stream_id, 1, "idle-stream", "idle_streams_require_headers")))
		end
	end
end

fn receive_client_push_associated_data_after_windows(offset: Int, stream_id: Int, length: Int, application_length: Int, end_stream: Bool, preview: ByteChunk, connection_window: Int, open_stream_id: Int, stream_window: Int, priority: StreamPriorityState, promised_stream_id: Int) -> Result<ReceiveFlowControlDecision, String>
	let body_decision: ContentLengthBodyDecision = update_content_length_body(offset, 0, stream_id, application_length, end_stream, "open-stream", preview, priority)?
	match body_decision
		ContentLengthBodyOk(next_priority) => match end_stream
			true => Ok(ReceiveFlowControlOk(ReceiveFlowControl(debit_connection_window(connection_window, length)?, ClosedByPeerStreamReceiveWindow(open_stream_id, debit_stream_window(stream_window, length)?))))
			false => Ok(ReceiveFlowControlOk(ReceiveFlowControl(debit_connection_window(connection_window, length)?, ClientPushAssociatedStreamReceiveWindow(open_stream_id, debit_stream_window(stream_window, length)?, next_priority, promised_stream_id))))
		end
		ContentLengthBodyFailed(error) => Ok(ReceiveFlowControlFailed(error))
	end
end

fn receive_open_stream_data_after_windows(offset: Int, stream_id: Int, length: Int, application_length: Int, end_stream: Bool, preview: ByteChunk, connection_window: Int, open_stream_id: Int, stream_window: Int, priority: StreamPriorityState) -> Result<ReceiveFlowControlDecision, String>
	let body_decision: ContentLengthBodyDecision = update_content_length_body(offset, 0, stream_id, application_length, end_stream, "open-stream", preview, priority)?
	match body_decision
		ContentLengthBodyOk(next_priority) => match end_stream
			true => Ok(ReceiveFlowControlOk(ReceiveFlowControl(debit_connection_window(connection_window, length)?, ClosedByPeerStreamReceiveWindow(open_stream_id, debit_stream_window(stream_window, length)?))))
			false => Ok(ReceiveFlowControlOk(ReceiveFlowControl(debit_connection_window(connection_window, length)?, OpenStreamReceiveWindow(open_stream_id, debit_stream_window(stream_window, length)?, next_priority))))
		end
		ContentLengthBodyFailed(error) => Ok(ReceiveFlowControlFailed(error))
	end
end

fn receive_first_open_stream_data_after_windows(offset: Int, stream_id: Int, length: Int, application_length: Int, end_stream: Bool, preview: ByteChunk, connection_window: Int, first_stream_id: Int, first_stream_window: Int, first_priority: StreamPriorityState, second_stream_id: Int, second_stream_window: Int, second_priority: StreamPriorityState) -> Result<ReceiveFlowControlDecision, String>
	let body_decision: ContentLengthBodyDecision = update_content_length_body(offset, 0, stream_id, application_length, end_stream, "open-stream", preview, first_priority)?
	match body_decision
		ContentLengthBodyOk(next_priority) => Ok(ReceiveFlowControlOk(ReceiveFlowControl(debit_connection_window(connection_window, length)?, TwoOpenStreamReceiveWindows(first_stream_id, debit_stream_window(first_stream_window, length)?, next_priority, second_stream_id, second_stream_window, second_priority))))
		ContentLengthBodyFailed(error) => Ok(ReceiveFlowControlFailed(error))
	end
end

fn receive_second_open_stream_data_after_windows(offset: Int, stream_id: Int, length: Int, application_length: Int, end_stream: Bool, preview: ByteChunk, connection_window: Int, first_stream_id: Int, first_stream_window: Int, first_priority: StreamPriorityState, second_stream_id: Int, second_stream_window: Int, second_priority: StreamPriorityState) -> Result<ReceiveFlowControlDecision, String>
	let body_decision: ContentLengthBodyDecision = update_content_length_body(offset, 0, stream_id, application_length, end_stream, "open-stream", preview, second_priority)?
	match body_decision
		ContentLengthBodyOk(next_priority) => Ok(ReceiveFlowControlOk(ReceiveFlowControl(debit_connection_window(connection_window, length)?, TwoOpenStreamReceiveWindows(first_stream_id, first_stream_window, first_priority, second_stream_id, debit_stream_window(second_stream_window, length)?, next_priority))))
		ContentLengthBodyFailed(error) => Ok(ReceiveFlowControlFailed(error))
	end
end

fn receive_first_of_three_open_stream_data_after_windows(offset: Int, stream_id: Int, length: Int, application_length: Int, end_stream: Bool, preview: ByteChunk, connection_window: Int, first_stream_id: Int, first_stream_window: Int, first_priority: StreamPriorityState, second_stream_id: Int, second_stream_window: Int, second_priority: StreamPriorityState, third_stream_id: Int, third_stream_window: Int, third_priority: StreamPriorityState) -> Result<ReceiveFlowControlDecision, String>
	let body_decision: ContentLengthBodyDecision = update_content_length_body(offset, 0, stream_id, application_length, end_stream, "open-stream", preview, first_priority)?
	match body_decision
		ContentLengthBodyOk(next_priority) => Ok(ReceiveFlowControlOk(ReceiveFlowControl(debit_connection_window(connection_window, length)?, ThreeOpenStreamReceiveWindows(first_stream_id, debit_stream_window(first_stream_window, length)?, next_priority, second_stream_id, second_stream_window, second_priority, third_stream_id, third_stream_window, third_priority))))
		ContentLengthBodyFailed(error) => Ok(ReceiveFlowControlFailed(error))
	end
end

fn receive_second_of_three_open_stream_data_after_windows(offset: Int, stream_id: Int, length: Int, application_length: Int, end_stream: Bool, preview: ByteChunk, connection_window: Int, first_stream_id: Int, first_stream_window: Int, first_priority: StreamPriorityState, second_stream_id: Int, second_stream_window: Int, second_priority: StreamPriorityState, third_stream_id: Int, third_stream_window: Int, third_priority: StreamPriorityState) -> Result<ReceiveFlowControlDecision, String>
	let body_decision: ContentLengthBodyDecision = update_content_length_body(offset, 0, stream_id, application_length, end_stream, "open-stream", preview, second_priority)?
	match body_decision
		ContentLengthBodyOk(next_priority) => Ok(ReceiveFlowControlOk(ReceiveFlowControl(debit_connection_window(connection_window, length)?, ThreeOpenStreamReceiveWindows(first_stream_id, first_stream_window, first_priority, second_stream_id, debit_stream_window(second_stream_window, length)?, next_priority, third_stream_id, third_stream_window, third_priority))))
		ContentLengthBodyFailed(error) => Ok(ReceiveFlowControlFailed(error))
	end
end

fn receive_third_open_stream_data_after_windows(offset: Int, stream_id: Int, length: Int, application_length: Int, end_stream: Bool, preview: ByteChunk, connection_window: Int, first_stream_id: Int, first_stream_window: Int, first_priority: StreamPriorityState, second_stream_id: Int, second_stream_window: Int, second_priority: StreamPriorityState, third_stream_id: Int, third_stream_window: Int, third_priority: StreamPriorityState) -> Result<ReceiveFlowControlDecision, String>
	let body_decision: ContentLengthBodyDecision = update_content_length_body(offset, 0, stream_id, application_length, end_stream, "open-stream", preview, third_priority)?
	match body_decision
		ContentLengthBodyOk(next_priority) => Ok(ReceiveFlowControlOk(ReceiveFlowControl(debit_connection_window(connection_window, length)?, ThreeOpenStreamReceiveWindows(first_stream_id, first_stream_window, first_priority, second_stream_id, second_stream_window, second_priority, third_stream_id, debit_stream_window(third_stream_window, length)?, next_priority))))
		ContentLengthBodyFailed(error) => Ok(ReceiveFlowControlFailed(error))
	end
end

fn receive_half_closed_local_stream_data_after_windows(offset: Int, stream_id: Int, length: Int, application_length: Int, end_stream: Bool, preview: ByteChunk, connection_window: Int, open_stream_id: Int, stream_window: Int, priority: StreamPriorityState) -> Result<ReceiveFlowControlDecision, String>
	let body_decision: ContentLengthBodyDecision = update_content_length_body(offset, 0, stream_id, application_length, end_stream, "half-closed-local-stream", preview, priority)?
	match body_decision
		ContentLengthBodyOk(next_priority) => match end_stream
			true => Ok(ReceiveFlowControlOk(ReceiveFlowControl(debit_connection_window(connection_window, length)?, ClosedByPeerStreamReceiveWindow(open_stream_id, debit_stream_window(stream_window, length)?))))
			false => Ok(ReceiveFlowControlOk(ReceiveFlowControl(debit_connection_window(connection_window, length)?, HalfClosedLocalStreamReceiveWindow(open_stream_id, debit_stream_window(stream_window, length)?, next_priority))))
		end
		ContentLengthBodyFailed(error) => Ok(ReceiveFlowControlFailed(error))
	end
end

fn reset_receive_stream(pending: ByteChunk, offset: Int, stream_id: Int, receive_flow_control: ReceiveFlowControl) -> Result<ReceiveFlowControlDecision, String>
	let error_code: Int = rst_stream_error_code(pending)?
	match receive_flow_control
		ReceiveFlowControl(connection_window, NoOpenStreamReceiveWindow) => Ok(ReceiveFlowControlFailed(InvalidFrameKind(offset, 3, stream_id, 1, "idle-stream", "idle_streams_require_headers")))
		ReceiveFlowControl(connection_window, OpenStreamReceiveWindow(open_stream_id, _, _)) => match stream_id == open_stream_id
			true => Ok(ReceiveFlowControlOk(ReceiveFlowControl(connection_window, ResetStreamReceiveWindow(stream_id, error_code))))
			false => Ok(ReceiveFlowControlFailed(InvalidFrameKind(offset, 3, stream_id, 1, "idle-stream", "idle_streams_require_headers")))
		end
		ReceiveFlowControl(connection_window, TwoOpenStreamReceiveWindows(first_stream_id, _, _, second_stream_id, _, _)) => match stream_id == first_stream_id
			true => Ok(ReceiveFlowControlOk(ReceiveFlowControl(connection_window, ResetStreamReceiveWindow(stream_id, error_code))))
			false => match stream_id == second_stream_id
				true => Ok(ReceiveFlowControlOk(ReceiveFlowControl(connection_window, ResetStreamReceiveWindow(stream_id, error_code))))
				false => Ok(ReceiveFlowControlFailed(InvalidFrameKind(offset, 3, stream_id, 1, "idle-stream", "idle_streams_require_headers")))
			end
		end
		ReceiveFlowControl(connection_window, ThreeOpenStreamReceiveWindows(first_stream_id, _, _, second_stream_id, _, _, third_stream_id, _, _)) => match stream_id == first_stream_id
			true => Ok(ReceiveFlowControlOk(ReceiveFlowControl(connection_window, ResetStreamReceiveWindow(stream_id, error_code))))
			false => match stream_id == second_stream_id
				true => Ok(ReceiveFlowControlOk(ReceiveFlowControl(connection_window, ResetStreamReceiveWindow(stream_id, error_code))))
				false => match stream_id == third_stream_id
					true => Ok(ReceiveFlowControlOk(ReceiveFlowControl(connection_window, ResetStreamReceiveWindow(stream_id, error_code))))
					false => Ok(ReceiveFlowControlFailed(InvalidFrameKind(offset, 3, stream_id, 1, "idle-stream", "idle_streams_require_headers")))
				end
			end
		end
		ReceiveFlowControl(connection_window, ClientPushAssociatedStreamReceiveWindow(open_stream_id, _, _, promised_stream_id)) => match stream_id == open_stream_id
			true => Ok(ReceiveFlowControlOk(ReceiveFlowControl(connection_window, ResetStreamReceiveWindow(stream_id, error_code))))
			false => match stream_id == promised_stream_id
				true => Ok(ReceiveFlowControlFailed(InvalidFrameKind(offset, 3, stream_id, 1, "reserved-by-peer-stream", "reserved_by_peer_requires_response_headers")))
				false => Ok(ReceiveFlowControlFailed(InvalidFrameKind(offset, 3, stream_id, 1, "idle-stream", "idle_streams_require_headers")))
			end
		end
		ReceiveFlowControl(connection_window, HalfClosedLocalStreamReceiveWindow(open_stream_id, _, _)) => match stream_id == open_stream_id
			true => Ok(ReceiveFlowControlOk(ReceiveFlowControl(connection_window, ResetStreamReceiveWindow(stream_id, error_code))))
			false => Ok(ReceiveFlowControlFailed(InvalidFrameKind(offset, 3, stream_id, 1, "idle-stream", "idle_streams_require_headers")))
		end
		ReceiveFlowControl(connection_window, ClosedByPeerStreamReceiveWindow(closed_stream_id, _)) => match stream_id == closed_stream_id
			true => Ok(ReceiveFlowControlFailed(InvalidFrameKind(offset, 3, stream_id, 1, "closed-by-peer-stream", "closed_by_peer_rejects_later_frames")))
			false => Ok(ReceiveFlowControlFailed(InvalidFrameKind(offset, 3, stream_id, 1, "idle-stream", "idle_streams_require_headers")))
		end
		ReceiveFlowControl(connection_window, ResetStreamReceiveWindow(reset_stream_id, _)) => match stream_id == reset_stream_id
			true => Ok(ReceiveFlowControlFailed(InvalidFrameKind(offset, 3, stream_id, 1, "reset-stream", "reset_stream_rejects_later_frames")))
			false => Ok(ReceiveFlowControlFailed(InvalidFrameKind(offset, 3, stream_id, 1, "idle-stream", "idle_streams_require_headers")))
		end
	end
end

fn rst_stream_error_code(pending: ByteChunk) -> Result<Int, String>
	let payload_offset: ByteOffset = byte_offset(9)?
	let payload_count: ByteCount = byte_count(4)?
	let payload: ByteView = byte_view(pending, payload_offset, payload_count)?
	byte_read_u32_be(payload)
end

fn max_receive_flow_control_window() -> Int
	2147483647
end

fn update_window_receive_credit(pending: ByteChunk, offset: Int, stream_id: Int, receive_flow_control: ReceiveFlowControl) -> Result<ReceiveFlowControlDecision, String>
	let increment: Int = window_update_increment(pending)?
	let preview: ByteView = window_update_payload_view(pending)?
	match stream_id
		0 => Ok(update_connection_receive_credit(offset, increment, preview, receive_flow_control))
		_ => Ok(update_stream_receive_credit(offset, stream_id, increment, preview, receive_flow_control))
	end
end

fn window_update_increment(pending: ByteChunk) -> Result<Int, String>
	let payload: ByteView = window_update_payload_view(pending)?
	byte_read_u31_be(payload)
end

fn window_update_payload_view(pending: ByteChunk) -> Result<ByteView, String>
	let payload_offset: ByteOffset = byte_offset(9)?
	let payload_count: ByteCount = byte_count(4)?
	byte_view(pending, payload_offset, payload_count)
end

fn update_connection_receive_credit(offset: Int, increment: Int, preview: ByteView, receive_flow_control: ReceiveFlowControl) -> ReceiveFlowControlDecision
	match receive_flow_control
		ReceiveFlowControl(connection_window, open_stream) => match window_update_increment_value(increment)
			Err(_) => ReceiveFlowControlFailed(InvalidWindowUpdateIncrement(offset, 0, increment, 1, max_receive_flow_control_window(), "connection-flow-control", "window_update_increment_nonzero", preview))
			Ok(domain_increment) => match connection_window_credit(connection_window + window_update_increment_int(domain_increment))
				Err(_) => ReceiveFlowControlFailed(FlowControlWindowExceeded(offset, 8, 0, increment, max_receive_flow_control_window() - connection_window, "connection-flow-control", "connection_receive_window", byte_view_to_chunk(preview)))
				Ok(next_credit) => ReceiveFlowControlOk(ReceiveFlowControl(connection_window_credit_value(next_credit), open_stream))
			end
		end
	end
end

fn update_stream_receive_credit(offset: Int, stream_id: Int, increment: Int, preview: ByteView, receive_flow_control: ReceiveFlowControl) -> ReceiveFlowControlDecision
	match receive_flow_control
		ReceiveFlowControl(connection_window, NoOpenStreamReceiveWindow) => ReceiveFlowControlFailed(InvalidFrameKind(offset, 8, stream_id, 1, "idle-stream", "idle_streams_require_headers"))
		ReceiveFlowControl(connection_window, OpenStreamReceiveWindow(open_stream_id, stream_window, priority)) => match stream_id == open_stream_id
			false => ReceiveFlowControlFailed(InvalidFrameKind(offset, 8, stream_id, 1, "idle-stream", "idle_streams_require_headers"))
			true => match window_update_increment_value(increment)
				Err(_) => ReceiveFlowControlFailed(InvalidWindowUpdateIncrement(offset, stream_id, increment, 1, max_receive_flow_control_window(), "open-stream", "window_update_increment_nonzero", preview))
				Ok(domain_increment) => match stream_window_credit(stream_window + window_update_increment_int(domain_increment))
					Err(_) => ReceiveFlowControlFailed(FlowControlWindowExceeded(offset, 8, stream_id, increment, max_receive_flow_control_window() - stream_window, "open-stream", "stream_receive_window", byte_view_to_chunk(preview)))
					Ok(next_credit) => ReceiveFlowControlOk(ReceiveFlowControl(connection_window, OpenStreamReceiveWindow(open_stream_id, stream_window_credit_value(next_credit), priority)))
				end
			end
		end
		ReceiveFlowControl(connection_window, TwoOpenStreamReceiveWindows(first_stream_id, first_stream_window, first_priority, second_stream_id, second_stream_window, second_priority)) => match stream_id == first_stream_id
			true => match window_update_increment_is_invalid(increment)
				true => ReceiveFlowControlFailed(InvalidWindowUpdateIncrement(offset, stream_id, increment, 1, max_receive_flow_control_window(), "open-stream", "window_update_increment_nonzero", preview))
				false => match stream_window_refill_overflows(first_stream_window, increment)
					true => ReceiveFlowControlFailed(FlowControlWindowExceeded(offset, 8, stream_id, increment, max_receive_flow_control_window() - first_stream_window, "open-stream", "stream_receive_window", byte_view_to_chunk(preview)))
					false => ReceiveFlowControlOk(ReceiveFlowControl(connection_window, TwoOpenStreamReceiveWindows(first_stream_id, refilled_stream_window(first_stream_window, increment), first_priority, second_stream_id, second_stream_window, second_priority)))
				end
			end
			false => match stream_id == second_stream_id
				true => match window_update_increment_is_invalid(increment)
					true => ReceiveFlowControlFailed(InvalidWindowUpdateIncrement(offset, stream_id, increment, 1, max_receive_flow_control_window(), "open-stream", "window_update_increment_nonzero", preview))
					false => match stream_window_refill_overflows(second_stream_window, increment)
						true => ReceiveFlowControlFailed(FlowControlWindowExceeded(offset, 8, stream_id, increment, max_receive_flow_control_window() - second_stream_window, "open-stream", "stream_receive_window", byte_view_to_chunk(preview)))
						false => ReceiveFlowControlOk(ReceiveFlowControl(connection_window, TwoOpenStreamReceiveWindows(first_stream_id, first_stream_window, first_priority, second_stream_id, refilled_stream_window(second_stream_window, increment), second_priority)))
					end
				end
				false => ReceiveFlowControlFailed(InvalidFrameKind(offset, 8, stream_id, 1, "idle-stream", "idle_streams_require_headers"))
			end
		end
		ReceiveFlowControl(connection_window, ThreeOpenStreamReceiveWindows(first_stream_id, first_stream_window, first_priority, second_stream_id, second_stream_window, second_priority, third_stream_id, third_stream_window, third_priority)) => match stream_id == first_stream_id
			true => match window_update_increment_is_invalid(increment)
				true => ReceiveFlowControlFailed(InvalidWindowUpdateIncrement(offset, stream_id, increment, 1, max_receive_flow_control_window(), "open-stream", "window_update_increment_nonzero", preview))
				false => match stream_window_refill_overflows(first_stream_window, increment)
					true => ReceiveFlowControlFailed(FlowControlWindowExceeded(offset, 8, stream_id, increment, max_receive_flow_control_window() - first_stream_window, "open-stream", "stream_receive_window", byte_view_to_chunk(preview)))
					false => ReceiveFlowControlOk(ReceiveFlowControl(connection_window, ThreeOpenStreamReceiveWindows(first_stream_id, refilled_stream_window(first_stream_window, increment), first_priority, second_stream_id, second_stream_window, second_priority, third_stream_id, third_stream_window, third_priority)))
				end
			end
			false => match stream_id == second_stream_id
				true => match window_update_increment_is_invalid(increment)
					true => ReceiveFlowControlFailed(InvalidWindowUpdateIncrement(offset, stream_id, increment, 1, max_receive_flow_control_window(), "open-stream", "window_update_increment_nonzero", preview))
					false => match stream_window_refill_overflows(second_stream_window, increment)
						true => ReceiveFlowControlFailed(FlowControlWindowExceeded(offset, 8, stream_id, increment, max_receive_flow_control_window() - second_stream_window, "open-stream", "stream_receive_window", byte_view_to_chunk(preview)))
						false => ReceiveFlowControlOk(ReceiveFlowControl(connection_window, ThreeOpenStreamReceiveWindows(first_stream_id, first_stream_window, first_priority, second_stream_id, refilled_stream_window(second_stream_window, increment), second_priority, third_stream_id, third_stream_window, third_priority)))
					end
				end
				false => match stream_id == third_stream_id
					true => match window_update_increment_is_invalid(increment)
						true => ReceiveFlowControlFailed(InvalidWindowUpdateIncrement(offset, stream_id, increment, 1, max_receive_flow_control_window(), "open-stream", "window_update_increment_nonzero", preview))
						false => match stream_window_refill_overflows(third_stream_window, increment)
							true => ReceiveFlowControlFailed(FlowControlWindowExceeded(offset, 8, stream_id, increment, max_receive_flow_control_window() - third_stream_window, "open-stream", "stream_receive_window", byte_view_to_chunk(preview)))
							false => ReceiveFlowControlOk(ReceiveFlowControl(connection_window, ThreeOpenStreamReceiveWindows(first_stream_id, first_stream_window, first_priority, second_stream_id, second_stream_window, second_priority, third_stream_id, refilled_stream_window(third_stream_window, increment), third_priority)))
						end
					end
					false => ReceiveFlowControlFailed(InvalidFrameKind(offset, 8, stream_id, 1, "idle-stream", "idle_streams_require_headers"))
				end
			end
		end
		ReceiveFlowControl(connection_window, ClientPushAssociatedStreamReceiveWindow(open_stream_id, stream_window, priority, promised_stream_id)) => match stream_id == open_stream_id
			true => match window_update_increment_is_invalid(increment)
				true => ReceiveFlowControlFailed(InvalidWindowUpdateIncrement(offset, stream_id, increment, 1, max_receive_flow_control_window(), "open-stream", "window_update_increment_nonzero", preview))
				false => match stream_window_refill_overflows(stream_window, increment)
					true => ReceiveFlowControlFailed(FlowControlWindowExceeded(offset, 8, stream_id, increment, max_receive_flow_control_window() - stream_window, "open-stream", "stream_receive_window", byte_view_to_chunk(preview)))
					false => ReceiveFlowControlOk(ReceiveFlowControl(connection_window, ClientPushAssociatedStreamReceiveWindow(open_stream_id, refilled_stream_window(stream_window, increment), priority, promised_stream_id)))
				end
			end
			false => match stream_id == promised_stream_id
				true => ReceiveFlowControlFailed(InvalidFrameKind(offset, 8, stream_id, 1, "reserved-by-peer-stream", "reserved_by_peer_requires_response_headers"))
				false => ReceiveFlowControlFailed(InvalidFrameKind(offset, 8, stream_id, 1, "idle-stream", "idle_streams_require_headers"))
			end
		end
		ReceiveFlowControl(_, HalfClosedLocalStreamReceiveWindow(open_stream_id, _, _)) => match stream_id == open_stream_id
			true => ReceiveFlowControlFailed(InvalidFrameKind(offset, 8, stream_id, 1, "half-closed-local-stream", "half_closed_local_data_only"))
			false => ReceiveFlowControlFailed(InvalidFrameKind(offset, 8, stream_id, 1, "idle-stream", "idle_streams_require_headers"))
		end
		ReceiveFlowControl(_, ClosedByPeerStreamReceiveWindow(closed_stream_id, _)) => match stream_id == closed_stream_id
			true => ReceiveFlowControlFailed(InvalidFrameKind(offset, 8, stream_id, 1, "closed-by-peer-stream", "closed_by_peer_rejects_later_frames"))
			false => ReceiveFlowControlFailed(InvalidFrameKind(offset, 8, stream_id, 1, "idle-stream", "idle_streams_require_headers"))
		end
		ReceiveFlowControl(_, ResetStreamReceiveWindow(reset_stream_id, _)) => match stream_id == reset_stream_id
			true => ReceiveFlowControlFailed(InvalidFrameKind(offset, 8, stream_id, 1, "reset-stream", "reset_stream_rejects_later_frames"))
			false => ReceiveFlowControlFailed(InvalidFrameKind(offset, 8, stream_id, 1, "idle-stream", "idle_streams_require_headers"))
		end
	end
end

fn update_priority_receive_state(pending: ByteChunk, offset: Int, length: Int, stream_id: Int, receive_flow_control: ReceiveFlowControl) -> Result<ReceiveFlowControlDecision, String>
	let payload: ByteChunk = frame_payload_chunk(pending, length)?
	let payload_view: ByteView = byte_view(payload, byte_offset(0)?, byte_count(5)?)?
	match receive_flow_control
		ReceiveFlowControl(connection_window, NoOpenStreamReceiveWindow) => Ok(ReceiveFlowControlOk(ReceiveFlowControl(connection_window, NoOpenStreamReceiveWindow)))
		ReceiveFlowControl(connection_window, OpenStreamReceiveWindow(open_stream_id, stream_window, priority)) => match stream_id == open_stream_id
			true => Ok(ReceiveFlowControlOk(ReceiveFlowControl(connection_window, OpenStreamReceiveWindow(open_stream_id, stream_window, stream_priority_with_priority(priority, StreamPriority(priority_dependency_stream_id(payload_view)?, priority_exclusive(payload_view)?, priority_weight(payload_view)?))))))
			false => Ok(ReceiveFlowControlOk(ReceiveFlowControl(connection_window, OpenStreamReceiveWindow(open_stream_id, stream_window, priority))))
		end
		ReceiveFlowControl(connection_window, TwoOpenStreamReceiveWindows(first_stream_id, first_stream_window, first_priority, second_stream_id, second_stream_window, second_priority)) => match stream_id == first_stream_id
			true => Ok(ReceiveFlowControlOk(ReceiveFlowControl(connection_window, TwoOpenStreamReceiveWindows(first_stream_id, first_stream_window, stream_priority_with_priority(first_priority, StreamPriority(priority_dependency_stream_id(payload_view)?, priority_exclusive(payload_view)?, priority_weight(payload_view)?)), second_stream_id, second_stream_window, second_priority))))
			false => match stream_id == second_stream_id
				true => Ok(ReceiveFlowControlOk(ReceiveFlowControl(connection_window, TwoOpenStreamReceiveWindows(first_stream_id, first_stream_window, first_priority, second_stream_id, second_stream_window, stream_priority_with_priority(second_priority, StreamPriority(priority_dependency_stream_id(payload_view)?, priority_exclusive(payload_view)?, priority_weight(payload_view)?))))))
				false => Ok(ReceiveFlowControlFailed(InvalidFrameKind(offset, 2, stream_id, 1, "idle-stream", "idle_streams_require_headers")))
			end
		end
		ReceiveFlowControl(connection_window, ThreeOpenStreamReceiveWindows(first_stream_id, first_stream_window, first_priority, second_stream_id, second_stream_window, second_priority, third_stream_id, third_stream_window, third_priority)) => match stream_id == first_stream_id
			true => Ok(ReceiveFlowControlOk(ReceiveFlowControl(connection_window, ThreeOpenStreamReceiveWindows(first_stream_id, first_stream_window, stream_priority_with_priority(first_priority, StreamPriority(priority_dependency_stream_id(payload_view)?, priority_exclusive(payload_view)?, priority_weight(payload_view)?)), second_stream_id, second_stream_window, second_priority, third_stream_id, third_stream_window, third_priority))))
			false => match stream_id == second_stream_id
				true => Ok(ReceiveFlowControlOk(ReceiveFlowControl(connection_window, ThreeOpenStreamReceiveWindows(first_stream_id, first_stream_window, first_priority, second_stream_id, second_stream_window, stream_priority_with_priority(second_priority, StreamPriority(priority_dependency_stream_id(payload_view)?, priority_exclusive(payload_view)?, priority_weight(payload_view)?)), third_stream_id, third_stream_window, third_priority))))
				false => match stream_id == third_stream_id
					true => Ok(ReceiveFlowControlOk(ReceiveFlowControl(connection_window, ThreeOpenStreamReceiveWindows(first_stream_id, first_stream_window, first_priority, second_stream_id, second_stream_window, second_priority, third_stream_id, third_stream_window, stream_priority_with_priority(third_priority, StreamPriority(priority_dependency_stream_id(payload_view)?, priority_exclusive(payload_view)?, priority_weight(payload_view)?))))))
					false => Ok(ReceiveFlowControlFailed(InvalidFrameKind(offset, 2, stream_id, 1, "idle-stream", "idle_streams_require_headers")))
				end
			end
		end
		ReceiveFlowControl(connection_window, ClientPushAssociatedStreamReceiveWindow(open_stream_id, stream_window, priority, promised_stream_id)) => match stream_id == open_stream_id
			true => Ok(ReceiveFlowControlOk(ReceiveFlowControl(connection_window, ClientPushAssociatedStreamReceiveWindow(open_stream_id, stream_window, stream_priority_with_priority(priority, StreamPriority(priority_dependency_stream_id(payload_view)?, priority_exclusive(payload_view)?, priority_weight(payload_view)?)), promised_stream_id))))
			false => match stream_id == promised_stream_id
				true => Ok(ReceiveFlowControlFailed(InvalidFrameKind(offset, 2, stream_id, 1, "reserved-by-peer-stream", "reserved_by_peer_requires_response_headers")))
				false => Ok(ReceiveFlowControlFailed(InvalidFrameKind(offset, 2, stream_id, 1, "idle-stream", "idle_streams_require_headers")))
			end
		end
		ReceiveFlowControl(connection_window, HalfClosedLocalStreamReceiveWindow(open_stream_id, stream_window, priority)) => match stream_id == open_stream_id
			true => Ok(ReceiveFlowControlOk(ReceiveFlowControl(connection_window, HalfClosedLocalStreamReceiveWindow(open_stream_id, stream_window, stream_priority_with_priority(priority, StreamPriority(priority_dependency_stream_id(payload_view)?, priority_exclusive(payload_view)?, priority_weight(payload_view)?))))))
			false => Ok(ReceiveFlowControlFailed(InvalidFrameKind(offset, 2, stream_id, 1, "idle-stream", "idle_streams_require_headers")))
		end
		ReceiveFlowControl(_, ClosedByPeerStreamReceiveWindow(closed_stream_id, _)) => match stream_id == closed_stream_id
			true => Ok(ReceiveFlowControlFailed(InvalidFrameKind(offset, 2, stream_id, 1, "closed-by-peer-stream", "closed_by_peer_rejects_later_frames")))
			false => Ok(ReceiveFlowControlFailed(InvalidFrameKind(offset, 2, stream_id, 1, "idle-stream", "idle_streams_require_headers")))
		end
		ReceiveFlowControl(_, ResetStreamReceiveWindow(reset_stream_id, _)) => match stream_id == reset_stream_id
			true => Ok(ReceiveFlowControlFailed(InvalidFrameKind(offset, 2, stream_id, 1, "reset-stream", "reset_stream_rejects_later_frames")))
			false => Ok(ReceiveFlowControlFailed(InvalidFrameKind(offset, 2, stream_id, 1, "idle-stream", "idle_streams_require_headers")))
		end
	end
end

fn step_kind(step: Http2Step) -> String
	match step
		FrameDecoded(_, _, _, _, _, _, _, _) => "frame"
		Waiting(_) => "waiting"
		Failed(_, _) => "failed"
	end
end

fn step_state(step: Http2Step) -> Http2DecodeState
	match step
		FrameDecoded(state, _, _, _, _, _, _, _) => state
		Waiting(state) => state
		Failed(state, _) => state
	end
end

fn step_failure(step: Http2Step) -> Http2ProtocolFailure
	match step
		FrameDecoded(_, _, _, _, _, _, _, _) => ClosedWithPending(0, 0, byte_chunk([]))
		Waiting(_) => ClosedWithPending(0, 0, byte_chunk([]))
		Failed(_, failure) => failure
	end
end

fn step_offset(step: Http2Step) -> Int
	match step
		FrameDecoded(_, offset, _, _, _, _, _, _) => offset
		Waiting(_) => 0
		Failed(_, _) => 0
	end
end

fn step_kind_value(step: Http2Step) -> Int
	match step
		FrameDecoded(_, _, _, kind, _, _, _, _) => kind
		Waiting(_) => 0
		Failed(_, _) => 0
	end
end

fn step_stream_id(step: Http2Step) -> Int
	match step
		FrameDecoded(_, _, _, _, _, stream_id, _, _) => stream_id
		Waiting(_) => 0
		Failed(_, _) => 0
	end
end

fn step_flags(step: Http2Step) -> Int
	match step
		FrameDecoded(_, _, _, _, flags, _, _, _) => flags
		Waiting(_) => 0
		Failed(_, _) => 0
	end
end

fn step_completed_count(step: Http2Step) -> Int
	match step
		FrameDecoded(_, _, _, _, _, _, completed_header_block, _) => byte_count_to_int(byte_chunk_count(completed_header_block))
		Waiting(_) => 0
		Failed(_, _) => 0
	end
end

fn step_completed_header_block(step: Http2Step) -> ByteChunk
	match step
		FrameDecoded(_, _, _, _, _, _, completed_header_block, _) => completed_header_block
		Waiting(_) => empty_header_block()
		Failed(_, _) => empty_header_block()
	end
end

fn step_frame_payload_chunk(step: Http2Step) -> ByteChunk
	match step
		FrameDecoded(_, _, _, _, _, _, _, KnownFrame(_, _, _, payload)) => byte_view_to_chunk(payload)
		FrameDecoded(_, _, _, _, _, _, _, PriorityFrame(_, _, _, _, _)) => byte_chunk([])
		FrameDecoded(_, _, _, _, _, _, _, UnknownFrame(_, _, _, payload)) => byte_view_to_chunk(payload)
		Waiting(_) => byte_chunk([])
		Failed(_, _) => byte_chunk([])
	end
end

fn state_pending_count(state: Http2DecodeState) -> Int
	match state
		State(pending, _, _, _, _, _, _, _, _, _) => byte_count_to_int(byte_chunk_count(pending))
	end
end

fn state_pending_chunk(state: Http2DecodeState) -> ByteChunk
	match state
		State(pending, _, _, _, _, _, _, _, _, _) => pending
	end
end

fn state_next_offset(state: Http2DecodeState) -> Int
	match state
		State(_, next_offset, _, _, _, _, _, _, _, _) => next_offset
	end
end

fn state_receive_limit(state: Http2DecodeState) -> ReceiveLimitEntry
	match state
		State(_, _, _, _, _, receive_limit, _, _, _, _) => receive_limit
	end
end

fn state_preface_label(state: Http2DecodeState) -> String
	match state
		State(_, _, ExpectPreface, _, _, _, _, _, _, _) => "expect"
		State(_, _, AfterPreface, _, _, _, _, _, _, _) => "done"
	end
end

fn state_continuation_label(state: Http2DecodeState) -> String
	match state
		State(_, _, _, NoContinuation, _, _, _, _, _, _) => "none"
		State(_, _, _, Continuation(_, _, _, _, _, _, _), _, _, _, _, _, _) => "active"
	end
end

fn state_continuation_count(state: Http2DecodeState) -> Int
	match state
		State(_, _, _, NoContinuation, _, _, _, _, _, _) => 0
		State(_, _, _, Continuation(_, _, _, _, _, _, accumulated), _, _, _, _, _, _) => byte_count_to_int(byte_chunk_count(accumulated))
	end
end

fn state_continuation_stream(state: Http2DecodeState) -> Int
	match state
		State(_, _, _, NoContinuation, _, _, _, _, _, _) => 0
		State(_, _, _, Continuation(stream_id, _, _, _, _, _, _), _, _, _, _, _, _) => stream_id
	end
end

fn state_continuation_started_kind(state: Http2DecodeState) -> Int
	match state
		State(_, _, _, NoContinuation, _, _, _, _, _, _) => 0
		State(_, _, _, Continuation(_, started_kind, _, _, _, _, _), _, _, _, _, _, _) => started_kind
	end
