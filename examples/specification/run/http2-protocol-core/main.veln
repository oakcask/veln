fn failure_active_state(failure: Http2ProtocolFailure) -> String
	match failure
		ClosedWithPending(_, _, _) => "none"
		ClosedWithPartialPreface(_, _) => "connection-preface"
		InvalidPreface(_, _, _, _) => "connection-preface"
		ContinuationExpected(offset, actual_kind, actual_stream, expected_stream, started_kind, started_offset, preview_chunk) => "headers"
		InvalidFrameKind(offset, actual_kind, stream_id, expected_kind, active_state, rule_provenance) => active_state
		InvalidStreamId(offset, frame_kind, stream_id, required_domain, endpoint_role, active_state, rule_provenance) => active_state
			InvalidPayloadLength(offset, frame_kind, stream_id, observed_length, expected_length, active_state, rule_provenance, preview) => active_state
			InvalidWindowUpdateIncrement(offset, stream_id, observed_increment, accepted_min_increment, accepted_max_increment, active_state, rule_provenance, preview) => active_state
			InvalidDataPadding(offset, stream_id, pad_length, remaining_payload_length, active_state, rule_provenance, preview) => active_state
			ContentLengthMismatch(offset, frame_kind, stream_id, expected_length, observed_length, active_state, rule_provenance, preview) => active_state
			InvalidRequestHeaderList(offset, frame_kind, stream_id, failed_header_fact, header_name, decoded_header_names, preview_chunk) => request_header_active_state(failed_header_fact, decoded_header_names)
			InvalidResponseHeaderList(offset, frame_kind, stream_id, failed_header_fact, header_name, decoded_header_names, active_state, preview_chunk) => active_state
			UnexpectedSettingsAck(_, active_state, _, _) => active_state
		InvalidPriorityDependency(offset, stream_id, dependency_stream_id, active_state, rule_provenance, preview) => active_state
		StreamAfterGoaway(offset, stream_id, last_stream_id, shutdown_state, endpoint_role, rule_provenance, preview_chunk) => shutdown_state
		FrameSizeExceeded(offset, observed_length, receive_limit, frame_kind, stream_id) => "none"
		FlowControlWindowExceeded(offset, frame_kind, stream_id, observed_length, allowed_window_credit, active_state, rule_provenance, preview_chunk) => active_state
		ConcurrentStreamsExceeded(offset, stream_id, attempted_count, allowed_count, endpoint_role, active_state, receive_limit_provenance, rule_provenance, preview_chunk) => active_state
		HeaderListSizeExceeded(offset, observed_size, receive_limit, frame_kind, stream_id, rule_provenance, preview_chunk) => "header-list"
		HeaderTableSizeExceeded(offset, observed_size, receive_limit, frame_kind, stream_id, rule_provenance, preview_chunk) => "hpack-dynamic-table"
		SettingsValueOutOfRange(offset, setting_identifier, setting_name, observed_value, accepted_min_value, accepted_max_value, peer_limit_provenance, preview) => "connection-control"
		HpackFixtureDecodeFailed(offset, observed_size, observed_first_byte, requested_dynamic_index, dynamic_table_entry_count, expected_fixture, codec_module, preview_chunk) => "hpack-fixture"
		HpackTableSizeUpdateNotAtStart(offset, observed_size, observed_first_byte, observed_update_size, frame_kind, stream_id, active_state, expected_fixture, codec_module, preview_chunk) => active_state
	end
end

fn request_header_active_state(failed_header_fact: String, decoded_header_names: String) -> String
	match request_header_failure_is_trailer(failed_header_fact, decoded_header_names)
		true => "request-trailers"
		false => "request-headers"
	end
end

fn request_header_failure_is_trailer(failed_header_fact: String, decoded_header_names: String) -> Bool
	match failed_header_fact
		"trailer_pseudo_header" => true
		_ => match decoded_header_names
			"server,Server" => true
			"server,bad header" => true
			"server,connection" => true
			"server,te" => true
			"Server" => true
			"bad@name" => true
			_ => false
		end
	end
end

fn request_header_rule_provenance(failed_header_fact: String) -> String
	match failed_header_fact
		"ordinary_header_name_not_lowercase" => "rfc9113_field_name_lowercase"
		"ordinary_header_name_invalid_token" => "rfc9110_field_name_token"
		"connection_specific_header" => "rfc9113_connection_specific_header_fields"
		"te_header_value_not_trailers" => "rfc9113_te_trailers_only"
		"content_length_invalid" => "rfc9113_content_length"
		"content_length_mismatch" => "rfc9113_content_length"
		"method_value_empty" => "rfc9113_request_pseudo_headers"
		"scheme_value_not_http_or_https" => "rfc9113_request_scheme"
		"path_value_empty" => "rfc9113_request_pseudo_headers"
		"authority_value_invalid" => "rfc9113_request_authority"
		"trailer_pseudo_header" => "rfc9113_trailer_pseudo_headers"
		_ => "rfc9113_request_pseudo_headers"
	end
end

fn response_header_rule_provenance(failed_header_fact: String) -> String
	match failed_header_fact
		"ordinary_header_name_not_lowercase" => "rfc9113_field_name_lowercase"
		"ordinary_header_name_invalid_token" => "rfc9110_field_name_token"
		"te_header_value_not_trailers" => "rfc9113_te_trailers_only"
		"content_length_invalid" => "rfc9113_content_length"
		"content_length_mismatch" => "rfc9113_content_length"
		"trailer_pseudo_header" => "rfc9113_trailer_pseudo_headers"
		_ => "rfc9113_response_pseudo_headers"
	end
end

fn failure_rule_provenance(failure: Http2ProtocolFailure) -> String
	match failure
		ClosedWithPending(_, _, _) => "none"
		ClosedWithPartialPreface(_, _) => "rfc9113_client_connection_preface"
		InvalidPreface(_, _, _, _) => "rfc9113_client_connection_preface"
		ContinuationExpected(offset, actual_kind, actual_stream, expected_stream, started_kind, started_offset, preview_chunk) => "rfc9113_continuation_sequence"
		InvalidFrameKind(offset, actual_kind, stream_id, expected_kind, active_state, rule_provenance) => rule_provenance
		InvalidStreamId(offset, frame_kind, stream_id, required_domain, endpoint_role, active_state, rule_provenance) => rule_provenance
			InvalidPayloadLength(offset, frame_kind, stream_id, observed_length, expected_length, active_state, rule_provenance, preview) => rule_provenance
			InvalidWindowUpdateIncrement(offset, stream_id, observed_increment, accepted_min_increment, accepted_max_increment, active_state, rule_provenance, preview) => rule_provenance
			InvalidDataPadding(offset, stream_id, pad_length, remaining_payload_length, active_state, rule_provenance, preview) => rule_provenance
			ContentLengthMismatch(offset, frame_kind, stream_id, expected_length, observed_length, active_state, rule_provenance, preview) => rule_provenance
			InvalidRequestHeaderList(offset, frame_kind, stream_id, failed_header_fact, header_name, decoded_header_names, preview_chunk) => request_header_rule_provenance(failed_header_fact)
			InvalidResponseHeaderList(offset, frame_kind, stream_id, failed_header_fact, header_name, decoded_header_names, active_state, preview_chunk) => response_header_rule_provenance(failed_header_fact)
			UnexpectedSettingsAck(_, _, rule_provenance, _) => rule_provenance
		InvalidPriorityDependency(offset, stream_id, dependency_stream_id, active_state, rule_provenance, preview) => rule_provenance
		StreamAfterGoaway(offset, stream_id, last_stream_id, shutdown_state, endpoint_role, rule_provenance, preview_chunk) => rule_provenance
		FrameSizeExceeded(offset, observed_length, receive_limit, frame_kind, stream_id) => "none"
		FlowControlWindowExceeded(offset, frame_kind, stream_id, observed_length, allowed_window_credit, active_state, rule_provenance, preview_chunk) => rule_provenance
		ConcurrentStreamsExceeded(offset, stream_id, attempted_count, allowed_count, endpoint_role, active_state, receive_limit_provenance, rule_provenance, preview_chunk) => rule_provenance
		HeaderListSizeExceeded(offset, observed_size, receive_limit, frame_kind, stream_id, rule_provenance, preview_chunk) => rule_provenance
		HeaderTableSizeExceeded(offset, observed_size, receive_limit, frame_kind, stream_id, rule_provenance, preview_chunk) => rule_provenance
		SettingsValueOutOfRange(offset, setting_identifier, setting_name, observed_value, accepted_min_value, accepted_max_value, peer_limit_provenance, preview) => "http2_settings_value_range"
		HpackFixtureDecodeFailed(offset, observed_size, observed_first_byte, requested_dynamic_index, dynamic_table_entry_count, expected_fixture, codec_module, preview_chunk) => "hpack_fixture_decode"
		HpackTableSizeUpdateNotAtStart(offset, observed_size, observed_first_byte, observed_update_size, frame_kind, stream_id, active_state, expected_fixture, codec_module, preview_chunk) => match expected_fixture == "fixture HPACK table-size update without trailing bytes"
			true => "hpack_dynamic_table_size_update_trailing_bytes"
			false => "hpack_dynamic_table_size_update_placement"
		end
	end
end

