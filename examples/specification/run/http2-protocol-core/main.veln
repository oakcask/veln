fn outbound_local_stream_state_label(state: OutboundLocalStreamState) -> String
	match state
		NoOutboundLocalStream => "none"
		OpenOutboundLocalStream(_) => "open"
		ClosedOutboundLocalStream(_) => "closed"
		ResetOutboundLocalStream(_, _) => "reset"
	end
end

fn outbound_local_stream_state_id(state: OutboundLocalStreamState) -> Int
	match state
		NoOutboundLocalStream => 0
		OpenOutboundLocalStream(stream_id) => stream_id
		ClosedOutboundLocalStream(stream_id) => stream_id
		ResetOutboundLocalStream(stream_id, _) => stream_id
	end
end

fn outbound_local_stream_reset_code(state: OutboundLocalStreamState) -> Int
	match state
		ResetOutboundLocalStream(_, error_code) => error_code
		NoOutboundLocalStream => 0
		OpenOutboundLocalStream(_) => 0
		ClosedOutboundLocalStream(_) => 0
	end
end

