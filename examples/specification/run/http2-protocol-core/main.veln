fn print_hpack_failure_cases(state: Http2DecodeState) -> Result<(), String> effects [stdio]
	let hpack_fixture_bad: Http2Step = receive(InputChunk(byte_chunk_from_hex("0000010104000000017f")?), state)?
	print_failure("hpack-fixture", hpack_fixture_bad)
	let hpack_literal_huffman: Http2Step = receive(InputChunk(byte_chunk_from_hex("0000020104000000010480")?), state)?
	print_step("hpack-literal-huffman", hpack_literal_huffman)
	let ignored_hpack_literal_huffman: () = emit_header_block("http2-hpack-literal-huffman", hpack_literal_huffman, "0480")?
	print_hpack_transition("hpack-literal-huffman", hpack_literal_huffman)
	let hpack_literal_huffman_malformed: Http2Step = receive(InputChunk(byte_chunk_from_hex("000003010400000001048100")?), state)?
	print_failure("hpack-literal-huffman-malformed", hpack_literal_huffman_malformed)
	let hpack_literal_authority_malformed: Http2Step = receive(InputChunk(byte_chunk_from_hex("0000020104000000010100")?), state)?
	print_failure("hpack-literal-authority-malformed", hpack_literal_authority_malformed)
	Ok(())
end

fn print_peer_header_list_size_cases() -> Result<(), String> effects [stdio]
	let peer_max_header_list_size: Http2Step = receive(InputChunk(byte_chunk_from_hex("000006040000000000000600002000")?), frame_state())?
	print_step("peer-max-header-list-size", peer_max_header_list_size)
	print_peer_settings("peer-max-header-list-size", step_state(peer_max_header_list_size))
	let max_header_list_size_settings_ack: Http2Step = receive(InputChunk(byte_chunk_from_hex("000000040100000000")?), step_state(peer_max_header_list_size))?
	print_step("max-header-list-size-settings-ack", max_header_list_size_settings_ack)
	print_peer_settings("max-header-list-size-settings-ack", step_state(max_header_list_size_settings_ack))
	let ignored_header_list_size_cases: () = print_header_list_size_cases(step_state(peer_max_header_list_size))?
	Ok(())
end

pub fn main() -> Result<(), String> effects [stdio]
	let preface_valid: Http2Step = receive(InputChunk(byte_chunk_from_hex("505249202a20485454502f322e300d0a0d0a534d0d0a0d0a000000040000000000")?), empty_state())?
	print_step("preface-valid", preface_valid)
	let preface_unknown: Http2Step = receive(InputChunk(byte_chunk_from_hex("505249202a20485454502f322e300d0a0d0a534d0d0a0d0a0000030a2300000000aabbcc")?), empty_state())?
	let preface_unknown_result: () = print_unknown_frame("preface-unknown", preface_unknown)?
	let preface_partial: Http2Step = receive(InputChunk(byte_chunk_from_hex("505249202a20")?), empty_state())?
	print_step("preface-partial", preface_partial)
	let preface_closed: Http2Step = receive(InputEnd, step_state(preface_partial))?
	print_failure("preface-closed", preface_closed)
	let preface_mismatch: Http2Step = receive(InputChunk(byte_chunk_from_hex("505249202b")?), empty_state())?
	print_failure("preface-mismatch", preface_mismatch)
	let valid: Http2Step = receive(InputChunk(byte_chunk_from_hex("000000040000000000")?), frame_state())?
	print_step("valid", valid)
	let incomplete: Http2Step = receive(InputChunk(byte_chunk_from_hex("00000004")?), frame_state())?
	print_step("incomplete", incomplete)
	let truncated: Http2Step = receive(InputEnd, step_state(incomplete))?
	print_failure("closed", truncated)
	let header_start: Http2Step = receive(InputChunk(byte_chunk_from_hex("000003010000000001aabbcc")?), frame_state())?
	print_step("headers", header_start)
	let continuation_more: Http2Step = receive(InputChunk(byte_chunk_from_hex("000002090000000001ddee")?), step_state(header_start))?
	print_step("continuation-more", continuation_more)
	let continuation_extra: Http2Step = receive(InputChunk(byte_chunk_from_hex("000001090000000001ff")?), step_state(continuation_more))?
	print_step("continuation-extra", continuation_extra)
	let continuation_done: Http2Step = receive(InputChunk(byte_chunk_from_hex("000003090400000001010203")?), step_state(continuation_extra))?
	print_step("continuation-done", continuation_done)
	let ignored_continuation_header_block: () = emit_header_block("http2-continuation-header-block", continuation_done, "aabbccddeeff010203")?
	print_hpack_transition("continuation-done", continuation_done)
	let headers_done: Http2Step = receive(InputChunk(byte_chunk_from_hex("000003010500000001102030")?), frame_state())?
	print_step("headers-done", headers_done)
	let ignored_headers_header_block: () = emit_header_block("http2-headers-header-block", headers_done, "102030")?
	print_hpack_transition("headers-done", headers_done)
	let ignored_headers_end_stream_cases: () = print_headers_end_stream_cases(headers_done)?
	let bad_continuation: Http2Step = receive(InputChunk(byte_chunk_from_hex("000000000000000001")?), step_state(header_start))?
	print_failure("continuation", bad_continuation)
	let wrong_stream_continuation: Http2Step = receive(InputChunk(byte_chunk_from_hex("000000090400000003")?), step_state(header_start))?
	print_failure("continuation-stream", wrong_stream_continuation)
	let closed_continuation: Http2Step = receive(InputEnd, step_state(header_start))?
	print_failure("continuation-closed", closed_continuation)
	let unknown_extension: Http2Step = receive(InputChunk(byte_chunk_from_hex("0000030a2300000000aabbcc")?), frame_state())?
	let ignored_unknown: () = print_unknown_frame("unknown-extension", unknown_extension)?
	let unknown_during_continuation: Http2Step = receive(InputChunk(byte_chunk_from_hex("0000030a2300000001aabbcc")?), step_state(header_start))?
	print_failure("unknown-continuation", unknown_during_continuation)
	let max_allowed_incomplete: Http2Step = receive(InputChunk(byte_chunk_from_hex("004000000000000003")?), frame_state())?
	print_step("frame-size-at-limit", max_allowed_incomplete)
	let too_large: Http2Step = receive(InputChunk(byte_chunk_from_hex("004001000000000003")?), frame_state())?
	print_failure("frame-size", too_large)
	let local_config_too_large: Http2Step = receive(InputChunk(byte_chunk_from_hex("000401000000000003")?), local_config_state(1024))?
	print_failure("frame-size-config", local_config_too_large)
	let local_settings_too_large: Http2Step = receive(InputChunk(byte_chunk_from_hex("002ee1000000000003")?), local_settings_state(12000, 2))?
	print_failure("frame-size-local-settings", local_settings_too_large)
	let peer_settings: Http2Step = receive(InputChunk(byte_chunk_from_hex("000006040000000000000500008000")?), frame_state())?
	print_step("peer-settings", peer_settings)
	print_peer_settings("peer-settings", step_state(peer_settings))
	let settings_ack: Http2Step = receive(InputChunk(byte_chunk_from_hex("000000040100000000")?), step_state(peer_settings))?
	print_step("settings-ack", settings_ack)
