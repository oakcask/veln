fn print_step(label: String, step: Http2Step) -> () effects [stdio]
	let state: Http2DecodeState = step_state(step)
	stdio::print(label)
	stdio::print(" result ")
	stdio::print(step_kind(step))
	stdio::print(" offset ")
	stdio::print(int_to_string(step_offset(step)))
	stdio::print(" kind ")
	stdio::print(int_to_string(step_kind_value(step)))
	stdio::print(" stream ")
	stdio::print(int_to_string(step_stream_id(step)))
	stdio::print(" next ")
	stdio::print(int_to_string(state_next_offset(state)))
	stdio::print(" pending ")
	stdio::print(int_to_string(state_pending_count(state)))
	stdio::print(" continuation ")
	stdio::print(state_continuation_label(state))
	stdio::print(" accumulated ")
	stdio::print(int_to_string(state_continuation_count(state)))
	stdio::print(" completed ")
	stdio::println(int_to_string(step_completed_count(step)))
end

fn print_failure(label: String, step: Http2Step) -> () effects [stdio]
	let failure: Http2ProtocolFailure = step_failure(step)
	let state: Http2DecodeState = step_state(step)
	stdio::print(label)
	stdio::print(" id ")
	stdio::print(failure_id(failure))
	stdio::print(" offset ")
	stdio::print(int_to_string(failure_offset(failure)))
	stdio::print(" pending ")
	stdio::print(int_to_string(failure_pending_count(failure)))
	stdio::print(" actual_kind ")
	stdio::print(int_to_string(failure_actual_kind(failure)))
	stdio::print(" actual_stream ")
	stdio::print(int_to_string(failure_actual_stream(failure)))
	stdio::print(" expected_stream ")
	stdio::print(int_to_string(context_expected_stream(failure, state)))
	stdio::print(" expected_kind ")
	stdio::print(int_to_string(context_expected_kind(failure, state)))
	stdio::print(" started_kind ")
	stdio::print(int_to_string(context_started_kind(failure, state)))
	stdio::print(" started_offset ")
	stdio::print(int_to_string(context_started_offset(failure, state)))
	stdio::print(" continuation ")
	stdio::print(state_continuation_label(state))
	stdio::print(" accumulated ")
	stdio::print(int_to_string(state_continuation_count(state)))
	stdio::print(" observed_length ")
	stdio::print(int_to_string(failure_observed_length(failure)))
	stdio::print(" allowed_length ")
	stdio::print(int_to_string(failure_allowed_length(failure)))
	stdio::print(" receive_limit ")
	stdio::print(failure_receive_limit_provenance(failure))
	stdio::print(" active_state ")
	stdio::print(context_active_state(failure, state))
	stdio::print(" rule ")
	stdio::println(context_rule_provenance(failure, state))
end

