end

fn print_local_enable_push_settings_case() -> Result<(), String> effects [stdio]
	let sent: OutboundSettingsDecision = send_local_enable_push_setting(1, connection_state(frame_state()))?
	print_outbound_settings("local-enable-push-settings-sent", sent)
	let ignored_chunk: () = emit_encoded_header("http2-local-enable-push-settings", outbound_settings_chunk(sent), "000006040000000000000200000001")?
	print_outstanding_settings("local-enable-push-settings-sent", outbound_settings_connection(sent))
	let ack: Http2ConnectionStep = receive_connection(InputChunk(byte_chunk_from_hex("000000040100000000")?), outbound_settings_connection(sent))?
	print_step("local-enable-push-settings-ack", connection_step_decode_step(ack))
	print_outstanding_settings("local-enable-push-settings-ack", connection_step_state(ack))
	let rejected: OutboundSettingsDecision = send_local_enable_push_setting(2, connection_state(frame_state()))?
	print_outbound_settings("local-enable-push-settings-range", rejected)
	let ignored_rejected_chunk: () = print_empty_output_chunks("http2-local-enable-push-settings-range")?
	print_settings_failure("local-enable-push-settings-range", Failed(frame_state(), outbound_settings_failure(rejected)))
	Ok(())
end

