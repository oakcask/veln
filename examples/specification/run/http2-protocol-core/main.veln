	let encoded_settings_header: Result<ByteChunk, EncodeError> = encode_frame_header({length: 0, kind: 4, flags: 0, stream_id: 0})
	let ignored_settings_header: () = print_encoded_header("http2-settings-header", encoded_settings_header, "000000040000000000")?
	let encoded_data_header: Result<ByteChunk, EncodeError> = encode_frame_header({length: 5, kind: 0, flags: 1, stream_id: 1})
	let ignored_data_header: () = print_encoded_header("http2-data-header", encoded_data_header, "000005000100000001")?
	let encoded_max_stream_header: Result<ByteChunk, EncodeError> = encode_frame_header({length: 0, kind: 8, flags: 0, stream_id: 2147483647})
	let ignored_max_stream_header: () = print_encoded_header("http2-max-stream-header", encoded_max_stream_header, "00000008007fffffff")?
	let invalid_stream_header: Result<ByteChunk, EncodeError> = encode_frame_header({length: 0, kind: 0, flags: 0, stream_id: 2147483648})
	print_encode_error("http2-stream-id-range", invalid_stream_header)
	Ok(())
