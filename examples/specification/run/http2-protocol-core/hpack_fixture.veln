pub fn transition_headers(transition: HpackDecodeTransition) -> HpackHeaderList
	match transition
		HpackDecodeTransition(headers, _) => headers
	end
end

pub fn transition_state(transition: HpackDecodeTransition) -> HpackFixtureState
	match transition
		HpackDecodeTransition(_, state) => state
	end
end

pub fn header_list_wire_size(headers: HpackHeaderList) -> Int
	match headers
		HpackHeaderList(_, _, wire_size) => wire_size
	end
end

pub fn header_list_first_name(headers: HpackHeaderList) -> String
	match headers
		HpackHeaderList(HpackHeader(name, _), _, _) => name
	end
end

pub fn header_list_first_value(headers: HpackHeaderList) -> String
	match headers
		HpackHeaderList(HpackHeader(_, value), _, _) => value
	end
end

pub fn header_list_is_table_size_update(headers: HpackHeaderList) -> Bool
	match headers
		HpackHeaderList(HpackHeader(":fixture", "table-size-update"), _, _) => true
		_ => false
	end
end

pub fn header_list_is_request(headers: HpackHeaderList) -> Bool
	match headers
		HpackHeaderList(HpackHeader(":method", _), HpackHeader(":request", "scheme,path"), _) => true
		HpackHeaderList(HpackHeader(":method", _), HpackHeader(":request", "scheme,path,host"), _) => true
		HpackHeaderList(HpackHeader(":method", _), HpackHeader(":request", "duplicate-method,scheme,path"), _) => true
		HpackHeaderList(HpackHeader("host", _), HpackHeader(":request", "method-after-regular,scheme,path"), _) => true
		HpackHeaderList(HpackHeader(":scheme", _), HpackHeader(":path", _), _) => true
		HpackHeaderList(HpackHeader(":status", _), HpackHeader(":request", "method,scheme,path"), _) => true
		HpackHeaderList(HpackHeader(":method", _), HpackHeader(":request", "scheme,path,Host"), _) => true
		HpackHeaderList(HpackHeader(":method", _), HpackHeader(":request", "scheme,path,bad header"), _) => true
		HpackHeaderList(HpackHeader(":method", _), HpackHeader(":request", "scheme,path,connection"), _) => true
		HpackHeaderList(HpackHeader(":method", _), HpackHeader(":request", "scheme,path,keep-alive"), _) => true
		HpackHeaderList(HpackHeader(":method", _), HpackHeader(":request", "scheme,path,proxy-connection"), _) => true
		HpackHeaderList(HpackHeader(":method", _), HpackHeader(":request", "scheme,path,transfer-encoding"), _) => true
		HpackHeaderList(HpackHeader(":method", _), HpackHeader(":request", "scheme,path,upgrade"), _) => true
		HpackHeaderList(HpackHeader(":method", _), HpackHeader(":request", "scheme,path,te:trailers"), _) => true
		HpackHeaderList(HpackHeader(":method", _), HpackHeader(":request", "scheme,path,te:gzip"), _) => true
		_ => false
	end
end

pub fn header_list_is_response(headers: HpackHeaderList) -> Bool
	match headers
		HpackHeaderList(HpackHeader(":status", _), HpackHeader(":fixture", "static-indexed"), _) => true
		HpackHeaderList(HpackHeader(":status", _), HpackHeader(":fixture", "literal-without-indexing"), _) => true
		HpackHeaderList(HpackHeader(":status", _), HpackHeader(":fixture", "literal-with-indexing"), _) => true
		HpackHeaderList(HpackHeader(":status", _), HpackHeader(":response", "ok"), _) => true
		HpackHeaderList(HpackHeader(":status", _), HpackHeader(":response", "ok,server"), _) => true
		HpackHeaderList(HpackHeader(":status", _), HpackHeader(":response-error", "ok,Server"), _) => true
		HpackHeaderList(HpackHeader(":status", _), HpackHeader(":response-error", "ok,bad header"), _) => true
		HpackHeaderList(HpackHeader(":status", _), HpackHeader(":response", "ok,te:trailers"), _) => true
		HpackHeaderList(HpackHeader(":status", _), HpackHeader(":response", "ok,te:gzip"), _) => true
		HpackHeaderList(HpackHeader("server", _), HpackHeader(":response", "missing-status"), _) => true
		HpackHeaderList(HpackHeader(":status", _), HpackHeader(":response", "duplicate-status"), _) => true
		HpackHeaderList(HpackHeader(":method", _), HpackHeader(":response", "status"), _) => true
		HpackHeaderList(HpackHeader(":authority", _), HpackHeader(":response", "status"), _) => true
		HpackHeaderList(HpackHeader("server", _), HpackHeader(":response", "status-after-regular"), _) => true
		_ => false
	end
end

pub fn header_list_has_authority(headers: HpackHeaderList) -> Bool
	match headers
		HpackHeaderList(HpackHeader(":authority", _), _, _) => true
		_ => false
	end
end

pub fn header_list_has_method(headers: HpackHeaderList) -> Bool
	match headers
		HpackHeaderList(HpackHeader(":method", _), _, _) => true
		HpackHeaderList(_, HpackHeader(":request", "method,scheme,path"), _) => true
		HpackHeaderList(_, HpackHeader(":request", "method-after-regular,scheme,path"), _) => true
		HpackHeaderList(_, HpackHeader(":request", "scheme,path,connection"), _) => true
		HpackHeaderList(_, HpackHeader(":request", "scheme,path,keep-alive"), _) => true
		HpackHeaderList(_, HpackHeader(":request", "scheme,path,proxy-connection"), _) => true
		HpackHeaderList(_, HpackHeader(":request", "scheme,path,transfer-encoding"), _) => true
		HpackHeaderList(_, HpackHeader(":request", "scheme,path,upgrade"), _) => true
		HpackHeaderList(_, HpackHeader(":request", "scheme,path,te:trailers"), _) => true
		HpackHeaderList(_, HpackHeader(":request", "scheme,path,te:gzip"), _) => true
		_ => false
	end
end

pub fn header_list_has_scheme(headers: HpackHeaderList) -> Bool
	match headers
		HpackHeaderList(HpackHeader(":scheme", _), _, _) => true
		HpackHeaderList(_, HpackHeader(":request", "scheme,path"), _) => true
		HpackHeaderList(_, HpackHeader(":request", "scheme,path,host"), _) => true
		HpackHeaderList(_, HpackHeader(":request", "duplicate-method,scheme,path"), _) => true
		HpackHeaderList(_, HpackHeader(":request", "method-after-regular,scheme,path"), _) => true
		HpackHeaderList(_, HpackHeader(":request", "method,scheme,path"), _) => true
		HpackHeaderList(_, HpackHeader(":request", "scheme,path,Host"), _) => true
		HpackHeaderList(_, HpackHeader(":request", "scheme,path,bad header"), _) => true
		HpackHeaderList(_, HpackHeader(":request", "scheme,path,connection"), _) => true
		HpackHeaderList(_, HpackHeader(":request", "scheme,path,keep-alive"), _) => true
		HpackHeaderList(_, HpackHeader(":request", "scheme,path,proxy-connection"), _) => true
		HpackHeaderList(_, HpackHeader(":request", "scheme,path,transfer-encoding"), _) => true
		HpackHeaderList(_, HpackHeader(":request", "scheme,path,upgrade"), _) => true
		HpackHeaderList(_, HpackHeader(":request", "scheme,path,te:trailers"), _) => true
		HpackHeaderList(_, HpackHeader(":request", "scheme,path,te:gzip"), _) => true
		_ => false
	end
end

pub fn header_list_has_path(headers: HpackHeaderList) -> Bool
	match headers
		HpackHeaderList(HpackHeader(":path", _), _, _) => true
		HpackHeaderList(_, HpackHeader(":path", _), _) => true
		HpackHeaderList(_, HpackHeader(":request", "scheme,path"), _) => true
		HpackHeaderList(_, HpackHeader(":request", "scheme,path,host"), _) => true
		HpackHeaderList(_, HpackHeader(":request", "duplicate-method,scheme,path"), _) => true
		HpackHeaderList(_, HpackHeader(":request", "method-after-regular,scheme,path"), _) => true
		HpackHeaderList(_, HpackHeader(":request", "method,scheme,path"), _) => true
		HpackHeaderList(_, HpackHeader(":request", "scheme,path,Host"), _) => true
		HpackHeaderList(_, HpackHeader(":request", "scheme,path,bad header"), _) => true
		HpackHeaderList(_, HpackHeader(":request", "scheme,path,connection"), _) => true
		HpackHeaderList(_, HpackHeader(":request", "scheme,path,keep-alive"), _) => true
		HpackHeaderList(_, HpackHeader(":request", "scheme,path,proxy-connection"), _) => true
		HpackHeaderList(_, HpackHeader(":request", "scheme,path,transfer-encoding"), _) => true
		HpackHeaderList(_, HpackHeader(":request", "scheme,path,upgrade"), _) => true
		HpackHeaderList(_, HpackHeader(":request", "scheme,path,te:trailers"), _) => true
		HpackHeaderList(_, HpackHeader(":request", "scheme,path,te:gzip"), _) => true
		_ => false
	end
