pub fn header_list_has_uppercase_ordinary_header(headers: HpackHeaderList) -> Bool
	match headers
		HpackHeaderList(HpackHeader(":method", _), HpackHeader(":request", "scheme,path,Host"), _) => true
		HpackHeaderList(HpackHeader(":status", _), HpackHeader(":response-error", "ok,Server"), _) => true
		_ => false
	end
end

pub fn header_list_has_invalid_token_ordinary_header(headers: HpackHeaderList) -> Bool
	match headers
		HpackHeaderList(HpackHeader(":method", _), HpackHeader(":request", "scheme,path,bad header"), _) => true
		HpackHeaderList(HpackHeader(":status", _), HpackHeader(":response-error", "ok,bad header"), _) => true
		_ => false
	end
end

pub fn header_list_has_connection_specific_header(headers: HpackHeaderList) -> Bool
	match headers
		HpackHeaderList(HpackHeader(":method", _), HpackHeader(":request", "scheme,path,connection"), _) => true
		HpackHeaderList(HpackHeader(":method", _), HpackHeader(":request", "scheme,path,keep-alive"), _) => true
		HpackHeaderList(HpackHeader(":method", _), HpackHeader(":request", "scheme,path,proxy-connection"), _) => true
		HpackHeaderList(HpackHeader(":method", _), HpackHeader(":request", "scheme,path,transfer-encoding"), _) => true
		HpackHeaderList(HpackHeader(":method", _), HpackHeader(":request", "scheme,path,upgrade"), _) => true
		_ => false
	end
end

pub fn header_list_connection_specific_header_name(headers: HpackHeaderList) -> String
	match headers
		HpackHeaderList(HpackHeader(":method", _), HpackHeader(":request", "scheme,path,connection"), _) => "connection"
		HpackHeaderList(HpackHeader(":method", _), HpackHeader(":request", "scheme,path,keep-alive"), _) => "keep-alive"
		HpackHeaderList(HpackHeader(":method", _), HpackHeader(":request", "scheme,path,proxy-connection"), _) => "proxy-connection"
		HpackHeaderList(HpackHeader(":method", _), HpackHeader(":request", "scheme,path,transfer-encoding"), _) => "transfer-encoding"
		HpackHeaderList(HpackHeader(":method", _), HpackHeader(":request", "scheme,path,upgrade"), _) => "upgrade"
		_ => ""
	end
end

pub fn header_list_has_invalid_te_header_value(headers: HpackHeaderList) -> Bool
	match headers
		HpackHeaderList(HpackHeader(":method", _), HpackHeader(":request", "scheme,path,te:gzip"), _) => true
		HpackHeaderList(HpackHeader(":status", _), HpackHeader(":response", "ok,te:gzip"), _) => true
		_ => false
	end
end

pub fn header_list_invalid_ordinary_header_name(headers: HpackHeaderList) -> String
	match headers
		HpackHeaderList(HpackHeader(":method", _), HpackHeader(":request", "scheme,path,Host"), _) => "Host"
		HpackHeaderList(HpackHeader(":method", _), HpackHeader(":request", "scheme,path,bad header"), _) => "bad header"
		HpackHeaderList(HpackHeader(":status", _), HpackHeader(":response-error", "ok,Server"), _) => "Server"
		HpackHeaderList(HpackHeader(":status", _), HpackHeader(":response-error", "ok,bad header"), _) => "bad header"
		_ => ""
	end
end

pub fn header_list_has_status(headers: HpackHeaderList) -> Bool
	match headers
		HpackHeaderList(HpackHeader(":status", _), _, _) => true
		HpackHeaderList(_, HpackHeader(":status", _), _) => true
		HpackHeaderList(_, HpackHeader(":response", "ok"), _) => true
		HpackHeaderList(_, HpackHeader(":response", "ok,server"), _) => true
		HpackHeaderList(_, HpackHeader(":response", "ok,te:trailers"), _) => true
		HpackHeaderList(_, HpackHeader(":response", "ok,te:gzip"), _) => true
		HpackHeaderList(_, HpackHeader(":response-error", "ok,Server"), _) => true
		HpackHeaderList(_, HpackHeader(":response-error", "ok,bad header"), _) => true
		HpackHeaderList(_, HpackHeader(":response", "duplicate-status"), _) => true
		HpackHeaderList(_, HpackHeader(":response", "status"), _) => true
		HpackHeaderList(_, HpackHeader(":response", "status-after-regular"), _) => true
		_ => false
	end
end

pub fn header_list_has_duplicate_pseudo_header(headers: HpackHeaderList) -> Bool
	match headers
		HpackHeaderList(HpackHeader(":method", _), HpackHeader(":request", "duplicate-method,scheme,path"), _) => true
		HpackHeaderList(HpackHeader(":status", _), HpackHeader(":response", "duplicate-status"), _) => true
		_ => false
	end
end

pub fn header_list_has_duplicate_status(headers: HpackHeaderList) -> Bool
	match headers
		HpackHeaderList(HpackHeader(":status", _), HpackHeader(":response", "duplicate-status"), _) => true
		_ => false
	end
end

pub fn header_list_has_pseudo_header_after_regular(headers: HpackHeaderList) -> Bool
	match headers
		HpackHeaderList(HpackHeader("host", _), HpackHeader(":request", "method-after-regular,scheme,path"), _) => true
		HpackHeaderList(HpackHeader("server", _), HpackHeader(":response", "status-after-regular"), _) => true
		_ => false
	end
end

pub fn header_list_decoded_names(headers: HpackHeaderList) -> String
	match headers
		HpackHeaderList(HpackHeader(":method", _), HpackHeader(":request", "scheme,path"), _) => ":method,:scheme,:path"
		HpackHeaderList(HpackHeader(":method", _), HpackHeader(":request", "scheme,path,host"), _) => ":method,:scheme,:path,host"
		HpackHeaderList(HpackHeader(":method", _), HpackHeader(":request", "duplicate-method,scheme,path"), _) => ":method,:method,:scheme,:path"
		HpackHeaderList(HpackHeader("host", _), HpackHeader(":request", "method-after-regular,scheme,path"), _) => "host,:method,:scheme,:path"
		HpackHeaderList(HpackHeader(":scheme", _), HpackHeader(":path", _), _) => ":scheme,:path"
		HpackHeaderList(HpackHeader(":status", _), HpackHeader(":request", "method,scheme,path"), _) => ":status,:method,:scheme,:path"
		HpackHeaderList(HpackHeader(":method", _), HpackHeader(":request", "scheme,path,Host"), _) => ":method,:scheme,:path,Host"
		HpackHeaderList(HpackHeader(":method", _), HpackHeader(":request", "scheme,path,bad header"), _) => ":method,:scheme,:path,bad header"
		HpackHeaderList(HpackHeader(":method", _), HpackHeader(":request", "scheme,path,connection"), _) => ":method,:scheme,:path,connection"
		HpackHeaderList(HpackHeader(":method", _), HpackHeader(":request", "scheme,path,keep-alive"), _) => ":method,:scheme,:path,keep-alive"
		HpackHeaderList(HpackHeader(":method", _), HpackHeader(":request", "scheme,path,proxy-connection"), _) => ":method,:scheme,:path,proxy-connection"
		HpackHeaderList(HpackHeader(":method", _), HpackHeader(":request", "scheme,path,transfer-encoding"), _) => ":method,:scheme,:path,transfer-encoding"
		HpackHeaderList(HpackHeader(":method", _), HpackHeader(":request", "scheme,path,upgrade"), _) => ":method,:scheme,:path,upgrade"
		HpackHeaderList(HpackHeader(":method", _), HpackHeader(":request", "scheme,path,te:trailers"), _) => ":method,:scheme,:path,te"
		HpackHeaderList(HpackHeader(":method", _), HpackHeader(":request", "scheme,path,te:gzip"), _) => ":method,:scheme,:path,te"
		HpackHeaderList(HpackHeader(":status", _), HpackHeader(":response", "ok"), _) => ":status"
		HpackHeaderList(HpackHeader(":status", _), HpackHeader(":response", "ok,server"), _) => ":status,server"
		HpackHeaderList(HpackHeader(":status", _), HpackHeader(":response", "ok,te:trailers"), _) => ":status,te"
		HpackHeaderList(HpackHeader(":status", _), HpackHeader(":response", "ok,te:gzip"), _) => ":status,te"
		HpackHeaderList(HpackHeader(":status", _), HpackHeader(":response-error", "ok,Server"), _) => ":status,Server"
		HpackHeaderList(HpackHeader(":status", _), HpackHeader(":response-error", "ok,bad header"), _) => ":status,bad header"
		HpackHeaderList(HpackHeader("server", _), HpackHeader(":response", "missing-status"), _) => "server"
		HpackHeaderList(HpackHeader(":status", _), HpackHeader(":response", "duplicate-status"), _) => ":status,:status"
		HpackHeaderList(HpackHeader(":method", _), HpackHeader(":response", "status"), _) => ":method,:status"
		HpackHeaderList(HpackHeader(":authority", _), HpackHeader(":response", "status"), _) => ":authority,:status"
		HpackHeaderList(HpackHeader("server", _), HpackHeader(":response", "status-after-regular"), _) => "server,:status"
		HpackHeaderList(HpackHeader(first_name, _), _, _) => first_name
	end
end

pub fn state_decode_count(state: HpackFixtureState) -> Int
	match state
		HpackFixtureState(_, decode_count, _) => decode_count
	end
end

pub fn state_table_size(state: HpackFixtureState) -> Int
	match state
		HpackFixtureState(table_size, _, _) => table_size
	end
end

pub fn hpack_failure_offset(failure: HpackFixtureFailure) -> Int
	match failure
		UnsupportedHeaderBlock(offset, _, _, _, _, _) => offset
	end
end

pub fn hpack_failure_observed_size(failure: HpackFixtureFailure) -> Int
	match failure
		UnsupportedHeaderBlock(_, observed_size, _, _, _, _) => observed_size
	end
end

pub fn hpack_failure_observed_first_byte(failure: HpackFixtureFailure) -> Int
	match failure
		UnsupportedHeaderBlock(_, _, observed_first_byte, _, _, _) => observed_first_byte
	end
end

pub fn hpack_failure_expected_fixture(failure: HpackFixtureFailure) -> String
	match failure
		UnsupportedHeaderBlock(_, _, _, expected_fixture, _, _) => expected_fixture
	end
end

pub fn hpack_failure_codec_module(failure: HpackFixtureFailure) -> String
	match failure
		UnsupportedHeaderBlock(_, _, _, _, codec_module, _) => codec_module
	end
end

pub fn hpack_failure_preview(failure: HpackFixtureFailure) -> ByteChunk
	match failure
		UnsupportedHeaderBlock(_, _, _, _, _, preview) => preview
	end
end

pub fn project_failure(failure: HpackFixtureFailure) -> Result<(), String>
	let preview_chunk: ByteChunk = hpack_failure_preview(failure)
	let preview: ByteView = byte_view(preview_chunk, byte_offset(0)?, byte_chunk_count(preview_chunk))?
	hpack_fixture_unsupported_header_block(hpack_failure_offset(failure), hpack_failure_observed_size(failure), hpack_failure_observed_first_byte(failure), hpack_failure_expected_fixture(failure), hpack_failure_codec_module(failure), preview)
end
