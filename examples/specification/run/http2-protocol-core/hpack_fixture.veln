pub fn decode_header_block(block: ByteChunk, state: HpackFixtureState, offset: Int) -> Result<HpackDecodeTransition, HpackFixtureFailure>
	let observed_size: Int = byte_count_to_int(byte_chunk_count(block))
	let first_byte: Int = byte_at_or_missing(block, 0)
	match observed_size == 0
		true => decoded("empty", 0, state)
		false => match first_byte
			62 => match observed_size == 1
				true => decoded_table_size_update(state, 30)
				false => unsupported(block, offset)
			end
			63 => match observed_size == 1
				true => decoded_table_size_update(state, 31)
				false => decode_saturated_table_size_update(block, observed_size, state, offset)
			end
			17 => match observed_size == 8
				true => decoded("header-list-accepted", 8, state)
				false => match observed_size == 14
					true => decoded("header-list-too-large", 14, state)
					false => unsupported(block, offset)
				end
			end
			48 => match observed_size == 3
				true => decoded_request_headers(state)
				false => unsupported(block, offset)
			end
			49 => match observed_size == 2
				true => decoded_request_headers_missing_method(state)
				false => unsupported(block, offset)
			end
			50 => match observed_size == 4
				true => decoded_request_headers_with_status(state)
				false => unsupported(block, offset)
			end
			51 => match observed_size == 4
				true => decoded_request_headers_duplicate_method(state)
				false => unsupported(block, offset)
			end
			52 => match observed_size == 4
				true => decoded_request_headers_method_after_regular(state)
				false => unsupported(block, offset)
			end
			1 => decode_literal_without_indexing_header_block(first_byte, observed_size, state, block, offset)
			2 => decode_literal_without_indexing_header_block(first_byte, observed_size, state, block, offset)
			4 => decode_literal_without_indexing_header_block(first_byte, observed_size, state, block, offset)
			6 => decode_literal_without_indexing_header_block(first_byte, observed_size, state, block, offset)
			8 => decode_literal_without_indexing_header_block(first_byte, observed_size, state, block, offset)
			65 => decode_literal_with_indexing_header_block(first_byte, observed_size, state, block, offset)
			66 => decode_literal_with_indexing_header_block(first_byte, observed_size, state, block, offset)
			68 => decode_literal_with_indexing_header_block(first_byte, observed_size, state, block, offset)
			70 => decode_literal_with_indexing_header_block(first_byte, observed_size, state, block, offset)
			72 => decode_literal_with_indexing_header_block(first_byte, observed_size, state, block, offset)
			190 => match observed_size == 1
				true => decoded_dynamic_indexed_newest_header(state, block, offset)
				false => unsupported(block, offset)
			end
			191 => match observed_size == 1
				true => decoded_dynamic_indexed_older_header(state, block, offset)
				false => unsupported(block, offset)
			end
			16 => match observed_size == 3
				true => decoded("single-headers", 8, state)
				false => unsupported(block, offset)
			end
			170 => match observed_size == 9
				true => decoded("continuation", 9, state)
				false => decode_static_indexed_header_block(first_byte, observed_size, state, block, offset)
			end
			_ => decode_static_indexed_header_block(first_byte, observed_size, state, block, offset)
		end
	end
end

pub fn transition_headers(transition: HpackDecodeTransition) -> HpackHeaderList
	match transition
		HpackDecodeTransition(headers, _) => headers
	end
end

pub fn transition_state(transition: HpackDecodeTransition) -> HpackFixtureState
	match transition
		HpackDecodeTransition(_, state) => state
	end
end

pub fn header_list_wire_size(headers: HpackHeaderList) -> Int
	match headers
		HpackHeaderList(_, _, wire_size) => wire_size
	end
end

pub fn header_list_first_name(headers: HpackHeaderList) -> String
	match headers
		HpackHeaderList(HpackHeader(name, _), _, _) => name
	end
end

pub fn header_list_first_value(headers: HpackHeaderList) -> String
	match headers
		HpackHeaderList(HpackHeader(_, value), _, _) => value
	end
end

pub fn header_list_is_request(headers: HpackHeaderList) -> Bool
	match headers
		HpackHeaderList(HpackHeader(":method", _), HpackHeader(":request", "scheme,path"), _) => true
		HpackHeaderList(HpackHeader(":method", _), HpackHeader(":request", "duplicate-method,scheme,path"), _) => true
		HpackHeaderList(HpackHeader("host", _), HpackHeader(":request", "method-after-regular,scheme,path"), _) => true
		HpackHeaderList(HpackHeader(":scheme", _), HpackHeader(":path", _), _) => true
		HpackHeaderList(HpackHeader(":status", _), HpackHeader(":request", "method,scheme,path"), _) => true
		_ => false
	end
end

pub fn header_list_has_method(headers: HpackHeaderList) -> Bool
	match headers
		HpackHeaderList(HpackHeader(":method", _), _, _) => true
		HpackHeaderList(_, HpackHeader(":request", "method,scheme,path"), _) => true
		HpackHeaderList(_, HpackHeader(":request", "method-after-regular,scheme,path"), _) => true
		_ => false
	end
end

pub fn header_list_has_scheme(headers: HpackHeaderList) -> Bool
	match headers
		HpackHeaderList(HpackHeader(":scheme", _), _, _) => true
		HpackHeaderList(_, HpackHeader(":request", "scheme,path"), _) => true
		HpackHeaderList(_, HpackHeader(":request", "duplicate-method,scheme,path"), _) => true
		HpackHeaderList(_, HpackHeader(":request", "method-after-regular,scheme,path"), _) => true
		HpackHeaderList(_, HpackHeader(":request", "method,scheme,path"), _) => true
		_ => false
	end
end

pub fn header_list_has_path(headers: HpackHeaderList) -> Bool
	match headers
		HpackHeaderList(HpackHeader(":path", _), _, _) => true
		HpackHeaderList(_, HpackHeader(":path", _), _) => true
		HpackHeaderList(_, HpackHeader(":request", "scheme,path"), _) => true
		HpackHeaderList(_, HpackHeader(":request", "duplicate-method,scheme,path"), _) => true
		HpackHeaderList(_, HpackHeader(":request", "method-after-regular,scheme,path"), _) => true
		HpackHeaderList(_, HpackHeader(":request", "method,scheme,path"), _) => true
		_ => false
	end
end

pub fn header_list_has_status(headers: HpackHeaderList) -> Bool
	match headers
		HpackHeaderList(HpackHeader(":status", _), _, _) => true
		HpackHeaderList(_, HpackHeader(":status", _), _) => true
		_ => false
	end
end

pub fn header_list_has_duplicate_pseudo_header(headers: HpackHeaderList) -> Bool
	match headers
		HpackHeaderList(HpackHeader(":method", _), HpackHeader(":request", "duplicate-method,scheme,path"), _) => true
		_ => false
	end
end

pub fn header_list_has_pseudo_header_after_regular(headers: HpackHeaderList) -> Bool
	match headers
		HpackHeaderList(HpackHeader("host", _), HpackHeader(":request", "method-after-regular,scheme,path"), _) => true
		_ => false
	end
end

pub fn header_list_decoded_names(headers: HpackHeaderList) -> String
	match headers
		HpackHeaderList(HpackHeader(":method", _), HpackHeader(":request", "scheme,path"), _) => ":method,:scheme,:path"
		HpackHeaderList(HpackHeader(":method", _), HpackHeader(":request", "duplicate-method,scheme,path"), _) => ":method,:method,:scheme,:path"
		HpackHeaderList(HpackHeader("host", _), HpackHeader(":request", "method-after-regular,scheme,path"), _) => "host,:method,:scheme,:path"
		HpackHeaderList(HpackHeader(":scheme", _), HpackHeader(":path", _), _) => ":scheme,:path"
		HpackHeaderList(HpackHeader(":status", _), HpackHeader(":request", "method,scheme,path"), _) => ":status,:method,:scheme,:path"
		HpackHeaderList(HpackHeader(first_name, _), _, _) => first_name
	end
end

pub fn state_decode_count(state: HpackFixtureState) -> Int
	match state
		HpackFixtureState(_, decode_count, _) => decode_count
	end
end

pub fn state_table_size(state: HpackFixtureState) -> Int
	match state
		HpackFixtureState(table_size, _, _) => table_size
	end
end

pub fn hpack_failure_offset(failure: HpackFixtureFailure) -> Int
	match failure
		UnsupportedHeaderBlock(offset, _, _, _, _, _) => offset
	end
end

pub fn hpack_failure_observed_size(failure: HpackFixtureFailure) -> Int
	match failure
		UnsupportedHeaderBlock(_, observed_size, _, _, _, _) => observed_size
	end
end

pub fn hpack_failure_observed_first_byte(failure: HpackFixtureFailure) -> Int
	match failure
		UnsupportedHeaderBlock(_, _, observed_first_byte, _, _, _) => observed_first_byte
	end
end

pub fn hpack_failure_expected_fixture(failure: HpackFixtureFailure) -> String
	match failure
		UnsupportedHeaderBlock(_, _, _, expected_fixture, _, _) => expected_fixture
	end
end

pub fn hpack_failure_codec_module(failure: HpackFixtureFailure) -> String
	match failure
		UnsupportedHeaderBlock(_, _, _, _, codec_module, _) => codec_module
	end
end

pub fn hpack_failure_preview(failure: HpackFixtureFailure) -> ByteChunk
	match failure
		UnsupportedHeaderBlock(_, _, _, _, _, preview) => preview
	end
end

pub fn project_failure(failure: HpackFixtureFailure) -> Result<(), String>
	let preview_chunk: ByteChunk = hpack_failure_preview(failure)
	let preview: ByteView = byte_view(preview_chunk, byte_offset(0)?, byte_chunk_count(preview_chunk))?
	hpack_fixture_unsupported_header_block(hpack_failure_offset(failure), hpack_failure_observed_size(failure), hpack_failure_observed_first_byte(failure), hpack_failure_expected_fixture(failure), hpack_failure_codec_module(failure), preview)
end
