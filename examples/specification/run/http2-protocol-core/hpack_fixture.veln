fn hpack_huffman_padding_valid(code: Int, length: Int) -> Bool
	length == 0 or (length <= 7 and code == pow2(length) - 1)
end

fn hpack_huffman_decoded_wire_size(value: String, decoded_size: Int) -> Int
	match value
		"" => 2
		"www.example.com" => 13
		_ => decoded_size
	end
end

fn append_hpack_huffman_symbol(decoded: ByteChunk, symbol: Int, block: ByteChunk, offset: Int) -> Result<ByteChunk, HpackFixtureFailure>
	match symbol
		256 => huffman_eos_symbol(block, offset)
		_ => match byte_write_u8_be(symbol)
			Ok(symbol_chunk) => Ok(byte_append(decoded, symbol_chunk))
			Err(_) => unsupported_byte_chunk(block, offset)
		end
	end
end

fn decode_hpack_huffman_done(decoded: ByteChunk, code: Int, length: Int, block: ByteChunk, offset: Int) -> Result<HpackStringLiteral, HpackFixtureFailure>
	match hpack_huffman_padding_valid(code, length)
		false => malformed_huffman_padding_string_literal(block, offset)
		true => match hpack_huffman_decoded_string(decoded, block, offset)
			Ok(value) => Ok(HpackStringLiteral(value, hpack_huffman_decoded_wire_size(value, byte_count_to_int(byte_chunk_count(decoded)))))
			Err(_) => unsupported_string_literal(block, offset)
		end
	end
end

fn hpack_huffman_decoded_string(decoded: ByteChunk, block: ByteChunk, offset: Int) -> Result<String, HpackFixtureFailure>
	match byte_chunk_to_visible_ascii_string(decoded)
		Ok(value) => Ok(value)
		Err(_) => hpack_huffman_fixture_non_visible_string(decoded, block, offset)
	end
end

fn hpack_huffman_fixture_non_visible_string(decoded: ByteChunk, block: ByteChunk, offset: Int) -> Result<String, HpackFixtureFailure>
	match byte_count_to_int(byte_chunk_count(decoded)) == 1 and byte_at_or_missing(decoded, 0) == 10
		true => Ok("\n")
		false => match byte_count_to_int(byte_chunk_count(decoded)) == 1
			true => match hpack_fixture_huffman_byte_label(byte_at_or_missing(decoded, 0))
				Some(label) => Ok(label)
				None => hpack_huffman_unsupported_non_visible_string(block, offset)
			end
			false => match hpack_decoded_huffman_bytes_label(decoded)
				Some(label) => Ok(label)
				None => hpack_huffman_unsupported_non_visible_string(block, offset)
			end
		end
	end
end

fn hpack_huffman_unsupported_non_visible_string(block: ByteChunk, offset: Int) -> Result<String, HpackFixtureFailure>
	match huffman_non_visible_value(block, offset)
		Ok(_) => Ok("")
		Err(failure) => Err(failure)
	end
end

fn hpack_decoded_huffman_bytes_label(decoded: ByteChunk) -> Option<String>
	Some(hpack_fixture_huffman_bytes_label(decoded))
end

