pub fn decode_header_block(block: ByteChunk, state: HpackFixtureState, offset: Int) -> Result<HpackDecodeTransition, HpackFixtureFailure>
	let observed_size: Int = byte_count_to_int(byte_chunk_count(block))
	let first_byte: Int = byte_at_or_missing(block, 0)
	match observed_size
		0 => decoded("empty", 0, state)
		_ => match first_byte
			62 => match observed_size == 1
				true => decoded_table_size_update(state, 30)
				false => unsupported(block, offset)
			end
			63 => match observed_size == 1
				true => decoded_table_size_update(state, 31)
				false => decode_saturated_table_size_update(block, observed_size, state, offset)
			end
			17 => match observed_size == 8 and byte_at_or_missing(block, 1) == 2
				true => decoded("header-list-accepted", 8, state)
				false => match observed_size == 14 and byte_at_or_missing(block, 1) == 2
					true => decoded("header-list-too-large", 14, state)
					false => decode_literal_never_indexed_header_block(first_byte, observed_size, state, block, offset)
				end
			end
			48 => match observed_size == 3
				true => decoded_request_headers(state)
				false => unsupported(block, offset)
			end
			59 => match observed_size == 3
				true => decoded_request_headers_with_regular_header(state)
				false => unsupported(block, offset)
			end
			91 => match observed_size == 4
				true => decoded_request_headers_with_scheme_value("http", state)
				false => unsupported(block, offset)
			end
			92 => match observed_size == 4
				true => decoded_request_headers_with_scheme_value("https", state)
				false => unsupported(block, offset)
			end
			94 => match observed_size == 4
				true => decoded_request_headers_with_scheme_value("ftp", state)
