				false => unsupported(block, offset)
			end
			71 => match observed_size == 4
				true => decoded_response_headers_bad_token_regular(state)
				false => unsupported(block, offset)
			end
			77 => match observed_size == 4
				true => decoded_response_headers_with_te_trailers_header(state)
				false => unsupported(block, offset)
			end
			78 => match observed_size == 4
				true => decoded_response_headers_with_bad_te_header(state)
				false => unsupported(block, offset)
			end
			87 => match observed_size == 4
				true => decoded_response_headers_with_content_length("ok,content-length:5", state)
				false => unsupported(block, offset)
			end
			88 => match observed_size == 4
				true => decoded_response_headers_with_content_length("ok,content-length:5,content-length:5", state)
				false => unsupported(block, offset)
			end
			89 => match observed_size == 4
				true => decoded_response_headers_with_content_length("ok,content-length:5,content-length:7", state)
				false => unsupported(block, offset)
			end
			90 => match observed_size == 4
				true => decoded_response_headers_with_content_length("ok,content-length:", state)
				false => unsupported(block, offset)
			end
			91 => match observed_size == 4
				true => decoded_response_headers_with_content_length("ok,content-length:abc", state)
				false => unsupported(block, offset)
			end
			92 => match observed_size == 4
				true => decoded_response_headers_with_content_length("ok,content-length:+5", state)
				false => unsupported(block, offset)
			end
			93 => match observed_size == 4
				true => decoded_response_headers_with_content_length("ok,content-length: 5", state)
				false => unsupported(block, offset)
			end
			94 => match observed_size == 4
				true => decoded_response_headers_with_content_length("ok,content-length:-5", state)
				false => unsupported(block, offset)
			end
			102 => match observed_size == 4
				true => decoded_response_headers_with_status("", "empty", state)
				false => unsupported(block, offset)
			end
			115 => match observed_size == 4
				true => decoded_response_headers_with_status("20", "short", state)
				false => unsupported(block, offset)
			end
			116 => match observed_size == 4
				true => decoded_response_headers_with_status("2000", "long", state)
				false => unsupported(block, offset)
			end
			117 => match observed_size == 4
				true => decoded_response_headers_with_status("20a", "non-decimal", state)
				false => unsupported(block, offset)
			end
			103 => match observed_size == 4
				true => decoded_request_headers_with_production_content_length("5", state)
				false => unsupported(block, offset)
			end
			104 => match observed_size == 4
				true => decoded_request_headers_with_production_content_length("5,5", state)
				false => unsupported(block, offset)
			end
			105 => match observed_size == 4
				true => decoded_request_headers_with_production_content_length("5,7", state)
				false => unsupported(block, offset)
			end
			106 => match observed_size == 4
				true => decoded_request_headers_with_production_content_length("", state)
				false => unsupported(block, offset)
			end
			107 => match observed_size == 4
				true => decoded_request_headers_with_production_content_length("abc", state)
				false => unsupported(block, offset)
			end
			108 => match observed_size == 4
				true => decoded_request_headers_with_production_content_length("+5", state)
				false => unsupported(block, offset)
			end
			109 => match observed_size == 4
				true => decoded_request_headers_with_production_content_length(" 5", state)
				false => unsupported(block, offset)
			end
			110 => match observed_size == 4
				true => decoded_request_headers_with_production_content_length("-5", state)
				false => unsupported(block, offset)
			end
			33 => match observed_size == 4
				true => decoded_trailer_headers_with_regular_header(state)
				false => unsupported(block, offset)
			end
			34 => match observed_size == 4
				true => decoded_trailer_headers_uppercase_regular(state)
				false => unsupported(block, offset)
			end
			35 => match observed_size == 4
				true => decoded_trailer_headers_bad_token_regular(state)
				false => unsupported(block, offset)
			end
			36 => match observed_size == 4
				true => decoded_trailer_headers_with_connection_header(state)
				false => unsupported(block, offset)
			end
			37 => match observed_size == 4
				true => decoded_trailer_headers_with_bad_te_header(state)
				false => unsupported(block, offset)
			end
			1 => decode_literal_without_indexing_header_block(first_byte, observed_size, state, block, offset)
			2 => decode_literal_without_indexing_header_block(first_byte, observed_size, state, block, offset)
			4 => decode_literal_without_indexing_header_block(first_byte, observed_size, state, block, offset)
			6 => decode_literal_without_indexing_header_block(first_byte, observed_size, state, block, offset)
			8 => decode_literal_without_indexing_header_block(first_byte, observed_size, state, block, offset)
			15 => decode_literal_without_indexing_header_block(first_byte, observed_size, state, block, offset)
			18 => decode_literal_never_indexed_header_block(first_byte, observed_size, state, block, offset)
			20 => decode_literal_never_indexed_header_block(first_byte, observed_size, state, block, offset)
			22 => decode_literal_never_indexed_header_block(first_byte, observed_size, state, block, offset)
			24 => decode_literal_never_indexed_header_block(first_byte, observed_size, state, block, offset)
			31 => decode_literal_never_indexed_header_block(first_byte, observed_size, state, block, offset)
			65 => decode_literal_with_indexing_header_block(first_byte, observed_size, state, block, offset)
			66 => decode_literal_with_indexing_header_block(first_byte, observed_size, state, block, offset)
			68 => decode_literal_with_indexing_header_block(first_byte, observed_size, state, block, offset)
			70 => decode_literal_with_indexing_header_block(first_byte, observed_size, state, block, offset)
			72 => decode_literal_with_indexing_header_block(first_byte, observed_size, state, block, offset)
			126 => decode_literal_with_indexing_header_block(first_byte, observed_size, state, block, offset)
			127 => decode_literal_with_indexing_header_block(first_byte, observed_size, state, block, offset)
			16 => match observed_size == 3
				true => decoded("single-headers", 8, state)
				false => decode_raw_name_literal_header_block(LiteralNeverIndexed, observed_size, state, block, offset)
			end
			170 => match observed_size == 9
				true => decoded("continuation", 9, state)
				false => decode_static_indexed_header_block(first_byte, observed_size, state, block, offset)
			end
			_ => match first_byte >= 190
				true => decode_dynamic_indexed_header_block(first_byte, observed_size, state, block, offset)
				false => match first_byte == 0
					true => decode_raw_name_literal_header_block(LiteralWithoutIndexing, observed_size, state, block, offset)
					false => match first_byte > 0 and first_byte < 16
						true => decode_literal_without_indexing_header_block(first_byte, observed_size, state, block, offset)
						false => match first_byte > 16 and first_byte < 32
							true => decode_literal_never_indexed_header_block(first_byte, observed_size, state, block, offset)
							false => match first_byte >= 65 and first_byte <= 127
								true => decode_literal_with_indexing_header_block(first_byte, observed_size, state, block, offset)
								false => decode_static_indexed_header_block(first_byte, observed_size, state, block, offset)
							end
						end
					end
				end
			end
		end
	end
end

pub fn transition_headers(transition: HpackDecodeTransition) -> HpackHeaderList
	match transition
		HpackDecodeTransition(headers, _) => headers
	end
end

pub fn transition_state(transition: HpackDecodeTransition) -> HpackFixtureState
	match transition
		HpackDecodeTransition(_, state) => state
	end
end

pub fn header_list_wire_size(headers: HpackHeaderList) -> Int
	match headers
		HpackHeaderList(_, _, wire_size) => wire_size
	end
end

pub fn header_list_first_name(headers: HpackHeaderList) -> String
	match headers
		HpackHeaderList(HpackHeader(name, _), _, _) => name
	end
end

pub fn header_list_first_value(headers: HpackHeaderList) -> String
	match headers
		HpackHeaderList(HpackHeader(_, value), _, _) => value
	end
end

pub fn header_list_second_name(headers: HpackHeaderList) -> String
	match headers
		HpackHeaderList(_, HpackHeader(name, _), _) => name
	end
end

pub fn header_list_second_value(headers: HpackHeaderList) -> String
	match headers
		HpackHeaderList(_, HpackHeader(_, value), _) => value
	end
end

pub fn header_list_is_table_size_update(headers: HpackHeaderList) -> Bool
	match headers
		HpackHeaderList(HpackHeader(":fixture", "table-size-update"), _, _) => true
		_ => false
	end
end

fn request_content_length_label(value: String) -> Bool
	match value
		"scheme,path,content-length:5" => true
		"scheme,path,content-length:5,content-length:5" => true
		"scheme,path,content-length:5,content-length:7" => true
		"scheme,path,content-length:" => true
		"scheme,path,content-length:abc" => true
		"scheme,path,content-length:+5" => true
		"scheme,path,content-length: 5" => true
		"scheme,path,content-length:-5" => true
		_ => false
	end
end

fn response_content_length_label(value: String) -> Bool
	match value
		"ok,content-length:5" => true
		"ok,content-length:5,content-length:5" => true
		"ok,content-length:5,content-length:7" => true
		"ok,content-length:" => true
		"ok,content-length:abc" => true
		"ok,content-length:+5" => true
		"ok,content-length: 5" => true
		"ok,content-length:-5" => true
		_ => false
	end
end

fn content_length_decimal_bytes(bytes: ByteChunk, index: Int, count: Int) -> Bool
	match index == count
		true => true
		false => match byte_at_or_missing(bytes, index) >= 48 and byte_at_or_missing(bytes, index) <= 57
			true => content_length_decimal_bytes(bytes, index + 1, count)
			false => false
		end
	end
end

fn content_length_value_is_decimal(value: String) -> Bool
	match byte_chunk_from_visible_ascii_string(value)
		Ok(bytes) => match byte_count_to_int(byte_chunk_count(bytes)) > 0
			true => content_length_decimal_bytes(bytes, 0, byte_count_to_int(byte_chunk_count(bytes)))
			false => false
		end
		Err(_) => false
	end
end

fn content_length_value_is_invalid(value: String) -> Bool
	match string_split_once(value, ",")
		Some(parts) => match content_length_value_is_decimal(parts.left)
			true => not content_length_value_is_decimal(parts.right)
			false => true
		end
		None => not content_length_value_is_decimal(value)
	end
end

pub fn header_list_has_invalid_status_value(headers: HpackHeaderList) -> Bool
	match headers
		HpackHeaderList(HpackHeader(":status", value), _, _) => not response_status_value_is_valid(value)
		_ => false
	end
end

fn response_status_value_is_valid(value: String) -> Bool
	match byte_chunk_from_visible_ascii_string(value)
		Ok(bytes) => match byte_count_to_int(byte_chunk_count(bytes)) == 3
			true => content_length_decimal_bytes(bytes, 0, 3)
			false => false
		end
		Err(_) => false
	end
end

fn content_length_value_is_mismatched(value: String) -> Bool
	match string_split_once(value, ",")
		Some(parts) => match content_length_value_is_decimal(parts.left) and content_length_value_is_decimal(parts.right)
			true => parts.left != parts.right
			false => false
		end
		None => false
	end
end

fn content_length_single_accepted_value(value: String) -> Int
	match content_length_value_is_decimal(value)
		true => match string_parse_int(value)
			Ok(parsed) => parsed
			Err(_) => -1
		end
		false => -1
	end
end

fn content_length_accepted_value(value: String) -> Int
	match string_split_once(value, ",")
		Some(parts) => match content_length_value_is_decimal(parts.left) and content_length_value_is_decimal(parts.right) and parts.left == parts.right
			true => content_length_single_accepted_value(parts.left)
			false => -1
		end
		None => content_length_single_accepted_value(value)
	end
end

fn request_content_length_header_value(headers: HpackHeaderList) -> Option<String>
	match headers
		HpackHeaderList(HpackHeader(":request", "method,scheme,path"), HpackHeader("content-length", value), _) => Some(value)
		_ => None
	end
end

fn production_request_content_length_decoded_names(value: String) -> String
	match string_split_once(value, ",")
		Some(_) => ":method,:scheme,:path,content-length,content-length"
		None => ":method,:scheme,:path,content-length"
	end
end

fn production_response_content_length_decoded_names(value: String) -> String
	match string_split_once(value, ",")
		Some(_) => ":status,content-length,content-length"
		None => ":status,content-length"
	end
end

pub fn header_list_is_request(headers: HpackHeaderList) -> Bool
	match headers
		HpackHeaderList(HpackHeader(":request", "method,scheme,path"), HpackHeader("content-length", _), _) => true
		HpackHeaderList(HpackHeader(":method", _), HpackHeader(":request", "scheme,path"), _) => true
		HpackHeaderList(HpackHeader(":authority", _), HpackHeader(":request", "method,scheme,path,authority"), _) => true
		HpackHeaderList(HpackHeader(":authority", _), HpackHeader(":request", "method,scheme,path,authority:invalid"), _) => true
		HpackHeaderList(HpackHeader(":method", _), HpackHeader(":request", "scheme,path,host"), _) => true
		HpackHeaderList(HpackHeader(":scheme", _), HpackHeader(":request", "method,path"), _) => true
		HpackHeaderList(HpackHeader(":method", _), HpackHeader(":request", "scheme,path:"), _) => true
		HpackHeaderList(HpackHeader(":method", _), HpackHeader(":request", "duplicate-method,scheme,path"), _) => true
		HpackHeaderList(HpackHeader("host", _), HpackHeader(":request", "method-after-regular,scheme,path"), _) => true
		HpackHeaderList(HpackHeader(":scheme", _), HpackHeader(":path", _), _) => true
		HpackHeaderList(HpackHeader(":status", _), HpackHeader(":request", "method,scheme,path"), _) => true
		HpackHeaderList(HpackHeader(":method", _), HpackHeader(":request", "scheme,path,Host"), _) => true
		HpackHeaderList(HpackHeader(":method", _), HpackHeader(":request", "scheme,path,bad header"), _) => true
		HpackHeaderList(HpackHeader(":method", _), HpackHeader(":request", "scheme,path,connection"), _) => true
		HpackHeaderList(HpackHeader(":method", _), HpackHeader(":request", "scheme,path,keep-alive"), _) => true
		HpackHeaderList(HpackHeader(":method", _), HpackHeader(":request", "scheme,path,proxy-connection"), _) => true
		HpackHeaderList(HpackHeader(":method", _), HpackHeader(":request", "scheme,path,transfer-encoding"), _) => true
		HpackHeaderList(HpackHeader(":method", _), HpackHeader(":request", "scheme,path,upgrade"), _) => true
		HpackHeaderList(HpackHeader(":method", _), HpackHeader(":request", "scheme,path,te:trailers"), _) => true
		HpackHeaderList(HpackHeader(":method", _), HpackHeader(":request", "scheme,path,te:gzip"), _) => true
		HpackHeaderList(HpackHeader(":method", _), HpackHeader(":request", value), _) => request_content_length_label(value)
		_ => false
	end
end

pub fn header_list_is_response(headers: HpackHeaderList) -> Bool
	match headers
		HpackHeaderList(HpackHeader(":status", _), HpackHeader("content-length", _), _) => true
		HpackHeaderList(HpackHeader(":status", _), HpackHeader("cache-control", _), _) => true
		HpackHeaderList(HpackHeader(":status", _), HpackHeader("content-type", _), _) => true
		HpackHeaderList(HpackHeader(":status", _), HpackHeader(":fixture", "static-indexed"), _) => true
		HpackHeaderList(HpackHeader(":status", _), HpackHeader(":fixture", "literal-without-indexing"), _) => true
		HpackHeaderList(HpackHeader(":status", _), HpackHeader(":fixture", "literal-with-indexing"), _) => true
		HpackHeaderList(HpackHeader(":status", _), HpackHeader(":response", "ok"), _) => true
		HpackHeaderList(HpackHeader(":status", _), HpackHeader(":response", "ok,server"), _) => true
		HpackHeaderList(HpackHeader(":status", _), HpackHeader(":response-error", "ok,Server"), _) => true
		HpackHeaderList(HpackHeader(":status", _), HpackHeader(":response-error", "ok,bad header"), _) => true
		HpackHeaderList(HpackHeader(":status", _), HpackHeader(":response", "ok,te:trailers"), _) => true
		HpackHeaderList(HpackHeader(":status", _), HpackHeader(":response", "ok,te:gzip"), _) => true
		HpackHeaderList(HpackHeader(":status", _), HpackHeader(":response", value), _) => response_content_length_label(value)
		HpackHeaderList(HpackHeader(":status", _), HpackHeader(":response-status", _), _) => true
		HpackHeaderList(HpackHeader("server", _), HpackHeader(":response", "missing-status"), _) => true
		HpackHeaderList(HpackHeader(":status", _), HpackHeader(":response", "duplicate-status"), _) => true
		HpackHeaderList(HpackHeader(":method", _), HpackHeader(":response", "status"), _) => true
		HpackHeaderList(HpackHeader(":authority", _), HpackHeader(":response", "status"), _) => true
		HpackHeaderList(HpackHeader("server", _), HpackHeader(":response", "status-after-regular"), _) => true
		_ => false
	end
end

pub fn header_list_is_trailer(headers: HpackHeaderList) -> Bool
	match headers
		HpackHeaderList(_, HpackHeader(":trailers", _), _) => true
		_ => false
	end
end

pub fn header_list_has_authority(headers: HpackHeaderList) -> Bool
	match headers
		HpackHeaderList(HpackHeader(":authority", _), _, _) => true
		_ => false
	end
end

pub fn header_list_has_method(headers: HpackHeaderList) -> Bool
	match headers
		HpackHeaderList(HpackHeader(":request", "method,scheme,path"), HpackHeader("content-length", _), _) => true
		HpackHeaderList(HpackHeader(":method", _), _, _) => true
		HpackHeaderList(HpackHeader(":authority", _), HpackHeader(":request", "method,scheme,path,authority"), _) => true
		HpackHeaderList(HpackHeader(":authority", _), HpackHeader(":request", "method,scheme,path,authority:invalid"), _) => true
		HpackHeaderList(_, HpackHeader(":request", "method,scheme,path"), _) => true
		HpackHeaderList(_, HpackHeader(":request", "method,path"), _) => true
		HpackHeaderList(_, HpackHeader(":request", "scheme,path:"), _) => true
		HpackHeaderList(_, HpackHeader(":request", "method-after-regular,scheme,path"), _) => true
		HpackHeaderList(_, HpackHeader(":request", "scheme,path,connection"), _) => true
		HpackHeaderList(_, HpackHeader(":request", "scheme,path,keep-alive"), _) => true
		HpackHeaderList(_, HpackHeader(":request", "scheme,path,proxy-connection"), _) => true
		HpackHeaderList(_, HpackHeader(":request", "scheme,path,transfer-encoding"), _) => true
		HpackHeaderList(_, HpackHeader(":request", "scheme,path,upgrade"), _) => true
		HpackHeaderList(_, HpackHeader(":request", "scheme,path,te:trailers"), _) => true
		HpackHeaderList(_, HpackHeader(":request", "scheme,path,te:gzip"), _) => true
		HpackHeaderList(_, HpackHeader(":request", value), _) => request_content_length_label(value)
		_ => false
	end
end

pub fn header_list_has_scheme(headers: HpackHeaderList) -> Bool
	match headers
		HpackHeaderList(HpackHeader(":request", "method,scheme,path"), HpackHeader("content-length", _), _) => true
		HpackHeaderList(HpackHeader(":scheme", _), _, _) => true
		HpackHeaderList(HpackHeader(":authority", _), HpackHeader(":request", "method,scheme,path,authority"), _) => true
		HpackHeaderList(HpackHeader(":authority", _), HpackHeader(":request", "method,scheme,path,authority:invalid"), _) => true
		HpackHeaderList(_, HpackHeader(":request", "scheme,path"), _) => true
		HpackHeaderList(_, HpackHeader(":request", "scheme,path,host"), _) => true
		HpackHeaderList(_, HpackHeader(":request", "scheme,path:"), _) => true
		HpackHeaderList(_, HpackHeader(":request", "duplicate-method,scheme,path"), _) => true
		HpackHeaderList(_, HpackHeader(":request", "method-after-regular,scheme,path"), _) => true
		HpackHeaderList(_, HpackHeader(":request", "method,scheme,path"), _) => true
		HpackHeaderList(_, HpackHeader(":request", "scheme,path,Host"), _) => true
		HpackHeaderList(_, HpackHeader(":request", "scheme,path,bad header"), _) => true
		HpackHeaderList(_, HpackHeader(":request", "scheme,path,connection"), _) => true
		HpackHeaderList(_, HpackHeader(":request", "scheme,path,keep-alive"), _) => true
		HpackHeaderList(_, HpackHeader(":request", "scheme,path,proxy-connection"), _) => true
		HpackHeaderList(_, HpackHeader(":request", "scheme,path,transfer-encoding"), _) => true
		HpackHeaderList(_, HpackHeader(":request", "scheme,path,upgrade"), _) => true
		HpackHeaderList(_, HpackHeader(":request", "scheme,path,te:trailers"), _) => true
		HpackHeaderList(_, HpackHeader(":request", "scheme,path,te:gzip"), _) => true
		HpackHeaderList(_, HpackHeader(":request", value), _) => request_content_length_label(value)
		_ => false
	end
end

pub fn header_list_has_path(headers: HpackHeaderList) -> Bool
	match headers
		HpackHeaderList(HpackHeader(":request", "method,scheme,path"), HpackHeader("content-length", _), _) => true
		HpackHeaderList(HpackHeader(":path", _), _, _) => true
		HpackHeaderList(_, HpackHeader(":path", _), _) => true
		HpackHeaderList(HpackHeader(":authority", _), HpackHeader(":request", "method,scheme,path,authority"), _) => true
		HpackHeaderList(HpackHeader(":authority", _), HpackHeader(":request", "method,scheme,path,authority:invalid"), _) => true
		HpackHeaderList(_, HpackHeader(":request", "method,path"), _) => true
		HpackHeaderList(_, HpackHeader(":request", "scheme,path"), _) => true
		HpackHeaderList(_, HpackHeader(":request", "scheme,path,host"), _) => true
		HpackHeaderList(_, HpackHeader(":request", "scheme,path:"), _) => true
		HpackHeaderList(_, HpackHeader(":request", "duplicate-method,scheme,path"), _) => true
		HpackHeaderList(_, HpackHeader(":request", "method-after-regular,scheme,path"), _) => true
		HpackHeaderList(_, HpackHeader(":request", "method,scheme,path"), _) => true
		HpackHeaderList(_, HpackHeader(":request", "scheme,path,Host"), _) => true
		HpackHeaderList(_, HpackHeader(":request", "scheme,path,bad header"), _) => true
		HpackHeaderList(_, HpackHeader(":request", "scheme,path,connection"), _) => true
		HpackHeaderList(_, HpackHeader(":request", "scheme,path,keep-alive"), _) => true
		HpackHeaderList(_, HpackHeader(":request", "scheme,path,proxy-connection"), _) => true
		HpackHeaderList(_, HpackHeader(":request", "scheme,path,transfer-encoding"), _) => true
		HpackHeaderList(_, HpackHeader(":request", "scheme,path,upgrade"), _) => true
		HpackHeaderList(_, HpackHeader(":request", "scheme,path,te:trailers"), _) => true
		HpackHeaderList(_, HpackHeader(":request", "scheme,path,te:gzip"), _) => true
		HpackHeaderList(_, HpackHeader(":request", value), _) => request_content_length_label(value)
		_ => false
	end
end

pub fn header_list_has_uppercase_ordinary_header(headers: HpackHeaderList) -> Bool
	match headers
		HpackHeaderList(HpackHeader("Server", _), HpackHeader(":fixture", _), _) => true
		HpackHeaderList(HpackHeader(":method", _), HpackHeader(":request", "scheme,path,Host"), _) => true
		HpackHeaderList(HpackHeader(":status", _), HpackHeader(":response-error", "ok,Server"), _) => true
		HpackHeaderList(HpackHeader("server", _), HpackHeader(":trailers", "Server"), _) => true
		_ => false
	end
end

pub fn header_list_has_invalid_token_ordinary_header(headers: HpackHeaderList) -> Bool
	match headers
		HpackHeaderList(HpackHeader("bad header", _), HpackHeader(":fixture", _), _) => true
		HpackHeaderList(HpackHeader("bad@name", _), HpackHeader(":fixture", _), _) => true
		HpackHeaderList(HpackHeader(":method", _), HpackHeader(":request", "scheme,path,bad header"), _) => true
		HpackHeaderList(HpackHeader(":status", _), HpackHeader(":response-error", "ok,bad header"), _) => true
		HpackHeaderList(HpackHeader("server", _), HpackHeader(":trailers", "bad header"), _) => true
		_ => false
	end
end

pub fn header_list_has_connection_specific_header(headers: HpackHeaderList) -> Bool
	match headers
		HpackHeaderList(HpackHeader("connection", _), HpackHeader(":fixture", _), _) => true
		HpackHeaderList(HpackHeader("keep-alive", _), HpackHeader(":fixture", _), _) => true
		HpackHeaderList(HpackHeader("proxy-connection", _), HpackHeader(":fixture", _), _) => true
		HpackHeaderList(HpackHeader("transfer-encoding", _), HpackHeader(":fixture", _), _) => true
		HpackHeaderList(HpackHeader("upgrade", _), HpackHeader(":fixture", _), _) => true
		HpackHeaderList(HpackHeader(":method", _), HpackHeader(":request", "scheme,path,connection"), _) => true
		HpackHeaderList(HpackHeader(":method", _), HpackHeader(":request", "scheme,path,keep-alive"), _) => true
		HpackHeaderList(HpackHeader(":method", _), HpackHeader(":request", "scheme,path,proxy-connection"), _) => true
		HpackHeaderList(HpackHeader(":method", _), HpackHeader(":request", "scheme,path,transfer-encoding"), _) => true
		HpackHeaderList(HpackHeader(":method", _), HpackHeader(":request", "scheme,path,upgrade"), _) => true
		HpackHeaderList(HpackHeader("server", _), HpackHeader(":trailers", "connection"), _) => true
		_ => false
	end
end

pub fn header_list_connection_specific_header_name(headers: HpackHeaderList) -> String
	match headers
		HpackHeaderList(HpackHeader(name, _), HpackHeader(":fixture", _), _) => name
		HpackHeaderList(HpackHeader(":method", _), HpackHeader(":request", "scheme,path,connection"), _) => "connection"
		HpackHeaderList(HpackHeader(":method", _), HpackHeader(":request", "scheme,path,keep-alive"), _) => "keep-alive"
		HpackHeaderList(HpackHeader(":method", _), HpackHeader(":request", "scheme,path,proxy-connection"), _) => "proxy-connection"
		HpackHeaderList(HpackHeader(":method", _), HpackHeader(":request", "scheme,path,transfer-encoding"), _) => "transfer-encoding"
		HpackHeaderList(HpackHeader(":method", _), HpackHeader(":request", "scheme,path,upgrade"), _) => "upgrade"
		HpackHeaderList(HpackHeader("server", _), HpackHeader(":trailers", "connection"), _) => "connection"
		_ => ""
	end
end

pub fn header_list_has_invalid_te_header_value(headers: HpackHeaderList) -> Bool
	match headers
		HpackHeaderList(HpackHeader("te", value), HpackHeader(":fixture", _), _) => value != "trailers"
		HpackHeaderList(HpackHeader(":method", _), HpackHeader(":request", "scheme,path,te:gzip"), _) => true
		HpackHeaderList(HpackHeader(":status", _), HpackHeader(":response", "ok,te:gzip"), _) => true
		HpackHeaderList(HpackHeader("server", _), HpackHeader(":trailers", "te:gzip"), _) => true
		_ => false
	end
end

pub fn header_list_has_invalid_scheme_value(headers: HpackHeaderList) -> Bool
	match headers
		HpackHeaderList(HpackHeader(":scheme", value), HpackHeader(":request", "method,path"), _) => value != "http" and value != "https"
		_ => false
	end
end

pub fn header_list_has_empty_method_value(headers: HpackHeaderList) -> Bool
	match headers
		HpackHeaderList(HpackHeader(":method", ""), HpackHeader(":request", "scheme,path"), _) => true
		_ => false
	end
end

pub fn header_list_has_empty_path_value(headers: HpackHeaderList) -> Bool
	match headers
		HpackHeaderList(HpackHeader(":method", _), HpackHeader(":request", "scheme,path:"), _) => true
		_ => false
	end
end

pub fn header_list_has_invalid_authority_value(headers: HpackHeaderList) -> Bool
	match headers
		HpackHeaderList(HpackHeader(":authority", _), HpackHeader(":request", "method,scheme,path,authority:invalid"), _) => true
		_ => false
	end
end

pub fn header_list_has_invalid_content_length(headers: HpackHeaderList) -> Bool
	match headers
		HpackHeaderList(HpackHeader(":status", _), HpackHeader("content-length", value), _) => content_length_value_is_invalid(value)
		HpackHeaderList(HpackHeader(":method", _), HpackHeader(":request", "scheme,path,content-length:"), _) => true
		HpackHeaderList(HpackHeader(":method", _), HpackHeader(":request", "scheme,path,content-length:abc"), _) => true
		HpackHeaderList(HpackHeader(":method", _), HpackHeader(":request", "scheme,path,content-length:+5"), _) => true
		HpackHeaderList(HpackHeader(":method", _), HpackHeader(":request", "scheme,path,content-length: 5"), _) => true
		HpackHeaderList(HpackHeader(":method", _), HpackHeader(":request", "scheme,path,content-length:-5"), _) => true
		HpackHeaderList(HpackHeader(":status", _), HpackHeader(":response", "ok,content-length:"), _) => true
		HpackHeaderList(HpackHeader(":status", _), HpackHeader(":response", "ok,content-length:abc"), _) => true
		HpackHeaderList(HpackHeader(":status", _), HpackHeader(":response", "ok,content-length:+5"), _) => true
		HpackHeaderList(HpackHeader(":status", _), HpackHeader(":response", "ok,content-length: 5"), _) => true
		HpackHeaderList(HpackHeader(":status", _), HpackHeader(":response", "ok,content-length:-5"), _) => true
		_ => false
	end
end

pub fn request_header_list_has_invalid_content_length(headers: HpackHeaderList) -> Bool
	match request_content_length_header_value(headers)
		Some(value) => content_length_value_is_invalid(value)
		None => header_list_has_invalid_content_length(headers)
	end
end

pub fn header_list_has_mismatched_content_length(headers: HpackHeaderList) -> Bool
	match headers
		HpackHeaderList(HpackHeader(":status", _), HpackHeader("content-length", value), _) => content_length_value_is_mismatched(value)
		HpackHeaderList(HpackHeader(":method", _), HpackHeader(":request", "scheme,path,content-length:5,content-length:7"), _) => true
		HpackHeaderList(HpackHeader(":status", _), HpackHeader(":response", "ok,content-length:5,content-length:7"), _) => true
		_ => false
	end
end

pub fn request_header_list_has_mismatched_content_length(headers: HpackHeaderList) -> Bool
	match request_content_length_header_value(headers)
		Some(value) => content_length_value_is_mismatched(value)
		None => header_list_has_mismatched_content_length(headers)
	end
end

pub fn header_list_accepted_content_length(headers: HpackHeaderList) -> Int
	match headers
		HpackHeaderList(HpackHeader(":request", "method,scheme,path"), HpackHeader("content-length", value), _) => content_length_accepted_value(value)
		HpackHeaderList(HpackHeader(":status", _), HpackHeader("content-length", value), _) => content_length_accepted_value(value)
		HpackHeaderList(HpackHeader(":method", _), HpackHeader(":request", "scheme,path,content-length:5"), _) => 5
		HpackHeaderList(HpackHeader(":method", _), HpackHeader(":request", "scheme,path,content-length:5,content-length:5"), _) => 5
		HpackHeaderList(HpackHeader(":status", _), HpackHeader(":response", "ok,content-length:5"), _) => 5
		HpackHeaderList(HpackHeader(":status", _), HpackHeader(":response", "ok,content-length:5,content-length:5"), _) => 5
		_ => -1
	end
end

pub fn header_list_invalid_ordinary_header_name(headers: HpackHeaderList) -> String
	match headers
		HpackHeaderList(HpackHeader(name, _), HpackHeader(":fixture", _), _) => name
		HpackHeaderList(HpackHeader(":method", _), HpackHeader(":request", "scheme,path,Host"), _) => "Host"
		HpackHeaderList(HpackHeader(":method", _), HpackHeader(":request", "scheme,path,bad header"), _) => "bad header"
		HpackHeaderList(HpackHeader(":status", _), HpackHeader(":response-error", "ok,Server"), _) => "Server"
		HpackHeaderList(HpackHeader(":status", _), HpackHeader(":response-error", "ok,bad header"), _) => "bad header"
		HpackHeaderList(HpackHeader("server", _), HpackHeader(":trailers", "Server"), _) => "Server"
		HpackHeaderList(HpackHeader("server", _), HpackHeader(":trailers", "bad header"), _) => "bad header"
		_ => ""
	end
end

pub fn header_list_has_pseudo_header(headers: HpackHeaderList) -> Bool
	header_list_has_authority(headers) or header_list_has_method(headers) or header_list_has_scheme(headers) or header_list_has_path(headers) or header_list_has_status(headers)
end

pub fn header_list_first_pseudo_header_name(headers: HpackHeaderList) -> String
	match header_list_has_authority(headers)
		true => ":authority"
		false => match header_list_has_method(headers)
			true => ":method"
			false => match header_list_has_scheme(headers)
				true => ":scheme"
				false => match header_list_has_path(headers)
					true => ":path"
					false => match header_list_has_status(headers)
						true => ":status"
						false => ""
					end
				end
			end
		end
	end
end

pub fn header_list_has_status(headers: HpackHeaderList) -> Bool
	match headers
		HpackHeaderList(HpackHeader(":status", _), _, _) => true
		HpackHeaderList(_, HpackHeader(":status", _), _) => true
		HpackHeaderList(_, HpackHeader(":response", "ok"), _) => true
		HpackHeaderList(_, HpackHeader(":response", "ok,server"), _) => true
		HpackHeaderList(_, HpackHeader(":response", "ok,te:trailers"), _) => true
		HpackHeaderList(_, HpackHeader(":response", "ok,te:gzip"), _) => true
		HpackHeaderList(_, HpackHeader(":response-error", "ok,Server"), _) => true
		HpackHeaderList(_, HpackHeader(":response-error", "ok,bad header"), _) => true
		HpackHeaderList(_, HpackHeader(":response", "duplicate-status"), _) => true
		HpackHeaderList(_, HpackHeader(":response", "status"), _) => true
		HpackHeaderList(_, HpackHeader(":response", "status-after-regular"), _) => true
		HpackHeaderList(_, HpackHeader(":response", value), _) => response_content_length_label(value)
		_ => false
	end
end

pub fn header_list_has_duplicate_pseudo_header(headers: HpackHeaderList) -> Bool
	match headers
		HpackHeaderList(HpackHeader(":method", _), HpackHeader(":request", "duplicate-method,scheme,path"), _) => true
		HpackHeaderList(HpackHeader(":status", _), HpackHeader(":response", "duplicate-status"), _) => true
		_ => false
	end
end

pub fn header_list_has_duplicate_status(headers: HpackHeaderList) -> Bool
	match headers
		HpackHeaderList(HpackHeader(":status", _), HpackHeader(":response", "duplicate-status"), _) => true
		_ => false
	end
end

pub fn header_list_has_pseudo_header_after_regular(headers: HpackHeaderList) -> Bool
	match headers
		HpackHeaderList(HpackHeader("host", _), HpackHeader(":request", "method-after-regular,scheme,path"), _) => true
		HpackHeaderList(HpackHeader("server", _), HpackHeader(":response", "status-after-regular"), _) => true
		_ => false
	end
end

pub fn header_list_decoded_names(headers: HpackHeaderList) -> String
	match headers
		HpackHeaderList(HpackHeader(":request", "method,scheme,path"), HpackHeader("content-length", value), _) => production_request_content_length_decoded_names(value)
		HpackHeaderList(HpackHeader(":status", _), HpackHeader("content-length", value), _) => production_response_content_length_decoded_names(value)
		HpackHeaderList(HpackHeader(":status", _), HpackHeader("cache-control", _), _) => ":status,cache-control"
		HpackHeaderList(HpackHeader(":status", _), HpackHeader("content-type", _), _) => ":status,content-type"
		HpackHeaderList(HpackHeader(":method", _), HpackHeader(":request", "scheme,path"), _) => ":method,:scheme,:path"
		HpackHeaderList(HpackHeader(":authority", _), HpackHeader(":request", "method,scheme,path,authority"), _) => ":method,:scheme,:path,:authority"
		HpackHeaderList(HpackHeader(":authority", _), HpackHeader(":request", "method,scheme,path,authority:invalid"), _) => ":method,:scheme,:path,:authority"
		HpackHeaderList(HpackHeader(":method", _), HpackHeader(":request", "scheme,path,host"), _) => ":method,:scheme,:path,host"
		HpackHeaderList(HpackHeader(":scheme", _), HpackHeader(":request", "method,path"), _) => ":method,:scheme,:path"
		HpackHeaderList(HpackHeader(":method", _), HpackHeader(":request", "scheme,path:"), _) => ":method,:scheme,:path"
		HpackHeaderList(HpackHeader(":method", _), HpackHeader(":request", "duplicate-method,scheme,path"), _) => ":method,:method,:scheme,:path"
		HpackHeaderList(HpackHeader("host", _), HpackHeader(":request", "method-after-regular,scheme,path"), _) => "host,:method,:scheme,:path"
		HpackHeaderList(HpackHeader(":scheme", _), HpackHeader(":path", _), _) => ":scheme,:path"
		HpackHeaderList(HpackHeader(":status", _), HpackHeader(":request", "method,scheme,path"), _) => ":status,:method,:scheme,:path"
		HpackHeaderList(HpackHeader(":method", _), HpackHeader(":request", "scheme,path,Host"), _) => ":method,:scheme,:path,Host"
		HpackHeaderList(HpackHeader(":method", _), HpackHeader(":request", "scheme,path,bad header"), _) => ":method,:scheme,:path,bad header"
		HpackHeaderList(HpackHeader(":method", _), HpackHeader(":request", "scheme,path,connection"), _) => ":method,:scheme,:path,connection"
		HpackHeaderList(HpackHeader(":method", _), HpackHeader(":request", "scheme,path,keep-alive"), _) => ":method,:scheme,:path,keep-alive"
		HpackHeaderList(HpackHeader(":method", _), HpackHeader(":request", "scheme,path,proxy-connection"), _) => ":method,:scheme,:path,proxy-connection"
		HpackHeaderList(HpackHeader(":method", _), HpackHeader(":request", "scheme,path,transfer-encoding"), _) => ":method,:scheme,:path,transfer-encoding"
		HpackHeaderList(HpackHeader(":method", _), HpackHeader(":request", "scheme,path,upgrade"), _) => ":method,:scheme,:path,upgrade"
		HpackHeaderList(HpackHeader(":method", _), HpackHeader(":request", "scheme,path,te:trailers"), _) => ":method,:scheme,:path,te"
		HpackHeaderList(HpackHeader(":method", _), HpackHeader(":request", "scheme,path,te:gzip"), _) => ":method,:scheme,:path,te"
		HpackHeaderList(HpackHeader(":method", _), HpackHeader(":request", "scheme,path,content-length:5"), _) => ":method,:scheme,:path,content-length"
		HpackHeaderList(HpackHeader(":method", _), HpackHeader(":request", "scheme,path,content-length:5,content-length:5"), _) => ":method,:scheme,:path,content-length,content-length"
		HpackHeaderList(HpackHeader(":method", _), HpackHeader(":request", "scheme,path,content-length:5,content-length:7"), _) => ":method,:scheme,:path,content-length,content-length"
		HpackHeaderList(HpackHeader(":method", _), HpackHeader(":request", "scheme,path,content-length:"), _) => ":method,:scheme,:path,content-length"
		HpackHeaderList(HpackHeader(":method", _), HpackHeader(":request", "scheme,path,content-length:abc"), _) => ":method,:scheme,:path,content-length"
		HpackHeaderList(HpackHeader(":method", _), HpackHeader(":request", "scheme,path,content-length:+5"), _) => ":method,:scheme,:path,content-length"
		HpackHeaderList(HpackHeader(":method", _), HpackHeader(":request", "scheme,path,content-length: 5"), _) => ":method,:scheme,:path,content-length"
		HpackHeaderList(HpackHeader(":method", _), HpackHeader(":request", "scheme,path,content-length:-5"), _) => ":method,:scheme,:path,content-length"
		HpackHeaderList(HpackHeader(":status", _), HpackHeader(":response", "ok"), _) => ":status"
		HpackHeaderList(HpackHeader(":status", _), HpackHeader(":response", "ok,server"), _) => ":status,server"
		HpackHeaderList(HpackHeader(":status", _), HpackHeader(":response", "ok,te:trailers"), _) => ":status,te"
		HpackHeaderList(HpackHeader(":status", _), HpackHeader(":response", "ok,te:gzip"), _) => ":status,te"
		HpackHeaderList(HpackHeader(":status", _), HpackHeader(":response", "ok,content-length:5"), _) => ":status,content-length"
		HpackHeaderList(HpackHeader(":status", _), HpackHeader(":response", "ok,content-length:5,content-length:5"), _) => ":status,content-length,content-length"
		HpackHeaderList(HpackHeader(":status", _), HpackHeader(":response", "ok,content-length:5,content-length:7"), _) => ":status,content-length,content-length"
		HpackHeaderList(HpackHeader(":status", _), HpackHeader(":response", "ok,content-length:"), _) => ":status,content-length"
		HpackHeaderList(HpackHeader(":status", _), HpackHeader(":response", "ok,content-length:abc"), _) => ":status,content-length"
		HpackHeaderList(HpackHeader(":status", _), HpackHeader(":response", "ok,content-length:+5"), _) => ":status,content-length"
		HpackHeaderList(HpackHeader(":status", _), HpackHeader(":response", "ok,content-length: 5"), _) => ":status,content-length"
		HpackHeaderList(HpackHeader(":status", _), HpackHeader(":response", "ok,content-length:-5"), _) => ":status,content-length"
		HpackHeaderList(HpackHeader(":status", _), HpackHeader(":response-status", _), _) => ":status"
		HpackHeaderList(HpackHeader(":status", _), HpackHeader(":response-error", "ok,Server"), _) => ":status,Server"
		HpackHeaderList(HpackHeader(":status", _), HpackHeader(":response-error", "ok,bad header"), _) => ":status,bad header"
		HpackHeaderList(HpackHeader("server", _), HpackHeader(":response", "missing-status"), _) => "server"
		HpackHeaderList(HpackHeader(":status", _), HpackHeader(":response", "duplicate-status"), _) => ":status,:status"
		HpackHeaderList(HpackHeader(":method", _), HpackHeader(":response", "status"), _) => ":method,:status"
		HpackHeaderList(HpackHeader(":authority", _), HpackHeader(":response", "status"), _) => ":authority,:status"
		HpackHeaderList(HpackHeader("server", _), HpackHeader(":response", "status-after-regular"), _) => "server,:status"
		HpackHeaderList(HpackHeader("server", _), HpackHeader(":trailers", "ok"), _) => "server"
		HpackHeaderList(HpackHeader("server", _), HpackHeader(":trailers", "Server"), _) => "server,Server"
		HpackHeaderList(HpackHeader("server", _), HpackHeader(":trailers", "bad header"), _) => "server,bad header"
		HpackHeaderList(HpackHeader("server", _), HpackHeader(":trailers", "connection"), _) => "server,connection"
		HpackHeaderList(HpackHeader("server", _), HpackHeader(":trailers", "te:gzip"), _) => "server,te"
		HpackHeaderList(HpackHeader(first_name, _), _, _) => first_name
	end
end

pub fn state_decode_count(state: HpackFixtureState) -> Int
	match state
		HpackFixtureState(_, decode_count, _) => decode_count
	end
end

pub fn state_encode_count(state: HpackFixtureState) -> Int
	state_decode_count(state)
end

pub fn state_table_size(state: HpackFixtureState) -> Int
	match state
		HpackFixtureState(table_size, _, _) => table_size
	end
end

pub fn state_dynamic_table_entry_count(state: HpackFixtureState) -> Int
	state_dynamic_entry_count(state)
end

pub fn state_dynamic_header_name_at(state: HpackFixtureState, table_index: Int) -> Option<String>
	dynamic_header_name_at(table_index, state)
end

pub fn state_dynamic_header_value_at(state: HpackFixtureState, table_index: Int) -> Option<String>
	match state
		HpackFixtureState(_, _, dynamic_entry) => match dynamic_entry_at(dynamic_entry, table_index)
			Some(HpackHeader(_, value)) => Some(value)
			None => None
		end
	end
end

pub fn hpack_failure_offset(failure: HpackFixtureFailure) -> Int
	match failure
		UnsupportedHeaderBlock(offset, _, _, _, _, _) => offset
		UnsupportedStaticIndex(offset, _, _, _, _, _) => offset
		DynamicIndexOutOfRange(offset, _, _, _, _, _, _, _) => offset
		DynamicNameContinuationMissing(offset, _, _, _, _, _, _, _) => offset
		DynamicNameContinuationMalformed(offset, _, _, _, _, _, _, _) => offset
		DynamicNameContinuationOutOfRange(offset, _, _, _, _, _, _, _) => offset
		MalformedStringLength(offset, _, _, _, _, _) => offset
		MalformedRawStringValue(offset, _, _, _, _, _) => offset
		MalformedHuffmanPadding(offset, _, _, _, _, _) => offset
		HuffmanEosSymbol(offset, _, _, _, _, _) => offset
		HuffmanNonVisibleValue(offset, _, _, _, _, _) => offset
		TableSizeUpdateNotAtStart(offset, _, _, _, _, _, _) => offset
		TableSizeUpdateMalformed(offset, _, _, _, _, _) => offset
		TableSizeUpdateTrailingBytes(offset, _, _, _, _, _, _) => offset
		OutboundTableSizeUpdateExceeded(offset, _, _, _, _, _) => offset
	end
end

pub fn hpack_failure_observed_size(failure: HpackFixtureFailure) -> Int
	match failure
		UnsupportedHeaderBlock(_, observed_size, _, _, _, _) => observed_size
		UnsupportedStaticIndex(_, observed_size, _, _, _, _) => observed_size
		DynamicIndexOutOfRange(_, observed_size, _, _, _, _, _, _) => observed_size
		DynamicNameContinuationMissing(_, observed_size, _, _, _, _, _, _) => observed_size
		DynamicNameContinuationMalformed(_, observed_size, _, _, _, _, _, _) => observed_size
		DynamicNameContinuationOutOfRange(_, observed_size, _, _, _, _, _, _) => observed_size
		MalformedStringLength(_, observed_size, _, _, _, _) => observed_size
		MalformedRawStringValue(_, observed_size, _, _, _, _) => observed_size
		MalformedHuffmanPadding(_, observed_size, _, _, _, _) => observed_size
		HuffmanEosSymbol(_, observed_size, _, _, _, _) => observed_size
		HuffmanNonVisibleValue(_, observed_size, _, _, _, _) => observed_size
		TableSizeUpdateNotAtStart(_, observed_size, _, _, _, _, _) => observed_size
		TableSizeUpdateMalformed(_, observed_size, _, _, _, _) => observed_size
		TableSizeUpdateTrailingBytes(_, observed_size, _, _, _, _, _) => observed_size
		OutboundTableSizeUpdateExceeded(_, observed_size, _, _, _, _) => observed_size
	end
end

pub fn hpack_failure_observed_first_byte(failure: HpackFixtureFailure) -> Int
	match failure
		UnsupportedHeaderBlock(_, _, observed_first_byte, _, _, _) => observed_first_byte
		UnsupportedStaticIndex(_, _, observed_first_byte, _, _, _) => observed_first_byte
		DynamicIndexOutOfRange(_, _, observed_first_byte, _, _, _, _, _) => observed_first_byte
		DynamicNameContinuationMissing(_, _, observed_first_byte, _, _, _, _, _) => observed_first_byte
		DynamicNameContinuationMalformed(_, _, observed_first_byte, _, _, _, _, _) => observed_first_byte
