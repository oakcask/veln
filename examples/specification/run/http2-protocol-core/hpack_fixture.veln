pub type HpackDynamicEntry
	NoDynamicEntry
	DynamicEntry(name: String, value: String, older: HpackDynamicEntry)
end

pub type HpackFixtureState
	HpackFixtureState(table_size: Int, decode_count: Int, dynamic_entry: HpackDynamicEntry)
end

pub type HpackHeader
	HpackHeader(name: String, value: String)
end

pub type HpackHeaderList
	HpackHeaderList(first: HpackHeader, second: HpackHeader, wire_size: Int)
end

pub fn hpack_header(name: String, value: String) -> HpackHeader
	HpackHeader(name, value)
end

pub fn hpack_header_list(first: HpackHeader, second: HpackHeader, wire_size: Int) -> HpackHeaderList
	HpackHeaderList(first, second, wire_size)
end

pub type HpackDecodeTransition
	HpackDecodeTransition(headers: HpackHeaderList, state: HpackFixtureState)
end

pub type HpackEncodeTransition
	HpackEncodeTransition(encoded: ByteChunk, state: HpackFixtureState)
end

pub type HpackFixtureFailure
	UnsupportedHeaderBlock(offset: Int, observed_size: Int, observed_first_byte: Int, expected_fixture: String, codec_module: String, preview: ByteChunk)
	UnsupportedStaticIndex(offset: Int, observed_size: Int, observed_first_byte: Int, expected_fixture: String, codec_module: String, preview: ByteChunk)
	DynamicIndexOutOfRange(offset: Int, observed_size: Int, observed_first_byte: Int, requested_dynamic_index: Int, dynamic_table_entry_count: Int, expected_fixture: String, codec_module: String, preview: ByteChunk)
	DynamicNameContinuationMissing(offset: Int, observed_size: Int, observed_first_byte: Int, requested_dynamic_index: Int, dynamic_table_entry_count: Int, expected_fixture: String, codec_module: String, preview: ByteChunk)
	DynamicNameContinuationMalformed(offset: Int, observed_size: Int, observed_first_byte: Int, requested_dynamic_index: Int, dynamic_table_entry_count: Int, expected_fixture: String, codec_module: String, preview: ByteChunk)
	DynamicNameContinuationOutOfRange(offset: Int, observed_size: Int, observed_first_byte: Int, requested_dynamic_index: Int, dynamic_table_entry_count: Int, expected_fixture: String, codec_module: String, preview: ByteChunk)
	MalformedStringLength(offset: Int, observed_size: Int, observed_first_byte: Int, expected_fixture: String, codec_module: String, preview: ByteChunk)
	MalformedRawStringValue(offset: Int, observed_size: Int, observed_first_byte: Int, expected_fixture: String, codec_module: String, preview: ByteChunk)
	MalformedHuffmanPadding(offset: Int, observed_size: Int, observed_first_byte: Int, expected_fixture: String, codec_module: String, preview: ByteChunk)
	HuffmanEosSymbol(offset: Int, observed_size: Int, observed_first_byte: Int, expected_fixture: String, codec_module: String, preview: ByteChunk)
	HuffmanNonVisibleValue(offset: Int, observed_size: Int, observed_first_byte: Int, expected_fixture: String, codec_module: String, preview: ByteChunk)
	TableSizeUpdateNotAtStart(offset: Int, observed_size: Int, observed_first_byte: Int, observed_update_size: Int, expected_fixture: String, codec_module: String, preview: ByteChunk)
	TableSizeUpdateMalformed(offset: Int, observed_size: Int, observed_first_byte: Int, expected_fixture: String, codec_module: String, preview: ByteChunk)
	TableSizeUpdateTrailingBytes(offset: Int, observed_size: Int, observed_first_byte: Int, observed_update_size: Int, expected_fixture: String, codec_module: String, preview: ByteChunk)
	OutboundTableSizeUpdateExceeded(offset: Int, observed_size: Int, allowed_size: Int, expected_fixture: String, codec_module: String, preview: ByteChunk)
end

type HpackStringLiteral
	HpackStringLiteral(value: String, wire_size: Int)
end

type HpackStringLength
	HpackStringLength(huffman_marked: Bool, encoded_count: Int, prefix_size: Int)
end

type HpackIntegerPrefix
	HpackIntegerPrefix(value: Int, prefix_size: Int)
end

type HpackLiteralIndexing
	LiteralWithoutIndexing
	LiteralWithIndexing
	LiteralNeverIndexed
end

type HpackHuffmanCode
	HpackHuffmanCode(code: Int, length: Int)
end

type HpackHuffmanEncoding
	HpackHuffmanEncoding(encoded: ByteChunk, current_byte: Int, current_bit_count: Int)
end

pub fn initial_state() -> HpackFixtureState
	HpackFixtureState(4096, 0, NoDynamicEntry)
end

pub fn initial_encode_state() -> HpackFixtureState
	HpackFixtureState(4096, 0, NoDynamicEntry)
end

pub fn incomplete_header_list() -> HpackHeaderList
	HpackHeaderList(HpackHeader(":fixture", "incomplete"), HpackHeader(":fixture", "incomplete"), 0)
end

fn byte_at(block: ByteChunk, index: Int) -> Result<Int, String>
	let view: ByteView = byte_view(block, byte_offset(index)?, byte_count(1)?)?
	byte_read_u8_be(view)
end

fn byte_at_or_missing(block: ByteChunk, index: Int) -> Int
	match byte_at(block, index)
		Ok(value) => value
		Err(_) => -1
	end
end

fn next_state(state: HpackFixtureState) -> HpackFixtureState
	match state
		HpackFixtureState(table_size, decode_count, dynamic_entry) => HpackFixtureState(table_size, decode_count + 1, dynamic_entry)
	end
end

fn dynamic_entry_size(name: String, value: String) -> Int
	string_byte_count(name) + string_byte_count(value) + 32
end

fn string_byte_count(value: String) -> Int
	match byte_chunk_from_visible_ascii_string(value)
		Ok(bytes) => byte_count_to_int(byte_chunk_count(bytes))
		Err(_) => 0
	end
end

fn bounded_dynamic_entry(table_size: Int, name: String, value: String, dynamic_entry: HpackDynamicEntry) -> HpackDynamicEntry
	let entry_size: Int = dynamic_entry_size(name, value)
	match entry_size > table_size
		true => NoDynamicEntry
		false => evict_for_table_size(table_size, DynamicEntry(name, value, dynamic_entry))
	end
end

fn evict_for_table_size(table_size: Int, dynamic_entry: HpackDynamicEntry) -> HpackDynamicEntry
	evict_for_remaining_table_size(table_size, dynamic_entry)
end

fn evict_for_remaining_table_size(remaining_table_size: Int, dynamic_entry: HpackDynamicEntry) -> HpackDynamicEntry
	match dynamic_entry
		NoDynamicEntry => NoDynamicEntry
		DynamicEntry(name, value, older) => match dynamic_entry_size(name, value) <= remaining_table_size
			true => DynamicEntry(name, value, evict_for_remaining_table_size(remaining_table_size - dynamic_entry_size(name, value), older))
			false => NoDynamicEntry
		end
	end
end

fn state_with_dynamic_entry(state: HpackFixtureState, name: String, value: String) -> HpackFixtureState
	match state
		HpackFixtureState(table_size, decode_count, dynamic_entry) => HpackFixtureState(table_size, decode_count + 1, bounded_dynamic_entry(table_size, name, value, dynamic_entry))
	end
end

pub fn state_with_indexed_literal_entry(state: HpackFixtureState, name: String, value: String) -> HpackFixtureState
	state_with_dynamic_entry(state, name, value)
end

pub fn state_after_literal_read(state: HpackFixtureState) -> HpackFixtureState
	next_state(state)
end

fn state_with_table_size(state: HpackFixtureState, table_size: Int) -> HpackFixtureState
	match state
		HpackFixtureState(_, decode_count, dynamic_entry) => HpackFixtureState(table_size, decode_count + 1, evict_for_table_size(table_size, dynamic_entry))
	end
end

