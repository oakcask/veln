fn project_failure_fallback_payload(error: String) -> RuntimeDiagnostic
	RuntimeDiagnostic(
		"hpack.fixture.unsupported_header_block",
		error,
		RuntimeHpackFixtureDiagnostic(0, 0, -1, "fixture header block", "hpack_fixture", byte_chunk([]))
	)
end

fn project_failure_preview(failure: HpackFixtureFailure) -> Result<ByteView, RuntimeDiagnostic>
	let preview_chunk: ByteChunk = hpack_failure_preview(failure)
	match byte_offset(0)
		Ok(offset) => match byte_view(preview_chunk, offset, byte_chunk_count(preview_chunk))
			Ok(view) => Ok(view)
			Err(error) => Err(project_failure_fallback_payload(error))
		end
		Err(error) => Err(project_failure_fallback_payload(error))
	end
end

pub fn project_failure(failure: HpackFixtureFailure) -> Result<(), RuntimeDiagnostic>
	let preview: ByteView = project_failure_preview(failure)?
	match failure
		UnsupportedHeaderBlock(_, _, _, _, _, _) => hpack_fixture_unsupported_header_block(hpack_failure_offset(failure), hpack_failure_observed_size(failure), hpack_failure_observed_first_byte(failure), hpack_failure_expected_fixture(failure), hpack_failure_codec_module(failure), preview)
		UnsupportedStaticIndex(_, _, _, _, _, _) => hpack_fixture_unsupported_static_index(hpack_failure_offset(failure), hpack_failure_observed_size(failure), hpack_failure_observed_first_byte(failure), hpack_failure_expected_fixture(failure), hpack_failure_codec_module(failure), preview)
		DynamicIndexOutOfRange(_, _, _, _, _, _, _, _) => hpack_fixture_dynamic_index_out_of_range(hpack_failure_offset(failure), hpack_failure_observed_size(failure), hpack_failure_observed_first_byte(failure), hpack_failure_requested_dynamic_index(failure), hpack_failure_dynamic_table_entry_count(failure), hpack_failure_expected_fixture(failure), hpack_failure_codec_module(failure), preview)
		DynamicNameContinuationMissing(_, _, _, _, _, _, _, _) => hpack_fixture_dynamic_name_continuation_missing(hpack_failure_offset(failure), hpack_failure_observed_size(failure), hpack_failure_observed_first_byte(failure), hpack_failure_requested_dynamic_index(failure), hpack_failure_dynamic_table_entry_count(failure), hpack_failure_expected_fixture(failure), hpack_failure_codec_module(failure), preview)
		DynamicNameContinuationMalformed(_, _, _, _, _, _, _, _) => hpack_fixture_dynamic_name_continuation_malformed(hpack_failure_offset(failure), hpack_failure_observed_size(failure), hpack_failure_observed_first_byte(failure), hpack_failure_requested_dynamic_index(failure), hpack_failure_dynamic_table_entry_count(failure), hpack_failure_expected_fixture(failure), hpack_failure_codec_module(failure), preview)
		DynamicNameContinuationOutOfRange(_, _, _, _, _, _, _, _) => hpack_fixture_dynamic_name_continuation_out_of_range(hpack_failure_offset(failure), hpack_failure_observed_size(failure), hpack_failure_observed_first_byte(failure), hpack_failure_requested_dynamic_index(failure), hpack_failure_dynamic_table_entry_count(failure), hpack_failure_expected_fixture(failure), hpack_failure_codec_module(failure), preview)
		MalformedStringLength(_, _, _, _, _, _) => hpack_fixture_malformed_string_length(hpack_failure_offset(failure), hpack_failure_observed_size(failure), hpack_failure_observed_first_byte(failure), hpack_failure_expected_fixture(failure), hpack_failure_codec_module(failure), preview)
		MalformedRawStringValue(_, _, _, _, _, _) => hpack_fixture_malformed_raw_string_value(hpack_failure_offset(failure), hpack_failure_observed_size(failure), hpack_failure_observed_first_byte(failure), hpack_failure_expected_fixture(failure), hpack_failure_codec_module(failure), preview)
		MalformedHuffmanPadding(_, _, _, _, _, _) => hpack_fixture_malformed_huffman_padding(hpack_failure_offset(failure), hpack_failure_observed_size(failure), hpack_failure_observed_first_byte(failure), hpack_failure_expected_fixture(failure), hpack_failure_codec_module(failure), preview)
		HuffmanEosSymbol(_, _, _, _, _, _) => hpack_fixture_huffman_eos_symbol(hpack_failure_offset(failure), hpack_failure_observed_size(failure), hpack_failure_observed_first_byte(failure), hpack_failure_expected_fixture(failure), hpack_failure_codec_module(failure), preview)
		HuffmanNonVisibleValue(_, _, _, _, _, _) => hpack_fixture_huffman_non_visible_value(hpack_failure_offset(failure), hpack_failure_observed_size(failure), hpack_failure_observed_first_byte(failure), hpack_failure_expected_fixture(failure), hpack_failure_codec_module(failure), preview)
		TableSizeUpdateNotAtStart(_, _, _, _, _, _, _) => hpack_fixture_table_size_update_not_at_start(hpack_failure_offset(failure), hpack_failure_observed_size(failure), hpack_failure_observed_first_byte(failure), hpack_failure_observed_update_size(failure), 0, 0, "hpack-fixture", hpack_failure_expected_fixture(failure), hpack_failure_codec_module(failure), preview)
		TableSizeUpdateMalformed(_, _, _, _, _, _) => hpack_fixture_table_size_update_malformed(hpack_failure_offset(failure), hpack_failure_observed_size(failure), hpack_failure_observed_first_byte(failure), hpack_failure_expected_fixture(failure), hpack_failure_codec_module(failure), preview)
		TableSizeUpdateTrailingBytes(_, _, _, _, _, _, _) => hpack_fixture_table_size_update_trailing_bytes(hpack_failure_offset(failure), hpack_failure_observed_size(failure), hpack_failure_observed_first_byte(failure), hpack_failure_observed_update_size(failure), 0, 0, "hpack-fixture", hpack_failure_expected_fixture(failure), hpack_failure_codec_module(failure), preview)
		OutboundTableSizeUpdateExceeded(_, _, _, _, _, _) => hpack_fixture_unsupported_header_block(hpack_failure_offset(failure), hpack_failure_observed_size(failure), hpack_failure_observed_first_byte(failure), hpack_failure_expected_fixture(failure), hpack_failure_codec_module(failure), preview)
	end
end
