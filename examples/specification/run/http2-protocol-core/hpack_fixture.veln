			268435450 => Some(30)
			268435451 => Some(31)
			268435452 => Some(127)
			268435453 => Some(220)
			268435454 => Some(249)
			_ => None
		end
		30 => match code
			1073741820 => Some(10)
			1073741821 => Some(13)
			1073741822 => Some(22)
			1073741823 => Some(256)
			_ => None
		end
		_ => None
	end
end

fn hpack_huffman_padding_valid(code: Int, length: Int) -> Bool
	length == 0 or (length <= 7 and code == pow2(length) - 1)
end

fn hpack_huffman_decoded_wire_size(value: String, decoded_size: Int) -> Int
	match value == ""
		true => 2
		false => match value == "www.example.com"
			true => 13
			false => decoded_size
		end
	end
end

fn append_hpack_huffman_symbol(decoded: ByteChunk, symbol: Int, block: ByteChunk, offset: Int) -> Result<ByteChunk, HpackFixtureFailure>
	match byte_write_u8_be(symbol)
		Ok(symbol_chunk) => Ok(byte_append(decoded, symbol_chunk))
		Err(_) => unsupported_byte_chunk(block, offset)
	end
end

fn decode_hpack_huffman_done(decoded: ByteChunk, code: Int, length: Int, block: ByteChunk, offset: Int) -> Result<HpackStringLiteral, HpackFixtureFailure>
	match hpack_huffman_padding_valid(code, length)
		false => unsupported_string_literal(block, offset)
		true => match byte_chunk_to_visible_ascii_string(decoded)
			Ok(value) => Ok(HpackStringLiteral(value, hpack_huffman_decoded_wire_size(value, byte_count_to_int(byte_chunk_count(decoded)))))
			Err(_) => unsupported_string_literal(block, offset)
		end
	end
end

fn decode_hpack_huffman_bit(block: ByteChunk, bit_index: Int, total_bits: Int, decoded: ByteChunk, code: Int, length: Int, offset: Int) -> Result<HpackStringLiteral, HpackFixtureFailure>
	let source_byte: Int = byte_at_or_missing(block, 2 + bit_index / 8)
	let bit: Int = byte_bit(source_byte, bit_index - (bit_index / 8) * 8)
	let next_code: Int = code * 2 + bit
	let next_length: Int = length + 1
	match hpack_static_huffman_symbol(next_code, next_length)
		Some(symbol) => match append_hpack_huffman_symbol(decoded, symbol, block, offset)
			Ok(next_decoded) => decode_hpack_huffman_bits(block, bit_index + 1, total_bits, next_decoded, 0, 0, offset)
			Err(failure) => Err(failure)
		end
		None => match next_length > 30
			true => unsupported_string_literal(block, offset)
			false => decode_hpack_huffman_bits(block, bit_index + 1, total_bits, decoded, next_code, next_length, offset)
		end
	end
end

fn decode_hpack_huffman_bits(block: ByteChunk, bit_index: Int, total_bits: Int, decoded: ByteChunk, code: Int, length: Int, offset: Int) -> Result<HpackStringLiteral, HpackFixtureFailure>
	match bit_index == total_bits
		true => decode_hpack_huffman_done(decoded, code, length, block, offset)
		false => decode_hpack_huffman_bit(block, bit_index, total_bits, decoded, code, length, offset)
	end
end

fn decode_hpack_huffman_literal_value(block: ByteChunk, encoded_count: Int, offset: Int) -> Result<HpackStringLiteral, HpackFixtureFailure>
	match encoded_count <= 127
		true => decode_hpack_huffman_bits(block, 0, encoded_count * 8, byte_chunk([]), 0, 0, offset)
		false => unsupported_string_literal(block, offset)
	end
end

fn decode_hpack_string_literal_value(block: ByteChunk, value_count: Int, offset: Int) -> Result<HpackStringLiteral, HpackFixtureFailure>
	match value_count >= 128
		true => decode_hpack_huffman_literal_value(block, value_count - 128, offset)
		false => match value_count > 0 and value_count < 128 and value_count <= 12
			true => no_huffman_literal_raw_value(block, value_count, offset)
			false => unsupported_string_literal(block, offset)
		end
	end
end

fn supported_literal_static_name(index: Int) -> Bool
	index == 1 or index == 2 or index == 4 or index == 6
end

fn supported_no_huffman_literal_static_name(index: Int) -> Bool
	supported_literal_static_name(index) or index == 8
end

fn literal_static_name(index: Int) -> String
	match index == 1
		true => ":authority"
		false => match index == 2
			true => ":method"
			false => match index == 4
				true => ":path"
				false => match index == 6
					true => ":scheme"
					false => ":status"
				end
			end
		end
	end
end

fn no_huffman_literal_raw_value(block: ByteChunk, value_count: Int, offset: Int) -> Result<HpackStringLiteral, HpackFixtureFailure>
	match byte_count(2)
		Ok(prefix_count) => match byte_drop(block, prefix_count)
			Ok(value_suffix) => match byte_count(value_count)
				Ok(decoded_value_count) => match byte_take(value_suffix, decoded_value_count)
					Ok(value_bytes) => match byte_chunk_to_visible_ascii_string(value_bytes)
						Ok(value) => Ok(HpackStringLiteral(value, value_count + 2))
						Err(_) => unsupported_string_literal(block, offset)
					end
					Err(_) => unsupported_string_literal(block, offset)
				end
				Err(_) => unsupported_string_literal(block, offset)
			end
			Err(_) => unsupported_string_literal(block, offset)
		end
		Err(_) => unsupported_string_literal(block, offset)
	end
end

fn decode_literal_without_indexing_header_block(first_byte: Int, observed_size: Int, state: HpackFixtureState, block: ByteChunk, offset: Int) -> Result<HpackDecodeTransition, HpackFixtureFailure>
	let value_count: Int = byte_at_or_missing(block, 1)
	match supported_no_huffman_literal_static_name(first_byte) and observed_size >= 2 and observed_size == low_seven_bits(value_count) + 2
		true => match decode_hpack_string_literal_value(block, value_count, offset)
			Ok(literal) => decoded_literal_without_indexing(literal_static_name(first_byte), string_literal_value(literal), string_literal_wire_size(literal), state)
			Err(failure) => Err(failure)
		end
		false => unsupported(block, offset)
	end
end

fn decode_literal_with_indexing_header_block(first_byte: Int, observed_size: Int, state: HpackFixtureState, block: ByteChunk, offset: Int) -> Result<HpackDecodeTransition, HpackFixtureFailure>
	let name_index: Int = first_byte - 64
	let value_count: Int = byte_at_or_missing(block, 1)
	match supported_no_huffman_literal_static_name(name_index) and observed_size >= 2 and observed_size == low_seven_bits(value_count) + 2
		true => match decode_hpack_string_literal_value(block, value_count, offset)
			Ok(literal) => decoded_literal_with_indexing(literal_static_name(name_index), string_literal_value(literal), string_literal_wire_size(literal), state)
			Err(failure) => Err(failure)
		end
		false => unsupported(block, offset)
	end
end

