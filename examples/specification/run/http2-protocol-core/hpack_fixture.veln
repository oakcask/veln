				false => decode_raw_name_literal_header_block(LiteralWithIndexing, observed_size, state, block, offset)
			end
			54 => match observed_size == 2
				true => decoded_response_headers_missing_status(state)
				false => unsupported(block, offset)
			end
			55 => match observed_size == 4
				true => decoded_response_headers_duplicate_status(state)
				false => unsupported(block, offset)
			end
			56 => match observed_size == 4
				true => decoded_response_headers_with_method(state)
				false => unsupported(block, offset)
