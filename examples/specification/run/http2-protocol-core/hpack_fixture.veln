fn encoded_hex_or_failure(hex: String, headers: HpackHeaderList, offset: Int) -> Result<ByteChunk, HpackFixtureFailure>
	match byte_chunk_from_hex(hex)
		Ok(chunk) => Ok(chunk)
		Err(_) => unsupported_header_list_encoding(headers, offset)
	end
end

fn unsupported_header_list_preview(headers: HpackHeaderList) -> ByteChunk
	match headers
		HpackHeaderList(HpackHeader(name, _), _, _) => match byte_chunk_from_visible_ascii_string(name)
			Ok(preview) => preview
			Err(_) => byte_chunk([])
		end
	end
end

fn unsupported_header_list_encoding(headers: HpackHeaderList, offset: Int) -> Result<ByteChunk, HpackFixtureFailure>
	let preview: ByteChunk = unsupported_header_list_preview(headers)
	Err(UnsupportedHeaderBlock(offset, byte_count_to_int(byte_chunk_count(preview)), byte_at_or_missing(preview, 0), "fixture header list encoding", "hpack_fixture", preview))
end

fn outbound_dynamic_name_literal_miss(headers: HpackHeaderList, state: HpackFixtureState, offset: Int) -> Result<HpackEncodeTransition, HpackFixtureFailure>
	let preview: ByteChunk = unsupported_header_list_preview(headers)
	match state
		HpackFixtureState(_, _, dynamic_entry) => match dynamic_entry_count(dynamic_entry) == 0
			true => Err(DynamicNameContinuationMissing(offset, byte_count_to_int(byte_chunk_count(preview)), byte_at_or_missing(preview, 0), 0, 0, "fixture outbound dynamic-name indexed literal", "hpack_fixture", preview))
			false => Err(DynamicNameContinuationOutOfRange(offset, byte_count_to_int(byte_chunk_count(preview)), byte_at_or_missing(preview, 0), 0, dynamic_entry_count(dynamic_entry), "fixture outbound dynamic-name indexed literal", "hpack_fixture", preview))
		end
	end
end

fn outbound_table_size_update_exceeded(offset: Int, table_size: Int, allowed_size: Int) -> Result<HpackEncodeTransition, HpackFixtureFailure>
	let preview: ByteChunk = byte_chunk([])
	Err(OutboundTableSizeUpdateExceeded(offset, table_size, allowed_size, "fixture outbound table-size update", "hpack_fixture", preview))
end

fn encode_static_status_header(value: String, headers: HpackHeaderList, offset: Int) -> Result<ByteChunk, HpackFixtureFailure>
	match value
		"200" => encoded_hex_or_failure("88", headers, offset)
		"204" => encoded_hex_or_failure("89", headers, offset)
		"206" => encoded_hex_or_failure("8a", headers, offset)
		"304" => encoded_hex_or_failure("8b", headers, offset)
		"400" => encoded_hex_or_failure("8c", headers, offset)
		"404" => encoded_hex_or_failure("8d", headers, offset)
		"500" => encoded_hex_or_failure("8e", headers, offset)
		_ => unsupported_header_list_encoding(headers, offset)
	end
end

fn encode_static_empty_header(name: String, headers: HpackHeaderList, offset: Int) -> Result<ByteChunk, HpackFixtureFailure>
	match name
		"accept-charset" => encoded_hex_or_failure("8f", headers, offset)
		"accept-language" => encoded_hex_or_failure("91", headers, offset)
		"accept-ranges" => encoded_hex_or_failure("92", headers, offset)
		"accept" => encoded_hex_or_failure("93", headers, offset)
		"access-control-allow-origin" => encoded_hex_or_failure("94", headers, offset)
		"age" => encoded_hex_or_failure("95", headers, offset)
		"allow" => encoded_hex_or_failure("96", headers, offset)
		"authorization" => encoded_hex_or_failure("97", headers, offset)
		"cache-control" => encoded_hex_or_failure("98", headers, offset)
		"content-disposition" => encoded_hex_or_failure("99", headers, offset)
		"content-encoding" => encoded_hex_or_failure("9a", headers, offset)
		"content-language" => encoded_hex_or_failure("9b", headers, offset)
		"content-length" => encoded_hex_or_failure("9c", headers, offset)
		"content-location" => encoded_hex_or_failure("9d", headers, offset)
		"content-range" => encoded_hex_or_failure("9e", headers, offset)
		"content-type" => encoded_hex_or_failure("9f", headers, offset)
		"cookie" => encoded_hex_or_failure("a0", headers, offset)
		"date" => encoded_hex_or_failure("a1", headers, offset)
		"etag" => encoded_hex_or_failure("a2", headers, offset)
		"expect" => encoded_hex_or_failure("a3", headers, offset)
		"expires" => encoded_hex_or_failure("a4", headers, offset)
		"from" => encoded_hex_or_failure("a5", headers, offset)
		"host" => encoded_hex_or_failure("a6", headers, offset)
		"if-match" => encoded_hex_or_failure("a7", headers, offset)
		"if-modified-since" => encoded_hex_or_failure("a8", headers, offset)
		"if-none-match" => encoded_hex_or_failure("a9", headers, offset)
		"if-range" => encoded_hex_or_failure("aa", headers, offset)
		"if-unmodified-since" => encoded_hex_or_failure("ab", headers, offset)
		"last-modified" => encoded_hex_or_failure("ac", headers, offset)
		"link" => encoded_hex_or_failure("ad", headers, offset)
		"location" => encoded_hex_or_failure("ae", headers, offset)
		"max-forwards" => encoded_hex_or_failure("af", headers, offset)
		"proxy-authenticate" => encoded_hex_or_failure("b0", headers, offset)
		"proxy-authorization" => encoded_hex_or_failure("b1", headers, offset)
		"range" => encoded_hex_or_failure("b2", headers, offset)
		"referer" => encoded_hex_or_failure("b3", headers, offset)
		"refresh" => encoded_hex_or_failure("b4", headers, offset)
		"retry-after" => encoded_hex_or_failure("b5", headers, offset)
		"server" => encoded_hex_or_failure("b6", headers, offset)
		"set-cookie" => encoded_hex_or_failure("b7", headers, offset)
		"strict-transport-security" => encoded_hex_or_failure("b8", headers, offset)
		"transfer-encoding" => encoded_hex_or_failure("b9", headers, offset)
		"user-agent" => encoded_hex_or_failure("ba", headers, offset)
		"vary" => encoded_hex_or_failure("bb", headers, offset)
		"via" => encoded_hex_or_failure("bc", headers, offset)
		"www-authenticate" => encoded_hex_or_failure("bd", headers, offset)
		_ => unsupported_header_list_encoding(headers, offset)
	end
end

fn encode_static_indexed_header(name: String, value: String, headers: HpackHeaderList, offset: Int) -> Result<ByteChunk, HpackFixtureFailure>
	match name == ":authority" and value == ""
		true => encoded_hex_or_failure("81", headers, offset)
		false => match name == ":method" and value == "GET"
			true => encoded_hex_or_failure("82", headers, offset)
			false => match name == ":method" and value == "POST"
				true => encoded_hex_or_failure("83", headers, offset)
				false => match name == ":path" and value == "/"
					true => encoded_hex_or_failure("84", headers, offset)
					false => match name == ":path" and value == "/index.html"
						true => encoded_hex_or_failure("85", headers, offset)
						false => match name == ":scheme" and value == "http"
							true => encoded_hex_or_failure("86", headers, offset)
							false => match name == ":scheme" and value == "https"
								true => encoded_hex_or_failure("87", headers, offset)
								false => match name == ":status"
									true => encode_static_status_header(value, headers, offset)
									false => match value == "gzip, deflate" and name == "accept-encoding"
										true => encoded_hex_or_failure("90", headers, offset)
										false => match value == ""
											true => encode_static_empty_header(name, headers, offset)
											false => unsupported_header_list_encoding(headers, offset)
										end
									end
								end
							end
						end
					end
				end
			end
		end
	end
end

fn literal_static_name_index(name: String) -> Int
	match name
		":authority" => 1
		":method" => 2
		":path" => 4
		":scheme" => 6
		":status" => 8
		_ => -1
	end
end

fn ordinary_header_name_token_byte(value: Int) -> Bool
	match value >= 97 and value <= 122
		true => true
		false => match value >= 48 and value <= 57
			true => true
			false => match value == 33
				true => true
				false => match value >= 35 and value <= 39
					true => true
					false => match value == 42 or value == 43 or value == 45 or value == 46
						true => true
						false => match value == 94 or value == 95 or value == 96 or value == 124 or value == 126
							true => true
							false => false
						end
					end
				end
			end
		end
	end
end

fn ordinary_header_name_token_bytes(bytes: ByteChunk, index: Int, count: Int) -> Bool
	match index >= count
		true => true
		false => match ordinary_header_name_token_byte(byte_at_or_missing(bytes, index))
			true => ordinary_header_name_token_bytes(bytes, index + 1, count)
			false => false
		end
	end
end

fn ordinary_header_name_is_connection_specific(name: String) -> Bool
	match name
		"connection" => true
		"keep-alive" => true
		"proxy-connection" => true
		"transfer-encoding" => true
		"upgrade" => true
		_ => false
	end
end

fn accepted_ordinary_header_name_bytes(name: String) -> Result<ByteChunk, String>
	match ordinary_header_name_is_connection_specific(name)
		true => Err("connection-specific")
		false => match byte_chunk_from_visible_ascii_string(name)
			Ok(bytes) => match byte_count_to_int(byte_chunk_count(bytes)) > 0 and ordinary_header_name_token_bytes(bytes, 0, byte_count_to_int(byte_chunk_count(bytes)))
				true => Ok(bytes)
				false => Err("invalid-token")
			end
			Err(error) => Err(error)
		end
	end
end

fn encode_new_name_literal_header_with_prefix(name: String, value: String, prefix_value: Int, headers: HpackHeaderList, offset: Int) -> Result<ByteChunk, HpackFixtureFailure>
	match accepted_ordinary_header_name_bytes(name)
		Ok(_) => match byte_write_u8_be(prefix_value)
			Ok(prefix) => match encode_hpack_raw_string_literal(name, offset)
				Ok(encoded_name) => match encode_hpack_raw_string_literal(value, offset)
					Ok(encoded_value) => Ok(byte_append(byte_append(prefix, encoded_name), encoded_value))
					Err(failure) => Err(failure)
				end
				Err(failure) => Err(failure)
			end
			Err(_) => unsupported_header_list_encoding(headers, offset)
		end
		Err(_) => unsupported_header_list_encoding(headers, offset)
	end
end

fn encode_literal_header_with_prefix(name: String, value: String, prefix_offset: Int, headers: HpackHeaderList, offset: Int) -> Result<ByteChunk, HpackFixtureFailure>
	let index: Int = literal_static_name_index(name)
	match index < 0
		true => match prefix_offset == 0 or prefix_offset == 16
			true => encode_new_name_literal_header_with_prefix(name, value, prefix_offset, headers, offset)
			false => unsupported_header_list_encoding(headers, offset)
		end
		false => match byte_write_u8_be(prefix_offset + index)
			Ok(prefix) => match encode_hpack_raw_string_literal(value, offset)
				Ok(encoded_value) => Ok(byte_append(prefix, encoded_value))
				Err(failure) => Err(failure)
			end
			Err(_) => unsupported_header_list_encoding(headers, offset)
		end
	end
end

fn encode_huffman_literal_header_with_prefix(name: String, value: String, prefix_offset: Int, headers: HpackHeaderList, offset: Int) -> Result<ByteChunk, HpackFixtureFailure>
	let index: Int = literal_static_name_index(name)
	match index < 0
		true => unsupported_header_list_encoding(headers, offset)
		false => match byte_write_u8_be(prefix_offset + index)
			Ok(prefix) => match encode_hpack_huffman_string_literal(value, offset)
				Ok(encoded_value) => Ok(byte_append(prefix, encoded_value))
				Err(failure) => Err(failure)
			end
			Err(_) => unsupported_header_list_encoding(headers, offset)
		end
	end
end

fn encode_request_headers(value: String, headers: HpackHeaderList, offset: Int) -> Result<ByteChunk, HpackFixtureFailure>
	match headers
		HpackHeaderList(HpackHeader(":scheme", "http"), HpackHeader(":request", "method,path"), _) => encoded_hex_or_failure("5b5c5d5e", headers, offset)
		HpackHeaderList(HpackHeader(":scheme", "https"), HpackHeader(":request", "method,path"), _) => encoded_hex_or_failure("5c5d5e5f", headers, offset)
		_ => match value
			"scheme,path" => encoded_hex_or_failure("303132", headers, offset)
			"method,scheme,path" => encoded_hex_or_failure("32333435", headers, offset)
			"scheme,path,content-length:5" => encoded_hex_or_failure("4f505152", headers, offset)
			_ => unsupported_header_list_encoding(headers, offset)
		end
	end
end

fn encode_response_headers(value: String, headers: HpackHeaderList, offset: Int) -> Result<ByteChunk, HpackFixtureFailure>
	match value
		"ok" => encoded_hex_or_failure("353637", headers, offset)
		"ok,server" => encoded_hex_or_failure("40414243", headers, offset)
		"status" => encoded_hex_or_failure("38393a3b", headers, offset)
		"ok,content-length:5" => encoded_hex_or_failure("5758595a", headers, offset)
		_ => unsupported_header_list_encoding(headers, offset)
	end
end

fn encode_response_error_headers(value: String, headers: HpackHeaderList, offset: Int) -> Result<ByteChunk, HpackFixtureFailure>
	match value
		"ok,Server" => encoded_hex_or_failure("45464748", headers, offset)
		"ok,bad header" => encoded_hex_or_failure("4748494a", headers, offset)
		_ => unsupported_header_list_encoding(headers, offset)
	end
end

pub fn encode_header_list(headers: HpackHeaderList, offset: Int) -> Result<ByteChunk, HpackFixtureFailure>
	match encode_header_list_with_state(headers, initial_encode_state(), offset)
		Ok(transition) => Ok(encode_transition_bytes(transition))
		Err(failure) => Err(failure)
	end
end

pub fn encode_header_list_with_state(headers: HpackHeaderList, state: HpackFixtureState, offset: Int) -> Result<HpackEncodeTransition, HpackFixtureFailure>
	match header_list_requires_literal_encoding(headers)
		true => encode_non_dynamic_header_list(headers, state, offset)
		false => match outbound_dynamic_name_literal_header_list(headers)
			true => encode_dynamic_name_literal_header_list(headers, state, offset)
			false => encode_header_list_with_dynamic_index_lookup(headers, state, offset)
		end
	end
end

fn encode_header_list_with_dynamic_index_lookup(headers: HpackHeaderList, state: HpackFixtureState, offset: Int) -> Result<HpackEncodeTransition, HpackFixtureFailure>
	let dynamic_index: Int = matching_dynamic_index(headers, state)
	match dynamic_index < 0
		true => encode_non_dynamic_header_list(headers, state, offset)
		false => encode_dynamic_indexed_header_list(dynamic_index, headers, state, offset)
	end
end

pub fn encode_table_size_update_with_state(table_size: Int, peer_advertised_limit: Int, state: HpackFixtureState, offset: Int) -> Result<HpackEncodeTransition, HpackFixtureFailure>
	match table_size > peer_advertised_limit
		true => outbound_table_size_update_exceeded(offset, table_size, peer_advertised_limit)
		false => encode_valid_table_size_update_with_state(table_size, state, offset)
	end
end

fn encode_valid_table_size_update_with_state(table_size: Int, state: HpackFixtureState, offset: Int) -> Result<HpackEncodeTransition, HpackFixtureFailure>
	match table_size < 31
		true => encode_table_size_update_prefix_byte(32 + table_size, table_size, state, offset)
		false => match byte_write_u8_be(63)
			Ok(prefix) => match encode_hpack_integer_tail(table_size - 31, offset)
				Ok(tail) => Ok(HpackEncodeTransition(byte_append(prefix, tail), state_with_table_size(state, table_size)))
				Err(failure) => Err(failure)
			end
			Err(_) => outbound_table_size_update_exceeded(offset, table_size, table_size)
		end
	end
end

fn encode_table_size_update_prefix_byte(value: Int, table_size: Int, state: HpackFixtureState, offset: Int) -> Result<HpackEncodeTransition, HpackFixtureFailure>
	match byte_write_u8_be(value)
		Ok(encoded) => Ok(HpackEncodeTransition(encoded, state_with_table_size(state, table_size)))
		Err(_) => outbound_table_size_update_exceeded(offset, table_size, table_size)
	end
end

fn encode_hpack_integer_tail(remaining: Int, offset: Int) -> Result<ByteChunk, HpackFixtureFailure>
	match remaining < 128
		true => encode_hpack_integer_tail_byte(remaining, offset)
		false => match encode_hpack_integer_tail_byte((remaining - (remaining / 128) * 128) + 128, offset)
			Ok(current) => match encode_hpack_integer_tail(remaining / 128, offset)
				Ok(next) => Ok(byte_append(current, next))
				Err(failure) => Err(failure)
			end
			Err(failure) => Err(failure)
		end
	end
end

fn encode_hpack_integer_tail_byte(value: Int, offset: Int) -> Result<ByteChunk, HpackFixtureFailure>
	match byte_write_u8_be(value)
		Ok(encoded) => Ok(encoded)
		Err(_) => Err(UnsupportedHeaderBlock(offset, 0, -1, "fixture HPACK integer encoding", "hpack_fixture", byte_chunk([])))
	end
end

fn encode_hpack_integer_with_prefix(value: Int, prefix_max: Int, prefix_base: Int, offset: Int) -> Result<ByteChunk, HpackFixtureFailure>
	match value < prefix_max
		true => match byte_write_u8_be(prefix_base + value)
			Ok(encoded) => Ok(encoded)
			Err(_) => Err(UnsupportedHeaderBlock(offset, 0, -1, "fixture HPACK integer encoding", "hpack_fixture", byte_chunk([])))
		end
		false => match byte_write_u8_be(prefix_base + prefix_max)
			Ok(prefix) => match encode_hpack_integer_tail(value - prefix_max, offset)
				Ok(tail) => Ok(byte_append(prefix, tail))
				Err(failure) => Err(failure)
			end
			Err(_) => Err(UnsupportedHeaderBlock(offset, 0, -1, "fixture HPACK integer encoding", "hpack_fixture", byte_chunk([])))
		end
	end
end

fn encode_non_dynamic_header_list(headers: HpackHeaderList, state: HpackFixtureState, offset: Int) -> Result<HpackEncodeTransition, HpackFixtureFailure>
	match headers
		HpackHeaderList(HpackHeader(name, value), HpackHeader(":fixture", "static-indexed"), _) => encode_header_list_transition(encode_static_indexed_header(name, value, headers, offset), next_state(state))
		HpackHeaderList(HpackHeader(name, value), HpackHeader(":fixture", "literal-without-indexing"), _) => encode_header_list_transition(encode_literal_header_with_prefix(name, value, 0, headers, offset), next_state(state))
		HpackHeaderList(HpackHeader(name, value), HpackHeader(":fixture", "literal-with-indexing"), _) => encode_header_list_transition(encode_literal_header_with_prefix(name, value, 64, headers, offset), state_with_dynamic_entry(state, name, value))
		HpackHeaderList(HpackHeader(name, value), HpackHeader(":fixture", "literal-never-indexed"), _) => encode_header_list_transition(encode_literal_header_with_prefix(name, value, 16, headers, offset), next_state(state))
		HpackHeaderList(HpackHeader(name, value), HpackHeader(":fixture", "literal-without-indexing-huffman"), _) => encode_header_list_transition(encode_huffman_literal_header_with_prefix(name, value, 0, headers, offset), next_state(state))
		HpackHeaderList(HpackHeader(name, value), HpackHeader(":fixture", "literal-with-indexing-huffman"), _) => encode_header_list_transition(encode_huffman_literal_header_with_prefix(name, value, 64, headers, offset), state_with_dynamic_entry(state, name, value))
		HpackHeaderList(_, HpackHeader(":request", marker), _) => encode_header_list_transition(encode_request_headers(marker, headers, offset), next_state(state))
		HpackHeaderList(_, HpackHeader(":response", marker), _) => encode_header_list_transition(encode_response_headers(marker, headers, offset), next_state(state))
		HpackHeaderList(HpackHeader(":status", _), HpackHeader(":response-error", marker), _) => encode_header_list_transition(encode_response_error_headers(marker, headers, offset), next_state(state))
		_ => encode_header_list_transition(unsupported_header_list_encoding(headers, offset), state)
	end
end

fn encode_dynamic_name_literal_header_list(headers: HpackHeaderList, state: HpackFixtureState, offset: Int) -> Result<HpackEncodeTransition, HpackFixtureFailure>
	match headers
		HpackHeaderList(HpackHeader(name, value), HpackHeader(":fixture", "literal-dynamic-name-with-indexing"), _) => match matching_dynamic_name_index(state, name) < 0
			true => outbound_dynamic_name_literal_miss(headers, state, offset)
			false => encode_header_list_transition(encode_literal_with_dynamic_name(value, matching_dynamic_name_index(state, name), 63, 64, headers, offset), state_with_dynamic_entry(state, name, value))
		end
		_ => encode_header_list_transition(unsupported_header_list_encoding(headers, offset), state)
	end
end

fn encode_literal_with_dynamic_name(value: String, dynamic_name_index: Int, prefix_max: Int, prefix_base: Int, headers: HpackHeaderList, offset: Int) -> Result<ByteChunk, HpackFixtureFailure>
	let hpack_name_index: Int = dynamic_name_index + 62
	match encode_hpack_integer_with_prefix(hpack_name_index, prefix_max, prefix_base, offset)
		Ok(prefix) => match encode_hpack_raw_string_literal(value, offset)
			Ok(encoded_value) => Ok(byte_append(prefix, encoded_value))
			Err(failure) => Err(failure)
		end
		Err(_) => unsupported_header_list_encoding(headers, offset)
	end
end

fn encode_header_list_transition(encoded: Result<ByteChunk, HpackFixtureFailure>, state: HpackFixtureState) -> Result<HpackEncodeTransition, HpackFixtureFailure>
	match encoded
		Ok(bytes) => Ok(HpackEncodeTransition(bytes, state))
		Err(failure) => Err(failure)
	end
end

fn encode_dynamic_indexed_header_list(dynamic_index: Int, headers: HpackHeaderList, state: HpackFixtureState, offset: Int) -> Result<HpackEncodeTransition, HpackFixtureFailure>
	match byte_write_u8_be(190 + dynamic_index)
		Ok(encoded) => Ok(HpackEncodeTransition(encoded, next_state(state)))
		Err(_) => encode_header_list_transition(unsupported_header_list_encoding(headers, offset), state)
	end
end

fn outbound_dynamic_name_literal_header_list(headers: HpackHeaderList) -> Bool
	match headers
		HpackHeaderList(_, HpackHeader(":fixture", "literal-dynamic-name-with-indexing"), _) => true
		_ => false
	end
end

fn header_list_requires_literal_encoding(headers: HpackHeaderList) -> Bool
	match headers
		HpackHeaderList(_, HpackHeader(":fixture", "literal-never-indexed"), _) => true
		_ => false
	end
end

fn matching_dynamic_index(headers: HpackHeaderList, state: HpackFixtureState) -> Int
	match headers
		HpackHeaderList(HpackHeader(name, value), _, _) => match state
			HpackFixtureState(_, _, dynamic_entry) => matching_dynamic_entry_index(dynamic_entry, name, value, 0)
		end
	end
end

fn matching_dynamic_name_index(state: HpackFixtureState, name: String) -> Int
	match state
		HpackFixtureState(_, _, dynamic_entry) => matching_dynamic_entry_name_index(dynamic_entry, name, 0)
	end
end

fn matching_dynamic_entry_name_index(dynamic_entry: HpackDynamicEntry, name: String, index: Int) -> Int
	match dynamic_entry
		NoDynamicEntry => -1
		DynamicEntry(entry_name, _, older) => match entry_name == name
			true => index
			false => matching_dynamic_entry_name_index(older, name, index + 1)
		end
	end
end

fn matching_dynamic_entry_index(dynamic_entry: HpackDynamicEntry, name: String, value: String, index: Int) -> Int
	match dynamic_entry
		NoDynamicEntry => -1
		DynamicEntry(entry_name, entry_value, older) => match entry_name == name and entry_value == value
			true => index
			false => matching_dynamic_entry_index(older, name, value, index + 1)
		end
	end
end

pub fn encode_transition_bytes(transition: HpackEncodeTransition) -> ByteChunk
	match transition
		HpackEncodeTransition(encoded, _) => encoded
	end
end

pub fn encode_transition_state(transition: HpackEncodeTransition) -> HpackFixtureState
	match transition
		HpackEncodeTransition(_, state) => state
	end
end

fn string_literal_value(literal: HpackStringLiteral) -> String
	match literal
		HpackStringLiteral(value, _) => value
	end
end

fn string_literal_wire_size(literal: HpackStringLiteral) -> Int
	match literal
		HpackStringLiteral(_, wire_size) => wire_size
	end
end

fn pow2(value: Int) -> Int
	match value
		0 => 1
		1 => 2
		2 => 4
		3 => 8
		4 => 16
		5 => 32
		6 => 64
		7 => 128
		_ => 256
	end
end

fn byte_bit(byte: Int, bit_index: Int) -> Int
	let divisor: Int = pow2(7 - bit_index)
	byte / divisor - (byte / (divisor * 2)) * 2
end

