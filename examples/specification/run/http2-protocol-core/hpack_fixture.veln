			126 => decode_literal_with_dynamic_name_indexing_header_block(first_byte, observed_size, state, block, offset)
			127 => decode_literal_with_dynamic_name_indexing_header_block(first_byte, observed_size, state, block, offset)
			16 => match observed_size == 3
				true => decoded("single-headers", 8, state)
				false => unsupported(block, offset)
			end
			170 => match observed_size == 9
				true => decoded("continuation", 9, state)
				false => decode_static_indexed_header_block(first_byte, observed_size, state, block, offset)
