									end
								end
							end
						end
					end
				end
			end
		end
	end
end

fn encode_static_indexed_header(name: String, value: String, headers: HpackHeaderList, offset: Int) -> Result<ByteChunk, HpackFixtureFailure>
	match name == ":authority" and value == ""
		true => encoded_hex_or_failure("81", headers, offset)
		false => match name == ":method" and value == "GET"
			true => encoded_hex_or_failure("82", headers, offset)
			false => match name == ":method" and value == "POST"
				true => encoded_hex_or_failure("83", headers, offset)
				false => match name == ":path" and value == "/"
					true => encoded_hex_or_failure("84", headers, offset)
					false => match name == ":path" and value == "/index.html"
						true => encoded_hex_or_failure("85", headers, offset)
						false => match name == ":scheme" and value == "http"
							true => encoded_hex_or_failure("86", headers, offset)
							false => match name == ":scheme" and value == "https"
								true => encoded_hex_or_failure("87", headers, offset)
								false => match name == ":status"
									true => encode_static_status_header(value, headers, offset)
									false => match value == "gzip, deflate" and name == "accept-encoding"
										true => encoded_hex_or_failure("90", headers, offset)
										false => match value == ""
											true => encode_static_empty_header(name, headers, offset)
											false => unsupported_header_list_encoding(headers, offset)
										end
									end
								end
							end
						end
					end
				end
			end
		end
	end
end

fn literal_static_name_index(name: String) -> Int
	match name == ":authority"
		true => 1
		false => match name == ":method"
			true => 2
			false => match name == ":path"
				true => 4
				false => match name == ":scheme"
					true => 6
					false => match name == ":status"
						true => 8
						false => -1
					end
				end
			end
		end
	end
end

fn encode_literal_header_with_prefix(name: String, value: String, prefix_offset: Int, headers: HpackHeaderList, offset: Int) -> Result<ByteChunk, HpackFixtureFailure>
	let index: Int = literal_static_name_index(name)
	match index < 0
		true => unsupported_header_list_encoding(headers, offset)
		false => match byte_write_u8_be(prefix_offset + index)
			Ok(prefix) => match encode_hpack_raw_string_literal(value, offset)
				Ok(encoded_value) => Ok(byte_append(prefix, encoded_value))
				Err(failure) => Err(failure)
			end
			Err(_) => unsupported_header_list_encoding(headers, offset)
		end
	end
end

fn encode_huffman_literal_header_with_prefix(name: String, value: String, prefix_offset: Int, headers: HpackHeaderList, offset: Int) -> Result<ByteChunk, HpackFixtureFailure>
	let index: Int = literal_static_name_index(name)
	match index < 0
		true => unsupported_header_list_encoding(headers, offset)
		false => match byte_write_u8_be(prefix_offset + index)
			Ok(prefix) => match encode_hpack_huffman_string_literal(value, offset)
				Ok(encoded_value) => Ok(byte_append(prefix, encoded_value))
				Err(failure) => Err(failure)
			end
			Err(_) => unsupported_header_list_encoding(headers, offset)
		end
	end
end

fn encode_request_headers(value: String, headers: HpackHeaderList, offset: Int) -> Result<ByteChunk, HpackFixtureFailure>
	match value == "scheme,path"
		true => encoded_hex_or_failure("303132", headers, offset)
		false => match value == "method,scheme,path"
			true => encoded_hex_or_failure("32333435", headers, offset)
			false => unsupported_header_list_encoding(headers, offset)
		end
	end
end

fn encode_response_headers(value: String, headers: HpackHeaderList, offset: Int) -> Result<ByteChunk, HpackFixtureFailure>
	match value == "ok"
		true => encoded_hex_or_failure("353637", headers, offset)
		false => match value == "ok,server"
			true => encoded_hex_or_failure("40414243", headers, offset)
			false => match value == "status"
				true => encoded_hex_or_failure("38393a3b", headers, offset)
				false => unsupported_header_list_encoding(headers, offset)
			end
		end
	end
end

fn encode_response_error_headers(value: String, headers: HpackHeaderList, offset: Int) -> Result<ByteChunk, HpackFixtureFailure>
	match value == "ok,Server"
		true => encoded_hex_or_failure("45464748", headers, offset)
		false => match value == "ok,bad header"
			true => encoded_hex_or_failure("4748494a", headers, offset)
			false => unsupported_header_list_encoding(headers, offset)
		end
	end
end

pub fn encode_header_list(headers: HpackHeaderList, offset: Int) -> Result<ByteChunk, HpackFixtureFailure>
	match headers
		HpackHeaderList(HpackHeader(name, value), HpackHeader(":fixture", "static-indexed"), _) => encode_static_indexed_header(name, value, headers, offset)
		HpackHeaderList(HpackHeader(name, value), HpackHeader(":fixture", "literal-without-indexing"), _) => encode_literal_header_with_prefix(name, value, 0, headers, offset)
		HpackHeaderList(HpackHeader(name, value), HpackHeader(":fixture", "literal-with-indexing"), _) => encode_literal_header_with_prefix(name, value, 64, headers, offset)
		HpackHeaderList(HpackHeader(name, value), HpackHeader(":fixture", "literal-without-indexing-huffman"), _) => encode_huffman_literal_header_with_prefix(name, value, 0, headers, offset)
		HpackHeaderList(HpackHeader(name, value), HpackHeader(":fixture", "literal-with-indexing-huffman"), _) => encode_huffman_literal_header_with_prefix(name, value, 64, headers, offset)
		HpackHeaderList(_, HpackHeader(":request", marker), _) => encode_request_headers(marker, headers, offset)
		HpackHeaderList(_, HpackHeader(":response", marker), _) => encode_response_headers(marker, headers, offset)
		HpackHeaderList(HpackHeader(":status", _), HpackHeader(":response-error", marker), _) => encode_response_error_headers(marker, headers, offset)
		_ => unsupported_header_list_encoding(headers, offset)
	end
end

fn string_literal_value(literal: HpackStringLiteral) -> String
	match literal
		HpackStringLiteral(value, _) => value
	end
end

fn string_literal_wire_size(literal: HpackStringLiteral) -> Int
	match literal
		HpackStringLiteral(_, wire_size) => wire_size
	end
end

fn pow2(value: Int) -> Int
	match value
		0 => 1
		1 => 2
		2 => 4
		3 => 8
		4 => 16
		5 => 32
		6 => 64
		7 => 128
		_ => 256
	end
end

fn byte_bit(byte: Int, bit_index: Int) -> Int
	let divisor: Int = pow2(7 - bit_index)
	byte / divisor - (byte / (divisor * 2)) * 2
end

