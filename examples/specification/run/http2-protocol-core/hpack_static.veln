	match index
		1 => Some(hpack_fixture::hpack_header(":authority", ""))
		2 => Some(hpack_fixture::hpack_header(":method", "GET"))
		3 => Some(hpack_fixture::hpack_header(":method", "POST"))
		4 => Some(hpack_fixture::hpack_header(":path", "/"))
