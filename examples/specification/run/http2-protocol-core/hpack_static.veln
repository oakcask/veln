fn hpack_static_table_header_from_indexed_byte(byte: Int) -> Option<HpackHeader>
	hpack_static_table_header(byte - 128)
end

fn hpack_static_index_wire_size(byte: Int) -> Int
	match byte
		129 => 1
		130 => 8
		131 => 9
		132 => 6
		133 => 9
		134 => 8
		135 => 9
		_ => 9
	end
end

fn hpack_static_all_bytes_indexed(block: ByteChunk, index: Int, count: Int) -> Bool
	match index == count
		true => true
		false => match hpack_static_byte_at_or_missing(block, index) >= 128 and hpack_static_byte_at_or_missing(block, index) <= 189
			true => hpack_static_all_bytes_indexed(block, index + 1, count)
			false => false
		end
	end
end

fn hpack_static_all_indexes_supported(block: ByteChunk, index: Int, count: Int) -> Bool
	match index == count
		true => true
		false => match hpack_static_table_header_from_indexed_byte(hpack_static_byte_at_or_missing(block, index))
			Some(_) => hpack_static_all_indexes_supported(block, index + 1, count)
			None => false
		end
	end
end

fn hpack_static_request_marker(method: String, wire_size: Int) -> HpackHeaderList
	hpack_fixture::hpack_header_list(hpack_fixture::hpack_header(":method", method), hpack_fixture::hpack_header(":request", "scheme,path"), wire_size)
end

fn hpack_static_single_header(byte: Int) -> HpackHeaderList
	match hpack_static_table_header_from_indexed_byte(byte)
		Some(header) => hpack_fixture::hpack_header_list(header, hpack_fixture::hpack_header(":fixture", "static-indexed"), hpack_static_index_wire_size(byte))
		None => hpack_fixture::hpack_header_list(hpack_fixture::hpack_header(":fixture", "unsupported-static-index"), hpack_fixture::hpack_header(":fixture", "static-indexed"), 0)
	end
end

fn hpack_static_supported_request_block(first: Int, second: Int, third: Int) -> Bool
	match (first == 130 or first == 131) and (second == 134 or second == 135) and third == 132
		true => true
		false => false
	end
end

fn hpack_static_request_method(byte: Int) -> String
	match byte
		131 => "POST"
		_ => "GET"
	end
end

fn hpack_static_not_static_string(block: ByteChunk, offset: Int) -> Result<String, HpackStaticFailure>
	Err(NotStaticHeaderBlock(offset, hpack_static_observed_size(block), hpack_static_byte_at_or_missing(block, 0), "HPACK static indexed header block", "hpack_static", block))
end

fn hpack_static_literal_without_indexing_name_index(block: ByteChunk) -> Int
	let first_byte: Int = hpack_static_byte_at_or_missing(block, 0)
	match first_byte
		15 => match hpack_static_byte_at_or_missing(block, 1) >= 0 and hpack_static_byte_at_or_missing(block, 1) < 128
			true => 15 + hpack_static_byte_at_or_missing(block, 1)
			false => -1
		end
		_ => match first_byte > 0 and first_byte < 15
			true => first_byte
			false => -1
		end
	end
end

fn hpack_static_literal_without_indexing_value_index(block: ByteChunk) -> Int
	match hpack_static_byte_at_or_missing(block, 0)
		15 => 2
		_ => 1
	end
end

fn hpack_static_literal_with_indexing_name_index(block: ByteChunk) -> Int
	let first_byte: Int = hpack_static_byte_at_or_missing(block, 0)
	match first_byte > 64 and first_byte < 127
		true => first_byte - 64
		false => -1
	end
end

fn hpack_static_literal_never_indexed_name_index(block: ByteChunk) -> Int
	let first_byte: Int = hpack_static_byte_at_or_missing(block, 0)
	match first_byte
		31 => match hpack_static_byte_at_or_missing(block, 1) >= 0 and hpack_static_byte_at_or_missing(block, 1) < 128
			true => 15 + hpack_static_byte_at_or_missing(block, 1)
			false => -1
		end
		_ => match first_byte > 16 and first_byte < 31
			true => first_byte - 16
			false => -1
		end
	end
end

fn hpack_static_literal_never_indexed_value_index(block: ByteChunk) -> Int
	match hpack_static_byte_at_or_missing(block, 0)
		31 => 2
		_ => 1
	end
end

fn hpack_static_supported_literal_name(name_index: Int) -> Option<String>
	match name_index
		1 => Some(":authority")
		4 => Some(":path")
		8 => Some(":status")
		54 => Some("server")
		28 => Some("content-length")
		31 => Some("content-type")
		58 => Some("user-agent")
		_ => None
	end
end

fn hpack_static_supported_literal_indexing_name(name_index: Int) -> Option<String>
	match name_index
		1 => Some(":authority")
		4 => Some(":path")
		8 => Some(":status")
		54 => Some("server")
		31 => Some("content-type")
		58 => Some("user-agent")
		_ => None
	end
end

fn hpack_static_literal_raw_value(block: ByteChunk, count: Int, value_index: Int, offset: Int) -> Result<String, HpackStaticFailure>
	match value_index < count
		true => match hpack_static_byte_at_or_missing(block, value_index) >= 0 and hpack_static_byte_at_or_missing(block, value_index) < 127
			true => match count == value_index + 1 + hpack_static_byte_at_or_missing(block, value_index)
				true => match byte_count(value_index + 1)
					Ok(prefix_count) => match byte_drop(block, prefix_count)
						Ok(value_suffix) => match byte_count(hpack_static_byte_at_or_missing(block, value_index))
							Ok(value_count) => match byte_take(value_suffix, value_count)
								Ok(value_bytes) => match byte_chunk_to_visible_ascii_string(value_bytes)
									Ok(value) => Ok(value)
									Err(_) => hpack_static_not_static_string(block, offset)
								end
								Err(_) => hpack_static_not_static_string(block, offset)
							end
							Err(_) => hpack_static_not_static_string(block, offset)
						end
						Err(_) => hpack_static_not_static_string(block, offset)
					end
					Err(_) => hpack_static_not_static_string(block, offset)
				end
				false => hpack_static_not_static_string(block, offset)
			end
			false => hpack_static_not_static_string(block, offset)
		end
		false => hpack_static_not_static_string(block, offset)
	end
end

fn hpack_static_literal_without_indexing_header(name: String, value: String, wire_size: Int) -> HpackHeaderList
	hpack_fixture::hpack_header_list(hpack_fixture::hpack_header(name, value), hpack_fixture::hpack_header(":fixture", "literal-without-indexing"), wire_size)
end

fn hpack_static_literal_static_name_header(name: String, value: String, marker: String, wire_size: Int) -> HpackHeaderList
	hpack_fixture::hpack_header_list(hpack_fixture::hpack_header(name, value), hpack_fixture::hpack_header(":fixture", marker), wire_size)
end

fn hpack_static_request_content_length_legacy_header(wire_size: Int) -> HpackHeaderList
	hpack_fixture::hpack_header_list(hpack_fixture::hpack_header(":method", "GET"), hpack_fixture::hpack_header(":request", "scheme,path,content-length:5"), wire_size)
end

fn hpack_static_literal_content_length_request_header(value: String, wire_size: Int) -> HpackHeaderList
	match value
		"5" => hpack_static_request_content_length_legacy_header(wire_size)
		_ => hpack_fixture::hpack_header_list(hpack_fixture::hpack_header(":request", "method,scheme,path"), hpack_fixture::hpack_header("content-length", value), wire_size)
	end
end

fn hpack_static_decode_literal_indexing_form(block: ByteChunk, count: Int, offset: Int, name_index: Int, value_index: Int, marker: String) -> Result<HpackHeaderList, HpackStaticFailure>
	match hpack_static_supported_literal_indexing_name(name_index)
		Some(name) => match hpack_static_literal_raw_value(block, count, value_index, offset)
			Ok(value) => Ok(hpack_static_literal_static_name_header(name, value, marker, count))
			Err(failure) => Err(failure)
		end
		None => hpack_static_not_static(block, offset)
	end
end

fn hpack_static_decode_literal_with_indexing_block(block: ByteChunk, count: Int, offset: Int) -> Result<HpackHeaderList, HpackStaticFailure>
	hpack_static_decode_literal_indexing_form(block, count, offset, hpack_static_literal_with_indexing_name_index(block), 1, "literal-with-indexing")
end

fn hpack_static_decode_literal_never_indexed_block(block: ByteChunk, count: Int, offset: Int) -> Result<HpackHeaderList, HpackStaticFailure>
	hpack_static_decode_literal_indexing_form(block, count, offset, hpack_static_literal_never_indexed_name_index(block), hpack_static_literal_never_indexed_value_index(block), "literal-never-indexed")
end

fn hpack_static_decode_literal_without_indexing_block(block: ByteChunk, count: Int, offset: Int) -> Result<HpackHeaderList, HpackStaticFailure>
	match hpack_static_supported_literal_name(hpack_static_literal_without_indexing_name_index(block))
		Some(name) => match hpack_static_literal_raw_value(block, count, hpack_static_literal_without_indexing_value_index(block), offset)
			Ok(value) => Ok(hpack_static_literal_without_indexing_header(name, value, count))
			Err(failure) => Err(failure)
		end
		None => hpack_static_not_static(block, offset)
	end
end

fn hpack_static_decode_static_name_literal_block(block: ByteChunk, count: Int, offset: Int) -> Result<HpackHeaderList, HpackStaticFailure>
	match hpack_static_byte_at_or_missing(block, 0) >= 64 and hpack_static_byte_at_or_missing(block, 0) < 128
		true => hpack_static_decode_literal_with_indexing_block(block, count, offset)
		false => match hpack_static_byte_at_or_missing(block, 0) >= 16 and hpack_static_byte_at_or_missing(block, 0) < 32
			true => hpack_static_decode_literal_never_indexed_block(block, count, offset)
			false => hpack_static_decode_literal_without_indexing_block(block, count, offset)
		end
	end
end

fn hpack_static_literal_tail_value_index(block: ByteChunk, literal_index: Int) -> Int
	match hpack_static_byte_at_or_missing(block, literal_index)
		15 => literal_index + 2
		_ => literal_index + 1
	end
end

fn hpack_static_literal_tail_name_index(block: ByteChunk, literal_index: Int) -> Int
	let first_byte: Int = hpack_static_byte_at_or_missing(block, literal_index)
	match first_byte
		15 => match hpack_static_byte_at_or_missing(block, literal_index + 1) >= 0 and hpack_static_byte_at_or_missing(block, literal_index + 1) < 128
			true => 15 + hpack_static_byte_at_or_missing(block, literal_index + 1)
			false => -1
		end
		_ => match first_byte > 0 and first_byte < 15
			true => first_byte
			false => -1
		end
	end
end

fn hpack_static_decode_request_with_content_length(block: ByteChunk, count: Int, offset: Int) -> Result<HpackHeaderList, HpackStaticFailure>
	match count > 3 and hpack_static_supported_request_block(hpack_static_byte_at_or_missing(block, 0), hpack_static_byte_at_or_missing(block, 1), hpack_static_byte_at_or_missing(block, 2)) and hpack_static_literal_tail_name_index(block, 3) == 28
		true => match hpack_static_literal_raw_value(block, count, hpack_static_literal_tail_value_index(block, 3), offset)
			Ok(value) => Ok(hpack_static_literal_content_length_request_header(value, count))
			Err(failure) => Err(failure)
		end
		false => hpack_static_decode_static_name_literal_block(block, count, offset)
	end
end

fn hpack_static_decode_supported_block(block: ByteChunk, count: Int, offset: Int) -> Result<HpackHeaderList, HpackStaticFailure>
	match hpack_static_all_indexes_supported(block, 0, count)
		false => hpack_static_unsupported_static_index(block, offset)
		true => match count == 1
			true => Ok(hpack_static_single_header(hpack_static_byte_at_or_missing(block, 0)))
			false => match count == 3 and hpack_static_supported_request_block(hpack_static_byte_at_or_missing(block, 0), hpack_static_byte_at_or_missing(block, 1), hpack_static_byte_at_or_missing(block, 2))
				true => Ok(hpack_static_request_marker(hpack_static_request_method(hpack_static_byte_at_or_missing(block, 0)), 9))
				false => hpack_static_not_static(block, offset)
			end
		end
	end
end

pub fn decode_header_block(block: ByteChunk, offset: Int) -> Result<HpackHeaderList, HpackStaticFailure>
	let count: Int = hpack_static_observed_size(block)
	match count
		0 => hpack_static_not_static(block, offset)
		_ => match hpack_static_all_bytes_indexed(block, 0, count)
			false => hpack_static_decode_request_with_content_length(block, count, offset)
			true => hpack_static_decode_supported_block(block, count, offset)
		end
	end
end

pub fn hpack_static_failure_is_not_static(failure: HpackStaticFailure) -> Bool
	match failure
		NotStaticHeaderBlock(_, _, _, _, _, _) => true
		UnsupportedStaticIndex(_, _, _, _, _, _) => false
	end
end

pub fn hpack_static_failure_offset(failure: HpackStaticFailure) -> Int
	match failure
		NotStaticHeaderBlock(offset, _, _, _, _, _) => offset
		UnsupportedStaticIndex(offset, _, _, _, _, _) => offset
	end
end

pub fn hpack_static_failure_observed_size(failure: HpackStaticFailure) -> Int
	match failure
		NotStaticHeaderBlock(_, size, _, _, _, _) => size
		UnsupportedStaticIndex(_, size, _, _, _, _) => size
	end
end

pub fn hpack_static_failure_observed_first_byte(failure: HpackStaticFailure) -> Int
	match failure
		NotStaticHeaderBlock(_, _, first_byte, _, _, _) => first_byte
		UnsupportedStaticIndex(_, _, first_byte, _, _, _) => first_byte
	end
end

pub fn hpack_static_failure_expected_header(failure: HpackStaticFailure) -> String
	match failure
		NotStaticHeaderBlock(_, _, _, expected_header, _, _) => expected_header
		UnsupportedStaticIndex(_, _, _, expected_header, _, _) => expected_header
	end
end

pub fn hpack_static_failure_decoder_module(failure: HpackStaticFailure) -> String
	match failure
		NotStaticHeaderBlock(_, _, _, _, decoder_module, _) => decoder_module
		UnsupportedStaticIndex(_, _, _, _, decoder_module, _) => decoder_module
	end
end

pub fn hpack_static_failure_preview(failure: HpackStaticFailure) -> ByteChunk
	match failure
		NotStaticHeaderBlock(_, _, _, _, _, preview) => preview
		UnsupportedStaticIndex(_, _, _, _, _, preview) => preview
	end
end
