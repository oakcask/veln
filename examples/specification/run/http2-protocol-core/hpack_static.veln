use hpack_fixture

pub type HpackStaticFailure
	NotStaticHeaderBlock(offset: Int, hpack_static_observed_size: Int, observed_first_byte: Int, expected_header: String, decoder_module: String, preview: ByteChunk)
	UnsupportedStaticIndex(offset: Int, hpack_static_observed_size: Int, observed_first_byte: Int, expected_header: String, decoder_module: String, preview: ByteChunk)
end

fn hpack_static_byte_at(block: ByteChunk, index: Int) -> Result<Int, String>
	let view: ByteView = byte_view(block, byte_offset(index)?, byte_count(1)?)?
	byte_read_u8_be(view)
end

fn hpack_static_byte_at_or_missing(block: ByteChunk, index: Int) -> Int
	match hpack_static_byte_at(block, index)
		Ok(value) => value
		Err(_) => -1
	end
end

fn hpack_static_observed_size(block: ByteChunk) -> Int
	byte_count_to_int(byte_chunk_count(block))
end

fn hpack_static_not_static(block: ByteChunk, offset: Int) -> Result<HpackHeaderList, HpackStaticFailure>
	Err(NotStaticHeaderBlock(offset, hpack_static_observed_size(block), hpack_static_byte_at_or_missing(block, 0), "HPACK static indexed header block", "hpack_static", block))
end

fn hpack_static_unsupported_static_index(block: ByteChunk, offset: Int) -> Result<HpackHeaderList, HpackStaticFailure>
	Err(UnsupportedStaticIndex(offset, hpack_static_observed_size(block), hpack_static_byte_at_or_missing(block, 0), "HPACK static indexed header", "hpack_static", block))
end

