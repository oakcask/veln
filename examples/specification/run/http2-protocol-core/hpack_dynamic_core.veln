fn dynamic_core_static_name_literal_value(block: ByteChunk, observed_size: Int, offset: Int) -> Result<String, HpackDynamicCoreFailure>
	match observed_size > 1
		true => match dynamic_core_byte_at_or_missing(block, 1) >= 0 and dynamic_core_byte_at_or_missing(block, 1) < 127
			true => match observed_size == 2 + dynamic_core_byte_at_or_missing(block, 1)
				true => match byte_count(2)
					Ok(prefix_count) => match byte_drop(block, prefix_count)
						Ok(value_suffix) => match byte_count(dynamic_core_byte_at_or_missing(block, 1))
							Ok(value_count) => match byte_take(value_suffix, value_count)
								Ok(value_bytes) => match byte_chunk_to_visible_ascii_string(value_bytes)
									Ok(value) => Ok(value)
									Err(_) => dynamic_core_unsupported_static_name_literal_string(block, offset)
								end
								Err(_) => dynamic_core_unsupported_static_name_literal_string(block, offset)
							end
							Err(_) => dynamic_core_unsupported_static_name_literal_string(block, offset)
						end
						Err(_) => dynamic_core_unsupported_static_name_literal_string(block, offset)
					end
					Err(_) => dynamic_core_unsupported_static_name_literal_string(block, offset)
				end
				false => dynamic_core_unsupported_static_name_literal_string(block, offset)
			end
			false => dynamic_core_unsupported_static_name_literal_string(block, offset)
		end
		false => dynamic_core_unsupported_static_name_literal_string(block, offset)
	end
end

fn dynamic_core_string_length_huffman_marked(length: HpackDynamicCoreStringLength) -> Bool
	match length
		HpackDynamicCoreStringLength(huffman_marked, _, _) => huffman_marked
	end
end

fn dynamic_core_string_length_encoded_count(length: HpackDynamicCoreStringLength) -> Int
	match length
		HpackDynamicCoreStringLength(_, encoded_count, _) => encoded_count
	end
end

fn dynamic_core_string_length_prefix_size(length: HpackDynamicCoreStringLength) -> Int
	match length
		HpackDynamicCoreStringLength(_, _, prefix_size) => prefix_size
	end
end

fn dynamic_core_string_length_from_integer(huffman_marked: Bool, prefix: HpackDynamicCoreIntegerPrefix) -> HpackDynamicCoreStringLength
	HpackDynamicCoreStringLength(huffman_marked, dynamic_core_integer_prefix_value(prefix), dynamic_core_integer_prefix_size(prefix))
end

fn dynamic_core_decode_string_length_at(block: ByteChunk, observed_size: Int, index: Int, offset: Int) -> Result<HpackDynamicCoreStringLength, HpackDynamicCoreFailure>
	let value_count: Int = dynamic_core_byte_at_or_missing(block, index)
	let encoded_count: Int = dynamic_core_low_seven_bits(value_count)
	let huffman_marked: Bool = value_count >= 128
	match dynamic_core_decode_prefixed_integer(encoded_count, 127, block, observed_size, index + 1, offset)
		Ok(prefix) => Ok(dynamic_core_string_length_from_integer(huffman_marked, prefix))
		Err(_) => Err(DynamicCoreUnsupportedHeaderBlock(offset, observed_size, dynamic_core_byte_at_or_missing(block, 0), "source-visible raw literal-name header", "hpack_dynamic_core", block))
	end
end

fn dynamic_core_decode_raw_string_literal_value(block: ByteChunk, value_count: Int, prefix_size: Int, offset: Int) -> Result<HpackDynamicCoreStringLiteral, HpackDynamicCoreFailure>
	match byte_count(prefix_size)
		Ok(prefix_count) => match byte_drop(block, prefix_count)
			Ok(value_suffix) => match byte_count(value_count)
				Ok(decoded_value_count) => match byte_take(value_suffix, decoded_value_count)
					Ok(value_bytes) => match byte_chunk_to_visible_ascii_string(value_bytes)
						Ok(value) => Ok(HpackDynamicCoreStringLiteral(value, value_count + prefix_size))
						Err(_) => dynamic_core_unsupported_raw_literal_string(block, offset)
					end
					Err(_) => dynamic_core_unsupported_raw_literal_string(block, offset)
				end
				Err(_) => dynamic_core_unsupported_raw_literal_string(block, offset)
			end
			Err(_) => dynamic_core_unsupported_raw_literal_string(block, offset)
		end
		Err(_) => dynamic_core_unsupported_raw_literal_string(block, offset)
	end
end

fn dynamic_core_decode_huffman_string_literal_value(block: ByteChunk, value_count: Int, prefix_size: Int, offset: Int) -> Result<HpackDynamicCoreStringLiteral, HpackDynamicCoreFailure>
	match byte_count(prefix_size)
		Ok(prefix_count) => match byte_drop(block, prefix_count)
			Ok(value_suffix) => match byte_count(value_count)
				Ok(decoded_value_count) => match byte_take(value_suffix, decoded_value_count)
					Ok(value_bytes) => match hpack_fixture::decode_checked_hpack_huffman_value(value_bytes, offset)
						Ok(value) => Ok(HpackDynamicCoreStringLiteral(value, value_count + prefix_size))
						Err(failure) => dynamic_core_huffman_string_literal_failure(block, offset, failure)
					end
					Err(_) => dynamic_core_unsupported_raw_literal_string(block, offset)
				end
				Err(_) => dynamic_core_unsupported_raw_literal_string(block, offset)
			end
			Err(_) => dynamic_core_unsupported_raw_literal_string(block, offset)
		end
		Err(_) => dynamic_core_unsupported_raw_literal_string(block, offset)
	end
end

fn dynamic_core_decode_raw_string_literal_prefix_at(block: ByteChunk, observed_size: Int, index: Int, offset: Int) -> Result<HpackDynamicCoreStringLiteral, HpackDynamicCoreFailure>
	match dynamic_core_decode_string_length_at(block, observed_size, index, offset)
		Ok(length) => match dynamic_core_string_length_huffman_marked(length)
			true => dynamic_core_unsupported_raw_literal_string(block, offset)
			false => match observed_size >= dynamic_core_string_length_prefix_size(length) + dynamic_core_string_length_encoded_count(length)
				true => dynamic_core_decode_raw_string_literal_value(block, dynamic_core_string_length_encoded_count(length), dynamic_core_string_length_prefix_size(length), offset)
				false => dynamic_core_unsupported_raw_literal_string(block, offset)
			end
		end
		Err(failure) => Err(failure)
	end
end

fn dynamic_core_decode_string_literal_at(block: ByteChunk, observed_size: Int, index: Int, offset: Int) -> Result<HpackDynamicCoreStringLiteral, HpackDynamicCoreFailure>
	match dynamic_core_decode_string_length_at(block, observed_size, index, offset)
		Ok(length) => match dynamic_core_string_length_huffman_marked(length)
			true => match observed_size == dynamic_core_string_length_prefix_size(length) + dynamic_core_string_length_encoded_count(length)
				true => dynamic_core_decode_huffman_string_literal_value(block, dynamic_core_string_length_encoded_count(length), dynamic_core_string_length_prefix_size(length), offset)
				false => dynamic_core_unsupported_raw_literal_string(block, offset)
			end
			false => match observed_size == dynamic_core_string_length_prefix_size(length) + dynamic_core_string_length_encoded_count(length)
				true => dynamic_core_decode_raw_string_literal_value(block, dynamic_core_string_length_encoded_count(length), dynamic_core_string_length_prefix_size(length), offset)
				false => dynamic_core_unsupported_raw_literal_string(block, offset)
			end
		end
		Err(failure) => Err(failure)
	end
end

fn dynamic_core_string_literal_value(literal: HpackDynamicCoreStringLiteral) -> String
	match literal
		HpackDynamicCoreStringLiteral(value, _) => value
	end
end

fn dynamic_core_string_literal_wire_size(literal: HpackDynamicCoreStringLiteral) -> Int
	match literal
		HpackDynamicCoreStringLiteral(_, wire_size) => wire_size
	end
end

fn dynamic_core_decoded_literal_for_indexing(indexing: HpackDynamicCoreLiteralIndexing, name: String, value: String, wire_size: Int, state: HpackDynamicCoreState) -> Result<HpackDynamicCoreDecodeTransition, HpackDynamicCoreFailure>
	match indexing
		DynamicCoreLiteralWithoutIndexing => Ok(HpackDynamicCoreDecodeTransition(dynamic_core_literal_without_indexing_header(name, value, wire_size), dynamic_core_next_state(state)))
		DynamicCoreLiteralWithIndexing => Ok(HpackDynamicCoreDecodeTransition(dynamic_core_literal_with_indexing_header(name, value, wire_size), dynamic_core_next_state(dynamic_core_insert_entry_state(state, name, value))))
		DynamicCoreLiteralNeverIndexed => Ok(HpackDynamicCoreDecodeTransition(dynamic_core_literal_never_indexed_header(name, value, wire_size), dynamic_core_next_state(state)))
	end
end

fn dynamic_core_decode_literal_header_with_name(indexing: HpackDynamicCoreLiteralIndexing, name: String, observed_size: Int, state: HpackDynamicCoreState, block: ByteChunk, offset: Int, value_index: Int) -> Result<HpackDynamicCoreDecodeTransition, HpackDynamicCoreFailure>
	match value_index < observed_size
		true => match dynamic_core_decode_string_literal_at(block, observed_size, value_index, offset)
			Ok(literal) => dynamic_core_decoded_literal_for_indexing(indexing, name, dynamic_core_string_literal_value(literal), dynamic_core_string_literal_wire_size(literal), state)
			Err(failure) => Err(failure)
		end
		false => dynamic_core_unsupported_raw_literal(block, offset)
	end
end

fn dynamic_core_decode_raw_name_literal_header_block(indexing: HpackDynamicCoreLiteralIndexing, observed_size: Int, state: HpackDynamicCoreState, block: ByteChunk, offset: Int) -> Result<HpackDynamicCoreDecodeTransition, HpackDynamicCoreFailure>
	match observed_size >= 3
		true => match dynamic_core_decode_raw_string_literal_prefix_at(block, observed_size, 1, offset)
			Ok(name) => dynamic_core_decode_literal_header_with_name(indexing, dynamic_core_string_literal_value(name), observed_size, state, block, offset, dynamic_core_string_literal_wire_size(name))
			Err(failure) => Err(failure)
		end
		false => dynamic_core_unsupported_raw_literal(block, offset)
	end
end

fn dynamic_core_decode_literal_dynamic_name_with_prefix(indexing: HpackDynamicCoreLiteralIndexing, prefix_value: Int, prefix_max: Int, observed_size: Int, state: HpackDynamicCoreState, block: ByteChunk, offset: Int) -> Result<HpackDynamicCoreDecodeTransition, HpackDynamicCoreFailure>
	match dynamic_core_decode_prefixed_integer(prefix_value, prefix_max, block, observed_size, 1, offset)
		Ok(name_index) => match dynamic_core_integer_prefix_value(name_index) >= 62
			true => dynamic_core_decode_literal_dynamic_name_at(indexing, dynamic_core_integer_prefix_value(name_index) - 62, dynamic_core_integer_prefix_size(name_index), observed_size, state, block, offset)
			false => dynamic_core_unsupported_raw_literal(block, offset)
		end
		Err(failure) => Err(failure)
	end
end

fn dynamic_core_decode_literal_dynamic_name_at(indexing: HpackDynamicCoreLiteralIndexing, table_index: Int, value_index: Int, observed_size: Int, state: HpackDynamicCoreState, block: ByteChunk, offset: Int) -> Result<HpackDynamicCoreDecodeTransition, HpackDynamicCoreFailure>
	match state
		HpackDynamicCoreState(_, _, dynamic_entry) => match dynamic_core_entry_at(dynamic_entry, table_index)
			Some(HpackDynamicCoreHeader(name, _)) => dynamic_core_decode_literal_header_with_name(indexing, name, observed_size, state, block, offset, value_index)
			None => dynamic_core_index_out_of_range(block, offset, table_index, dynamic_core_entry_count(dynamic_entry))
		end
	end
end

fn dynamic_core_decode_saturated_indexed_header(block: ByteChunk, state: HpackDynamicCoreState, observed_size: Int, offset: Int) -> Result<HpackDynamicCoreDecodeTransition, HpackDynamicCoreFailure>
	match dynamic_core_decode_prefixed_integer(127, 127, block, observed_size, 1, offset)
		Ok(prefix) => match dynamic_core_integer_prefix_size(prefix) == observed_size
			true => dynamic_core_decode_indexed_at(dynamic_core_integer_prefix_value(prefix) - 62, block, state, offset)
			false => dynamic_core_unsupported_indexed_header(block, offset)
		end
		Err(failure) => Err(failure)
	end
end

pub fn initial_dynamic_core_state() -> HpackDynamicCoreState
	HpackDynamicCoreState(4096, 0, NoDynamicCoreEntry)
end

pub fn empty_dynamic_core_state(table_size: Int, decode_count: Int) -> HpackDynamicCoreState
	HpackDynamicCoreState(table_size, decode_count, NoDynamicCoreEntry)
end

pub fn carried_single_dynamic_entry_state(table_size: Int, decode_count: Int, name: String, value: String) -> HpackDynamicCoreState
	match dynamic_core_entry_size(name, value) <= table_size
		true => HpackDynamicCoreState(table_size, decode_count, DynamicCoreEntry(name, value, NoDynamicCoreEntry))
		false => HpackDynamicCoreState(table_size, decode_count, NoDynamicCoreEntry)
	end
end

pub fn prepend_carried_dynamic_entry_state(state: HpackDynamicCoreState, name: String, value: String) -> HpackDynamicCoreState
	match state
		HpackDynamicCoreState(table_size, decode_count, dynamic_entry) => HpackDynamicCoreState(table_size, decode_count, dynamic_core_bounded_entry(table_size, name, value, dynamic_entry))
	end
end

pub fn dynamic_core_insert_entry_state(state: HpackDynamicCoreState, name: String, value: String) -> HpackDynamicCoreState
	prepend_carried_dynamic_entry_state(state, name, value)
end

pub fn dynamic_core_with_table_size(state: HpackDynamicCoreState, table_size: Int) -> HpackDynamicCoreState
	match state
		HpackDynamicCoreState(_, decode_count, dynamic_entry) => HpackDynamicCoreState(table_size, decode_count, dynamic_core_evict_for_table_size(table_size, dynamic_entry))
	end
end

pub fn dynamic_core_header_entry_size(name: String, value: String) -> Int
	dynamic_core_entry_size(name, value)
end

pub fn decode_indexed_header_field(block: ByteChunk, state: HpackDynamicCoreState, offset: Int) -> Result<HpackDynamicCoreDecodeTransition, HpackDynamicCoreFailure>
	let observed_size: Int = byte_count_to_int(byte_chunk_count(block))
	let first_byte: Int = dynamic_core_byte_at_or_missing(block, 0)
	match first_byte >= 190
		true => match observed_size == 1
			true => dynamic_core_decode_indexed_at(first_byte - 190, block, state, offset)
			false => match first_byte == 255
				true => dynamic_core_decode_saturated_indexed_header(block, state, observed_size, offset)
				false => dynamic_core_unsupported_indexed_header(block, offset)
			end
		end
		false => dynamic_core_unsupported_indexed_header(block, offset)
	end
end

pub fn decode_static_name_literal_with_indexing_field(block: ByteChunk, state: HpackDynamicCoreState, offset: Int) -> Result<HpackDynamicCoreDecodeTransition, HpackDynamicCoreFailure>
	let observed_size: Int = byte_count_to_int(byte_chunk_count(block))
	let first_byte: Int = dynamic_core_byte_at_or_missing(block, 0)
	match first_byte > 64 and first_byte < 127
		true => match dynamic_core_static_table_name(first_byte - 64)
			Some(name) => match dynamic_core_static_name_literal_value(block, observed_size, offset)
				Ok(value) => Ok(HpackDynamicCoreDecodeTransition(dynamic_core_literal_with_indexing_header(name, value, observed_size), dynamic_core_next_state(dynamic_core_insert_entry_state(state, name, value))))
				Err(failure) => Err(failure)
			end
			None => dynamic_core_unsupported_static_name_literal(block, offset)
		end
		false => dynamic_core_unsupported_static_name_literal(block, offset)
	end
end

pub fn decode_raw_literal_name_header_field(block: ByteChunk, state: HpackDynamicCoreState, offset: Int) -> Result<HpackDynamicCoreDecodeTransition, HpackDynamicCoreFailure>
	let observed_size: Int = byte_count_to_int(byte_chunk_count(block))
	let first_byte: Int = dynamic_core_byte_at_or_missing(block, 0)
	match first_byte
		0 => dynamic_core_decode_raw_name_literal_header_block(DynamicCoreLiteralWithoutIndexing, observed_size, state, block, offset)
		16 => dynamic_core_decode_raw_name_literal_header_block(DynamicCoreLiteralNeverIndexed, observed_size, state, block, offset)
		64 => dynamic_core_decode_raw_name_literal_header_block(DynamicCoreLiteralWithIndexing, observed_size, state, block, offset)
		_ => dynamic_core_unsupported_raw_literal(block, offset)
	end
end

pub fn decode_dynamic_name_literal_header_field(block: ByteChunk, state: HpackDynamicCoreState, offset: Int) -> Result<HpackDynamicCoreDecodeTransition, HpackDynamicCoreFailure>
	let observed_size: Int = byte_count_to_int(byte_chunk_count(block))
	let first_byte: Int = dynamic_core_byte_at_or_missing(block, 0)
	match first_byte >= 64 and first_byte < 128
		true => dynamic_core_decode_literal_dynamic_name_with_prefix(DynamicCoreLiteralWithIndexing, first_byte - 64, 63, observed_size, state, block, offset)
		false => match first_byte
			15 => dynamic_core_decode_literal_dynamic_name_with_prefix(DynamicCoreLiteralWithoutIndexing, 15, 15, observed_size, state, block, offset)
			31 => dynamic_core_decode_literal_dynamic_name_with_prefix(DynamicCoreLiteralNeverIndexed, 15, 15, observed_size, state, block, offset)
			_ => dynamic_core_unsupported_raw_literal(block, offset)
		end
	end
end

pub fn dynamic_core_transition_headers(transition: HpackDynamicCoreDecodeTransition) -> HpackDynamicCoreHeaderList
	match transition
		HpackDynamicCoreDecodeTransition(headers, _) => headers
	end
end

pub fn dynamic_core_transition_state(transition: HpackDynamicCoreDecodeTransition) -> HpackDynamicCoreState
	match transition
		HpackDynamicCoreDecodeTransition(_, state) => state
	end
end

pub fn dynamic_core_header_list_wire_size(headers: HpackDynamicCoreHeaderList) -> Int
	match headers
		HpackDynamicCoreHeaderList(_, _, wire_size) => wire_size
	end
end

pub fn dynamic_core_header_list_first_name(headers: HpackDynamicCoreHeaderList) -> String
	match headers
		HpackDynamicCoreHeaderList(HpackDynamicCoreHeader(name, _), _, _) => name
	end
end

pub fn dynamic_core_header_list_first_value(headers: HpackDynamicCoreHeaderList) -> String
	match headers
		HpackDynamicCoreHeaderList(HpackDynamicCoreHeader(_, value), _, _) => value
	end
end

pub fn dynamic_core_header_list_second_name(headers: HpackDynamicCoreHeaderList) -> String
	match headers
		HpackDynamicCoreHeaderList(_, HpackDynamicCoreHeader(name, _), _) => name
	end
end

pub fn dynamic_core_header_list_second_value(headers: HpackDynamicCoreHeaderList) -> String
	match headers
		HpackDynamicCoreHeaderList(_, HpackDynamicCoreHeader(_, value), _) => value
	end
end

pub fn dynamic_core_state_decode_count(state: HpackDynamicCoreState) -> Int
	match state
		HpackDynamicCoreState(_, decode_count, _) => decode_count
	end
end

pub fn dynamic_core_state_table_size(state: HpackDynamicCoreState) -> Int
	match state
		HpackDynamicCoreState(table_size, _, _) => table_size
	end
end

pub fn dynamic_core_state_dynamic_table_entry_count(state: HpackDynamicCoreState) -> Int
	match state
		HpackDynamicCoreState(_, _, dynamic_entry) => dynamic_core_entry_count(dynamic_entry)
	end
end

pub fn dynamic_core_state_dynamic_table_size(state: HpackDynamicCoreState) -> Int
	match state
		HpackDynamicCoreState(_, _, dynamic_entry) => dynamic_core_entries_size(dynamic_entry)
	end
end

pub fn dynamic_core_failure_diagnostic_id(failure: HpackDynamicCoreFailure) -> String
	match failure
		DynamicCoreUnsupportedHeaderBlock(_, _, _, _, _, _) => "hpack.fixture.unsupported_header_block"
		DynamicCoreIndexOutOfRange(_, _, _, _, _, _, _, _) => "hpack.fixture.dynamic_index_out_of_range"
		DynamicCoreMalformedHuffmanPadding(_, _, _, _, _, _) => "hpack.fixture.malformed_huffman_padding"
		DynamicCoreMalformedInteger(_, _, _, _, _, _, _) => "hpack.integer.malformed"
	end
end

pub fn dynamic_core_failure_offset(failure: HpackDynamicCoreFailure) -> Int
	match failure
		DynamicCoreUnsupportedHeaderBlock(offset, _, _, _, _, _) => offset
		DynamicCoreIndexOutOfRange(offset, _, _, _, _, _, _, _) => offset
		DynamicCoreMalformedHuffmanPadding(offset, _, _, _, _, _) => offset
		DynamicCoreMalformedInteger(offset, _, _, _, _, _, _) => offset
	end
end

pub fn dynamic_core_failure_observed_size(failure: HpackDynamicCoreFailure) -> Int
	match failure
		DynamicCoreUnsupportedHeaderBlock(_, observed_size, _, _, _, _) => observed_size
		DynamicCoreIndexOutOfRange(_, observed_size, _, _, _, _, _, _) => observed_size
		DynamicCoreMalformedHuffmanPadding(_, observed_size, _, _, _, _) => observed_size
		DynamicCoreMalformedInteger(_, observed_size, _, _, _, _, _) => observed_size
	end
end

pub fn dynamic_core_failure_observed_first_byte(failure: HpackDynamicCoreFailure) -> Int
	match failure
		DynamicCoreUnsupportedHeaderBlock(_, _, observed_first_byte, _, _, _) => observed_first_byte
		DynamicCoreIndexOutOfRange(_, _, observed_first_byte, _, _, _, _, _) => observed_first_byte
		DynamicCoreMalformedHuffmanPadding(_, _, observed_first_byte, _, _, _) => observed_first_byte
		DynamicCoreMalformedInteger(_, _, observed_first_byte, _, _, _, _) => observed_first_byte
	end
end

pub fn dynamic_core_failure_prefix_width(failure: HpackDynamicCoreFailure) -> Int
	match failure
		DynamicCoreMalformedInteger(_, _, _, prefix_width, _, _, _) => prefix_width
		_ => 0
	end
end

pub fn dynamic_core_failure_preview_count(failure: HpackDynamicCoreFailure) -> Int
	match failure
		DynamicCoreUnsupportedHeaderBlock(_, _, _, _, _, preview) => byte_count_to_int(byte_chunk_count(preview))
		DynamicCoreIndexOutOfRange(_, _, _, _, _, _, _, preview) => byte_count_to_int(byte_chunk_count(preview))
		DynamicCoreMalformedHuffmanPadding(_, _, _, _, _, preview) => byte_count_to_int(byte_chunk_count(preview))
		DynamicCoreMalformedInteger(_, _, _, _, _, _, preview) => byte_count_to_int(byte_chunk_count(preview))
	end
end

pub fn dynamic_core_failure_requested_dynamic_index(failure: HpackDynamicCoreFailure) -> Int
	match failure
		DynamicCoreIndexOutOfRange(_, _, _, requested_dynamic_index, _, _, _, _) => requested_dynamic_index
		_ => 0
	end
end

pub fn dynamic_core_failure_dynamic_table_entry_count(failure: HpackDynamicCoreFailure) -> Int
	match failure
		DynamicCoreIndexOutOfRange(_, _, _, _, dynamic_table_entry_count, _, _, _) => dynamic_table_entry_count
		_ => 0
	end
end

pub fn dynamic_core_failure_decoder_module(failure: HpackDynamicCoreFailure) -> String
	match failure
		DynamicCoreUnsupportedHeaderBlock(_, _, _, _, decoder_module, _) => decoder_module
		DynamicCoreIndexOutOfRange(_, _, _, _, _, _, decoder_module, _) => decoder_module
		DynamicCoreMalformedHuffmanPadding(_, _, _, _, decoder_module, _) => decoder_module
		DynamicCoreMalformedInteger(_, _, _, _, _, decoder_module, _) => decoder_module
	end
end

pub fn hpack_integer_prefix_value(prefix: HpackDynamicCoreIntegerPrefix) -> Int
	dynamic_core_integer_prefix_value(prefix)
end

pub fn hpack_integer_prefix_size(prefix: HpackDynamicCoreIntegerPrefix) -> Int
	dynamic_core_integer_prefix_size(prefix)
end

pub fn hpack_integer_encoding_bytes(encoding: HpackDynamicCoreIntegerEncoding) -> ByteChunk
	match encoding
		HpackDynamicCoreIntegerEncoding(encoded) => encoded
	end
end
