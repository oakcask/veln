use hpack_fixture

pub type HpackDynamicCoreEntry
	NoDynamicCoreEntry
	DynamicCoreEntry(name: String, value: String, older: HpackDynamicCoreEntry)
end

pub type HpackDynamicCoreState
	HpackDynamicCoreState(table_size: Int, decode_count: Int, dynamic_entry: HpackDynamicCoreEntry)
end

pub type HpackDynamicCoreHeader
	HpackDynamicCoreHeader(name: String, value: String)
end

pub type HpackDynamicCoreHeaderList
	HpackDynamicCoreHeaderList(first: HpackDynamicCoreHeader, second: HpackDynamicCoreHeader, wire_size: Int)
end

pub type HpackDynamicCoreDecodeTransition
	HpackDynamicCoreDecodeTransition(headers: HpackDynamicCoreHeaderList, state: HpackDynamicCoreState)
end

pub type HpackDynamicCoreFailure
	DynamicCoreUnsupportedHeaderBlock(offset: Int, observed_size: Int, observed_first_byte: Int, expected_header: String, decoder_module: String, preview: ByteChunk)
	DynamicCoreIndexOutOfRange(offset: Int, observed_size: Int, observed_first_byte: Int, requested_dynamic_index: Int, dynamic_table_entry_count: Int, expected_header: String, decoder_module: String, preview: ByteChunk)
	DynamicCoreMalformedHuffmanPadding(offset: Int, observed_size: Int, observed_first_byte: Int, expected_header: String, decoder_module: String, preview: ByteChunk)
	DynamicCoreMalformedInteger(offset: Int, observed_size: Int, observed_first_byte: Int, prefix_width: Int, expected_header: String, decoder_module: String, preview: ByteChunk)
end

type HpackDynamicCoreStringLiteral
	HpackDynamicCoreStringLiteral(value: String, wire_size: Int)
end

type HpackDynamicCoreStringLength
	HpackDynamicCoreStringLength(huffman_marked: Bool, encoded_count: Int, prefix_size: Int)
end

type HpackDynamicCoreLiteralIndexing
	DynamicCoreLiteralWithoutIndexing
	DynamicCoreLiteralWithIndexing
	DynamicCoreLiteralNeverIndexed
end

pub type HpackDynamicCoreIntegerPrefix
	HpackDynamicCoreIntegerPrefix(value: Int, prefix_size: Int)
end

pub type HpackDynamicCoreIntegerEncoding
	HpackDynamicCoreIntegerEncoding(encoded: ByteChunk)
end

fn dynamic_core_byte_at(block: ByteChunk, index: Int) -> Result<Int, String>
	let view: ByteView = byte_view(block, byte_offset(index)?, byte_count(1)?)?
	byte_read_u8_be(view)
end

fn dynamic_core_byte_at_or_missing(block: ByteChunk, index: Int) -> Int
	match dynamic_core_byte_at(block, index)
		Ok(value) => value
		Err(_) => -1
	end
end

fn dynamic_core_string_byte_count(value: String) -> Int
	match byte_chunk_from_visible_ascii_string(value)
		Ok(bytes) => byte_count_to_int(byte_chunk_count(bytes))
		Err(_) => 0
	end
end

fn dynamic_core_entry_size(name: String, value: String) -> Int
	dynamic_core_string_byte_count(name) + dynamic_core_string_byte_count(value) + 32
end

fn dynamic_core_next_state(state: HpackDynamicCoreState) -> HpackDynamicCoreState
	match state
		HpackDynamicCoreState(table_size, decode_count, dynamic_entry) => HpackDynamicCoreState(table_size, decode_count + 1, dynamic_entry)
	end
end

fn dynamic_core_entry_count(dynamic_entry: HpackDynamicCoreEntry) -> Int
	match dynamic_entry
		NoDynamicCoreEntry => 0
		DynamicCoreEntry(_, _, older) => 1 + dynamic_core_entry_count(older)
	end
end

fn dynamic_core_entries_size(dynamic_entry: HpackDynamicCoreEntry) -> Int
	match dynamic_entry
		NoDynamicCoreEntry => 0
		DynamicCoreEntry(name, value, older) => dynamic_core_entry_size(name, value) + dynamic_core_entries_size(older)
	end
end

fn dynamic_core_evict_for_table_size(table_size: Int, dynamic_entry: HpackDynamicCoreEntry) -> HpackDynamicCoreEntry
	dynamic_core_evict_for_remaining_table_size(table_size, dynamic_entry)
end

fn dynamic_core_evict_for_remaining_table_size(remaining_table_size: Int, dynamic_entry: HpackDynamicCoreEntry) -> HpackDynamicCoreEntry
	match dynamic_entry
		NoDynamicCoreEntry => NoDynamicCoreEntry
		DynamicCoreEntry(name, value, older) => match dynamic_core_entry_size(name, value) <= remaining_table_size
			true => DynamicCoreEntry(name, value, dynamic_core_evict_for_remaining_table_size(remaining_table_size - dynamic_core_entry_size(name, value), older))
			false => NoDynamicCoreEntry
		end
	end
end

fn dynamic_core_bounded_entry(table_size: Int, name: String, value: String, dynamic_entry: HpackDynamicCoreEntry) -> HpackDynamicCoreEntry
	match dynamic_core_entry_size(name, value) > table_size
		true => NoDynamicCoreEntry
		false => dynamic_core_evict_for_table_size(table_size, DynamicCoreEntry(name, value, dynamic_entry))
	end
end

fn dynamic_core_entry_at(dynamic_entry: HpackDynamicCoreEntry, table_index: Int) -> Option<HpackDynamicCoreHeader>
	match dynamic_entry
		NoDynamicCoreEntry => None
		DynamicCoreEntry(name, value, older) => match table_index
			0 => Some(HpackDynamicCoreHeader(name, value))
			_ => dynamic_core_entry_at(older, table_index - 1)
		end
	end
end

fn dynamic_core_low_seven_bits(byte: Int) -> Int
	byte - (byte / 128) * 128
end

fn dynamic_core_decode_integer_tail(block: ByteChunk, observed_size: Int, index: Int, multiplier: Int, value: Int, prefix_width: Int, offset: Int) -> Result<HpackDynamicCoreIntegerPrefix, HpackDynamicCoreFailure>
	match index < observed_size
		false => dynamic_core_malformed_integer_prefix(block, prefix_width, offset)
		true => dynamic_core_decode_integer_tail_byte(dynamic_core_byte_at_or_missing(block, index), block, observed_size, index, multiplier, value, prefix_width, offset)
	end
end

fn dynamic_core_decode_integer_tail_byte(current: Int, block: ByteChunk, observed_size: Int, index: Int, multiplier: Int, value: Int, prefix_width: Int, offset: Int) -> Result<HpackDynamicCoreIntegerPrefix, HpackDynamicCoreFailure>
	let next_value: Int = value + dynamic_core_low_seven_bits(current) * multiplier
	match current < 128
		true => Ok(HpackDynamicCoreIntegerPrefix(next_value, index + 1))
		false => dynamic_core_decode_integer_tail(block, observed_size, index + 1, multiplier * 128, next_value, prefix_width, offset)
	end
end

fn dynamic_core_prefix_width(prefix_max: Int) -> Int
	match prefix_max
		15 => 4
		31 => 5
		63 => 6
		127 => 7
		_ => 0
	end
end

fn hpack_integer_prefix_max(prefix_width: Int) -> Int
	match prefix_width
		4 => 15
		5 => 31
		6 => 63
		7 => 127
		_ => 0
	end
end

pub fn decode_hpack_integer_prefix(prefix_value: Int, prefix_width: Int, block: ByteChunk, next_index: Int, offset: Int) -> Result<HpackDynamicCoreIntegerPrefix, HpackDynamicCoreFailure>
	let observed_size: Int = byte_count_to_int(byte_chunk_count(block))
	let prefix_max: Int = hpack_integer_prefix_max(prefix_width)
	match prefix_max > 0
		true => dynamic_core_decode_prefixed_integer_with_width(prefix_value, prefix_max, prefix_width, block, observed_size, next_index, offset)
		false => dynamic_core_malformed_integer_prefix(block, prefix_width, offset)
	end
end

fn dynamic_core_decode_prefixed_integer(prefix_value: Int, prefix_max: Int, block: ByteChunk, observed_size: Int, next_index: Int, offset: Int) -> Result<HpackDynamicCoreIntegerPrefix, HpackDynamicCoreFailure>
	dynamic_core_decode_prefixed_integer_with_width(prefix_value, prefix_max, dynamic_core_prefix_width(prefix_max), block, observed_size, next_index, offset)
end

fn dynamic_core_decode_prefixed_integer_with_width(prefix_value: Int, prefix_max: Int, prefix_width: Int, block: ByteChunk, observed_size: Int, next_index: Int, offset: Int) -> Result<HpackDynamicCoreIntegerPrefix, HpackDynamicCoreFailure>
	match prefix_value < prefix_max
		true => Ok(HpackDynamicCoreIntegerPrefix(prefix_value, next_index))
		false => dynamic_core_decode_integer_tail(block, observed_size, next_index, 1, prefix_max, prefix_width, offset)
	end
end

fn dynamic_core_integer_prefix_value(prefix: HpackDynamicCoreIntegerPrefix) -> Int
	match prefix
		HpackDynamicCoreIntegerPrefix(value, _) => value
	end
end

fn dynamic_core_integer_prefix_size(prefix: HpackDynamicCoreIntegerPrefix) -> Int
	match prefix
		HpackDynamicCoreIntegerPrefix(_, prefix_size) => prefix_size
	end
end

fn dynamic_core_malformed_integer_prefix(block: ByteChunk, prefix_width: Int, offset: Int) -> Result<HpackDynamicCoreIntegerPrefix, HpackDynamicCoreFailure>
	Err(DynamicCoreMalformedInteger(offset, byte_count_to_int(byte_chunk_count(block)), dynamic_core_byte_at_or_missing(block, 0), prefix_width, "source-visible HPACK integer", "hpack_dynamic_core", block))
end

fn dynamic_core_malformed_integer_encoding(value: Int, prefix_width: Int, offset: Int) -> Result<ByteChunk, HpackDynamicCoreFailure>
	Err(DynamicCoreMalformedInteger(offset, 0, value, prefix_width, "source-visible HPACK integer", "hpack_dynamic_core", byte_chunk([])))
end

fn encode_hpack_integer_tail(remaining: Int, prefix_width: Int, offset: Int) -> Result<ByteChunk, HpackDynamicCoreFailure>
	match remaining < 128
		true => encode_hpack_integer_tail_byte(remaining, prefix_width, offset)
		false => match encode_hpack_integer_tail_byte((remaining - (remaining / 128) * 128) + 128, prefix_width, offset)
			Ok(current) => match encode_hpack_integer_tail(remaining / 128, prefix_width, offset)
				Ok(next) => Ok(byte_append(current, next))
				Err(failure) => Err(failure)
			end
			Err(failure) => Err(failure)
		end
	end
end

fn encode_hpack_integer_tail_byte(value: Int, prefix_width: Int, offset: Int) -> Result<ByteChunk, HpackDynamicCoreFailure>
	match byte_write_u8_be(value)
		Ok(encoded) => Ok(encoded)
		Err(_) => dynamic_core_malformed_integer_encoding(value, prefix_width, offset)
	end
end

pub fn encode_hpack_integer_prefix(value: Int, prefix_width: Int, prefix_base: Int, offset: Int) -> Result<HpackDynamicCoreIntegerEncoding, HpackDynamicCoreFailure>
	let prefix_max: Int = hpack_integer_prefix_max(prefix_width)
	match prefix_max > 0 and value >= 0
		true => match value < prefix_max
			true => match byte_write_u8_be(prefix_base + value)
				Ok(encoded) => Ok(HpackDynamicCoreIntegerEncoding(encoded))
				Err(_) => Err(DynamicCoreMalformedInteger(offset, 0, prefix_base + value, prefix_width, "source-visible HPACK integer", "hpack_dynamic_core", byte_chunk([])))
			end
			false => match byte_write_u8_be(prefix_base + prefix_max)
				Ok(prefix) => match encode_hpack_integer_tail(value - prefix_max, prefix_width, offset)
					Ok(tail) => Ok(HpackDynamicCoreIntegerEncoding(byte_append(prefix, tail)))
					Err(failure) => Err(failure)
				end
				Err(_) => Err(DynamicCoreMalformedInteger(offset, 0, prefix_base + prefix_max, prefix_width, "source-visible HPACK integer", "hpack_dynamic_core", byte_chunk([])))
			end
		end
		false => match dynamic_core_malformed_integer_encoding(value, prefix_width, offset)
			Ok(encoded) => Ok(HpackDynamicCoreIntegerEncoding(encoded))
			Err(failure) => Err(failure)
		end
	end
end

fn dynamic_core_indexed_header(name: String, value: String) -> HpackDynamicCoreHeaderList
	HpackDynamicCoreHeaderList(HpackDynamicCoreHeader(name, value), HpackDynamicCoreHeader(":fixture", "dynamic-indexed"), 9)
end

fn dynamic_core_literal_with_indexing_header(name: String, value: String, wire_size: Int) -> HpackDynamicCoreHeaderList
	HpackDynamicCoreHeaderList(HpackDynamicCoreHeader(name, value), HpackDynamicCoreHeader(":fixture", "literal-with-indexing"), wire_size)
end

fn dynamic_core_literal_without_indexing_header(name: String, value: String, wire_size: Int) -> HpackDynamicCoreHeaderList
	HpackDynamicCoreHeaderList(HpackDynamicCoreHeader(name, value), HpackDynamicCoreHeader(":fixture", "literal-without-indexing"), wire_size)
end

fn dynamic_core_literal_never_indexed_header(name: String, value: String, wire_size: Int) -> HpackDynamicCoreHeaderList
	HpackDynamicCoreHeaderList(HpackDynamicCoreHeader(name, value), HpackDynamicCoreHeader(":fixture", "literal-never-indexed"), wire_size)
end

fn dynamic_core_index_out_of_range(block: ByteChunk, offset: Int, requested_dynamic_index: Int, dynamic_table_entry_count: Int) -> Result<HpackDynamicCoreDecodeTransition, HpackDynamicCoreFailure>
	Err(DynamicCoreIndexOutOfRange(offset, byte_count_to_int(byte_chunk_count(block)), dynamic_core_byte_at_or_missing(block, 0), requested_dynamic_index, dynamic_table_entry_count, "source-visible dynamic indexed header", "hpack_dynamic_core", block))
end

fn dynamic_core_unsupported_indexed_header(block: ByteChunk, offset: Int) -> Result<HpackDynamicCoreDecodeTransition, HpackDynamicCoreFailure>
	Err(DynamicCoreUnsupportedHeaderBlock(offset, byte_count_to_int(byte_chunk_count(block)), dynamic_core_byte_at_or_missing(block, 0), "source-visible dynamic indexed header", "hpack_dynamic_core", block))
end

fn dynamic_core_unsupported_static_name_literal(block: ByteChunk, offset: Int) -> Result<HpackDynamicCoreDecodeTransition, HpackDynamicCoreFailure>
	Err(DynamicCoreUnsupportedHeaderBlock(offset, byte_count_to_int(byte_chunk_count(block)), dynamic_core_byte_at_or_missing(block, 0), "source-visible static-name literal-with-indexing", "hpack_dynamic_core", block))
end

fn dynamic_core_unsupported_static_name_literal_string(block: ByteChunk, offset: Int) -> Result<String, HpackDynamicCoreFailure>
	Err(DynamicCoreUnsupportedHeaderBlock(offset, byte_count_to_int(byte_chunk_count(block)), dynamic_core_byte_at_or_missing(block, 0), "source-visible static-name literal-with-indexing", "hpack_dynamic_core", block))
end

fn dynamic_core_unsupported_raw_literal(block: ByteChunk, offset: Int) -> Result<HpackDynamicCoreDecodeTransition, HpackDynamicCoreFailure>
	Err(DynamicCoreUnsupportedHeaderBlock(offset, byte_count_to_int(byte_chunk_count(block)), dynamic_core_byte_at_or_missing(block, 0), "source-visible raw literal-name header", "hpack_dynamic_core", block))
end

fn dynamic_core_unsupported_raw_literal_string(block: ByteChunk, offset: Int) -> Result<HpackDynamicCoreStringLiteral, HpackDynamicCoreFailure>
	Err(DynamicCoreUnsupportedHeaderBlock(offset, byte_count_to_int(byte_chunk_count(block)), dynamic_core_byte_at_or_missing(block, 0), "source-visible raw literal-name header", "hpack_dynamic_core", block))
end

fn dynamic_core_huffman_string_literal_failure(block: ByteChunk, offset: Int, failure: HpackFixtureFailure) -> Result<HpackDynamicCoreStringLiteral, HpackDynamicCoreFailure>
	match failure
		MalformedHuffmanPadding(_, _, _, _, _, _) => Err(DynamicCoreMalformedHuffmanPadding(offset, byte_count_to_int(byte_chunk_count(block)), dynamic_core_byte_at_or_missing(block, 0), "fixture HPACK Huffman padding", "hpack_dynamic_core", block))
		_ => dynamic_core_unsupported_raw_literal_string(block, offset)
	end
end

fn dynamic_core_decode_indexed_at(table_index: Int, block: ByteChunk, state: HpackDynamicCoreState, offset: Int) -> Result<HpackDynamicCoreDecodeTransition, HpackDynamicCoreFailure>
	match state
		HpackDynamicCoreState(_, _, dynamic_entry) => match dynamic_core_entry_at(dynamic_entry, table_index)
			Some(HpackDynamicCoreHeader(name, value)) => Ok(HpackDynamicCoreDecodeTransition(dynamic_core_indexed_header(name, value), dynamic_core_next_state(state)))
			None => dynamic_core_index_out_of_range(block, offset, table_index, dynamic_core_entry_count(dynamic_entry))
		end
	end
end

