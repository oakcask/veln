# Flag24 helpers return checked Result failures for invalid indexes and raw bits.
use stdio

fn emit_bool_error(value: Result<Bool, String>) -> () effects [stdio]
	match value
		Ok(_) => stdio::println("unexpected bool success")
		Err(message) => stdio::println(message)
	end
end

fn emit_flag24be_error(value: Result<Flag24be, String>) -> () effects [stdio]
	match value
		Ok(_) => stdio::println("unexpected flag24be success")
		Err(message) => stdio::println(message)
	end
end

fn emit_flag24le_error(value: Result<Flag24le, String>) -> () effects [stdio]
	match value
		Ok(_) => stdio::println("unexpected flag24le success")
		Err(message) => stdio::println(message)
	end
end

pub fn main() -> () effects [stdio]
	emit_bool_error(flag24be_is_set(Flag24be(0), 24))
	emit_flag24le_error(flag24le_set(Flag24le(0), -1))
	emit_flag24be_error(flag24be_from_bits(16777216))
	emit_flag24le_error(flag24le_from_bits(16777216))
end
