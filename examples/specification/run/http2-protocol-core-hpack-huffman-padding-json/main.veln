use http2::hpack::diagnostic from "std"
# HTTP/2 HPACK malformed Huffman padding projects structured runtime details.

fn fallback_payload(error: String) -> RuntimeDiagnostic
	RuntimeDiagnostic("hpack.fixture.malformed_huffman_padding", error, RuntimeHpackFixtureDiagnostic(9, 0, -1, "fixture HPACK Huffman padding", "hpack_static", byte_chunk([])))
end

fn preview_view() -> Result<ByteView, RuntimeDiagnostic>
	match byte_chunk_from_hex("048100")
		Ok(bytes) => match byte_offset(0)
			Ok(offset) => match byte_view(bytes, offset, byte_chunk_count(bytes))
				Ok(view) => Ok(view)
				Err(error) => Err(fallback_payload(error))
			end
			Err(error) => Err(fallback_payload(error))
		end
		Err(error) => Err(fallback_payload(error))
	end
end

pub fn main() -> Result<(), RuntimeDiagnostic>
	let preview: ByteView = preview_view()?
	http2::hpack::diagnostic::malformed_huffman_padding(9, 3, 4, "fixture HPACK Huffman padding", "hpack_static", preview)
end
