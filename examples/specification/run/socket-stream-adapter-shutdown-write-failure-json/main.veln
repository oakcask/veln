# Writes after write-side shutdown stay runtime transport failures.
pub fn main() -> Result<(), String> effects [net]
	let listener: NetListener = net::listen("127.0.0.1:0")
	let stream: NetStream = net::accept(listener)
	let outgoing: ByteChunk = byte_chunk_from_hex("0a0b")?
	net::write_chunk(stream, outgoing)
	net::shutdown_write(stream)
	net::write_chunk(stream, outgoing)
	Ok(())
end
