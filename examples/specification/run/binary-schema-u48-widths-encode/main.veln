# Binary schema UInt48be and UInt48le primitives encode ordinary Int fields.
use stdio

schema UInt48Widths
	format binary

	big_value: UInt48be
	little_value: UInt48le
end

fn emit_output_chunk(name: String, index: Int, chunk: ByteChunk, expected_hex: String) -> () effects [stdio]
	stdio::print("output_chunk ")
	stdio::print(name)
	stdio::print(" index ")
	stdio::print(int_to_string(index))
	stdio::print(" hex \"")
	stdio::print(expected_hex)
	stdio::print("\" count ")
	stdio::println(int_to_string(byte_count_to_int(byte_chunk_count(chunk))))
end

fn emit_output_chunk_list_header(name: String, count: Int) -> () effects [stdio]
	stdio::print("output_chunk_list ")
	stdio::print(name)
	stdio::print(" count ")
	stdio::println(int_to_string(count))
end

fn emit_decoded(bytes: ByteChunk) -> Result<(), String> effects [stdio]
	let view: ByteView = byte_view(bytes, byte_offset(0)?, byte_count(12)?)?
	let decoded: {big_value: Int, little_value: Int} = byte_decode_uint48_widths(view)?
	stdio::print("decoded ")
	stdio::print(int_to_string(decoded.big_value))
	stdio::print(" ")
	stdio::println(int_to_string(decoded.little_value))
	Ok(())
end

fn emit_encoded_bytes(bytes: ByteChunk) -> Result<(), String> effects [stdio]
	emit_output_chunk_list_header("u48-widths", 1)
	emit_output_chunk("u48-widths", 0, bytes, "010203040506060504030201")
	emit_decoded(bytes)
end

fn emit_encoded(encoded: Result<ByteChunk, EncodeError>) -> Result<(), String> effects [stdio]
	match encoded
		Ok(bytes) => emit_encoded_bytes(bytes)
		Err(_) => Ok(stdio::println("unexpected encode failure"))
	end
end

pub fn main() -> Result<(), String> effects [stdio]
	let encoded: Result<ByteChunk, EncodeError> = byte_encode_uint48_widths({big_value: 1108152157446, little_value: 1108152157446})
	let ignored: () = emit_encoded(encoded)?
	Ok(())
end
