fn hpack_static_huffman_decoded_string(decoded: ByteChunk) -> Option<String>
	match byte_chunk_to_visible_ascii_string(decoded)
		Ok(value) => Some(value)
		Err(_) => match byte_count_to_int(byte_chunk_count(decoded)) == 1 and hpack_fixture_byte_at_or_missing(decoded, 0) == 10
			true => Some("\n")
			false => match byte_count_to_int(byte_chunk_count(decoded)) == 1
				true => hpack_static_huffman_single_byte_label(hpack_fixture_byte_at_or_missing(decoded, 0))
				false => Some(hpack_fixture_huffman_bytes_label(decoded))
			end
		end
	end
end

fn hpack_static_huffman_done(decoded: ByteChunk, code: Int, length: Int) -> Option<String>
	match hpack_static_huffman_padding_valid(code, length)
		true => hpack_static_huffman_decoded_string(decoded)
		false => None
	end
end

fn hpack_static_huffman_decode_bit(encoded: ByteChunk, bit_index: Int, total_bits: Int, decoded: ByteChunk, code: Int, length: Int) -> Option<String>
	let source_byte: Int = hpack_fixture_byte_at_or_missing(encoded, bit_index / 8)
	let bit: Int = hpack_static_huffman_byte_bit(source_byte, bit_index - (bit_index / 8) * 8)
	let next_code: Int = code * 2 + bit
	let next_length: Int = length + 1
	match hpack_static_huffman_symbol(next_code, next_length)
		Some(symbol) => match hpack_static_huffman_append_symbol(decoded, symbol)
			Some(next_decoded) => hpack_static_huffman_decode_bits(encoded, bit_index + 1, total_bits, next_decoded, 0, 0)
			None => None
		end
		None => match next_length > 30
			true => None
			false => hpack_static_huffman_decode_bits(encoded, bit_index + 1, total_bits, decoded, next_code, next_length)
		end
	end
end

fn hpack_static_huffman_decode_bits(encoded: ByteChunk, bit_index: Int, total_bits: Int, decoded: ByteChunk, code: Int, length: Int) -> Option<String>
	match bit_index == total_bits
		true => hpack_static_huffman_done(decoded, code, length)
		false => hpack_static_huffman_decode_bit(encoded, bit_index, total_bits, decoded, code, length)
	end
end

pub fn checked_hpack_huffman_value(encoded: ByteChunk) -> Option<String>
	hpack_static_huffman_decode_bits(encoded, 0, byte_count_to_int(byte_chunk_count(encoded)) * 8, byte_chunk([]), 0, 0)
end

pub fn header_list_first_name(headers: HpackHeaderList) -> String
	match headers
		HpackHeaderList(HpackHeader(name, _), _, _) => name
	end
end

pub fn header_list_first_value(headers: HpackHeaderList) -> String
	match headers
		HpackHeaderList(HpackHeader(_, value), _, _) => value
	end
end

pub fn header_list_wire_size(headers: HpackHeaderList) -> Int
	match headers
		HpackHeaderList(_, _, wire_size) => wire_size
	end
end

pub fn header_list_decoded_names(headers: HpackHeaderList) -> String
	match headers
		HpackHeaderList(HpackHeader(":method", _), HpackHeader(":request", "scheme,path"), _) => ":method,:scheme,:path"
		HpackHeaderList(HpackHeader(":method", _), HpackHeader(":fixture", _), _) => ":method,:fixture"
		HpackHeaderList(HpackHeader(":authority", _), HpackHeader(":fixture", _), _) => ":authority,:fixture"
		HpackHeaderList(HpackHeader(":path", _), HpackHeader(":fixture", _), _) => ":path,:fixture"
		HpackHeaderList(HpackHeader(":scheme", _), HpackHeader(":fixture", _), _) => ":scheme,:fixture"
		HpackHeaderList(HpackHeader(":status", _), HpackHeader(":fixture", _), _) => ":status,:fixture"
		HpackHeaderList(HpackHeader("accept-encoding", _), HpackHeader(":fixture", _), _) => "accept-encoding,:fixture"
		HpackHeaderList(HpackHeader("authorization", _), HpackHeader(":fixture", _), _) => "authorization,:fixture"
		HpackHeaderList(HpackHeader("server", _), HpackHeader(":fixture", _), _) => "server,:fixture"
		HpackHeaderList(HpackHeader("content-length", _), HpackHeader(":fixture", _), _) => "content-length,:fixture"
		HpackHeaderList(HpackHeader("content-type", _), HpackHeader(":fixture", _), _) => "content-type,:fixture"
		HpackHeaderList(HpackHeader("host", _), HpackHeader(":fixture", _), _) => "host,:fixture"
		HpackHeaderList(HpackHeader("set-cookie", _), HpackHeader(":fixture", _), _) => "set-cookie,:fixture"
		HpackHeaderList(HpackHeader("user-agent", _), HpackHeader(":fixture", _), _) => "user-agent,:fixture"
		HpackHeaderList(HpackHeader("www-authenticate", _), HpackHeader(":fixture", _), _) => "www-authenticate,:fixture"
		_ => ":unknown"
	end
end
