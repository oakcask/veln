fn hpack_static_huffman_padding_valid(code: Int, length: Int) -> Bool
	length == 0 or (length <= 7 and code == hpack_static_huffman_pow2(length) - 1)
end

fn hpack_static_huffman_append_symbol(decoded: ByteChunk, symbol: Int) -> Option<ByteChunk>
	match symbol
		256 => None
		_ => match byte_write_u8_be(symbol)
			Ok(symbol_chunk) => Some(byte_append(decoded, symbol_chunk))
			Err(_) => None
		end
	end
end

