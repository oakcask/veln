pub type HpackHeader
	HpackHeader(name: String, value: String)
end

pub type HpackHeaderList
	HpackHeaderList(first: HpackHeader, second: HpackHeader, wire_size: Int)
end

pub fn hpack_header(name: String, value: String) -> HpackHeader
	HpackHeader(name, value)
end

pub fn hpack_header_list(first: HpackHeader, second: HpackHeader, wire_size: Int) -> HpackHeaderList
	HpackHeaderList(first, second, wire_size)
end

fn hpack_fixture_byte_at(block: ByteChunk, index: Int) -> Result<Int, String>
	let view: ByteView = byte_view(block, byte_offset(index)?, byte_count(1)?)?
	byte_read_u8_be(view)
end

fn hpack_fixture_byte_at_or_missing(block: ByteChunk, index: Int) -> Int
	match hpack_fixture_byte_at(block, index)
		Ok(value) => value
		Err(_) => -1
	end
end

fn hpack_static_huffman_pow2(value: Int) -> Int
	match value
		0 => 1
		1 => 2
		2 => 4
		3 => 8
		4 => 16
		5 => 32
		6 => 64
		7 => 128
		_ => 256
	end
end

fn hpack_static_huffman_byte_bit(byte: Int, bit_index: Int) -> Int
	let divisor: Int = hpack_static_huffman_pow2(7 - bit_index)
	byte / divisor - (byte / (divisor * 2)) * 2
end

