end

fn static_table_header_from_indexed_byte(byte: Int) -> Option<HpackHeader>
	static_table_header(byte - 128)
end

fn static_index_wire_size(byte: Int) -> Int
	match byte
		129 => 1
		130 => 8
		131 => 9
		132 => 6
		133 => 9
		134 => 8
		135 => 9
		_ => 9
	end
end

fn all_bytes_indexed(block: ByteChunk, index: Int, count: Int) -> Bool
	match index == count
		true => true
		false => match byte_at_or_missing(block, index) >= 128
			true => all_bytes_indexed(block, index + 1, count)
			false => false
		end
	end
end

fn all_indexes_supported(block: ByteChunk, index: Int, count: Int) -> Bool
	match index == count
		true => true
		false => match static_table_header_from_indexed_byte(byte_at_or_missing(block, index))
			Some(_) => all_indexes_supported(block, index + 1, count)
			None => false
		end
	end
end

fn request_marker(method: String, wire_size: Int) -> HpackHeaderList
	hpack_fixture::hpack_header_list(hpack_fixture::hpack_header(":method", method), hpack_fixture::hpack_header(":request", "scheme,path"), wire_size)
end

fn single_header(byte: Int) -> HpackHeaderList
	match static_table_header_from_indexed_byte(byte)
		Some(header) => hpack_fixture::hpack_header_list(header, hpack_fixture::hpack_header(":fixture", "static-indexed"), static_index_wire_size(byte))
		None => hpack_fixture::hpack_header_list(hpack_fixture::hpack_header(":fixture", "unsupported-static-index"), hpack_fixture::hpack_header(":fixture", "static-indexed"), 0)
	end
end

fn supported_request_block(first: Int, second: Int, third: Int) -> Bool
	(first == 130 or first == 131) and (second == 134 or second == 135) and third == 132
end

fn request_method(byte: Int) -> String
	match byte
		131 => "POST"
		_ => "GET"
	end
end

fn not_static_string(block: ByteChunk, offset: Int) -> Result<String, HpackStaticFailure>
	Err(NotStaticHeaderBlock(offset, observed_size(block), byte_at_or_missing(block, 0), "HPACK static indexed header block", "hpack_static", block))
end

fn literal_without_indexing_name_index(block: ByteChunk) -> Int
	let first_byte: Int = byte_at_or_missing(block, 0)
	match first_byte
		15 => match byte_at_or_missing(block, 1) >= 0 and byte_at_or_missing(block, 1) < 128
			true => 15 + byte_at_or_missing(block, 1)
			false => -1
		end
		_ => match first_byte > 0 and first_byte < 15
			true => first_byte
			false => -1
		end
	end
end

fn literal_without_indexing_value_index(block: ByteChunk) -> Int
	match byte_at_or_missing(block, 0)
		15 => 2
		_ => 1
	end
end

fn literal_with_indexing_name_index(block: ByteChunk) -> Int
	let first_byte: Int = byte_at_or_missing(block, 0)
	match first_byte > 64 and first_byte < 127
		true => first_byte - 64
		false => -1
	end
end

fn literal_never_indexed_name_index(block: ByteChunk) -> Int
	let first_byte: Int = byte_at_or_missing(block, 0)
	match first_byte
		31 => match byte_at_or_missing(block, 1) >= 0 and byte_at_or_missing(block, 1) < 128
			true => 15 + byte_at_or_missing(block, 1)
			false => -1
		end
		_ => match first_byte > 16 and first_byte < 31
			true => first_byte - 16
			false => -1
		end
	end
end

fn literal_never_indexed_value_index(block: ByteChunk) -> Int
	match byte_at_or_missing(block, 0)
		31 => 2
		_ => 1
	end
end

fn static_table_literal_name(name_index: Int) -> Option<String>
	match static_table_header(name_index)
		Some(HpackHeader(name, _)) => Some(name)
		None => None
	end
end

fn literal_raw_value(block: ByteChunk, count: Int, value_index: Int, offset: Int) -> Result<String, HpackStaticFailure>
	match value_index < count
		true => match byte_at_or_missing(block, value_index) >= 0 and byte_at_or_missing(block, value_index) < 127
			true => match count == value_index + 1 + byte_at_or_missing(block, value_index)
				true => match byte_count(value_index + 1)
					Ok(prefix_count) => match byte_drop(block, prefix_count)
						Ok(value_suffix) => match byte_count(byte_at_or_missing(block, value_index))
							Ok(value_count) => match byte_take(value_suffix, value_count)
								Ok(value_bytes) => match byte_chunk_to_visible_ascii_string(value_bytes)
									Ok(value) => Ok(value)
									Err(_) => not_static_string(block, offset)
								end
								Err(_) => not_static_string(block, offset)
							end
							Err(_) => not_static_string(block, offset)
						end
						Err(_) => not_static_string(block, offset)
					end
					Err(_) => not_static_string(block, offset)
				end
				false => not_static_string(block, offset)
			end
			false => not_static_string(block, offset)
		end
		false => not_static_string(block, offset)
	end
end

fn literal_huffman_value(block: ByteChunk, count: Int, value_index: Int, offset: Int) -> Result<String, HpackStaticFailure>
	match value_index < count
		true => match byte_at_or_missing(block, value_index) >= 128 and byte_at_or_missing(block, value_index) < 255
			true => match count == value_index + 1 + byte_at_or_missing(block, value_index) - 128
				true => match byte_count(value_index + 1)
					Ok(prefix_count) => match byte_drop(block, prefix_count)
						Ok(value_suffix) => match byte_count(byte_at_or_missing(block, value_index) - 128)
							Ok(value_count) => match byte_take(value_suffix, value_count)
								Ok(value_bytes) => match hpack_fixture::checked_hpack_huffman_value(value_bytes)
									Some(value) => Ok(value)
									None => not_static_string(block, offset)
								end
								Err(_) => not_static_string(block, offset)
							end
							Err(_) => not_static_string(block, offset)
						end
						Err(_) => not_static_string(block, offset)
					end
					Err(_) => not_static_string(block, offset)
				end
				false => not_static_string(block, offset)
			end
			false => not_static_string(block, offset)
		end
		false => not_static_string(block, offset)
	end
end

fn literal_value(block: ByteChunk, count: Int, value_index: Int, offset: Int) -> Result<String, HpackStaticFailure>
	match byte_at_or_missing(block, value_index) >= 128
		true => literal_huffman_value(block, count, value_index, offset)
		false => literal_raw_value(block, count, value_index, offset)
	end
end

fn literal_static_name_header(name: String, value: String, marker: String, wire_size: Int) -> HpackHeaderList
	hpack_fixture::hpack_header_list(hpack_fixture::hpack_header(name, value), hpack_fixture::hpack_header(":fixture", marker), wire_size)
end

fn decode_static_name_literal(block: ByteChunk, count: Int, offset: Int, name_index: Int, value_index: Int, marker: String) -> Result<HpackHeaderList, HpackStaticFailure>
	match static_table_literal_name(name_index)
		Some(name) => match literal_value(block, count, value_index, offset)
			Ok(value) => Ok(literal_static_name_header(name, value, marker, count))
			Err(failure) => Err(failure)
		end
		None => not_static(block, offset)
	end
end

fn decode_literal_without_indexing_block(block: ByteChunk, count: Int, offset: Int) -> Result<HpackHeaderList, HpackStaticFailure>
	decode_static_name_literal(block, count, offset, literal_without_indexing_name_index(block), literal_without_indexing_value_index(block), "literal-without-indexing")
end

fn decode_literal_with_indexing_block(block: ByteChunk, count: Int, offset: Int) -> Result<HpackHeaderList, HpackStaticFailure>
	decode_static_name_literal(block, count, offset, literal_with_indexing_name_index(block), 1, "literal-with-indexing")
end

fn decode_literal_never_indexed_block(block: ByteChunk, count: Int, offset: Int) -> Result<HpackHeaderList, HpackStaticFailure>
	decode_static_name_literal(block, count, offset, literal_never_indexed_name_index(block), literal_never_indexed_value_index(block), "literal-never-indexed")
end

fn decode_static_name_literal_block(block: ByteChunk, count: Int, offset: Int) -> Result<HpackHeaderList, HpackStaticFailure>
	match byte_at_or_missing(block, 0) >= 64 and byte_at_or_missing(block, 0) < 128
		true => decode_literal_with_indexing_block(block, count, offset)
		false => match byte_at_or_missing(block, 0) >= 16 and byte_at_or_missing(block, 0) < 32
			true => decode_literal_never_indexed_block(block, count, offset)
			false => decode_literal_without_indexing_block(block, count, offset)
		end
	end
end

fn decode_supported_block(block: ByteChunk, count: Int, offset: Int) -> Result<HpackHeaderList, HpackStaticFailure>
	match all_indexes_supported(block, 0, count)
		false => unsupported_static_index(block, offset)
		true => match count == 1
			true => Ok(single_header(byte_at_or_missing(block, 0)))
			false => match count == 3 and supported_request_block(byte_at_or_missing(block, 0), byte_at_or_missing(block, 1), byte_at_or_missing(block, 2))
				true => Ok(request_marker(request_method(byte_at_or_missing(block, 0)), 9))
				false => not_static(block, offset)
			end
		end
	end
end

pub fn decode_header_block(block: ByteChunk, offset: Int) -> Result<HpackHeaderList, HpackStaticFailure>
	let count: Int = observed_size(block)
	match count
		0 => not_static(block, offset)
		_ => match all_bytes_indexed(block, 0, count)
			false => decode_static_name_literal_block(block, count, offset)
			true => decode_supported_block(block, count, offset)
		end
	end
end

pub fn hpack_static_failure_offset(failure: HpackStaticFailure) -> Int
	match failure
		NotStaticHeaderBlock(offset, _, _, _, _, _) => offset
		UnsupportedStaticIndex(offset, _, _, _, _, _) => offset
	end
end

pub fn hpack_static_failure_observed_size(failure: HpackStaticFailure) -> Int
	match failure
		NotStaticHeaderBlock(_, size, _, _, _, _) => size
		UnsupportedStaticIndex(_, size, _, _, _, _) => size
	end
end

pub fn hpack_static_failure_observed_first_byte(failure: HpackStaticFailure) -> Int
	match failure
		NotStaticHeaderBlock(_, _, first_byte, _, _, _) => first_byte
		UnsupportedStaticIndex(_, _, first_byte, _, _, _) => first_byte
	end
end

pub fn hpack_static_failure_expected_header(failure: HpackStaticFailure) -> String
	match failure
		NotStaticHeaderBlock(_, _, _, expected_header, _, _) => expected_header
		UnsupportedStaticIndex(_, _, _, expected_header, _, _) => expected_header
	end
end
