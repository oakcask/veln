use hpack_fixture

pub type HpackStaticFailure
	NotStaticHeaderBlock(offset: Int, observed_size: Int, observed_first_byte: Int, expected_header: String, decoder_module: String, preview: ByteChunk)
	UnsupportedStaticIndex(offset: Int, observed_size: Int, observed_first_byte: Int, expected_header: String, decoder_module: String, preview: ByteChunk)
end

fn byte_at(block: ByteChunk, index: Int) -> Result<Int, String>
	let view: ByteView = byte_view(block, byte_offset(index)?, byte_count(1)?)?
	byte_read_u8_be(view)
end

fn byte_at_or_missing(block: ByteChunk, index: Int) -> Int
	match byte_at(block, index)
		Ok(value) => value
		Err(_) => -1
	end
end

fn observed_size(block: ByteChunk) -> Int
	byte_count_to_int(byte_chunk_count(block))
end

fn not_static(block: ByteChunk, offset: Int) -> Result<HpackHeaderList, HpackStaticFailure>
	Err(NotStaticHeaderBlock(offset, observed_size(block), byte_at_or_missing(block, 0), "HPACK static indexed header block", "hpack_static", block))
end

fn unsupported_static_index(block: ByteChunk, offset: Int) -> Result<HpackHeaderList, HpackStaticFailure>
	Err(UnsupportedStaticIndex(offset, observed_size(block), byte_at_or_missing(block, 0), "HPACK static indexed header", "hpack_static", block))
end

fn static_table_header(index: Int) -> Option<HpackHeader>
	match index
		1 => Some(hpack_fixture::hpack_header(":authority", ""))
		2 => Some(hpack_fixture::hpack_header(":method", "GET"))
		3 => Some(hpack_fixture::hpack_header(":method", "POST"))
		4 => Some(hpack_fixture::hpack_header(":path", "/"))
		5 => Some(hpack_fixture::hpack_header(":path", "/index.html"))
		6 => Some(hpack_fixture::hpack_header(":scheme", "http"))
		7 => Some(hpack_fixture::hpack_header(":scheme", "https"))
		8 => Some(hpack_fixture::hpack_header(":status", "200"))
		9 => Some(hpack_fixture::hpack_header(":status", "204"))
		10 => Some(hpack_fixture::hpack_header(":status", "206"))
		11 => Some(hpack_fixture::hpack_header(":status", "304"))
		12 => Some(hpack_fixture::hpack_header(":status", "400"))
		13 => Some(hpack_fixture::hpack_header(":status", "404"))
		14 => Some(hpack_fixture::hpack_header(":status", "500"))
		15 => Some(hpack_fixture::hpack_header("accept-charset", ""))
		16 => Some(hpack_fixture::hpack_header("accept-encoding", "gzip, deflate"))
		17 => Some(hpack_fixture::hpack_header("accept-language", ""))
		18 => Some(hpack_fixture::hpack_header("accept-ranges", ""))
		19 => Some(hpack_fixture::hpack_header("accept", ""))
		20 => Some(hpack_fixture::hpack_header("access-control-allow-origin", ""))
		21 => Some(hpack_fixture::hpack_header("age", ""))
		22 => Some(hpack_fixture::hpack_header("allow", ""))
		23 => Some(hpack_fixture::hpack_header("authorization", ""))
		24 => Some(hpack_fixture::hpack_header("cache-control", ""))
		25 => Some(hpack_fixture::hpack_header("content-disposition", ""))
		26 => Some(hpack_fixture::hpack_header("content-encoding", ""))
		27 => Some(hpack_fixture::hpack_header("content-language", ""))
		28 => Some(hpack_fixture::hpack_header("content-length", ""))
		29 => Some(hpack_fixture::hpack_header("content-location", ""))
		30 => Some(hpack_fixture::hpack_header("content-range", ""))
		31 => Some(hpack_fixture::hpack_header("content-type", ""))
		32 => Some(hpack_fixture::hpack_header("cookie", ""))
		33 => Some(hpack_fixture::hpack_header("date", ""))
		34 => Some(hpack_fixture::hpack_header("etag", ""))
		35 => Some(hpack_fixture::hpack_header("expect", ""))
		36 => Some(hpack_fixture::hpack_header("expires", ""))
		37 => Some(hpack_fixture::hpack_header("from", ""))
		38 => Some(hpack_fixture::hpack_header("host", ""))
		39 => Some(hpack_fixture::hpack_header("if-match", ""))
		40 => Some(hpack_fixture::hpack_header("if-modified-since", ""))
		41 => Some(hpack_fixture::hpack_header("if-none-match", ""))
		42 => Some(hpack_fixture::hpack_header("if-range", ""))
		43 => Some(hpack_fixture::hpack_header("if-unmodified-since", ""))
		44 => Some(hpack_fixture::hpack_header("last-modified", ""))
		45 => Some(hpack_fixture::hpack_header("link", ""))
		46 => Some(hpack_fixture::hpack_header("location", ""))
		47 => Some(hpack_fixture::hpack_header("max-forwards", ""))
		48 => Some(hpack_fixture::hpack_header("proxy-authenticate", ""))
