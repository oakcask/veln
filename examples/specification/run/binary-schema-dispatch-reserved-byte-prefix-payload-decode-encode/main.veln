# Reserved-byte-prefix nested dispatch payloads use generated helpers.
use stdio

schema TwoBitBytePayload
	format binary

	prefix: ReservedBits(2, 0)
	value: UInt8
end

schema NineBitBytePayload
	format binary

	prefix: ReservedBits(9, 0)
	value: UInt8
end

schema TwoBitPacket
	format binary

	kind: UInt8
	payload: Dispatch(kind, 1 => TwoBitBytePayload)
end

schema NineBitPacket
	format binary

	kind: UInt8
	payload: Dispatch(kind, 1 => NineBitBytePayload)
end

fn emit_output_chunk(name: String, index: Int, chunk: ByteChunk, expected_hex: String) -> () effects [stdio]
	stdio::print("output_chunk ")
	stdio::print(name)
	stdio::print(" index ")
	stdio::print(int_to_string(index))
	stdio::print(" hex \"")
	stdio::print(expected_hex)
	stdio::print("\" count ")
	stdio::println(int_to_string(byte_count_to_int(byte_chunk_count(chunk))))
end

fn emit_encoded_chunk(name: String, bytes: ByteChunk, expected_hex: String) -> () effects [stdio]
	stdio::print("output_chunk_list ")
	stdio::print(name)
	stdio::println(" count 1")
	emit_output_chunk(name, 0, bytes, expected_hex)
end

fn emit_encoded(name: String, encoded: Result<ByteChunk, EncodeError>, expected_hex: String) -> () effects [stdio]
	match encoded
		Ok(bytes) => emit_encoded_chunk(name, bytes, expected_hex)
		Err(_) => stdio::println("unexpected encode failure")
	end
end

fn emit_two_bit(packet: {kind: Int, payload: {value: Int}}) -> () effects [stdio]
	stdio::print("two-bit ")
	stdio::print(int_to_string(packet.kind))
	stdio::print(" ")
	stdio::println(int_to_string(packet.payload.value))
end

fn emit_nine_bit(packet: {kind: Int, payload: {value: Int}}) -> () effects [stdio]
	stdio::print("nine-bit ")
	stdio::print(int_to_string(packet.kind))
	stdio::print(" ")
	stdio::println(int_to_string(packet.payload.value))
end

pub fn main() -> Result<(), String> effects [stdio]
	let two_bit_bytes: ByteChunk = byte_chunk_from_hex("012ac0")?
	let two_bit_view: ByteView = byte_view(two_bit_bytes, byte_offset(0)?, byte_count(3)?)?
	let two_bit: {kind: Int, payload: {value: Int}} = byte_decode_two_bit_packet(two_bit_view)?
	emit_two_bit(two_bit)
	emit_encoded("two-bit-byte-prefix-payload", byte_encode_two_bit_packet(two_bit), "012ac0")

	let nine_bit_bytes: ByteChunk = byte_chunk_from_hex("01002a")?
	let nine_bit_view: ByteView = byte_view(nine_bit_bytes, byte_offset(0)?, byte_count(3)?)?
	let nine_bit: {kind: Int, payload: {value: Int}} = byte_decode_nine_bit_packet(nine_bit_view)?
	emit_nine_bit(nine_bit)
	emit_encoded("nine-bit-byte-prefix-payload", byte_encode_nine_bit_packet(nine_bit), "01002a")
	Ok(())
end
