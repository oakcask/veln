use http2::diagnostic from "std"
# Client-side SETTINGS_ENABLE_PUSH rejection projects structured details.

fn invalid_payload(error: String) -> RuntimeDiagnostic
	RuntimeDiagnostic(
		"http2.protocol.settings_not_allowed_for_endpoint",
		error,
		RuntimeHttp2Diagnostic(RuntimeHttp2ProtocolSettingsNotAllowedForEndpointDiagnostic(15, 2, "SETTINGS_ENABLE_PUSH", "client", 4, "peer-settings", "rfc9113_client_must_not_receive_settings_enable_push", byte_chunk([])))
	)
end

fn settings_item() -> Result<ByteView, RuntimeDiagnostic>
	match byte_chunk_from_hex("000200000001")
		Ok(bytes) => match byte_offset(0)
			Ok(offset) => match byte_count(6)
				Ok(count) => match byte_view(bytes, offset, count)
					Ok(view) => Ok(view)
					Err(error) => Err(invalid_payload(error))
				end
				Err(error) => Err(invalid_payload(error))
			end
			Err(error) => Err(invalid_payload(error))
		end
		Err(error) => Err(invalid_payload(error))
	end
end

pub fn main() -> Result<(), RuntimeDiagnostic>
	http2::diagnostic::protocol_settings_not_allowed_for_endpoint(15, 2, "SETTINGS_ENABLE_PUSH", "client", 4, "peer-settings", "rfc9113_client_must_not_receive_settings_enable_push", settings_item()?)
end
