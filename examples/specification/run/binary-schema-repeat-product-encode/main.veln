# Binary schema Repeat product counts encode primitive lists.
use stdio

schema CountedValues
	format binary

	row_count: UInt8
	column_count: UInt8
	items: Repeat(row_count * column_count, UInt16be)
end

fn emit_output_chunk(name: String, index: Int, chunk: ByteChunk, expected_hex: String) -> () effects [stdio]
	stdio::print("output_chunk ")
	stdio::print(name)
	stdio::print(" index ")
	stdio::print(int_to_string(index))
	stdio::print(" hex \"")
	stdio::print(expected_hex)
	stdio::print("\" count ")
	stdio::println(int_to_string(byte_count_to_int(byte_chunk_count(chunk))))
end

fn emit_encoded(bytes: ByteChunk) -> () effects [stdio]
	stdio::println("output_chunk_list counted-values-product count 1")
	emit_output_chunk("counted-values-product", 0, bytes, "02030001000200030004000500ff")
end

pub fn main() -> () effects [stdio]
	let items: List<Int> = list_cons(1, list_cons(2, list_cons(3, list_cons(4, list_cons(5, list_cons(255, list_nil()))))))
	let encoded: Result<ByteChunk, EncodeError> = byte_encode_counted_values({row_count: 2, column_count: 3, items: items})
	match encoded
		Ok(bytes) => emit_encoded(bytes)
		Err(_) => stdio::println("unexpected encode failure")
	end
end
