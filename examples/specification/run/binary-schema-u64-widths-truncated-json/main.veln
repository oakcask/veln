# Binary schema UInt64le truncation reports schema field byte details.
schema UInt64Widths
	format binary

	big_value: UInt64be
	little_value: UInt64le
end

pub fn main() -> Result<(), String>
	let bytes: ByteChunk = byte_chunk_from_hex("010203040506070808070605040302")?
	let offset: ByteOffset = byte_offset(0)?
	let count: ByteCount = byte_count(15)?
	let view: ByteView = byte_view(bytes, offset, count)?
	let ignored: {big_value: Int, little_value: Int} = byte_decode_uint64_widths(view)?
	Ok(())
end
