# Reserved-byte-prefix dispatch payload failures keep the parent field path.

schema NineBitBytePayload
	format binary

	prefix: ReservedBits(9, 0)
	value: UInt8
end

schema NineBitPacket
	format binary

	kind: UInt8
	payload: Dispatch(kind, 1 => NineBitBytePayload)
end

pub fn main() -> Result<(), String>
	let bytes: ByteChunk = byte_chunk_from_hex("01012a")?
	let view: ByteView = byte_view(bytes, byte_offset(0)?, byte_count(3)?)?
	let ignored: {kind: Int, payload: {value: Int}} = byte_decode_nine_bit_packet(view)?
	Ok(())
end
