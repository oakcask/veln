use http2::core from "std"
use http2::diagnostic from "std"
# HTTP/2 partial connection preface failures project to human runtime diagnostics.

fn partial_preface_error_payload(error: String) -> RuntimeDiagnostic
	RuntimeDiagnostic(
		"http2.protocol.partial_preface",
		error,
		RuntimeHttp2Diagnostic(RuntimeHttp2ProtocolPartialPrefaceDiagnostic(0, 0, 24, "connection-preface", "rfc9113_client_connection_preface", byte_chunk([])))
	)
end

fn preview_view(bytes: ByteChunk) -> Result<ByteView, RuntimeDiagnostic>
	match byte_offset(0)
		Ok(offset) => match byte_view(bytes, offset, byte_chunk_count(bytes))
			Ok(view) => Ok(view)
			Err(error) => Err(partial_preface_error_payload(error))
		end
		Err(error) => Err(partial_preface_error_payload(error))
	end
end

fn preface_bytes() -> Result<ByteChunk, RuntimeDiagnostic>
	match byte_chunk_from_hex("505249202a20485454502f32")
		Ok(bytes) => Ok(bytes)
		Err(error) => Err(partial_preface_error_payload(error))
	end
end

fn http2_protocol_diagnostic(failure: ConnectionPrefaceFailure) -> Result<(), RuntimeDiagnostic>
	let preview: ByteChunk = http2::core::connection_preface_failure_preview(failure)
	http2::diagnostic::protocol_partial_preface(
		http2::core::connection_preface_failure_offset(failure),
		http2::core::connection_preface_failure_pending_count(failure),
		preview_view(preview)?
	)
end

pub fn main() -> Result<(), RuntimeDiagnostic>
	let bytes: ByteChunk = preface_bytes()?
	match http2::core::accept_connection_preface(http2::core::empty_connection_preface(0), bytes)
		Err(_) => Err(partial_preface_error_payload("partial connection preface unexpectedly failed before input end"))
		Ok(transition) => match http2::core::close_connection_preface(http2::core::connection_preface_state(transition))
			Ok(_) => Err(partial_preface_error_payload("partial connection preface unexpectedly accepted input end"))
			Err(failure) => http2_protocol_diagnostic(failure)
		end
	end
end
