# Hand-written codec decoders keep offsets explicit and NeedMore non-consuming.
use stdio

schema ManualOffsetPacketWire
	format binary

	length: UInt16be
	kind: UInt8
end

codec ManualOffsetCodec for ManualOffsetPacketWire decode
	decode with decode_manual_offset_packet
end

fn absolute_offset(base: ByteOffset, local: Int) -> ByteOffset
	match byte_offset(byte_offset_to_int(base) + local)
		Ok(offset) => offset
		Err(_) => base
	end
end

fn decode_manual_offset_packet(input: ByteView, base: ByteOffset) -> DecodeStep<{length: Int, kind: Int}>
	match byte_count(3)
		Ok(required) => match byte_count_to_int(byte_view_count(input)) < 3
			true => NeedMore(NeedBytes(required))
			false => decode_ready_packet(input, base, required)
		end
		Err(message) => Invalid(DecodeError(message, base, "ManualOffsetPacketWire"))
	end
end

fn decode_ready_packet(input: ByteView, base: ByteOffset, consumed: ByteCount) -> DecodeStep<{length: Int, kind: Int}>
	match byte_read_u16_be(input)
		Ok(length) => decode_ready_kind(input, base, consumed, length)
		Err(message) => Invalid(DecodeError(message, base, "ManualOffsetPacketWire.length"))
	end
end

fn decode_ready_kind(input: ByteView, base: ByteOffset, consumed: ByteCount, length: Int) -> DecodeStep<{length: Int, kind: Int}>
	match byte_count(2)
		Ok(local_kind) => match byte_view_drop(input, local_kind)
			Ok(kind_view) => decode_validated_kind(base, consumed, length, kind_view)
			Err(message) => Invalid(DecodeError(message, absolute_offset(base, 2), "ManualOffsetPacketWire.kind"))
		end
		Err(message) => Invalid(DecodeError(message, base, "ManualOffsetPacketWire.kind"))
	end
end

fn decode_validated_kind(base: ByteOffset, consumed: ByteCount, length: Int, kind_view: ByteView) -> DecodeStep<{length: Int, kind: Int}>
	match byte_read_u8_be(kind_view)
		Ok(kind) => match kind <= length
			true => Decoded({length: length, kind: kind}, consumed)
			false => Invalid(DecodeError("codec.invalid_input", absolute_offset(base, 2), "ManualOffsetPacketWire.kind"))
		end
		Err(message) => Invalid(DecodeError(message, absolute_offset(base, 2), "ManualOffsetPacketWire.kind"))
	end
end

fn step_kind(step: DecodeStep<{length: Int, kind: Int}>) -> String
	match step
		Decoded(_, _) => "decoded"
		NeedMore(_) => "need_more"
		Invalid(_) => "invalid"
	end
end

fn decoded_length(step: DecodeStep<{length: Int, kind: Int}>) -> Int
	match step
		Decoded(packet, _) => packet.length
		NeedMore(_) => -1
		Invalid(_) => -1
	end
end

fn decoded_kind(step: DecodeStep<{length: Int, kind: Int}>) -> Int
	match step
		Decoded(packet, _) => packet.kind
		NeedMore(_) => -1
		Invalid(_) => -1
	end
end

fn consumed_count(step: DecodeStep<{length: Int, kind: Int}>) -> Int
	match step
		Decoded(_, consumed) => byte_count_to_int(consumed)
		NeedMore(_) => 0
		Invalid(_) => 0
	end
end

fn readiness_kind(step: DecodeStep<{length: Int, kind: Int}>) -> String
	match step
		Decoded(_, _) => "none"
		NeedMore(NeedBytes(_)) => "need_bytes"
		NeedMore(NeedEnd) => "need_end"
		Invalid(_) => "none"
	end
end

fn readiness_count(step: DecodeStep<{length: Int, kind: Int}>) -> Int
	match step
		Decoded(_, _) => 0
		NeedMore(NeedBytes(count)) => byte_count_to_int(count)
		NeedMore(NeedEnd) => 0
		Invalid(_) => 0
	end
end

fn error_id(step: DecodeStep<{length: Int, kind: Int}>) -> String
	match step
		Decoded(_, _) => "none"
		NeedMore(_) => "none"
		Invalid(DecodeError(id, _, _)) => id
		Invalid(DecodeErrorWithReason(id, _, _, _)) => id
	end
end

fn error_offset(step: DecodeStep<{length: Int, kind: Int}>) -> Int
	match step
		Decoded(_, _) => -1
		NeedMore(_) => -1
		Invalid(DecodeError(_, offset, _)) => byte_offset_to_int(offset)
		Invalid(DecodeErrorWithReason(_, offset, _, _)) => byte_offset_to_int(offset)
	end
end

fn error_path(step: DecodeStep<{length: Int, kind: Int}>) -> String
	match step
		Decoded(_, _) => "none"
		NeedMore(_) => "none"
		Invalid(DecodeError(_, _, path)) => path
		Invalid(DecodeErrorWithReason(_, _, path, _)) => path
	end
end

pub fn main() -> Result<(), String> effects [stdio]
	let complete_bytes: ByteChunk = byte_chunk_from_hex("000703")?
	let complete_view: ByteView = byte_view(complete_bytes, byte_offset(0)?, byte_count(3)?)?
	let complete: DecodeStep<{length: Int, kind: Int}> = ManualOffsetCodec(complete_view, byte_offset(40)?)
	stdio::println(step_kind(complete))
	stdio::println(int_to_string(decoded_length(complete)))
	stdio::println(int_to_string(decoded_kind(complete)))
	stdio::println(int_to_string(consumed_count(complete)))

	let short_bytes: ByteChunk = byte_chunk_from_hex("0007")?
	let short_view: ByteView = byte_view(short_bytes, byte_offset(0)?, byte_count(2)?)?
	let waiting: DecodeStep<{length: Int, kind: Int}> = ManualOffsetCodec(short_view, byte_offset(50)?)
	stdio::println(step_kind(waiting))
	stdio::println(readiness_kind(waiting))
	stdio::println(int_to_string(readiness_count(waiting)))
	stdio::println(int_to_string(consumed_count(waiting)))

	let invalid_bytes: ByteChunk = byte_chunk_from_hex("000107")?
	let invalid_view: ByteView = byte_view(invalid_bytes, byte_offset(0)?, byte_count(3)?)?
	let invalid: DecodeStep<{length: Int, kind: Int}> = ManualOffsetCodec(invalid_view, byte_offset(60)?)
	stdio::println(step_kind(invalid))
	stdio::println(error_id(invalid))
	stdio::println(int_to_string(error_offset(invalid)))
	stdio::println(error_path(invalid))
	stdio::println(int_to_string(consumed_count(invalid)))
	Ok(())
end
