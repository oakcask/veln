fn decode_static_indexed_two_header_block(first_byte: Int, second_byte: Int, state: HpackFixtureState, block: ByteChunk, offset: Int) -> Result<HpackDecodeTransition, HpackFixtureFailure>
	match static_indexed_header_value(first_byte)
		Some(first) => match static_indexed_header_value(second_byte)
			Some(second) => decoded_static_indexed_two_headers(first, second, state)
			None => unsupported(block, offset)
		end
		None => unsupported(block, offset)
	end
end

