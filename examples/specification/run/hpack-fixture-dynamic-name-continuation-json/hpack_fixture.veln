use http2::hpack from "std"
use http2::hpack::diagnostic from "std"
pub type HpackDynamicEntry
	NoDynamicEntry
	DynamicEntry(name: String, value: String, older: HpackDynamicEntry)
end

pub type HpackFixtureState
	HpackFixtureState(table_size: Int, decode_count: Int, dynamic_entry: HpackDynamicEntry)
end

pub type HpackHeader
	HpackHeader(name: String, value: String)
end

pub type HpackHeaderList
	HpackHeaderList(first: HpackHeader, second: HpackHeader, wire_size: Int)
end

pub type HpackDecodeTransition
	HpackDecodeTransition(headers: HpackHeaderList, state: HpackFixtureState)
end

pub type HpackEncodeTransition
	HpackEncodeTransition(encoded: ByteChunk, state: HpackFixtureState)
end

pub type HpackFixtureFailure
	UnsupportedHeaderBlock(offset: Int, observed_size: Int, observed_first_byte: Int, expected_fixture: String, codec_module: String, preview: ByteChunk)
	DynamicIndexOutOfRange(offset: Int, observed_size: Int, observed_first_byte: Int, requested_dynamic_index: Int, dynamic_table_entry_count: Int, expected_fixture: String, codec_module: String, preview: ByteChunk)
	DynamicNameContinuationMissing(offset: Int, observed_size: Int, observed_first_byte: Int, requested_dynamic_index: Int, dynamic_table_entry_count: Int, expected_fixture: String, codec_module: String, preview: ByteChunk)
	DynamicNameContinuationMalformed(offset: Int, observed_size: Int, observed_first_byte: Int, requested_dynamic_index: Int, dynamic_table_entry_count: Int, expected_fixture: String, codec_module: String, preview: ByteChunk)
	DynamicNameContinuationOutOfRange(offset: Int, observed_size: Int, observed_first_byte: Int, requested_dynamic_index: Int, dynamic_table_entry_count: Int, expected_fixture: String, codec_module: String, preview: ByteChunk)
	HuffmanNonVisibleValue(offset: Int, observed_size: Int, observed_first_byte: Int, expected_fixture: String, codec_module: String, preview: ByteChunk)
	OutboundTableSizeUpdateExceeded(offset: Int, observed_size: Int, allowed_size: Int, expected_fixture: String, codec_module: String, preview: ByteChunk)
end

type HpackStringLiteral
	HpackStringLiteral(value: String, wire_size: Int)
end

type HpackStringLength
	HpackStringLength(huffman_marked: Bool, encoded_count: Int, prefix_size: Int)
end

type HpackIntegerPrefix
	HpackIntegerPrefix(value: Int, prefix_size: Int)
end

type HpackLiteralIndexing
	LiteralWithoutIndexing
	LiteralWithIndexing
	LiteralNeverIndexed
end

pub fn initial_state() -> HpackFixtureState
	HpackFixtureState(4096, 0, NoDynamicEntry)
end

pub fn initial_encode_state() -> HpackFixtureState
	HpackFixtureState(4096, 0, NoDynamicEntry)
end

fn byte_at(block: ByteChunk, index: Int) -> Result<Int, String>
	let view: ByteView = byte_view(block, byte_offset(index)?, byte_count(1)?)?
	byte_read_u8_be(view)
end

fn byte_at_or_missing(block: ByteChunk, index: Int) -> Int
	match byte_at(block, index)
		Ok(value) => value
		Err(_) => -1
	end
end

fn next_state(state: HpackFixtureState) -> HpackFixtureState
	match state
		HpackFixtureState(table_size, decode_count, dynamic_entry) => HpackFixtureState(table_size, decode_count + 1, dynamic_entry)
	end
end

fn dynamic_entry_size(name: String, value: String) -> Int
	string_byte_count(name) + string_byte_count(value) + 32
end

fn string_byte_count(value: String) -> Int
	match byte_chunk_from_visible_ascii_string(value)
		Ok(bytes) => byte_count_to_int(byte_chunk_count(bytes))
		Err(_) => 0
	end
end

fn bounded_dynamic_entry(table_size: Int, name: String, value: String, dynamic_entry: HpackDynamicEntry) -> HpackDynamicEntry
	let entry_size: Int = dynamic_entry_size(name, value)
	match entry_size > table_size
		true => NoDynamicEntry
		false => evict_for_table_size(table_size, DynamicEntry(name, value, dynamic_entry))
	end
end

fn evict_for_table_size(table_size: Int, dynamic_entry: HpackDynamicEntry) -> HpackDynamicEntry
	evict_for_remaining_table_size(table_size, dynamic_entry)
end

fn evict_for_remaining_table_size(remaining_table_size: Int, dynamic_entry: HpackDynamicEntry) -> HpackDynamicEntry
	match dynamic_entry
		NoDynamicEntry => NoDynamicEntry
		DynamicEntry(name, value, older) => match dynamic_entry_size(name, value) <= remaining_table_size
			true => DynamicEntry(name, value, evict_for_remaining_table_size(remaining_table_size - dynamic_entry_size(name, value), older))
			false => NoDynamicEntry
		end
	end
end

fn state_with_dynamic_entry(state: HpackFixtureState, name: String, value: String) -> HpackFixtureState
	match state
		HpackFixtureState(table_size, decode_count, dynamic_entry) => HpackFixtureState(table_size, decode_count + 1, bounded_dynamic_entry(table_size, name, value, dynamic_entry))
	end
end

fn state_with_table_size(state: HpackFixtureState, table_size: Int) -> HpackFixtureState
	match state
		HpackFixtureState(_, decode_count, dynamic_entry) => HpackFixtureState(table_size, decode_count + 1, evict_for_table_size(table_size, dynamic_entry))
	end
end

fn fixture_headers(label: String, wire_size: Int) -> HpackHeaderList
	HpackHeaderList(HpackHeader(":fixture", label), HpackHeader(":status", "ok"), wire_size)
end

fn static_indexed_method_get_headers() -> HpackHeaderList
	HpackHeaderList(HpackHeader(":method", "GET"), HpackHeader(":fixture", "static-indexed"), 8)
end

fn static_indexed_method_post_headers() -> HpackHeaderList
	HpackHeaderList(HpackHeader(":method", "POST"), HpackHeader(":fixture", "static-indexed"), 9)
end

fn static_indexed_path_root_headers() -> HpackHeaderList
	HpackHeaderList(HpackHeader(":path", "/"), HpackHeader(":fixture", "static-indexed"), 6)
end

fn static_indexed_path_index_headers() -> HpackHeaderList
	HpackHeaderList(HpackHeader(":path", "/index.html"), HpackHeader(":fixture", "static-indexed"), 9)
end

fn static_indexed_scheme_http_headers() -> HpackHeaderList
	HpackHeaderList(HpackHeader(":scheme", "http"), HpackHeader(":fixture", "static-indexed"), 8)
end

fn static_indexed_scheme_https_headers() -> HpackHeaderList
	HpackHeaderList(HpackHeader(":scheme", "https"), HpackHeader(":fixture", "static-indexed"), 9)
end

fn static_indexed_status_headers(value: String) -> HpackHeaderList
	HpackHeaderList(HpackHeader(":status", value), HpackHeader(":fixture", "static-indexed"), 9)
end

fn static_indexed_two_headers(first: HpackHeader, second: HpackHeader, wire_size: Int) -> HpackHeaderList
	HpackHeaderList(first, second, wire_size)
end

fn static_indexed_header(name: String, value: String) -> HpackHeaderList
	HpackHeaderList(HpackHeader(name, value), HpackHeader(":fixture", "static-indexed"), 9)
end

fn static_indexed_authority_headers() -> HpackHeaderList
	HpackHeaderList(HpackHeader(":authority", ""), HpackHeader(":fixture", "static-indexed"), 1)
end

fn dynamic_indexed_header(name: String, value: String) -> HpackHeaderList
	HpackHeaderList(HpackHeader(name, value), HpackHeader(":fixture", "dynamic-indexed"), 9)
end

fn decoded(label: String, wire_size: Int, state: HpackFixtureState) -> Result<HpackDecodeTransition, HpackFixtureFailure>
	Ok(HpackDecodeTransition(fixture_headers(label, wire_size), next_state(state)))
end

fn decoded_static_indexed_method_post(state: HpackFixtureState) -> Result<HpackDecodeTransition, HpackFixtureFailure>
	Ok(HpackDecodeTransition(static_indexed_method_post_headers(), next_state(state)))
end

fn decoded_static_indexed_method_get(state: HpackFixtureState) -> Result<HpackDecodeTransition, HpackFixtureFailure>
	Ok(HpackDecodeTransition(static_indexed_method_get_headers(), next_state(state)))
end

fn decoded_static_indexed_path_root(state: HpackFixtureState) -> Result<HpackDecodeTransition, HpackFixtureFailure>
	Ok(HpackDecodeTransition(static_indexed_path_root_headers(), next_state(state)))
end

fn decoded_static_indexed_path_index(state: HpackFixtureState) -> Result<HpackDecodeTransition, HpackFixtureFailure>
	Ok(HpackDecodeTransition(static_indexed_path_index_headers(), next_state(state)))
end

fn decoded_static_indexed_scheme_http(state: HpackFixtureState) -> Result<HpackDecodeTransition, HpackFixtureFailure>
	Ok(HpackDecodeTransition(static_indexed_scheme_http_headers(), next_state(state)))
end

fn decoded_static_indexed_scheme_https(state: HpackFixtureState) -> Result<HpackDecodeTransition, HpackFixtureFailure>
	Ok(HpackDecodeTransition(static_indexed_scheme_https_headers(), next_state(state)))
end

fn decoded_static_indexed_status(value: String, state: HpackFixtureState) -> Result<HpackDecodeTransition, HpackFixtureFailure>
	Ok(HpackDecodeTransition(static_indexed_status_headers(value), next_state(state)))
end

fn decoded_static_indexed_header(name: String, value: String, state: HpackFixtureState) -> Result<HpackDecodeTransition, HpackFixtureFailure>
	Ok(HpackDecodeTransition(static_indexed_header(name, value), next_state(state)))
end

fn decoded_static_indexed_two_headers(first: HpackHeader, second: HpackHeader, state: HpackFixtureState) -> Result<HpackDecodeTransition, HpackFixtureFailure>
	Ok(HpackDecodeTransition(static_indexed_two_headers(first, second, 2), next_state(state)))
end

fn decoded_static_indexed_authority(state: HpackFixtureState) -> Result<HpackDecodeTransition, HpackFixtureFailure>
	Ok(HpackDecodeTransition(static_indexed_authority_headers(), next_state(state)))
end

fn literal_without_indexing_headers(name: String, value: String, wire_size: Int) -> HpackHeaderList
	HpackHeaderList(HpackHeader(name, value), HpackHeader(":fixture", "literal-without-indexing"), wire_size)
end

fn literal_with_indexing_headers(name: String, value: String, wire_size: Int) -> HpackHeaderList
	HpackHeaderList(HpackHeader(name, value), HpackHeader(":fixture", "literal-with-indexing"), wire_size)
end

fn literal_never_indexed_headers(name: String, value: String, wire_size: Int) -> HpackHeaderList
	HpackHeaderList(HpackHeader(name, value), HpackHeader(":fixture", "literal-never-indexed"), wire_size)
end

fn decoded_literal_without_indexing(name: String, value: String, wire_size: Int, state: HpackFixtureState) -> Result<HpackDecodeTransition, HpackFixtureFailure>
	Ok(HpackDecodeTransition(literal_without_indexing_headers(name, value, wire_size), next_state(state)))
end

fn decoded_literal_with_indexing(name: String, value: String, wire_size: Int, state: HpackFixtureState) -> Result<HpackDecodeTransition, HpackFixtureFailure>
	Ok(HpackDecodeTransition(literal_with_indexing_headers(name, value, wire_size), state_with_dynamic_entry(state, name, value)))
end

fn decoded_literal_never_indexed(name: String, value: String, wire_size: Int, state: HpackFixtureState) -> Result<HpackDecodeTransition, HpackFixtureFailure>
	Ok(HpackDecodeTransition(literal_never_indexed_headers(name, value, wire_size), next_state(state)))
end

fn dynamic_entry_at(dynamic_entry: HpackDynamicEntry, table_index: Int) -> Option<HpackHeader>
	match dynamic_entry
		NoDynamicEntry => None
		DynamicEntry(name, value, older) => match table_index == 0
			true => Some(HpackHeader(name, value))
			false => dynamic_entry_at(older, table_index - 1)
		end
	end
end

fn dynamic_entry_count(dynamic_entry: HpackDynamicEntry) -> Int
	match dynamic_entry
		NoDynamicEntry => 0
		DynamicEntry(_, _, older) => 1 + dynamic_entry_count(older)
	end
end

fn state_dynamic_entry_count(state: HpackFixtureState) -> Int
	match state
		HpackFixtureState(_, _, dynamic_entry) => dynamic_entry_count(dynamic_entry)
	end
end

fn decoded_dynamic_indexed_header_at(table_index: Int, state: HpackFixtureState, block: ByteChunk, offset: Int) -> Result<HpackDecodeTransition, HpackFixtureFailure>
	match state
		HpackFixtureState(_, _, dynamic_entry) => match dynamic_entry_at(dynamic_entry, table_index)
			Some(HpackHeader(name, value)) => Ok(HpackDecodeTransition(dynamic_indexed_header(name, value), next_state(state)))
			None => dynamic_index_out_of_range(block, offset, table_index, dynamic_entry_count(dynamic_entry))
		end
	end
end

fn dynamic_header_name_at(table_index: Int, state: HpackFixtureState) -> Option<String>
	match state
		HpackFixtureState(_, _, dynamic_entry) => match dynamic_entry_at(dynamic_entry, table_index)
			Some(HpackHeader(name, _)) => Some(name)
			None => None
		end
	end
end

fn decoded_table_size_update(state: HpackFixtureState, table_size: Int) -> Result<HpackDecodeTransition, HpackFixtureFailure>
	Ok(HpackDecodeTransition(fixture_headers("table-size-update", 0), state_with_table_size(state, table_size)))
end

fn low_seven_bits(byte: Int) -> Int
	byte - (byte / 128) * 128
end

fn decode_hpack_prefixed_integer_tail_byte(current: Int, block: ByteChunk, observed_size: Int, index: Int, multiplier: Int, value: Int, offset: Int) -> Result<HpackIntegerPrefix, HpackFixtureFailure>
	let next_value: Int = value + low_seven_bits(current) * multiplier
	match current < 128
		true => Ok(HpackIntegerPrefix(next_value, index + 1))
		false => decode_hpack_prefixed_integer_tail(block, observed_size, index + 1, multiplier * 128, next_value, offset)
	end
end

fn decode_hpack_prefixed_integer_tail(block: ByteChunk, observed_size: Int, index: Int, multiplier: Int, value: Int, offset: Int) -> Result<HpackIntegerPrefix, HpackFixtureFailure>
	match index < observed_size
		false => unsupported_integer_prefix(block, offset)
		true => decode_hpack_prefixed_integer_tail_byte(byte_at_or_missing(block, index), block, observed_size, index, multiplier, value, offset)
	end
end

fn decode_hpack_prefixed_integer(prefix_value: Int, prefix_max: Int, block: ByteChunk, observed_size: Int, next_index: Int, offset: Int) -> Result<HpackIntegerPrefix, HpackFixtureFailure>
	match prefix_value < prefix_max
		true => Ok(HpackIntegerPrefix(prefix_value, next_index))
		false => decode_hpack_prefixed_integer_tail(block, observed_size, next_index, 1, prefix_max, offset)
	end
end

fn decode_saturated_table_size_update(block: ByteChunk, observed_size: Int, state: HpackFixtureState, offset: Int) -> Result<HpackDecodeTransition, HpackFixtureFailure>
	match decode_hpack_prefixed_integer(31, 31, block, observed_size, 1, offset)
		Ok(prefix) => match integer_prefix_size(prefix) == observed_size
			true => decoded_table_size_update(state, integer_prefix_value(prefix))
			false => unsupported(block, offset)
		end
		Err(failure) => Err(failure)
	end
end

fn integer_prefix_value(prefix: HpackIntegerPrefix) -> Int
	match prefix
		HpackIntegerPrefix(value, _) => value
	end
end

fn integer_prefix_size(prefix: HpackIntegerPrefix) -> Int
	match prefix
		HpackIntegerPrefix(_, prefix_size) => prefix_size
	end
end

fn decode_dynamic_name_index(first_byte: Int, observed_size: Int, block: ByteChunk, offset: Int) -> Result<HpackIntegerPrefix, HpackFixtureFailure>
	match first_byte >= 126 and first_byte <= 127
		true => decode_hpack_prefixed_integer(first_byte - 64, 63, block, observed_size, 1, offset)
		false => unsupported_integer_prefix(block, offset)
	end
end

fn decode_four_bit_dynamic_name_index(first_byte: Int, prefix_base: Int, observed_size: Int, block: ByteChunk, offset: Int) -> Result<HpackIntegerPrefix, HpackFixtureFailure>
	let prefix_value: Int = first_byte - prefix_base
	match prefix_value >= 0 and prefix_value <= 15
		true => decode_hpack_prefixed_integer(prefix_value, 15, block, observed_size, 1, offset)
		false => unsupported_integer_prefix(block, offset)
	end
end

fn unsupported(block: ByteChunk, offset: Int) -> Result<HpackDecodeTransition, HpackFixtureFailure>
	Err(UnsupportedHeaderBlock(offset, byte_count_to_int(byte_chunk_count(block)), byte_at_or_missing(block, 0), "fixture header block", "hpack_fixture", block))
end

fn dynamic_index_out_of_range(block: ByteChunk, offset: Int, requested_dynamic_index: Int, dynamic_table_entry_count: Int) -> Result<HpackDecodeTransition, HpackFixtureFailure>
	Err(DynamicIndexOutOfRange(offset, byte_count_to_int(byte_chunk_count(block)), byte_at_or_missing(block, 0), requested_dynamic_index, dynamic_table_entry_count, "fixture dynamic indexed header", "hpack_fixture", block))
end

fn dynamic_name_continuation_missing(block: ByteChunk, offset: Int, requested_dynamic_index: Int, dynamic_table_entry_count: Int) -> Result<HpackDecodeTransition, HpackFixtureFailure>
	Err(DynamicNameContinuationMissing(offset, byte_count_to_int(byte_chunk_count(block)), byte_at_or_missing(block, 0), requested_dynamic_index, dynamic_table_entry_count, "fixture dynamic-name continuation entry", "hpack_fixture", block))
end

fn dynamic_name_continuation_malformed(block: ByteChunk, offset: Int, dynamic_table_entry_count: Int) -> Result<HpackDecodeTransition, HpackFixtureFailure>
	Err(DynamicNameContinuationMalformed(offset, byte_count_to_int(byte_chunk_count(block)), byte_at_or_missing(block, 0), -1, dynamic_table_entry_count, "fixture dynamic-name continuation integer", "hpack_fixture", block))
end

fn dynamic_name_continuation_out_of_range(block: ByteChunk, offset: Int, requested_dynamic_index: Int, dynamic_table_entry_count: Int) -> Result<HpackDecodeTransition, HpackFixtureFailure>
	Err(DynamicNameContinuationOutOfRange(offset, byte_count_to_int(byte_chunk_count(block)), byte_at_or_missing(block, 0), requested_dynamic_index, dynamic_table_entry_count, "fixture dynamic-name continuation range", "hpack_fixture", block))
end

fn unsupported_string_literal(block: ByteChunk, offset: Int) -> Result<HpackStringLiteral, HpackFixtureFailure>
	Err(UnsupportedHeaderBlock(offset, byte_count_to_int(byte_chunk_count(block)), byte_at_or_missing(block, 0), "fixture header block", "hpack_fixture", block))
end

fn unsupported_string_length(block: ByteChunk, offset: Int) -> Result<HpackStringLength, HpackFixtureFailure>
	Err(UnsupportedHeaderBlock(offset, byte_count_to_int(byte_chunk_count(block)), byte_at_or_missing(block, 0), "fixture header block", "hpack_fixture", block))
end

fn unsupported_integer_prefix(block: ByteChunk, offset: Int) -> Result<HpackIntegerPrefix, HpackFixtureFailure>
	Err(UnsupportedHeaderBlock(offset, byte_count_to_int(byte_chunk_count(block)), byte_at_or_missing(block, 0), "fixture header block", "hpack_fixture", block))
end

fn unsupported_byte_chunk(block: ByteChunk, offset: Int) -> Result<ByteChunk, HpackFixtureFailure>
	Err(UnsupportedHeaderBlock(offset, byte_count_to_int(byte_chunk_count(block)), byte_at_or_missing(block, 0), "fixture header block", "hpack_fixture", block))
end

fn huffman_non_visible_value(block: ByteChunk, offset: Int) -> Result<ByteChunk, HpackFixtureFailure>
	Err(HuffmanNonVisibleValue(offset, byte_count_to_int(byte_chunk_count(block)), byte_at_or_missing(block, 0), "fixture HPACK Huffman checked header value", "hpack_fixture", block))
end

fn unsupported_raw_string_encoding(value: String, offset: Int) -> Result<ByteChunk, HpackFixtureFailure>
	let preview: ByteChunk = hpack_raw_string_unsupported_preview(value)
	Err(UnsupportedHeaderBlock(offset, byte_count_to_int(byte_chunk_count(preview)), byte_at_or_missing(preview, 0), "fixture raw string encoding", "hpack_fixture", preview))
end

fn hpack_raw_string_unsupported_preview(value: String) -> ByteChunk
	match value
		"bad" => match byte_chunk_from_hex("626164")
			Ok(preview) => preview
			Err(_) => byte_chunk([])
		end
		"\n" => match byte_chunk_from_hex("0a")
			Ok(preview) => preview
			Err(_) => byte_chunk([])
		end
		"hpack-byte-00" => match byte_chunk_from_hex("00")
			Ok(preview) => preview
			Err(_) => byte_chunk([])
		end
		_ => byte_chunk([])
	end
end

pub fn hpack_fixture_long_raw_string_value() -> String
	"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
end

fn hpack_fixture_raw_string_value_bytes(value: String, offset: Int) -> Result<ByteChunk, HpackFixtureFailure>
	match byte_chunk_from_visible_ascii_string(value)
		Ok(bytes) => Ok(bytes)
		Err(_) => unsupported_raw_string_encoding(value, offset)
	end
end

fn hpack_fixture_raw_string_length_prefix(count: Int, value: String, offset: Int) -> Result<ByteChunk, HpackFixtureFailure>
	match count < 127
		true => hpack_fixture_raw_string_length_prefix_byte(count, value, offset)
		false => match hpack_fixture_raw_string_length_prefix_byte(127, value, offset)
			Ok(prefix) => match hpack_fixture_raw_string_length_tail(count - 127, value, offset)
				Ok(tail) => Ok(byte_append(prefix, tail))
				Err(failure) => Err(failure)
			end
			Err(failure) => Err(failure)
		end
	end
end

fn hpack_fixture_raw_string_length_tail(remaining: Int, value: String, offset: Int) -> Result<ByteChunk, HpackFixtureFailure>
	match remaining < 128
		true => hpack_fixture_raw_string_length_prefix_byte(remaining, value, offset)
		false => match hpack_fixture_raw_string_length_prefix_byte((remaining - (remaining / 128) * 128) + 128, value, offset)
			Ok(current) => match hpack_fixture_raw_string_length_tail(remaining / 128, value, offset)
				Ok(next) => Ok(byte_append(current, next))
				Err(failure) => Err(failure)
			end
			Err(failure) => Err(failure)
		end
	end
end

fn hpack_fixture_raw_string_length_prefix_byte(value_byte: Int, value: String, offset: Int) -> Result<ByteChunk, HpackFixtureFailure>
	match byte_write_u8_be(value_byte)
		Ok(prefix) => Ok(prefix)
		Err(_) => unsupported_raw_string_encoding(value, offset)
	end
end

pub fn encode_hpack_raw_string_literal(value: String, offset: Int) -> Result<ByteChunk, HpackFixtureFailure>
	match hpack_fixture_raw_string_value_bytes(value, offset)
		Ok(bytes) => match hpack_fixture_raw_string_length_prefix(byte_count_to_int(byte_chunk_count(bytes)), value, offset)
			Ok(prefix) => Ok(byte_append(prefix, bytes))
			Err(failure) => Err(failure)
		end
		Err(failure) => Err(failure)
	end
end

pub fn outbound_literal_path_target_headers() -> HpackHeaderList
	HpackHeaderList(HpackHeader(":path", "/target"), HpackHeader(":fixture", "literal-with-indexing"), 9)
end

pub fn outbound_literal_indexed_path_target_headers() -> HpackHeaderList
	HpackHeaderList(HpackHeader(":path", "/target"), HpackHeader(":fixture", "literal-with-indexing"), 9)
end

pub fn outbound_static_indexed_method_get_headers() -> HpackHeaderList
	HpackHeaderList(HpackHeader(":method", "GET"), HpackHeader(":fixture", "static-indexed"), 8)
end

fn encoded_hex_or_failure(hex: String, headers: HpackHeaderList, offset: Int) -> Result<ByteChunk, HpackFixtureFailure>
	match byte_chunk_from_hex(hex)
		Ok(chunk) => Ok(chunk)
		Err(_) => unsupported_header_list_encoding(headers, offset)
	end
end

fn unsupported_header_list_preview(headers: HpackHeaderList) -> ByteChunk
	match headers
		HpackHeaderList(HpackHeader(name, _), _, _) => match byte_chunk_from_visible_ascii_string(name)
			Ok(preview) => preview
			Err(_) => byte_chunk([])
		end
	end
end

fn unsupported_header_list_encoding(headers: HpackHeaderList, offset: Int) -> Result<ByteChunk, HpackFixtureFailure>
	let preview: ByteChunk = unsupported_header_list_preview(headers)
	Err(UnsupportedHeaderBlock(offset, byte_count_to_int(byte_chunk_count(preview)), byte_at_or_missing(preview, 0), "fixture header list encoding", "hpack_fixture", preview))
end

fn outbound_table_size_update_exceeded(offset: Int, table_size: Int, allowed_size: Int) -> Result<HpackEncodeTransition, HpackFixtureFailure>
	let preview: ByteChunk = byte_chunk([])
	Err(OutboundTableSizeUpdateExceeded(offset, table_size, allowed_size, "fixture outbound table-size update", "hpack_fixture", preview))
end

fn literal_static_name_index(name: String) -> Int
	match name
		":authority" => 1
		":method" => 2
		":path" => 4
		":scheme" => 6
		":status" => 8
		_ => -1
	end
end

fn encode_static_indexed_header(name: String, value: String, headers: HpackHeaderList, offset: Int) -> Result<ByteChunk, HpackFixtureFailure>
	match name == ":authority" and value == ""
		true => encoded_hex_or_failure("81", headers, offset)
		false => match name == ":method" and value == "GET"
			true => encoded_hex_or_failure("82", headers, offset)
			false => match name == ":method" and value == "POST"
				true => encoded_hex_or_failure("83", headers, offset)
				false => match name == ":path" and value == "/"
					true => encoded_hex_or_failure("84", headers, offset)
					false => unsupported_header_list_encoding(headers, offset)
				end
			end
		end
	end
end

fn encode_literal_header_with_prefix(name: String, value: String, prefix_offset: Int, headers: HpackHeaderList, offset: Int) -> Result<ByteChunk, HpackFixtureFailure>
	let index: Int = literal_static_name_index(name)
	match index < 0
		true => unsupported_header_list_encoding(headers, offset)
		false => match byte_write_u8_be(prefix_offset + index)
			Ok(prefix) => match encode_hpack_raw_string_literal(value, offset)
				Ok(encoded_value) => Ok(byte_append(prefix, encoded_value))
				Err(failure) => Err(failure)
			end
			Err(_) => unsupported_header_list_encoding(headers, offset)
		end
	end
end

pub fn encode_header_list(headers: HpackHeaderList, offset: Int) -> Result<ByteChunk, HpackFixtureFailure>
	match encode_header_list_with_state(headers, initial_encode_state(), offset)
		Ok(transition) => Ok(encode_transition_bytes(transition))
		Err(failure) => Err(failure)
	end
end

pub fn encode_header_list_with_state(headers: HpackHeaderList, state: HpackFixtureState, offset: Int) -> Result<HpackEncodeTransition, HpackFixtureFailure>
	let dynamic_index: Int = matching_dynamic_index(headers, state)
	match dynamic_index < 0
		true => encode_non_dynamic_header_list(headers, state, offset)
		false => encode_dynamic_indexed_header_list(dynamic_index, headers, state, offset)
	end
end

pub fn encode_table_size_update_with_state(table_size: Int, peer_advertised_limit: Int, state: HpackFixtureState, offset: Int) -> Result<HpackEncodeTransition, HpackFixtureFailure>
	match table_size > peer_advertised_limit
		true => outbound_table_size_update_exceeded(offset, table_size, peer_advertised_limit)
		false => encode_valid_table_size_update_with_state(table_size, state, offset)
	end
end

fn encode_valid_table_size_update_with_state(table_size: Int, state: HpackFixtureState, offset: Int) -> Result<HpackEncodeTransition, HpackFixtureFailure>
	match table_size < 31
		true => encode_table_size_update_prefix_byte(32 + table_size, table_size, state, offset)
		false => match byte_write_u8_be(63)
			Ok(prefix) => match encode_hpack_integer_tail(table_size - 31, offset)
				Ok(tail) => Ok(HpackEncodeTransition(byte_append(prefix, tail), state_with_table_size(state, table_size)))
				Err(failure) => Err(failure)
			end
			Err(_) => outbound_table_size_update_exceeded(offset, table_size, table_size)
		end
	end
end

fn encode_table_size_update_prefix_byte(value: Int, table_size: Int, state: HpackFixtureState, offset: Int) -> Result<HpackEncodeTransition, HpackFixtureFailure>
	match byte_write_u8_be(value)
		Ok(encoded) => Ok(HpackEncodeTransition(encoded, state_with_table_size(state, table_size)))
		Err(_) => outbound_table_size_update_exceeded(offset, table_size, table_size)
	end
end

fn encode_hpack_integer_tail(remaining: Int, offset: Int) -> Result<ByteChunk, HpackFixtureFailure>
	match remaining < 128
		true => encode_hpack_integer_tail_byte(remaining, offset)
		false => match encode_hpack_integer_tail_byte((remaining - (remaining / 128) * 128) + 128, offset)
			Ok(current) => match encode_hpack_integer_tail(remaining / 128, offset)
				Ok(next) => Ok(byte_append(current, next))
				Err(failure) => Err(failure)
			end
			Err(failure) => Err(failure)
		end
	end
end

fn encode_hpack_integer_tail_byte(value: Int, offset: Int) -> Result<ByteChunk, HpackFixtureFailure>
	match byte_write_u8_be(value)
		Ok(encoded) => Ok(encoded)
		Err(_) => Err(UnsupportedHeaderBlock(offset, 0, -1, "fixture HPACK integer encoding", "hpack_fixture", byte_chunk([])))
	end
end

fn encode_non_dynamic_header_list(headers: HpackHeaderList, state: HpackFixtureState, offset: Int) -> Result<HpackEncodeTransition, HpackFixtureFailure>
	match headers
		HpackHeaderList(HpackHeader(name, value), HpackHeader(":fixture", "static-indexed"), _) => encode_header_list_transition(encode_static_indexed_header(name, value, headers, offset), next_state(state))
		HpackHeaderList(HpackHeader(name, value), HpackHeader(":fixture", "literal-without-indexing"), _) => encode_header_list_transition(encode_literal_header_with_prefix(name, value, 0, headers, offset), next_state(state))
		HpackHeaderList(HpackHeader(name, value), HpackHeader(":fixture", "literal-with-indexing"), _) => encode_header_list_transition(encode_literal_header_with_prefix(name, value, 64, headers, offset), state_with_dynamic_entry(state, name, value))
		_ => encode_header_list_transition(unsupported_header_list_encoding(headers, offset), state)
	end
end

fn encode_header_list_transition(encoded: Result<ByteChunk, HpackFixtureFailure>, state: HpackFixtureState) -> Result<HpackEncodeTransition, HpackFixtureFailure>
	match encoded
		Ok(bytes) => Ok(HpackEncodeTransition(bytes, state))
		Err(failure) => Err(failure)
	end
end

fn encode_dynamic_indexed_header_list(dynamic_index: Int, headers: HpackHeaderList, state: HpackFixtureState, offset: Int) -> Result<HpackEncodeTransition, HpackFixtureFailure>
	match byte_write_u8_be(190 + dynamic_index)
		Ok(encoded) => Ok(HpackEncodeTransition(encoded, next_state(state)))
		Err(_) => encode_header_list_transition(unsupported_header_list_encoding(headers, offset), state)
	end
end

fn matching_dynamic_index(headers: HpackHeaderList, state: HpackFixtureState) -> Int
	match headers
		HpackHeaderList(HpackHeader(name, value), _, _) => match state
			HpackFixtureState(_, _, dynamic_entry) => matching_dynamic_entry_index(dynamic_entry, name, value, 0)
		end
	end
end

fn matching_dynamic_entry_index(dynamic_entry: HpackDynamicEntry, name: String, value: String, index: Int) -> Int
	match dynamic_entry
		NoDynamicEntry => -1
		DynamicEntry(entry_name, entry_value, older) => match entry_name == name and entry_value == value
			true => index
			false => matching_dynamic_entry_index(older, name, value, index + 1)
		end
	end
end

pub fn encode_transition_bytes(transition: HpackEncodeTransition) -> ByteChunk
	match transition
		HpackEncodeTransition(encoded, _) => encoded
	end
end

pub fn encode_transition_state(transition: HpackEncodeTransition) -> HpackFixtureState
	match transition
		HpackEncodeTransition(_, state) => state
	end
end

fn string_literal_value(literal: HpackStringLiteral) -> String
	match literal
		HpackStringLiteral(value, _) => value
	end
end

fn string_literal_wire_size(literal: HpackStringLiteral) -> Int
	match literal
		HpackStringLiteral(_, wire_size) => wire_size
	end
end

fn pow2(value: Int) -> Int
	match value
		0 => 1
		1 => 2
		2 => 4
		3 => 8
		4 => 16
		5 => 32
		6 => 64
		7 => 128
		_ => 256
	end
end

fn byte_bit(byte: Int, bit_index: Int) -> Int
	let divisor: Int = pow2(7 - bit_index)
	byte / divisor - (byte / (divisor * 2)) * 2
end

