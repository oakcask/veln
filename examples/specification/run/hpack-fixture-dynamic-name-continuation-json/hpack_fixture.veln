pub fn failure_preview(failure: HpackFixtureFailure) -> ByteChunk
	match failure
		UnsupportedHeaderBlock(_, _, _, _, _, preview) => preview
		DynamicIndexOutOfRange(_, _, _, _, _, _, _, preview) => preview
		DynamicNameContinuationMissing(_, _, _, _, _, _, _, preview) => preview
		DynamicNameContinuationMalformed(_, _, _, _, _, _, _, preview) => preview
		DynamicNameContinuationOutOfRange(_, _, _, _, _, _, _, preview) => preview
