# Production loopback cancellable deadline-aware writes return adapter values.
use stdio

fn write_outcome_text(outcome: StreamWriteOutcome) -> String
	match outcome
		WriteCompleted => "write-completed"
		WriteDeadlineExpired => "write-deadline"
		WriteCancelled => "write-cancelled"
	end
end

fn close_and_return(listener: NetListener, stream: NetStream, decision: String) -> String effects [net]
	net::close_stream(stream)
	net::close_listener(listener)
	decision
end

fn write_success_decision() -> Result<String, String> effects [net, time]
	let listener: NetListener = net::listen("127.0.0.1:0")
	let stream: NetStream = net::accept(listener)
	let outgoing: ByteChunk = byte_chunk_from_hex("0a0b")?
	let deadline: Deadline = time::deadline_after_ms(100)
	let token: CancelToken = time::cancel_token()
	Ok(close_and_return(listener, stream, write_outcome_text(net::write_chunk_until_cancellable(stream, outgoing, deadline, token))))
end

fn write_deadline_decision() -> Result<String, String> effects [net, time]
	let listener: NetListener = net::listen("127.0.0.1:0")
	let stream: NetStream = net::accept(listener)
	let outgoing: ByteChunk = byte_chunk_from_hex("0a0b")?
	let deadline: Deadline = time::deadline_after_ms(0)
	let token: CancelToken = time::cancel_token()
	Ok(close_and_return(listener, stream, write_outcome_text(net::write_chunk_until_cancellable(stream, outgoing, deadline, token))))
end

fn write_cancel_decision() -> Result<String, String> effects [net, time]
	let listener: NetListener = net::listen("127.0.0.1:0")
	let stream: NetStream = net::accept(listener)
	let outgoing: ByteChunk = byte_chunk_from_hex("0a0b")?
	let deadline: Deadline = time::deadline_after_ms(100)
	let token: CancelToken = time::cancel_token()
	time::cancel(token)
	Ok(close_and_return(listener, stream, write_outcome_text(net::write_chunk_until_cancellable(stream, outgoing, deadline, token))))
end

pub fn main() -> Result<(), String> effects [net, time, stdio]
	stdio::print(write_success_decision()?)
	stdio::print(",")
	stdio::print(write_deadline_decision()?)
	stdio::print(",")
	stdio::println(write_cancel_decision()?)
	Ok(())
end
