# Nested dispatch reserved-bit payloads decode and encode through schema helpers.
use stdio

schema PackedReservedPayload
	format binary

	prefix: ReservedBits(2, 1)
	value: UInt6
end

schema ByteReservedPayload
	format binary

	marker: ReservedBits(8, 171)
	code: UInt8
end

schema OneBitReservedPayload
	format binary

	padding: ReservedBits(1, 0)
	value: UInt8
end

schema ClosedReservedPacket
	format binary

	kind: UInt8
	payload: Dispatch(kind, 1 => PackedReservedPayload)
end

schema ClosedOneBitReservedPacket
	format binary

	kind: UInt8
	payload: Dispatch(kind, 1 => OneBitReservedPayload)
end

schema ExtensionReservedPacket
	format binary

	length: UInt8
	kind: UInt8
	payload: ExtensionDispatch(kind, length, 1 => ByteReservedPayload)
end

fn emit_output_chunk(name: String, index: Int, chunk: ByteChunk, expected_hex: String) -> () effects [stdio]
	stdio::print("output_chunk ")
	stdio::print(name)
	stdio::print(" index ")
	stdio::print(int_to_string(index))
	stdio::print(" hex \"")
	stdio::print(expected_hex)
	stdio::print("\" count ")
	stdio::println(int_to_string(byte_count_to_int(byte_chunk_count(chunk))))
end

fn emit_output_chunk_list_header(name: String, count: Int) -> () effects [stdio]
	stdio::print("output_chunk_list ")
	stdio::print(name)
	stdio::print(" count ")
	stdio::println(int_to_string(count))
end

fn emit_encoded_chunk(name: String, bytes: ByteChunk, expected_hex: String) -> () effects [stdio]
	emit_output_chunk_list_header(name, 1)
	emit_output_chunk(name, 0, bytes, expected_hex)
end

fn emit_encoded(name: String, encoded: Result<ByteChunk, EncodeError>, expected_hex: String) -> () effects [stdio]
	match encoded
		Ok(bytes) => emit_encoded_chunk(name, bytes, expected_hex)
		Err(_) => stdio::println("unexpected encode failure")
	end
end

fn emit_closed_decode(packet: {kind: Int, payload: {value: Int}}) -> () effects [stdio]
	stdio::print("closed-decode ")
	stdio::print(int_to_string(packet.kind))
	stdio::print(" ")
	stdio::println(int_to_string(packet.payload.value))
end

fn emit_extension_decode(packet: {length: Int, kind: Int, payload: SchemaDispatchPayload<{code: Int}>}) -> () effects [stdio]
	stdio::print("extension-decode ")
	stdio::print(int_to_string(packet.length))
	stdio::print(" ")
	stdio::print(int_to_string(packet.kind))
	stdio::print(" ")
	match packet.payload
		Known(value) => stdio::println(int_to_string(value.code))
		Unknown(_, _) => stdio::println("unexpected unknown")
	end
end

fn emit_extension_roundtrip(packet: {length: Int, kind: Int, payload: SchemaDispatchPayload<{code: Int}>}) -> () effects [stdio]
	match packet.payload
		Known(value) => emit_encoded("extension-reserved-roundtrip", byte_encode_extension_reserved_packet({length: packet.length, kind: packet.kind, payload: Known(value)}), "0201ab07")
		Unknown(_, _) => stdio::println("unexpected unknown")
	end
end

fn emit_one_bit_decode(packet: {kind: Int, payload: {value: Int}}) -> () effects [stdio]
	stdio::print("one-bit-decode ")
	stdio::print(int_to_string(packet.kind))
	stdio::print(" ")
	stdio::println(int_to_string(packet.payload.value))
end

pub fn main() -> Result<(), String> effects [stdio]
	let closed_bytes: ByteChunk = byte_chunk_from_hex("014a")?
	let closed_view: ByteView = byte_view(closed_bytes, byte_offset(0)?, byte_count(2)?)?
	let closed: {kind: Int, payload: {value: Int}} = byte_decode_closed_reserved_packet(closed_view)?
	emit_closed_decode(closed)
	emit_encoded("closed-reserved-roundtrip", byte_encode_closed_reserved_packet(closed), "014a")

	let one_bit_bytes: ByteChunk = byte_chunk_from_hex("010180")?
	let one_bit_view: ByteView = byte_view(one_bit_bytes, byte_offset(0)?, byte_count(3)?)?
	let one_bit: {kind: Int, payload: {value: Int}} = byte_decode_closed_one_bit_reserved_packet(one_bit_view)?
	emit_one_bit_decode(one_bit)
	emit_encoded("one-bit-reserved-roundtrip", byte_encode_closed_one_bit_reserved_packet(one_bit), "010180")

	let extension_bytes: ByteChunk = byte_chunk_from_hex("0201ab07")?
	let extension_view: ByteView = byte_view(extension_bytes, byte_offset(0)?, byte_count(4)?)?
	let extension: {length: Int, kind: Int, payload: SchemaDispatchPayload<{code: Int}>} = byte_decode_extension_reserved_packet(extension_view)?
	emit_extension_decode(extension)
	emit_extension_roundtrip(extension)
	Ok(())
end
