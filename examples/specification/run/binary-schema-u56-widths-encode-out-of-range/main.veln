# Binary schema UInt56be and UInt56le encode rejects unrepresentable Int values.
use stdio

schema UInt56BigWidth
	format binary

	value: UInt56be
end

schema UInt56LittleWidth
	format binary

	value: UInt56le
end

fn emit_error(error: EncodeError) -> () effects [stdio]
	stdio::println(error_id(error))
	stdio::println(error_path(error))
	stdio::println(error_reason(error))
end

fn error_id(error: EncodeError) -> String
	match error
		EncodeError(id, _, _) => id
	end
end

fn error_path(error: EncodeError) -> String
	match error
		EncodeError(_, field_path, _) => field_path
	end
end

fn error_reason(error: EncodeError) -> String
	match error
		EncodeError(_, _, reason) => reason
	end
end

pub fn main() -> () effects [stdio]
	let too_large = byte_encode_uint56_big_width({value: 72057594037927936})
	match too_large
		Ok(_) => stdio::println("unexpected UInt56be encode success")
		Err(error) => emit_error(error)
	end

	let negative = byte_encode_uint56_little_width({value: -1})
	match negative
		Ok(_) => stdio::println("unexpected UInt56le encode success")
		Err(error) => emit_error(error)
	end
end
