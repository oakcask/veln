type Packet
	Packet {length: Int, kind: Int}
end

schema PacketWire
	format binary

	wire_length: UInt16be
	wire_kind: UInt8

	map to Packet
		length = wire_length
		kind = wire_kind
end

pub codec PacketCodec for PacketWire encode
	encode with encode_packet
end

fn encode_packet(packet: {length: Int, kind: Int}, chunks: List<ByteChunk>, produced: ByteCount, state: {remaining: ByteChunk, next_budget: ByteCount}) -> EncodeStep<{remaining: ByteChunk, next_budget: ByteCount}>
	match packet.kind <= packet.length
		true => match byte_count_to_int(byte_chunk_count(state.remaining)) == 0
			true => Encoded(chunks)
			false => Partial(chunks, produced, state)
		end
		false => Invalid(EncodeError("codec.out_of_range", "Packet.kind", "kind exceeds length"))
	end
end
