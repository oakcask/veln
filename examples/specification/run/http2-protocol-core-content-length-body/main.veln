use stdio

type OutboundStreamCredit
	NoOutboundStreamCredit
	OutboundOpenStreamContentLength(Int, Int, Int, Int)
	OutboundClosedStream(Int)
end

type OutboundSendCredit
	OutboundSendCredit(Int, OutboundStreamCredit)
end

type OutboundDataDecision
	OutboundDataAccepted(Int, Int, Bool, Int, OutboundSendCredit)
	OutboundDataRejected(Int, Int, Bool, Http2ProtocolFailure)
end

type Http2ProtocolFailure
	ContentLengthMismatch {offset: Int, frame_kind: Int, stream_id: Int, expected_length: Int, observed_length: Int, active_state: String, rule_provenance: String, preview: ByteView}
end

fn byte_chunk_view(bytes: ByteChunk) -> Result<ByteView, String>
	byte_view(bytes, byte_offset(0)?, byte_chunk_count(bytes))
end

fn accepted_request_send_credit() -> OutboundSendCredit
	OutboundSendCredit(20, OutboundOpenStreamContentLength(1, 20, 5, 0))
end

fn accepted_response_send_credit() -> OutboundSendCredit
	OutboundSendCredit(30, OutboundOpenStreamContentLength(1, 30, 5, 0))
end

fn send_data(stream_id: Int, payload: ByteChunk, end_stream: Bool, send_credit: OutboundSendCredit) -> Result<OutboundDataDecision, String>
	let application_length = byte_count_to_int(byte_chunk_count(payload))
	match send_credit
		OutboundSendCredit(connection_window, OutboundOpenStreamContentLength(open_stream_id, stream_window, expected_length, observed_length)) => if stream_id == open_stream_id
			validate_outbound_content_length(stream_id, payload, application_length, application_length, 1, end_stream, connection_window, stream_window, expected_length, observed_length)
		else
			Ok(OutboundDataRejected(stream_id, application_length, end_stream, ContentLengthMismatch(0, 0, stream_id, 0, application_length, "open-stream", "outbound_stream_window", byte_chunk_view(payload)?)))
		end
		OutboundSendCredit(_, _) => Ok(OutboundDataRejected(stream_id, application_length, end_stream, ContentLengthMismatch(0, 0, stream_id, 0, application_length, "open-stream", "outbound_stream_window", byte_chunk_view(payload)?)))
	end
end

fn send_padded_data(stream_id: Int, payload: ByteChunk, padding_length: Int, max_frame_size: Int, end_stream: Bool, send_credit: OutboundSendCredit) -> Result<OutboundDataDecision, String>
	let application_length = byte_count_to_int(byte_chunk_count(payload))
	let max_application_frame_payload = max_frame_size - padding_length - 1
	let encoded_length = padded_data_encoded_length(application_length, padding_length, max_application_frame_payload)
	let frame_count = padded_data_frame_count(application_length, max_application_frame_payload)
	match send_credit
		OutboundSendCredit(connection_window, OutboundOpenStreamContentLength(open_stream_id, stream_window, expected_length, observed_length)) => if stream_id == open_stream_id
			validate_outbound_content_length(stream_id, payload, encoded_length, application_length, frame_count, end_stream, connection_window, stream_window, expected_length, observed_length)
		else
			Ok(OutboundDataRejected(stream_id, encoded_length, end_stream, ContentLengthMismatch(0, 0, stream_id, 0, application_length, "open-stream", "outbound_stream_window", byte_chunk_view(payload)?)))
		end
		OutboundSendCredit(_, _) => Ok(OutboundDataRejected(stream_id, encoded_length, end_stream, ContentLengthMismatch(0, 0, stream_id, 0, application_length, "open-stream", "outbound_stream_window", byte_chunk_view(payload)?)))
	end
end

fn padded_data_encoded_length(remaining_length: Int, padding_length: Int, max_application_frame_payload: Int) -> Int
	if remaining_length > max_application_frame_payload
		max_application_frame_payload + padding_length + 1 + padded_data_encoded_length(remaining_length - max_application_frame_payload, padding_length, max_application_frame_payload)
	else
		remaining_length + padding_length + 1
	end
end

fn padded_data_frame_count(remaining_length: Int, max_application_frame_payload: Int) -> Int
	if remaining_length > max_application_frame_payload
		1 + padded_data_frame_count(remaining_length - max_application_frame_payload, max_application_frame_payload)
	else
		1
	end
end

fn validate_outbound_content_length(stream_id: Int, payload: ByteChunk, encoded_length: Int, application_length: Int, output_frames: Int, end_stream: Bool, connection_window: Int, stream_window: Int, expected_length: Int, observed_length: Int) -> Result<OutboundDataDecision, String>
	let next_observed_length = observed_length + application_length
	if next_observed_length > expected_length
		Ok(OutboundDataRejected(stream_id, encoded_length, end_stream, ContentLengthMismatch(0, 0, stream_id, expected_length, next_observed_length, "open-stream", "rfc9113_content_length_body", byte_chunk_view(payload)?)))
	else if end_stream and next_observed_length < expected_length
		Ok(OutboundDataRejected(stream_id, encoded_length, end_stream, ContentLengthMismatch(0, 0, stream_id, expected_length, next_observed_length, "open-stream", "rfc9113_content_length_body", byte_chunk_view(payload)?)))
	else
		Ok(OutboundDataAccepted(encoded_length, application_length, end_stream, output_frames, data_sent_send_credit(stream_id, end_stream, connection_window - encoded_length, stream_window - encoded_length, expected_length, next_observed_length)))
	end
end

fn data_sent_send_credit(stream_id: Int, end_stream: Bool, connection_window: Int, stream_window: Int, expected_length: Int, observed_length: Int) -> OutboundSendCredit
	if end_stream
		OutboundSendCredit(connection_window, OutboundClosedStream(stream_id))
	else
		OutboundSendCredit(connection_window, OutboundOpenStreamContentLength(stream_id, stream_window, expected_length, observed_length))
	end
end

fn decision_send_credit(decision: OutboundDataDecision) -> OutboundSendCredit
	match decision
		OutboundDataAccepted(_, _, _, _, send_credit) => send_credit
		OutboundDataRejected(_, _, _, _) => OutboundSendCredit(0, NoOutboundStreamCredit)
	end
end

fn send_credit_connection_window(send_credit: OutboundSendCredit) -> Int
	match send_credit
		OutboundSendCredit(connection_window, _) => connection_window
	end
end

fn send_credit_open_stream(send_credit: OutboundSendCredit) -> Int
	match send_credit
		OutboundSendCredit(_, OutboundOpenStreamContentLength(stream_id, _, _, _)) => stream_id
		OutboundSendCredit(_, _) => 0
	end
end

fn send_credit_closed_stream(send_credit: OutboundSendCredit) -> Int
	match send_credit
		OutboundSendCredit(_, OutboundClosedStream(stream_id)) => stream_id
		OutboundSendCredit(_, _) => 0
	end
end

fn send_credit_stream_window(send_credit: OutboundSendCredit) -> Int
	match send_credit
		OutboundSendCredit(_, OutboundOpenStreamContentLength(_, stream_window, _, _)) => stream_window
		OutboundSendCredit(_, _) => 0
	end
end

fn send_credit_expected(send_credit: OutboundSendCredit) -> Int
	match send_credit
		OutboundSendCredit(_, OutboundOpenStreamContentLength(_, _, expected_length, _)) => expected_length
		OutboundSendCredit(_, _) => 0
	end
end

fn send_credit_observed(send_credit: OutboundSendCredit) -> Int
	match send_credit
		OutboundSendCredit(_, OutboundOpenStreamContentLength(_, _, _, observed_length)) => observed_length
		OutboundSendCredit(_, _) => 0
	end
end

fn decision_status(decision: OutboundDataDecision) -> String
	match decision
		OutboundDataAccepted(_, _, _, _, _) => "accepted"
		OutboundDataRejected(_, _, _, _) => "rejected"
	end
end

fn decision_encoded_length(decision: OutboundDataDecision) -> Int
	match decision
		OutboundDataAccepted(encoded_length, _, _, _, _) => encoded_length
		OutboundDataRejected(_, encoded_length, _, _) => encoded_length
	end
end

fn decision_application_length(decision: OutboundDataDecision) -> Int
	match decision
		OutboundDataAccepted(_, application_length, _, _, _) => application_length
		OutboundDataRejected(_, _, _, failure) => failure_observed_length(failure)
	end
end

fn decision_end_stream(decision: OutboundDataDecision) -> Int
	match decision
		OutboundDataAccepted(_, _, end_stream, _, _) => bool_to_int(end_stream)
		OutboundDataRejected(_, _, end_stream, _) => bool_to_int(end_stream)
	end
end

fn decision_output_frames(decision: OutboundDataDecision) -> Int
	match decision
		OutboundDataAccepted(_, _, _, output_frames, _) => output_frames
		OutboundDataRejected(_, _, _, _) => 0
	end
end

fn failure_observed_length(failure: Http2ProtocolFailure) -> Int
	match failure
		ContentLengthMismatch(_, _, _, _, observed_length, _, _, _) => observed_length
	end
end

fn bool_to_int(value: Bool) -> Int
	if value
		1
	else
		0
	end
end

fn print_outbound_data(label: String, decision: OutboundDataDecision) -> () effects [stdio]
	let send_credit = decision_send_credit(decision)
	stdio::print(label)
	stdio::print(" ")
	stdio::print(decision_status(decision))
	stdio::print(" encoded_length ")
	stdio::print(int_to_string(decision_encoded_length(decision)))
	stdio::print(" application_length ")
	stdio::print(int_to_string(decision_application_length(decision)))
	stdio::print(" end_stream ")
	stdio::print(int_to_string(decision_end_stream(decision)))
	stdio::print(" connection_window ")
	stdio::print(int_to_string(send_credit_connection_window(send_credit)))
	stdio::print(" open_stream ")
	stdio::print(int_to_string(send_credit_open_stream(send_credit)))
	stdio::print(" closed_stream ")
	stdio::print(int_to_string(send_credit_closed_stream(send_credit)))
	stdio::print(" stream_window ")
	stdio::print(int_to_string(send_credit_stream_window(send_credit)))
	stdio::print(" expected ")
	stdio::print(int_to_string(send_credit_expected(send_credit)))
	stdio::print(" observed ")
	stdio::print(int_to_string(send_credit_observed(send_credit)))
	stdio::print(" output_frames ")
	stdio::println(int_to_string(decision_output_frames(decision)))
end

pub fn main() -> Result<(), String> effects [stdio]
	let exact_first = send_data(1, byte_chunk_from_hex("aabb")?, false, accepted_request_send_credit())?
	print_outbound_data("outbound-content-length-data-first", exact_first)
	let exact_end = send_data(1, byte_chunk_from_hex("ccddee")?, true, decision_send_credit(exact_first))?
	print_outbound_data("outbound-content-length-data-exact", exact_end)
	let padded = send_padded_data(1, byte_chunk_from_hex("aabbccddee")?, 2, 4, true, accepted_response_send_credit())?
	print_outbound_data("outbound-content-length-padded", padded)
	Ok(())
end
