# HTTP/2 flow-control failures project structured runtime details.

type Http2ProtocolFailure
	FlowControlWindowExceeded(Int, Int, Int, Int, Int, String, String)
end

fn project(failure: Http2ProtocolFailure) -> Result<(), String>
	match failure
		FlowControlWindowExceeded(offset, observed_length, allowed_window_credit, frame_kind, stream_id, active_state, rule_provenance) => http2_peer_limit_flow_control_window_exceeded(offset, observed_length, allowed_window_credit, frame_kind, stream_id, active_state, rule_provenance)
	end
end

pub fn main() -> Result<(), String>
	project(FlowControlWindowExceeded(0, 4, 3, 0, 1, "open-stream", "stream_receive_window"))
end
