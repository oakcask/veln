pub fn main() -> Result<(), String> effects [net, stdio]
	let listener = net::listen("127.0.0.1:0")
	let stream = net::accept(listener)
	let first = byte_chunk_from_hex("0a0b")?
	let second = byte_chunk_from_hex("cafe")?
	let chunks = list_cons(first, list_cons(second, list_nil()))
	net::write_chunks(stream, chunks)
	stdio::println("written")
	Ok(())
end
