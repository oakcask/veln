use stdio

schema PackedFourByteControlHeader
	format binary

	prefix: UInt8
	control_reserved: ReservedBits(25, 22369621)
	control: UInt7
	suffix: UInt8
end

pub fn main() -> Result<(), String> effects [stdio]
	let bytes: ByteChunk = byte_chunk_from_hex("12aaaaab2a34")?
	let offset: ByteOffset = byte_offset(0)?
	let count: ByteCount = byte_count(6)?
	let view: ByteView = byte_view(bytes, offset, count)?
	let ignored: {prefix: Int, control: Int, suffix: Int} = byte_decode_packed_four_byte_control_header(view)?
	stdio::println(int_to_string(ignored.control))
	Ok(())
end
