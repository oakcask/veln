# Human output renders committed production output as related transport context.
pub fn main() -> Result<(), String> effects [net]
	let listener: NetListener = net::listen("127.0.0.1:0")
	let stream: NetStream = net::accept(listener)
	let chunk: ByteChunk = byte_chunk_from_hex("0a0b")?
	net::write_chunk(stream, chunk)
	Ok(())
end
