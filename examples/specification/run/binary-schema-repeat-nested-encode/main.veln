# Binary schema Repeat fields encode counted nested records.
use stdio

schema ItemRecord
	format binary

	code: UInt8
	value: UInt16be
end

schema CountedItems
	format binary

	count: UInt8
	items: Repeat(count, ItemRecord)
end

fn emit_output_chunk(name: String, index: Int, chunk: ByteChunk, expected_hex: String) -> () effects [stdio]
	stdio::print("output_chunk ")
	stdio::print(name)
	stdio::print(" index ")
	stdio::print(int_to_string(index))
	stdio::print(" hex \"")
	stdio::print(expected_hex)
	stdio::print("\" count ")
	stdio::println(int_to_string(byte_count_to_int(byte_chunk_count(chunk))))
end

fn emit_output_chunk_list_header(name: String, count: Int) -> () effects [stdio]
	stdio::print("output_chunk_list ")
	stdio::print(name)
	stdio::print(" count ")
	stdio::println(int_to_string(count))
end

fn emit_encoded(bytes: ByteChunk) -> () effects [stdio]
	emit_output_chunk_list_header("counted-items", 1)
	emit_output_chunk("counted-items", 0, bytes, "0207012c09000a")
end

pub fn main() -> () effects [stdio]
	let items = list_cons({code: 7, value: 300}, list_cons({code: 9, value: 10}, list_nil()))
	let encoded = byte_encode_counted_items({count: 2, items: items})
	match encoded
		Ok(bytes) => emit_encoded(bytes)
		Err(_) => stdio::println("unexpected encode failure")
	end
end
