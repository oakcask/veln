type Maybe<A>
	Missing
	Just(A)
end

type Shape
	Point { x: Int, y: Int }
	Origin
end

fn label(value: Maybe<Int>) -> String
	match value
		Missing => "missing"
		Just(_) => "value"
	end
end

fn coordinate_sum(value: Shape) -> Int
	match value
		Point(x, y) => x + y
		Origin => 0
	end
end

pub fn main() -> () effects [stdio]
	stdio::println(label(Just(1)))
	stdio::println(int_to_string(coordinate_sum(Point(2, 5))))
end
