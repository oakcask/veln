use stdio

schema BytePrefixReservedGroupHeader
	format binary

	marker: ReservedBits(8, 171)
	high: UInt3
	low: UInt5
end

fn encoded_value(chunk: ByteChunk) -> Result<Int, String>
	let view = byte_view(chunk, byte_offset(0)?, byte_count(2)?)?
	byte_read_u16_be(view)
end

fn emit_encoded_chunk(chunk: ByteChunk) -> Result<(), String> effects [stdio]
	stdio::println(int_to_string(encoded_value(chunk)?))
	Ok(())
end

fn emit_unexpected_encode_failure() -> Result<(), String> effects [stdio]
	stdio::println("unexpected encode failure")
	Ok(())
end

fn emit_encoded(encoded: Result<ByteChunk, EncodeError>) -> Result<(), String> effects [stdio]
	match encoded
		Ok(chunk) => emit_encoded_chunk(chunk)
		Err(_) => emit_unexpected_encode_failure()
	end
end

pub fn main() -> Result<(), String> effects [stdio]
	let bytes = byte_chunk_from_hex("abb1")?
	let view = byte_view(bytes, byte_offset(0)?, byte_count(2)?)?
	let decoded = byte_decode_byte_prefix_reserved_group_header(view)?
	stdio::println(int_to_string(decoded.high))
	stdio::println(int_to_string(decoded.low))

	let encoded = byte_encode_byte_prefix_reserved_group_header({high: 5, low: 17})
	let ignored = emit_encoded(encoded)?
	Ok(())
end
