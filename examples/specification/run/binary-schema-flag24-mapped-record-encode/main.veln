use stdio

type FlagPacket
	FlagPacket {target_be: Flag24be, target_le: Flag24le}
end

schema FlagPacketWire
	format binary

	flags_be: Flag24be
	flags_le: Flag24le

	map to FlagPacket
		target_be = flags_be
		target_le = flags_le
end

fn emit_output_chunk(name: String, index: Int, chunk: ByteChunk, expected_hex: String) -> () effects [stdio]
	stdio::print("output_chunk ")
	stdio::print(name)
	stdio::print(" index ")
	stdio::print(int_to_string(index))
	stdio::print(" hex \"")
	stdio::print(expected_hex)
	stdio::print("\" count ")
	stdio::println(int_to_string(byte_count_to_int(byte_chunk_count(chunk))))
end

fn emit_encoded(bytes: ByteChunk) -> () effects [stdio]
	stdio::println("output_chunk_list mapped-flag24-packet count 1")
	emit_output_chunk("mapped-flag24-packet", 0, bytes, "123456563412")
end

pub fn main() -> () effects [stdio]
	let encoded: Result<ByteChunk, EncodeError> = byte_encode_flag_packet_wire({target_be: Flag24be(1193046), target_le: Flag24le(1193046)})
	match encoded
		Ok(bytes) => emit_encoded(bytes)
		Err(_) => stdio::println("unexpected encode failure")
	end
end
