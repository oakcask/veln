# Binary schema frame-header decode reports an invalid reserved bit.
pub fn main() -> Result<(), String>
	let bytes: ByteChunk = byte_chunk_from_hex("000005010480000001")?
	let offset: ByteOffset = byte_offset(0)?
	let count: ByteCount = byte_count(9)?
	let view: ByteView = byte_view(bytes, offset, count)?
	let ignored: {length: Int, kind: Int, flags: Int, stream_id: Int} = byte_decode_http2_frame_header(view)?
	Ok(())
end
