# Explicit binary schema frame-header decode reports an invalid reserved bit.
schema Http2FrameHeaderWire
	format binary

	length: UInt24be
	kind: UInt8
	flags: UInt8
	stream_reserved: ReservedBits(1, 0)
	stream_id: UInt31be
end

fn invalid_step() -> Result<DecodeStep<{length: Int, kind: Int, flags: Int, stream_id: Int}>, String>
	let bytes: ByteChunk = byte_chunk_from_hex("000005010480000001")?
	let offset: ByteOffset = byte_offset(0)?
	let count: ByteCount = byte_count(9)?
	let view: ByteView = byte_view(bytes, offset, count)?
	Ok(decode Http2FrameHeaderWire from view at offset)
end

pub fn main() -> DecodeStep<{length: Int, kind: Int, flags: Int, stream_id: Int}>
	match invalid_step()
		Ok(step) => step
		Err(_) => NeedMore(NeedEnd)
	end
end
