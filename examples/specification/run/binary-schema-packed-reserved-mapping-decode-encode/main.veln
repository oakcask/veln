use stdio

type PackedMapped
	PackedMapped {control: Int, reserved: Int}
end

schema PackedControlHeader
	format binary

	control_reserved: ReservedBits(3, 5)
	control: UInt5

	map to PackedMapped
		control = control
		reserved = control_reserved
end

fn emit_output_chunk(name: String, index: Int, chunk: ByteChunk, expected_hex: String) -> () effects [stdio]
	stdio::print("output_chunk ")
	stdio::print(name)
	stdio::print(" index ")
	stdio::print(int_to_string(index))
	stdio::print(" hex \"")
	stdio::print(expected_hex)
	stdio::print("\" count ")
	stdio::println(int_to_string(byte_count_to_int(byte_chunk_count(chunk))))
end

fn emit_header(header: {control: Int, reserved: Int}) -> () effects [stdio]
	stdio::print(int_to_string(header.control))
	stdio::print(" ")
	stdio::println(int_to_string(header.reserved))
end

fn emit_encoded(bytes: ByteChunk) -> () effects [stdio]
	stdio::println("output_chunk_list packed-reserved-mapping count 1")
	emit_output_chunk("packed-reserved-mapping", 0, bytes, "b2")
end

fn error_id(error: EncodeError) -> String
	match error
		EncodeError(id, _, _) => id
	end
end

fn error_path(error: EncodeError) -> String
	match error
		EncodeError(_, path, _) => path
	end
end

fn error_reason(error: EncodeError) -> String
	match error
		EncodeError(_, _, reason) => reason
	end
end

fn emit_error(error: EncodeError) -> () effects [stdio]
	stdio::println(error_id(error))
	stdio::println(error_path(error))
	stdio::println(error_reason(error))
end

pub fn main() -> Result<(), String> effects [stdio]
	let bytes: ByteChunk = byte_chunk_from_hex("b2")?
	let offset: ByteOffset = byte_offset(0)?
	let count: ByteCount = byte_count(1)?
	let view: ByteView = byte_view(bytes, offset, count)?
	let header: {control: Int, reserved: Int} = byte_decode_packed_control_header(view)?
	emit_header(header)

	let encoded: Result<ByteChunk, EncodeError> = byte_encode_packed_control_header({control: 18, reserved: 5})
	let emitted: () = match encoded
		Ok(encoded_bytes) => emit_encoded(encoded_bytes)
		Err(_) => stdio::println("unexpected encode failure")
	end

	let invalid: Result<ByteChunk, EncodeError> = byte_encode_packed_control_header({control: 18, reserved: 4})
	let invalid_emitted: () = match invalid
		Ok(_) => stdio::println("unexpected encode success")
		Err(error) => emit_error(error)
	end

	Ok(())
end
