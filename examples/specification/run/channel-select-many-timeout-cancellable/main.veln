# Cancellable receiver-list timeout selection keeps priority and reports token cancellation.
use stdio

fn result_score(selected: Result<Option<{ index : Int, value : Int }>, SelectError>) -> Int
	match selected
		Ok(Some(value)) => value.index * 100 + value.value
		Ok(None) => 0
		Err(_) => -1
	end
end

pub fn main() -> Result<(), String> effects [time, concurrency, stdio]
	let first = channel::bounded<Int>(1)
	let second = channel::bounded<Int>(1)
	let third = channel::bounded<Int>(1)
	let _ = channel::send(second.tx, 21)
	let _ = channel::send(third.tx, 34)
	let ready_receivers: List<Receiver<Int>> = list_cons(first.rx, list_cons(second.rx, list_cons(third.rx, list_nil())))
	let ready_token = time::cancel_token()
	let ready_selected = channel::select_many_timeout_cancellable(ready_receivers, 25, ready_token)

	let timeout_first = channel::bounded<Int>(1)
	let timeout_second = channel::bounded<Int>(1)
	let timeout_receivers: List<Receiver<Int>> = list_cons(timeout_first.rx, list_cons(timeout_second.rx, list_nil()))
	let timeout_token = time::cancel_token()
	let timeout_selected = channel::select_many_timeout_cancellable(timeout_receivers, 0, timeout_token)

	let cancelled_first = channel::bounded<Int>(1)
	let cancelled_second = channel::bounded<Int>(1)
	let _ = channel::send(cancelled_second.tx, 55)
	let cancelled_receivers: List<Receiver<Int>> = list_cons(cancelled_first.rx, list_cons(cancelled_second.rx, list_nil()))
	let cancelled_token = time::cancel_token()
	time::cancel(cancelled_token)
	let cancelled_selected = channel::select_many_timeout_cancellable(cancelled_receivers, 25, cancelled_token)

	stdio::print("ready ")
	stdio::print(int_to_string(result_score(ready_selected)))
	stdio::print(" timeout ")
	stdio::print(int_to_string(result_score(timeout_selected)))
	stdio::print(" cancelled ")
	stdio::println(int_to_string(result_score(cancelled_selected)))
	Ok(())
end
