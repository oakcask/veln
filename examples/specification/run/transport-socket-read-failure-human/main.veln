use fixture_effects
use fake_effects

# Socket read host failures stay runtime transport failures.
fn fixture_body() -> Result<(), String> effects [net]
	let listener: NetListener = net::listen("127.0.0.1:0")
	let stream: NetStream = net::accept(listener)
	let chunk: ByteChunk = net::read_chunk(stream)
	Ok(())
end

pub fn main() -> Result<(), String> effects [concurrency, fs, net]
	let state = fixture_effects::create_fixture()
	handle handle fixture_body() with fake_effects::network(state) with fake_effects::clock(state)
end
