# Optional socket accept returns a usable stream when the fixture accepts.
fn emit_accept_result(result: Option<NetStream>) -> () effects [net, stdio]
	match result
		Some(stream) => emit_accepted_stream(stream)
		None => stdio::println("ended")
	end
end

fn emit_accepted_stream(stream: NetStream) -> () effects [net, stdio]
	let incoming = net::read_chunk(stream)
	stdio::print("accepted ")
	stdio::println(int_to_string(byte_count_to_int(byte_chunk_count(incoming))))
end

pub fn main() -> Result<(), String> effects [net, stdio]
	let listener = net::listen("127.0.0.1:0")
	emit_accept_result(net::accept_or_end(listener))
	Ok(())
end
