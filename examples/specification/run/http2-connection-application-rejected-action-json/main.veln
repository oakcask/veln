use fixture_effects
use fake_effects
use http2::connection from "std"
use http2::core from "std"
use http2::hpack from "std"
use net from "std"
use transport::net from "std"
use stdio

fn open_listener() -> Result<net::Listener, String> effects [net::IO]
	match net::listen(net::Address(net::Tcp4, "127.0.0.1", 0))
		Ok(listener) => Ok(listener)
		Err(_) => Err("missing listener")
	end
end

fn accept_next(listener: net::Listener) -> Result<net::Stream, String> effects [net::IO]
	match net::accept(listener)
		Ok(stream) => Ok(stream)
		Err(_) => Err("missing stream")
	end
end

fn ascii_header(name: String, value: String) -> Result<HeaderField, String>
	Ok(http2::hpack::header_field(name, byte_chunk_from_visible_ascii_string(value)?))
end

fn response_headers() -> Result<HeaderList, String>
	Ok(http2::hpack::prepend_header_field(ascii_header(":status", "200")?, http2::hpack::prepend_header_field(ascii_header("content-length", "5")?, http2::hpack::empty_header_list())))
end

fn handler(event: Http2ApplicationEvent) -> Result<List<Http2ApplicationAction>, String>
	let stream_id = http2::core::application_event_stream_id(event)
	Ok(list_cons(Http2ApplicationAction::Http2SendResponseHeaders(stream_id, response_headers()?, false), list_cons(Http2ApplicationAction::Http2SendResponseData(stream_id, byte_chunk_from_hex("0a0b")?, true), list_nil())))
end

fn run_server(stream: net::Stream, state: CoreConnectionState) -> Result<CoreConnectionState, Http2ApplicationBoundaryFailure> effects [net::IO]
	handle http2::connection::drive_server_application(state, handler) with transport::net::net_stream(stream)
end

fn print_result(result: Result<CoreConnectionState, Http2ApplicationBoundaryFailure>) -> Result<(), String> effects [stdio]
	match result
		Ok(_) => print_accepted()
		Err(failure) => print_failure(failure)
	end
end

fn print_accepted() -> Result<(), String> effects [stdio]
	stdio::println("accepted")
	Ok(())
end

fn print_failure(failure: Http2ApplicationBoundaryFailure) -> Result<(), String> effects [stdio]
	stdio::print(http2::connection::application_failure_kind(failure))
	stdio::print(" ")
	stdio::print(http2::connection::application_failure_id(failure))
	stdio::print(" ")
	stdio::println(http2::connection::application_failure_reason(failure))
	Ok(())
end

fn fixture_body() -> Result<(), String> effects [net::IO, stdio]
	let listener = open_listener()?
	let stream = accept_next(listener)?
	let state = http2::core::server_connection_state(0)?
	let _ = print_result(run_server(stream, state))?
	let _ = net::close_stream(stream)
	Ok(())
end

pub fn main() -> Result<(), String> effects [concurrency, fs, net, time, stdio]
	let state = fixture_effects::create_fixture()
	handle handle handle fixture_body() with net::system() with fake_effects::network(state) with fake_effects::clock(state)
end
