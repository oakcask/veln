use http2::diagnostic from "std"
# HTTP/2 WINDOW_UPDATE payload length helper returns a RuntimeDiagnostic payload.

fn invalid_payload(error: String) -> RuntimeDiagnostic
	RuntimeDiagnostic(
		"http2.protocol.invalid_payload_length",
		error,
		RuntimeHttp2Diagnostic(RuntimeHttp2ProtocolInvalidPayloadLengthDiagnostic(9, 8, 0, 3, 4, "connection-flow-control", "rfc9113_window_update_payload_length", byte_chunk([])))
	)
end

fn preview_bytes() -> Result<ByteChunk, RuntimeDiagnostic>
	match byte_chunk_from_hex("010203")
		Ok(bytes) => Ok(bytes)
		Err(error) => Err(invalid_payload(error))
	end
end

fn preview_view(bytes: ByteChunk) -> Result<ByteView, RuntimeDiagnostic>
	match byte_offset(0)
		Ok(offset) => match byte_view(bytes, offset, byte_chunk_count(bytes))
			Ok(view) => Ok(view)
			Err(error) => Err(invalid_payload(error))
		end
		Err(error) => Err(invalid_payload(error))
	end
end

pub fn main() -> Result<(), RuntimeDiagnostic>
	let bytes: ByteChunk = preview_bytes()?
	let preview: ByteView = preview_view(bytes)?
	http2::diagnostic::protocol_invalid_payload_length(9, 8, 0, 3, 4, "connection-flow-control", "rfc9113_window_update_payload_length", preview)
end
