# Binary schema mapping can carry a Flag64le field into a target record.
use stdio

type FlagPacket
	FlagPacket {target_flags: Flag64le}
end

schema FlagPacketWire
	format binary

	flags: Flag64le

	map to FlagPacket
		target_flags = flags
end

fn flag_bits(flags: Flag64le) -> Int
	match flags
		Flag64le(bits) => bits
	end
end

pub fn main() -> Result<(), String> effects [stdio]
	let bytes: ByteChunk = byte_chunk_from_hex("0807060504030201")?
	let view: ByteView = byte_view(bytes, byte_offset(0)?, byte_count(8)?)?
	let packet: {target_flags: Flag64le} = byte_decode_flag_packet_wire(view)?
	stdio::println(int_to_string(flag_bits(packet.target_flags)))
	Ok(())
end
