# Deadline-aware socket accept observes deadline expiry as None.
fn emit_accept_result(result: Option<NetStream>) -> () effects [stdio]
	match result
		Some(_) => stdio::println("accepted")
		None => stdio::println("deadline")
	end
end

pub fn main() -> Result<(), String> effects [net, time, stdio]
	let listener = net::listen("127.0.0.1:0")
	let deadline = time::deadline_after_ms(5)
	emit_accept_result(net::accept_until(listener, deadline))
	Ok(())
end
