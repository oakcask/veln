# Adapter accept-loop helper owns listener and accepted stream lifecycles.
use stdio

fn handle_input(input: StreamInput) -> List<StreamAdapterAction>
	match input
		Chunk(bytes) => list_cons(SendBytes(bytes), list_cons(Ignore, list_nil()))
		End => list_cons(EndStream, list_nil())
	end
end

pub fn main() -> Result<(), String> effects [net, concurrency, stdio]
	let listener = net::listen("127.0.0.1:0")
	stream_adapter_accept_loop(listener, handle_input)
	stdio::println("loop-complete")
	Ok(())
end
