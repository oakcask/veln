# Binary schema packed four-byte reserved bits decode without exposing reserved fields.
use stdio

schema PackedFourBytePrefixHeader
	format binary

	prefix: UInt8
	control_reserved: ReservedBits(25, 22369621)
	control: UInt7
	suffix: UInt8
end

schema PackedFourByteSuffixHeader
	format binary

	prefix: UInt8
	control: UInt1
	control_padding: ReservedBits(31, 715827882)
	suffix: UInt8
end

fn emit_header(name: String, header: {prefix: Int, control: Int, suffix: Int}) -> () effects [stdio]
	stdio::print(name)
	stdio::print(" ")
	stdio::print(int_to_string(header.prefix))
	stdio::print(" ")
	stdio::print(int_to_string(header.control))
	stdio::print(" ")
	stdio::println(int_to_string(header.suffix))
end

pub fn main() -> Result<(), String> effects [stdio]
	let prefix_bytes: ByteChunk = byte_chunk_from_hex("12aaaaaaaa34")?
	let prefix_offset: ByteOffset = byte_offset(0)?
	let prefix_count: ByteCount = byte_count(6)?
	let prefix_view: ByteView = byte_view(prefix_bytes, prefix_offset, prefix_count)?
	let prefix_header: {prefix: Int, control: Int, suffix: Int} = byte_decode_packed_four_byte_prefix_header(prefix_view)?
	emit_header("prefix", prefix_header)

	let suffix_bytes: ByteChunk = byte_chunk_from_hex("12aaaaaaaa34")?
	let suffix_offset: ByteOffset = byte_offset(0)?
	let suffix_count: ByteCount = byte_count(6)?
	let suffix_view: ByteView = byte_view(suffix_bytes, suffix_offset, suffix_count)?
	let suffix_header: {prefix: Int, control: Int, suffix: Int} = byte_decode_packed_four_byte_suffix_header(suffix_view)?
	emit_header("suffix", suffix_header)
	Ok(())
end
