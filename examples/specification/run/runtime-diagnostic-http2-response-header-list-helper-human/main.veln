use http2::diagnostic from "std"
# HTTP/2 response header-list helper projects human runtime diagnostics from the payload.
fn invalid_payload(error: String) -> RuntimeDiagnostic
	RuntimeDiagnostic(
		"http2.protocol.invalid_response_header_list",
		error,
		RuntimeHttp2ProtocolInvalidResponseHeaderListDiagnostic(12, 1, 1, "request_only_pseudo_header", ":method", ":status,:method,server", "response-headers", "rfc9113_response_pseudo_headers", byte_chunk([]))
	)
end

fn preview_bytes() -> Result<ByteChunk, RuntimeDiagnostic>
	match byte_chunk_from_hex("88")
		Ok(bytes) => Ok(bytes)
		Err(error) => Err(invalid_payload(error))
	end
end

fn preview_view(bytes: ByteChunk) -> Result<ByteView, RuntimeDiagnostic>
	match byte_offset(0)
		Ok(offset) => match byte_count(1)
			Ok(count) => match byte_view(bytes, offset, count)
				Ok(view) => Ok(view)
				Err(error) => Err(invalid_payload(error))
			end
			Err(error) => Err(invalid_payload(error))
		end
		Err(error) => Err(invalid_payload(error))
	end
end

pub fn main() -> Result<(), RuntimeDiagnostic>
	let bytes: ByteChunk = preview_bytes()?
	http2::diagnostic::protocol_invalid_response_header_list(12, 1, 1, "request_only_pseudo_header", ":method", ":status,:method,server", "response-headers", "rfc9113_response_pseudo_headers", preview_view(bytes)?)
end
