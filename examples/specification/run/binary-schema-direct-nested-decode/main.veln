# Binary schema direct nested fields decode nested visible records.
use stdio

schema NestedHeader
	format binary

	kind: UInt8
	code: UInt16be
end

schema NestedPacket
	format binary

	prefix: UInt8
	header: NestedHeader
	tail: UInt8
end

fn emit_packet(packet: {prefix: Int, header: {kind: Int, code: Int}, tail: Int}) -> () effects [stdio]
	stdio::print(int_to_string(packet.prefix))
	stdio::print(" ")
	stdio::print(int_to_string(packet.header.kind))
	stdio::print(" ")
	stdio::print(int_to_string(packet.header.code))
	stdio::print(" ")
	stdio::print(int_to_string(packet.tail))
	stdio::print(" ")
	match byte_encode_nested_packet(packet)
		Ok(bytes) => stdio::println(int_to_string(byte_count_to_int(byte_chunk_count(bytes))))
		Err(_) => stdio::println("encode-error")
	end
end

pub fn main() -> Result<(), String> effects [stdio]
	let bytes = byte_chunk_from_hex("01020304ff")?
	let view = byte_view(bytes, byte_offset(0)?, byte_count(5)?)?
	let packet = byte_decode_nested_packet(view)?
	emit_packet(packet)
	Ok(())
end
