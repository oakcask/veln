use net from "std"
use fixture_effects
use fake_effects
# Production loopback deadline-aware writes return adapter values.
use stdio

fn write_outcome_text(outcome: net::WriteOutcome) -> String
	match outcome
		net::Written(_) => "write-completed"
		net::WriteFailed(_, net::NetError(_, _, _, net::TimedOut, _)) => "write-deadline"
		net::WriteFailed(_, net::NetError(_, _, _, net::Cancelled, _)) => "write-cancelled"
		net::WriteFailed(_, _) => "write-cancelled"
	end
end

fn close_and_return(listener: net::Listener, stream: net::Stream, decision: String) -> String effects [net::IO]
	net::close_stream(stream)
	net::close_listener(listener)
	decision
end

fn write_success_decision() -> Result<String, String> effects [net::IO, time]
	let listener = open_listener("127.0.0.1:0")?
	let stream = accept_stream(listener)?
	let outgoing = byte_chunk_from_hex("0a0b")?
	let deadline = time::deadline_after_ms(100)
	Ok(close_and_return(listener, stream, write_outcome_text(net::write_with(stream, outgoing, Some(deadline), None))))
end

fn write_deadline_decision() -> Result<String, String> effects [net::IO, time]
	let listener = open_listener("127.0.0.1:0")?
	let stream = accept_stream(listener)?
	let outgoing = byte_chunk_from_hex("0a0b")?
	let deadline = time::deadline_after_ms(0)
	Ok(close_and_return(listener, stream, write_outcome_text(net::write_with(stream, outgoing, Some(deadline), None))))
end

fn fixture_body() -> Result<(), String> effects [net::IO, time, stdio]
	stdio::print(write_success_decision()?)
	stdio::print(",")
	stdio::println(write_deadline_decision()?)
	Ok(())
end

fn fixture_network_error(error: net::NetError) -> String
	match error
		net::NetError(_, _, _, _, message) => match string_split_once(message, "\n")
			Some(parts) => parts.left
			None => message
		end
	end
end

fn open_listener(text: String) -> Result<net::Listener, String> effects [net::IO]
	match net::listen(net::Address(net::Tcp4, "127.0.0.1", 0))
		Ok(listener) => Ok(listener)
		Err(error) => Err(fixture_network_error(error))
	end
end

fn accept_stream(listener: net::Listener) -> Result<net::Stream, String> effects [net::IO]
	match net::accept(listener)
		Ok(stream) => Ok(stream)
		Err(error) => Err(fixture_network_error(error))
	end
end

pub fn main() -> Result<(), String> effects [concurrency, fs, net, stdio, time]
	let state = fixture_effects::create_fixture()
	handle handle handle fixture_body() with net::system() with fake_effects::network(state) with fake_effects::clock(state)
end
