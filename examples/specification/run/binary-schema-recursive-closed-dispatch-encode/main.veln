use stdio

type NodePayload
	Leaf(Int)
	Branch({length: Int, kind: Int, payload: NodePayload})
end

type Node
	Node {length: Int, kind: Int, payload: NodePayload}
end

schema RecursiveNode
	format binary

	length: UInt8
	kind: UInt8
	payload: Dispatch(kind, length, 0 => UInt8, 1 => RecursiveNode)

	map to Node when kind == 0
		length = length
		kind = kind
		payload = NodePayload::Leaf(payload)

	map to Node when kind == 1
		length = length
		kind = kind
		payload = NodePayload::Branch(payload)
end

fn emit_output_chunk(name: String, index: Int, chunk: ByteChunk, expected_hex: String) -> () effects [stdio]
	stdio::print("output_chunk ")
	stdio::print(name)
	stdio::print(" index ")
	stdio::print(int_to_string(index))
	stdio::print(" hex \"")
	stdio::print(expected_hex)
	stdio::print("\" count ")
	stdio::println(int_to_string(byte_count_to_int(byte_chunk_count(chunk))))
end

fn emit_output_chunk_list_header(name: String, count: Int) -> () effects [stdio]
	stdio::print("output_chunk_list ")
	stdio::print(name)
	stdio::print(" count ")
	stdio::println(int_to_string(count))
end

fn emit_encoded_chunk(name: String, bytes: ByteChunk, expected_hex: String) -> () effects [stdio]
	emit_output_chunk_list_header(name, 1)
	emit_output_chunk(name, 0, bytes, expected_hex)
end

fn emit_encoded(name: String, encoded: Result<ByteChunk, EncodeError>, expected_hex: String) -> () effects [stdio]
	match encoded
		Ok(bytes) => emit_encoded_chunk(name, bytes, expected_hex)
		Err(_) => stdio::println("unexpected encode failure")
	end
end

pub fn main() -> () effects [stdio]
	let encoded: Result<ByteChunk, EncodeError> = byte_encode_recursive_node({length: 3, kind: 1, payload: NodePayload::Branch({length: 1, kind: 0, payload: NodePayload::Leaf(42)})})
	emit_encoded("recursive-closed-dispatch", encoded, "030101002a")
end
