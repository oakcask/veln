# ByteView reads and writes fixed-width unsigned values.
use stdio

fn int_result_text(result: Result<Int, String>) -> String
	match result
		Ok(value) => int_to_string(value)
		Err(error) => error
	end
end

fn chunk_result_text(result: Result<ByteChunk, String>) -> String
	match result
		Ok(chunk) => int_to_string(byte_count_to_int(byte_chunk_count(chunk)))
		Err(error) => error
	end
end

fn view_result_text(result: Result<ByteView, String>) -> String
	match result
		Ok(view) => int_to_string(byte_count_to_int(byte_chunk_count(byte_view_to_chunk(view))))
		Err(error) => error
	end
end

pub fn main() -> Result<(), String> effects [stdio, concurrency]
	let chunk = byte_chunk_from_hex("00010203ff")?
	let one = byte_count(1)?
	let two = byte_count(2)?
	let three = byte_count(3)?
	let four = byte_count(4)?
	let zero_offset = byte_offset(0)?
	let one_offset = byte_offset(1)?
	let four_offset = byte_offset(4)?
	let slice = byte_view(chunk, one_offset, three)?
	stdio::println(int_result_text(byte_read_u8_be(slice)))
	stdio::println(int_result_text(byte_read_u16_be(slice)))
	stdio::println(int_result_text(byte_read_u24_be(slice)))
	stdio::println(int_result_text(byte_read_u16_le(slice)))
	stdio::println(int_result_text(byte_read_u24_le(slice)))
	let pair = channel::bounded<ByteView>(1)
	let _ = channel::send(pair.tx, slice)
	let received = match channel::recv(pair.rx)
		Some(value) => value
		None => slice
	end
	stdio::println(int_result_text(byte_read_u24_be(received)))
	let received_chunk = byte_view_to_chunk(received)
	stdio::println(int_result_text(byte_read_u24_be(byte_view(received_chunk, zero_offset, three)?)))
	stdio::println(int_result_text(byte_read_u31_be(byte_view(byte_write_u31_be(2147483647)?, zero_offset, four)?)))
	stdio::println(int_result_text(byte_read_u32_be(byte_view(byte_write_u32_be(4294967295)?, zero_offset, four)?)))
	stdio::println(int_result_text(byte_read_u31_le(byte_view(byte_write_u31_le(2147483647)?, zero_offset, four)?)))
	stdio::println(int_result_text(byte_read_u32_le(byte_view(byte_write_u32_le(4294967295)?, zero_offset, four)?)))
	stdio::println(chunk_result_text(byte_write_u16_be(4660)))
	stdio::println(int_result_text(byte_read_u16_be(byte_view(byte_write_u16_be(4660)?, zero_offset, two)?)))
	stdio::println(chunk_result_text(byte_write_u16_le(4660)))
	stdio::println(int_result_text(byte_read_u16_le(byte_view(byte_write_u16_le(4660)?, zero_offset, two)?)))
	stdio::println(int_result_text(byte_read_u16_be(byte_view(byte_write_u16_le(4660)?, zero_offset, two)?)))
	stdio::println(int_result_text(byte_read_u24_be(byte_view(byte_write_u24_le(66051)?, zero_offset, three)?)))
	stdio::println(int_result_text(byte_read_u32_be(byte_view(byte_write_u32_le(16909060)?, zero_offset, four)?)))
	stdio::println(int_result_text(byte_read_u24_be(byte_view(chunk, zero_offset, two)?)))
	stdio::println(int_result_text(byte_read_u24_le(byte_view(chunk, zero_offset, two)?)))
	stdio::println(view_result_text(byte_view(chunk, four_offset, two)))
	stdio::println(chunk_result_text(byte_write_u8_be(256)))
	stdio::println(chunk_result_text(byte_write_u32_le(4294967296)))
	stdio::println(int_result_text(byte_read_u31_be(byte_view(byte_write_u32_be(4294967295)?, zero_offset, four)?)))
	stdio::println(int_result_text(byte_read_u31_le(byte_view(byte_write_u32_le(4294967295)?, zero_offset, four)?)))
	stdio::println(int_to_string(byte_count_to_int(one)))
	Ok(())
end
