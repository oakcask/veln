type FlagPacket
	FlagPacket {flag: Int}
end

schema FifteenBitPrefixHeader
	format binary

	guard: ReservedBits(15, 21845)
	control: UInt1

	map to FlagPacket
		flag = control
end

pub fn main() -> Result<(), String>
	let bytes: ByteChunk = byte_chunk_from_hex("aaac")?
	let view: ByteView = byte_view(bytes, byte_offset(0)?, byte_count(2)?)?
	let ignored: {flag: Int} = byte_decode_fifteen_bit_prefix_header(view)?
	Ok(())
end
