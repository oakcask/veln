schema SevenByteWideSuffixHeader
	format binary

	value: UInt7
	guard: ReservedBits(49, 375299968947541)
end

pub fn main() -> Result<{value: Int}, String>
	let bytes: ByteChunk = byte_chunk_from_hex("ab555555555554")?
	let view: ByteView = byte_view(bytes, byte_offset(0)?, byte_count(7)?)?
	byte_decode_seven_byte_wide_suffix_header(view)
end
