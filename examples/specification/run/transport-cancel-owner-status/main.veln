# Cancellation owner status is observable by adapter-owned code.
use stdio

fn status_text(cancelled: Bool) -> String
	if cancelled
		"cancelled"
	else
		"active"
	end
end

pub fn main() -> Result<(), String> effects [time, stdio]
	let owner = time::cancel_owner()
	stdio::println(status_text(time::is_cancelled_owner(owner)))
	time::cancel_owned(owner)
	stdio::println(status_text(time::is_cancelled_owner(owner)))
	Ok(())
end
