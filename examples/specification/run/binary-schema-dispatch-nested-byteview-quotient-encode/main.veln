# Nested dispatch payload encode accepts ByteView quotient lengths.
use stdio

schema QuotientWritePayload
	format binary

	total_length: UInt8
	chunk_count: UInt8
	payload: ByteView(total_length / chunk_count)
end

schema ClosedQuotientWritePacket
	format binary

	kind: UInt8
	payload: Dispatch(kind, 1 => QuotientWritePayload)
end

schema ExtensionQuotientWritePacket
	format binary

	length: UInt8
	kind: UInt8
	payload: ExtensionDispatch(kind, length, 1 => QuotientWritePayload)
end

codec ClosedQuotientCodec for ClosedQuotientWritePacket encode
	derive encode
end

codec ExtensionQuotientCodec for ExtensionQuotientWritePacket encode
	derive encode
end

fn emit_output_chunk(name: String, index: Int, chunk: ByteChunk, expected_hex: String) -> () effects [stdio]
	stdio::print("output_chunk ")
	stdio::print(name)
	stdio::print(" index ")
	stdio::print(int_to_string(index))
	stdio::print(" hex \"")
	stdio::print(expected_hex)
	stdio::print("\" count ")
	stdio::println(int_to_string(byte_count_to_int(byte_chunk_count(chunk))))
end

fn emit_output_chunk_list_header(name: String, count: Int) -> () effects [stdio]
	stdio::print("output_chunk_list ")
	stdio::print(name)
	stdio::print(" count ")
	stdio::println(int_to_string(count))
end

fn emit_encoded_chunk(name: String, bytes: ByteChunk, expected_hex: String) -> () effects [stdio]
	emit_output_chunk_list_header(name, 1)
	emit_output_chunk(name, 0, bytes, expected_hex)
end

fn emit_encoded_result(name: String, encoded: Result<ByteChunk, EncodeError>, expected_hex: String) -> () effects [stdio]
	match encoded
		Ok(bytes) => emit_encoded_chunk(name, bytes, expected_hex)
		Err(_) => stdio::println("unexpected encode failure")
	end
end

fn emit_encoded_step(name: String, encoded: EncodeStep<()>, expected_hex: String) -> () effects [stdio]
	match encoded
		Encoded(Cons(chunk, Nil)) => emit_encoded_chunk(name, chunk, expected_hex)
		Encoded(_) => stdio::println("unexpected encoded chunk count")
		Partial(_, _, _) => stdio::println("unexpected partial encode")
		Invalid(_) => stdio::println("unexpected encode failure")
	end
end

pub fn main() -> Result<(), String> effects [stdio]
	let payload_bytes: ByteChunk = byte_chunk_from_hex("aabbccdd")?
	let payload_view: ByteView = byte_view(payload_bytes, byte_offset(0)?, byte_count(4)?)?
	let payload: {total_length: Int, chunk_count: Int, payload: ByteView} = {total_length: 8, chunk_count: 2, payload: payload_view}

	let closed: Result<ByteChunk, EncodeError> = byte_encode_closed_quotient_write_packet({kind: 1, payload: payload})
	emit_encoded_result("closed-quotient-nested", closed, "010802aabbccdd")

	let extension: Result<ByteChunk, EncodeError> = byte_encode_extension_quotient_write_packet({length: 6, kind: 1, payload: Known(payload)})
	emit_encoded_result("extension-quotient-nested", extension, "06010802aabbccdd")

	let closed_codec: EncodeStep<()> = ClosedQuotientCodec({kind: 1, payload: payload})
	emit_encoded_step("codec-closed-quotient-nested", closed_codec, "010802aabbccdd")

	let extension_codec: EncodeStep<()> = ExtensionQuotientCodec({length: 6, kind: 1, payload: Known(payload)})
	emit_encoded_step("codec-extension-quotient-nested", extension_codec, "06010802aabbccdd")
	Ok(())
end
