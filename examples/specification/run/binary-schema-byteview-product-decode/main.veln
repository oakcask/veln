# Binary schema ByteView product lengths decode bounded payload bytes.
use stdio

schema PacketWire
	format binary

	row_count: UInt8
	column_count: UInt8
	payload: ByteView(row_count * column_count)
end

fn emit_packet(packet: {row_count: Int, column_count: Int, payload: ByteView}) -> Result<(), String> effects [stdio]
	stdio::print(int_to_string(packet.row_count))
	stdio::print(" ")
	stdio::print(int_to_string(packet.column_count))
	stdio::print(" ")
	stdio::print(int_to_string(byte_count_to_int(byte_chunk_count(byte_view_to_chunk(packet.payload)))))
	stdio::print(" ")
	stdio::println(int_to_string(byte_read_u16_be(packet.payload)?))
	Ok(())
end

pub fn main() -> Result<(), String> effects [stdio]
	let bytes = byte_chunk_from_hex("0203aabbccddeeff")?
	let view = byte_view(bytes, byte_offset(0)?, byte_count(8)?)?
	let packet = byte_decode_packet_wire(view)?
	emit_packet(packet)
	Ok(())
end
