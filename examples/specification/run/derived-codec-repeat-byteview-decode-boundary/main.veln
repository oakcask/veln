# Explicit schema decode expressions include Repeat-backed ByteView schema helpers.
use stdio

schema CountedViews
	format binary

	count: UInt8
	item_length: UInt8
	items: Repeat(count, ByteView(item_length))
end


fn list_count(items: List<ByteView>) -> Int
	match items
		Nil => 0
		Cons(_, tail) => 1 + list_count(tail)
	end
end

fn total_view_count(items: List<ByteView>) -> Int
	match items
		Nil => 0
		Cons(head, tail) => byte_count_to_int(byte_view_count(head)) + total_view_count(tail)
	end
end

fn step_kind(step: DecodeStep<{count: Int, item_length: Int, items: List<ByteView>}>) -> String
	match step
		Decoded(_, _) => "decoded"
		NeedMore(_) => "need_more"
		Invalid(_) => "invalid"
	end
end

fn decoded_item_count(step: DecodeStep<{count: Int, item_length: Int, items: List<ByteView>}>) -> Int
	match step
		Decoded(sample, _) => list_count(sample.items)
		NeedMore(_) => -1
		Invalid(_) => -1
	end
end

fn decoded_total_count(step: DecodeStep<{count: Int, item_length: Int, items: List<ByteView>}>) -> Int
	match step
		Decoded(sample, _) => total_view_count(sample.items)
		NeedMore(_) => -1
		Invalid(_) => -1
	end
end

fn consumed_count(step: DecodeStep<{count: Int, item_length: Int, items: List<ByteView>}>) -> Int
	match step
		Decoded(_, consumed) => byte_count_to_int(consumed)
		NeedMore(_) => 0
		Invalid(_) => 0
	end
end

fn readiness_kind(step: DecodeStep<{count: Int, item_length: Int, items: List<ByteView>}>) -> String
	match step
		Decoded(_, _) => "none"
		NeedMore(NeedBytes(_)) => "need_bytes"
		NeedMore(NeedEnd) => "need_end"
		Invalid(_) => "none"
	end
end

fn readiness_count(step: DecodeStep<{count: Int, item_length: Int, items: List<ByteView>}>) -> Int
	match step
		Decoded(_, _) => 0
		NeedMore(NeedBytes(count)) => byte_count_to_int(count)
		NeedMore(NeedEnd) => 0
		Invalid(_) => 0
	end
end

fn error_id(step: DecodeStep<{count: Int, item_length: Int, items: List<ByteView>}>) -> String
	match step
		Decoded(_, _) => "none"
		NeedMore(_) => "none"
		Invalid(DecodeError(id, _, _)) => id
		Invalid(DecodeErrorWithReason(id, _, _, _)) => id
	end
end

fn error_offset(step: DecodeStep<{count: Int, item_length: Int, items: List<ByteView>}>) -> Int
	match step
		Decoded(_, _) => -1
		NeedMore(_) => -1
		Invalid(DecodeError(_, offset, _)) => byte_offset_to_int(offset)
		Invalid(DecodeErrorWithReason(_, offset, _, _)) => byte_offset_to_int(offset)
	end
end

fn error_path(step: DecodeStep<{count: Int, item_length: Int, items: List<ByteView>}>) -> String
	match step
		Decoded(_, _) => "none"
		NeedMore(_) => "none"
		Invalid(DecodeError(_, _, path)) => path
		Invalid(DecodeErrorWithReason(_, _, path, _)) => path
	end
end

pub fn main() -> Result<(), String> effects [stdio]
	let complete_bytes: ByteChunk = byte_chunk_from_hex("0203aabbccddeeff")?
	let complete_view: ByteView = byte_view(complete_bytes, byte_offset(0)?, byte_count(8)?)?
	let complete: DecodeStep<{count: Int, item_length: Int, items: List<ByteView>}> = decode CountedViews from complete_view at byte_offset(31)?
	stdio::println(step_kind(complete))
	stdio::println(int_to_string(decoded_item_count(complete)))
	stdio::println(int_to_string(decoded_total_count(complete)))
	stdio::println(int_to_string(consumed_count(complete)))

	let prefix_short_bytes: ByteChunk = byte_chunk_from_hex("02")?
	let prefix_short_view: ByteView = byte_view(prefix_short_bytes, byte_offset(0)?, byte_count(1)?)?
	let waiting: DecodeStep<{count: Int, item_length: Int, items: List<ByteView>}> = decode CountedViews from prefix_short_view at byte_offset(37)?
	stdio::println(step_kind(waiting))
	stdio::println(readiness_kind(waiting))
	stdio::println(int_to_string(readiness_count(waiting)))
	stdio::println(int_to_string(consumed_count(waiting)))

	let short_bytes: ByteChunk = byte_chunk_from_hex("0203aabbccdd")?
	let short_view: ByteView = byte_view(short_bytes, byte_offset(0)?, byte_count(6)?)?
	let invalid: DecodeStep<{count: Int, item_length: Int, items: List<ByteView>}> = decode CountedViews from short_view at byte_offset(41)?
	stdio::println(step_kind(invalid))
	stdio::println(readiness_kind(invalid))
	stdio::println(int_to_string(readiness_count(invalid)))
	stdio::println(int_to_string(consumed_count(invalid)))
	stdio::println(error_id(invalid))
	stdio::println(int_to_string(error_offset(invalid)))
	stdio::println(error_path(invalid))
	Ok(())
end
