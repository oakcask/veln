# Binary schema mapping reports a diagnostic for integer division by zero.
schema PacketWire
	format binary

	total: UInt8
	count: UInt8

	map to Packet
		quotient = total / count
end

type Packet
	Packet {quotient: Int}
end

pub fn main() -> Result<(), String>
	let bytes: ByteChunk = byte_chunk_from_hex("0c00")?
	let view: ByteView = byte_view(bytes, byte_offset(0)?, byte_count(2)?)?
	let ignored: {quotient: Int} = byte_decode_packet_wire(view)?
	Ok(())
end
