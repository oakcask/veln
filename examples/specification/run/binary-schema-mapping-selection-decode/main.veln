# Binary schema mapping selection chooses one target from a decoded field value.
use stdio

type ControlFrame
	ControlFrame {kind: Int, value: Int}
end

type DataFrame
	DataFrame {kind: Int, value: Int}
end

schema PacketWire
	format binary

	kind: UInt8
	control_value: UInt8
	data_value: UInt8

	map to ControlFrame when kind == 1
		kind = kind
		value = control_value

	map to DataFrame when kind == 2
		kind = kind
		value = data_value
end

fn emit(label: String, packet: {kind: Int, value: Int}) -> () effects [stdio]
	stdio::print(label)
	stdio::print(" ")
	stdio::print(int_to_string(packet.kind))
	stdio::print(" ")
	stdio::println(int_to_string(packet.value))
end

fn decode_packet(hex: String) -> Result<{kind: Int, value: Int}, String>
	let bytes: ByteChunk = byte_chunk_from_hex(hex)?
	let view: ByteView = byte_view(bytes, byte_offset(0)?, byte_count(3)?)?
	byte_decode_packet_wire(view)
end

pub fn main() -> Result<(), String> effects [stdio]
	let control: {kind: Int, value: Int} = decode_packet("010705")?
	let data: {kind: Int, value: Int} = decode_packet("020705")?
	emit("control", control)
	emit("data", data)
	Ok(())
end
