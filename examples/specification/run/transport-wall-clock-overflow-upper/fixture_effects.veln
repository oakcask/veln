use fake_effects

pub fn create_clock_state(seconds: Int, nanosecond: Int, monotonic: Int) -> { tx : Sender<Dict<String, String>>, rx : Receiver<Dict<String, String>> } effects [concurrency]
	fake_effects::create_state({ "wall_seconds": int_to_string(seconds), "wall_nanosecond": int_to_string(nanosecond), "now": int_to_string(monotonic) })
end
