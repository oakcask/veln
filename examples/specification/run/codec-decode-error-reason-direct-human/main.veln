# Direct DecodeErrorWithReason result failures render reason notes.

schema ManualPacketWire
	format binary

	length: UInt16be
	kind: UInt8
end

fn offset(value: Int) -> ByteOffset
	byte_offset(value)?
end

pub fn main() -> Result<(), DecodeError>
	Err(DecodeErrorWithReason("codec.invalid_input", offset(62), "ManualPacketWire.kind", "kind value exceeds declared length"))
end
