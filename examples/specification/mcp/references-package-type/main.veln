use model from "example/dep"
use http2::frame from "std"

type Item
end

type Box
  Wrap(model::Item)
end

pub type Alias = model::Item

pub fn direct(input: model::Item) -> model::Item
  model::Item::Ready(1)
end

pub fn standard(current: frame::Frame) -> frame::Frame
  current
end

pub fn collisions(record: {Item: Int}, Item: Int) -> Int
  record.Item
  "Item"
  Item
end
