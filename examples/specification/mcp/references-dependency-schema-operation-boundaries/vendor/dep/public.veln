use core
use other from "other/dep"

pub schema Public
  value: Int
end

pub schema badSchema
  value: Int
end

pub schema Alias = Public
pub schema AliasChain = Alias
pub schema Other
  value: Int
end
pub schema CollisionTarget
  value: Int
end
pub schema CollisionTarget = Other
pub schema CollidingAlias = CollisionTarget
pub schema badAlias = Public
pub schema RecoveredAlias
  value: Int
end

pub schema CrossModuleAlias = core::Packet
pub schema DuplicateRecoveredAlias = Public
pub schema InvalidTargetAlias = badTarget
pub schema OtherPackageAlias = other::Public

pub schema RecoveredPacket
  value: Int
end

pub schema RecoveredAliasCollision
  value: Int
end

fn package_operations(view: ByteView, value: {value: Int}) -> ()
  decode Public from view at byte_offset(0)?
  encode Public from value
end
