use public from "example/dep"
use private from "example/dep"
use hidden from "example/dep"
use mismatch from "other/dep"
use transitive from "transitive/dep"
# The embedded standard library has no schema declaration to select here.

fn read(view: ByteView) -> ()
  decode private::Private from view at byte_offset(0)?
  decode hidden::Hidden from view at byte_offset(0)?
  decode mismatch::Public from view at byte_offset(0)?
  decode transitive::Public from view at byte_offset(0)?
  decode public::badSchema from view at byte_offset(0)?
  decode public::Missing from view at byte_offset(0)?
  decode public::Alias from view at byte_offset(0)?
  decode public::AliasChain from view at byte_offset(0)?
  decode public::CollidingAlias from view at byte_offset(0)?
  decode private::PrivateAlias from view at byte_offset(0)?
  decode hidden::HiddenAlias from view at byte_offset(0)?
  decode mismatch::OtherAlias from view at byte_offset(0)?
  decode transitive::TransitiveAlias from view at byte_offset(0)?
  decode public::badAlias from view at byte_offset(0)?
  decode public::RecoveredAlias from view at byte_offset(0)?
  decode public::Public from view at byte_offset(0)?
  decode public::CrossModuleAlias from view at byte_offset(0)?
  decode public::DuplicateRecoveredAlias from view at byte_offset(0)?
end

schema Frame
  nested: public::Public
end
