fn helper(value: Int) -> Int
  helper(value - 1)
end

fn main() -> Int
  helper(1)
end

type Item
  Some(Int)
  None
end

fn make_item() -> Item
  Item::Some(1)
end

fn read_item(input: Item) -> Int
  match input
    Item::Some(value) => value
    Item::None => 0
  end
end

effect Choose
  pick(value: Bool) -> Int
end

handler choose() handles Choose
  pick(value) => match value
    true => value
    value => value
    false => record.value
  end
end

schema Packet
  format binary
  value: UInt8
end

test Bad() -> Int
  Bad()
end

fn read() -> Int
  Bad()
end
