pub fn first(view: ByteView) -> Int
  byte_count_to_int(byte_view_len(view))
end

pub fn second(view: ByteView) -> Int
  let callback: fn(ByteView) -> ByteCount = prelude::byte_view_len
  let bare_callback: fn(ByteView) -> ByteCount = byte_view_len
  byte_count_to_int(callback(view)) + byte_count_to_int(bare_callback(view)) + byte_count_to_int(prelude::byte_view_len(view))
end
