use dep from "example/dep"

pub fn first() -> Int
  dep::renamed()
end

pub fn second() -> fn() -> Int
  dep::renamed
end

pub fn target_call() -> Int
  dep::target()
end

pub fn chain_call() -> Int
  dep::chain()
end

pub fn standard_bare() -> ByteCount
  byte_chunk_len(byte_chunk([]))
end

pub fn standard_qualified() -> ByteCount
  prelude::byte_chunk_len(byte_chunk([]))
end

pub fn standard_callback() -> fn(ByteChunk) -> ByteCount
  prelude::byte_chunk_len
end

pub fn standard_target() -> ByteCount
  byte_chunk_count(byte_chunk([]))
end
