use dep from "example/dep"

pub type State
  pub Ready(Int)
  pub Closed
end

pub type Alias = State

fn observe(value: State::Ready) -> State
  let made = State::Ready(1)
  match value
    State::Ready(payload) => made
  end
end

fn alias_single(value: Alias::Ready) -> Int
  0
end

fn alias_union(value: Alias::Ready | Alias::Closed) -> Int
  0
end

pub type Other
  pub Shared
end

fn observe_other(value: Other::Shared) -> Other
  Other::Shared
end

fn invalid(value: State::Ready | Other::Shared) -> Int
  0
end

fn retained_unknown(value: Alias::Missing) -> Int
  0
end

fn retained_wrong_owner(value: Alias::Shared) -> Int
  0
end

fn dependency(value: dep::Remote) -> Int
  0
end

pub type RecoveryState
  pub Known
end

pub type RecoveryAlias = RecoveryState

fn retained_union(value: RecoveryState::Known | RecoveryState::Missing) -> Int
  0
end

fn retained_alias_union(value: RecoveryAlias::Known | RecoveryAlias::Shared) -> Int
  0
end
