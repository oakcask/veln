pub schema Packet
  format binary
  value: UInt8
end

fn local(view: ByteView, packet: {value: Int}) -> ()
  let decoded = decode Packet from view at byte_offset(0)?
  let encoded = encode Packet from packet
end

schema LocalFrame
  format binary
  count: UInt8
  direct: Packet
  repeated: Repeat(count, Packet)
  canonical: [Packet; count]
end

pub schema AliasPacket = Packet

pub schema Collision
  format binary
  value: UInt8
end

pub type Collision
end
