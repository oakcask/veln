use lib::wire from "example/dep"

schema Frame
  format binary
  count: UInt8
  direct: lib::wire::Packet
  repeated: Repeat(count, wire::Packet)
  canonical: [wire::Packet; count]
end

fn operations(view: ByteView, packet: {value: Int}) -> ()
  let decoded = keep("😀", decode lib::wire::Packet from view at byte_offset(0)?)
  encode wire::Packet from packet
end
