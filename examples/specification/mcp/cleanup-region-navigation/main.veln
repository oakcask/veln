fn cleanup(value: Int) -> ()
	()
end

fn choose(input: Int) -> Int
	let outer = input
	let cleanup = begin
		let captured = outer
		defer
			cleanup(captured)
		end
		captured
	end
	cleanup
end

effect Ask
	value() -> Int
end

handler ask() handles Ask
	value() => begin
		let captured = 1
		defer
			let deferred = captured
			()
		end
		captured
	end
end

fn sibling_cleanup_scopes() -> Int
	let left = begin
		let first = 1
		first
	end
	let right = begin
		let second = 2
		second
	end
	left + right
end

fn incomplete(input: Int) -> ()
	defer
		input
end

fn following(parameter: Int) -> Int
	let local = parameter
	local
end

fn consume(value: Int) -> Int
	value
end

fn embedded_cleanup_regions(input: Int) -> Int
	let call_result = consume(begin
		let call_value = input
		defer
			let deferred = call_value
			cleanup(deferred)
		end
		call_value
	end)
	let list_result = [begin
		let list_value = input
		defer
			cleanup(list_value)
		end
		list_value
	end]
	let record_result = { value: begin
		let record_value = input
		defer
			cleanup(record_value)
		end
		record_value
	end }
	call_result
end
