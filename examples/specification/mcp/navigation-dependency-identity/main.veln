use math from "example/pkg"

pub fn build() -> Token
  exposed(1)
end

fn exposed(value: Int) -> Int
  value
end

pub fn use_exposed() -> Int
  exposed(2)
end

type Local
  pack(Int)
end

fn parameter_shadow(pack: fn(Int) -> Local) -> Local
  pack(1)
end

fn parenthesized_shadow(identity: fn(Int) -> Local) -> Local
  let pack = (identity)
  pack(1)
end

fn field_shadow(record: {pack: fn(Int) -> Local}) -> Local
  let pack = record.pack
  pack(1)
end

fn build_local(value: Int) -> Local
  pack(value)
end

fn make_record() -> {pack: fn(Int) -> Local}
  {pack: build_local}
end

fn returned_field() -> Local
  let record = make_record()
  let pack = record.pack
  pack(1)
end
