type Envelope
 Wrapped(value:protocol::Result<Int, Error>::Ok| protocol::Result<Int, Error>::Err)
end

fn transition(state:Alias::Ready|protocol::State::Closed|Alias::Ready,callback:fn(State::Open|State::Closed)->State::Open)->Result<Int, Error>::Ok
 let nested:{states:List<State::Open| State::Closed>}=state
 sink<State::Open|State::Closed>(nested)
end
