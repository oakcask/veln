// Canonical formatting normalizes headers, contracts, expressions, and comments.
mod app
use stdio
pub   fn main ( raw : String ) -> Result ( { value : Int, tags : Vec(String) } , AppError ) effects [ stdio ]
 require raw != ""
 ensure output.value >= 0 and not ( output.value == - 1 )
 let parsed : Int = parse ( raw ) ?
// preserve body comment
 let payload : { message : String, values : Vec(Int) } = { message : raw , values : [ 1 , 2 , add ( 3 , 4 ) ] }
 match Some ( parsed )
 Some(count) => { value : count + 1 * ( 2 + 3 ) , tags : [ choose ( payload.message , "fallback" ) , "done" ] }
 None => { value : 0, tags : [ ] }
 end
end
