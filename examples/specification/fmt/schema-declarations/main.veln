pub  schema   Http2FrameHeader
  format   binary
  priority:UInt16be
  length : UInt24be
  kind :UInt8
  padding_length:UInt8    where   padding_length<=length
  stream_reserved : ReservedBits( 1,0 )
  stream_id:UInt31be
  checksum  : UInt32be
  settings:Repeat(length-padding_length,UInt16be)
  product_settings:Repeat(length*padding_length,UInt16be)
  payload:ByteView(length-padding_length)
  product_payload:ByteView(length*padding_length)
end
