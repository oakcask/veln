effect Ask
  value() -> Int
end

handler outer(value: Int) for Ask
  value() => value
end

handler inner(value: Int) for Ask
  value() => value
end

handler handler() for Ask
  value() => 3
end

fn first() -> Int
  1
end

fn second() -> Int
  2
end

fn wrap(value: Int) -> Int
  value
end

fn value() -> Int effects [Ask]
  perform Ask::value()
end

fn expression_body() -> Int
  handle value() with
    outer(first()),
    inner(second()),
  end
end

fn block_body() -> Int
  handle
    let value = first()
    value
  # retain before with
  with
    outer(),
    inner(),
  # retain before end
  end
end

fn contextual_entries() -> Int
  handle value() with
    handler(),
    inner(second()),
  end
end

fn migrate_parenthesized_short_chain() -> Int
  handle (handle value() with inner(second())) with outer(first())
end

fn migrate_unparenthesized_short_chain() -> Int
  handle handle handle value() with inner(second()) with outer(first()) with handler()
end

fn migrate_multiline_short_chain() -> Int
  handle (
    handle (handle value() with inner(second())) with outer(first())
  ) with handler()
end

fn migrate_short_over_list() -> Int
  handle (handle value() with
    outer(first()),
    inner(second())
  end) with handler()
end

fn migrate_list_over_short() -> Int
  handle (handle value() with inner(second())) with
    handler(),
    outer(first())
  end
end

fn migrate_begin_block() -> Int
  handle (handle begin
    let result = value()
    result
  end with inner(second())) with outer(first())
end

fn migrate_existing_block() -> Int
  handle (handle
    let result = value()
    result
  with
    handler(),
    inner(second())
  end) with outer(first())
end

fn preserve_inner_closing_comment() -> Int
  wrap(handle (handle value() with
    inner(second())
  end # inner closing
  ) with outer(first()))
end

fn preserve_list_sibling_comment() -> Vec<Int>
  [handle (handle value() with inner(second())) with
    outer(first())
  end, second() # later item
  ]
end

fn preserve_record_continuation() -> Int
  { first: first() # final field
  }.first
end
