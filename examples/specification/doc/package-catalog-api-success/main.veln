use wire

## Public type documentation.
pub type Choice
	## Public constructor documentation uses {@schema wire::Packet}.
	## ```veln
	## 1
	## ```
	pub Ready(value: Int)
	Hidden(value: Int)
end

## Uses {@schema wire::Packet}.
## ```veln
## visible(1)
## ```
## ```veln-output stream=stdout
## 1
## ```
## ```veln-output stream=stderr
## note
## ```
pub fn visible(value: Int) -> output: Int
	require value >= 0
	ensure output >= value
	value
end

fn hidden_helper() -> Int
	0
end
