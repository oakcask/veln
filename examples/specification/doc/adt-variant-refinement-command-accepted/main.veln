pub type State
	pub Ready
	pub Closed
	pub Failed
end

pub type Envelope
	pub Live(marker: Unit, state: State::Closed|State::Ready)
end

pub fn keep_ready(value: State::Ready) -> State::Ready
	value
end

pub fn keep_live(value: State::Closed|State::Ready) -> State::Closed|State::Ready
	value
end

pub fn mixed(marker: Unit, state: State::Ready) -> Unit
	()
end
