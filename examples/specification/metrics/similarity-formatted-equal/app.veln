fn add(left: Int, right: Int) -> Int
  left + right
end

fn first() -> Int
  # comments and layout do not affect similarity
  let value = add(1, 2)
  value
end

fn second() -> Int
  let value=add(
    1,
    2
  )
  value
end

fn renamed() -> Int
  let other = add(1, 2)
  other
end

fn cleanup_first() -> Int
  begin
    defer
      let _ = add(1, 2)
    end
    add(3, 4)
  end
end

fn cleanup_second() -> Int
  begin
    defer
      let _ = add(1, 2)
    end
    add(3, 4)
  end
end
