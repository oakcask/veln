type Token
  byte(Int)
end

pub fn parameter_shadow(byte: fn(Int) -> Token) -> Token
  byte(1)
end

pub fn local_shadow(identity: fn(Int) -> Token) -> Token
  let byte = identity
  byte(1)
end

pub fn parenthesized_shadow(identity: fn(Int) -> Token) -> Token
  let byte = (identity)
  byte(1)
end

pub fn match_shadow(flag: Bool, identity: fn(Int) -> Token) -> Token
  let byte = match flag
    true => identity
    false => identity
  end
  byte(1)
end

pub fn if_shadow(flag: Bool, backup: Bool, identity: fn(Int) -> Token) -> Token
  let byte = if flag
    identity
  else if backup
    identity
  else
    identity
  end
  byte(1)
end
