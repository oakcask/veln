type Token
  pack(Int)
end

fn direct(value: Int) -> Int
  value
end

pub fn parameter_field(record: {pack: fn(Int) -> Int}) -> Int
  let pack = record.pack
  pack(1)
end

pub fn local_field() -> Int
  let record: {pack: fn(Int) -> Int} = {pack: direct}
  let alias = record
  let pack = alias.pack
  pack(2)
end

fn make_record() -> {pack: fn(Int) -> Int}
  {pack: direct}
end

pub fn returned_field() -> Int
  let record = make_record()
  let pack = record.pack
  pack(3)
end

pub fn destructured_let(record: {callback: fn(Int) -> Int}) -> Int
  let {callback: pack}: {callback: fn(Int) -> Int} = record
  pack(4)
end

pub fn destructured_match(record: {callback: fn(Int) -> Int}) -> Int
  match record
    {callback: pack} => pack(5)
  end
end
