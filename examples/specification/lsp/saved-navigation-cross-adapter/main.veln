use model from "example/model"

pub fn helper(value: Int) -> Int
  value
end

fn first() -> Int
  helper(1)
end

fn unicode() -> Int
  choose("🙂", helper(2))
end

fn package_alias() -> model::Alias
  model::Alias::Ready(1)
end

fn choose(label: String, value: Int) -> Int
  value
end

fn Bad(label: String) -> Int
  Bad("🙂") + Bad(label)
end

pub let answer: Int = 42
let mirrored: Int = answer

pub handler run() for Work
  go() => 1
end

fn local_handler() -> Int
  handle 1 with run()
end

fn first_dependency_handler() -> Int
  handle 1 with model::execute()
end

fn second_dependency_handler() -> Int
  handle 2 with model::execute()
end
