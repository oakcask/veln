fn cleanup(value: Int) -> ()
	()
end

fn choose(input: Int) -> Int
	let outer = input
	let cleanup = begin
		let captured = outer
		defer
			cleanup(captured)
		end
		captured
	end
	cleanup
end

effect Ask
	value() -> Int
end

handler ask() handles Ask
	value() => begin
		let captured = 1
		defer
			let deferred = captured
			()
		end
		captured
	end
end
