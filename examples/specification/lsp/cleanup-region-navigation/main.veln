fn cleanup(value: Int) -> ()
	()
end

fn choose(input: Int) -> Int
	let outer = input
	let cleanup = begin
		let captured = outer
		defer
			cleanup(captured)
		end
		captured
	end
	cleanup
end

effect Ask
	value() -> Int
end

handler ask() handles Ask
	value() => begin
		let captured = 1
		defer
			let deferred = captured
			()
		end
		captured
	end
end

fn sibling_cleanup_scopes() -> Int
	let left = begin
		let first = 1
		first
	end
	let right = begin
		let second = 2
		second
	end
	left + right
end
