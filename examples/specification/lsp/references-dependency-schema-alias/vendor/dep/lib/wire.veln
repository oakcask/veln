mod lib::wire

use lib::core
use private
use lib::Core

pub type Packet
  pub Ready(Int)
end

pub schema WirePacket = core::Packet
pub schema PrivateTarget = private::Packet
pub schema InvalidImport = Core::Packet

pub schema Hidden
  value: Int
end

schema PackageFrame
  nested: WirePacket
end

fn package_operations(view: ByteView, packet: {value: Int}) -> ()
  decode WirePacket from view at byte_offset(0)?
  encode WirePacket from packet
end
