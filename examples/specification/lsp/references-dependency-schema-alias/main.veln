use lib::wire from "example/dep"
use other::lib from "other/dep"

fn keep(note: String, packet: {value: Int}) -> {value: Int}
  packet
end

fn operations(view: ByteView, packet: {value: Int}) -> ()
  let decoded = keep("😀", decode lib::wire::WirePacket from view at byte_offset(0)?)
  let encoded = encode wire::WirePacket from packet
  let bare = encode WirePacket from packet
  let target_decoded = decode lib::wire::Packet from view at byte_offset(0)?
  let target_encoded = encode wire::Packet from packet
  let hidden_alias = decode lib::wire::Hidden from view at byte_offset(0)?
  let lexical_noise = "WirePacket"
  let private_target = decode lib::wire::PrivateTarget from view at byte_offset(0)?
  let invalid_import = decode lib::wire::InvalidImport from view at byte_offset(0)?
end
# WirePacket is lexical noise, not an operation leaf.

type WirePacket
  Local(Int)
end

schema Frame
  count: UInt8
  nested: lib::wire::WirePacket
  implicit: wire::WirePacket
  repeated: Repeat(count, lib::wire::WirePacket)
  array: [lib::wire::WirePacket; count]
  invalid_repeat: Repeat(count + 1, lib::wire::WirePacket)
  invalid_array: [lib::wire::WirePacket; count + 1]
end

fn identity_boundaries(view: ByteView, packet: {value: Int}) -> ()
  decode lib::wire::SiblingPacket from view at byte_offset(0)?
  encode other::lib::WirePacket from packet
end

schema IneligibleFrame
  count: UInt8
  direct: lib::wire::PrivateTarget
  repeated: Repeat(count, lib::wire::PrivateTarget)
  array: [lib::wire::PrivateTarget; count]
end

use lib::core from "example/dep"

fn target_identity_boundaries(view: ByteView, packet: {value: Int}) -> ()
  decode lib::core::Packet from view at byte_offset(0)?
  encode core::Packet from packet
  decode other::lib::Packet from view at byte_offset(0)?
  encode other::lib::Packet from packet
end
