effect Ask
  value() -> Int
  add(left: Int, right: Int) -> Int
end

fn provide(ctx:Int,value:Int)->Int
  ctx + value
end

handler ask(ctx:Int) handles Ask
  value()=>provide(ctx,1)
  add(left,right)=>if left == 0
    provide(ctx,right)
  else if left == 1
    provide(ctx,left)
  else
    provide(ctx,left + { left: right }.left)
  end
end
