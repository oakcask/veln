fn callsite(value: Int) -> Int
  value
end
fn parameter(callsite: Int) -> Int
  callsite
end
fn local() -> Int
  let callsite = 1
  callsite
end
fn caller() -> Int
  callsite(1)
end
fn pattern(value: {field: Int}) -> Int
  let {field: callsite} = value
  callsite
end
fn result_name() -> callsite: Int
ensure callsite > 0
  1
end
