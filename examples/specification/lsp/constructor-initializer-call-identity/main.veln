type Maker
  make(Int)
end

type Token
  pack(Int)
  build(Int)
end

fn direct(value: Int) -> Int
  value
end

fn make(value: Int) -> fn(Int) -> Int
  direct
end

pub fn main() -> Token
  let pack = make(0)
  pack(1)
end

fn source(value: Int) -> Int
  value
end

pub fn shadowed_initializer() -> Token
  let source = 0
  let build = source
  build(1)
end
