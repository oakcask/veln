// Doctest runtime contract expectations match independently from output text.
fn reject() -> ()
require false
  ()
end

/// ```veln runtime=contract clause=require predicate=false function=reject blame=caller
/// stdio::println("before failure")
/// reject()
/// ```
/// ```veln-output stream=stdout
/// before failure
/// ```
///
/// ```veln runtime=contract clause=require predicate=true function=reject blame=caller
/// reject()
/// ```
///
/// ```veln runtime=contract clause=require predicate=false
/// ()
/// ```
///
/// ```veln error=String runtime=contract clause=require predicate=false
/// Err("actual")?
/// ```
pub fn main() -> ()
  ()
end
