// Doctest runtime result expectations match returned Err values.
/// ```veln error=String runtime=result value=bad
/// stdio::println("before failure")
/// Err("bad")?
/// ```
/// ```veln-output stream=stdout
/// before failure
/// ```
///
/// ```veln error=String runtime=result value=expected
/// Err("actual")?
/// ```
///
/// ```veln error=String runtime=result value=bad
/// ()
/// ```
pub fn main() -> () effects []
  ()
end
