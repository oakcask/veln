use helpers

type Header
	Header {too_many: Int, unsupported_fourth: Int, nested_converter: Int, imported_bad_fourth: Int}
end

fn five(value: Int, extra: Int, another: Int, final: Int, overflow: Int) -> Int
	value + extra + another + final + overflow
end

fn combine(value: Int, extra: Int, another: Int, final: Int) -> Int
	value + extra + another + final
end

fn identity(value: Int) -> Int
	value
end

schema HeaderWire
	format binary

	kind: UInt8
	length: UInt8

	map to Header
		too_many = five(kind, length, kind, length, kind)
		unsupported_fourth = combine(kind, length, kind, kind == 1)
		nested_converter = combine(kind, length, kind, identity(kind))
		imported_bad_fourth = helpers::combine_text(kind, length, kind, length)
end
