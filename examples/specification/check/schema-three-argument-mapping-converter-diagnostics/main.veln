use helpers

type Header
	Header {too_many: Int, unsupported_fifth: Int, nested_converter: Int, imported_bad_fifth: Int}
end

fn six(value: Int, extra: Int, another: Int, final: Int, overflow: Int, spare: Int) -> Int
	value + extra + another + final + overflow + spare
end

fn combine(value: Int, extra: Int, another: Int, final: Int, overflow: Int) -> Int
	value + extra + another + final + overflow
end

fn identity(value: Int) -> Int
	value
end

schema HeaderWire
	format binary

	kind: UInt8
	length: UInt8

	map to Header
		too_many = six(kind, length, kind, length, kind, length, kind)
		unsupported_fifth = combine(kind, length, kind, length, kind == 1)
		nested_converter = combine(kind, length, kind, length, identity(kind))
		imported_bad_fifth = helpers::combine_text(kind, length, kind, length, length)
end
