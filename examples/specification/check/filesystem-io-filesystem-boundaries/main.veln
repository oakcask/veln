use fs from "std"
use io from "std"
use io_provider from "std"
use path as portable from "std"

pub fn read_only_cannot_mutate(filesystem: fs::Filesystem, name: portable::Path) -> Result<fs::WriteFile, io::Error> effects [fs::Mutate]
	fs::open_write(filesystem, name, fs::WriteMode::WriteMode(fs::CreateMode::Existing, false))
end

pub fn factories_remain_distinct(owner: io_provider::Owner) -> () effects [concurrency]
	let _: Result<fs::MutableFilesystem, io::Error> = io_provider::filesystem(owner, 1)
	let _: Result<fs::Filesystem, io::Error> = io_provider::mutable_filesystem(owner, 2)
	()
end

pub fn projections_remain_distinct(resource: io_provider::Resource) -> Result<fs::WriteFile, io::Error>
	io_provider::read_file(resource)
end

pub fn write_projection_is_not_read(resource: io_provider::Resource) -> Result<fs::ReadFile, io::Error>
	io_provider::write_file(resource)
end

pub fn update_projection_is_not_append(resource: io_provider::Resource) -> Result<fs::AppendFile, io::Error>
	io_provider::update_file(resource)
end

pub fn append_projection_is_not_update(resource: io_provider::Resource) -> Result<fs::UpdateFile, io::Error>
	io_provider::append_file(resource)
end

pub fn duplex_projection_is_not_read_file(resource: io_provider::Resource) -> Result<fs::ReadFile, io::Error>
	io_provider::duplex(resource)
end


# F1 compiler contract: provider identities and both namespace-token families
# remain pairwise distinct at public adapter operands.
pub fn provider_identity_families_do_not_cross(owner: io_provider::Owner, resource: io_provider::Resource, filesystem: fs::Filesystem, mutable: fs::MutableFilesystem) -> () effects [concurrency]
	let _ = io_provider::slot(owner, owner)
	let _ = io_provider::slot(resource, resource)
	let _ = io_provider::filesystem_slot(owner, owner)
	let _ = io_provider::mutable_filesystem_slot(owner, owner)
	let _ = io_provider::read_file(filesystem)
	let _ = io_provider::read_file(mutable)
	()
end
