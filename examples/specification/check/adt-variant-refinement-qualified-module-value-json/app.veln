use a::b as wire

fn identity_and_scope() -> ()
	let current: Int = 0
	match wire::current
		a::b::State::Ready => begin
			let direct: a::b::State::Ready = a::b::current
			let aliased: wire::State::Ready = wire::current
			()
		end
		a::b::State::Closed => ()
		a::b::State::Failed => ()
	end
	let restored: wire::State::Ready = a::b::current
end

fn coverage() -> ()
	match wire::limited
		a::b::State::Failed => ()
		a::b::State::Ready => ()
		a::b::State::Ready => ()
		remaining => begin
			let closed: wire::State::Closed = wire::limited
			let bound: wire::State::Closed = remaining
			()
		end
	end
end

fn alias_composition() -> ()
	let local = ((wire::limited))
	let transitive = local
	let widened: wire::State = transitive
	match wire::limited
		a::b::State::Ready => begin
			let local_ready: wire::State::Ready = local
			let transitive_ready: wire::State::Ready = transitive
			let widened_ready: wire::State::Ready = widened
			()
		end
		remaining => begin
			let local_closed: wire::State::Closed = local
			let bound_closed: wire::State::Closed = remaining
			()
		end
	end
	match widened
		a::b::State::Failed => ()
		a::b::State::Ready => begin
			let direct: wire::State::Ready = a::b::limited
			let aliased: wire::State::Ready = wire::limited
			()
		end
		a::b::State::Ready => ()
		remaining => begin
			let direct: wire::State::Closed = wire::limited
			match transitive
				a::b::State::Closed => begin
					let nested: wire::State::Closed = widened
					()
				end
			end
			let restored_outer: wire::State::Closed = local
			let bound_closed: wire::State::Closed = remaining
			()
		end
	end
	let restored: wire::State::Ready = transitive
end

fn computed_call() -> ()
	match wire::read()
		a::b::State::Ready => begin
			let repeated: wire::State::Ready = wire::read()
			()
		end
		a::b::State::Closed => ()
		a::b::State::Failed => ()
	end
end

fn module_field_composition() -> ()
	let local = wire::snapshot
	let transitive = local
	let unrelated = wire::other_snapshot
	match a::b::snapshot.session.state
		a::b::State::Failed => begin
			let preserved: wire::State::Closed = unrelated.session.state
			()
		end
		a::b::State::Ready => begin
			let direct: wire::State::Ready = a::b::snapshot.session.state
			let aliased: wire::State::Ready = wire::snapshot.session.state
			let rooted_local: wire::State::Ready = local.session.state
			let transitive_local: wire::State::Ready = transitive.session.state
			let preserved: wire::State::Closed = unrelated.session.state
			()
		end
		a::b::State::Ready => ()
		remaining => begin
			let direct: wire::State::Closed = wire::snapshot.session.state
			let rooted_local: wire::State::Closed = local.session.state
			let residual: wire::State::Closed = remaining
			()
		end
	end
	let restored_direct: wire::State::Ready = wire::snapshot.session.state
	let restored_local: wire::State::Ready = transitive.session.state
	match wire::read_snapshot().session.state
		a::b::State::Ready => begin
			let repeated: wire::State::Ready = wire::read_snapshot().session.state
			()
		end
		a::b::State::Closed => ()
		a::b::State::Failed => ()
	end
	let copied = {session: {state: wire::snapshot.session.state}}
	match copied.session.state
		a::b::State::Ready => begin
			let declaration_unchanged: wire::State::Ready = wire::snapshot.session.state
			()
		end
		a::b::State::Closed => ()
	end
	let preserved_after_failures: wire::State::Closed = unrelated.session.state
end

fn inaccessible_private_path() -> ()
	match wire::private_current
		_ => ()
	end
end
