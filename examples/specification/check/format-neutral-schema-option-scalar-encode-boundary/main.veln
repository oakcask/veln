schema UnsupportedOptionPacket
	items: Option<Option<Int>>
end

fn direct(packet: {items: Option<Option<Int>>}) -> Result<{items: Option<Option<Int>>}, String>
	byte_encode_unsupported_option_packet(packet)
end

fn explicit(packet: {items: Option<Option<Int>>}) -> Result<{items: Option<Option<Int>>}, String>
	encode UnsupportedOptionPacket from packet
end
