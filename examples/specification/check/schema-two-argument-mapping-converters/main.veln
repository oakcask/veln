use helpers

type Header
	Header {same_module: Int, imported: Int}
end

fn combine(input: {value: Int}, extra: Int) -> Int
	input.value + extra
end

schema HeaderWire
	format binary

	length: UInt16be
	kind: UInt8

	map to Header
		same_module = combine({value: kind}, length)
		imported = helpers::merge({value: kind}.value, length + 1)
end
