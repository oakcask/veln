use net from "std"
use transport from "std"
use transport::net from "std"

fn read_one() -> Result<Option<ByteChunk>, net::NetError> effects [transport::DuplexStream]
	perform transport::DuplexStream::read_chunk()
end

pub fn unhandled_requires_duplex_stream() -> Result<Option<ByteChunk>, net::NetError>
	read_one()
end

pub fn handled_requires_net(stream: net::Stream) -> Result<Option<ByteChunk>, net::NetError>
	handle read_one() with transport::net::net_stream(stream)
end

pub fn handled_effect_boundary(stream: net::Stream) -> Result<Option<ByteChunk>, net::NetError> effects [net::IO]
	handle read_one() with transport::net::net_stream(stream)
end
