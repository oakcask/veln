type Header
	Header {wrapped: FrameKind, bad_arity: FrameKind, bad_type: FrameKind, bad_nested_type: FrameKind, bad_operand: Int, literal_operand_bad_type: Int, unsupported_record_operand: Int, unsupported_operator: Int}
end

type FrameKind
	FrameKind(Int)
end

type Payload
	Payload(Int)
end

schema HeaderWire
	format binary

	length: UInt16be
	kind: UInt8
	payload: ByteView(length)

	map to Header
		wrapped = Missing(kind)
		bad_arity = FrameKind(kind, length)
		bad_type = FrameKind({value: kind})
		bad_nested_type = FrameKind(Payload(kind))
		bad_operand = length * payload
		literal_operand_bad_type = payload + 1
		unsupported_record_operand = {value: length} + kind
		unsupported_operator = kind == length
end
