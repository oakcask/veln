type Secret
	pub One
	pub Two
end

pub type State
	pub Open
	Hidden
	Closed
end

type GenericSecret<A>
	pub Hidden(A)
end

pub type GenericState<A>
	Hidden(A)
end

pub fn private_base_parameter(value: Secret::One) -> ()
	()
end

pub fn private_base_result() -> Secret::Two
	Two
end

pub fn qualified_private_base_parameter(value: main::Secret::One) -> ()
	()
end

pub fn private_variant_parameter(value: State::Hidden) -> ()
	()
end

pub fn private_variant_result() -> State::Closed
	Closed
end

pub fn private_union(value: State::Closed | State::Hidden | State::Closed) -> ()
	()
end

pub fn invalid_arity_private_base(value: GenericSecret::Hidden) -> ()
	()
end

pub fn invalid_arity_private_variant(value: GenericState::Hidden) -> ()
	()
end
