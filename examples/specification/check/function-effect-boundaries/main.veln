# Function-typed values must carry every effect that the actual callable may perform.
fn printer(text: String) -> () effects [stdio]
  stdio::println(text)
end

fn pure_sink(text: String) -> () effects []
  ()
end

fn accepts_stdio() -> fn(String) -> () effects [stdio] effects []
  pure_sink
end

pub fn callback_factory() -> fn(String) -> () effects [] effects []
  printer
end
