type Header
	Header {missing: Int, too_few: Int, bad_input: Int, bad_return: Int, impure: Int, unsupported_arg: Int}
end

fn two_params(value: Int, extra: Int) -> Int
	value
end

fn needs_text(value: String) -> Int
	0
end

fn to_text(value: Int) -> String
	int_to_string(value)
end

fn noisy(value: Int) -> Int effects [stdio]
	value
end

fn convert(value: Int) -> Int
	value
end

schema HeaderWire
	format binary

	kind: UInt8
	length: UInt8

	map to Header
		missing = missing_converter(kind) + length
		too_few = two_params(kind) + length
		bad_input = needs_text(kind) + length
		bad_return = to_text(kind) + length
		impure = noisy(kind) + length
		unsupported_arg = convert(kind == 1) + length
end
