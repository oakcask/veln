type CallbackCarrier
	Processor(run: fn(Int) -> String)
end

type GenericCarrier<A>
	GenericProcessor(run: fn(A, Int) -> String)
end

fn string_body(value) -> String
	let text: String = value
	text
end

fn option_string_body(value) -> String
	let text: String = value
	text
end

fn missing_context(value, fixed) -> String
	"ok"
end

fn missing_option_context(value) -> String
	"ok"
end

fn missing_ok_context(value) -> String
	"ok"
end

fn missing_err_context(value) -> String
	"ok"
end

pub fn body_conflict() -> CallbackCarrier
	Processor(string_body)
end

pub fn non_concrete_payload() -> String
	let processor = GenericProcessor(missing_context)
	"ok"
end

pub fn option_body_conflict() -> Option<fn(Int) -> String>
	Some(option_string_body)
end

pub fn unconstrained_option_payload() -> String
	let processor = Some(missing_option_context)
	"ok"
end

pub fn unconstrained_result_payloads() -> String
	let success = Ok(missing_ok_context)
	let failure = Err(missing_err_context)
	"ok"
end
