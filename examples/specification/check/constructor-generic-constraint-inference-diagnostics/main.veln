type State
	Ready
	Closed
	Failed
end

type Pair<T>
	Paired(T, T)
end

type Upper<T>
	UpperValue(fn(T) -> (), fn(T) -> ())
end

type Phantom<T>
	Empty
end

type Irrelevant<T>
	IrrelevantValue(Phantom<T>)
end

type Exact<T>
	ExactValue(fn(T) -> T, T, T)
end

fn accepts_int(value: Int) -> ()
	()
end

fn accepts_string(value: String) -> ()
	()
end

fn ready_identity(value: State::Ready) -> State::Ready
	value
end

fn rollback(callback: fn(State::Ready) -> State::Ready, rejected: State::Closed, later: State::Ready)
	ExactValue(callback, rejected, later)
end

pub fn main() -> ()
	let value: Phantom<State::Ready> = Empty
	let missing = IrrelevantValue(value)
	let unavailable_join = Paired(1, "text")
	let unavailable_meet = UpperValue(accepts_int, accepts_string)
	let retained = rollback(ready_identity, Closed, Ready)
end
