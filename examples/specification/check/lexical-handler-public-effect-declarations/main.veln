effect Ask
	value() -> Int
end

fn traced(offset: Int) -> Int effects [stdio]
	stdio::println("provider")
	offset + 1
end

pub handler missing(offset: Int) for Ask
	value() => traced(offset)
end

pub handler declared(offset: Int) for Ask effects [stdio, stdio]
	value() => traced(offset)
end

fn compute() -> Int effects [Ask]
	perform Ask::value()
end

pub fn run_case() -> Int effects [stdio]
	handle compute() with declared(41)
end
