# Binary schema field references stay schema-local and point backward.

schema MissingRepeatCount
	format binary

	available_count: UInt8
	items: Repeat(missing_count, UInt8)
end

schema ForwardRepeatCount
	format binary

	available_count: UInt8
	items: Repeat(later_count, UInt8)
	later_count: UInt8
end

schema WrongRepeatCount
	format binary

	available_count: UInt8
	flags: ByteView(available_count)
	items: Repeat(flags, UInt8)
end

schema MissingRepeatAddOperand
	format binary

	available_count: UInt8
	items: Repeat(available_count + missing_count, UInt8)
end

schema ForwardRepeatAddOperand
	format binary

	available_count: UInt8
	items: Repeat(available_count + later_count, UInt8)
	later_count: UInt8
end

schema WrongRepeatAddOperand
	format binary

	available_count: UInt8
	flags: ByteView(available_count)
	items: Repeat(available_count + flags, UInt8)
end

schema MissingByteViewLength
	format binary

	available_length: UInt8
	payload: ByteView(missing_length)
end

schema ForwardByteViewLength
	format binary

	available_length: UInt8
	payload: ByteView(later_length)
	later_length: UInt8
end

schema WrongByteViewLength
	format binary

	available_length: UInt8
	flags: ByteView(available_length)
	payload: ByteView(flags)
end

schema MissingByteViewAddOperand
	format binary

	available_length: UInt8
	payload: ByteView(available_length + missing_length)
end

schema ForwardByteViewAddOperand
	format binary

	available_length: UInt8
	payload: ByteView(available_length + later_length)
	later_length: UInt8
end

schema WrongByteViewAddOperand
	format binary

	available_length: UInt8
	flags: ByteView(available_length)
	payload: ByteView(available_length + flags)
end

schema MissingByteViewProductOperand
	format binary

	available_length: UInt8
	payload: ByteView(available_length * missing_length)
end

schema ForwardByteViewProductOperand
	format binary

	available_length: UInt8
	payload: ByteView(available_length * later_length)
	later_length: UInt8
end

schema WrongByteViewProductOperand
	format binary

	available_length: UInt8
	flags: ByteView(available_length)
	payload: ByteView(available_length * flags)
end

schema MissingDispatchTag
	format binary

	available_tag: UInt8
	payload: Dispatch(missing_tag, 1 => UInt8)
end

schema ForwardDispatchTag
	format binary

	available_tag: UInt8
	payload: Dispatch(later_tag, 1 => UInt8)
	later_tag: UInt8
end

schema WrongDispatchTag
	format binary

	available_tag: UInt8
	flags: ByteView(available_tag)
	payload: Dispatch(flags, 1 => UInt8)
end

schema MissingExtensionTag
	format binary

	available_tag: UInt8
	length: UInt8
	payload: ExtensionDispatch(missing_extension_tag, length, 1 => UInt8)
end

schema ForwardExtensionTag
	format binary

	available_tag: UInt8
	length: UInt8
	payload: ExtensionDispatch(later_extension_tag, length, 1 => UInt8)
	later_extension_tag: UInt8
end

schema WrongExtensionTag
	format binary

	available_tag: UInt8
	length: UInt8
	extension_tag_value: ByteView(length)
	payload: ExtensionDispatch(extension_tag_value, length, 1 => UInt8)
end

schema MissingExtensionLength
	format binary

	kind: UInt8
	available_length: UInt8
	payload: ExtensionDispatch(kind, missing_extension_length, 1 => UInt8)
end

schema ForwardExtensionLength
	format binary

	kind: UInt8
	available_length: UInt8
	payload: ExtensionDispatch(kind, later_extension_length, 1 => UInt8)
	later_extension_length: UInt8
end

schema WrongExtensionLength
	format binary

	kind: UInt8
	available_length: UInt8
	extension_length_value: ByteView(available_length)
	payload: ExtensionDispatch(kind, extension_length_value, 1 => UInt8)
end
