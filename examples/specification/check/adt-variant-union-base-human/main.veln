use first
use second

type Empty
end

type Left
	A
end

type Right
	B
end

type Box<A>
	Present(A)
	Absent
end

fn different_adts(value: Left::A | Right::B | Right::B) -> ()
	()
end

fn generic_arguments(value: Box<Int>::Present | Box<String>::Absent) -> ()
	()
end

fn failed_before(value: Empty::Missing | Left::A | Right::B) -> ()
	()
end

fn colliding_identities(value: first::State::Ready | second::State::Ready) -> ()
	()
end

fn nested_colliding_identities(value: Box<first::State>::Present | Box<second::State>::Absent) -> ()
	()
end

fn nested_refinement_colliding_identities(value: Box<first::State::Ready>::Present | Box<second::State::Ready>::Absent) -> ()
	()
end

schema InvalidPacket
	format binary

	invalid: Left::A | Right::B
	sibling: UInt8

	validate invalid == sibling
	validate true
end
