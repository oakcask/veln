use http2::connection from "std"
use http2::core from "std"
use http2::hpack from "std"
use transport from "std"
use transport::net from "std"

fn pure_callback() -> Int
	1
end

fn db_callback() -> Int effects [db]
	2
end

fn stdio_callback() -> Int effects [stdio]
	3
end

fn ascii_header(name: String, value: String) -> Result<HeaderField, String>
	Ok(http2::hpack::header_field(name, byte_chunk_from_visible_ascii_string(value)?))
end

fn response_headers() -> Result<HeaderList, String>
	Ok(http2::hpack::prepend_header_field(ascii_header(":status", "204")?, http2::hpack::empty_header_list()))
end

fn pure_handler(event: Http2ApplicationEvent) -> Result<List<Http2ApplicationAction>, String>
	Ok(list_cons(Http2ApplicationAction::Http2SendResponseHeaders(http2::core::application_event_stream_id(event), response_headers()?, true), list_nil()))
end

fn db_handler(event: Http2ApplicationEvent) -> Result<List<Http2ApplicationAction>, String> effects [db]
	Ok(list_cons(Http2ApplicationAction::Http2SendResponseHeaders(http2::core::application_event_stream_id(event), response_headers()?, true), list_nil()))
end

fn connection_boundary<effect E>(callback: fn() -> Int effects [...E]) -> Int effects [transport::DuplexStream, ...E]
	callback()
end

fn stdio_boundary<effect E>(callback: fn() -> Int effects [...E]) -> Int effects [stdio, ...E]
	callback()
end

fn callback_parameter<effect E>(callback: fn() -> Int effects [...E]) -> Int effects [...E]
	callback()
end

pub fn pure_substitution_missing_transport() -> Int
	connection_boundary(pure_callback)
end

pub fn db_substitution_missing_db() -> Int effects [transport::DuplexStream]
	connection_boundary(db_callback)
end

pub fn duplicate_stdio_appears_once() -> Int
	stdio_boundary(stdio_callback)
end

pub fn compatible_pure_callback() -> Int
	callback_parameter(pure_callback)
end

pub fn compatible_effectful_callback() -> Int effects [stdio]
	callback_parameter(stdio_callback)
end

pub fn handled_transport_preserves_row(stream: NetStream) -> Int effects [net]
	handle connection_boundary(db_callback) with transport::net::net_stream(stream)
end

pub fn public_service_connection_missing_transport() -> Result<(), Http2ServiceFailure>
	http2::connection::serve_connection(pure_handler)
end

pub fn public_tcp_service_missing_net_and_concurrency(listener: NetListener) -> Result<(), Http2ServiceFailure>
	http2::connection::serve_tcp(listener, pure_handler)
end

pub fn public_tcp_service_missing_db(listener: NetListener) -> Result<(), Http2ServiceFailure> effects [net, concurrency]
	http2::connection::serve_tcp(listener, db_handler)
end
