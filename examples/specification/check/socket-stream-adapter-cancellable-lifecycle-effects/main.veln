use net from "std"

# Cancellable socket lifecycle keeps handlers pure and adapter effects explicit.
type ResponseAction
	SendBytes(bytes: ByteChunk)
	EndStream
	RetryAfterDeadline
	CleanupAfterCancel
end

fn handle_stream_input(input: StreamInput, state: { chunks : Int, ended : Bool }) -> { actions : List<ResponseAction>, next_state : { chunks : Int, ended : Bool } }
	match input
		Chunk(bytes) => { actions: list_cons(SendBytes(bytes), list_nil()), next_state: { chunks: state.chunks + 1, ended: state.ended } }
		End => { actions: list_cons(EndStream, list_nil()), next_state: { chunks: state.chunks, ended: true } }
	end
end

fn prepend_wait_action(outcome: CancellableWaitOutcome, handled: { actions : List<ResponseAction>, next_state : { chunks : Int, ended : Bool } }) -> { actions : List<ResponseAction>, next_state : { chunks : Int, ended : Bool } }
	match outcome
		WaitCompleted => handled
		WaitDeadlineExpired => { actions: list_cons(RetryAfterDeadline, handled.actions), next_state: handled.next_state }
		WaitCancelled => { actions: list_cons(CleanupAfterCancel, handled.actions), next_state: handled.next_state }
	end
end

fn route_input(route: { tx : Sender<StreamInput>, rx : Receiver<StreamInput> }, input: StreamInput) -> StreamInput effects [concurrency]
	let _ = channel::send(route.tx, input)
	match channel::recv(route.rx)
		Some(value) => value
		None => End
	end
end

fn collect_cancellable_actions(stream: net::Stream, state: { chunks : Int, ended : Bool }, deadline: Deadline, token: CancelToken) -> { actions : List<ResponseAction>, next_state : { chunks : Int, ended : Bool } } effects [net::IO, time, concurrency]
	let route = channel::bounded<StreamInput>(1)
	let input = route_input(route, Chunk(read_stream_chunk(stream)))
	let handled = handle_stream_input(input, state)
	prepend_wait_action(time::wait_until_cancellable_outcome(deadline, token), handled)
end

pub fn handler_boundary(input: StreamInput, state: { chunks : Int, ended : Bool }) -> { actions : List<ResponseAction>, next_state : { chunks : Int, ended : Bool } }
	handle_stream_input(input, state)
end

pub fn adapter_missing_time(stream: net::Stream, state: { chunks : Int, ended : Bool }, deadline: Deadline, token: CancelToken) -> { actions : List<ResponseAction>, next_state : { chunks : Int, ended : Bool } } effects [net::IO, concurrency]
	collect_cancellable_actions(stream, state, deadline, token)
end

pub fn adapter_missing_concurrency(stream: net::Stream, state: { chunks : Int, ended : Bool }, deadline: Deadline, token: CancelToken) -> { actions : List<ResponseAction>, next_state : { chunks : Int, ended : Bool } } effects [net::IO, time]
	collect_cancellable_actions(stream, state, deadline, token)
end

pub fn adapter_missing_net(stream: net::Stream, state: { chunks : Int, ended : Bool }, deadline: Deadline, token: CancelToken) -> { actions : List<ResponseAction>, next_state : { chunks : Int, ended : Bool } } effects [time, concurrency]
	collect_cancellable_actions(stream, state, deadline, token)
end

fn read_stream_chunk(stream: net::Stream) -> ByteChunk effects [net::IO]
	match net::read(stream)
		Ok(net::ReadChunk(bytes)) => bytes
		_ => byte_chunk([])
	end
end
