	handle_selected(selected.index, selected.value, state)
end

pub fn handler_boundary(stream_id: Int, input: StreamInput, state: { chunks : Int, ended : Bool }) -> { actions : List<ResponseAction>, next_state : { chunks : Int, ended : Bool } }
	handle_stream_input(stream_id, input, state)
end

pub fn adapter_missing_concurrency(first_input: StreamInput, second_input: StreamInput, third_input: StreamInput, fourth_input: StreamInput, fifth_input: StreamInput, sixth_input: StreamInput, seventh_input: StreamInput, eighth_input: StreamInput, ninth_input: StreamInput, tenth_input: StreamInput, eleventh_input: StreamInput, twelfth_input: StreamInput, thirteenth_input: StreamInput, fourteenth_input: StreamInput, fifteenth_input: StreamInput, sixteenth_input: StreamInput, seventeenth_input: StreamInput, eighteenth_input: StreamInput, nineteenth_input: StreamInput, twentieth_input: StreamInput, twenty_first_input: StreamInput, twenty_second_input: StreamInput, twenty_third_input: StreamInput, twenty_fourth_input: StreamInput, twenty_fifth_input: StreamInput, twenty_sixth_input: StreamInput, twenty_seventh_input: StreamInput, twenty_eighth_input: StreamInput, twenty_ninth_input: StreamInput, thirtieth_input: StreamInput, state: { chunks : Int, ended : Bool }) -> { actions : List<ResponseAction>, next_state : { chunks : Int, ended : Bool } }
