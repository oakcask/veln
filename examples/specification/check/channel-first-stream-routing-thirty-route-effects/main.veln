	channel::close(twenty_seventh.tx)
	channel::close(twenty_eighth.tx)
	channel::close(twenty_ninth.tx)
	channel::close(thirtieth.tx)
	let receivers: List<Receiver<StreamInput>> = list_cons(first.rx, list_cons(second.rx, list_cons(third.rx, list_cons(fourth.rx, list_cons(fifth.rx, list_cons(sixth.rx, list_cons(seventh.rx, list_cons(eighth.rx, list_cons(ninth.rx, list_cons(tenth.rx, list_cons(eleventh.rx, list_cons(twelfth.rx, list_cons(thirteenth.rx, list_cons(fourteenth.rx, list_cons(fifteenth.rx, list_cons(sixteenth.rx, list_cons(seventeenth.rx, list_cons(eighteenth.rx, list_cons(nineteenth.rx, list_cons(twentieth.rx, list_cons(twenty_first.rx, list_cons(twenty_second.rx, list_cons(twenty_third.rx, list_cons(twenty_fourth.rx, list_cons(twenty_fifth.rx, list_cons(twenty_sixth.rx, list_cons(twenty_seventh.rx, list_cons(twenty_eighth.rx, list_cons(twenty_ninth.rx, list_cons(thirtieth.rx, list_nil()))))))))))))))))))))))))))))))
	let selected: { index : Int, value : StreamInput } = match channel::select_many_priority(receivers)
		Some(value) => value
