	let _ = channel::send(twenty_eighth.tx, twenty_eighth_input)
	let _ = channel::send(twenty_ninth.tx, twenty_ninth_input)
	let _ = channel::send(thirtieth.tx, thirtieth_input)
	channel::close(first.tx)
	channel::close(second.tx)
	channel::close(third.tx)
	channel::close(fourth.tx)
	channel::close(fifth.tx)
	channel::close(sixth.tx)
