effect Audit
  save(entry: Int) -> Int
end

handler serve(_Ctx: Int) handles Audit
  save(_Entry) => _Entry
end

fn main(Bad: Int) -> ResultName: Int
  let {field: _Destructured} = {field: 1}
  let _Let = _value satisfy BadCandidate => BadCandidate > 0
  let Value = 1
  match Bad
    _Arm => _Arm
  end
end
