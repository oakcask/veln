use facade
use wire

fn missing(value: {length: Int}) -> Result<ByteChunk, EncodeError>
	encode MissingPacket from value
end

fn private_schema(value: {length: Int}) -> Result<ByteChunk, EncodeError>
	encode wire::PrivatePacket from value
end

fn wrong_function(value: {length: Int}) -> Result<ByteChunk, EncodeError>
	encode wire::make_packet from value
end

fn wrong_type(value: {length: Int}) -> Result<ByteChunk, EncodeError>
	encode wire::PacketShape from value
end

fn missing_alias_target(value: {length: Int}) -> Result<ByteChunk, EncodeError>
	encode facade::MissingAlias from value
end

fn private_alias_target(value: {length: Int}) -> Result<ByteChunk, EncodeError>
	encode facade::PrivateAlias from value
end

fn function_alias_target(value: {length: Int}) -> Result<ByteChunk, EncodeError>
	encode facade::FunctionAlias from value
end

fn type_alias_target(value: {length: Int}) -> Result<ByteChunk, EncodeError>
	encode facade::TypeAlias from value
end

fn codec_alias_target(value: {length: Int}) -> Result<ByteChunk, EncodeError>
	encode facade::CodecAlias from value
end
