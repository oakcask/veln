use net from "std"

# Compiler integration contract: cancellable accept keeps time and nominal IO effects distinct.
pub fn accept_until_cancellable_missing_time(listener: net::Listener, deadline: Deadline, token: CancelToken) -> Result<net::Stream, net::NetError> effects [net::IO]
	time::wait_until(deadline)
	net::accept_with(listener, Some(deadline), Some(token))
end

pub fn accept_until_cancellable_missing_net(listener: net::Listener, deadline: Deadline, token: CancelToken) -> Result<net::Stream, net::NetError> effects [time]
	net::accept_with(listener, Some(deadline), Some(token))
end
