type Header
	Header {length: Int, kind: Int}
end

schema HeaderWire
	format binary

	wire_length: UInt16be
	wire_kind: UInt8

	map to Header
		length = decode_length(wire_length)
		kind = wire_kind
end

fn decode_length(value: Int) -> Int
	value
end

codec HeaderCodec for HeaderWire encode
	derive encode
end
