# Parenthesized bindings refine directly. Qualified values, alias provenance,
# field paths, indexed lookup calls, and other computed expressions remain
# outside that rule.
use states

type State
	Ready
	Closed
	Failed
end

fn accept_ready(value: State::Ready) -> ()
	()
end

fn preserve(value: State::Ready | State::Closed) -> State::Ready | State::Closed
	value
end

fn alias_source(value: State::Ready | State::Closed) -> ()
	let current: State::Ready | State::Closed = value
	let transitive: State::Ready | State::Closed = current
	match ((transitive))
		Ready => begin
			accept_ready(transitive)
			accept_ready(current)
			accept_ready(value)
		end
		Closed => ()
	end
end

fn field_path(holder: {state: State::Ready | State::Closed}) -> ()
	match holder.state
		Ready => accept_ready(holder.state)
		Closed => ()
		Failed => ()
	end
end

fn computed_call(value: State::Ready | State::Closed) -> ()
	match preserve(value)
		Ready => accept_ready(value)
		Closed => ()
		Failed => ()
	end
end

fn indexed_lookup(value: State::Ready | State::Closed) -> State::Ready | State::Closed
	value
end

fn indexed(value: State::Ready | State::Closed) -> ()
	match ((indexed_lookup(value)))
		Ready => accept_ready(indexed_lookup(value))
		Closed => ()
		Failed => ()
	end
end

fn pipelined(value: State::Ready | State::Closed) -> ()
	match (value |> preserve())
		Ready => accept_ready(value)
		Closed => ()
		Failed => ()
	end
end

fn constructed(value: State::Ready | State::Closed) -> ()
	match State::Ready
		Ready => accept_ready(value)
		Closed => ()
		Failed => ()
	end
end

fn qualified_value(value: State::Ready | State::Closed) -> ()
	match ((states::RemoteReady))
		states::RemoteReady => accept_ready(value)
		states::RemoteClosed => ()
		_ => ()
	end
end
