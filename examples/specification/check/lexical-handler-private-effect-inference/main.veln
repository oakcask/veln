effect Ask
	value() -> Int
end

fn provide(offset: Int) -> Int effects [stdio]
	stdio::println("provider")
	offset + 1
end

handler ask(offset: Int) handles Ask
	value() => provide(offset)
end

fn compute() -> Int effects [Ask]
	perform Ask::value()
end

pub fn run_case() -> Int
	handle compute() with ask(41)
end
