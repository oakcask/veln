effect Ask
	value() -> Int
end

fn provide(offset: Int) -> Int effects [stdio]
	stdio::println("provider")
	offset + 1
end

handler ask(offset: Int) handles Ask
	value() => provide(offset)
end

fn compute() -> Int effects [Ask]
	perform Ask::value()
end

fn compute_in_region() -> Int
	handle begin
		perform Ask::value()
	end with ask(41)
end

pub fn run_case() -> Int
	let direct = handle compute() with ask(41)
	let begun = compute_in_region()
	direct + begun
end
