# Cancellable receiver-list selection keeps handlers pure and adapter effects explicit.
type ResponseAction
	SendBytes {stream_id: Int, bytes: ByteChunk}
	EndStream {stream_id: Int}
	RetryAfterDeadline {stream_id: Int}
	CleanupAfterCancel {stream_id: Int}
	Decline {stream_id: Int}
end

fn handle_stream_input(stream_id: Int, input: StreamInput, state: { chunks : Int, ended : Bool }) -> { actions : List<ResponseAction>, next_state : { chunks : Int, ended : Bool } }
	match input
		Chunk(bytes) => { actions: list_cons(SendBytes(stream_id, bytes), list_nil()), next_state: { chunks: state.chunks + 1, ended: state.ended } }
		End => { actions: list_cons(EndStream(stream_id), list_nil()), next_state: { chunks: state.chunks, ended: true } }
	end
end

fn stream_id_for_index(index: Int) -> Int
	match index
		0 => 11
		1 => 13
		_ => 17
	end
end

fn handle_selected(selected: { index : Int, value : StreamInput }, state: { chunks : Int, ended : Bool }) -> { actions : List<ResponseAction>, next_state : { chunks : Int, ended : Bool } }
	handle_stream_input(stream_id_for_index(selected.index), selected.value, state)
end

fn handle_selection_result(selected: Result<Option<{ index : Int, value : StreamInput }>, SelectError>, state: { chunks : Int, ended : Bool }) -> { actions : List<ResponseAction>, next_state : { chunks : Int, ended : Bool } }
	match selected
		Ok(Some(route)) => handle_selected(route, state)
		Ok(None) => { actions: list_cons(Decline(0), list_nil()), next_state: state }
		Err(_) => { actions: list_cons(CleanupAfterCancel(17), list_nil()), next_state: state }
	end
end

fn route_with_cancellable_channel_first(receivers: List<Receiver<StreamInput>>, state: { chunks : Int, ended : Bool }, token: CancelToken) -> { actions : List<ResponseAction>, next_state : { chunks : Int, ended : Bool } } effects [time, concurrency]
	handle_selection_result(channel::select_many_timeout_cancellable(receivers, 25, token), state)
end

pub fn handler_boundary(stream_id: Int, input: StreamInput, state: { chunks : Int, ended : Bool }) -> { actions : List<ResponseAction>, next_state : { chunks : Int, ended : Bool } }
	handle_stream_input(stream_id, input, state)
end

pub fn adapter_missing_time(receivers: List<Receiver<StreamInput>>, state: { chunks : Int, ended : Bool }, token: CancelToken) -> { actions : List<ResponseAction>, next_state : { chunks : Int, ended : Bool } } effects [concurrency]
	route_with_cancellable_channel_first(receivers, state, token)
end

pub fn adapter_missing_concurrency(receivers: List<Receiver<StreamInput>>, state: { chunks : Int, ended : Bool }, token: CancelToken) -> { actions : List<ResponseAction>, next_state : { chunks : Int, ended : Bool } } effects [time]
	route_with_cancellable_channel_first(receivers, state, token)
end
