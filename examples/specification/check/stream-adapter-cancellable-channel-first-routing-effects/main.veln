# Cancellable receiver-list routing keeps handlers pure and adapter effects explicit.
type ResponseAction
	SendBytes {stream_id: Int, bytes: ByteChunk}
	EndStream {stream_id: Int}
	RetryAfterDeadline {stream_id: Int}
	CleanupAfterCancel {stream_id: Int}
	Decline {stream_id: Int}
end

fn handle_stream_input(stream_id: Int, input: StreamInput, state: { chunks : Int, ended : Bool }) -> { actions : List<ResponseAction>, next_state : { chunks : Int, ended : Bool } }
	match input
		Chunk(bytes) => { actions: list_cons(SendBytes(stream_id, bytes), list_nil()), next_state: { chunks: state.chunks + 1, ended: state.ended } }
		End => { actions: list_cons(EndStream(stream_id), list_nil()), next_state: { chunks: state.chunks, ended: true } }
	end
end

fn stream_id_for_index(index: Int) -> Int
	match index
		0 => 11
		1 => 13
		_ => 17
	end
end

fn handle_selected(selected: Option<{ index : Int, value : StreamInput }>, state: { chunks : Int, ended : Bool }) -> { actions : List<ResponseAction>, next_state : { chunks : Int, ended : Bool } }
	match selected
		Some(route) => handle_stream_input(stream_id_for_index(route.index), route.value, state)
		None => { actions: list_cons(Decline(0), list_nil()), next_state: state }
	end
end

fn route_with_cancellable_channel_first(receivers: List<Receiver<StreamInput>>, state: { chunks : Int, ended : Bool }, deadline: Deadline, token: CancelToken) -> { actions : List<ResponseAction>, next_state : { chunks : Int, ended : Bool } } effects [time, concurrency]
	let handled = handle_selected(channel::select_many_timeout(receivers, 25), state)
	match time::wait_until_cancellable_outcome(deadline, token)
		WaitCompleted => handled
		WaitDeadlineExpired => { actions: list_cons(RetryAfterDeadline(11), handled.actions), next_state: handled.next_state }
		WaitCancelled => { actions: list_cons(CleanupAfterCancel(17), handled.actions), next_state: handled.next_state }
	end
end

pub fn handler_boundary(stream_id: Int, input: StreamInput, state: { chunks : Int, ended : Bool }) -> { actions : List<ResponseAction>, next_state : { chunks : Int, ended : Bool } }
	handle_stream_input(stream_id, input, state)
end

pub fn adapter_missing_time(receivers: List<Receiver<StreamInput>>, state: { chunks : Int, ended : Bool }, deadline: Deadline, token: CancelToken) -> { actions : List<ResponseAction>, next_state : { chunks : Int, ended : Bool } } effects [concurrency]
	route_with_cancellable_channel_first(receivers, state, deadline, token)
end

pub fn adapter_missing_concurrency(receivers: List<Receiver<StreamInput>>, state: { chunks : Int, ended : Bool }, deadline: Deadline, token: CancelToken) -> { actions : List<ResponseAction>, next_state : { chunks : Int, ended : Bool } } effects [time]
	route_with_cancellable_channel_first(receivers, state, deadline, token)
end
