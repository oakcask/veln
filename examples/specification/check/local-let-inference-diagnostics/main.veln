# Omitted local let types still need one concrete same-function type.
fn consume_int(items: Vec<Int>) -> Int
	1
end

fn consume_string(items: Vec<String>) -> Int
	1
end

fn unconstrained() -> Int
	let items = []
	1
end

fn unconstrained_list() -> Int
	let items = Nil
	1
end

fn conflicting() -> Int
	let items = []
	let first: Int = consume_int(items)
	consume_string(items)
end

fn unconstrained_record_pattern() -> Int
	let {items: items} = {items: []}
	1
end

fn conflicting_record_pattern() -> Int
	let {items: items} = {items: []}
	let first: Int = consume_int(items)
	consume_string(items)
end

fn missing_record_pattern_field(input: {count: Int}) -> Int
	let {missing: value} = input
	value
end

fn conflicting_constructor_pattern(input: Option<Vec<Int>>) -> Int
	let Some(items) = input
	consume_string(items)
end

fn wrong_constructor_pattern(input: Option<Int>) -> Int
	let Result::Ok(value) = input
	value
end

fn ambiguous_empty_collection_arguments() -> Int
	let vec_count: Int = vec_len([])
	let list_empty: Bool = list_is_empty(Nil)
	let has_key: Bool = dict_contains({}, "key")
	1
end

fn empty_vec_callback(value: Int)
	[]
end

fn string_vec_callback(value: Int)
	["bad"]
end

fn ambiguous_prelude_callback_result() -> Int
	let mapped = vec_map([1], empty_vec_callback)
	1
end

fn conflicting_prelude_callback_result() -> Vec<Vec<Int>>
	vec_map([1], string_vec_callback)
end

fn conflicting_non_empty_vec() -> Int
	let items = [1, "bad"]
	1
end

fn conflicting_non_empty_dict_key() -> Int
	let table = {"one": 1, 2: 2}
	1
end

fn conflicting_non_empty_dict_value() -> Int
	let table = {"one": 1, "two": "bad"}
	1
end
