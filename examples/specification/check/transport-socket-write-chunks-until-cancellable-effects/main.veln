# Cancellable deadline-aware socket chunk-list writes require both net and time effects.
pub fn write_chunks_until_cancellable_missing_time(stream: NetStream, chunks: List<ByteChunk>, deadline: Deadline, token: CancelToken) -> StreamWriteOutcome effects [net]
	net::write_chunks_until_cancellable(stream, chunks, deadline, token)
end

pub fn write_chunks_until_cancellable_missing_net(stream: NetStream, chunks: List<ByteChunk>, deadline: Deadline, token: CancelToken) -> StreamWriteOutcome effects [time]
	net::write_chunks_until_cancellable(stream, chunks, deadline, token)
end
