type FrameHeader
	FrameHeader {length: Int, kind: Int}
end

schema FrameHeaderWire
	format binary

	wire_length: UInt16be
	wire_kind: UInt8

	map to FrameHeader
		length = wire_length
		kind = wire_kind
end

codec HeaderCodec for FrameHeaderWire decode encode
	decode with decode_header
	encode with encode_header
end

fn decode_header(input: ByteView, base: ByteOffset) -> DecodeStep<{kind: Int, length: Int}>
	NeedMore(NeedEnd)
end

fn encode_header(header: {length: Int, kind: Int}) -> EncodeStep<String>
	Encoded(list_nil())
end
