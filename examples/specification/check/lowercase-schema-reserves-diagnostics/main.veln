schema FlagReserve
	format binary

	flags: flag8 reserves 0
end

schema InvalidReserveValue
	format binary

	missing: uint8 reserves
	named: uint8 reserves expected
	negative: uint8 reserves -1
end

schema MissingFormatReserve
	padding: uint16be reserves 0
end

schema MissingFormatReserveDispatchPayload
	tag: Int
	payload: Dispatch(tag, 1 => uint24be reserves 0)
end

schema RepeatReservePayload
	format binary

	count: uint8
	items: Repeat(count, uint16be reserves 0)
end

schema DispatchReservePayload
	format binary

	tag: uint8
	payload: Dispatch(tag, 1 => uint16be reserves 0)
end

schema DispatchUnsupportedReserveValuePayload
	format binary

	tag: uint8
	payload: Dispatch(tag, 1 => uint2 reserves 4, 2 => uint8 reserves 256)
end
