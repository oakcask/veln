schema UnsupportedOptionDictKeyPacket
	items: Option<Dict<Int, String>>
end

fn direct_key(packet: {items: Option<Dict<Int, String>>}) -> Result<{items: Option<Dict<Int, String>>}, String>
	byte_encode_unsupported_option_dict_key_packet(packet)
end

fn explicit_key(packet: {items: Option<Dict<Int, String>>}) -> Result<{items: Option<Dict<Int, String>>}, String>
	encode UnsupportedOptionDictKeyPacket from packet
end
