schema UnsupportedKeyPacket
	items: Dict<Int, String>
end

schema UnsupportedListValuePacket
	items: Dict<String, List<Int>>
end

fn direct_key(packet: {items: Dict<Int, String>}) -> Result<{items: Dict<Int, String>}, String>
	byte_encode_unsupported_key_packet(packet)
end

fn explicit_key(packet: {items: Dict<Int, String>}) -> Result<{items: Dict<Int, String>}, String>
	encode UnsupportedKeyPacket from packet
end

fn direct_value(packet: {items: Dict<String, List<Int>>}) -> Result<{items: Dict<String, List<Int>>}, String>
	byte_encode_unsupported_list_value_packet(packet)
end

fn explicit_value(packet: {items: Dict<String, List<Int>>}) -> Result<{items: Dict<String, List<Int>>}, String>
	encode UnsupportedListValuePacket from packet
end
