schema RemovedDirectPrimitives
	format binary

	first: flag8
	second: Flag16be
end

schema RemovedRepeatedPrimitives
	format binary

	count: uint8
	lower: [flag24le; count]
	upper: Repeat(count, Flag32be)
end

schema RemovedAnonymousPrimitives
	format binary

	value: {lower: flag40le, nested: {upper: Flag48be}}
end

schema RemovedNestedLower
	format binary

	value: flag56le
end

schema RemovedNestedUpper
	format binary

	value: Flag64be
end

schema RemovedNestedPrimitives
	format binary

	lower: RemovedNestedLower
	upper: RemovedNestedUpper
end

schema RemovedDispatchPrimitives
	format binary

	kind: uint8
	length: uint8
	closed: Dispatch(kind, 1 => flag8)
	extension: ExtensionDispatch(kind, length, 1 => Flag16le)
end

schema RemovedExplicitLower
	format binary

	value: flag24be
end

schema RemovedExplicitUpper
	format binary

	value: Flag32le
end

schema RemovedDerivedLower
	format binary

	value: flag40be
end

schema RemovedDerivedUpper
	format binary

	value: Flag48le
end

fn removed_explicit_lower(view: ByteView, base: ByteOffset) -> DecodeStep<{value: Int}>
	decode RemovedExplicitLower from view at base
end

fn removed_explicit_upper(value: Int) -> Result<ByteChunk, EncodeError>
	encode RemovedExplicitUpper from {value: value}
end

fn removed_derived_lower(view: ByteView) -> Result<{value: Int}, DecodeError>
	byte_decode_removed_derived_lower(view)
end

fn removed_derived_upper(value: Int) -> Result<ByteChunk, EncodeError>
	byte_encode_removed_derived_upper({value: value})
end
