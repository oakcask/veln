schema MissingEndian
	format binary

	length: uint24
end

schema RedundantEndian
	format binary

	kind: uint8be
end

schema UnsupportedWidth
	format binary

	value: uint9
end

schema UnknownEndian
	format binary

	value: uint16ne
end

schema MissingWidth
	format binary

	value: uint
end

schema MissingFormat
	length: uint16be
end

fn ordinary_type(value: uint24be) -> Int
	uint16be
end
