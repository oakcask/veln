use helpers

fn stringify(value) -> String
	"ok"
end

fn emit(value) effects [stdio]
	"sent"
end

fn pure_emit(value)
	"pure"
end

pub fn main() -> { plain : String, effectful : String, pure : String } effects [stdio]
	{ plain: helpers::apply_int(1, stringify), effectful: helpers::apply_effect(emit), pure: helpers::apply_effect(pure_emit) }
end
