# Schema mapping arithmetic accepts integer literal operands for Int targets.
type Packet
	Packet {body_length: Int, padded_length: Int, scaled_length: Int}
end

schema PacketWire
	format binary

	length: UInt8
	padding: UInt8

	map to Packet
		body_length = length - 9
		padded_length = padding + 1
		scaled_length = (length - padding) * 2
end
