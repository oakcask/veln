schema LittleEndianField
	format binary

	short_value: UInt16le
	length_value: UInt24le
	stream_id: UInt31le
	wide_value: UInt32le
	trace_id: UInt40be
	little_trace_id: UInt40le
	extended_value: UInt48be
	little_extended: UInt48le
	seven_byte_value: UInt56be
	little_seven_byte: UInt56le
end

pub schema PublicLittleEndianField
	format binary

	short_value: UInt16le
	length_value: UInt24le
	stream_id: UInt31le
	wide_value: UInt32le
	trace_id: UInt40be
	little_trace_id: UInt40le
	extended_value: UInt48be
	little_extended: UInt48le
	seven_byte_value: UInt56be
	little_seven_byte: UInt56le
end
