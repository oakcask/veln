use source_vec

type State
	Ready
	Closed
end

pub type Table = Dict

fn ready_to_state(value: State::Ready) -> State
	value
end

fn ready_values_to_state(values: ...State::Ready) -> State
	Ready
end

fn fixed_ready_to_state(value: State::Ready) -> State
	value
end

fn variadic_ready_to_state(values: ...State::Ready) -> State
	Ready
end

fn accepts_state_callback(callback: fn(State) -> ()) -> ()
	()
end

fn accepts_wide_record(value: {id: Int, label: String}) -> ()
	()
end

fn stdio_callback() -> () effects [stdio]
	stdio::println("effect")
end

fn accepts_pure_callback(callback: fn() -> ()) -> ()
	()
end

fn reject_covariant_refinement(value: Option<State::Ready>::None) -> Option<State>::Some
	value
end

fn reject_covariant_base(value: Option<State::Ready>) -> Option<State>::Some
	value
end

fn reject_nested_argument(value: Option<State>::None) -> Option<State::Ready>::Some
	value
end

fn main(value: State, record: {state: State}, state_values: Vec<State>, optional: Option<State>, success: Result<State, String>, failure: Result<Int, State>, list: List<State>, key_table: Dict<State, Int>, value_table: Dict<String, State>, alias_key_table: Table<State, Int>, alias_value_table: Table<String, State>, alias_unrelated: Table<String, Int>, unrelated: Option<Int>, unrelated_result_value: Result<String, String>, unrelated_result_error: Result<Int, String>, unrelated_list: List<String>, source_values: source_vec::Vec<State>, source_optional: source_vec::Option<State>, source_result: source_vec::Result<State, String>, source_list: source_vec::List<State>, source_dict: source_vec::Dict<String, State>, source_table: source_vec::Table<String, State::Ready>) -> ()
	let narrowed: State::Ready = value
	let narrowed_record: {state: State::Ready, label: String} = record
	let reversed: fn(State) -> State::Ready = ready_to_state
	let reversed_variadic: fn(...State) -> State::Ready = ready_values_to_state
	let fixed_as_variadic: fn(...State::Ready) -> State = fixed_ready_to_state
	let variadic_as_fixed: fn(State::Ready) -> State = variadic_ready_to_state
	let reversed_callback: fn(fn(State::Ready) -> ()) -> () = accepts_state_callback
	let reversed_record_width: fn({id: Int}) -> () = accepts_wide_record
	let narrowed_effect: fn() -> () = stdio_callback
	let reversed_nested_effect: fn(fn() -> () effects [stdio]) -> () = accepts_pure_callback
	let ready_values = [Ready]
	let widened_values: Vec<State> = ready_values
	let narrowed_values: Vec<State::Ready> = state_values
	let narrowed_optional: Option<State::Ready> = optional
	let narrowed_success: Result<State::Ready, String> = success
	let narrowed_failure: Result<Int, State::Ready> = failure
	let narrowed_list: List<State::Ready> = list
	let narrowed_keys: Dict<State::Ready, Int> = key_table
	let narrowed_table_values: Dict<String, State::Ready> = value_table
	let narrowed_alias_keys: Dict<State::Ready, Int> = alias_key_table
	let narrowed_alias_values: Dict<String, State::Ready> = alias_value_table
	let unrelated_alias_argument: Dict<String, String> = alias_unrelated
	let unrelated_argument: Option<String> = unrelated
	let unrelated_result_value_argument: Result<State, String> = unrelated_result_value
	let unrelated_result_error_argument: Result<Int, State> = unrelated_result_error
	let unrelated_list_argument: List<State> = unrelated_list
	let unrelated_dict_key_argument: Dict<State, Int> = alias_unrelated
	let distinct_constructor: Vec<State> = source_values
	let distinct_option: Option<State> = source_optional
	let distinct_result: Result<State, String> = source_result
	let distinct_list: List<State> = source_list
	let distinct_dict: Dict<String, State> = source_dict
	let invariant_source_alias: source_vec::Table<String, State> = source_table
end
