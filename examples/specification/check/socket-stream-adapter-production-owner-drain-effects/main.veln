use net from "std"

# Production owner-drain adapter requires transport, time, and channel effects.
type ResponseAction
	SendBytes(bytes: ByteChunk)
	EndStream
	CleanupAfterCancel
end

fn handle_stream_input(input: StreamInput, state: { chunks : Int, ended : Bool }) -> { actions : List<ResponseAction>, next_state : { chunks : Int, ended : Bool } }
	match input
		Chunk(bytes) => { actions: list_cons(SendBytes(bytes), list_nil()), next_state: { chunks: state.chunks + 1, ended: state.ended } }
		End => { actions: list_cons(EndStream, list_nil()), next_state: { chunks: state.chunks, ended: true } }
	end
end

fn route_input(route: { tx : Sender<StreamInput>, rx : Receiver<StreamInput> }, input: StreamInput) -> StreamInput effects [concurrency]
	let _ = channel::send(route.tx, input)
	match channel::recv(route.rx)
		Some(value) => value
		None => End
	end
end

fn read_response(route: { tx : Sender<StreamInput>, rx : Receiver<StreamInput> }, outcome: Result<net::ReadOutcome, net::NetError>, state: { chunks : Int, ended : Bool }) -> { actions : List<ResponseAction>, next_state : { chunks : Int, ended : Bool } } effects [concurrency]
	match outcome
		Ok(net::ReadChunk(bytes)) => handle_stream_input(route_input(route, Chunk(bytes)), state)
		Ok(net::ReadEnd) => handle_stream_input(route_input(route, End), state)
		Err(net::NetError(_, _, _, net::TimedOut, _)) => { actions: list_nil(), next_state: state }
		Err(net::NetError(_, _, _, net::Cancelled, _)) => { actions: list_cons(CleanupAfterCancel, list_nil()), next_state: state }
	end
end

fn ordered_send_chunks(actions: List<ResponseAction>) -> List<ByteChunk>
	match actions
		Nil => list_nil()
		Cons(action, tail) => match action
			SendBytes(bytes) => list_cons(bytes, ordered_send_chunks(tail))
			EndStream => ordered_send_chunks(tail)
			CleanupAfterCancel => ordered_send_chunks(tail)
		end
	end
end

fn apply_ordered_send_chunks(stream: net::Stream, actions: List<ResponseAction>) -> () effects [net::IO]
	write_stream_chunks(stream, ordered_send_chunks(actions))
end

fn collect_lifecycle_actions(stream: net::Stream, state: { chunks : Int, ended : Bool }, deadline: Deadline, token: CancelToken) -> { actions : List<ResponseAction>, next_state : { chunks : Int, ended : Bool } } effects [net::IO, time, concurrency]
	let route = channel::bounded<StreamInput>(1)
	read_response(route, net::read_with(stream, Some(deadline), Some(token)), state)
end

fn close_after_collect(stream: net::Stream, routed: { actions : List<ResponseAction>, next_state : { chunks : Int, ended : Bool } }) -> { actions : List<ResponseAction>, next_state : { chunks : Int, ended : Bool } } effects [net::IO]
	apply_ordered_send_chunks(stream, routed.actions)
	close_owned_stream(stream)
	routed
end

fn drain_listener(listener: net::Listener, state: { chunks : Int, ended : Bool }, deadline: Deadline, token: CancelToken) -> { actions : List<ResponseAction>, next_state : { chunks : Int, ended : Bool } } effects [net::IO, time, concurrency]
	match net::accept_with(listener, Some(deadline), Some(token))
		Ok(stream) => close_after_collect(stream, collect_lifecycle_actions(stream, state, deadline, token))
		Err(net::NetError(_, _, _, net::Closed, _)) => { actions: list_cons(EndStream, list_nil()), next_state: { chunks: state.chunks, ended: true } }
		Err(net::NetError(_, _, _, net::TimedOut, _)) => { actions: list_nil(), next_state: state }
		Err(net::NetError(_, _, _, net::Cancelled, _)) => { actions: list_cons(CleanupAfterCancel, list_nil()), next_state: state }
	end
end

fn owner_drain_adapter(listener: net::Listener, owner: CancelOwner, deadline: Deadline) -> { actions : List<ResponseAction>, next_state : { chunks : Int, ended : Bool } } effects [net::IO, time, concurrency]
	let token: CancelToken = time::cancel_token_from(owner)
	let routed = drain_listener(listener, { chunks: 0, ended: false }, deadline, token)
	time::cancel_owned(owner)
	close_owned_listener(listener)
	routed
end

pub fn handler_boundary(input: StreamInput, state: { chunks : Int, ended : Bool }) -> { actions : List<ResponseAction>, next_state : { chunks : Int, ended : Bool } }
	handle_stream_input(input, state)
end

pub fn adapter_missing_time(listener: net::Listener, owner: CancelOwner, deadline: Deadline) -> { actions : List<ResponseAction>, next_state : { chunks : Int, ended : Bool } } effects [net::IO, concurrency]
	owner_drain_adapter(listener, owner, deadline)
end

pub fn adapter_missing_concurrency(listener: net::Listener, owner: CancelOwner, deadline: Deadline) -> { actions : List<ResponseAction>, next_state : { chunks : Int, ended : Bool } } effects [net::IO, time]
	owner_drain_adapter(listener, owner, deadline)
end

pub fn adapter_missing_net(listener: net::Listener, owner: CancelOwner, deadline: Deadline) -> { actions : List<ResponseAction>, next_state : { chunks : Int, ended : Bool } } effects [time, concurrency]
	owner_drain_adapter(listener, owner, deadline)
end

fn write_stream_chunks(stream: net::Stream, chunks: List<ByteChunk>) -> () effects [net::IO]
	match chunks
		Nil => ()
		Cons(bytes, tail) => begin
			let _ = net::write_all(stream, bytes, None, None)
			write_stream_chunks(stream, tail)
		end
	end
end

fn close_owned_stream(stream: net::Stream) -> () effects [net::IO]
	let _ = net::close_stream(stream)
	()
end

fn close_owned_listener(listener: net::Listener) -> () effects [net::IO]
	let _ = net::close_listener(listener)
	()
end
