# Production owner-drain adapter requires transport, time, and channel effects.
type ResponseAction
	SendBytes(bytes: ByteChunk)
	EndStream
	CleanupAfterCancel
end

fn handle_stream_input(input: StreamInput, state: { chunks : Int, ended : Bool }) -> { actions : List<ResponseAction>, next_state : { chunks : Int, ended : Bool } }
	match input
		Chunk(bytes) => { actions: list_cons(SendBytes(bytes), list_nil()), next_state: { chunks: state.chunks + 1, ended: state.ended } }
		End => { actions: list_cons(EndStream, list_nil()), next_state: { chunks: state.chunks, ended: true } }
	end
end

fn route_input(route: { tx : Sender<StreamInput>, rx : Receiver<StreamInput> }, input: StreamInput) -> StreamInput effects [concurrency]
	let _ = channel::send(route.tx, input)
	match channel::recv(route.rx)
		Some(value) => value
		None => End
	end
end

fn read_response(route: { tx : Sender<StreamInput>, rx : Receiver<StreamInput> }, outcome: StreamReadOutcome, state: { chunks : Int, ended : Bool }) -> { actions : List<ResponseAction>, next_state : { chunks : Int, ended : Bool } } effects [concurrency]
	match outcome
		ReadChunk(bytes) => handle_stream_input(route_input(route, Chunk(bytes)), state)
		ReadEnd => handle_stream_input(route_input(route, End), state)
		ReadDeadlineExpired => { actions: list_nil(), next_state: state }
		ReadCancelled => { actions: list_cons(CleanupAfterCancel, list_nil()), next_state: state }
	end
end

fn ordered_send_chunks(actions: List<ResponseAction>) -> List<ByteChunk>
	match actions
		Nil => list_nil()
		Cons(action, tail) => match action
			SendBytes(bytes) => list_cons(bytes, ordered_send_chunks(tail))
			EndStream => ordered_send_chunks(tail)
			CleanupAfterCancel => ordered_send_chunks(tail)
		end
	end
end

fn apply_ordered_send_chunks(stream: NetStream, actions: List<ResponseAction>) -> () effects [net]
	net::write_chunks(stream, ordered_send_chunks(actions))
end

fn collect_lifecycle_actions(stream: NetStream, state: { chunks : Int, ended : Bool }, deadline: Deadline, token: CancelToken) -> { actions : List<ResponseAction>, next_state : { chunks : Int, ended : Bool } } effects [net, time, concurrency]
	let route = channel::bounded<StreamInput>(1)
	read_response(route, net::read_chunk_until_cancellable(stream, deadline, token), state)
end

fn close_after_collect(stream: NetStream, routed: { actions : List<ResponseAction>, next_state : { chunks : Int, ended : Bool } }) -> { actions : List<ResponseAction>, next_state : { chunks : Int, ended : Bool } } effects [net]
	apply_ordered_send_chunks(stream, routed.actions)
	net::close_stream(stream)
	routed
end

fn drain_listener(listener: NetListener, state: { chunks : Int, ended : Bool }, deadline: Deadline, token: CancelToken) -> { actions : List<ResponseAction>, next_state : { chunks : Int, ended : Bool } } effects [net, time, concurrency]
	match net::accept_until_cancellable(listener, deadline, token)
		AcceptStream(stream) => close_after_collect(stream, collect_lifecycle_actions(stream, state, deadline, token))
		AcceptEnd => { actions: list_cons(EndStream, list_nil()), next_state: { chunks: state.chunks, ended: true } }
		AcceptDeadlineExpired => { actions: list_nil(), next_state: state }
		AcceptCancelled => { actions: list_cons(CleanupAfterCancel, list_nil()), next_state: state }
	end
end

fn owner_drain_adapter(listener: NetListener, owner: CancelOwner, deadline: Deadline) -> { actions : List<ResponseAction>, next_state : { chunks : Int, ended : Bool } } effects [net, time, concurrency]
	let token: CancelToken = time::cancel_token_from(owner)
	let routed = drain_listener(listener, { chunks: 0, ended: false }, deadline, token)
	time::cancel_owned(owner)
	net::close_listener(listener)
	routed
end

pub fn handler_boundary(input: StreamInput, state: { chunks : Int, ended : Bool }) -> { actions : List<ResponseAction>, next_state : { chunks : Int, ended : Bool } }
	handle_stream_input(input, state)
end

pub fn adapter_missing_time(listener: NetListener, owner: CancelOwner, deadline: Deadline) -> { actions : List<ResponseAction>, next_state : { chunks : Int, ended : Bool } } effects [net, concurrency]
	owner_drain_adapter(listener, owner, deadline)
end

pub fn adapter_missing_concurrency(listener: NetListener, owner: CancelOwner, deadline: Deadline) -> { actions : List<ResponseAction>, next_state : { chunks : Int, ended : Bool } } effects [net, time]
	owner_drain_adapter(listener, owner, deadline)
end

pub fn adapter_missing_net(listener: NetListener, owner: CancelOwner, deadline: Deadline) -> { actions : List<ResponseAction>, next_state : { chunks : Int, ended : Bool } } effects [time, concurrency]
	owner_drain_adapter(listener, owner, deadline)
end
