use selectors
use alternate_selectors

type Packet
	Packet {kind: Int, value: Int}
end

fn returns_int(kind: Int) -> Int
	kind
end

fn expects_text(label: String) -> Bool
	label == "primary"
end

fn impure_selector(kind: Int) -> Bool effects [stdio]
	kind == 1
end

schema WrongReturnWire
	format binary

	kind: UInt8
	value: UInt8

	map to Packet when returns_int(kind)
		kind = kind
		value = value

	map to Packet when kind == 2
		kind = kind
		value = value
end

schema WrongArgumentWire
	format binary

	kind: UInt8
	value: UInt8

	map to Packet when expects_text(kind)
		kind = kind
		value = value

	map to Packet when kind == 2
		kind = kind
		value = value
end

schema ImpureWire
	format binary

	kind: UInt8
	value: UInt8

	map to Packet when impure_selector(kind)
		kind = kind
		value = value

	map to Packet when kind == 2
		kind = kind
		value = value
end

schema PrivateImportedWire
	format binary

	kind: UInt8
	value: UInt8

	map to Packet when selectors::private_selector(kind)
		kind = kind
		value = value

	map to Packet when kind == 2
		kind = kind
		value = value
end

schema MissingImportedWire
	format binary

	kind: UInt8
	value: UInt8

	map to Packet when missing_selector(kind)
		kind = kind
		value = value

	map to Packet when kind == 2
		kind = kind
		value = value
end

schema AmbiguousImportedWire
	format binary

	kind: UInt8
	value: UInt8

	map to Packet when public_selector(kind)
		kind = kind
		value = value

	map to Packet when kind == 2
		kind = kind
		value = value
end
