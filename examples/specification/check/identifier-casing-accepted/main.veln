type Option
  None
  Some(value: Int)
end

pub type ExportedOption = Option

fn identity(value: Int) -> result: Int
  let local = value
  let {item: nested} = {item: local}
  match nested
    matched => matched
  end
end

fn candidate_check(proposed: Int) -> accepted: Int
  _hole satisfy candidate => candidate == candidate
end

pub fn exported_identity = identity

test identity_test() -> ()
  ()
end

effect Ask
  value(input: Int) -> Int
end

handler ask(context: Int) handles Ask
  value(operation_value) => operation_value
end
