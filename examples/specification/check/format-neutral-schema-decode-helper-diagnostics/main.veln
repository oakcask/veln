type LocalPayload
	LocalPayload(value: Int)
end

schema BadPacket
	code: Int
	names: List<String>
	supported_metadata: {label: Option<String>, retries: Option<Int>}
	numeric_scores: Dict<Int, Int>
	optional_scores: Option<Dict<Int, Int>>
	nested_optional_scores: {scores: Option<Dict<Int, Int>>}
	result_bad_dict_key: Result<Dict<Int, Int>, String>
	result_local: Result<LocalPayload, String>
	result_callback: Result<Int, fn(Int) -> String>
	unsupported_callback_vec: Vec<fn(Int) -> String>
	nested_unsupported_vec: {callbacks: Vec<fn(Int) -> String>}
	local_payload: LocalPayload
	callback: fn(Int) -> String
	metadata: {payload: LocalPayload, callback: fn(Int) -> String}
end
