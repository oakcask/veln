schema BadPacket
	code: Int
	names: List<String>
	supported_metadata: {label: Option<String>, retries: Option<Int>}
	nested_lists: List<List<Int>>
	nested_item_lists: {items: List<List<Int>>}
	nested_optional_items: {items: Option<List<Int>>}
	numeric_scores: Dict<Int, Int>
	nested_scores: Dict<String, Dict<String, Int>>
	optional_scores: Option<Dict<String, Int>>
	nested_optional_scores: {scores: Option<Dict<String, Int>>}
	record_nested_scores: {scores: Dict<String, Dict<String, Int>>}
	vec_items: Vec<Int>
end
