schema BadPacket
	code: Int
	names: List<String>
	nested_lists: List<List<Int>>
	optional_items: Option<List<Int>>
	nested_items: {items: List<Float>}
	numeric_scores: Dict<Int, Int>
	flag_scores: Dict<String, Bool>
	nested_scores: Dict<String, Dict<String, Int>>
	optional_scores: Option<Dict<String, Int>>
	record_scores: {scores: Dict<String, Int>}
	vec_items: Vec<Int>
end
