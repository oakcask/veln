use http2::connection from "std"
use http2::hpack from "std"

fn ascii_header(name: String, value: String) -> Result<HeaderField, String>
	Ok(http2::hpack::header_field(name, byte_chunk_from_visible_ascii_string(value)?))
end

fn request_headers() -> Result<HeaderList, String>
	Ok(http2::hpack::prepend_header_field(ascii_header(":method", "GET")?, http2::hpack::prepend_header_field(ascii_header(":scheme", "https")?, http2::hpack::prepend_header_field(ascii_header(":path", "/")?, http2::hpack::empty_header_list()))))
end

fn one_request() -> List<Http2ClientRequest>
	list_cons(http2::connection::client_bodyless_request(http2::hpack::empty_header_list()), list_nil())
end

fn pure_observer(response: Http2ClientResponse) -> Result<(), String>
	let _ = http2::connection::client_response_stream_id(response)
	Ok(())
end

fn db_observer(response: Http2ClientResponse) -> Result<(), String> effects [db]
	let _ = http2::connection::client_response_stream_id(response)
	Ok(())
end

pub fn pure_client_service_missing_net_and_concurrency() -> Result<(), Http2ClientServiceFailure>
	http2::connection::request_endpoint_sequence("127.0.0.1:0", one_request(), pure_observer)
end

pub fn db_client_service_missing_db() -> Result<(), Http2ClientServiceFailure> effects [net, concurrency]
	http2::connection::request_endpoint_sequence("127.0.0.1:0", one_request(), db_observer)
end

pub fn declared_pure_client_service() -> Result<(), Http2ClientServiceFailure> effects [net, concurrency]
	http2::connection::request_endpoint_sequence("127.0.0.1:0", one_request(), pure_observer)
end

pub fn declared_db_client_service() -> Result<(), Http2ClientServiceFailure> effects [net, concurrency, db]
	http2::connection::request_endpoint_sequence("127.0.0.1:0", one_request(), db_observer)
end
