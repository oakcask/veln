use wire

type Node
	Node {kind: Int, value: Int, child: Option<Node>}
end

schema UnboundedNode
	format binary

	kind: UInt8
	payload: Dispatch(kind, 0 => UInt8, 1 => UnboundedNode)

	map to Node when kind == 0
		kind = kind
		value = payload
		child = None

	map to Node when kind == 1
		kind = kind
		value = payload.value
		child = Some(Node(payload.kind, payload.value, payload.child))
end

schema ImportedRecursiveNoLengthPacket
	format binary

	kind: UInt8
	payload: Dispatch(kind, 0 => UInt8, 1 => wire::RecursiveClosedPayload)
end

schema ImportedRecursiveUnmappedPacket
	format binary

	length: UInt8
	kind: UInt8
	payload: Dispatch(kind, length, 0 => UInt8, 1 => wire::RecursiveClosedPayload)
end
