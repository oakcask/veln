# Every removed bitset field position uses an exact-width unsigned Int primitive.
schema AllWidths
	format binary

	u8: uint8
	u16be: uint16be
	u16le: uint16le
	u24be: uint24be
	u24le: uint24le
	u32be: uint32be
	u32le: uint32le
	u40be: uint40be
	u40le: uint40le
	u48be: uint48be
	u48le: uint48le
	u56be: uint56be
	u56le: uint56le
	u64be: uint64be
	u64le: uint64le
end

schema NestedPayload
	format binary

	value: uint16le
end

schema ReplacementShapes
	format binary

	count: uint8
	kind: uint8
	length: uint8
	direct: uint32be
	repeated: [uint24le; count]
	anonymous: { first: uint40be, second: { inner: uint48le } }
	nested: NestedPayload
	closed: Dispatch(kind, 1 => uint56be)
	extension: ExtensionDispatch(kind, length, 1 => uint64le)
end
