# Clean shutdown keeps handlers pure and adapter effects explicit.
type ResponseAction
	SendBytes(bytes: ByteChunk)
	EndStream
	RetryAfterDeadline
	CleanupAfterCancel
end

fn handle_stream_input(input: StreamInput, state: { chunks : Int, ended : Bool }) -> { actions : List<ResponseAction>, next_state : { chunks : Int, ended : Bool } }
	match input
		Chunk(bytes) => { actions: list_cons(SendBytes(bytes), list_nil()), next_state: { chunks: state.chunks + 1, ended: state.ended } }
		End => { actions: list_cons(EndStream, list_nil()), next_state: { chunks: state.chunks, ended: true } }
	end
end

fn wait_response(outcome: CancellableWaitOutcome, state: { chunks : Int, ended : Bool }) -> { actions : List<ResponseAction>, next_state : { chunks : Int, ended : Bool } }
	match outcome
		WaitCompleted => { actions: list_nil(), next_state: state }
		WaitDeadlineExpired => { actions: list_cons(RetryAfterDeadline, list_nil()), next_state: state }
		WaitCancelled => { actions: list_cons(CleanupAfterCancel, list_nil()), next_state: state }
	end
end

fn route_input(route: { tx : Sender<StreamInput>, rx : Receiver<StreamInput> }, input: StreamInput) -> StreamInput effects [concurrency]
	let _ = channel::send(route.tx, input)
	match channel::recv(route.rx)
		Some(value) => value
		None => End
	end
end

fn read_response(route: { tx : Sender<StreamInput>, rx : Receiver<StreamInput> }, outcome: StreamReadOutcome, state: { chunks : Int, ended : Bool }) -> { actions : List<ResponseAction>, next_state : { chunks : Int, ended : Bool } } effects [concurrency]
	match outcome
		ReadChunk(bytes) => handle_stream_input(route_input(route, Chunk(bytes)), state)
		ReadEnd => handle_stream_input(route_input(route, End), state)
		ReadDeadlineExpired => { actions: list_cons(RetryAfterDeadline, list_nil()), next_state: state }
		ReadCancelled => { actions: list_cons(CleanupAfterCancel, list_nil()), next_state: state }
	end
end

fn collect_shutdown_actions(stream: NetStream, state: { chunks : Int, ended : Bool }, deadline: Deadline, token: CancelToken) -> { actions : List<ResponseAction>, next_state : { chunks : Int, ended : Bool } } effects [net, time, concurrency]
	let route = channel::bounded<StreamInput>(1)
	let handled = read_response(route, net::read_chunk_until_cancellable(stream, deadline, token), state)
	wait_response(time::wait_until_cancellable_outcome(deadline, token), handled.next_state)
end

fn apply_response_actions(stream: NetStream, actions: List<ResponseAction>) -> () effects [net]
	match actions
		Nil => ()
		Cons(action, tail) => match action
			SendBytes(bytes) => write_then_apply(stream, bytes, tail)
			EndStream => apply_response_actions(stream, tail)
			RetryAfterDeadline => apply_response_actions(stream, tail)
			CleanupAfterCancel => apply_response_actions(stream, tail)
		end
	end
end

fn write_then_apply(stream: NetStream, bytes: ByteChunk, tail: List<ResponseAction>) -> () effects [net]
	net::write_chunk(stream, bytes)
	apply_response_actions(stream, tail)
end

fn close_owned_transport(listener: NetListener, stream: NetStream, actions: List<ResponseAction>) -> () effects [net]
	apply_response_actions(stream, actions)
	net::close_stream(stream)
	net::close_listener(listener)
end

fn clean_shutdown_lifecycle(listener: NetListener, stream: NetStream, deadline: Deadline, token: CancelToken) -> { actions : List<ResponseAction>, next_state : { chunks : Int, ended : Bool } } effects [net, time, concurrency]
	let routed = collect_shutdown_actions(stream, { chunks: 0, ended: false }, deadline, token)
	close_owned_transport(listener, stream, routed.actions)
	routed
end

pub fn handler_boundary(input: StreamInput, state: { chunks : Int, ended : Bool }) -> { actions : List<ResponseAction>, next_state : { chunks : Int, ended : Bool } }
	handle_stream_input(input, state)
end

pub fn adapter_missing_time(listener: NetListener, stream: NetStream, deadline: Deadline, token: CancelToken) -> { actions : List<ResponseAction>, next_state : { chunks : Int, ended : Bool } } effects [net, concurrency]
	clean_shutdown_lifecycle(listener, stream, deadline, token)
end

pub fn adapter_missing_concurrency(listener: NetListener, stream: NetStream, deadline: Deadline, token: CancelToken) -> { actions : List<ResponseAction>, next_state : { chunks : Int, ended : Bool } } effects [net, time]
	clean_shutdown_lifecycle(listener, stream, deadline, token)
end

pub fn adapter_missing_net(listener: NetListener, stream: NetStream, deadline: Deadline, token: CancelToken) -> { actions : List<ResponseAction>, next_state : { chunks : Int, ended : Bool } } effects [time, concurrency]
	clean_shutdown_lifecycle(listener, stream, deadline, token)
end
