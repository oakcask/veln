# Direct generated encode helper calls report mapped projection diagnostics.

type MappedPayload
	MappedPayload {code: Int}
end

schema UnsupportedMappedPayload
	format binary

	code: UInt8

	map to MappedPayload
		code = code * 2
end

pub fn main(payload: {code: Int}) -> Result<ByteChunk, EncodeError>
	byte_encode_unsupported_mapped_payload(payload)
end
