use http2::connection from "std"
use http2::core from "std"
use http2::hpack from "std"
use transport from "std"
use transport::net from "std"

fn pure_job() -> Int
	1
end

fn db_job() -> Int effects [db]
	2
end

fn application_callback() -> Int effects [db]
	3
end

fn ascii_header(name: String, value: String) -> Result<HeaderField, String>
	Ok(http2::hpack::header_field(name, byte_chunk_from_visible_ascii_string(value)?))
end

fn response_headers() -> Result<HeaderList, String>
	Ok(http2::hpack::prepend_header_field(ascii_header(":status", "204")?, http2::hpack::empty_header_list()))
end

fn pure_handler(event: Http2ApplicationEvent) -> Result<List<Http2ApplicationAction>, String>
	Ok(list_cons(Http2ApplicationAction::Http2SendResponseHeaders(http2::core::application_event_stream_id(event), response_headers()?, true), list_nil()))
end

fn db_handler(event: Http2ApplicationEvent) -> Result<List<Http2ApplicationAction>, String> effects [db]
	Ok(list_cons(Http2ApplicationAction::Http2SendResponseHeaders(http2::core::application_event_stream_id(event), response_headers()?, true), list_nil()))
end

fn read_request() -> Option<ByteChunk> effects [transport::DuplexStream]
	perform transport::DuplexStream::read_chunk()
end

fn connection_body() -> Int effects [transport::DuplexStream, db]
	let _ = read_request()
	application_callback()
end

fn connection_job(context: {stream: NetStream}) -> Int effects [net, db]
	handle connection_body() with transport::net::net_stream(context.stream)
end

pub fn pure_spawn_missing_concurrency() -> Task<Int>
	task::spawn(pure_job)
end

pub fn db_spawn_missing_db() -> Task<Int> effects [concurrency]
	task::spawn(db_job)
end

pub fn connection_task_missing_net_and_db(stream: NetStream) -> Task<Int> effects [concurrency]
	let context = {stream: stream}
	task::spawn_with<Int, {stream: NetStream}>(connection_job, context)
end

pub fn pure_tcp_service_missing_net_and_concurrency(listener: NetListener) -> Result<(), Http2ServiceFailure>
	http2::connection::serve_tcp(listener, pure_handler)
end

pub fn db_tcp_service_missing_db(listener: NetListener) -> Result<(), Http2ServiceFailure> effects [net, concurrency]
	http2::connection::serve_tcp(listener, db_handler)
end
