type State
	Ready
	Closed
	Failed
end

pub type First = State
pub type Second = State

type Positive<T>
	Present(T)
end

type Pair<T>
	Paired(T, T)
end

fn option(first: Option<First::Ready>, second: Option<Second::Closed>)
	[first, second]
end

fn option_reverse(first: Option<First::Ready>, second: Option<Second::Closed>)
	[second, first]
end

fn option_base(narrow: Option<State::Ready>, wide: Option<State>)
	[wide, narrow]
end

fn result(first: Result<Option<State::Ready>, List<State::Closed>>, second: Result<Option<State::Closed>, List<State::Failed>>)
	[first, second]
end

fn result_reverse(first: Result<Option<State::Ready>, List<State::Closed>>, second: Result<Option<State::Closed>, List<State::Failed>>)
	[second, first]
end

fn list(first: List<State::Ready>, second: List<State::Closed>)
	[first, second]
end

fn vector(first: Vec<State::Ready>, second: Vec<State::Closed>)
	[first, second]
end

fn constructed_vector()
	[[Ready], [Closed]]
end

fn selected_vector(flag: Bool, first: Vec<State::Ready>, second: Vec<State::Closed>)
	if flag
		first
	else
		second
	end
end

fn selected_constructed_vector(flag: Bool)
	if flag
		[Ready]
	else
		[Closed]
	end
end

fn matched_option(flag: Bool, first: Option<State::Ready>, second: Option<State::Closed>)
	match flag
		true => first
		false => second
	end
end

fn paired_option(first: Option<State::Ready>, second: Option<State::Closed>)
	Paired(first, second)
end

fn paired_constructed_vector()
	Paired([Ready], [Closed])
end

fn paired_constructed_vector_reverse()
	Paired([Closed], [Ready])
end

fn constructed_option()
	[Some(Ready), None]
end

fn constructed_option_reverse()
	[None, Some(Ready)]
end

fn nested_constructed_option()
	[Some(None), Some(Some(1))]
end

fn nested_constructed_option_reverse()
	[Some(Some(1)), Some(None)]
end

fn constructed_list(complete: List<Int>)
	[complete, Nil]
end

fn constructed_list_reverse(complete: List<Int>)
	[Nil, complete]
end

fn constructed_empty_vector()
	[[1], []]
end

fn constructed_empty_vector_reverse()
	[[], [1]]
end

fn constructed_empty_dictionary(complete: Dict<Int, String>)
	[complete, {}]
end

fn constructed_empty_dictionary_reverse(complete: Dict<Int, String>)
	[{}, complete]
end

fn selected_constructed_option(flag: Bool)
	if flag
		Some(Ready)
	else
		None
	end
end

fn selected_constructed_option_reverse(flag: Bool)
	if flag
		None
	else
		Some(Ready)
	end
end

fn matched_constructed_option(flag: Bool)
	match flag
		true => Some(Ready)
		false => None
	end
end

fn matched_constructed_option_reverse(flag: Bool)
	match flag
		true => None
		false => Some(Ready)
	end
end

fn dictionary(first: Dict<Option<State::Ready>, Positive<State::Closed>>, second: Dict<Option<State::Closed>, Positive<State::Failed>>)
	[second, first]
end

fn dictionary_forward(first: Dict<Option<State::Ready>, Positive<State::Closed>>, second: Dict<Option<State::Closed>, Positive<State::Failed>>)
	[first, second]
end

fn observe(flag: Bool, first_option: Option<First::Ready>, second_option: Option<Second::Closed>, wide_option: Option<State>, first_result: Result<Option<State::Ready>, List<State::Closed>>, second_result: Result<Option<State::Closed>, List<State::Failed>>, first_list: List<State::Ready>, second_list: List<State::Closed>, first_vector: Vec<State::Ready>, second_vector: Vec<State::Closed>, first_dict: Dict<Option<State::Ready>, Positive<State::Closed>>, second_dict: Dict<Option<State::Closed>, Positive<State::Failed>>) -> ()
	let option_result: Vec<Option<State::Ready | State::Closed>> = option(first_option, second_option)
	let option_reverse_result: Vec<Option<State::Ready | State::Closed>> = option_reverse(first_option, second_option)
	let option_base_result: Vec<Option<State>> = option_base(first_option, wide_option)
	let result_result: Vec<Result<Option<State::Ready | State::Closed>, List<State::Closed | State::Failed>>> = result(first_result, second_result)
	let result_reverse_result: Vec<Result<Option<State::Ready | State::Closed>, List<State::Closed | State::Failed>>> = result_reverse(first_result, second_result)
	let list_result: Vec<List<State::Ready | State::Closed>> = list(first_list, second_list)
	let vector_result: Vec<Vec<State::Ready | State::Closed>> = vector(first_vector, second_vector)
	let constructed_vector_result: Vec<Vec<State::Ready | State::Closed>> = constructed_vector()
	let selected_vector_result: Vec<State::Ready | State::Closed> = selected_vector(flag, first_vector, second_vector)
	let selected_constructed_vector_result: Vec<State::Ready | State::Closed> = selected_constructed_vector(flag)
	let matched_option_result: Option<State::Ready | State::Closed> = matched_option(flag, first_option, second_option)
	let paired_option_result: Pair<Option<State::Ready | State::Closed>>::Paired = paired_option(first_option, second_option)
	let paired_constructed_vector_result: Pair<Vec<State::Ready | State::Closed>>::Paired = paired_constructed_vector()
	let paired_constructed_vector_reverse_result: Pair<Vec<State::Ready | State::Closed>>::Paired = paired_constructed_vector_reverse()
	let constructed_option_result: Vec<Option<State::Ready>> = constructed_option()
	let constructed_option_reverse_result: Vec<Option<State::Ready>> = constructed_option_reverse()
	let nested_constructed_option_result: Vec<Option<Option<Int>>> = nested_constructed_option()
	let nested_constructed_option_reverse_result: Vec<Option<Option<Int>>> = nested_constructed_option_reverse()
	let constructed_list_result: Vec<List<Int>> = constructed_list(Cons(1, Nil))
	let constructed_list_reverse_result: Vec<List<Int>> = constructed_list_reverse(Cons(1, Nil))
	let constructed_empty_vector_result: Vec<Vec<Int>> = constructed_empty_vector()
	let constructed_empty_vector_reverse_result: Vec<Vec<Int>> = constructed_empty_vector_reverse()
	let constructed_empty_dictionary_result: Vec<Dict<Int, String>> = constructed_empty_dictionary({1: "one"})
	let constructed_empty_dictionary_reverse_result: Vec<Dict<Int, String>> = constructed_empty_dictionary_reverse({1: "one"})
	let selected_constructed_option_result: Option<State::Ready> = selected_constructed_option(flag)
	let selected_constructed_option_reverse_result: Option<State::Ready> = selected_constructed_option_reverse(flag)
	let matched_constructed_option_result: Option<State::Ready> = matched_constructed_option(flag)
	let matched_constructed_option_reverse_result: Option<State::Ready> = matched_constructed_option_reverse(flag)
	let dictionary_result: Vec<Dict<Option<State::Ready | State::Closed>, Positive<State::Closed | State::Failed>>> = dictionary(first_dict, second_dict)
	let dictionary_forward_result: Vec<Dict<Option<State::Ready | State::Closed>, Positive<State::Closed | State::Failed>>> = dictionary_forward(first_dict, second_dict)
	()
end
