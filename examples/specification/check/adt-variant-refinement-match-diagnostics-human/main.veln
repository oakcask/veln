# Compiler integration contract: human diagnostics classify impossible and
# redundant arms against direct refined bare or parenthesized binding domains,
# preserve coverage notes and select complete written scrutinees for context.
type State
	Ready
	Closed
	Failed
end

fn complete(value: State::Ready | State::Closed) -> ()
	match value
		Failed => ()
		Ready => ()
		Ready => ()
		Closed => ()
		_ => ()
		remaining => ()
		Ready => ()
	end
end

fn caught(value: State::Ready | State::Closed) -> ()
	match value
		_ => ()
		Ready => ()
		remaining => ()
	end
end

fn parenthesized(value: State::Ready | State::Closed) -> ()
	match (((value)))
		Failed => ()
		Ready => ()
		Closed => ()
	end
end

fn main() -> ()
	()
end
