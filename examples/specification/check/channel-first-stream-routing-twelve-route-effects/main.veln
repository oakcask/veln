# Twelve-route receiver-list routing keeps handlers pure and adapter effects explicit.
type ResponseAction
	SendBytes {stream_id: Int, bytes: ByteChunk}
	EndStream {stream_id: Int}
	Decline {stream_id: Int}
end

fn handle_stream_input(stream_id: Int, input: StreamInput, state: { chunks : Int, ended : Bool }) -> { actions : List<ResponseAction>, next_state : { chunks : Int, ended : Bool } }
	match input
		Chunk(bytes) => { actions: list_cons(SendBytes(stream_id, bytes), list_nil()), next_state: { chunks: state.chunks + 1, ended: state.ended } }
		End => { actions: list_cons(EndStream(stream_id), list_nil()), next_state: { chunks: state.chunks, ended: true } }
	end
end

fn handle_selected(index: Int, input: StreamInput, state: { chunks : Int, ended : Bool }) -> { actions : List<ResponseAction>, next_state : { chunks : Int, ended : Bool } }
	match index
		0 => handle_stream_input(1, input, state)
		1 => handle_stream_input(3, input, state)
		2 => handle_stream_input(5, input, state)
		3 => handle_stream_input(7, input, state)
		4 => handle_stream_input(9, input, state)
		5 => handle_stream_input(11, input, state)
		6 => handle_stream_input(13, input, state)
		7 => handle_stream_input(15, input, state)
		8 => handle_stream_input(17, input, state)
		9 => handle_stream_input(19, input, state)
		10 => handle_stream_input(21, input, state)
		_ => handle_stream_input(23, input, state)
	end
end

fn route_selected_stream_input(first_input: StreamInput, second_input: StreamInput, third_input: StreamInput, fourth_input: StreamInput, fifth_input: StreamInput, sixth_input: StreamInput, seventh_input: StreamInput, eighth_input: StreamInput, ninth_input: StreamInput, tenth_input: StreamInput, eleventh_input: StreamInput, twelfth_input: StreamInput, state: { chunks : Int, ended : Bool }) -> { actions : List<ResponseAction>, next_state : { chunks : Int, ended : Bool } } effects [concurrency]
	let first = channel::bounded<StreamInput>(1)
	let second = channel::bounded<StreamInput>(1)
	let third = channel::bounded<StreamInput>(1)
	let fourth = channel::bounded<StreamInput>(1)
	let fifth = channel::bounded<StreamInput>(1)
	let sixth = channel::bounded<StreamInput>(1)
	let seventh = channel::bounded<StreamInput>(1)
	let eighth = channel::bounded<StreamInput>(1)
	let ninth = channel::bounded<StreamInput>(1)
	let tenth = channel::bounded<StreamInput>(1)
	let eleventh = channel::bounded<StreamInput>(1)
	let twelfth = channel::bounded<StreamInput>(1)
	let _ = channel::send(first.tx, first_input)
	let _ = channel::send(second.tx, second_input)
	let _ = channel::send(third.tx, third_input)
	let _ = channel::send(fourth.tx, fourth_input)
	let _ = channel::send(fifth.tx, fifth_input)
	let _ = channel::send(sixth.tx, sixth_input)
	let _ = channel::send(seventh.tx, seventh_input)
	let _ = channel::send(eighth.tx, eighth_input)
	let _ = channel::send(ninth.tx, ninth_input)
	let _ = channel::send(tenth.tx, tenth_input)
	let _ = channel::send(eleventh.tx, eleventh_input)
	let _ = channel::send(twelfth.tx, twelfth_input)
	channel::close(first.tx)
	channel::close(second.tx)
	channel::close(third.tx)
	channel::close(fourth.tx)
	channel::close(fifth.tx)
	channel::close(sixth.tx)
	channel::close(seventh.tx)
	channel::close(eighth.tx)
	channel::close(ninth.tx)
	channel::close(tenth.tx)
	channel::close(eleventh.tx)
	channel::close(twelfth.tx)
	let receivers: List<Receiver<StreamInput>> = list_cons(first.rx, list_cons(second.rx, list_cons(third.rx, list_cons(fourth.rx, list_cons(fifth.rx, list_cons(sixth.rx, list_cons(seventh.rx, list_cons(eighth.rx, list_cons(ninth.rx, list_cons(tenth.rx, list_cons(eleventh.rx, list_cons(twelfth.rx, list_nil()))))))))))))
	let selected: { index : Int, value : StreamInput } = match channel::select_many_priority(receivers)
		Some(value) => value
		None => { index: 0, value: End }
	end
	handle_selected(selected.index, selected.value, state)
end

pub fn handler_boundary(stream_id: Int, input: StreamInput, state: { chunks : Int, ended : Bool }) -> { actions : List<ResponseAction>, next_state : { chunks : Int, ended : Bool } }
	handle_stream_input(stream_id, input, state)
end

pub fn adapter_missing_concurrency(first: StreamInput, second: StreamInput, third: StreamInput, fourth: StreamInput, fifth: StreamInput, sixth: StreamInput, seventh: StreamInput, eighth: StreamInput, ninth: StreamInput, tenth: StreamInput, eleventh: StreamInput, twelfth: StreamInput, state: { chunks : Int, ended : Bool }) -> { actions : List<ResponseAction>, next_state : { chunks : Int, ended : Bool } }
	route_selected_stream_input(first, second, third, fourth, fifth, sixth, seventh, eighth, ninth, tenth, eleventh, twelfth, state)
end
