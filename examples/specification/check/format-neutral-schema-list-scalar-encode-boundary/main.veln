schema UnsupportedNestedListPacket
	items: List<List<Int>>
end

fn direct(packet: {items: List<List<Int>>}) -> Result<{items: List<List<Int>>}, String>
	byte_encode_unsupported_nested_list_packet(packet)
end

fn explicit(packet: {items: List<List<Int>>}) -> Result<{items: List<List<Int>>}, String>
	encode UnsupportedNestedListPacket from packet
end
