schema Http2FrameHeader
  format binary

  length: UInt24be
  stream_reserved: ReservedBits(1, 0)
  stream_id: UInt31be
end

codec HeaderDecode for Http2FrameHeader decode
  derive decode
end

pub codec HeaderRoundTrip for Http2FrameHeader decode encode
  decode with decode_header
  derive encode
end

codec HeaderEncode for Http2FrameHeader encode
  encode with encode_header
end

fn decode_header(input: ByteView, base: ByteOffset) -> DecodeStep<Int>
  NeedMore(NeedEnd)
end

fn encode_header(chunks: List<ByteChunk>) -> EncodeStep<String>
  Encoded(chunks)
end
