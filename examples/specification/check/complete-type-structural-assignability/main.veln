type State
	Ready
	Closed
end

pub type Table = Dict

fn state_to_ready(value: State) -> State::Ready
	Ready
end

fn states_to_ready(values: ...State) -> State::Ready
	Ready
end

fn numbered_states_to_ready(first: Int, values: ...State) -> State::Ready
	Ready
end

fn accepts_ready_callback(callback: fn(State::Ready) -> ()) -> ()
	()
end

fn accepts_state_producer(callback: fn() -> State) -> ()
	()
end

fn accepts_identity_record(value: {id: Int}) -> ()
	()
end

fn pure_callback() -> ()
	()
end

fn accepts_stdio_callback(callback: fn() -> () effects [stdio]) -> ()
	()
end

fn state_vectors_to_ready(values: Vec<State>) -> Vec<State::Ready>
	[Ready]
end

fn main(value: State::Ready, record: {state: State::Ready, label: String}, vector_record: {items: Vec<State::Ready>, label: String}, optional: Option<State::Ready>, success: Result<State::Ready, String>, failure: Result<Int, State::Ready>, list: List<State::Ready>, key_table: Dict<State::Ready, Int>, value_table: Dict<String, State::Ready>, alias_key_table: Table<State::Ready, Int>, alias_value_table: Table<String, State::Ready>) -> ()
	let direct: State = value
	let widened_record: {state: State} = record
	let fixed: fn(State::Ready) -> State = state_to_ready
	let variadic: fn(...State::Ready) -> State = states_to_ready
	let fixed_variadic: fn(Int, ...State::Ready) -> State = numbered_states_to_ready
	let two_reversals: fn(fn(State) -> ()) -> () = accepts_ready_callback
	let nested_callback: fn(fn() -> State::Ready) -> () = accepts_state_producer
	let record_width_callback: fn({id: Int, label: String}) -> () = accepts_identity_record
	let wider_effect: fn() -> () effects [stdio] = pure_callback
	let nested_effect: fn(fn() -> ()) -> () = accepts_stdio_callback
	let ready_values = [value]
	let widened_values: Vec<State> = ready_values
	let widened_optional: Option<State> = optional
	let widened_success: Result<State, String> = success
	let widened_failure: Result<Int, State> = failure
	let widened_list: List<State> = list
	let widened_keys: Dict<State, Int> = key_table
	let widened_table_values: Dict<String, State> = value_table
	let widened_alias_keys: Dict<State, Int> = alias_key_table
	let widened_alias_values: Dict<String, State> = alias_value_table
	let widened_vector_record: {items: Vec<State>} = vector_record
	let vector_polarity: fn(Vec<State::Ready>) -> Vec<State> = state_vectors_to_ready
end
