# Nested dispatch payload helper eligibility reports helper boundaries.

schema ForwardByteViewPayload
	format binary

	payload: ByteView(later_length)
	later_length: UInt8
end

schema MissingByteViewPayload
	format binary

	payload: ByteView(missing_length)
end

schema NonIntByteViewPayload
	format binary

	flags: Flag8
	payload: ByteView(flags)
end

schema ClosedPacket
	format binary

	kind: UInt8
	payload: Dispatch(kind, 1 => ForwardByteViewPayload)
end

schema ExtensionPacket
	format binary

	length: UInt8
	kind: UInt8
	payload: ExtensionDispatch(kind, length, 1 => ForwardByteViewPayload)
end

schema MissingPacket
	format binary

	kind: UInt8
	payload: Dispatch(kind, 1 => MissingByteViewPayload)
end

schema NonIntPacket
	format binary

	kind: UInt8
	payload: Dispatch(kind, 1 => NonIntByteViewPayload)
end

codec ClosedPacketDecode for ClosedPacket decode
	derive decode
end

codec ClosedPacketEncode for ClosedPacket encode
	derive encode
end

codec ExtensionPacketDecode for ExtensionPacket decode
	derive decode
end

codec ExtensionPacketEncode for ExtensionPacket encode
	derive encode
end
