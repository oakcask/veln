fn network_callback() -> () effects [net]
	()
end

fn accepts_stdio(callback: fn() -> () effects [stdio]) -> ()
	()
end

fn constrained<effect E>(produce: fn() -> () effects [...E], consume: fn(fn() -> () effects [...E]) -> ()) -> () effects [...E]
	()
end

fn db_callback() -> () effects [db]
	()
end

fn invoke<effect E>(callback: fn() -> () effects [...E], count: Int) -> () effects [...E]
	callback()
end

fn make_int() -> Int
	1
end

fn rejected_helper() -> ()
	invoke(db_callback, "wrong")
end

fn accepted_call_expression_helper() -> ()
	invoke(db_callback, make_int())
end

fn invoke_optional<effect E>(callback: Option<fn() -> () effects [...E]>, count: Int) -> () effects [...E]
	()
end

fn rejected_nested_helper() -> ()
	invoke_optional(Some(db_callback), {count: 1})
end

fn accepts_pure(callback: fn() -> ()) -> ()
	()
end

fn produce<effect E>(callback: fn() -> () effects [...E], count: Int) -> fn() -> () effects [...E] effects [...E]
	callback
end

fn concrete_boundary<effect E>(callback: fn() -> () effects [...E]) -> () effects [fs, ...E]
	()
end

fn rigid_rejection<effect R>(callback: fn() -> () effects [...R]) -> () effects [...R]
	constrained(callback, accepts_pure)
end

pub fn rejected_call_is_transactional() -> ()
	constrained(network_callback, accepts_stdio)
end

pub fn rejected_payload_is_transactional() -> ()
	rejected_helper()
end


pub fn rejected_nested_payload_is_transactional() -> ()
	rejected_nested_helper()
end

pub fn rejected_result_is_transactional() -> ()
	let recovered = produce(db_callback, "wrong")
	accepts_pure(recovered)
end

pub fn accepted_call_expression_keeps_row_effect() -> ()
	accepted_call_expression_helper()
end

pub fn concrete_effect_is_observable() -> () effects [db]
	concrete_boundary(db_callback)
end
