schema UnsupportedNestedVecPacket
	metadata: {items: Vec<Vec<Int>>}
end

fn direct_nested_vec(packet: {metadata: {items: Vec<Vec<Int>>}}) -> Result<{metadata: {items: Vec<Vec<Int>>}}, String>
	byte_encode_unsupported_nested_vec_packet(packet)
end

fn explicit_nested_vec(packet: {metadata: {items: Vec<Vec<Int>>}}) -> Result<{metadata: {items: Vec<Vec<Int>>}}, String>
	encode UnsupportedNestedVecPacket from packet
end
