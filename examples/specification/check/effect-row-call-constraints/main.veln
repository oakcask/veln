fn stdio_callback() -> () effects [stdio]
	()
end

fn accepts_stdio_or_db(callback: fn() -> () effects [stdio, db]) -> ()
	()
end

fn lower_then_upper<effect E>(produce: fn() -> () effects [...E], consume: fn(fn() -> () effects [...E]) -> ()) -> () effects [fs, ...E]
	()
end

fn upper_then_lower<effect E>(consume: fn(fn() -> () effects [...E]) -> (), produce: fn() -> () effects [...E]) -> () effects [fs, ...E]
	()
end

fn unconstrained<effect E>() -> () effects [...E]
	()
end

pub fn first_order() -> () effects [fs, stdio]
	lower_then_upper(stdio_callback, accepts_stdio_or_db)
end

pub fn reverse_order() -> () effects [fs, stdio]
	upper_then_lower(accepts_stdio_or_db, stdio_callback)
end

pub fn empty_row() -> ()
	unconstrained()
end
