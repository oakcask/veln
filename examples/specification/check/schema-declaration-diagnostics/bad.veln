schema BadHeader
  length: UInt24be
  format binary
  format binary
  _reserved: UInt8
  broken: UInt8 where
  map to EmptyHeader
  map Header
    length = length
    length = kind
    = stream_id
    stream_reserved
end

schema
  format binary
  length: UInt24be
end

schema MissingEnd
  format binary
  length: UInt24be
