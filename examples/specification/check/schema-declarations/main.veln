type FrameHeader
  FrameHeader {priority: Int, length: Int, kind: Int, stream_id: Int, checksum: Int, payload: ByteView}
end

schema Http2FrameHeader
  format binary

  priority: UInt16be
  length: UInt24be
  kind: UInt8
  padding_length: UInt8 where padding_length <= length
  stream_reserved: ReservedBits(1, 0)
  stream_id: UInt31be
  little_stream_id: UInt31le
  checksum: UInt32be
  payload: ByteView(length - padding_length)

  map to FrameHeader
    priority = priority
    length = length
    kind = kind
    stream_id = stream_id
    checksum = checksum
    payload = payload
end

pub schema PublicFrameHeader
  format binary

  priority: UInt16be
  length: UInt24be
  kind: UInt8
  padding_length: UInt8 where padding_length <= length
  stream_reserved: ReservedBits(1, 0)
  stream_id: UInt31be
  little_stream_id: UInt31le
  checksum: UInt32be
  payload: ByteView(length - padding_length)

  map to FrameHeader
    priority = priority
    length = length
    kind = kind
    stream_id = stream_id
    checksum = checksum
    payload = payload
end
