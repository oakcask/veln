# Holes inherit concrete expected types from expression contexts.
type Box<A>
	Box(value: A)
end

type State
	Ready
	Closed
end

fn accept(value: Int) -> Int
	value
end

fn return_context(candidate: Int) -> Int
	_
end

fn call_context(candidate: Int) -> Int
	accept(_)
end

fn local_annotation_context(candidate: Int) -> Int
	let value: Int = _
	value
end

fn record_context(candidate: Int) -> {value: Int}
	{value: _}
end

fn if_context(flag: Bool, candidate: Int) -> Int
	if flag
		_
	else
		candidate
	end
end

fn match_context(flag: Bool, candidate: Int) -> Int
	match flag
		true => _
		false => candidate
	end
end

fn constructor_context(candidate: Int) -> Box<Int>
	Box(_)
end

fn inferred_if_context(flag: Bool, candidate: State) -> ()
	let value = if flag
		Ready
	else
		_
	end
end

fn inferred_match_context(flag: Bool, candidate: State) -> ()
	let value = match flag
		true => Ready
		false => _
	end
end
