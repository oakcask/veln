type Packet
	Packet {kind: Int, value: Int}
end

schema PacketWire
	format binary

	kind: UInt8
	control_value: UInt8
	data_value: UInt8

	map to Packet when kind == 1
		kind = kind
		value = control_value

	map to Packet when kind == 2
		kind = kind
		value = data_value
end

codec RawPacketCodec for PacketWire decode
	decode with decode_raw_packet
end

codec WrongPacketCodec for PacketWire decode
	decode with decode_wrong_packet
end

fn decode_raw_packet(input: ByteView, base: ByteOffset) -> DecodeStep<{kind: Int, control_value: Int, data_value: Int}>
	NeedMore(NeedEnd)
end

fn decode_wrong_packet(input: ByteView, base: ByteOffset) -> DecodeStep<{kind: Int, code: Int}>
	NeedMore(NeedEnd)
end
