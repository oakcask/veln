# Result bindings are visible only to postconditions on the same function.
pub fn require_cannot_read_result(value: Int) -> output: Int
	require output >= 0
	value
end

pub fn invariant_cannot_read_result(value: Int) -> output: Int
	invariant output >= 0
	value
end

pub fn invalid_require_cannot_read_result(value: Int) -> Output: Int
	require Output >= 0
	value
end

pub fn invalid_invariant_cannot_read_result(value: Int) -> Output: Int
	invariant Output >= 0
	value
end

pub fn invalid_ensure_can_read_result(value: Int) -> Output: Int
	ensure Output >= 0
	value
end

pub fn body_cannot_read_result(value: Int) -> output: Int
	output
end

pub fn invalid_body_cannot_read_result(value: Int) -> Output: Int
	Output
end

pub fn bare_result_is_not_special(value: Int) -> Int
	ensure result >= 0
	value
end

pub fn body_cannot_call_result(value: Int) -> Callback: fn(Int) -> Int
	Callback(1)
end

pub fn invalid_ensure_can_read_function_result(value: Int) -> Callback: fn(Int) -> Int
	ensure Callback == Callback
	identity
end

fn identity(value: Int) -> Int
	value
end
