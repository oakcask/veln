// Result bindings are visible only to postconditions on the same function.
pub fn require_cannot_read_result(value: Int) -> output: Int effects []
require output >= 0
  value
end

pub fn invariant_cannot_read_result(value: Int) -> output: Int effects []
invariant output >= 0
  value
end

pub fn body_cannot_read_result(value: Int) -> output: Int effects []
  output
end

pub fn bare_result_is_not_special(value: Int) -> Int effects []
ensure result >= 0
  value
end
