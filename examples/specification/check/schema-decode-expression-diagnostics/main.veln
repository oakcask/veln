use facade
use wire

fn missing(view: ByteView, base: ByteOffset) -> DecodeStep<{length: Int}>
	decode MissingPacket from view at base
end

fn private_schema(view: ByteView, base: ByteOffset) -> DecodeStep<{length: Int}>
	decode wire::PrivatePacket from view at base
end

fn wrong_function(view: ByteView, base: ByteOffset) -> DecodeStep<{length: Int}>
	decode wire::make_packet from view at base
end

fn wrong_type(view: ByteView, base: ByteOffset) -> DecodeStep<{length: Int}>
	decode wire::PacketShape from view at base
end

fn wrong_codec(view: ByteView, base: ByteOffset) -> DecodeStep<{length: Int}>
	decode wire::PacketCodec from view at base
end

fn missing_alias_target(view: ByteView, base: ByteOffset) -> DecodeStep<{length: Int}>
	decode facade::MissingAlias from view at base
end

fn private_alias_target(view: ByteView, base: ByteOffset) -> DecodeStep<{length: Int}>
	decode facade::PrivateAlias from view at base
end

fn function_alias_target(view: ByteView, base: ByteOffset) -> DecodeStep<{length: Int}>
	decode facade::FunctionAlias from view at base
end

fn type_alias_target(view: ByteView, base: ByteOffset) -> DecodeStep<{length: Int}>
	decode facade::TypeAlias from view at base
end

fn codec_alias_target(view: ByteView, base: ByteOffset) -> DecodeStep<{length: Int}>
	decode facade::CodecAlias from view at base
end
