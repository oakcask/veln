type State
	Ready
	Closed
	Failed
end

pub type First = State
pub type Second = State

type Single
	Only
end

pub type SingleFirst = Single
pub type SingleSecond = Single

type Pair
	Left
	Right
end

pub type PairFirst = Pair
pub type PairSecond = Pair

fn needs_first(value: First::Ready) -> ()
	()
end

fn needs_failed(value: State::Failed) -> ()
	()
end

fn same_alias(flag: Bool)
	let ready: First::Ready = Ready
	let closed: First::Closed = Closed
	if flag
		ready
	else
		closed
	end
end

fn conflicting_aliases(flag: Bool)
	let ready: First::Ready = Ready
	let closed: Second::Closed = Closed
	if flag
		ready
	else
		closed
	end
end

fn conflicting_single_forward(flag: Bool)
	let first: SingleFirst::Only = Only
	let second: SingleSecond::Only = Only
	if flag
		first
	else
		second
	end
end

fn conflicting_single_reverse(flag: Bool)
	let first: SingleFirst::Only = Only
	let second: SingleSecond::Only = Only
	if flag
		second
	else
		first
	end
end

fn conflicting_pair_forward(flag: Bool)
	let first: PairFirst::Left | PairFirst::Right = Pair::Left
	let second: PairSecond::Left | PairSecond::Right = Pair::Right
	if flag
		first
	else
		second
	end
end

fn conflicting_pair_reverse(flag: Bool)
	let first: PairFirst::Left | PairFirst::Right = Pair::Left
	let second: PairSecond::Left | PairSecond::Right = Pair::Right
	if flag
		second
	else
		first
	end
end

fn needs_int(value: Int) -> ()
	()
end

fn main() -> ()
	let explicit: Second::Closed = Closed
	needs_first(explicit)
	needs_first(Closed)
	needs_failed(same_alias(true))
	needs_failed(conflicting_aliases(false))
	needs_int(conflicting_single_forward(true))
	needs_int(conflicting_single_reverse(false))
	needs_int(conflicting_pair_forward(true))
	needs_int(conflicting_pair_reverse(false))
end

type Envelope<A>
	Left(A)
	Right(A)
end

fn needs_envelope_left(value: Envelope<First::Ready>::Left) -> ()
	()
end

fn reject_alias_nested_refinement() -> ()
	let actual: Envelope<Second::Ready>::Right = Envelope::Right(Ready)
	needs_envelope_left(actual)
end

fn reject_alias_nested_base(actual: Envelope<Second::Ready>) -> ()
	needs_envelope_left(actual)
end

fn reject_different_nested_variant() -> ()
	let actual: Envelope<Second::Closed>::Right = Envelope::Right(Closed)
	needs_envelope_left(actual)
end
