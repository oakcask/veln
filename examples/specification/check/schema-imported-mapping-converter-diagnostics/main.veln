use helpers

type Header
	Header {missing: Int, private: Int, bare: Int, bad_arity: Int, bad_input: Int, bad_return: Int, impure: Int}
end

schema HeaderWire
	format binary

	kind: UInt8

	map to Header
		missing = missing_helpers::convert(kind)
		private = helpers::private_convert(kind)
		bare = public_convert(kind)
		bad_arity = helpers::two_params(kind)
		bad_input = helpers::needs_text(kind)
		bad_return = helpers::to_text(kind)
		impure = helpers::noisy(kind)
end
