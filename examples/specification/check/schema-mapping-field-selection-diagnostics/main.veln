type Settings
	Settings {code: Int, value: Int}
end

type Packet
	Packet {missing: Int, non_record: Int}
end

schema SettingsPayload
	format binary

	wire_code: UInt8
	wire_value: UInt16be

	map to Settings
		code = wire_code
		value = wire_value
end

schema PacketWire
	format binary

	kind: UInt8
	payload: Dispatch(kind, 1 => SettingsPayload)

	map to Packet
		missing = payload.missing
		non_record = kind.code
end
