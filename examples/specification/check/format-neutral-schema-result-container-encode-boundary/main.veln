schema UnsupportedFunctionPayloadPacket
	items: List<Result<Int, fn(Int) -> String>>
end

fn direct_function_payload(packet: {items: List<Result<Int, fn(Int) -> String>>}) -> Result<{items: List<Result<Int, fn(Int) -> String>>}, String>
	byte_encode_unsupported_function_payload_packet(packet)
end

fn explicit_function_payload(packet: {items: List<Result<Int, fn(Int) -> String>>}) -> Result<{items: List<Result<Int, fn(Int) -> String>>}, String>
	encode UnsupportedFunctionPayloadPacket from packet
end

schema UnsupportedKeyPacket
	items: Dict<Int, Result<Int, String>>
end

fn direct_key(packet: {items: Dict<Int, Result<Int, String>>}) -> Result<{items: Dict<Int, Result<Int, String>>}, String>
	byte_encode_unsupported_key_packet(packet)
end

fn explicit_key(packet: {items: Dict<Int, Result<Int, String>>}) -> Result<{items: Dict<Int, Result<Int, String>>}, String>
	encode UnsupportedKeyPacket from packet
end
