type Header
	Header {missing: Int, too_few: Int, too_many: Int, bad_input: Int, bad_return: Int, impure: Int, bad_structural_input: Int, unsupported: Int}
end

fn two_params(value: Int, extra: Int) -> Int
	value
end

fn five_params(value: Int, extra: Int, another: Int, final: Int, overflow: Int) -> Int
	value
end

fn needs_text(value: String) -> Int
	0
end

fn to_text(value: Int) -> String
	int_to_string(value)
end

fn noisy(value: Int) -> Int effects [stdio]
	value
end

fn from_text(value: String) -> Int
	0
end

fn convert(value: Int) -> Int
	value
end

schema HeaderWire
	format binary

	kind: UInt8
	length: UInt8

	map to Header
		missing = missing_converter(kind)
		too_few = two_params(kind)
		too_many = five_params(kind, length, kind, length, kind)
		bad_input = needs_text(kind)
		bad_return = to_text(kind)
		impure = noisy(kind)
		bad_structural_input = from_text({value: kind})
		unsupported = convert(kind == 1)
end
