# Adapter accept-loop helper must declare socket and channel effects.
fn handle_input(input: StreamInput) -> List<StreamAdapterAction>
	match input
		Chunk(bytes) => list_cons(SendBytes(bytes), list_nil())
		End => list_cons(EndStream, list_nil())
	end
end

pub fn handler_boundary(input: StreamInput) -> List<StreamAdapterAction>
	handle_input(input)
end

pub fn adapter_missing_concurrency(listener: NetListener) -> () effects [net]
	stream_adapter_accept_loop(listener, handle_input)
end

pub fn adapter_missing_net(listener: NetListener) -> () effects [concurrency]
	stream_adapter_accept_loop(listener, handle_input)
end
