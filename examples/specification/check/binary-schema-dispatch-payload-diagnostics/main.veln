# Binary schema dispatch payload diagnostics keep nested schema scope narrow.
use wire

type Shape
	Shape(Int)
end

type MappedPayload
	MappedPayload {code: Int}
end

schema MissingPacket
	format binary

	kind: UInt8
	payload: Dispatch(kind, 1 => MissingPayload)
end

schema NonSchemaPacket
	format binary

	kind: UInt8
	payload: Dispatch(kind, 1 => Shape)
end

schema ImportedPrivatePacket
	format binary

	kind: UInt8
	payload: Dispatch(kind, 1 => wire::PrivatePayload)
end

schema ImportedMissingPacket
	format binary

	kind: UInt8
	payload: Dispatch(kind, 1 => wire::MissingPayload)
end

schema ImportedWrongKindPacket
	format binary

	kind: UInt8
	payload: Dispatch(kind, 1 => wire::WireShape)
end

schema UnsupportedReservedPayload
	format binary

	control_reserved: ReservedBits(9, 0)
end

schema UnsupportedReservedPacket
	format binary

	kind: UInt8
	payload: Dispatch(kind, 1 => UnsupportedReservedPayload)
end

schema UnsupportedReservedSuffixPayload
	format binary

	control: UInt8
	control_padding: ReservedBits(9, 0)
end

schema UnsupportedByteViewPayload
	format binary

	payload: ByteView(later_length)
	later_length: UInt8
end

schema UnsupportedMappedPayload
	format binary

	code: UInt8

	map to MappedPayload
		code = code * 2
end

schema ExtensionUnsupportedReservedPacket
	format binary

	length: UInt8
	kind: UInt8
	payload: ExtensionDispatch(kind, length, 1 => UnsupportedReservedSuffixPayload)
end

schema UnsupportedByteViewPacket
	format binary

	kind: UInt8
	payload: Dispatch(kind, 1 => UnsupportedByteViewPayload)
end

schema UnsupportedMappedPacket
	format binary

	kind: UInt8
	payload: Dispatch(kind, 1 => UnsupportedMappedPayload)
end

schema ImportedPublicPacket
	format binary

	kind: UInt8
	payload: Dispatch(kind, 1 => wire::PublicPayload)
end

schema SelfPacket
	format binary

	kind: UInt8
	payload: Dispatch(kind, 1 => SelfPacket)
end

schema ForwardPacket
	format binary

	kind: UInt8
	payload: Dispatch(kind, 1 => LaterPayload)
end

schema ExtensionSelfPacket
	format binary

	length: UInt8
	kind: UInt8
	payload: ExtensionDispatch(kind, length, 1 => ExtensionSelfPacket)
end

schema PriorPayload
	format binary

	code: UInt8
	value: UInt8
end

schema MixedPacket
	format binary

	kind: UInt8
	payload: Dispatch(kind, 1 => UInt8, 2 => PriorPayload)
end

schema LaterPayload
	format binary

	code: UInt8
end
