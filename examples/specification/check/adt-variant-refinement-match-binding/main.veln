# Compiler integration contract: checking a constructor arm exposes the matched
# bare or redundantly parenthesized parameter, local, transparent alias chain,
# or complete-value pattern binding at its singleton or complete multi-variant
# residual refinement without losing generic arguments. Nested matches restore
# the enclosing arm refinement. Computed expressions do not alias their inputs.
type State
	Ready
	Closed
end

type Connection
	Disconnected
	Connected(socket: Int)
	Closed(reason: String)
end

type Boxed<A>
	Filled(A)
	Empty
	Failed
	Skipped
end

type LiteralPayload
	Number(Int)
end

fn accept_ready(value: State::Ready) -> ()
	()
end

fn accept_filled(value: Boxed<Int>::Filled) -> ()
	()
end

fn accept_empty(value: Boxed<Int>::Empty) -> ()
	()
end

fn accept_failed(value: Boxed<Int>::Failed) -> ()
	()
end

fn accept_empty_or_failed(value: Boxed<Int>::Empty | Boxed<Int>::Failed) -> ()
	()
end

fn accept_number(value: LiteralPayload::Number) -> ()
	()
end

fn reset_closed(state: Connection::Closed) -> Connection::Disconnected
	Disconnected
end

fn recover(state: Connection::Connected | Connection::Closed) -> Connection::Disconnected
	match state
		Connected(_) => Disconnected
		remaining => reset_closed(remaining)
	end
end

fn pair(first: (), second: ()) -> ()
	()
end

fn parameter(value: Boxed<Int>) -> ()
	match value
		Filled(_) => accept_filled(value)
		Empty => ()
		Failed => ()
		Skipped => ()
	end
end

fn local(value: Boxed<Int>) -> ()
	let current: Boxed<Int> = value
	match (current)
		Filled(_) => accept_filled(current)
		Empty => ()
		Failed => ()
		Skipped => ()
	end
end

fn inferred_alias_chain(value: Boxed<Int>) -> ()
	let current = value
	let transitive = ((current))
	match transitive
		Filled(_) => begin
			accept_filled(value)
			accept_filled(current)
			accept_filled(transitive)
		end
		Empty => ()
		Failed => ()
		Skipped => ()
	end
end

fn residual_alias_chain(value: Boxed<Int>::Filled | Boxed<Int>::Empty | Boxed<Int>::Failed) -> ()
	let current: Boxed<Int>::Filled | Boxed<Int>::Empty | Boxed<Int>::Failed = value
	let transitive: Boxed<Int>::Filled | Boxed<Int>::Empty | Boxed<Int>::Failed = current
	match transitive
		Filled(_) => begin
			accept_filled(value)
			accept_filled(current)
			accept_filled(transitive)
		end
		remaining => begin
			accept_empty_or_failed(value)
			accept_empty_or_failed(current)
			accept_empty_or_failed(transitive)
			accept_empty_or_failed(remaining)
			match remaining
				Empty => begin
					accept_empty(value)
					accept_empty(current)
					accept_empty(transitive)
					accept_empty(remaining)
				end
				Failed => begin
					accept_failed(value)
					accept_failed(current)
					accept_failed(transitive)
					accept_failed(remaining)
				end
			end
			accept_empty_or_failed(value)
			accept_empty_or_failed(remaining)
		end
	end
end

fn residual_alias_wildcard(value: Boxed<Int>::Filled | Boxed<Int>::Empty | Boxed<Int>::Failed) -> ()
	let current = value
	let transitive = current
	match transitive
		Filled(_) => accept_filled(value)
		_ => begin
			accept_empty_or_failed(value)
			accept_empty_or_failed(current)
			accept_empty_or_failed(transitive)
		end
	end
end

fn parenthesized_residual(value: Boxed<Int>::Filled | Boxed<Int>::Empty | Boxed<Int>::Failed) -> ()
	match (((value)))
		Filled(_) => accept_filled(value)
		remaining => begin
			match ((remaining))
				Empty => accept_empty(remaining)
				Failed => accept_failed(remaining)
			end
			match (value)
				Empty => accept_empty(value)
				Failed => accept_failed(value)
			end
		end
	end
	match (value)
		Filled(_) => accept_filled(value)
		Empty => accept_empty(value)
		Failed => accept_failed(value)
	end
end

fn parenthesized_wildcard(value: Boxed<Int>::Filled | Boxed<Int>::Empty) -> ()
	match ((value))
		Filled(_) => accept_filled(value)
		_ => accept_empty(value)
	end
end

fn make_filled() -> Boxed<Int>::Filled
	Filled(1)
end

fn computed_scrutinee_boundary() -> ()
	match make_filled()
		Filled(_) => ()
		Empty => ()
		Failed => ()
		Skipped => ()
	end
end

fn residual(value: Boxed<Int>::Filled | Boxed<Int>::Empty | Boxed<Int>::Failed) -> ()
	match value
		Filled(_) => accept_filled(value)
		remaining => begin
			match remaining
				Empty => accept_empty(remaining)
				Failed => accept_failed(remaining)
			end
			match value
				Empty => accept_empty(value)
				Failed => accept_failed(value)
			end
		end
	end
end

fn residual_wildcard(value: Boxed<Int>::Filled | Boxed<Int>::Empty | Boxed<Int>::Failed) -> ()
	match value
		Filled(_) => accept_filled(value)
		_ => match value
			Empty => accept_empty(value)
			Failed => accept_failed(value)
		end
	end
end

fn nested(state: State) -> ()
	match state
		Ready => pair(match state
			Ready => accept_ready(state)
		end, accept_ready(state))
		Closed => ()
	end
end

fn literal_payload(value: LiteralPayload) -> ()
	match value
		Number(1) => accept_number(value)
		_ => ()
	end
end

fn main() -> ()
	()
end
