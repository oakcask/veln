# Compiler integration contract: checking a constructor arm exposes the matched
# bare parameter or local at its singleton or complete multi-variant residual
# refinement without losing generic arguments, and nested matches restore the
# enclosing arm refinement.
type State
	Ready
	Closed
end

type Connection
	Disconnected
	Connected(socket: Int)
	Closed(reason: String)
end

type Boxed<A>
	Filled(A)
	Empty
	Failed
	Skipped
end

type LiteralPayload
	Number(Int)
end

fn accept_ready(value: State::Ready) -> ()
	()
end

fn accept_filled(value: Boxed<Int>::Filled) -> ()
	()
end

fn accept_empty(value: Boxed<Int>::Empty) -> ()
	()
end

fn accept_failed(value: Boxed<Int>::Failed) -> ()
	()
end

fn accept_number(value: LiteralPayload::Number) -> ()
	()
end

fn reset_closed(state: Connection::Closed) -> Connection::Disconnected
	Disconnected
end

fn recover(state: Connection::Connected | Connection::Closed) -> Connection::Disconnected
	match state
		Connected(_) => Disconnected
		remaining => reset_closed(remaining)
	end
end

fn pair(first: (), second: ()) -> ()
	()
end

fn parameter(value: Boxed<Int>) -> ()
	match value
		Filled(_) => accept_filled(value)
		Empty => ()
		Failed => ()
		Skipped => ()
	end
end

fn local(value: Boxed<Int>) -> ()
	let current: Boxed<Int> = value
	match current
		Filled(_) => accept_filled(current)
		Empty => ()
		Failed => ()
		Skipped => ()
	end
end

fn residual(value: Boxed<Int>::Filled | Boxed<Int>::Empty | Boxed<Int>::Failed) -> ()
	match value
		Filled(_) => accept_filled(value)
		remaining => begin
			match remaining
				Empty => accept_empty(remaining)
				Failed => accept_failed(remaining)
			end
			match value
				Empty => accept_empty(value)
				Failed => accept_failed(value)
			end
		end
	end
end

fn residual_wildcard(value: Boxed<Int>::Filled | Boxed<Int>::Empty | Boxed<Int>::Failed) -> ()
	match value
		Filled(_) => accept_filled(value)
		_ => match value
			Empty => accept_empty(value)
			Failed => accept_failed(value)
		end
	end
end

fn nested(state: State) -> ()
	match state
		Ready => pair(match state
			Ready => accept_ready(state)
		end, accept_ready(state))
		Closed => ()
	end
end

fn literal_payload(value: LiteralPayload) -> ()
	match value
		Number(1) => accept_number(value)
		_ => ()
	end
end

fn main() -> ()
	()
end
