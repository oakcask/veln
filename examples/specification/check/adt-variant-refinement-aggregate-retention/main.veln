type State
	Ready
	Closed
	Failed
end

type Pair<A>
	Paired(A, A)
end

type Container<A>
	Built(A, Vec<A>)
end

type First<A>
	Some(A)
	Empty
end

fn ready() -> State::Ready
	Ready
end

fn closed() -> State::Closed
	Closed
end

fn forward()
	[Ready, Closed]
end

fn reverse()
	[Closed, Ready]
end

fn complete()
	[Failed, Ready, Closed]
end

fn with_base(value: State)
	[Ready, value]
end

fn optional()
	[Option::Some(1), None]
end

fn table()
	{ready(): Closed, closed(): Ready}
end

fn table_reverse()
	{closed(): Ready, ready(): Closed}
end

fn paired()
	Paired(Closed, Ready)
end

fn paired_reverse()
	Paired(Ready, Closed)
end

fn retained_pair()
	Paired(Ready, Ready)
end

fn mixed_occurrence()
	Built(Ready, [Ready])
end

fn mixed_payload() -> Vec<State::Ready>
	match mixed_occurrence()
		Built(_, items) => items
	end
end

fn ambiguous_private_result()
	Paired(First::Some(1), Empty)
end

fn payload() -> State::Ready
	match retained_pair()
		Paired(item, _) => item
	end
end

fn keep_ready(value: State::Ready) -> Bool
	true
end

# Compiler integration contract: retained collection element refinements must
# reach a standard-library callback boundary. The result annotation detects
# either erasure or widening of the projected element type.
fn projected() -> Vec<State::Ready>
	vec_filter([Ready], keep_ready)
end

fn main() -> ()
	let first: Vec<State::Ready | State::Closed> = forward()
	let second: Vec<State::Ready | State::Closed> = reverse()
	let all: Vec<State> = complete()
	let base_join: Vec<State> = with_base(Closed)
	let optional_values: Vec<Option<Int>> = optional()
	let entries: Dict<State::Ready | State::Closed, State::Ready | State::Closed> = table()
	let reverse_entries: Dict<State::Ready | State::Closed, State::Ready | State::Closed> = table_reverse()
	let pair: Pair<State::Ready | State::Closed>::Paired = paired()
	let reverse_pair: Pair<State::Ready | State::Closed>::Paired = paired_reverse()
	let contextual_vec: Vec<State> = [Ready, Closed]
	let contextual_dict: Dict<String, State> = {"ready": Ready}
	let contextual_pair: Pair<State> = Paired(Ready, Closed)
	let item: State::Ready = payload()
	let items: Vec<State::Ready> = projected()
	let nested_items: Vec<State::Ready> = mixed_payload()
	let inferred_private: Pair<First<Int>>::Paired = ambiguous_private_result()
end
