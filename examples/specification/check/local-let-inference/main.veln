# Omitted local let types may be fixed by later same-function uses.
fn consume(items: Vec<Int>) -> Int
	1
end

fn consume_nodes(items: List<Int>) -> Int
	1
end

fn consume_table(items: Dict<String, Int>) -> Int
	1
end

type Box<A>
	Box(value: A)
end

fn call_constrained() -> Int
	let items = []
	consume(items)
end

fn list_call_constrained() -> Int
	let items = Nil
	consume_nodes(items)
end

fn dict_call_constrained() -> Int
	let items = {}
	consume_table(items)
end

fn non_empty_collection_initializers() -> {vec: Vec<Int>, dict: Dict<String, Int>}
	let items = [1, 2, 3]
	let table = {"one": 1, "two": 2}
	{vec: items, dict: table}
end

fn record_pattern_bindings(input: {count: Int, label: String}) -> {count: Int, label: String}
	let {count: count, label: label} = input
	{count: count, label: label}
end

fn nested_record_pattern_bindings() -> {count: Int, label: String}
	let {outer: {count: count, label: label}, ignored: _} = {outer: {count: 1, label: "ok"}, ignored: false}
	let _: Int = count + 1
	{count: count, label: label}
end

fn annotated_record_pattern_bindings(input: {outer: {count: Int, label: String}, ignored: Bool}) -> String
	let {outer: {count: count, label: label}, ignored: _}: {outer: {count: Int, label: String}, ignored: Bool} = input
	let _: Int = count + 1
	label
end

fn constructor_pattern_bindings(input: Option<Int>) -> Int
	let Some(count) = input
	count + 1
end

fn nested_constructor_pattern_bindings(input: Result<Option<Int>, String>) -> Int
	let Ok(Some(count)) = input
	count + 1
end

fn annotated_constructor_pattern_bindings(input: Result<Option<Int>, String>) -> Int
	let Ok(Some(count)): Result<Option<Int>, String> = input
	count + 1
end

fn return_constrained() -> Vec<Int>
	let items = []
	items
end

fn annotated_empty_collections() -> {vec: Vec<Int>, list: List<Int>, dict: Dict<String, Int>}
	let vec: Vec<Int> = []
	let list: List<Int> = Nil
	let dict: Dict<String, Int> = {}
	{vec: vec, list: list, dict: dict}
end

fn return_empty_list() -> List<Int>
	Nil
end

fn return_empty_dict() -> Dict<String, Int>
	{}
end

fn call_argument_empty_collections() -> Int
	let left: Int = consume([])
	let middle: Int = consume_nodes(Nil)
	left + middle + consume_table({})
end

fn record_field_empty_collections() -> {vec: Vec<Int>, list: List<Int>, dict: Dict<String, Int>}
	{vec: [], list: Nil, dict: {}}
end

fn match_arm_empty_vec(flag: Bool) -> Vec<Int>
	match flag
		true => []
		false => [1]
	end
end

fn match_arm_empty_list(flag: Bool) -> List<Int>
	match flag
		true => Nil
		false => Cons(1, Nil)
	end
end

fn match_arm_empty_dict(flag: Bool) -> Dict<String, Int>
	match flag
		true => {}
		false => {"one": 1}
	end
end

fn constructor_payload_empty_collections() -> {vec: Box<Vec<Int>>, list: Box<List<Int>>, dict: Box<Dict<String, Int>>}
	{vec: Box([]), list: Box(Nil), dict: Box({})}
end

fn empty_vec_callback(value: Int)
	[]
end

fn empty_list_callback(value: Int)
	Nil
end

fn prelude_helper_callback_result_context() -> {vec: Vec<Vec<Int>>, list: List<List<Int>>, option: Option<Vec<Int>>, result: Result<List<Int>, String>}
	let ints: List<Int> = Cons(1, Nil)
	{
		vec: vec_map([1], empty_vec_callback),
		list: list_map(ints, empty_list_callback),
		option: option_map(Some(1), empty_vec_callback),
		result: result_map(Ok(1), empty_list_callback)
	}
end
