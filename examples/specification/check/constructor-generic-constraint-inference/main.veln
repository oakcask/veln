type State
	Ready
	Closed
	Failed
end

pub type First = State
pub type Second = State

type Positive<T>
	PositiveValue({left: T, right: T})
end

type Negative<T>
	NegativeValue(fn(T) -> (), fn(T) -> ())
end

type Invariant<T>
	InvariantValue(fn(T) -> T)
end

type Exact<T>
	ExactValue(Invariant<T>)
end

type Phantom<T>
	Empty
end

type Irrelevant<T>
	IrrelevantValue(Phantom<T>)
end

type Mixed<T>
	MixedValue(T, fn(T) -> (), Invariant<T>)
end

type Pair<T>
	Paired(T, T)
end

type Upper<T>
	UpperValue(fn(T) -> (), fn(T) -> ())
end

type FunctionBox<T>
	FunctionBoxed(T)
end

type Transition<T>
	Resolved({upper: fn(T) -> (), first: FunctionBox<T>, second: FunctionBox<T>, third: FunctionBox<T>})
end

fn accepts_state(value: State) -> ()
	()
end

fn accepts_ready(value: State::Ready) -> ()
	()
end

fn ready_identity(value: State::Ready) -> State::Ready
	value
end

fn accepts_phantom_int(value: Phantom<Int>) -> ()
	()
end

fn accepts_phantom_string(value: Phantom<String>) -> ()
	()
end

fn transition_f(value: {a: Int}) -> State::Ready
	Ready
end

fn transition_g(value: {b: Int}) -> State::Closed
	Closed
end

fn transition_h(value: {a: Int, b: Int}) -> State::Ready
	Ready
end

fn accepts_transition_complete(value: fn({a: Int, b: Int}) -> State) -> ()
	()
end

fn positive_forward()
	PositiveValue({left: First::Ready, right: Second::Closed})
end

fn positive_reverse()
	PositiveValue({left: Second::Closed, right: First::Ready})
end

fn negative_private(first: fn(State) -> (), second: fn(State::Ready) -> ())
	NegativeValue(first, second)
end

fn exact_private(callback: fn(State::Ready) -> State::Ready)
	ExactValue(InvariantValue(callback))
end

fn mixed_private(callback: fn(State::Ready) -> State::Ready)
	MixedValue(Ready, accepts_state, InvariantValue(callback))
end

fn contextual(value: Phantom<State::Ready>) -> Irrelevant<State::Closed>
	IrrelevantValue(value)
end

fn contextual_join(first: Phantom<Int>, second: Phantom<String>)
	Paired(first, second)
end

fn contextual_meet()
	UpperValue(accepts_phantom_int, accepts_phantom_string)
end

fn private_transition(payload: {upper: fn(fn({a: Int, b: Int}) -> State) -> (), first: FunctionBox<fn({a: Int}) -> State::Ready>, second: FunctionBox<fn({b: Int}) -> State::Closed>, third: FunctionBox<fn({a: Int, b: Int}) -> State::Ready>})
	Resolved(payload)
end

fn needs_positive(value: Positive<State::Ready | State::Closed>) -> ()
	()
end

fn needs_negative(value: Negative<State::Ready>) -> ()
	()
end

fn needs_exact(value: Exact<State::Ready>) -> ()
	()
end

fn needs_mixed(value: Mixed<State::Ready>) -> ()
	()
end

fn needs_pair(value: Pair<Phantom<State::Ready>>) -> ()
	()
end

fn needs_upper(value: Upper<Phantom<State::Ready>>) -> ()
	()
end

fn needs_transition(value: Transition<fn({a: Int, b: Int}) -> State::Ready | State::Closed>) -> ()
	()
end

fn ordinary_context_free(value: Phantom<State::Ready>) -> ()
	let positive = PositiveValue({left: Ready, right: Closed})
	let PositiveValue(payload) = positive
	match payload.left
		Ready => ()
		Closed => ()
	end
	let positive_reverse = PositiveValue({left: Closed, right: Ready})
	let PositiveValue(reverse_payload) = positive_reverse
	match reverse_payload.left
		Ready => ()
		Closed => ()
	end
	let negative = NegativeValue(accepts_state, accepts_ready)
	let NegativeValue(first, second) = negative
	let first_ready: fn(State::Ready) -> () = first
	let second_ready: fn(State::Ready) -> () = second
	first_ready(Ready)
	second_ready(Ready)
	let exact = ExactValue(InvariantValue(ready_identity))
	needs_exact(exact)
	let ExactValue(exact_value) = exact
	let InvariantValue(exact_callback) = exact_value
	exact_callback(Ready)
	let mixed = MixedValue(Ready, accepts_state, InvariantValue(ready_identity))
	needs_mixed(mixed)
	let MixedValue(mixed_value, _, _) = mixed
	match mixed_value
		Ready => ()
	end
	let contextual_irrelevant: Irrelevant<State::Closed> = IrrelevantValue(value)
end

fn ordinary_transition(payload: {upper: fn(fn({a: Int, b: Int}) -> State) -> (), first: FunctionBox<fn({a: Int}) -> State::Ready>, second: FunctionBox<fn({b: Int}) -> State::Closed>, third: FunctionBox<fn({a: Int, b: Int}) -> State::Ready>}) -> ()
	let inferred = Resolved(payload)
	needs_transition(inferred)
end

pub fn main() -> ()
	let value: Phantom<State::Ready> = Empty
	needs_positive(positive_forward())
	needs_positive(positive_reverse())
	needs_positive(PositiveValue({left: Ready, right: Closed}))
	needs_negative(negative_private(accepts_state, accepts_ready))
	needs_negative(NegativeValue(accepts_state, accepts_ready))
	needs_exact(exact_private(ready_identity))
	needs_mixed(mixed_private(ready_identity))
	let explicit: Irrelevant<State::Closed> = contextual(value)
	let phantom_int: Phantom<Int> = Empty
	let phantom_string: Phantom<String> = Empty
	let ordinary_join: Pair<Phantom<State::Ready>> = Paired(phantom_int, phantom_string)
	let ordinary_meet: Upper<Phantom<State::Ready>> = UpperValue(accepts_phantom_int, accepts_phantom_string)
	needs_pair(ordinary_join)
	needs_upper(ordinary_meet)
	needs_pair(contextual_join(phantom_int, phantom_string))
	needs_upper(contextual_meet())
	ordinary_context_free(value)
	let transition_payload: {upper: fn(fn({a: Int, b: Int}) -> State) -> (), first: FunctionBox<fn({a: Int}) -> State::Ready>, second: FunctionBox<fn({b: Int}) -> State::Closed>, third: FunctionBox<fn({a: Int, b: Int}) -> State::Ready>} = {upper: accepts_transition_complete, first: FunctionBoxed(transition_f), second: FunctionBoxed(transition_g), third: FunctionBoxed(transition_h)}
	needs_transition(private_transition(transition_payload))
	ordinary_transition(transition_payload)
end
