# Sixteen-argument socket-to-handler task routing must declare effects.
type StreamEvent
	Request {stream_id: Int, payload: ByteChunk}
	PeerClosed {stream_id: Int}
end

type ResponseAction
	SendBytes {stream_id: Int, bytes: ByteChunk}
	EndStream {stream_id: Int}
	Decline {stream_id: Int}
end

fn handle_stream_event(event: StreamEvent, state: { request_count : Int, marker : ByteChunk }) -> { actions : List<ResponseAction>, next_state : { request_count : Int, marker : ByteChunk } }
	match event
		Request(stream_id, payload) => { actions: list_cons(SendBytes(stream_id, state.marker), list_cons(SendBytes(stream_id, payload), list_cons(EndStream(stream_id), list_nil()))), next_state: { request_count: state.request_count + 1, marker: payload } }
		PeerClosed(stream_id) => { actions: list_cons(Decline(stream_id), list_nil()), next_state: state }
	end
end

fn handle_stream_event_with_context(event: StreamEvent, state: { request_count : Int, marker : ByteChunk }, context: { adapter_id : Int, deadline : Deadline, adapter_marker : ByteChunk }, routing: { stream_offset : Int, route_marker : ByteChunk }, metadata: { metadata_offset : Int, metadata_marker : ByteChunk }, audit: { audit_offset : Int, audit_marker : ByteChunk }, trace: { trace_offset : Int, trace_marker : ByteChunk }, shard: { shard_offset : Int, shard_marker : ByteChunk }, region: { region_offset : Int, region_marker : ByteChunk }, zone: { zone_offset : Int, zone_marker : ByteChunk }, site: { site_offset : Int, site_marker : ByteChunk }, rack: { rack_offset : Int, rack_marker : ByteChunk }, aisle: { aisle_offset : Int, aisle_marker : ByteChunk }, shelf: { shelf_offset : Int, shelf_marker : ByteChunk }, bin: { bin_offset : Int, bin_marker : ByteChunk }, slot: { slot_offset : Int, slot_marker : ByteChunk }) -> { actions : List<ResponseAction>, next_state : { request_count : Int, marker : ByteChunk } }
	match event
		Request(stream_id, payload) => { actions: list_cons(SendBytes(stream_id, slot.slot_marker), list_cons(SendBytes(stream_id, payload), list_cons(EndStream(stream_id), list_nil()))), next_state: { request_count: state.request_count + context.adapter_id + routing.stream_offset + metadata.metadata_offset + audit.audit_offset + trace.trace_offset + shard.shard_offset + region.region_offset + zone.zone_offset + site.site_offset + rack.rack_offset + aisle.aisle_offset + shelf.shelf_offset + bin.bin_offset + slot.slot_offset, marker: payload } }
		PeerClosed(stream_id) => { actions: list_cons(Decline(stream_id), list_nil()), next_state: state }
	end
end

fn spawned_stream_handler(event: StreamEvent, state: { request_count : Int, marker : ByteChunk }, context: { adapter_id : Int, deadline : Deadline, adapter_marker : ByteChunk }, routing: { stream_offset : Int, route_marker : ByteChunk }, metadata: { metadata_offset : Int, metadata_marker : ByteChunk }, audit: { audit_offset : Int, audit_marker : ByteChunk }, trace: { trace_offset : Int, trace_marker : ByteChunk }, shard: { shard_offset : Int, shard_marker : ByteChunk }, region: { region_offset : Int, region_marker : ByteChunk }, zone: { zone_offset : Int, zone_marker : ByteChunk }, site: { site_offset : Int, site_marker : ByteChunk }, rack: { rack_offset : Int, rack_marker : ByteChunk }, aisle: { aisle_offset : Int, aisle_marker : ByteChunk }, shelf: { shelf_offset : Int, shelf_marker : ByteChunk }, bin: { bin_offset : Int, bin_marker : ByteChunk }, slot: { slot_offset : Int, slot_marker : ByteChunk }) -> { actions : List<ResponseAction>, next_state : { request_count : Int, marker : ByteChunk } } effects [concurrency]
	handle_stream_event_with_context(event, state, context, routing, metadata, audit, trace, shard, region, zone, site, rack, aisle, shelf, bin, slot)
end

fn route_socket_events(stream: NetStream, stream_id: Int, state: { request_count : Int, marker : ByteChunk }) -> { actions : List<ResponseAction>, next_state : { request_count : Int, marker : ByteChunk } } effects [net, concurrency]
	let first_incoming: ByteChunk = net::read_chunk(stream)
	let second_incoming: ByteChunk = net::read_chunk(stream)
	let route = channel::bounded<StreamEvent>(1)
	let _ = channel::send(route.tx, Request(stream_id, first_incoming))
	let first_event: StreamEvent = match channel::recv(route.rx)
		Some(value) => value
		None => PeerClosed(stream_id)
	end
	let first_result = handle_stream_event(first_event, state)
	let _ = channel::send(route.tx, Request(stream_id, second_incoming))
	let second_event: StreamEvent = match channel::recv(route.rx)
		Some(value) => value
		None => PeerClosed(stream_id)
	end
	handle_stream_event(second_event, first_result.next_state)
end

pub fn handler_boundary(event: StreamEvent, state: { request_count : Int, marker : ByteChunk }) -> { actions : List<ResponseAction>, next_state : { request_count : Int, marker : ByteChunk } }
	handle_stream_event(event, state)
end

pub fn task_handler_boundary(event: StreamEvent, state: { request_count : Int, marker : ByteChunk }, context: { adapter_id : Int, deadline : Deadline, adapter_marker : ByteChunk }, routing: { stream_offset : Int, route_marker : ByteChunk }, metadata: { metadata_offset : Int, metadata_marker : ByteChunk }, audit: { audit_offset : Int, audit_marker : ByteChunk }, trace: { trace_offset : Int, trace_marker : ByteChunk }, shard: { shard_offset : Int, shard_marker : ByteChunk }, region: { region_offset : Int, region_marker : ByteChunk }, zone: { zone_offset : Int, zone_marker : ByteChunk }, site: { site_offset : Int, site_marker : ByteChunk }, rack: { rack_offset : Int, rack_marker : ByteChunk }, aisle: { aisle_offset : Int, aisle_marker : ByteChunk }, shelf: { shelf_offset : Int, shelf_marker : ByteChunk }, bin: { bin_offset : Int, bin_marker : ByteChunk }, slot: { slot_offset : Int, slot_marker : ByteChunk }) -> { actions : List<ResponseAction>, next_state : { request_count : Int, marker : ByteChunk } } effects [concurrency]
	let worker = task::spawn_with16<{ actions : List<ResponseAction>, next_state : { request_count : Int, marker : ByteChunk } }>(spawned_stream_handler, event, state, context, routing, metadata, audit, trace, shard, region, zone, site, rack, aisle, shelf, bin, slot)
	match task::join(worker)
		Ok(value) => value
		Err(_) => { actions: list_nil(), next_state: state }
	end
end

pub fn adapter_missing_concurrency(stream: NetStream, state: { request_count : Int, marker : ByteChunk }, deadline: Deadline) -> { actions : List<ResponseAction>, next_state : { request_count : Int, marker : ByteChunk } } effects [net]
	let marker: ByteChunk = byte_chunk([])
	let context = { adapter_id: 1, deadline: deadline, adapter_marker: marker }
	let routing = { stream_offset: 1, route_marker: marker }
	let metadata = { metadata_offset: 1, metadata_marker: marker }
	let audit = { audit_offset: 1, audit_marker: marker }
	let trace = { trace_offset: 1, trace_marker: marker }
	let shard = { shard_offset: 1, shard_marker: marker }
	let region = { region_offset: 1, region_marker: marker }
	let zone = { zone_offset: 1, zone_marker: marker }
	let site = { site_offset: 1, site_marker: marker }
	let rack = { rack_offset: 1, rack_marker: marker }
	let aisle = { aisle_offset: 1, aisle_marker: marker }
	let shelf = { shelf_offset: 1, shelf_marker: marker }
	let bin = { bin_offset: 1, bin_marker: marker }
	let slot = { slot_offset: 1, slot_marker: marker }
	let worker = task::spawn_with16<{ actions : List<ResponseAction>, next_state : { request_count : Int, marker : ByteChunk } }>(spawned_stream_handler, Request(11, marker), state, context, routing, metadata, audit, trace, shard, region, zone, site, rack, aisle, shelf, bin, slot)
	let _ = task::join(worker)
	route_socket_events(stream, 7, state)
end

pub fn adapter_missing_net(stream: NetStream, state: { request_count : Int, marker : ByteChunk }) -> { actions : List<ResponseAction>, next_state : { request_count : Int, marker : ByteChunk } } effects [concurrency]
	route_socket_events(stream, 7, state)
end
