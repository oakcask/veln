use app::wire
use facade

codec PrivateDecode for app::wire::PrivatePacket decode
	derive decode
end

codec MissingDecode for app::wire::MissingPacket decode
	derive decode
end

codec FunctionDecode for app::wire::make_packet decode
	derive decode
end

codec TypeDecode for app::wire::PacketShape decode
	derive decode
end

codec CodecDecode for app::wire::PacketCodec decode
	derive decode
end

codec BareImportedName for PublicPacket decode
	derive decode
end

codec MissingUsePath for other::PublicPacket decode
	derive decode
end

codec FacadeReexportDecode for facade::PublicPacket decode
	derive decode
end

fn schema_field_is_not_imported() -> Int
	payload
end

fn codec_item_is_not_callable() -> Int
	app::wire::PacketCodec()
end
