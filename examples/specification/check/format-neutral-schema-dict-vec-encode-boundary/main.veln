schema UnsupportedDictVecOptionPacket
	items: Dict<String, Vec<Option<Int>>>
end

fn direct_nested_vec(packet: {items: Dict<String, Vec<Option<Int>>>}) -> Result<{items: Dict<String, Vec<Option<Int>>>}, String>
	byte_encode_unsupported_dict_vec_option_packet(packet)
end

fn explicit_nested_vec(packet: {items: Dict<String, Vec<Option<Int>>>}) -> Result<{items: Dict<String, Vec<Option<Int>>>}, String>
	encode UnsupportedDictVecOptionPacket from packet
end
