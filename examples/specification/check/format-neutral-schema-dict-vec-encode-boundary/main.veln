schema UnsupportedDictVecListPacket
	items: Dict<String, Vec<List<Int>>>
end

fn direct_nested_vec(packet: {items: Dict<String, Vec<List<Int>>>}) -> Result<{items: Dict<String, Vec<List<Int>>>}, String>
	byte_encode_unsupported_dict_vec_list_packet(packet)
end

fn explicit_nested_vec(packet: {items: Dict<String, Vec<List<Int>>>}) -> Result<{items: Dict<String, Vec<List<Int>>>}, String>
	encode UnsupportedDictVecListPacket from packet
end
