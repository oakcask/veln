type Packet
	Packet {kind: Int, value: Int}
end

schema UnsupportedSelectorWire
	format binary

	kind: UInt8
	value: UInt8

	map to Packet when kind + 1 == 2
		kind = kind
		value = value

	map to Packet when kind == 2
		kind = kind
		value = value
end

schema UnknownSelectorWire
	format binary

	kind: UInt8
	value: UInt8

	map to Packet when missing == 1
		kind = kind
		value = value

	map to Packet when kind == 2
		kind = kind
		value = value
end

schema NonIntSelectorWire
	format binary

	flags: Flag8
	kind: UInt8
	value: UInt8

	map to Packet when flags == 1
		kind = kind
		value = value

	map to Packet when kind == 2
		kind = kind
		value = value
end

schema OverlappingBooleanSelectorWire
	format binary

	kind: UInt8
	flags: UInt8
	value: UInt8

	map to Packet when kind == 1 and flags != 0
		kind = kind
		value = value

	map to Packet when kind == 1 and flags == 2
		kind = kind
		value = value
end
