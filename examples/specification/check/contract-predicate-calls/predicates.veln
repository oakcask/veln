mod spec.predicates

pub fn positive(value: Int) -> Bool effects []
  value > 0
end

pub fn next_value(value: Int) -> Int effects []
  value + 1
end

pub fn apply(value: Int, predicate: fn(Int) -> Bool effects []) -> Bool effects []
  predicate(value)
end

pub fn summary(value: Int) -> {ready: Bool, next: Int} effects []
  {ready: positive(value), next: next_value(value)}
end
