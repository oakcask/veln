// Type annotations accept non-built-in named type paths with type arguments.
pub fn carry(value: domain::Envelope(String, Result(Int, AppError))) -> domain::Envelope(String, Result(Int, AppError))
  value
end

pub fn accept_callback(callback: fn(domain::Envelope(String, AppError)) -> () effects [stdio]) -> fn(domain::Envelope(String, AppError)) -> () effects [stdio]
  callback
end
