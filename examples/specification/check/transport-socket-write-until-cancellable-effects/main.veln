use net from "std"

# Compiler integration contract: cancellable writes keep time and nominal IO effects distinct.
pub fn write_until_cancellable_missing_time(stream: net::Stream, chunk: ByteChunk, deadline: Deadline, token: CancelToken) -> net::WriteOutcome effects [net::IO]
	time::wait_until(deadline)
	net::write_with(stream, chunk, Some(deadline), Some(token))
end

pub fn write_until_cancellable_missing_net(stream: net::Stream, chunk: ByteChunk, deadline: Deadline, token: CancelToken) -> net::WriteOutcome effects [time]
	net::write_with(stream, chunk, Some(deadline), Some(token))
end
