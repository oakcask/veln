use net from "std"

# Compiler integration contract: controlled writes keep time and nominal IO effects distinct.
pub fn write_until_missing_time(stream: net::Stream, chunk: ByteChunk, deadline: Deadline) -> net::WriteOutcome effects [net::IO]
	time::wait_until(deadline)
	net::write_with(stream, chunk, Some(deadline), None)
end

pub fn write_until_missing_net(stream: net::Stream, chunk: ByteChunk, deadline: Deadline) -> net::WriteOutcome effects [time]
	net::write_with(stream, chunk, Some(deadline), None)
end
