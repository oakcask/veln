mod spec.duplicates

pub type Alpha
	pub Same
end

pub type Beta
	pub Same
end

pub type Gamma
	pub Wrap(value: Int)
end

pub type Delta
	pub Wrap(value: String)
end

type Broken
	Repeat
	Repeat
end

fn alpha() -> Alpha
	Alpha::Same
end

fn beta() -> Beta
	Beta::Same
end

fn gamma() -> Gamma
	Gamma::Wrap(1)
end

fn delta() -> Delta
	Delta::Wrap("value")
end

fn ambiguous_payload() -> Gamma
	Wrap(1)
end
