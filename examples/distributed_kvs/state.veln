use command as domain

pub type ReplicatedLog
	pub ReplicatedLog(last_index: Int, entries: Dict<Int, domain::LogEntry>)
end

# Only this part survives process termination.
pub type PersistentState
	pub PersistentState(term: Int, voted_for: Option<Int>, log: ReplicatedLog)
end

pub type PeerProgress
	pub PeerProgress(next_index: Int, matched_index: Int)
end

pub type Role
	pub Follower(leader: Option<Int>, election_due: Int)
	pub Candidate(votes: Dict<Int, Bool>, election_due: Int)
	pub Leader(peers: Dict<Int, PeerProgress>)
end

pub type VolatileState
	pub VolatileState(commit_index: Int, role: Role)
end

pub type ApplicationState
	pub ApplicationState(last_applied: Int, values: Dict<String, String>, replies: Dict<String, domain::ClientReply>)
end

pub type State
	pub State(id: Int, persistent: PersistentState, volatile: VolatileState, application: ApplicationState)
end

pub fn election_due(id: Int, term: Int, now: Int) -> Int
	now + 1000 + id * 220 + (now + term * 97) % 401
end

pub fn empty_persistent() -> PersistentState
	PersistentState(0, None, ReplicatedLog(0, {}))
end

pub fn from_persistent(id: Int, persistent: PersistentState, now: Int) -> State
	State(id, persistent, VolatileState(0, Follower(None, election_due(id, persistent_term(persistent), now))), ApplicationState(0, {}, {}))
end

pub fn id(s: State) -> Int
	match s
		State(id, _, _, _) => id
	end
end

pub fn persistent(s: State) -> PersistentState
	match s
		State(_, persistent, _, _) => persistent
	end
end

pub fn persistent_term(p: PersistentState) -> Int
	match p
		PersistentState(term, _, _) => term
	end
end

pub fn persistent_vote(p: PersistentState) -> Option<Int>
	match p
		PersistentState(_, vote, _) => vote
	end
end

pub fn persistent_log(p: PersistentState) -> ReplicatedLog
	match p
		PersistentState(_, _, log) => log
	end
end

pub fn term(s: State) -> Int
	persistent_term(persistent(s))
end

pub fn voted_for(s: State) -> Option<Int>
	persistent_vote(persistent(s))
end

pub fn log(s: State) -> ReplicatedLog
	persistent_log(persistent(s))
end

pub fn log_size(log: ReplicatedLog) -> Int
	match log
		ReplicatedLog(size, _) => size
	end
end

pub fn size(s: State) -> Int
	log_size(log(s))
end

pub fn log_entry(log: ReplicatedLog, index: Int) -> Option<domain::LogEntry>
	match log
		ReplicatedLog(_, entries) => dict_get(entries, index)
	end
end

pub fn log_term(log: ReplicatedLog, index: Int) -> Int
	match log_entry(log, index)
		Some(entry) => domain::entry_term(entry)
		None => 0
	end
end

pub fn append_log(log: ReplicatedLog, entry: domain::LogEntry) -> ReplicatedLog
	match log
		ReplicatedLog(size, entries) => ReplicatedLog(size + 1, dict_insert(entries, size + 1, entry))
	end
end

pub fn truncate_log(log: ReplicatedLog, limit: Int) -> ReplicatedLog
	match log
		ReplicatedLog(size, entries) => if size <= limit
			log
		else
			truncate_log(ReplicatedLog(size - 1, dict_remove(entries, size)), limit)
		end
	end
end

pub fn role(s: State) -> Role
	match s
		State(_, _, VolatileState(_, role), _) => role
	end
end

pub fn is_leader(s: State) -> Bool
	match role(s)
		Leader(_) => true
		_ => false
	end
end

pub fn is_candidate(s: State) -> Bool
	match role(s)
		Candidate(_, _) => true
		_ => false
	end
end

pub fn known_leader(s: State) -> Option<Int>
	match role(s)
		Leader(_) => Some(id(s))
		Follower(leader, _) => leader
		Candidate(_, _) => None
	end
end

pub fn election_expired(s: State, now: Int) -> Bool
	match role(s)
		Follower(_, due) => now >= due
		Candidate(_, due) => now >= due
		Leader(_) => false
	end
end

pub fn commit(s: State) -> Int
	match s
		State(_, _, VolatileState(commit, _), _) => commit
	end
end

pub fn application(s: State) -> ApplicationState
	match s
		State(_, _, _, application) => application
	end
end

pub fn applied(s: State) -> Int
	match application(s)
		ApplicationState(applied, _, _) => applied
	end
end

pub fn values(s: State) -> Dict<String, String>
	match application(s)
		ApplicationState(_, values, _) => values
	end
end

pub fn replies(s: State) -> Dict<String, domain::ClientReply>
	match application(s)
		ApplicationState(_, _, replies) => replies
	end
end

pub fn with_persistent(s: State, persistent: PersistentState) -> State
	match s
		State(id, _, volatile, application) => State(id, persistent, volatile, application)
	end
end

pub fn with_election(s: State, term: Int, vote: Option<Int>) -> State
	with_persistent(s, PersistentState(term, vote, log(s)))
end

pub fn with_log(s: State, log: ReplicatedLog) -> State
	with_persistent(s, PersistentState(term(s), voted_for(s), log))
end

pub fn with_role(s: State, role: Role) -> State
	match s
		State(id, persistent, VolatileState(commit, _), application) => State(id, persistent, VolatileState(commit, role), application)
	end
end

pub fn with_commit(s: State, commit: Int) -> State
	match s
		State(id, persistent, VolatileState(_, role), application) => State(id, persistent, VolatileState(commit, role), application)
	end
end

pub fn with_application(s: State, application: ApplicationState) -> State
	match s
		State(id, persistent, volatile, _) => State(id, persistent, volatile, application)
	end
end

pub fn progress(s: State, peer: Int) -> PeerProgress
	match role(s)
		Leader(peers) => option_unwrap_or(dict_get(peers, peer), PeerProgress(size(s) + 1, 0))
		_ => PeerProgress(size(s) + 1, 0)
	end
end

pub fn with_progress(s: State, peer: Int, progress: PeerProgress) -> State
	match role(s)
		Leader(peers) => with_role(s, Leader(dict_insert(peers, peer, progress)))
		_ => s
	end
end

pub fn durable_changed(before: PersistentState, after: PersistentState) -> Bool
	let old = persistent_log(before)
	let next = persistent_log(after)
	persistent_term(before) != persistent_term(after) or option_unwrap_or(persistent_vote(before), 0) != option_unwrap_or(persistent_vote(after), 0) or log_size(old) != log_size(next) or log_term(old, log_size(old)) != log_term(next, log_size(next))
end
