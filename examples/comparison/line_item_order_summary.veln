# This comparison example summarizes line-item input into an order total.
fn add_summary(summary: {item_count: Int, subtotal_cents: Int}, item: {sku: String, quantity: Int, unit_cents: Int}) -> {item_count: Int, subtotal_cents: Int}
  {item_count: summary.item_count + item.quantity, subtotal_cents: summary.subtotal_cents + item.quantity * item.unit_cents}
end

fn parse_line(catalog: Dict<String, Int>, line: String) -> Result<{sku: String, quantity: Int, unit_cents: Int}, {kind: String, input: String}>
  match string_split_once(line, ",")
  Some(parts) => match string_parse_int(parts.right)
    Ok(quantity) => match quantity <= 0
      true => Err({kind: "bad_quantity", input: parts.right})
      false => match dict_get(catalog, parts.left)
        Some(price) => Ok({sku: parts.left, quantity: quantity, unit_cents: price})
        None => Err({kind: "unknown_sku", input: parts.left})
      end
    end
    Err(input) => Err({kind: "bad_quantity", input: input})
  end
  None => Err({kind: "malformed", input: line})
  end
end

pub fn summarize_order(lines: Vec<String>, catalog: Dict<String, Int>) -> result: Result<{item_count: Int, subtotal_cents: Int}, {kind: String, input: String}>
  let items: Vec<{sku: String, quantity: Int, unit_cents: Int}> = vec_try_map_with(catalog, lines, parse_line)?
  Ok(vec_fold(items, {item_count: 0, subtotal_cents: 0}, add_summary))
end

pub fn main() -> Result<(), {kind: String, input: String}> effects [stdio]
  let summary: {item_count: Int, subtotal_cents: Int} = summarize_order(["tea,2", "cake,1"], {"tea": 250, "cake": 400})?
  stdio::println(int_to_string(summary.subtotal_cents))
  Ok(())
end

fn sample_catalog() -> Dict<String, Int>
  {"tea": 250, "cake": 400}
end

test summarizes_success() -> Result<(), {kind: String, input: String}>
  let summary: {item_count: Int, subtotal_cents: Int} = summarize_order(["tea,2", "cake,1"], sample_catalog())?
  match summary.item_count == 3 and summary.subtotal_cents == 900
  true => Ok(())
  false => Err({kind: "wrong_summary", input: int_to_string(summary.subtotal_cents)})
  end
end

test rejects_malformed_input() -> Result<(), {kind: String, input: String}>
  match summarize_order(["tea"], sample_catalog())
  Ok(summary) => Err({kind: "unexpected_success", input: int_to_string(summary.subtotal_cents)})
  Err(error) => match error.kind == "malformed" and error.input == "tea"
    true => Ok(())
    false => Err(error)
  end
  end
end

test rejects_bad_quantity() -> Result<(), {kind: String, input: String}>
  match summarize_order(["tea,0"], sample_catalog())
  Ok(summary) => Err({kind: "unexpected_success", input: int_to_string(summary.subtotal_cents)})
  Err(error) => match error.kind == "bad_quantity" and error.input == "0"
    true => Ok(())
    false => Err(error)
  end
  end
end

test rejects_unknown_sku() -> Result<(), {kind: String, input: String}>
  match summarize_order(["mug,1"], sample_catalog())
  Ok(summary) => Err({kind: "unexpected_success", input: int_to_string(summary.subtotal_cents)})
  Err(error) => match error.kind == "unknown_sku" and error.input == "mug"
    true => Ok(())
    false => Err(error)
  end
  end
end
