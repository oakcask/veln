fn read_shutdown(state: Dict<String, String>, subject: String) -> { state : Dict<String, String>, result : { status : String, value : String, local : String, peer : String, bytes : ByteChunk, category : String, phase : String, input_committed : Int, output_committed : Int, ownership_committed : Int, cause : String } } effects [fs]
	let _ = event(state, join(["read-end", suffix(state), " ", subject]))
	transition(state, reply("end", "", "", "", byte_chunk([])))
end

fn read_deadline(state: Dict<String, String>, subject: String) -> { state : Dict<String, String>, result : { status : String, value : String, local : String, peer : String, bytes : ByteChunk, category : String, phase : String, input_committed : Int, output_committed : Int, ownership_committed : Int, cause : String } } effects [fs]
	let _ = event(state, join(["read-deadline ", subject]))
	transition(state, reply("deadline", "", "", "", byte_chunk([])))
end

fn read_cancelled(state: Dict<String, String>, subject: String) -> { state : Dict<String, String>, result : { status : String, value : String, local : String, peer : String, bytes : ByteChunk, category : String, phase : String, input_committed : Int, output_committed : Int, ownership_committed : Int, cause : String } } effects [fs]
	let _ = event(state, join(["read-cancelled ", subject]))
	transition(state, reply("cancelled", "", "", "", byte_chunk([])))
end

fn read_end(next: Dict<String, String>, state: Dict<String, String>, subject: String) -> { state : Dict<String, String>, result : { status : String, value : String, local : String, peer : String, bytes : ByteChunk, category : String, phase : String, input_committed : Int, output_committed : Int, ownership_committed : Int, cause : String } } effects [fs]
	let _ = event(state, join(["read-end", suffix(state), " ", subject]))
	transition(next, reply("end", "", "", "", byte_chunk([])))
end

fn production_read_input(index: Int, state: Dict<String, String>, subject: String) -> Option<String>
	let streams = get(state, "production_reads_hex")
	let chunks = if streams == ""
		get(state, "production_read_hex")
	else
		option_unwrap_or(part(streams, ",", number(state, join(["stream_index:", subject]))), "")
	end
	if chunks == ""
		None
	else
		part(chunks, ";", index)
	end
end

fn connect_stream(state: Dict<String, String>, subject: String) -> { state : Dict<String, String>, result : { status : String, value : String, local : String, peer : String, bytes : ByteChunk, category : String, phase : String, input_committed : Int, output_committed : Int, ownership_committed : Int, cause : String } } effects [fs]
	let configured = get(state, "connect_stream")
	let id = if production(state)
		"production-stream"
	else
		if configured == ""
			"client-stream"
		else
			configured
		end
	end
	let endpoint = if production(state)
		"127.0.0.1:1"
	else
		id
	end
	let index = number(state, "connect_index")
	let opened: Dict<String, String> = dict_insert(dict_insert(reset_stream(state, id), "connect_index", int_to_string(index + 1)), join(["stream_index:", id]), int_to_string(index))
	let next = dict_insert(dict_insert(dict_insert(opened, join(["local:", id]), endpoint), join(["peer:", id]), subject), join(["connected:", id]), "1")
	if event(state, join(["connect", suffix(state), " ", subject, " ", id]))
		transition(next, success(id, endpoint, subject))
	else
		transition(next, failure(id, endpoint, subject, "event_record_failed", "stream_connected", 0, 0, 1, "could not record injected net events"))
	end
end

fn accept_end(state: Dict<String, String>, subject: String) -> { state : Dict<String, String>, result : { status : String, value : String, local : String, peer : String, bytes : ByteChunk, category : String, phase : String, input_committed : Int, output_committed : Int, ownership_committed : Int, cause : String } } effects [fs]
	let _ = event(state, join(["accept-end", suffix(state), " ", subject]))
	transition(state, reply("end", "", "", "", byte_chunk([])))
end

fn accept_deadline(state: Dict<String, String>, subject: String) -> { state : Dict<String, String>, result : { status : String, value : String, local : String, peer : String, bytes : ByteChunk, category : String, phase : String, input_committed : Int, output_committed : Int, ownership_committed : Int, cause : String } } effects [fs]
	let _ = event(state, join(["accept-deadline ", subject]))
	transition(state, reply("deadline", "", "", "", byte_chunk([])))
end

fn accept_cancelled(state: Dict<String, String>, subject: String) -> { state : Dict<String, String>, result : { status : String, value : String, local : String, peer : String, bytes : ByteChunk, category : String, phase : String, input_committed : Int, output_committed : Int, ownership_committed : Int, cause : String } } effects [fs]
	let _ = event(state, join(["accept-cancelled ", subject]))
	transition(state, reply("cancelled", "", "", "", byte_chunk([])))
end

fn configured_stream_name(state: Dict<String, String>) -> String
	let configured = get(state, "accept_stream")
	if configured == ""
		"stream-1"
	else
		configured
	end
end

fn record_event(line: String, state: Dict<String, String>) -> Bool effects [fs]
	if get(state, "events") == ""
		true
	else
		append_text(get(state, "events"), join([line, "\n"]))
	end
end

fn append_text(path: String, text: String) -> Bool effects [fs]
	let file = fs::path(path)
	let old = match fs::read_to_string(file)
		Ok(value) => value
		Err(_) => ""
	end
	match fs::write_string(file, join([old, text]))
		Ok(_) => true
		Err(_) => false
	end
end

fn read_input_for_operation(state: Dict<String, String>, subject: String, operation: String) -> Option<String>
	match read_input(state, subject)
		Some(text) => Some(text)
		None => if operation == "read_chunk" and not production(state)
			Some("")
		else
			None
		end
	end
end

fn socket_address(text: String) -> Bool
	match string_split_once(text, ":")
		Some(parts) => match string_parse_int(parts.right)
			Ok(port) => port >= 0 and port <= 65535 and parts.left != ""
			Err(_) => false
		end
		None => false
	end
end

fn publish_pair_write(state: Dict<String, String>, subject: String, text: String) -> Dict<String, String>
	let paired = get(state, join(["paired:", subject]))
	if paired == ""
		state
	else
		dict_insert(state, join(["pending:", paired]), join([get(state, join(["pending:", paired])), text]))
	end
end

fn connect_pair(state: Dict<String, String>, subject: String) -> { state : Dict<String, String>, result : { status : String, value : String, local : String, peer : String, bytes : ByteChunk, category : String, phase : String, input_committed : Int, output_committed : Int, ownership_committed : Int, cause : String } } effects [fs]
	let client = "production-client-stream"
	let server = "production-stream"
	let endpoint = "127.0.0.1:1"
	let paired: Dict<String, String> = dict_insert(dict_insert(state, join(["paired:", client]), server), join(["paired:", server]), client)
	let next = dict_insert(dict_insert(paired, join(["local:", client]), endpoint), join(["peer:", client]), subject)
	if event(state, join(["connect-production ", subject, " ", client]))
		transition(next, success(client, endpoint, subject))
	else
		transition(next, failure(client, endpoint, subject, "event_record_failed", "stream_connected", 0, 0, 1, "could not record injected net events"))
	end
end

fn reset_stream(state: Dict<String, String>, id: String) -> Dict<String, String>
	let opened = dict_remove(dict_remove(dict_remove(state, join(["closed:", id])), join(["read_shutdown:", id])), join(["write_shutdown:", id]))
	dict_remove(dict_remove(dict_remove(dict_remove(opened, join(["read_index:", id])), join(["write_index:", id])), join(["writes:", id])), join(["connected:", id]))
end

fn capture_contents(state: Dict<String, String>, index: Int) -> String
	if index >= stream_count(state)
		""
	else
		join([separator(index, "\n"), get(state, join(["capture:", int_to_string(index)])), capture_contents(state, index + 1)])
	end
end
