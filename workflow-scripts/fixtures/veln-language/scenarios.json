      "covers": "language-match",
      "turns": [
        {
          "request": { "route": "language", "text": "How do Veln schemas work?" },
          "events": [
            { "type": "call", "tool": "search_docs", "arguments": { "query": "Veln schemas", "scope": "language" } },
            { "type": "result", "tool": "search_docs", "value": { "scope": "language", "results": [{ "uri": "veln-doc:///language/snapshot/recorded-digest/topic/schemas", "title": "Schemas", "summary": "Schemas describe fields and codec operations." }] } },
            { "type": "call", "tool": "read_doc", "arguments": { "uri": "veln-doc:///language/snapshot/recorded-digest/topic/schemas" } },
            { "type": "result", "tool": "read_doc", "value": { "uri": "veln-doc:///language/snapshot/recorded-digest/topic/schemas", "text": "Schemas describe format-neutral and binary fields. Explicit encode and decode expressions apply a schema." } },
            { "type": "answer", "status": "answered", "claims": ["Schemas describe format-neutral and binary fields."], "source_uris": ["veln-doc:///language/snapshot/recorded-digest/topic/schemas"] }
          ]
        }
      ]
    },
