    {
      "id": "repository-current-behavior",
      "covers": "repository-current",
      "turns": [
        {
          "request": { "route": "repository", "text": "Inspect the implemented Veln MCP documentation search." },
          "events": [
            { "type": "read", "path": "docs/README.md", "value": { "route": "docs/specification/mcp.md" } },
            { "type": "read", "path": "docs/specification/mcp.md", "value": { "authority": "current" } },
            { "type": "answer", "status": "repository_routed", "claims": [], "source_uris": [], "repository_authority": "docs/specification/mcp.md" }
          ]
        }
      ]
    },
    {
      "id": "repository-proposal-selection",
      "covers": "repository-proposal",
      "turns": [
        {
          "request": { "route": "repository", "text": "Select the next ready Veln language proposal." },
          "events": [
            { "type": "read", "path": "docs/README.md", "value": { "route": "docs/proposals/README.md" } },
            { "type": "read", "path": "docs/proposals/README.md", "value": { "authority": "proposal-catalog", "selection": "ready-only" } },
            { "type": "answer", "status": "repository_routed", "claims": [], "source_uris": [], "repository_authority": "docs/proposals/README.md" }
          ]
        }
      ]
    },
    {
      "id": "repository-unknown-topic",
      "covers": "repository-unknown",
      "turns": [
        {
          "request": { "route": "repository", "text": "Find repository authority for an undocumented deployment service." },
          "events": [
            { "type": "read", "path": "docs/README.md", "value": { "route": null } },
            { "type": "answer", "status": "repository_no_route", "claims": [], "source_uris": [], "message": "No repository documentation route covers this topic." }
