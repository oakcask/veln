{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agent-language-services-migration-ledger.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "entries"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_id",
          "lifecycle",
          "destination"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "lifecycle": {
                  "const": "current"
                }
              },
              "required": [
                "lifecycle"
              ]
            },
            "then": {
              "properties": {
                "destination": {
                  "properties": {
                    "kind": {
                      "const": "current"
                    }
                  },
                  "required": [
                    "kind"
                  ]
                }
              },
              "required": [
                "destination"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "lifecycle": {
                  "const": "completed"
                }
              },
              "required": [
                "lifecycle"
              ]
            },
            "then": {
              "properties": {
                "destination": {
                  "properties": {
                    "kind": {
                      "const": "completed"
                    }
                  },
                  "required": [
                    "kind"
                  ]
                }
              },
              "required": [
                "destination"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "lifecycle": {
                  "const": "planned"
                }
              },
              "required": [
                "lifecycle"
              ]
            },
            "then": {
              "properties": {
                "destination": {
                  "properties": {
                    "kind": {
                      "const": "planned"
                    }
                  },
                  "required": [
                    "kind"
                  ]
                }
              },
              "required": [
                "destination"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "lifecycle": {
                  "const": "removed"
                }
              },
              "required": [
                "lifecycle"
              ]
            },
            "then": {
              "properties": {
                "destination": {
                  "properties": {
                    "kind": {
                      "const": "removed"
                    }
                  },
                  "required": [
                    "kind"
                  ]
                }
              },
              "required": [
                "destination"
              ]
            }
          }
        ],
        "properties": {
          "source_id": {
            "type": "string",
            "pattern": "^agent-language-services/S[0-9]{4}\\.c[0-9]{2}$",
            "not": {
              "pattern": "(\\*|\\.\\.|remaining|^all\\b|range)"
            }
          },
          "lifecycle": {
            "enum": [
              "current",
              "completed",
              "planned",
              "removed"
            ]
          },
          "destination": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "current",
                  "completed",
                  "planned",
                  "removed"
                ]
              },
              "path": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\.md$"
              },
              "anchor": {
                "type": "string",
                "minLength": 1,
                "enum": [
                  "acceptance-model",
                  "agent-language-services-frozen-inventory",
                  "agent-module-package-and-documentation-model",
                  "agent-plugin",
                  "authority-and-inputs",
                  "checked-examples",
                  "command-and-transport",
                  "compiler-owned-tables",
                  "conformance-contract",
                  "coordinates",
                  "deferred-work",
                  "definition-and-reference-coverage",
                  "diagnostics-and-navigation",
                  "documentation-search-and-reads",
                  "executable-grammar",
                  "generated-package-documentation",
                  "goals",
                  "implementation-slices",
                  "implementation-status",
                  "language-semantics-prerequisite",
                  "lsp-integration",
                  "mcp-workspace-projects-diagnostics-and-definitions",
                  "motivation",
                  "next-slice-saved-workspace-function-references",
                  "non-goals",
                  "ownership-boundary",
                  "package-documentation-uri",
                  "package-snapshots",
                  "package-source-uri",
                  "plugin",
                  "project-selection",
                  "published-language-reference",
                  "reference-snapshot",
                  "resolution-and-failure",
                  "resources",
                  "safety-and-privacy",
                  "saved-snapshot-capture",
                  "semantic-locations",
                  "server-and-project-selection",
                  "slice-closure-prerequisite",
                  "summary",
                  "terminology",
                  "tools",
                  "topic-catalog",
                  "virtual-locations-and-package-documentation"
                ]
              },
              "evidence": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "path",
                    "case_id"
                  ],
                  "properties": {
                    "path": {
                      "type": "string",
                      "minLength": 1
                    },
                    "case_id": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              },
              "rationale": {
                "type": "string",
                "minLength": 1
              },
              "supersedes": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "path",
                  "anchor"
                ],
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "\\.md$"
                  },
                  "anchor": {
                    "type": "string",
                    "minLength": 1,
                    "enum": [
                      "acceptance-model",
                      "agent-language-services-frozen-inventory",
                      "agent-module-package-and-documentation-model",
                      "agent-plugin",
                      "authority-and-inputs",
                      "checked-examples",
                      "command-and-transport",
                      "compiler-owned-tables",
                      "conformance-contract",
                      "coordinates",
                      "deferred-work",
                      "definition-and-reference-coverage",
                      "diagnostics-and-navigation",
                      "documentation-search-and-reads",
                      "executable-grammar",
                      "generated-package-documentation",
                      "goals",
                      "implementation-slices",
                      "implementation-status",
                      "language-semantics-prerequisite",
                      "lsp-integration",
                      "mcp-workspace-projects-diagnostics-and-definitions",
                      "motivation",
                      "next-slice-saved-workspace-function-references",
                      "non-goals",
                      "ownership-boundary",
                      "package-documentation-uri",
                      "package-snapshots",
                      "package-source-uri",
                      "plugin",
                      "project-selection",
                      "published-language-reference",
                      "reference-snapshot",
                      "resolution-and-failure",
                      "resources",
                      "safety-and-privacy",
                      "saved-snapshot-capture",
                      "semantic-locations",
                      "server-and-project-selection",
                      "slice-closure-prerequisite",
                      "summary",
                      "terminology",
                      "tools",
                      "topic-catalog",
                      "virtual-locations-and-package-documentation"
                    ]
                  }
                }
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "kind": {
                      "const": "current"
                    }
                  }
                },
                "then": {
                  "required": [
                    "path",
                    "anchor",
                    "evidence"
                  ]
                }
              },
              {
                "if": {
                  "properties": {
                    "kind": {
                      "enum": [
                        "completed",
                        "planned"
                      ]
                    }
                  }
                },
                "then": {
                  "required": [
                    "path",
                    "anchor"
                  ]
                }
              },
              {
                "if": {
                  "properties": {
                    "kind": {
                      "const": "removed"
                    }
                  }
                },
                "then": {
                  "required": [
                    "rationale",
                    "supersedes"
                  ]
                }
              }
            ]
          }
        }
      }
    }
  }
}
