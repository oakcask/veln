schema Http2FrameHeader
	format binary

	priority: UInt16be
	length: UInt24be
	padding_length: UInt8 where padding_length <= length
	stream_reserved: ReservedBits(1, 0)
	stream_id: UInt31be
	little_stream_id: UInt31le
	checksum: UInt32be
	payload: ByteView(length - padding_length)
	aligned_payload: ByteView(length) where payload_count multiple of padding_length

	validate padding_length <= length
end

pub schema PublicFrameHeader
	format binary

	priority: UInt16be
	length: UInt24be
	padding_length: UInt8 where padding_length <= length
	stream_reserved: ReservedBits(1, 0)
	stream_id: UInt31be
	little_stream_id: UInt31le
	checksum: UInt32be
	payload: ByteView(length - padding_length)
	aligned_payload: ByteView(length) where payload_count multiple of padding_length

	validate padding_length <= length
end

schema Metadata
	version: Int
	title: String
end
