schema Http2FrameHeader
	format binary

	length: UInt24be
	padding_length: UInt8 where padding_length <= length
	payload: ByteView(length - padding_length)
end

pub schema PublicFrameHeader
	format binary

	length: UInt24be
	padding_length: UInt8 where padding_length <= length
	payload: ByteView(length - padding_length)
end
