effect Ask
	value() -> Int
end

fn provide(offset: Int) -> Int
	offset + 1
end

handler ask(offset: Int) for Ask
	value() => provide(offset)
end

handler qualified() for handles::Ask
	value() => 1
end

fn compute() -> Int effects [Ask]
	perform Ask::value()
end

fn run_case() -> Int
	handle compute() with ask(1)
end
