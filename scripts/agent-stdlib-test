set -euo pipefail

script_dir="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
repository_root="$(CDPATH= cd -- "$script_dir/.." && pwd)"
standard_root="$repository_root/crates/veln-stdlib/veln"
cache_root="$(mktemp -d)"

cleanup() {
  rm -rf "$cache_root"
}
trap cleanup EXIT HUP INT TERM
export VELN_CACHE_DIR="$cache_root"

cd "$standard_root"
bash ../../../scripts/agent-run \
  cargo run \
  --manifest-path ../../../Cargo.toml \
  --locked \
  -p veln-cli \
  -- test
