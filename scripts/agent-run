set -euo pipefail

if [ "$#" -eq 0 ]; then
  printf 'usage: bash scripts/agent-run <command> [args...]\n' >&2
  exit 64
fi

timeout_limit="${VELN_AGENT_TIMEOUT:-300s}"
memory_mb="${VELN_AGENT_MEMORY_MB:-6144}"
systemd_mode="${VELN_AGENT_SYSTEMD:-auto}"
java_options="${VELN_AGENT_JAVA_OPTIONS:--XX:+PerfDisableSharedMem -Xmx256m -XX:ActiveProcessorCount=2}"
java_tool_mode="${VELN_AGENT_JAVA_TOOLS:-auto}"
java_tool_dir=""

cleanup() {
  if [ -n "$java_tool_dir" ]; then
    rm -rf "$java_tool_dir"
  fi
}
trap cleanup EXIT
trap 'cleanup; exit 130' HUP INT TERM

case "$memory_mb" in
  ''|*[!0-9]*)
    printf 'VELN_AGENT_MEMORY_MB must be a whole number of megabytes\n' >&2
    exit 64
    ;;
esac

if ! command -v timeout >/dev/null 2>&1; then
  printf 'timeout command is required for guarded agent runs\n' >&2
  exit 69
fi

memory_kb=$((memory_mb * 1024))

run_with_address_space_limit() {
  (
    ulimit -v "$memory_kb"
    exec timeout --kill-after=10s "$timeout_limit" "$@"
  )
}

run_with_systemd_limit() {
  systemd-run \
    --user \
    --scope \
    --quiet \
    -p "MemoryMax=${memory_mb}M" \
    sh -c '
      memory_kb=$1
      timeout_limit=$2
      shift 2
      ulimit -v "$memory_kb"
      exec timeout --kill-after=10s "$timeout_limit" "$@"
    ' agent-run "$memory_kb" "$timeout_limit" "$@"
}

report_failure() {
  status="$1"
  enforcement="$2"

  case "$status" in
    124)
      failure="timed out after $timeout_limit"
      ;;
    134)
      failure="aborted with SIGABRT, commonly after an allocation failure"
      ;;
    137)
      failure="terminated with SIGKILL, possibly after timeout escalation or a memory limit"
      ;;
    143)
      failure="terminated with SIGTERM"
      ;;
    *)
      if [ "$status" -gt 128 ]; then
        failure="terminated by signal $((status - 128))"
      else
        failure="exited with status $status"
      fi
      ;;
  esac

  printf 'agent-run: guarded command %s\n' "$failure" >&2
  printf 'agent-run: active limits were timeout=%s memory=%sMiB enforcement=%s\n' \
    "$timeout_limit" "$memory_mb" "$enforcement" >&2
  printf 'agent-run: inspect the preceding output for runaway recursion, unbounded growth, or repeated work before raising a limit\n' >&2
}

write_java_wrapper() {
  tool="$1"
  real_tool="$2"
  wrapper="$java_tool_dir/$tool"

  {
    printf '#!/bin/sh\n'
    printf 'set -eu\n'
    printf 'agent_java_options=%s\n' "$(printf '%s\n' "$java_options" | sed "s/'/'\\\\''/g; s/^/'/; s/$/'/")"
    printf 'real_tool=%s\n' "$(printf '%s\n' "$real_tool" | sed "s/'/'\\\\''/g; s/^/'/; s/$/'/")"
    if [ "$tool" = "java" ]; then
      printf 'exec "$real_tool" $agent_java_options "$@"\n'
    else
      printf 'agent_java_args=\n'
      printf 'for agent_java_option in $agent_java_options; do\n'
      printf '  agent_java_args="$agent_java_args -J$agent_java_option"\n'
      printf 'done\n'
      printf 'exec "$real_tool" $agent_java_args "$@"\n'
    fi
  } >"$wrapper"
  chmod +x "$wrapper"
}

configure_java_tools() {
  if [ "$java_tool_mode" = 0 ] || [ -z "$java_options" ]; then
    return
  fi

  java_tool_dir="$(mktemp -d)"
  for tool in java javac javap; do
    real_tool="$(command -v "$tool" || true)"
    if [ -n "$real_tool" ]; then
      write_java_wrapper "$tool" "$real_tool"
    fi
  done
  export PATH="$java_tool_dir:$PATH"
}

configure_java_tools

if [ "$systemd_mode" != 0 ] && command -v systemd-run >/dev/null 2>&1; then
  if systemd-run --user --scope --quiet true >/dev/null 2>&1; then
    if run_with_systemd_limit "$@"; then
      exit 0
    else
      status=$?
      report_failure "$status" "systemd-cgroup+address-space"
      exit "$status"
    fi
  fi
fi

if run_with_address_space_limit "$@"; then
  exit 0
else
  status=$?
  report_failure "$status" "address-space"
  exit "$status"
fi
