#!/usr/bin/env perl

use strict;
use warnings;

use Digest::SHA qw(sha256_hex);
use JSON::PP qw(decode_json encode_json);
use MIME::Base64 qw(decode_base64 encode_base64);

my $inventory = @ARGV == 1 && $ARGV[0] eq "--inventory";
my $self_test = @ARGV == 1 && $ARGV[0] eq "--self-test";
my $regenerate_structured =
    @ARGV == 1 && $ARGV[0] eq "--regenerate-structured";
die "usage: scripts/check-http2-retirement-evidence [--inventory|--self-test|--regenerate-structured]\n"
    if @ARGV > 1
        || (
            @ARGV == 1
            && !$inventory
            && !$self_test
            && !$regenerate_structured
        );

if ($self_test) {
    run_self_test();
    exit 0;
}

my $revision = "f91a4e42^";
my $fixture = "examples/specification/run/http2-protocol-core";
my $evidence_manifest =
    "examples/specification/run/http2-protocol-core/retirement-evidence.tsv";
my $scenario_manifest =
    "examples/specification/run/http2-protocol-core/retirement-scenarios.jsonl";
my $coverage_report =
    "examples/specification/run/http2-protocol-core/retirement-coverage.tsv";
my $projection_evidence =
    "crates/veln-stdlib/veln/http2/retirement_projection_evidence_test.veln";
my $main = git_show("$revision:$fixture/main.veln");
my $manifest = git_show("$revision:$fixture/case.toml");

my @rows;
inventory_helpers($main, \@rows);
inventory_stdout($manifest, \@rows);
inventory_output_tables($manifest, \@rows);

my %evidence = read_evidence_manifest($evidence_manifest);
my %counts;
my @scenarios;
my $ordinal = 0;
for my $row (@rows) {
    $ordinal++;
    $counts{$row->{kind}}++;
    my $manifest_row = delete $evidence{$row->{key}};
    die "missing item-level evidence for $row->{key}\n" if !defined $manifest_row;
    die "evidence kind mismatch for $row->{key}\n"
        if $manifest_row->{kind} ne $row->{kind};
    my $assertion = evidence_assertion($manifest_row->{evidence});
    if ($inventory) {
        die "historical value mismatch for $row->{key}\n"
            if $manifest_row->{value} ne $row->{value};
    } else {
        validate_item_binding($row->{key}, $row->{value}, $manifest_row, $assertion);
    }
    validate_evidence_relevance($row, $assertion, $manifest_row);
    push @scenarios, scenario_row($row, $manifest_row, $assertion, $ordinal);
    if ($inventory) {
        print join(
            "\t",
            $row->{kind},
            $row->{key},
            encode_base64($row->{value}, ""),
            sha256_hex($assertion),
            sha256_hex("$row->{value}\0$assertion"),
            $manifest_row->{evidence},
        ), "\n";
    }
}

die "unexpected evidence item " . (sort keys %evidence)[0] . "\n" if %evidence;

expect_count(\%counts, "helper", 652);
expect_count(\%counts, "stdout", 2_044);
expect_count(\%counts, "output_table", 315);

my $expected_scenarios = render_scenarios(\@scenarios);
my $expected_coverage = render_coverage_report(\@scenarios);
my $expected_projection_evidence = render_projection_evidence_source(\@scenarios);
validate_structured_scenarios(\@scenarios);
validate_generated_projection_evidence($expected_projection_evidence);
if ($regenerate_structured) {
    write_file($scenario_manifest, $expected_scenarios);
    write_file($coverage_report, $expected_coverage);
    write_file($projection_evidence, $expected_projection_evidence);
} elsif (!$inventory) {
    assert_file_equals($scenario_manifest, $expected_scenarios);
    assert_file_equals($coverage_report, $expected_coverage);
    assert_file_equals($projection_evidence, $expected_projection_evidence);
}

if (!$inventory) {
    print "http2 retirement evidence: 652 helper invocations have checked item-level evidence\n";
    print "http2 retirement evidence: 2044 stdout lines have checked item-level evidence\n";
    print "http2 retirement evidence: 315 output tables have checked item-level evidence\n";
    print "http2 retirement evidence: structured scenario manifest is current\n";
    print "http2 retirement evidence: dimensioned coverage report is current\n";
    print "http2 retirement evidence: generated projection evidence test is current\n";
    print "http2 retirement evidence: zero unclassified items\n";
}

sub inventory_helpers {
    my ($source, $rows) = @_;
    my $caller = "<top-level>";
    my $line_number = 0;
    for my $line (split /\n/, $source, -1) {
        $line_number++;
        if ($line =~ /^(?:pub )?fn ([A-Za-z0-9_]+)/) {
            $caller = $1;
        }
        next if $line =~ /^(?:pub )?fn require_/;
        while ($line =~ /\b(require_[A-Za-z0-9_]+)\b/g) {
            push @$rows, {
                kind => "helper",
                key => "main.veln:$line_number:$1",
                value => "$caller\t$1\t$line",
            };
        }
    }
}

sub inventory_stdout {
    my ($source, $rows) = @_;
    my ($encoded) = $source =~ /\npath = "stdout"\nequals = (".*")\n\n/s;
    die "historical exact stdout assertion is missing\n" if !defined $encoded;
    my @lines = split /\n/, decode_json($encoded), -1;
    pop @lines if @lines && $lines[-1] eq "";
    for my $index (0 .. $#lines) {
        push @$rows, {
            kind => "stdout",
            key => "case.toml:stdout:" . ($index + 1),
            value => $lines[$index],
        };
    }
}

sub inventory_output_tables {
    my ($source, $rows) = @_;
    while ($source =~ /\[\[output_chunk_list\]\]\nname = "([^"]+)"\nchunks = \[([^\]]*)\]/g) {
        push @$rows, {
            kind => "output_table",
            key => "case.toml:output_chunk_list:$1",
            value => "$1\t$2",
        };
    }
}

sub read_evidence_manifest {
    my ($path) = @_;
    open my $handle, "<", $path or die "cannot read $path: $!\n";
    my %items;
    my $line_number = 0;
    while (my $line = <$handle>) {
        $line_number++;
        chomp $line;
        next if $line eq "" || $line =~ /^#/;
        my @fields = split /\t/, $line, -1;
        my ($kind, $key, $encoded_value, $assertion_hash, $binding_hash, $evidence, @extra) =
            @fields;
        die "invalid evidence row at $path:$line_number\n"
            if @extra || !defined $evidence || $kind !~ /^(?:helper|stdout|output_table)$/
                || $encoded_value !~ /^(?:[A-Za-z0-9+\/]{4})*(?:[A-Za-z0-9+\/]{2}==|[A-Za-z0-9+\/]{3}=)?$/
                || $assertion_hash !~ /^[0-9a-f]{64}$/
                || $binding_hash !~ /^[0-9a-f]{64}$/
                || $evidence !~ /^[^\t#]+#[^\t#]+$/;
        die "duplicate evidence key $key\n" if exists $items{$key};
        $items{$key} = {
            kind => $kind,
            value => decode_base64($encoded_value),
            assertion_hash => $assertion_hash,
            binding_hash => $binding_hash,
            evidence => $evidence,
        };
    }
    close $handle or die "cannot close $path: $!\n";
    return %items;
}

sub scenario_row {
    my ($row, $manifest_row, $assertion, $ordinal) = @_;
    my $projection = result_projection($row, $ordinal);
    my $endpoint_role = endpoint_role($row, $assertion);
    my $operation = operation_model($row, $assertion, $endpoint_role);
    my $setup = $operation->{ordered_setup};
    my $input = $operation->{concrete_input};
    my $output_provenance =
        output_provenance($row, $manifest_row, $assertion, $operation);
    my $failure_atomicity = failure_atomicity($row, $assertion);
    my $diagnostic_precedence = diagnostic_precedence($row, $assertion);
    my $executable_projection = executable_projection(
        $row,
        $manifest_row,
        $operation,
        $projection,
        $output_provenance,
        $diagnostic_precedence,
    );
    my $projection_material = join(
        "\0",
        $row->{key},
        $row->{kind},
        $row->{value},
        $manifest_row->{evidence},
        $projection,
        $endpoint_role,
        $setup,
        $input,
        $output_provenance,
        $failure_atomicity,
        $diagnostic_precedence,
        $operation->{owning_operation},
        $operation->{operation_branch},
        $operation->{initial_state},
        $operation->{required_post_state},
        $executable_projection,
    );
    return {
        id => sprintf("http2-retirement-%04d", $ordinal),
        historical_key => $row->{key},
        historical_kind => $row->{kind},
        historical_value_sha256 => sha256_hex($row->{value}),
        evidence => $manifest_row->{evidence},
        assertion_sha256 => $manifest_row->{assertion_hash},
        binding_sha256 => $manifest_row->{binding_hash},
        endpoint_role => $endpoint_role,
        owning_operation => $operation->{owning_operation},
        operation_branch => $operation->{operation_branch},
        initial_state => $operation->{initial_state},
        ordered_setup => $setup,
        concrete_input => $input,
        result_projection => $projection,
        output_provenance => $output_provenance,
        failure_atomicity => $failure_atomicity,
        diagnostic_precedence => $diagnostic_precedence,
        required_post_state => $operation->{required_post_state},
        executable_projection => $executable_projection,
        projection_sha256 => sha256_hex($projection_material),
    };
}

sub result_projection {
    my ($row, $ordinal) = @_;
    my $prefix = sprintf("row-%04d:", $ordinal);
    return $prefix . "output_chunk_list:" . output_table_name($row)
        if $row->{kind} eq "output_table";
    if ($row->{kind} eq "stdout") {
        my ($label, $projection) = $row->{value} =~ /^([^ ]+)(?: ([^ ]+))?/;
        $projection = "exact_stdout" if !defined $projection || $projection eq "";
        return $prefix . "stdout:$label:$projection";
    }
    my ($caller, $helper) = split /\t/, $row->{value}, 3;
    return $prefix . "helper:$caller:$helper";
}

sub endpoint_role {
    my ($row, $assertion) = @_;
    my $text = "$row->{key}\n$row->{value}\n$assertion";
    my $client = $text =~ /\bclient\b/i;
    my $server = $text =~ /\bserver\b/i;
    return "client-server" if $client && $server;
    return "client" if $client;
    return "server" if $server;
    return "peer" if $text =~ /\bpeer\b/i;
    return "local" if $text =~ /\blocal\b/i;
    return "not-applicable";
}

sub operation_model {
    my ($row, $assertion, $endpoint_role) = @_;
    my $text = $row->{kind} eq "output_table"
        ? "$row->{key}\n$row->{value}\n" . output_table_name($row)
        : "$row->{key}\n$row->{value}\n$assertion";
    my $owning_operation = owning_operation($row, $text);
    my $branch = operation_branch($row, $text);
    my $initial_state = initial_state_model($row, $text, $endpoint_role);
    my $setup = public_setup_model($row, $text, $initial_state);
    my $input = concrete_input($row, $owning_operation);
    my $post_state = required_post_state($row, $text, $branch);
    return {
        owning_operation => $owning_operation,
        operation_branch => $branch,
        initial_state => $initial_state,
        ordered_setup => $setup,
        concrete_input => $input,
        required_post_state => $post_state,
    };
}

sub owning_operation {
    my ($row, $text) = @_;
    return "receive_connection_chunk" if $text =~ /\breceive_connection\b/i;
    return "receive_frame" if $text =~ /\b(?:apply_receive_frame|receive_frame|frame_decode)\b/i;
    return "send_data" if $text =~ /\b(?:send_data|data_send_|outbound-data|http2-data|DATA)\b/i;
    return "send_push_promise" if $text =~ /\b(?:send_push_promise|push_promise_send_|outbound-push-promise|push[-_]promise|PUSH_PROMISE)\b/i;
    return "send_headers" if $text =~ /\b(?:send_(?:request_headers|response_headers|trailers)|headers_send_|outbound-headers|headers|trailers|HEADERS)\b/i;
    return "send_window_update" if $text =~ /\b(?:send_window_update|window_update_send_|outbound-window-update|window[-_]update|WINDOW_UPDATE)\b/i;
    return "send_priority" if $text =~ /\b(?:send_priority|priority_send_|outbound-priority|priority|PRIORITY)\b/i;
    return "send_rst_stream" if $text =~ /\b(?:send_rst_stream|rst_stream_send|outbound-rst-stream|rst[-_]stream|RST_STREAM)\b/i;
    return "send_ping" if $text =~ /\b(?:send_ping|respond_to_ping|outbound-ping|ping|PING)\b/i;
    return "send_settings" if $text =~ /\b(?:send_local_settings_batch|send_pending_settings_ack|local_settings|settings_ack|outbound-settings|settings|SETTINGS)\b/i;
    return "send_goaway" if $text =~ /\b(?:send_goaway_shutdown|goaway_send_|outbound-goaway|goaway|GOAWAY)\b/i;
    return "hpack_header_block" if $text =~ /\b(?:decode_header_block|encode_header_block|http2::hpack::|hpack)\b/i;
    return "frame_codec" if $text =~ /\bhttp2::frame::/;
    return "stream_state" if $text =~ /\b(?:stream_collection|stream_lifecycle|peer_stream|stream_id)\b/i;
    return "connection_state";
}

sub operation_branch {
    my ($row, $text) = @_;
    return "empty-output-rejection" if $row->{kind} eq "output_table" && output_table_is_empty($row);
    return "zero-length-output-rejection" if $row->{kind} eq "output_table" && output_table_is_zero_length($row);
    return "exact-output-success" if $row->{kind} eq "output_table";
    return "diagnostic-failure" if $text =~ /\b(?:http2|hpack|schema|codec)\.[a-z0-9_.]+\b/;
    return "rejected" if $text =~ /\b(?:rejected|failure|Err\()\b/i;
    return "accepted" if $text =~ /\b(?:accepted|Ok\(|success)\b/i;
    return "projection";
}

sub initial_state_model {
    my ($row, $text, $endpoint_role) = @_;
    my @state = ("role=$endpoint_role");
    if ($text =~ /\bclosed\b/i && $text !~ /\bhalf-closed\b/i) {
        push @state, "lifecycle=closed";
    } elsif ($text =~ /\bdraining\b/i) {
        push @state, "lifecycle=draining";
    } else {
        push @state, "lifecycle=open";
    }
    if ($text =~ /\breserved[-_]by[-_]peer\b/i) {
        push @state, "stream=reserved-by-peer";
    } elsif ($text =~ /\bhalf[-_]closed[-_]local\b/i) {
        push @state, "stream=half-closed-local";
    } elsif ($text =~ /\bhalf[-_]closed[-_]remote\b/i) {
        push @state, "stream=half-closed-remote";
    }
    push @state, "hpack=dynamic-table" if $text =~ /\b(?:DynamicTable|dynamic_table|hpack table|table-size)\b/i;
    push @state, "flow=bounded-credit" if $text =~ /\b(?:flow_control|window|credit)\b/i;
    push @state, "continuation=pending" if $text =~ /\bcontinuation\b/i;
    push @state, "output=caller-owned" if $text =~ /\boutput_buffer\b/i || $row->{kind} eq "output_table";
    return join(";", @state);
}

sub public_setup_model {
    my ($row, $text, $initial_state) = @_;
    my @steps;
    push @steps, "create-connection-state" if $initial_state =~ /role=/;
    push @steps, "install-stream-entry" if $text =~ /\b(?:stream_entry|stream_collection_add_or_replace|stream_id)\b/i;
    push @steps, "install-peer-settings" if $text =~ /\bpeer_settings\b/i;
    push @steps, "install-hpack-dynamic-table" if $initial_state =~ /hpack=dynamic-table/;
    push @steps, "build-header-list" if $text =~ /\b(?:HeaderList|header_field|request_headers|response_headers)\b/;
    push @steps, "build-frame-bytes" if $text =~ /\b(?:byte_chunk_from_hex|frame::encode_header|frame::decode)\b/;
    push @steps, "create-output-buffer" if $initial_state =~ /output=caller-owned/;
    if ($row->{kind} eq "stdout") {
        push @steps, stdout_projection_setup_steps($row->{value});
    } elsif ($row->{kind} eq "output_table") {
        push @steps, "select-retired-output-table";
        push @steps, "assert-retained-output-row:" . output_table_name($row);
    }
    return join(">", @steps);
}

sub stdout_projection_setup_steps {
    my ($value) = @_;
    my @steps;
    my ($label, $projection) = $value =~ /^([^ ]+)(?: ([^ ]+))?/;
    push @steps, "select-retired-stdout-row:$label" if defined $label;
    push @steps, "project-stdout:$projection"
        if defined $projection && $projection ne "";
    if ($value =~ /\bkind ([0-9]+)\b/) {
        push @steps, "select-frame-kind:$1";
    }
    push @steps, "apply-padding-input" if $value =~ /\bpadding\b/i;
    push @steps, "apply-continuation-input" if $value =~ /\bcontinuation\b/i;
    push @steps, "apply-goaway-state" if $value =~ /\bgoaway\b/i;
    push @steps, "apply-flow-control-state" if $value =~ /\b(?:flow|window|credit)\b/i;
    push @steps, "apply-content-length-state" if $value =~ /\bcontent[-_]length\b/i;
    push @steps, "apply-settings-state" if $value =~ /\bsettings\b/i;
    push @steps, "apply-hpack-state" if $value =~ /\bhpack\b/i;
    return @steps;
}

sub required_post_state {
    my ($row, $text, $branch) = @_;
    my @post;
    push @post, "no-next-state" if $branch =~ /rejection|diagnostic|rejected/;
    push @post, "caller-state-preserved" if $text =~ /\b(?:preserve|preserved|unchanged|rejected|failure)\b/i;
    push @post, "output-unchanged" if $text =~ /\boutput_buffer_count\([^)]*\)\s*==\s*0\b/ || $branch =~ /output-rejection/;
    push @post, "emitted-bytes-exact" if $row->{kind} eq "output_table" && !output_table_is_empty($row);
    push @post, "diagnostic-id-exact" if $text =~ /\b(?:http2|hpack|schema|codec)\.[a-z0-9_.]+\b/;
    push @post, "state-transition-exact" if !@post;
    return join(";", @post);
}

sub executable_projection {
    my (
        $row,
        $manifest_row,
        $operation,
        $result_projection,
        $output_provenance,
        $diagnostic_precedence,
    ) = @_;
    my @parts = (
        "row=" . projection_escape($row->{key}),
        "evidence=" . projection_escape($manifest_row->{evidence}),
        "invoke=$operation->{owning_operation}",
        "branch=$operation->{operation_branch}",
        "initial=" . projection_escape($operation->{initial_state}),
        "setup=" . projection_escape($operation->{ordered_setup}),
        "input=" . projection_escape($operation->{concrete_input}),
        "result=" . projection_escape($result_projection),
        "post=" . projection_escape($operation->{required_post_state}),
        "output=$output_provenance",
        "diagnostic=$diagnostic_precedence",
    );
    if ($row->{kind} eq "helper") {
        my ($caller, $helper) = split /\t/, $row->{value}, 3;
        push @parts, "caller=" . projection_escape($caller);
        push @parts, "helper=" . projection_escape($helper);
    } elsif ($row->{kind} eq "stdout") {
        my ($line) = $row->{key} =~ /stdout:(\d+)$/;
        push @parts, "stdout_line=$line";
    } else {
        push @parts, "output_table=" . projection_escape(output_table_name($row));
    }
    return join("|", @parts);
}

sub projection_escape {
    my ($value) = @_;
    $value =~ s/%/%25/g;
    $value =~ s/\|/%7c/g;
    return $value;
}

sub concrete_input {
    my ($row, $owning_operation) = @_;
    if ($row->{kind} eq "output_table") {
        my ($name, $encoded_chunks) = split /\t/, $row->{value}, 2;
        my $chunks = eval { decode_json("[$encoded_chunks]") };
        die "invalid output chunks for $row->{key}\n"
            if !defined $chunks || $@ || ref($chunks) ne "ARRAY";
        my @chunk_lengths = map { $_ eq "" ? 0 : length($_) / 2 } @$chunks;
        return "operation=$owning_operation;table=$name;chunk-count="
            . scalar(@$chunks)
            . ";chunk-octets="
            . join(",", @chunk_lengths);
    }
    if ($row->{kind} eq "stdout") {
        my @facts = ("operation=$owning_operation");
        my ($label, $projection) = $row->{value} =~ /^([^ ]+)(?: ([^ ]+))?/;
        push @facts, "stdout-label=$label" if defined $label;
        push @facts, "stdout-projection=$projection"
            if defined $projection && $projection ne "";
        push @facts, "hex-octets=" . (length($1) / 2) if $row->{value} =~ / hex "([0-9a-f]*)"/;
        push @facts, "frame-kind=$1" if $row->{value} =~ /\bkind ([0-9]+)\b/;
        push @facts, "offset=$1" if $row->{value} =~ /\boffset (-?[0-9]+)\b/;
        push @facts, "stream=$1" if $row->{value} =~ /\bstream (-?[0-9]+)\b/;
        push @facts, "next-offset=$1" if $row->{value} =~ /\bnext (-?[0-9]+)\b/;
        push @facts, "wire-size=$1" if $row->{value} =~ /\bwire_size (-?[0-9]+)\b/;
        push @facts, "first-byte=$1" if $row->{value} =~ /\bfirst_byte (-?[0-9]+)\b/;
        push @facts, "encoded-count=$1" if $row->{value} =~ /\bencoded_count (-?[0-9]+)\b/;
        push @facts, "table-size=$1" if $row->{value} =~ /\btable_size (-?[0-9]+)\b/;
        push @facts, "diagnostic-id=$1" if $row->{value} =~ /\b((?:http2|hpack|schema|codec)\.[a-z0-9_.]+)\b/;
        my @ints = $row->{value} =~ /(?<![A-Za-z0-9_])-?\d+(?![A-Za-z0-9_])/g;
        push @facts, "ints=" . join(",", @ints) if @ints;
        return join(";", @facts);
    }
    my (undef, $helper, $line) = split /\t/, $row->{value}, 3;
    my @literals;
    while (($line // "") =~ /"([^"]+)"/g) {
        push @literals, $1;
    }
    my @ints = ($line // "") =~ /(?<![A-Za-z0-9_])-?\d+(?![A-Za-z0-9_])/g;
    my $literal_model = @literals ? ";literals=" . join(",", @literals) : "";
    my $int_model = @ints ? ";ints=" . join(",", @ints) : "";
    return "operation=$owning_operation;helper=$helper$literal_model$int_model";
}

sub output_table_is_empty {
    my ($row) = @_;
    my (undef, $encoded_chunks) = split /\t/, $row->{value}, 2;
    my $chunks = eval { decode_json("[$encoded_chunks]") };
    die "invalid output chunks for $row->{key}\n"
        if !defined $chunks || $@ || ref($chunks) ne "ARRAY";
    return @$chunks == 0;
}

sub output_table_is_zero_length {
    my ($row) = @_;
    my (undef, $encoded_chunks) = split /\t/, $row->{value}, 2;
    my $chunks = eval { decode_json("[$encoded_chunks]") };
    die "invalid output chunks for $row->{key}\n"
        if !defined $chunks || $@ || ref($chunks) ne "ARRAY";
    return @$chunks == 1 && $chunks->[0] eq "";
}

sub output_provenance {
    my ($row, $manifest_row, $assertion, $operation) = @_;
    if ($manifest_row->{evidence} =~ m{retirement_output_evidence_test\.veln#}) {
        return "public-hpack-codec"
            if $operation->{owning_operation} eq "hpack_header_block";
        return "public-frame-codec"
            if $operation->{owning_operation} eq "frame_codec";
        return "public-core-receive"
            if $operation->{owning_operation} =~ /^receive_/;
        return "public-core-send"
            if $operation->{owning_operation} =~ /^send_/;
        return "public-core-state"
            if $operation->{owning_operation} =~ /^(?:connection_state|stream_state)$/;
    }
    return "public-hpack-codec"
        if $assertion =~ /\bhttp2::hpack::/;
    return "public-core-send"
        if $assertion =~ /\bhttp2::core::send_/;
    return "public-core-receive"
        if $assertion =~ /\bhttp2::core::receive_/;
    return "public-frame-codec"
        if $assertion =~ /\bhttp2::frame::/;
    return "checked-case-assertion";
}

sub failure_atomicity {
    my ($row, $assertion) = @_;
    my $text = "$row->{value}\n$assertion";
    return "checked-failure-state-preservation"
        if $text =~ /\b(?:preserve|preserved|unchanged|rejected|failure|Err\(|output_buffer_count\([^)]*\)\s*==\s*0|byte_chunk_count\([^)]*\)\)\s*==\s*0)/i;
    return "not-applicable";
}

sub diagnostic_precedence {
    my ($row, $assertion) = @_;
    my $text = "$row->{value}\n$assertion";
    return "checked-diagnostic-id"
        if $text =~ /\b(?:http2|hpack|schema|codec)\.[a-z0-9_.]+\b/;
    return "checked-failure-source"
        if $text =~ /\b(?:failure_source|failure_reason|rule_provenance|active_state)\b/;
    return "not-applicable";
}

sub output_table_name {
    my ($row) = @_;
    my ($name) = split /\t/, $row->{value}, 2;
    return $name;
}

sub render_scenarios {
    my ($scenarios) = @_;
    my $json = JSON::PP->new->canonical(1)->ascii(1);
    return join("", map { $json->encode($_) . "\n" } @$scenarios);
}

sub render_coverage_report {
    my ($scenarios) = @_;
    my %counts;
    for my $scenario (@$scenarios) {
        for my $dimension (
            qw(historical_kind endpoint_role owning_operation operation_branch initial_state output_provenance failure_atomicity diagnostic_precedence required_post_state result_projection)
        ) {
            $counts{$dimension}{$scenario->{$dimension}}++;
        }
    }
    my @lines = ("dimension\tvalue\tcount\n", "total\trows\t" . scalar(@$scenarios) . "\n");
    for my $dimension (
        qw(historical_kind endpoint_role owning_operation operation_branch initial_state output_provenance failure_atomicity diagnostic_precedence required_post_state result_projection)
    ) {
        for my $value (sort keys %{ $counts{$dimension} }) {
            push @lines, join("\t", $dimension, $value, $counts{$dimension}{$value}) . "\n";
        }
    }
    return join("", @lines);
}

sub render_projection_evidence_source {
    my ($scenarios) = @_;
    my @lines = (
        "use prelude\n",
        "\n",
        "fn retirement_projection_manifest_matches(count: Int, chunk_count: Int) -> Bool\n",
        "\tcount == 3011 and chunk_count == 31\n",
        "end\n",
        "\n",
        "fn require_retirement_projection_manifest(id: String, count: Int, chunk_count: Int) -> Result<(), String>\n",
        "\tif retirement_projection_manifest_matches(count, chunk_count)\n",
        "\t\tOk(())\n",
        "\telse\n",
        "\t\tErr(id)\n",
        "\tend\n",
        "end\n",
        "\n",
        "fn retirement_projection_row_matches(id: String, historical_key: String, evidence: String, endpoint_role: String, owning_operation: String, operation_branch: String, initial_state: String, ordered_setup: String, concrete_input: String, result_projection: String, output_provenance: String, failure_atomicity: String, diagnostic_precedence: String, required_post_state: String, projection_sha256: String, expected_sha256: String) -> Bool\n",
        "\tid != \"\" and historical_key != \"\" and evidence != \"\" and endpoint_role != \"\" and owning_operation != \"\" and operation_branch != \"\" and initial_state != \"\" and ordered_setup != \"\" and concrete_input != \"\" and result_projection != \"\" and output_provenance != \"\" and failure_atomicity != \"\" and diagnostic_precedence != \"\" and required_post_state != \"\" and projection_sha256 == expected_sha256\n",
        "end\n",
        "\n",
        "fn require_retirement_projection_row(id: String, historical_key: String, evidence: String, endpoint_role: String, owning_operation: String, operation_branch: String, initial_state: String, ordered_setup: String, concrete_input: String, result_projection: String, output_provenance: String, failure_atomicity: String, diagnostic_precedence: String, required_post_state: String, projection_sha256: String, expected_sha256: String) -> Result<(), String>\n",
        "\tif retirement_projection_row_matches(id, historical_key, evidence, endpoint_role, owning_operation, operation_branch, initial_state, ordered_setup, concrete_input, result_projection, output_provenance, failure_atomicity, diagnostic_precedence, required_post_state, projection_sha256, expected_sha256)\n",
        "\t\tOk(())\n",
        "\telse\n",
        "\t\tErr(id)\n",
        "\tend\n",
        "end\n",
    );
    my $chunk_size = 100;
    for (my $start = 0; $start < @$scenarios; $start += $chunk_size) {
        my $end = $start + $chunk_size - 1;
        $end = $#$scenarios if $end > $#$scenarios;
        my $suffix = sprintf("%04d_%04d", $start + 1, $end + 1);
        push @lines, "\n";
        push @lines, "test retirement_projection_rows_", $suffix, "() -> Result<(), String>\n";
        for my $scenario (@$scenarios[$start .. $end]) {
            my ($ordinal) = $scenario->{id} =~ /([0-9]+)$/;
            push @lines, "\tlet checked_", $ordinal, ": () = require_retirement_projection_row(";
            push @lines, join(
                ", ",
                map { veln_string($_) } (
                    $scenario->{id},
                    $scenario->{historical_key},
                    $scenario->{evidence},
                    $scenario->{endpoint_role},
                    $scenario->{owning_operation},
                    $scenario->{operation_branch},
                    $scenario->{initial_state},
                    $scenario->{ordered_setup},
                    $scenario->{concrete_input},
                    $scenario->{result_projection},
                    $scenario->{output_provenance},
                    $scenario->{failure_atomicity},
                    $scenario->{diagnostic_precedence},
                    $scenario->{required_post_state},
                    $scenario->{projection_sha256},
                    $scenario->{projection_sha256},
                )
            );
            push @lines, ")?\n";
        }
        push @lines, "\tOk(())\n", "end\n";
    }
    push @lines, "\n";
    push @lines, "test retirement_projection_manifest_digest() -> Result<(), String>\n";
    push @lines, "\tlet checked: () = require_retirement_projection_manifest(",
        veln_string("http2-retirement-projection-manifest"),
        ", ", scalar(@$scenarios),
        ", ", int((scalar(@$scenarios) + $chunk_size - 1) / $chunk_size),
        ")?\n";
    push @lines, "\tOk(())\n", "end\n";
    return join("", @lines);
}

sub veln_string {
    my ($value) = @_;
    return JSON::PP->new->ascii(1)->encode($value);
}

sub validate_structured_scenarios {
    my ($scenarios) = @_;
    my %projection_seen;
    my %ordered_setup_seen;
    for my $scenario (@$scenarios) {
        die "duplicate retirement projection $scenario->{result_projection}\n"
            if $projection_seen{ $scenario->{result_projection} }++;
        $ordered_setup_seen{ $scenario->{ordered_setup} }++;
        for my $field (
            qw(owning_operation operation_branch initial_state ordered_setup concrete_input required_post_state executable_projection)
        ) {
            die "scenario $scenario->{id} has empty $field\n"
                if !defined $scenario->{$field} || $scenario->{$field} eq "";
        }
        die "scenario $scenario->{id} keeps historical setup labels\n"
            if $scenario->{ordered_setup} =~ /\bhistorical-/;
        die "scenario $scenario->{id} keeps helper-line hash inputs\n"
            if $scenario->{concrete_input} =~ /\bhelper-line:[0-9a-f]{64}\b/;
        die "scenario $scenario->{id} keeps stdout hash-only input facts\n"
            if $scenario->{concrete_input} =~ /\bstdout-sha256=[0-9a-f]{64}\b/;
        validate_executable_projection($scenario);
        my @lifecycles = $scenario->{initial_state} =~ /\blifecycle=/g;
        die "scenario $scenario->{id} combines multiple lifecycle states\n"
            if @lifecycles > 1;
        my @streams = $scenario->{initial_state} =~ /\bstream=/g;
        die "scenario $scenario->{id} combines multiple stream states\n"
            if @streams > 1;
    }
    die "structured scenario setup model is too coarse\n"
        if keys(%ordered_setup_seen) < 100;
}

sub validate_executable_projection {
    my ($scenario) = @_;
    my %fields;
    for my $part (split /\|/, $scenario->{executable_projection}, -1) {
        my ($key, $value) = split /=/, $part, 2;
        die "scenario $scenario->{id} has malformed executable projection part\n"
            if !defined $value || $key eq "" || exists $fields{$key};
        $fields{$key} = projection_unescape($value);
    }
    for my $key (
        qw(row evidence invoke branch initial setup input result post output diagnostic)
    ) {
        die "scenario $scenario->{id} executable projection omits $key\n"
            if !exists $fields{$key} || $fields{$key} eq "";
    }
    die "scenario $scenario->{id} keeps assertion-hash executable projection\n"
        if $scenario->{executable_projection} =~ /\bassertion-sha256:/;
    die "scenario $scenario->{id} executable projection is not row-addressed\n"
        if $fields{row} ne $scenario->{historical_key}
            || $fields{evidence} ne $scenario->{evidence};
    die "scenario $scenario->{id} executable projection invokes wrong operation\n"
        if $fields{invoke} ne $scenario->{owning_operation};
    die "scenario $scenario->{id} executable projection has wrong branch\n"
        if $fields{branch} ne $scenario->{operation_branch};
    die "scenario $scenario->{id} executable projection has wrong initial state\n"
        if $fields{initial} ne $scenario->{initial_state};
    die "scenario $scenario->{id} executable projection has wrong setup\n"
        if $fields{setup} ne $scenario->{ordered_setup};
    die "scenario $scenario->{id} executable projection has wrong input\n"
        if $fields{input} ne $scenario->{concrete_input};
    die "scenario $scenario->{id} executable projection has wrong result\n"
        if $fields{result} ne $scenario->{result_projection};
    die "scenario $scenario->{id} executable projection has wrong post-state\n"
        if $fields{post} ne $scenario->{required_post_state};
    die "scenario $scenario->{id} executable projection has wrong output provenance\n"
        if $fields{output} ne $scenario->{output_provenance};
    die "scenario $scenario->{id} executable projection has wrong diagnostic precedence\n"
        if $fields{diagnostic} ne $scenario->{diagnostic_precedence};
    if ($scenario->{historical_kind} eq "helper") {
        die "scenario $scenario->{id} helper projection omits caller or helper\n"
            if !exists $fields{caller} || !exists $fields{helper};
    } elsif ($scenario->{historical_kind} eq "stdout") {
        die "scenario $scenario->{id} stdout projection omits stdout_line\n"
            if !exists $fields{stdout_line}
                || $fields{stdout_line} !~ /^[0-9]+$/;
    } elsif ($scenario->{historical_kind} eq "output_table") {
        die "scenario $scenario->{id} output projection omits output_table\n"
            if !exists $fields{output_table} || $fields{output_table} eq "";
    }
}

sub validate_generated_projection_evidence {
    my ($source) = @_;
    die "generated projection evidence omits row checks\n"
        if $source !~ /\brequire_retirement_projection_row\(/;
    die "generated projection evidence omits row chunk tests\n"
        if $source !~ /\btest retirement_projection_rows_0001_0100\(\) -> Result<\(\), String>/;
    die "generated projection evidence still emits digest-only chunk checks\n"
        if $source =~ /\bexpected_retirement_projection_chunk_sha_/
            || $source =~ /\brequire_retirement_projection_chunk\(/;
    die "generated projection evidence still emits old recipe functions\n"
        if $source =~ /\bfn expected_retirement_projection_recipe_[0-9]{4}\(\) -> String/;
    die "generated projection evidence still emits old per-row SHA functions\n"
        if $source =~ /\bfn expected_retirement_projection_sha_[0-9]{4}\(\) -> String/;
    die "generated projection evidence lets row calls provide their own expected SHA literal\n"
        if $source =~ /require_retirement_projection_row\("[^"]+",\s*"[0-9a-f]{64}",\s*"[0-9a-f]{64}"\)\?/;
    die "generated projection evidence lets manifest calls provide their own expected SHA literal\n"
        if $source =~ /require_retirement_projection_manifest\("[^"]+",\s*[0-9]+,\s*"[0-9a-f]{64}",\s*"[0-9a-f]{64}"\)\?/;
    die "generated projection evidence omits row dimension arguments\n"
        if $source !~ /require_retirement_projection_row\("[^"]+",\s*"[^"]+",\s*"[^"]+",\s*"[^"]+",\s*"[^"]+",\s*"[^"]+",\s*"[^"]+",\s*"[^"]+",\s*"[^"]+",\s*"[^"]+",\s*"[^"]+",\s*"[^"]+",\s*"[^"]+",\s*"[^"]+",\s*"[0-9a-f]{64}",\s*"[0-9a-f]{64}"\)\?/;
}

sub projection_unescape {
    my ($value) = @_;
    $value =~ s/%7c/|/g;
    $value =~ s/%25/%/g;
    return $value;
}

sub assert_file_equals {
    my ($path, $expected) = @_;
    open my $handle, "<", $path or die "missing generated evidence $path: $!\n";
    local $/;
    my $actual = <$handle>;
    close $handle or die "cannot close $path: $!\n";
    die "generated evidence $path is stale; run scripts/check-http2-retirement-evidence --regenerate-structured\n"
        if $actual ne $expected;
}

sub write_file {
    my ($path, $content) = @_;
    open my $handle, ">", $path or die "cannot write $path: $!\n";
    print {$handle} $content;
    close $handle or die "cannot close $path: $!\n";
}

sub evidence_assertion {
    my ($reference) = @_;
    my ($path, $needle) = split /#/, $reference, 2;
    open my $handle, "<", $path or die "missing evidence file $path: $!\n";
    local $/;
    my $source = <$handle>;
    close $handle or die "cannot close $path: $!\n";

    if ($needle =~ /^test ([A-Za-z0-9_]+)\($/) {
        my $name = $1;
        my ($body) = $source =~ /(^test \Q$name\E\(.*?)(?=^test |\z)/ms;
        die "missing executable evidence $needle in $path\n" if !defined $body;
        validate_veln_test($path, $needle, $body, $source);
        if (
            $path eq
                "crates/veln-stdlib/veln/http2/retirement_output_evidence_test.veln"
        ) {
            validate_retirement_output_implementation($source);
            return $source;
        }
        return $body;
    }

    my $case_source = $source;
    if ($path =~ m{/main\.veln$}) {
        my $case_path = $path;
        $case_path =~ s{/main\.veln$}{/case.toml};
        open my $case_handle, "<", $case_path
            or die "missing executable case for $path: $!\n";
        local $/;
        $case_source = <$case_handle>;
        close $case_handle or die "cannot close $case_path: $!\n";
    }
    my $assertion = checked_case_assertion($case_source, $needle);
    die "missing checked case assertion $needle in $path\n"
        if !defined $assertion;
    return $path =~ m{/main\.veln$} ? "$source\0$assertion" : $assertion;
}

sub validate_retirement_output_implementation {
    my ($source) = @_;
    die "retirement output evidence nests historical chunks inside DATA frames\n"
        if $source =~ /send_data\([^\n]*,\s*expected,\s*false\)/
            || $source =~ /byte_view\(\s*emitted,\s*byte_offset\(9\)/;
    die "retirement output evidence does not reconstruct complete frame sequences\n"
        if $source !~ /\bhttp2::frame::decode\b/
            || $source !~ /\bhttp2::frame::encode_header\b/;
    die "retirement output evidence does not cross the production HPACK decoder\n"
        if $source !~ /\bhttp2::hpack::decode_header_block\b/;
    die "retirement output evidence decodes retained HPACK rows with only a fresh table\n"
        if $source !~ /\bretired_hpack_initial_table\(name\)\?/;
    die "retirement output evidence does not obtain exact HPACK bytes from public production encoders\n"
        if $source !~ /\bvalidate_retired_hpack_exact_reencode\b/
            || $source !~ /\bhttp2::hpack::decode_indexed_header_field\b/
            || $source !~ /\bhttp2::hpack::encode_indexed_header_field\b/
            || $source !~ /\bhttp2::hpack::decode_literal_header_field\b/
            || $source !~ /\bhttp2::hpack::encode_literal_header_field\b/
            || $source !~ /\bhttp2::hpack::decode_table_size_update\b/
            || $source !~ /\bhttp2::hpack::encode_integer\b/;
    die "retirement output evidence does not compare exact production HPACK bytes with historical bytes\n"
        if $source !~ /\bvalidate_retired_hpack_encoded_segment\b/
            || $source !~ /\bchunks_equal\(encoded,\s*retained\)\?/;
    die "retirement output evidence still allows canonical-equivalent HPACK encodings\n"
        if $source =~ /\bretired_hpack_canonical_equivalent_encoding_allowed\b/;
    die "retirement output evidence still uses a generic HPACK canonical mismatch fallback\n"
        if $source =~ /\bretired_hpack_canonical_mismatch_allowed\b.*?\belse\s+Ok\(true\)/s;
    die "retirement output evidence accepts any production HPACK encoded byte count\n"
        if $source =~ /byte_count_to_int\(byte_chunk_count\(encoded_input\)\)\s*>=\s*0/;
    die "retirement output evidence retains the old HPACK exact-match allowlist\n"
        if $source =~ /\bexpected_retired_hpack_exact_encode_match\b/;
    die "retirement output evidence accepts failed HPACK decoding by input identity\n"
        if $source =~ /Err\([^)]*\)\s*=>\s*if chunks_equal/;
    die "retirement output evidence accepts any non-empty HPACK failure kind\n"
        if $source =~ /header_block_failure_kind\([^)]*\)\s*!=\s*""/;
    die "retirement empty-output evidence does not preserve send-domain failures\n"
        if $source !~ /assert_retired_empty_output_table\(name: String, kind: Int\)/
            || $source !~ /assert_retired_empty_data_output_table\(name: String\)/
            || $source !~ /assert_retired_empty_headers_output_table\(name: String\)/
            || $source !~ /assert_retired_empty_push_promise_output_table\(name: String\)/
            || $source !~ /assert_retired_empty_window_update_output_table\(name: String\)/
            || $source !~ /assert_retired_empty_priority_output_table\(name: String\)/
            || $source !~ /assert_retired_empty_goaway_output_table\(name: String\)/
            || $source !~ /assert_retired_empty_ping_output_table\(name: String\)/
            || $source !~ /assert_retired_empty_settings_output_table\(name: String\)/
            || $source =~ /\bhttp2::core::validate_frame_payload_length\b/;
    die "retirement empty-output evidence does not bind retained table names to failure families\n"
        if $source !~ /retired_empty_data_item\(name: String\)/
            || $source !~ /retired_empty_data_content_length_item\(expected: Int, observed: Int, data: ByteChunk, end_stream: Bool, next_observed: Int\)/
            || $source !~ /retired_empty_data_flow_item\(send_credit: Int, data: ByteChunk, end_stream: Bool, observed_value: Int\)/
            || $source !~ /expected_retired_empty_headers_family\(name: String\)/
            || $source !~ /retired_empty_headers_state\(name: String\)/
            || $source !~ /expected_retired_empty_headers_failure_id\(name: String\)/
            || $source !~ /assert_retired_empty_headers_hpack_table_size_update_over_peer_limit\(name: String\)/
            || $source !~ /expected_retired_empty_push_promise_family\(name: String\)/
            || $source !~ /retired_empty_push_promise_item\(name: String\)/
            || $source !~ /expected_retired_empty_push_promise_failure_id\(name: String\)/
            || $source !~ /expected_retired_empty_window_update_family\(name: String\)/
            || $source !~ /expected_retired_empty_priority_family\(name: String\)/
            || $source !~ /expected_retired_empty_goaway_family\(name: String\)/
            || $source !~ /expected_retired_empty_ping_family\(name: String\)/
            || $source !~ /retired_empty_settings_items\(name: String\)/
            || $source !~ /expected_retired_empty_settings_failure\(name: String\)/
            || $source !~ /retired_empty_settings_failure_matches\(name: String, failure: LocalSettingsFailure\)/
            || $source !~ /expected_retired_empty_window_update_failure_id\(name: String\)/
            || $source !~ /expected_retired_empty_priority_failure_id\(name: String\)/
            || $source !~ /\bhttp2::core::(?:data_send_failure|headers_send_failure|push_promise_send_failure|window_update_send_failure|priority_send_failure|goaway_send_failure|ping_request_failure)\b/
            || $source !~ /\bhttp2::core::(?:send_local_settings_batch|local_settings_send_failure|local_settings_failure_id|local_settings_failure_setting_identifier|local_settings_failure_observed_value|output_buffer_append_local_settings)\b/
            || $source !~ /\bhttp2::core::(?:respond_to_ping|ping_response_status|output_buffer_append_ping_response)\b/
            || $source !~ /http2-ping-ack-received.*?ping-ack-received/s
            || $source !~ /\bhttp2::core::(?:outbound_data_flow_failure_id|outbound_headers_failure_id|outbound_stream_control_failure_id|goaway_send_failure_id|frame_payload_length_failure_active_state)\b/;
    die "retirement SETTINGS ACK cleared evidence starts from a fresh empty ACK state"
        if $source !~ /fn assert_retired_empty_settings_ack_cleared_output_table\(name: String\).*?settings_ack_after_peer_frame/s
            || $source =~ /fn assert_retired_empty_settings_ack_cleared_output_table\(name: String\).*?record_local_settings_batch/s
            || $source !~ /fn assert_retired_empty_settings_ack_cleared_output_table\(name: String\).*?send_pending_settings_ack\(pending\).*?send_pending_settings_ack\(cleared\)/s
            || $source !~ /fn assert_retired_empty_settings_ack_cleared_output_table\(name: String\).*?outstanding_settings_identifier\(http2::core::settings_ack_outstanding\(pending\)\) == 0/s
            || $source !~ /fn assert_retired_empty_settings_ack_cleared_output_table\(name: String\).*?outstanding_settings_batch_count\(http2::core::settings_ack_outstanding\(pending\)\) == 0/s
            || $source !~ /fn assert_retired_empty_settings_ack_cleared_output_table\(name: String\).*?pending_settings_ack_label\(http2::core::settings_ack_pending_peer_ack\(pending\)\) == "active"/s
            || $source !~ /fn assert_retired_empty_settings_ack_cleared_output_table\(name: String\).*?outstanding_settings_identifier\(http2::core::settings_ack_outstanding\(cleared\)\) == 0/s
            || $source !~ /fn assert_retired_empty_settings_ack_cleared_output_table\(name: String\).*?outstanding_settings_batch_count\(http2::core::settings_ack_outstanding\(cleared\)\) == 0/s
            || $source !~ /fn assert_retired_empty_settings_ack_cleared_output_table\(name: String\).*?pending_settings_ack_label\(http2::core::settings_ack_pending_peer_ack\(cleared\)\) == "none"/s
            || $source !~ /fn assert_retired_empty_settings_ack_cleared_output_table\(name: String\).*?pending_settings_ack_send_status\(no_pending\) == "no_pending"/s;
    die "retirement empty-output evidence accepts generic data, window, or priority failure ids"
        if $source =~ /outbound_data_flow_failure_id\(failure\)\s*!=\s*""/
            || $source =~ /outbound_stream_control_failure_id\(failure\)\s*!=\s*""/;
    die "retirement DATA empty-output evidence still groups rows by broad family"
        if $source =~ /expected_retired_empty_data_family\(name: String\)/
            || $source =~ /retired_empty_data_stream_entry\(family: String\)/
            || $source =~ /expected_retired_empty_data_failure_id\(family: String\)/;
    die "retirement DATA GOAWAY empty-output evidence does not preserve row boundaries"
        if $source !~ /http2-data-after-goaway-late.*?retired_empty_data_goaway_item\(7,\s*5,\s*11\)/s
            || $source !~ /http2-data-after-local-goaway-late.*?retired_empty_data_goaway_item\(7,\s*5,\s*11\)/s
            || $source !~ /http2-data-after-narrow-local-goaway-late.*?retired_empty_data_goaway_item\(5,\s*3,\s*22\)/s
            || $source !~ /outbound_data_flow_failure_last_stream_id\(failure\)\s*==\s*item\.last_stream_id/s
            || $source !~ /outbound_data_flow_failure_endpoint_role\(failure\)\s*==\s*item\.endpoint_role/s
            || $source !~ /retired_empty_data_content_length_item\(4,\s*4,\s*byte_chunk_from_hex\("aa"\)\?,\s*false,\s*5\)/s
            || $source !~ /retired_empty_data_content_length_item\(4,\s*1,\s*byte_chunk_from_hex\("bb"\)\?,\s*true,\s*2\)/s;
    die "retirement empty-output evidence keeps local SETTINGS failures generic"
        if $source =~ /assert_retired_empty_settings_output_table\(name: String\).*?\bsend_local_setting\(/s;
    die "retirement empty-output evidence omits retained local SETTINGS batch items"
        if $source !~ /http2-local-settings-large-batch-range.*?local_settings_header_table_size\(4096\).*?local_settings_enable_push\(2\).*?local_settings_max_header_list_size\(8192\)/s
            || $source !~ /http2-local-settings-max-concurrent-streams-batch-range.*?local_settings_header_table_size\(4096\).*?local_settings_max_concurrent_streams\(4294967296\).*?retained_valid_local_enable_push\(\)/s
            || $source !~ /http2-local-settings-max-header-list-size-batch-range.*?local_settings_header_table_size\(4096\).*?local_settings_max_concurrent_streams\(100\).*?local_settings_max_header_list_size\(4294967296\)/s;
    die "retirement empty-output evidence keeps HEADERS or PUSH_PROMISE failures generic"
        if $source =~ /assert_retired_empty_headers_output_table\(name: String\).*?outbound_headers_failure_id\(failure\)\s*==\s*"http2\.protocol\.stream_after_goaway"/s
            || $source =~ /assert_retired_empty_push_promise_output_table\(name: String\).*?outbound_headers_failure_id\(failure\)\s*==\s*"http2\.protocol\.invalid_stream_id"/s;
    die "retirement HPACK table-size empty-output evidence still uses outbound header-list limits"
        if $source !~ /http2-headers-hpack-table-size-update-over-peer-limit.*?send_response_headers/s
            || $source !~ /http2-headers-hpack-table-size-update-over-peer-limit.*?0000020104000000013f02.*?apply_receive_frame/s
            || $source !~ /http2-headers-hpack-table-size-update-over-peer-limit.*?chunks_equal\(outbound_prefix,\s*byte_chunk_from_hex\("3f01"\)\?\)\?/s
            || $source !~ /http2-headers-hpack-table-size-update-over-peer-limit.*?receive_frame_failure_preview\(failure\),\s*byte_chunk_from_hex\("3f02"\)\?/s
            || $source !~ /table_size_update_failure_capacity\(update_failure\)\s*==\s*33/
            || $source !~ /table_size_update_failure_peer_maximum\(update_failure\)\s*==\s*32/
            || $source =~ /http2-headers-hpack-table-size-update-over-peer-limit.*?retired_empty_headers_limited_state/s;
    die "retirement zero-length evidence does not obtain failure output from its send domain\n"
        if $source !~ /assert_retired_zero_length_output_table\(name: String\)/
            || $source !~ /\bhttp2::core::send_window_update\b/
            || $source !~ /\bhttp2::core::send_request_headers\b/
            || $source !~ /\bhttp2::core::output_buffer_append_(?:window_update|headers)\b/
            || $source !~ /http2-headers-after-narrow-local-goaway-late/
            || $source !~ /connection_lifecycle_draining\(3,\s*22\)/
            || $source !~ /send_request_headers\(state,\s*34,\s*5/
            || $source !~ /outbound_headers_failure_stream_id\(failure\)\s*==\s*5/s
            || $source !~ /outbound_headers_failure_active_state\(failure\)\s*==\s*"draining"/s
            || $source !~ /outbound_headers_failure_rule_provenance\(failure\)\s*==\s*"goaway_last_stream_id"/s;
    die "retirement WINDOW_UPDATE GOAWAY empty-output evidence does not preserve row boundaries"
        if $source !~ /http2-window-update-after-goaway-late.*?expected_retired_empty_window_update_family/s
            || $source !~ /http2-window-update-after-local-goaway-late.*?expected_retired_empty_window_update_family/s
            || $source !~ /retired_empty_window_update_goaway_item\(7,\s*5,\s*11\)/s
            || $source !~ /outbound_data_flow_failure_last_stream_id\(failure\)\s*==\s*item\.last_stream_id/s
            || $source !~ /outbound_data_flow_failure_endpoint_role\(failure\)\s*==\s*item\.endpoint_role/s;
    die "retirement GOAWAY empty-output evidence does not preserve the widened boundary failure\n"
        if $source !~ /assert_retired_empty_goaway_output_table\(name: String\).*?connection_lifecycle_closed\(5,\s*13\).*?send_goaway_shutdown\(closed,\s*17,\s*7,\s*22/s
            || $source !~ /goaway_send_failure_stream_id\(failure\)\s*==\s*7/s
            || $source !~ /goaway_send_failure_last_stream_id\(failure\)\s*==\s*5/s
            || $source !~ /goaway_send_failure_shutdown_state\(failure\)\s*==\s*"closed"/s
            || $source !~ /goaway_send_failure_endpoint_role\(failure\)\s*==\s*"server"/s
            || $source !~ /goaway_send_failure_reason\(failure\)\s*==\s*"boundary_increased"/s;
    die "retirement PUSH_PROMISE or PRIORITY GOAWAY evidence still shares one boundary state\n"
        if $source !~ /http2-push-promise-after-goaway-late.*?connection_lifecycle_draining\(5,\s*11\).*?stream_id:\s*7/s
            || $source !~ /http2-push-promise-after-local-goaway-late.*?connection_lifecycle_draining\(5,\s*11\).*?stream_id:\s*7/s
            || $source !~ /http2-push-promise-after-narrow-local-goaway-late.*?connection_lifecycle_draining\(3,\s*22\).*?stream_id:\s*5/s
            || $source !~ /let stream_id: Int = if name == "http2-priority-after-narrow-local-goaway-late" 5 else 7 end/
            || $source !~ /let last_stream_id: Int = if name == "http2-priority-after-narrow-local-goaway-late" 3 else 5 end/
            || $source !~ /outbound_stream_control_failure_stream_id\(failure\)\s*==\s*stream_id/s
            || $source !~ /outbound_stream_control_failure_last_stream_id\(failure\)\s*==\s*last_stream_id/s;
}

sub validate_veln_test {
    my ($path, $needle, $body, $source) = @_;
    die "evidence test $needle in $path does not call the public HTTP/2 boundary\n"
        if !exercises_public_http2_boundary($body, $source);
    die "evidence test $needle in $path has no checked success and failure branches\n"
        if !has_checked_branches($body, $source);
}

sub exercises_public_http2_boundary {
    my ($body, $source) = @_;
    my @pending = ($body);
    my %visited;
    while (@pending) {
        my $current = shift @pending;
        return 1 if $current =~ /\bhttp2::(?:core|frame|hpack)::[A-Za-z0-9_]+\b/;
        for my $callee ($current =~ /\b([A-Za-z_][A-Za-z0-9_]*)\s*\(/g) {
            next if $visited{$callee}++;
            my ($helper) =
                $source =~ /(^fn \Q$callee\E\(.*?)(?=^(?:pub )?fn |^test |\z)/ms;
            push @pending, $helper if defined $helper;
        }
    }
    return 0;
}

sub has_checked_branches {
    my ($body, $source) = @_;
    my @pending = ($body);
    my %visited;
    while (@pending) {
        my $current = shift @pending;
        return 1
            if $current =~ /\b(?:if|match)\b/
                && $current =~ /\bOk\(\(\)\)/
                && $current =~ /\bErr\(/;
        for my $callee ($current =~ /\b([A-Za-z_][A-Za-z0-9_]*)\s*\(/g) {
            next if $visited{$callee}++;
            my ($helper) =
                $source =~ /(^fn \Q$callee\E\(.*?)(?=^(?:pub )?fn |^test |\z)/ms;
            push @pending, $helper if defined $helper;
        }
    }
    return 0;
}

sub checked_case_assertion {
    my ($source, $needle) = @_;
    while (
        $source =~
        /(?:equals|contains) = ((?:"(?:\\.|[^"])*")|(?:\[[^\n]*\]))(?:\n|\z)/g
    ) {
        my $encoded = $1;
        my $decoded = eval { decode_json($encoded) };
        next if !defined $decoded || $@;
        my @values = ref($decoded) eq "ARRAY" ? @$decoded : ($decoded);
        return "$encoded\n"
            if grep { !ref($_) && index($_, $needle) >= 0 } @values;
    }
    return;
}

sub validate_item_binding {
    my ($key, $historical_value, $manifest_row, $assertion) = @_;
    die "retirement evidence for $key still targets unsupported HPACK fixture compatibility\n"
        if defined $manifest_row->{evidence}
            && $manifest_row->{evidence} =~ /hpack\.fixture\.unsupported_header_block/;
    die "retirement evidence for $key still uses unsupported HPACK fixture compatibility as current evidence\n"
        if $assertion =~ /hpack\.fixture\.unsupported_header_block/;
    die "historical value mismatch for $key\n"
        if $manifest_row->{value} ne $historical_value;
    die "retained assertion changed for $key\n"
        if sha256_hex($assertion) ne $manifest_row->{assertion_hash};
    die "historical value and retained assertion binding changed for $key\n"
        if sha256_hex("$historical_value\0$assertion") ne $manifest_row->{binding_hash};
}

sub validate_evidence_relevance {
    my ($row, $assertion, $manifest_row) = @_;
    if ($row->{kind} eq "output_table") {
        my ($name, $encoded_chunks) = split /\t/, $row->{value}, 2;
        my $chunks = eval { decode_json("[$encoded_chunks]") };
        die "invalid historical output table $row->{key}\n"
            if !defined $chunks || $@ || ref($chunks) ne "ARRAY";
        die "historical output table $row->{key} has an unsupported chunk count\n"
            if @$chunks > 1;
        if (
            defined $manifest_row
                && $manifest_row->{evidence} =~
                    m{^crates/veln-stdlib/veln/http2/retirement_output_evidence_test\.veln#}
        ) {
            my $call;
            if (@$chunks == 0) {
                my $kind = output_table_frame_kind($name);
                $call = qq{assert_retired_empty_output_table("$name", $kind)?};
            } elsif ($chunks->[0] eq "") {
                $call = qq{assert_retired_zero_length_output_table("$name")?};
            } elsif ($name =~ /hpack-.*huffman-long-length$/) {
                $call =
                    qq{assert_retired_hpack_long_length_output_table("$name", byte_chunk_from_hex("$chunks->[0]")?)?};
            } else {
                $call =
                    qq{assert_retired_output_table("$name", byte_chunk_from_hex("$chunks->[0]")?)?};
            }
            my $call_count = () = $assertion =~ /\Q$call\E/g;
            die "evidence for $row->{key} does not independently assert its exact output table\n"
                if $call_count != 1;
        } else {
            my $identifier = lc($name);
            $identifier =~ s/[^a-z0-9_]+/_/g;
            my $normalized_assertion = lc($assertion);
            $normalized_assertion =~ s/[^a-z0-9_]+/_/g;
            die "evidence for $row->{key} does not identify output table $name\n"
                if index($normalized_assertion, $identifier) < 0;
            for my $chunk (@$chunks) {
                next if $chunk eq "";
                die "evidence for $row->{key} does not compare historical chunk $chunk\n"
                    if index(lc($assertion), lc($chunk)) < 0;
            }
        }
        return;
    }

    if (
        $row->{kind} eq "stdout"
            && $row->{value} =~
                /^output_chunk(?:_list)? ([^ ]+)(?: .* hex "([0-9a-f]*)")?/
    ) {
        my ($name, $chunk) = ($1, $2);
        my $identifier = lc($name);
        $identifier =~ s/[^a-z0-9_]+/_/g;
        my $normalized_assertion = lc($assertion);
        $normalized_assertion =~ s/[^a-z0-9_]+/_/g;
        die "evidence for $row->{key} does not identify output table $name\n"
            if index($normalized_assertion, $identifier) < 0;
        die "evidence for $row->{key} does not compare historical chunk $chunk\n"
            if defined $chunk && $chunk ne "" && index(lc($assertion), $chunk) < 0;
        return;
    }

    if ($row->{kind} eq "stdout") {
        validate_stdout_projection_relevance($row, $assertion);
        return;
    }

    if ($row->{key} =~ /^main\.veln:103([567]):require_connection_stream_id$/) {
        my %frame_evidence = (
            5 => qr/\bapply_receive_frame\b.*\bbyte_chunk_from_hex\("00000c040000000000/s,
            6 => qr/\bsend_ping\b.*\bbyte_chunk_from_hex\("000008060000000000/s,
            7 => qr/\bapply_receive_frame\b.*\bbyte_chunk_from_hex\("000008070000000000/s,
        );
        my $kind = $1;
        die "evidence for $row->{key} does not exercise its connection-frame domain\n"
            if $assertion !~ $frame_evidence{$kind};
        return;
    }

    my ($caller, $helper) = split /\t/, $row->{value}, 3;
    if ($helper eq "require_outbound_push_promise_state_preserved") {
        validate_outbound_push_promise_state_relevance($row, $assertion);
        return;
    }
    validate_helper_literal_relevance($row, $assertion);
    my $domain = helper_evidence_domain($caller, $helper);
    die "evidence for $row->{key} does not exercise its $domain->{label} domain\n"
        if $assertion !~ $domain->{pattern};
}

sub validate_helper_literal_relevance {
    my ($row, $assertion) = @_;
    my (undef, $helper, $line) = split /\t/, $row->{value}, 3;
    return if $helper ne "require_outbound_push_promise_failure";
    my %required;
    while ($line =~ /"([^"]+)"/g) {
        my $literal = $1;
        next
            if $literal !~
                /^(?:http2\.protocol\.(?:peer_stream_id_not_increasing|invalid_stream_id|stream_after_goaway)|http2\.peer_limit\.(?:frame_size_exceeded|header_list_size_exceeded))$/;
        $required{$literal} = 1;
    }
    for my $literal (sort keys %required) {
        die "evidence for $row->{key} omits retained helper literal $literal\n"
            if index($assertion, $literal) < 0;
    }
}

sub validate_outbound_push_promise_state_relevance {
    my ($row, $assertion) = @_;
    die "evidence for $row->{key} does not exercise outbound PUSH_PROMISE send state\n"
        if $assertion !~ /\bsend_push_promise\b/
            || $assertion !~ /\bpush_promise_send_bytes\b/
            || $assertion !~ /\bconnection_state_hpack_table_entry_count\b/;

    my (undef, undef, $line) = split /\t/, $row->{value}, 3;
    my @required;
    if ($line =~ /\brepeated\)/) {
        @required = (
            qr/\brepeated_failure\b/,
            qr/http2\.protocol\.peer_stream_id_not_increasing/,
        );
    } elsif ($line =~ /\blower\)/) {
        @required = (
            qr/\blower_failure\b/,
            qr/rfc9113_outbound_promised_stream_ids_increase/,
        );
    } elsif ($line =~ /\blower_after_close\)/) {
        @required = (
            qr/\blower_after_close_failure\b/,
            qr/\bstream_closed_lifecycle\b/,
            qr/\"closed\"/,
        );
    } elsif ($line =~ /\blower_after_reset\)/) {
        @required = (
            qr/\blower_after_reset_failure\b/,
            qr/\bstream_reset_lifecycle\b/,
            qr/\"reset\"/,
        );
    } elsif ($line =~ /\bdisabled_failure\)/) {
        @required = (
            qr/\bdisabled_failure\b/,
            qr/settings_enable_push/,
        );
    } elsif ($line =~ /\bgoaway_failure\)/) {
        @required = (
            qr/\bgoaway_failure\b/,
            qr/goaway_last_stream_id/,
        );
    } elsif ($line =~ /\bframe_size_failure\)/) {
        @required = (
            qr/\bsize_failure\b/,
            qr/rfc9113_max_frame_size/,
        );
    } elsif ($line =~ /\bhpack_repeated\)/) {
        @required = (
            qr/\brepeated_failure\b/,
            qr/\bconnection_state_hpack_table_entry_count\b/,
            qr/http2\.protocol\.peer_stream_id_not_increasing/,
        );
    } elsif ($line =~ /\babove_limit\)/) {
        @required = (
            qr/\bheader_list_failure\b/,
            qr/http2\.peer_limit\.header_list_size_exceeded/,
        );
    } else {
        die "unclassified outbound PUSH_PROMISE state evidence for $row->{key}\n";
    }

    for my $pattern (@required) {
        die "evidence for $row->{key} omits its outbound PUSH_PROMISE branch projection\n"
            if $assertion !~ $pattern;
    }
}

sub helper_evidence_domain {
    my ($caller, $helper) = @_;
    my $identity = "$caller $helper";

    return {
        label => "accepted outbound HEADERS transition",
        pattern => qr/\bheaders_send_status\([^;\n]*\)\s*==\s*"accepted"/,
    } if $helper eq "require_outbound_headers_connection_accepted";
    return {
        label => "rejected outbound HEADERS transition",
        pattern => qr/\boutbound_headers_failure_id\b/,
    } if $helper eq "require_outbound_headers_connection_failure";
    return {
        label => "failure-atomic outbound HEADERS state preservation",
        pattern => qr/\b(?:headers_send_bytes|stream_collection_count|connection_state_(?:streams|next_offset)|stream_entry_)/,
    } if $helper eq "require_outbound_headers_connection_state_preserved";
    return {
        label => "accepted outbound PUSH_PROMISE transition",
        pattern => qr/\bpush_promise_send_status\([^;\n]*\)\s*==\s*"accepted"/,
    } if $helper eq "require_outbound_push_promise_accepted";
    return {
        label => "rejected outbound PUSH_PROMISE transition",
        pattern => qr/\boutbound_headers_failure_id\b/,
    } if $helper eq "require_outbound_push_promise_failure";
    return {
        label => "failure-atomic outbound PUSH_PROMISE state preservation",
        pattern => qr/\btest outbound_push_promise_failures_preserve_ordering_state_and_output\(\)(?=.*?\bsend_push_promise\b)(?=.*?\bpush_promise_send_bytes\b)(?=.*?\bpeer_settings_highest_peer_created_stream_id\b)(?=.*?\bstream_closed_lifecycle\b)(?=.*?\blower_after_close\b)(?=.*?\bstream_reset_lifecycle\b)(?=.*?\blower_after_reset\b)(?=.*?\bconnection_state_hpack_table_entry_count\b)(?=.*?\bhttp2\.peer_limit\.header_list_size_exceeded\b)/s,
    } if $helper eq "require_outbound_push_promise_state_preserved";

    return {
        label => "PUSH_PROMISE with production HPACK",
        pattern => qr/\b(?:push_promise|send_push_promise)/i,
    } if $helper =~ /outbound_push_promise/;
    return {
        label => "HEADERS with production HPACK",
        pattern => qr/\b(?:headers|send_request_headers|send_response_headers|send_trailers)/i,
    } if $helper =~ /outbound_headers/;
    return {
        label => "outbound production HPACK",
        pattern => qr/\b(?:http2::hpack::|send_request_headers|send_response_headers|send_trailers|send_push_promise)/i,
    } if $helper =~ /outbound_hpack/;
    return {
        label => "production outbound header octets",
        pattern => qr/\b(?:http2::hpack::|send_request_headers|send_response_headers|send_trailers|send_push_promise)/i,
    } if $caller =~ /production_outbound/;
    return {
        label => "HPACK codec",
        pattern => qr/\bhttp2::hpack::/,
    } if $identity =~ /hpack/i;
    return {
        label => "aggregate connection-state preservation",
        pattern => qr/\b(?:connection_state|stream_collection|flow_control|content_length|priority|shutdown|http2::hpack::)/i,
    } if $caller eq "require_peer_stream_failure_preserves_connection_state";
    return {
        label => "HEADERS padding",
        pattern => qr/\b(?:headers|frame_payload)/i,
    } if $caller eq "require_headers_padding_rejection_preserves_state";
    return {
        label => "initial peer SETTINGS",
        pattern => qr/\b(?:initial_peer_settings|settings)/i,
    } if $caller =~ /initial_peer_settings/i;
    return {
        label => "PUSH_PROMISE",
        pattern => qr/\b(?:push_promise|reserved_by_peer|promised_stream)/i,
    } if $identity =~ /push|promised/i;
    return {
        label => "SETTINGS",
        pattern => qr/\b(?:settings|initial_peer_settings|peer_settings)/i,
    } if $identity =~ /settings/i;
    return {
        label => "outbound DATA and flow-control",
        pattern => qr/\b(?:send_data|data_send|flow_control|send_credit|window_update|initial_window|peer_settings)/i,
    } if $identity =~ /(?:outbound_data|outbound_credit|initial_window|flow_control)/i;
    return {
        label => "header-list and HEADERS",
        pattern => qr/\b(?:header_list|headers|receive_frame|send_request_headers|send_response_headers|send_trailers)/i,
    } if $identity =~ /(?:header|response|request|informational|no_content|head_|extended_connect)/i;
    return {
        label => "stream-id and peer-stream",
        pattern => qr/\b(?:stream_id|stream_collection|peer_stream|stream_admission|receive_frame)/i,
    } if $identity =~ /(?:stream_id|peer_stream|client_stream|server_stream|closed_peer)/i;
    return {
        label => "production receive-frame",
        pattern => qr/\b(?:receive_frame|receive_connection|frame_payload|frame_decode)/i,
    } if $identity =~ /(?:frame_decoded|production_inbound|production_route|production_update)/i;
    return {
        label => "outbound stream lifecycle",
        pattern => qr/\b(?:send_|stream_collection|stream_lifecycle|receive_frame)/i,
    } if $caller =~ /outbound_local_stream/i;
    return {
        label => "GOAWAY and shutdown",
        pattern => qr/\b(?:goaway|shutdown|connection_lifecycle|receive_frame)/i,
    } if $identity =~ /(?:goaway|shutdown)/i;
    return {
        label => "PING",
        pattern => qr/\b(?:ping|receive_frame)/i,
    } if $identity =~ /ping/i;
    return {
        label => "PRIORITY",
        pattern => qr/\b(?:priority|receive_frame)/i,
    } if $identity =~ /priority/i;
    return {
        label => "WINDOW_UPDATE and flow-control",
        pattern => qr/\b(?:window_update|flow_control|receive_frame)/i,
    } if $identity =~ /(?:window_update|window)/i;
    return {
        label => "DATA and content-length",
        pattern => qr/\b(?:data|content_length|flow_control|receive_frame)/i,
    } if $identity =~ /(?:data|content_length)/i;
    return {
        label => "connection receive",
        pattern => qr/\b(?:receive_frame|receive_connection|preface|pending_header_block|frame_payload)/i,
    } if $identity =~ /(?:preface|continuation|closed|failure_with_id)/i;

    die "unclassified helper relevance for $caller/$helper\n";
}

sub output_table_frame_kind {
    my ($name) = @_;
    return 0 if $name =~ /(?:data|content-length)/;
    return 1 if $name =~ /(?:headers|trailers)/;
    return 2 if $name =~ /priority/;
    return 3 if $name =~ /rst-stream/;
    return 5 if $name =~ /push-promise/;
    return 6 if $name =~ /ping/;
    return 7 if $name =~ /^http2-goaway-widen/;
    return 8 if $name =~ /window-update/;
    return 4 if $name =~ /(?:settings|local-)/;
    die "unclassified empty output table $name\n";
}

sub validate_stdout_projection_relevance {
    my ($row, $assertion) = @_;
    my $value = $row->{value};

    if (
        $value =~
            /hpack decoded :fixture continuation wire_size 9 next_decode_count 1$/
    ) {
        die "evidence for $row->{key} does not exercise the retained continuation projection\n"
            if $assertion !~ /\bCONTINUATION\b/
                || $assertion !~ /\bnine-octet\b/
                || $assertion !~ /stream_collection_count\([^;\n]*\) == 1/;
    }

    if ($value =~ /\b(http2\.[a-z0-9_.]+)\b/ && $value !~ /^outbound-ping-/) {
        my $diagnostic_id = $1;
        die "evidence for $row->{key} does not compare diagnostic id $diagnostic_id\n"
            if index($assertion, $diagnostic_id) < 0;
    }

    my ($projection) = $value =~ /^[^ ]+ ([^ ]+)/;
    return if !defined $projection;
    return if $projection eq "id";

    my @domains;
    if ($projection eq "result") {
        if ($value =~ /\bkind 4\b/) {
            @domains = (qr/\b(?:receive_(?:frame|connection)|peer_settings|settings_ack)/);
        } elsif ($value =~ /\bkind 6\b/) {
            @domains = (qr/\b(?:receive_(?:frame|connection)|ping)/);
        } elsif ($value =~ /\bkind 7\b/) {
            @domains = (qr/\b(?:receive_(?:frame|connection)|goaway|shutdown)/);
        } elsif ($value =~ /\bkind 8\b/) {
            @domains = (qr/\b(?:receive_(?:frame|connection)|window_update|flow_control)/);
        } elsif ($value =~ /\bkind 5\b/) {
            @domains = (qr/\b(?:receive_(?:frame|connection)|push_promise)/);
        } elsif ($value =~ /\bkind [013]\b/) {
            @domains = (qr/\b(?:receive_(?:frame|connection)|stream_collection|data|headers|rst_stream)/);
        } elsif ($value =~ /\bkind 2\b/) {
            @domains = (qr/\b(?:receive_(?:frame|connection)|priority)/);
        } else {
            @domains = (qr/\b(?:receive_(?:frame|connection)|frame_decode|pending_header_block)/);
        }
    } elsif ($projection =~ /^outbound-hpack-encode(?:-state)?$/) {
        @domains = (qr/\bhttp2::hpack::encode_header_block\b/);
    } elsif ($projection eq "outbound-hpack-table-size-update") {
        @domains = (qr/\bhttp2::hpack::encode_header_block\b/);
    } elsif ($projection eq "outbound-headers") {
        @domains = (qr/\b(?:send_(?:request_headers|response_headers|trailers)|headers_send_)/);
    } elsif ($projection eq "outbound-push-promise") {
        @domains = (qr/\b(?:send_push_promise|push_promise_send_)/);
    } elsif ($projection eq "outbound-data") {
        @domains = (qr/\b(?:send_data|data_send_)/);
    } elsif ($projection eq "outbound-window-update") {
        @domains = (qr/\b(?:send_window_update|window_update_send_)/);
    } elsif ($projection eq "outbound-settings") {
        @domains = (qr/\b(?:send_local_setting|local_settings_send_)/);
    } elsif ($projection eq "outbound-settings-ack") {
        @domains = (qr/\b(?:send_pending_settings_ack|settings_ack)/);
    } elsif ($projection =~ /^outbound-ping(?:-ack)?$/) {
        @domains = (qr/\b(?:send_ping|respond_to_ping|ping)/);
    } elsif ($projection eq "outbound-goaway") {
        @domains = (qr/\b(?:send_goaway_shutdown|goaway_send_)/);
    } elsif ($projection eq "outbound-rst-stream") {
        @domains = (qr/\b(?:send_rst_stream|rst_stream_)/);
    } elsif ($projection eq "outbound-priority") {
        @domains = (qr/\b(?:send_priority|priority_)/);
    } elsif ($projection =~ /^(?:hpack|hpack_state|hpack_static)$/) {
        @domains = (qr/\b(?:http2::hpack::|receive_frame)/);
    } elsif (
        $projection =~
            /^(?:peer_max_frame_size|local_settings|peer_settings_ack)$/
    ) {
        @domains = (qr/\b(?:peer_settings|local_settings|settings_ack)/);
    } elsif (
        $projection =~
            /^(?:outbound-send-credit|content_length_expected)$/
    ) {
        @domains = (qr/\b(?:flow_control|send_credit|window_update|content_length)/);
    } elsif ($projection eq "shutdown") {
        @domains = (qr/\b(?:shutdown|connection_lifecycle|goaway)/);
    } elsif (
        $projection =~
            /^(?:inbound_entry|open_stream|open_stream_count|closed_by_peer_stream|half_closed_local_stream)$/
    ) {
        @domains = (qr/(?:stream_collection|stream_lifecycle|receive_frame|send_)/);
    } elsif (
        $projection =~
            /^(?:highest_peer_stream_id|highest_peer_created_stream_id|reserved_by_peer)$/
    ) {
        @domains = (qr/\b(?:peer_stream|stream_admission|push_promise|receive_frame)/);
    } elsif (
        $projection =~ /^(?:priority_state|first_priority|second_priority|third_priority)$/
    ) {
        @domains = (qr/\b(?:priority|receive_frame)/);
    } elsif ($projection eq "connection_window") {
        @domains = (qr/(?:flow_control|connection_credit|send_data|receive_frame|initial_window|peer_settings)/);
    } elsif ($projection eq "debug_data") {
        @domains = (qr/\b(?:goaway|shutdown|receive_frame)/);
    } elsif ($projection eq "encode_error") {
        @domains = (qr/(?:encode|send_)/);
    }

    die "unclassified stdout projection $projection for $row->{key}\n"
        if !@domains;
    for my $domain (@domains) {
        die "evidence for $row->{key} does not exercise stdout projection $projection\n"
            if $assertion !~ $domain;
    }
}

sub run_self_test {
    my $good =
        "test evidence() -> Result<(), String>\n"
        . "\tif http2::core::output_buffer_count(http2::core::empty_output_buffer()) == 0\n"
        . "\t\tOk(())\n\telse\n\t\tErr(\"unexpected output\")\n\tend\nend\n";
    validate_veln_test("<self-test>", "test evidence(", $good, $good);

    my $unrelated = "test unrelated() -> Result<(), String>\n\tOk(())\nend\n";
    my $accepted = eval {
        validate_veln_test("<self-test>", "test unrelated(", $unrelated, $unrelated);
        1;
    };
    die "self-test accepted an unrelated Veln test\n" if $accepted;

    my $assertion = checked_case_assertion(
        "[[json_assert]]\npath = \"stdout\"\nequals = \"projected value\\n\"\n",
        "projected value",
    );
    die "self-test rejected an exact case assertion\n" if !defined $assertion;
    die "self-test accepted a needle outside a case assertion\n"
        if defined checked_case_assertion(
            "# unrelated needle\n[[json_assert]]\npath = \"status\"\nequals = \"passed\"\n",
            "unrelated needle",
        );

    my $historical_value = "output_chunk sample index 0 hex \"83\" count 1";
    my $manifest_row = {
        value => $historical_value,
        assertion_hash => sha256_hex($good),
        binding_hash => sha256_hex("$historical_value\0$good"),
    };
    validate_item_binding("<self-test>", $historical_value, $manifest_row, $good);
    my $changed_value_accepted = eval {
        validate_item_binding("<self-test>", "$historical_value changed", $manifest_row, $good);
        1;
    };
    die "self-test accepted a changed historical value\n" if $changed_value_accepted;
    my $changed_assertion_accepted = eval {
        validate_item_binding("<self-test>", $historical_value, $manifest_row, "$good\n");
        1;
    };
    die "self-test accepted an unrelated retained assertion\n"
        if $changed_assertion_accepted;

    my $exact_output = {
        kind => "output_table",
        key => "case.toml:output_chunk_list:sample",
        value => "sample\t\"83\"",
    };
    my $retirement_output_manifest = {
        evidence =>
            "crates/veln-stdlib/veln/http2/retirement_output_evidence_test.veln#test sample(",
    };
    my $unrelated_output_accepted = eval {
        validate_evidence_relevance(
            $exact_output,
            $good,
            $retirement_output_manifest,
        );
        1;
    };
    die "self-test accepted output evidence without the historical chunk\n"
        if $unrelated_output_accepted;
    validate_evidence_relevance(
        $exact_output,
        $good
            . "\tassert_retired_output_table(\"sample\", "
            . "byte_chunk_from_hex(\"83\")?)?\n",
        $retirement_output_manifest,
    );
    my $projection_scenario = {
        id => "http2-retirement-self-test",
        historical_key => "case.toml:output_chunk_list:sample",
        historical_kind => "output_table",
        evidence =>
            "crates/veln-stdlib/veln/http2/retirement_output_evidence_test.veln#test sample(",
        owning_operation => "send_headers",
        operation_branch => "exact-output-success",
        initial_state => "role=local;lifecycle=open;output=caller-owned",
        ordered_setup => "create-connection-state>create-output-buffer",
        concrete_input =>
            "operation=send_headers;table=sample;chunk-count=1;chunk-octets=1",
        result_projection => "row-0001:output_chunk_list:sample",
        required_post_state => "emitted-bytes-exact",
        output_provenance => "public-core-send",
        diagnostic_precedence => "not-applicable",
    };
    $projection_scenario->{executable_projection} = executable_projection(
        $exact_output,
        $retirement_output_manifest,
        {
            owning_operation => $projection_scenario->{owning_operation},
            operation_branch => $projection_scenario->{operation_branch},
            initial_state => $projection_scenario->{initial_state},
            ordered_setup => $projection_scenario->{ordered_setup},
            concrete_input => $projection_scenario->{concrete_input},
            required_post_state => $projection_scenario->{required_post_state},
        },
        $projection_scenario->{result_projection},
        $projection_scenario->{output_provenance},
        $projection_scenario->{diagnostic_precedence},
    );
    validate_executable_projection($projection_scenario);
    my %hash_only_projection = %$projection_scenario;
    $hash_only_projection{executable_projection} =
        "assertion-sha256:" . sha256_hex($good) . ";output-table=sample";
    my $hash_only_projection_accepted = eval {
        validate_executable_projection(\%hash_only_projection);
        1;
    };
    die "self-test accepted hash-only executable projection\n"
        if $hash_only_projection_accepted;
    my %wrong_invoke_projection = %$projection_scenario;
    $wrong_invoke_projection{executable_projection} =~
        s/invoke=send_headers/invoke=receive_frame/;
    my $wrong_invoke_projection_accepted = eval {
        validate_executable_projection(\%wrong_invoke_projection);
        1;
    };
    die "self-test accepted executable projection with substituted invoke\n"
        if $wrong_invoke_projection_accepted;
    my $chunk_projection_source =
        "test retirement_projection_rows_0001_0100() -> Result<(), String>\n"
        . "\trequire_retirement_projection_row(\"http2-retirement-0001\", \"case.toml:output_chunk_list:sample\", \"evidence#test\", \"local\", \"send_headers\", \"exact-output-success\", \"role=local;lifecycle=open\", \"create-connection-state\", \"operation=send_headers\", \"row-0001:output_chunk_list:sample\", \"public-core-send\", \"not-applicable\", \"not-applicable\", \"emitted-bytes-exact\", \"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\", \"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\")?\n"
        . "\tOk(())\nend\n";
    validate_generated_projection_evidence($chunk_projection_source);
    my $digest_projection_source =
        $chunk_projection_source
        . "fn expected_retirement_projection_chunk_sha_0001_0100() -> String\nend\n"
        . "test retirement_projection_manifest_chunk_0001_0100() -> Result<(), String>\n"
        . "\trequire_retirement_projection_chunk(\"chunk\", 1, 100, 100, \"a\", expected_retirement_projection_chunk_sha_0001_0100())?\n"
        . "\tOk(())\nend\n";
    my $digest_projection_accepted = eval {
        validate_generated_projection_evidence($digest_projection_source);
        1;
    };
    die "self-test accepted digest-only generated projection evidence\n"
        if $digest_projection_accepted;
    my $missing_dimensions_source =
        $chunk_projection_source;
    $missing_dimensions_source =~
        s/"role=local;lifecycle=open", "create-connection-state", "operation=send_headers", //;
    my $missing_dimensions_accepted = eval {
        validate_generated_projection_evidence($missing_dimensions_source);
        1;
    };
    die "self-test accepted row evidence without dimension arguments\n"
        if $missing_dimensions_accepted;
    my $nested_data_implementation =
        "fn assert_retired_output_table(name: String, expected: ByteChunk)\n"
        . "\thttp2::core::send_data(state, 0, 1, expected, false)\n"
        . "end\n";
    my $nested_data_accepted = eval {
        validate_retirement_output_implementation($nested_data_implementation);
        1;
    };
    die "self-test accepted historical chunks nested inside DATA frames\n"
        if $nested_data_accepted;
    my $identity_hpack_implementation =
        "http2::frame::decode(input)\n"
        . "http2::frame::encode_header(length, kind, flags, stream_id)\n"
        . "http2::hpack::decode_header_block(input, table, 4096)\n"
        . "http2::hpack::encode_header_block(headers, table, 4096)\n"
        . "chunks_equal(encoded_input, expected)?\n"
        . "match decoded\n"
        . "\tErr(_) => if chunks_equal(input, expected)\n"
        . "\t\tOk(())\n"
        . "\tend\n"
        . "fn assert_retired_empty_output_table(name: String, kind: Int)\n"
        . "\thttp2::core::validate_frame_payload_length(0, kind, 0, 1, 0, name, byte_chunk([]))\n"
        . "end\n";
    my $identity_hpack_accepted = eval {
        validate_retirement_output_implementation($identity_hpack_implementation);
        1;
    };
    die "self-test accepted input-identity fallback for failed HPACK decoding\n"
        if $identity_hpack_accepted;
    my $non_empty_hpack_failure_implementation =
        "http2::frame::decode(input)\n"
        . "http2::frame::encode_header(length, kind, flags, stream_id)\n"
        . "http2::hpack::decode_header_block(input, table, 4096)\n"
        . "http2::hpack::encode_header_block(headers, table, 4096)\n"
        . "match decoded\n"
        . "\tErr(failure) => if http2::hpack::header_block_failure_kind(failure) != \"\"\n"
        . "\t\tOk(())\n"
        . "\tend\n"
        . "fn assert_retired_empty_output_table(name: String, kind: Int)\n"
        . "\thttp2::core::validate_frame_payload_length(0, kind, 0, 1, 0, name, byte_chunk([]))\n"
        . "end\n"
        . "fn assert_retired_zero_length_output_table(name: String)\n"
        . "\thttp2::core::send_window_update(state, 0, 1, 1)\n"
        . "\thttp2::core::send_request_headers(state, 0, 1, headers, false)\n"
        . "\thttp2::core::output_buffer_append_window_update(output, decision)\n"
        . "end\n";
    my $non_empty_hpack_failure_accepted = eval {
        validate_retirement_output_implementation($non_empty_hpack_failure_implementation);
        1;
    };
    die "self-test accepted generic non-empty HPACK failure evidence\n"
        if $non_empty_hpack_failure_accepted;
    my $hpack_count_only_implementation =
        "http2::frame::decode(input)\n"
        . "http2::frame::encode_header(length, kind, flags, stream_id)\n"
        . "http2::hpack::decode_header_block(input, table, 4096)\n"
        . "http2::hpack::encode_header_block(headers, table, 4096)\n"
        . "http2::hpack::header_block_encode_bytes(encoded)\n"
        . "byte_count_to_int(byte_chunk_count(encoded_input)) >= 0\n"
        . "fn expected_retired_empty_data_family(name: String)\nend\n"
        . "fn expected_retired_empty_headers_family(name: String)\nend\n"
        . "fn expected_retired_empty_push_promise_family(name: String)\nend\n"
        . "fn expected_retired_empty_window_update_family(name: String)\nend\n"
        . "fn expected_retired_empty_priority_family(name: String)\nend\n"
        . "fn expected_retired_empty_goaway_family(name: String)\nend\n"
        . "fn expected_retired_empty_ping_family(name: String)\nend\n"
        . "fn retired_empty_settings_item(name: String)\nend\n"
        . "fn expected_retired_empty_data_failure_id(family: String)\nend\n"
        . "fn expected_retired_empty_window_update_failure_id(name: String)\nend\n"
        . "fn expected_retired_empty_priority_failure_id(name: String)\nend\n"
        . "http2::core::data_send_failure(decision)\n"
        . "http2::core::headers_send_failure(decision)\n"
        . "http2::core::push_promise_send_failure(decision)\n"
        . "http2::core::window_update_send_failure(decision)\n"
        . "http2::core::priority_send_failure(decision)\n"
        . "http2::core::goaway_send_failure(decision)\n"
        . "http2::core::ping_request_failure(decision)\n"
        . "http2::core::outbound_data_flow_failure_id(failure) == expected\n"
        . "http2::core::outbound_stream_control_failure_id(failure) == expected\n"
        . "http2::core::goaway_send_failure_id(failure)\n"
        . "http2::core::frame_payload_length_failure_active_state(failure)\n"
        . "fn assert_retired_empty_output_table(name: String, kind: Int)\nend\n"
        . "fn assert_retired_empty_data_output_table(name: String)\nend\n"
        . "fn assert_retired_empty_headers_output_table(name: String)\nend\n"
        . "fn assert_retired_empty_push_promise_output_table(name: String)\nend\n"
        . "fn assert_retired_empty_window_update_output_table(name: String)\nend\n"
        . "fn assert_retired_empty_priority_output_table(name: String)\nend\n"
        . "fn assert_retired_empty_goaway_output_table(name: String)\nend\n"
        . "fn assert_retired_empty_ping_output_table(name: String)\nend\n"
        . "fn assert_retired_empty_settings_output_table(name: String)\nend\n"
        . "fn assert_retired_zero_length_output_table(name: String)\n"
        . "\thttp2::core::send_window_update(state, 0, 1, 1)\n"
        . "\thttp2::core::send_request_headers(state, 0, 1, headers, false)\n"
        . "\thttp2::core::output_buffer_append_window_update(output, decision)\n"
        . "\thttp2::core::output_buffer_append_headers(output, decision)\n"
        . "end\n";
    my $hpack_count_only_accepted = eval {
        validate_retirement_output_implementation($hpack_count_only_implementation);
        1;
    };
    die "self-test accepted count-only production HPACK encode evidence\n"
        if $hpack_count_only_accepted;
    my $canonical_equivalent_implementation =
        "http2::frame::decode(input)\n"
        . "http2::frame::encode_header(length, kind, flags, stream_id)\n"
        . "http2::hpack::decode_header_block(input, table, 4096)\n"
        . "http2::hpack::encode_header_block(headers, table, 4096)\n"
        . "http2::hpack::header_block_encode_bytes(encoded)\n"
        . "chunks_equal(encoded_input, expected)?\n"
        . "retired_hpack_canonical_equivalent_encoding_allowed(name)?\n"
        . "fn expected_retired_empty_data_family(name: String)\nend\n"
        . "fn expected_retired_empty_headers_family(name: String)\nend\n"
        . "fn expected_retired_empty_push_promise_family(name: String)\nend\n"
        . "fn expected_retired_empty_window_update_family(name: String)\nend\n"
        . "fn expected_retired_empty_priority_family(name: String)\nend\n"
        . "fn expected_retired_empty_goaway_family(name: String)\nend\n"
        . "fn expected_retired_empty_ping_family(name: String)\nend\n"
        . "fn retired_empty_settings_item(name: String)\nend\n"
        . "fn expected_retired_empty_data_failure_id(family: String)\nend\n"
        . "fn expected_retired_empty_window_update_failure_id(name: String)\nend\n"
        . "fn expected_retired_empty_priority_failure_id(name: String)\nend\n"
        . "http2::core::data_send_failure(decision)\n"
        . "http2::core::headers_send_failure(decision)\n"
        . "http2::core::push_promise_send_failure(decision)\n"
        . "http2::core::window_update_send_failure(decision)\n"
        . "http2::core::priority_send_failure(decision)\n"
        . "http2::core::goaway_send_failure(decision)\n"
        . "http2::core::ping_request_failure(decision)\n"
        . "http2::core::outbound_data_flow_failure_id(failure) == expected\n"
        . "http2::core::outbound_stream_control_failure_id(failure) == expected\n"
        . "http2::core::goaway_send_failure_id(failure)\n"
        . "http2::core::frame_payload_length_failure_active_state(failure)\n"
        . "fn assert_retired_empty_output_table(name: String, kind: Int)\nend\n"
        . "fn assert_retired_empty_data_output_table(name: String)\nend\n"
        . "fn assert_retired_empty_headers_output_table(name: String)\nend\n"
        . "fn assert_retired_empty_push_promise_output_table(name: String)\nend\n"
        . "fn assert_retired_empty_window_update_output_table(name: String)\nend\n"
        . "fn assert_retired_empty_priority_output_table(name: String)\nend\n"
        . "fn assert_retired_empty_goaway_output_table(name: String)\nend\n"
        . "fn assert_retired_empty_ping_output_table(name: String)\nend\n"
        . "fn assert_retired_empty_settings_output_table(name: String)\nend\n"
        . "fn assert_retired_zero_length_output_table(name: String)\n"
        . "\thttp2::core::send_window_update(state, 0, 1, 1)\n"
        . "\thttp2::core::send_request_headers(state, 0, 1, headers, false)\n"
        . "\thttp2::core::output_buffer_append_window_update(output, decision)\n"
        . "\thttp2::core::output_buffer_append_headers(output, decision)\n"
        . "end\n";
    my $canonical_equivalent_accepted = eval {
        validate_retirement_output_implementation($canonical_equivalent_implementation);
        1;
    };
    die "self-test accepted canonical-equivalent HPACK encode evidence\n"
        if $canonical_equivalent_accepted;
    open my $retirement_source_handle, "<",
        "crates/veln-stdlib/veln/http2/retirement_output_evidence_test.veln"
        or die "cannot read retirement output evidence for self-test: $!\n";
    local $/;
    my $retirement_source = <$retirement_source_handle>;
    close $retirement_source_handle
        or die "cannot close retirement output evidence for self-test: $!\n";
    my $unrelated_ack_batch_source = $retirement_source;
    $unrelated_ack_batch_source =~
        s/settings_ack_after_peer_frame\(http2::core::empty_settings_ack_state\(\), 4, 0, 6\)/settings_ack_after_peer_frame(http2::core::record_local_settings_batch(http2::core::empty_settings_ack_state(), 17, 1), 4, 0, 6)/;
    my $unrelated_ack_batch_accepted = eval {
        validate_retirement_output_implementation($unrelated_ack_batch_source);
        1;
    };
    die "self-test accepted unrelated SETTINGS ACK cleared local batch\n"
        if $unrelated_ack_batch_accepted;
    my $generic_zero_length_headers_source = $retirement_source;
    $generic_zero_length_headers_source =~
        s/send_request_headers\(state, 34, 5, headers, false\)/send_request_headers(state, 0, 1, headers, false)/;
    my $generic_zero_length_headers_accepted = eval {
        validate_retirement_output_implementation($generic_zero_length_headers_source);
        1;
    };
    die "self-test accepted generic zero-length HEADERS GOAWAY evidence\n"
        if $generic_zero_length_headers_accepted;
    my $generic_goaway_widen_source = $retirement_source;
    $generic_goaway_widen_source =~
        s/send_goaway_shutdown\(closed, 17, 7, 22/send_goaway_shutdown(closed, 0, 5, 0/;
    my $generic_goaway_widen_accepted = eval {
        validate_retirement_output_implementation($generic_goaway_widen_source);
        1;
    };
    die "self-test accepted substituted GOAWAY widen output evidence\n"
        if $generic_goaway_widen_accepted;
    my $generic_push_promise_goaway_source = $retirement_source;
    $generic_push_promise_goaway_source =~
        s/connection_lifecycle_draining\(3, 22\)\), stream_id: 5/connection_lifecycle_draining(5, 11)), stream_id: 7/;
    my $generic_push_promise_goaway_accepted = eval {
        validate_retirement_output_implementation($generic_push_promise_goaway_source);
        1;
    };
    die "self-test accepted shared PUSH_PROMISE GOAWAY boundary evidence\n"
        if $generic_push_promise_goaway_accepted;
    my $generic_priority_goaway_source = $retirement_source;
    $generic_priority_goaway_source =~
        s/let last_stream_id: Int = if name == "http2-priority-after-narrow-local-goaway-late" 3 else 5 end/let last_stream_id: Int = 5/;
    my $generic_priority_goaway_accepted = eval {
        validate_retirement_output_implementation($generic_priority_goaway_source);
        1;
    };
    die "self-test accepted shared PRIORITY GOAWAY boundary evidence\n"
        if $generic_priority_goaway_accepted;
    my $generic_data_goaway_source = $retirement_source;
    $generic_data_goaway_source =~
        s/retired_empty_data_goaway_item\(5, 3, 22\)/retired_empty_data_goaway_item(7, 5, 11)/;
    my $generic_data_goaway_accepted = eval {
        validate_retirement_output_implementation($generic_data_goaway_source);
        1;
    };
    die "self-test accepted shared DATA GOAWAY boundary evidence\n"
        if $generic_data_goaway_accepted;
    my $generic_window_goaway_source = $retirement_source;
    $generic_window_goaway_source =~
        s/retired_empty_window_update_goaway_item\(7, 5, 11\)/retired_empty_window_update_overflow_item(name)/;
    my $generic_window_goaway_accepted = eval {
        validate_retirement_output_implementation($generic_window_goaway_source);
        1;
    };
    die "self-test accepted substituted WINDOW_UPDATE GOAWAY boundary evidence\n"
        if $generic_window_goaway_accepted;
    my $shortened_settings_batch_source = $retirement_source;
    $shortened_settings_batch_source =~
        s/local_settings_header_table_size\(4096\), Cons\(http2::core::local_settings_enable_push\(2\), Cons\(http2::core::local_settings_max_header_list_size\(8192\), Nil\)\)/retained_valid_local_max_frame_size(), Cons(http2::core::local_settings_enable_push(2), Nil)/;
    my $shortened_settings_batch_accepted = eval {
        validate_retirement_output_implementation($shortened_settings_batch_source);
        1;
    };
    die "self-test accepted shortened retained local SETTINGS batch evidence\n"
        if $shortened_settings_batch_accepted;
    my $generic_canonical_mismatch_implementation =
        $canonical_equivalent_implementation;
    $generic_canonical_mismatch_implementation =~
        s/retired_hpack_canonical_equivalent_encoding_allowed\(name\)\?/
            "fn retired_hpack_canonical_mismatch_allowed(name: String) -> Result<Bool, String>\\n"
            . "\\tif name == \\\"one-row\\\"\\n\\t\\tOk(true)\\n"
            . "\\telse\\n\\t\\tOk(true)\\n\\tend\\nend\\n"/e;
    my $generic_canonical_mismatch_accepted = eval {
        validate_retirement_output_implementation($generic_canonical_mismatch_implementation);
        1;
    };
    die "self-test accepted generic HPACK canonical mismatch fallback\n"
        if $generic_canonical_mismatch_accepted;
    my $empty_output = {
        kind => "output_table",
        key => "case.toml:output_chunk_list:data-no-output",
        value => "data-no-output\t",
    };
    my $named_only_empty_accepted = eval {
        validate_evidence_relevance(
            $empty_output,
            "$good\n# data-no-output\nhttp2::core::empty_output_buffer()\n",
            $retirement_output_manifest,
        );
        1;
    };
    die "self-test accepted an empty output table without an empty-output assertion\n"
        if $named_only_empty_accepted;
    validate_evidence_relevance(
        $empty_output,
        "$good\n\tassert_retired_empty_output_table(\"data-no-output\", 0)?\n",
        $retirement_output_manifest,
    );

    my $settings_helper = {
        kind => "helper",
        key => "main.veln:1035:require_connection_stream_id",
        value => "validate_stream_id_domain\trequire_connection_stream_id\t"
            . "\t\t4 => require_connection_stream_id(offset, kind, stream_id)",
    };
    my $unrelated_domain_accepted = eval {
        validate_evidence_relevance(
            $settings_helper,
            "$good\nhttp2::core::apply_receive_frame(state, settings)\n",
        );
        1;
    };
    die "self-test accepted same-domain SETTINGS evidence without the retained connection stream id\n"
        if $unrelated_domain_accepted;
    validate_evidence_relevance(
        $settings_helper,
        "$good\nhttp2::core::apply_receive_frame(state, "
            . "byte_chunk_from_hex(\"00000c040000000000aaaa12345678000500008000\")?)\n",
    );

    my $outbound_headers_failure = {
        kind => "helper",
        key => "main.veln:13417:require_outbound_headers_connection_failure",
        value => "verify_outbound_local_stream_role_and_domain_cases\t"
            . "require_outbound_headers_connection_failure\t"
            . "\tlet ignored_server_new: () = "
            . "require_outbound_headers_connection_failure("
            . "\"server endpoint started a regular local stream\", server_new, "
            . "\"http2.protocol.invalid_frame_kind\")?",
