    die "self-test accepted outbound HEADERS success evidence for a failure helper\n"
        if $accepted_headers_substitution;
    validate_evidence_relevance(
        $outbound_headers_failure,
        "$good\nif http2::core::outbound_headers_failure_id(failure) == "
            . "\"http2.protocol.invalid_frame_kind\"\n",
