    my $outbound_push_failure = {
        kind => "helper",
        key => "main.veln:13712:require_outbound_push_promise_failure",
        value => "verify_outbound_push_promise_ordering_cases\t"
            . "require_outbound_push_promise_failure\t"
            . "\tlet ignored_repeated: () = "
            . "require_outbound_push_promise_failure("
            . "\"repeated outbound promised stream id was accepted\", "
            . "repeated, \"http2.protocol.peer_stream_id_not_increasing\")?",
