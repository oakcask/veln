        if $unrelated_hpack_projection_accepted;
    validate_evidence_relevance(
        $hpack_encode_projection,
        "$good\nhttp2::hpack::encode_header_block(headers, state)\n",
    );

    my $inbound_entry_projection = {
        kind => "stdout",
