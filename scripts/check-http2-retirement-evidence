    die "self-test accepted helper evidence without the retained diagnostic id\n"
        if $missing_push_literal;
    validate_evidence_relevance(
        $outbound_push_failure,
        "$good\nhttp2::core::send_push_promise(state, 29, 1, 4, headers)\n"
            . "if http2::core::outbound_headers_failure_id(failure) == "
            . "\"http2.protocol.peer_stream_id_not_increasing\"\n",
    );

    my $outbound_push_state = {
        kind => "helper",
        key => "main.veln:13755:require_outbound_push_promise_state_preserved",
        value => "verify_outbound_push_promise_ordering_cases\t"
            . "require_outbound_push_promise_state_preserved\t"
            . "\tlet ignored_repeated_state: () = "
            . "require_outbound_push_promise_state_preserved("
            . "\"repeated outbound promised stream id changed connection state\", "
            . "increasing_state, outbound_push_promise_connection_state(repeated))?",
    };
    my $inbound_push_substitution_accepted = eval {
        validate_evidence_relevance(
            $outbound_push_state,
            "$good\nhttp2::core::receive_frame_state(push_promise)\n"
                . "http2::core::receive_frame_applied_transition(push_promise)\n",
        );
        1;
    };
    die "self-test accepted inbound PUSH_PROMISE evidence for outbound state preservation\n"
        if $inbound_push_substitution_accepted;
    validate_evidence_relevance(
        $outbound_push_state,
        "$good\n"
            . "test outbound_push_promise_failures_preserve_ordering_state_and_output() -> Result<(), String>\n"
            . "\tlet decision: CorePushPromiseSendDecision = http2::core::send_push_promise(state, 29, 1, 4, headers)\n"
            . "\tlet repeated_failure: CoreOutboundHeadersFailure = require_push_promise_send_failure(decision)?\n"
            . "\tlet closed_state: CoreConnectionState = http2::core::connection_state_with_streams(state, http2::core::stream_collection_add_or_replace(streams, http2::core::stream_entry(4, http2::core::stream_closed_lifecycle(), 0, 0, 5, 0)))\n"
            . "\tlet lower_after_close: CorePushPromiseSendDecision = http2::core::send_push_promise(closed_state, 47, 1, 2, headers)\n"
            . "\tlet reset_state: CoreConnectionState = http2::core::connection_state_with_streams(state, http2::core::stream_collection_add_or_replace(streams, http2::core::stream_entry(4, http2::core::stream_reset_lifecycle(8), 0, 0, 5, 0)))\n"
            . "\tlet lower_after_reset: CorePushPromiseSendDecision = http2::core::send_push_promise(reset_state, 53, 1, 2, headers)\n"
            . "\tif byte_count_to_int(byte_chunk_count(http2::core::push_promise_send_bytes(decision))) == 0 and http2::core::outbound_headers_failure_id(repeated_failure) == \"http2.protocol.peer_stream_id_not_increasing\" and http2::core::peer_settings_highest_peer_created_stream_id(http2::core::connection_state_peer_settings(state)) == 4 and http2::core::connection_state_hpack_table_entry_count(state) == 1 and http2::core::outbound_headers_failure_id(header_list_failure) == \"http2.peer_limit.header_list_size_exceeded\"\n"
            . "\t\tOk(())\n\telse\n\t\tErr(\"unexpected\")\n\tend\nend\n",
    );

    my $continuation_projection = {
        kind => "stdout",
        key => "case.toml:stdout:17",
        value => "continuation-done hpack decoded :fixture continuation "
            . "wire_size 9 next_decode_count 1",
