sub expect_count {
    my ($counts, $kind, $expected) = @_;
    my $actual = $counts->{$kind} // 0;
    die "expected $expected $kind items, found $actual\n" if $actual != $expected;
}

sub git_show {
    my ($object) = @_;
    open my $handle, "-|", "git", "show", $object
        or die "cannot inspect historical object $object: $!\n";
    local $/;
    my $content = <$handle>;
    close $handle or die "git show failed for $object\n";
    return $content;
}
