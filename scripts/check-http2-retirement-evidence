    die "self-test accepted unrelated HPACK evidence for the continuation projection\n"
        if $unrelated_projection_accepted;
    validate_evidence_relevance(
        $continuation_projection,
        "$good\n# CONTINUATION nine-octet projection\n"
            . "if http2::core::stream_collection_count(streams) == 1\n"
            . "http2::hpack::decode_header_block(input, state)\n",
    );

    my $peer_settings_projection = {
        kind => "stdout",
        key => "case.toml:stdout:230",
