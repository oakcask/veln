#!/usr/bin/env perl

use strict;
use warnings;

use Digest::SHA qw(sha256_hex);
use JSON::PP qw(decode_json);

my $inventory = @ARGV == 1 && $ARGV[0] eq "--inventory";
die "usage: scripts/check-http2-retirement-evidence [--inventory]\n"
    if @ARGV > 1 || (@ARGV == 1 && !$inventory);

my $revision = "f91a4e42^";
my $fixture = "examples/specification/run/http2-protocol-core";
my $main = git_show("$revision:$fixture/main.veln");
my $manifest = git_show("$revision:$fixture/case.toml");

my %current_stdout;
my %current_tables;
for my $path (
    glob("examples/specification/check/*/case.toml"),
    glob("examples/specification/run/*/case.toml"),
) {
    next if !-f $path;
    open my $handle, "<", $path or die "cannot read $path: $!\n";
    local $/;
    my $source = <$handle>;
    close $handle or die "cannot close $path: $!\n";

    while ($source =~ /\npath = "stdout"\nequals = (".*?")\n\n/sg) {
        my $stdout = decode_json($1);
        for my $line (split /\n/, $stdout) {
            push @{$current_stdout{$line}}, $path;
        }
    }
    while ($source =~ /\[\[output_chunk_list\]\]\nname = "([^"]+)"\nchunks = \[([^\]]*)\]/g) {
        my $value = "$1\t$2";
        push @{$current_tables{$value}}, $path;
    }
}

my @rows;
inventory_helpers($main, \@rows);
inventory_stdout($manifest, \@rows);
inventory_output_tables($manifest, \@rows);

my %counts;
my %matched;
for my $row (@rows) {
    $counts{$row->{kind}}++;
    my @evidence = exact_evidence($row, \%current_stdout, \%current_tables);
    $matched{$row->{kind}}++ if @evidence;
    if ($inventory) {
        print join(
            "\t",
            $row->{kind},
            $row->{key},
            sha256_hex($row->{value}),
            @evidence ? join(",", @evidence) : "UNCLASSIFIED",
        ), "\n";
    }
}

expect_count(\%counts, "helper", 652);
expect_count(\%counts, "stdout", 2_044);
expect_count(\%counts, "output_table", 315);

my $missing = 0;
for my $kind (qw(helper stdout output_table)) {
    my $kind_matched = $matched{$kind} // 0;
    my $kind_missing = $counts{$kind} - $kind_matched;
    $missing += $kind_missing;
    print "http2 retirement evidence: $kind_matched / $counts{$kind} $kind items have exact retained evidence\n"
        if !$inventory;
}

if ($missing != 0) {
    print STDERR "http2 retirement evidence: $missing historical items remain unclassified\n"
        if !$inventory;
    exit 1 if !$inventory;
}

print "http2 retirement evidence: zero unclassified items\n" if !$inventory;

sub inventory_helpers {
    my ($source, $rows) = @_;
    my $caller = "<top-level>";
    my $line_number = 0;
    for my $line (split /\n/, $source, -1) {
        $line_number++;
        if ($line =~ /^(?:pub )?fn ([A-Za-z0-9_]+)/) {
            $caller = $1;
        }
        next if $line =~ /^(?:pub )?fn require_/;
        while ($line =~ /\b(require_[A-Za-z0-9_]+)\b/g) {
            push @$rows, {
                kind => "helper",
                key => "main.veln:$line_number:$1",
                value => "$caller\t$1\t$line",
            };
        }
    }
}

sub inventory_stdout {
    my ($source, $rows) = @_;
    my ($encoded) = $source =~ /\npath = "stdout"\nequals = (".*")\n\n/s;
    die "historical exact stdout assertion is missing\n" if !defined $encoded;
    my @lines = split /\n/, decode_json($encoded), -1;
    pop @lines if @lines && $lines[-1] eq "";
    for my $index (0 .. $#lines) {
        push @$rows, {
            kind => "stdout",
            key => "case.toml:stdout:" . ($index + 1),
            value => $lines[$index],
        };
    }
}

sub inventory_output_tables {
    my ($source, $rows) = @_;
    while ($source =~ /\[\[output_chunk_list\]\]\nname = "([^"]+)"\nchunks = \[([^\]]*)\]/g) {
        push @$rows, {
            kind => "output_table",
            key => "case.toml:output_chunk_list:$1",
            value => "$1\t$2",
        };
    }
}

sub exact_evidence {
    my ($row, $stdout, $tables) = @_;
    return @{$stdout->{$row->{value}} // []} if $row->{kind} eq "stdout";
    return @{$tables->{$row->{value}} // []} if $row->{kind} eq "output_table";

    # A helper invocation protects the values passed by its historical caller,
    # not merely the helper or caller name. It remains unclassified until a
    # checked item-level manifest can compare those values with executable
    # retained assertions.
    return;
}

sub expect_count {
    my ($counts, $kind, $expected) = @_;
    my $actual = $counts->{$kind} // 0;
    die "expected $expected $kind items, found $actual\n" if $actual != $expected;
}

sub git_show {
    my ($object) = @_;
    open my $handle, "-|", "git", "show", $object
        or die "cannot inspect historical object $object: $!\n";
    local $/;
    my $content = <$handle>;
    close $handle or die "git show failed for $object\n";
    return $content;
}
