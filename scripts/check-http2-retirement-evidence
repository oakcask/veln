#!/usr/bin/env perl

use strict;
use warnings;

use Digest::SHA qw(sha256_hex);
use JSON::PP qw(decode_json);
use MIME::Base64 qw(decode_base64 encode_base64);

my $inventory = @ARGV == 1 && $ARGV[0] eq "--inventory";
my $self_test = @ARGV == 1 && $ARGV[0] eq "--self-test";
die "usage: scripts/check-http2-retirement-evidence [--inventory|--self-test]\n"
    if @ARGV > 1 || (@ARGV == 1 && !$inventory && !$self_test);

if ($self_test) {
    run_self_test();
    exit 0;
}

my $revision = "f91a4e42^";
my $fixture = "examples/specification/run/http2-protocol-core";
my $evidence_manifest =
    "examples/specification/run/http2-protocol-core/retirement-evidence.tsv";
my $main = git_show("$revision:$fixture/main.veln");
my $manifest = git_show("$revision:$fixture/case.toml");

my @rows;
inventory_helpers($main, \@rows);
inventory_stdout($manifest, \@rows);
inventory_output_tables($manifest, \@rows);

my %evidence = read_evidence_manifest($evidence_manifest);
my %counts;
for my $row (@rows) {
    $counts{$row->{kind}}++;
    my $manifest_row = delete $evidence{$row->{key}};
    die "missing item-level evidence for $row->{key}\n" if !defined $manifest_row;
    die "evidence kind mismatch for $row->{key}\n"
        if $manifest_row->{kind} ne $row->{kind};
    my $assertion = evidence_assertion($manifest_row->{evidence});
    validate_item_binding($row->{key}, $row->{value}, $manifest_row, $assertion);
    if ($inventory) {
        print join(
            "\t",
            $row->{kind},
            $row->{key},
            encode_base64($row->{value}, ""),
            sha256_hex($assertion),
            sha256_hex("$row->{value}\0$assertion"),
            $manifest_row->{evidence},
        ), "\n";
    }
}

die "unexpected evidence item " . (sort keys %evidence)[0] . "\n" if %evidence;

expect_count(\%counts, "helper", 652);
expect_count(\%counts, "stdout", 2_044);
expect_count(\%counts, "output_table", 315);

if (!$inventory) {
    print "http2 retirement evidence: 652 helper invocations have checked item-level evidence\n";
    print "http2 retirement evidence: 2044 stdout lines have checked item-level evidence\n";
    print "http2 retirement evidence: 315 output tables have checked item-level evidence\n";
    print "http2 retirement evidence: zero unclassified items\n";
}

sub inventory_helpers {
    my ($source, $rows) = @_;
    my $caller = "<top-level>";
    my $line_number = 0;
    for my $line (split /\n/, $source, -1) {
        $line_number++;
        if ($line =~ /^(?:pub )?fn ([A-Za-z0-9_]+)/) {
            $caller = $1;
        }
        next if $line =~ /^(?:pub )?fn require_/;
        while ($line =~ /\b(require_[A-Za-z0-9_]+)\b/g) {
            push @$rows, {
                kind => "helper",
                key => "main.veln:$line_number:$1",
                value => "$caller\t$1\t$line",
            };
        }
    }
}

sub inventory_stdout {
    my ($source, $rows) = @_;
    my ($encoded) = $source =~ /\npath = "stdout"\nequals = (".*")\n\n/s;
    die "historical exact stdout assertion is missing\n" if !defined $encoded;
    my @lines = split /\n/, decode_json($encoded), -1;
    pop @lines if @lines && $lines[-1] eq "";
    for my $index (0 .. $#lines) {
        push @$rows, {
            kind => "stdout",
            key => "case.toml:stdout:" . ($index + 1),
            value => $lines[$index],
        };
    }
}

sub inventory_output_tables {
    my ($source, $rows) = @_;
    while ($source =~ /\[\[output_chunk_list\]\]\nname = "([^"]+)"\nchunks = \[([^\]]*)\]/g) {
        push @$rows, {
            kind => "output_table",
            key => "case.toml:output_chunk_list:$1",
            value => "$1\t$2",
        };
    }
}

sub read_evidence_manifest {
    my ($path) = @_;
    open my $handle, "<", $path or die "cannot read $path: $!\n";
    my %items;
    my $line_number = 0;
    while (my $line = <$handle>) {
        $line_number++;
        chomp $line;
        next if $line eq "" || $line =~ /^#/;
        my @fields = split /\t/, $line, -1;
        my ($kind, $key, $encoded_value, $assertion_hash, $binding_hash, $evidence, @extra) =
            @fields;
        die "invalid evidence row at $path:$line_number\n"
            if @extra || !defined $evidence || $kind !~ /^(?:helper|stdout|output_table)$/
                || $encoded_value !~ /^(?:[A-Za-z0-9+\/]{4})*(?:[A-Za-z0-9+\/]{2}==|[A-Za-z0-9+\/]{3}=)?$/
                || $assertion_hash !~ /^[0-9a-f]{64}$/
                || $binding_hash !~ /^[0-9a-f]{64}$/
                || $evidence !~ /^[^\t#]+#[^\t#]+$/;
        die "duplicate evidence key $key\n" if exists $items{$key};
        $items{$key} = {
            kind => $kind,
            value => decode_base64($encoded_value),
            assertion_hash => $assertion_hash,
            binding_hash => $binding_hash,
            evidence => $evidence,
        };
    }
    close $handle or die "cannot close $path: $!\n";
    return %items;
}

sub evidence_assertion {
    my ($reference) = @_;
    my ($path, $needle) = split /#/, $reference, 2;
    open my $handle, "<", $path or die "missing evidence file $path: $!\n";
    local $/;
    my $source = <$handle>;
    close $handle or die "cannot close $path: $!\n";

    if ($needle =~ /^test ([A-Za-z0-9_]+)\($/) {
        my $name = $1;
        my ($body) = $source =~ /(^test \Q$name\E\(.*?)(?=^test |\z)/ms;
        die "missing executable evidence $needle in $path\n" if !defined $body;
        validate_veln_test($path, $needle, $body, $source);
        return $body;
    }

    my $case_source = $source;
    if ($path =~ m{/main\.veln$}) {
        my $case_path = $path;
        $case_path =~ s{/main\.veln$}{/case.toml};
        open my $case_handle, "<", $case_path
            or die "missing executable case for $path: $!\n";
        local $/;
        $case_source = <$case_handle>;
        close $case_handle or die "cannot close $case_path: $!\n";
    }
    my $assertion = checked_case_assertion($case_source, $needle);
    die "missing checked case assertion $needle in $path\n"
        if !defined $assertion;
    return $path =~ m{/main\.veln$} ? "$source\0$assertion" : $assertion;
}

sub validate_veln_test {
    my ($path, $needle, $body, $source) = @_;
    die "evidence test $needle in $path does not call the public HTTP/2 boundary\n"
        if !exercises_public_http2_boundary($body, $source);
    die "evidence test $needle in $path has no checked success and failure branches\n"
        if $body !~ /\b(?:if|match)\b/ || $body !~ /\bOk\(\(\)\)/ || $body !~ /\bErr\(/;
}

sub exercises_public_http2_boundary {
    my ($body, $source) = @_;
    my @pending = ($body);
    my %visited;
    while (@pending) {
        my $current = shift @pending;
        return 1 if $current =~ /\bhttp2::(?:core|hpack)::[A-Za-z0-9_]+\b/;
        for my $callee ($current =~ /\b([A-Za-z_][A-Za-z0-9_]*)\s*\(/g) {
            next if $visited{$callee}++;
            my ($helper) =
                $source =~ /(^fn \Q$callee\E\(.*?)(?=^(?:pub )?fn |^test |\z)/ms;
            push @pending, $helper if defined $helper;
        }
    }
    return 0;
}

sub checked_case_assertion {
    my ($source, $needle) = @_;
    while (
        $source =~
        /(?:equals|contains) = ((?:"(?:\\.|[^"])*")|(?:\[[^\n]*\]))(?:\n|\z)/g
    ) {
        my $encoded = $1;
        my $decoded = eval { decode_json($encoded) };
        next if !defined $decoded || $@;
        my @values = ref($decoded) eq "ARRAY" ? @$decoded : ($decoded);
        return "$encoded\n"
            if grep { !ref($_) && index($_, $needle) >= 0 } @values;
    }
    return;
}

sub validate_item_binding {
    my ($key, $historical_value, $manifest_row, $assertion) = @_;
    die "historical value mismatch for $key\n"
        if $manifest_row->{value} ne $historical_value;
    die "retained assertion changed for $key\n"
        if sha256_hex($assertion) ne $manifest_row->{assertion_hash};
    die "historical value and retained assertion binding changed for $key\n"
        if sha256_hex("$historical_value\0$assertion") ne $manifest_row->{binding_hash};
}

sub run_self_test {
    my $good =
        "test evidence() -> Result<(), String>\n"
        . "\tif http2::core::output_buffer_count(http2::core::empty_output_buffer()) == 0\n"
        . "\t\tOk(())\n\telse\n\t\tErr(\"unexpected output\")\n\tend\nend\n";
    validate_veln_test("<self-test>", "test evidence(", $good, $good);

    my $unrelated = "test unrelated() -> Result<(), String>\n\tOk(())\nend\n";
    my $accepted = eval {
        validate_veln_test("<self-test>", "test unrelated(", $unrelated, $unrelated);
        1;
    };
    die "self-test accepted an unrelated Veln test\n" if $accepted;

    my $assertion = checked_case_assertion(
        "[[json_assert]]\npath = \"stdout\"\nequals = \"projected value\\n\"\n",
        "projected value",
    );
    die "self-test rejected an exact case assertion\n" if !defined $assertion;
    die "self-test accepted a needle outside a case assertion\n"
        if defined checked_case_assertion(
            "# unrelated needle\n[[json_assert]]\npath = \"status\"\nequals = \"passed\"\n",
            "unrelated needle",
        );

    my $historical_value = "output_chunk sample index 0 hex \"83\" count 1";
    my $manifest_row = {
        value => $historical_value,
        assertion_hash => sha256_hex($good),
        binding_hash => sha256_hex("$historical_value\0$good"),
    };
    validate_item_binding("<self-test>", $historical_value, $manifest_row, $good);
    my $changed_value_accepted = eval {
        validate_item_binding("<self-test>", "$historical_value changed", $manifest_row, $good);
        1;
    };
    die "self-test accepted a changed historical value\n" if $changed_value_accepted;
    my $changed_assertion_accepted = eval {
        validate_item_binding("<self-test>", $historical_value, $manifest_row, "$good\n");
        1;
    };
    die "self-test accepted an unrelated retained assertion\n"
        if $changed_assertion_accepted;
    print "http2 retirement evidence checker self-test: passed\n";
}

sub expect_count {
    my ($counts, $kind, $expected) = @_;
    my $actual = $counts->{$kind} // 0;
    die "expected $expected $kind items, found $actual\n" if $actual != $expected;
}

sub git_show {
    my ($object) = @_;
    open my $handle, "-|", "git", "show", $object
        or die "cannot inspect historical object $object: $!\n";
    local $/;
    my $content = <$handle>;
    close $handle or die "git show failed for $object\n";
    return $content;
}
