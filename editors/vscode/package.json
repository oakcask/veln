{
  "name": "veln-language",
  "displayName": "Veln Language",
  "description": "Veln language support.",
  "version": "0.1.0",
  "publisher": "veln",
  "main": "./extension.js",
  "files": [
    "extension.js",
    "language-configuration.json",
    "syntaxes/veln.tmLanguage.json"
  ],
  "scripts": {
    "test": "node --check extension.js && node --test extension.test.mjs",
    "vsix": "vsce package --no-dependencies --allow-missing-repository"
  },
  "extensionKind": [
    "workspace"
  ],
  "engines": {
    "vscode": "^1.90.0"
  },
  "activationEvents": [
    "onLanguage:veln"
  ],
  "categories": [
    "Programming Languages"
  ],
  "devDependencies": {
    "@types/vscode": "1.90.0",
    "@vscode/vsce": "^3.9.1"
  },
  "contributes": {
    "languages": [
      {
        "id": "veln",
        "aliases": [
          "Veln",
          "veln"
        ],
        "extensions": [
          ".veln"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "veln",
        "scopeName": "source.veln",
        "path": "./syntaxes/veln.tmLanguage.json"
      }
    ],
    "semanticTokenTypes": [
      {
        "id": "namespace"
      },
      {
        "id": "type"
      },
      {
        "id": "parameter"
      },
      {
        "id": "variable"
      },
      {
        "id": "property"
      },
      {
        "id": "enumMember"
      },
      {
        "id": "function"
      }
    ],
    "semanticTokenModifiers": [
      {
        "id": "test"
      },
      {
        "id": "result"
      },
      {
        "id": "hole"
      }
    ],
    "configuration": {
      "title": "Veln",
      "properties": {
        "veln.server.path": {
          "type": "string",
          "default": "veln",
          "description": "Executable used to start the Veln language server."
        },
        "veln.server.arguments": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "lsp"
          ],
          "description": "Arguments passed to the Veln language server executable."
        }
      }
    }
  }
}
