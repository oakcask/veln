{
  "name": "veln-language",
  "displayName": "Veln Language",
  "description": "Veln language support.",
  "version": "0.1.0",
  "publisher": "veln",
  "main": "./extension.js",
  "files": [
    "extension.js",
    "language-configuration.json",
    "syntaxes/veln.tmLanguage.json"
  ],
  "scripts": {
    "generate:syntax": "node generate-syntax.mjs",
    "test": "node generate-syntax.mjs --check && node --check extension.js && node --test extension.test.mjs syntax.test.mjs && pnpm test:integration",
    "vsix": "vsce package --no-dependencies --allow-missing-repository",
    "test:integration": "cargo build --locked --manifest-path ../../Cargo.toml -p veln-cli && node --test lsp.integration.test.mjs"
  },
  "extensionKind": [
    "workspace"
  ],
  "engines": {
    "vscode": "^1.140.0"
  },
  "activationEvents": [
    "onLanguage:veln"
  ],
  "categories": [
    "Programming Languages"
  ],
  "devDependencies": {
    "@types/vscode": "1.138.0",
    "@vscode/vsce": "^4.0.0",
    "vscode-textmate": "9.3.2",
    "vscode-oniguruma": "2.0.1"
  },
  "contributes": {
    "languages": [
      {
        "id": "veln",
        "aliases": [
          "Veln",
          "veln"
        ],
        "extensions": [
          ".veln"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "veln",
        "scopeName": "source.veln",
        "path": "./syntaxes/veln.tmLanguage.json"
      }
    ],
    "semanticTokenTypes": [],
    "semanticTokenModifiers": [
      {
        "id": "test"
      },
      {
        "id": "result"
      },
      {
        "id": "hole"
      }
    ],
    "configuration": {
      "title": "Veln",
      "properties": {
        "veln.server.path": {
          "type": "string",
          "default": "veln",
          "description": "Executable used to start the Veln language server."
        },
        "veln.server.arguments": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "lsp"
          ],
          "description": "Arguments passed to the Veln language server executable."
        },
        "veln.server.trace": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Controls Veln language server protocol tracing in the Veln output channel."
        }
      }
    }
  }
}
